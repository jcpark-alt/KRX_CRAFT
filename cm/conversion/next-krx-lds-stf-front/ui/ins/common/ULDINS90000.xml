		<script type="text/javascript" lazy="false"><![CDATA[scwin.vScrenID = "ULDINS90100";
scwin.param1 = "";
scwin.param2 = "";
scwin.flag = "0";

scwin.onpageload = function() {
    scwin.flag = "0";
    ixb_cntrNm.focus();

    var param = $c.data.getParameter();

    scwin.param1 = $p.parent().scwin.param1;
    scwin.param2 = $p.parent().scwin.param2;

    console.log("scwin.param1 : "+ scwin.param1);

    if(scwin.param1 != "") { // undefined 확인필요
        scwin.ins_search("", scwin.param1);
    }


};


scwin.btn_search_onclick = function (e) {    
    scwin.flag = "1";
    scwin.ins_search(ixb_cntrNm.getValue());
};

scwin.ins_search = function (cntrNm) {
    //dma_search.set("cntrNm", cntrNm);
    dma_search.set("param1", cntrNm);
    dma_search.set("param2", cntrNm);

    /*
    dlt_list.insertRow(0);
    dlt_list.setCellData(0, "cntrCd", "00123");
    dlt_list.setCellData(0, "cntrNm", "테스트");
    //dlt_list.setCellData(0, "stdCdInstStatCd", "1");
    //grd_main.refreshRow(0);
    */

    $c.sbm.execute(sbm_search);
}

scwin.grd_main_oncelldblclick = function (rowIndex, columnIndex, columnId) {

    var cntrCd = dlt_list.getCellData(rowIndex, "cntrCd");
    var cntrNm = dlt_list.getCellData(rowIndex, "cntrNm");

    $c.cm.ins_popupRtn_cdnm(cntrCd, cntrNm);
    $c.win.closePopup();
};

scwin.btn_close_onclick = function (e) {
    $c.win.closePopup();
};

scwin.sbm_search_submitdone = function (e) {
    spa_totCnt.setValue(dlt_list.getRowCount());
};

scwin.ixb_cntrNm_onkeyup = function (e) {
    scwin.flag = "1";
    $c.cm.fn_DelChar(ixb_cntrNm);
};

scwin.ixb_cntrNm_oneditenter = function (e) {
    scwin.flag = "1";
    if(ixb_cntrNm.getValue() != "") {
        scwin.ins_search(ixb_cntrNm.getValue());
    }
};
]]></script>

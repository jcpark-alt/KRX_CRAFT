 *  (주로 SPA(Single Page Application) 환경에서 전역 자원을 해제하거나 메모리 누수 방지)
 */
scwin.onpageunload = function() {
};

/**
 *  화면 초기화
 */
scwin.fn_Init = function() {

    // 결산일자 조회
    $p.parent().frame_head.getWindow().scwin.fn_SrchAcntclsDt();

};

/**
 *  데이터셋 초기화
 */
scwin.fn_InitDs = function() {

    dlt_productPriceTrendAcntclsDtListRes.setData([]);
    dlt_productPriceTrendListRes.setData([]);

};

/**
 *  조회조건 유효성 체크
 */
scwin.fn_ChkValid = function() {

    //필수항목 체크
    scwin.vKisCd = $p.parent().frame_head.getWindow().scwin.fn_GetKisCd();
    scwin.vAcntclsDt = $p.parent().frame_head.getWindow().scwin.fn_GetAcntclsDt();

    if (scwin.vKisCd == "" || scwin.vAcntclsDt == "") {
        return false;
    }

    return true;

};


/**
 * 주요제품가격동향 조회
 */
scwin.fn_Search = function() {

    //데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 체크
    if (!scwin.fn_ChkValid()) {
        return;
    }

    // 최근 3년 결산일자 조회
    scwin.fn_SearchStdDt();

};


/**
 * 최근 3년 결산일자 조회
 */
scwin.fn_SearchStdDt = async function() {

    dma_productPriceTrendAcntclsDtInfoReq.set("kisCd", scwin.vKisCd); // 기업코드
    dma_productPriceTrendAcntclsDtInfoReq.set("acntclsDt", scwin.vAcntclsDt); // 결산일자
    
    const res = await $c.sbm.execute(sbm_productPriceTrendAcntclsDt);
    dlt_productPriceTrendAcntclsDtListRes.setJSON(res.responseJSON.body);

    scwin.fn_SetGrdTitle();

};

/**
 * 그리드 타이틀 세팅
 */
scwin.fn_SetGrdTitle = function() {

    acntclsDtArray = []; // 배열 초기화

    grd_majProdPrcTrend.setHeaderValue("h_YYYY1", $c.stf.FormatDateEx(dlt_productPriceTrendAcntclsDtListRes.getCellData(0, "stdDt")));
    grd_majProdPrcTrend.setHeaderValue("h_YYYY2", $c.stf.FormatDateEx(dlt_productPriceTrendAcntclsDtListRes.getCellData(1, "stdDt")));
    grd_majProdPrcTrend.setHeaderValue("h_YYYY3", $c.stf.FormatDateEx(dlt_productPriceTrendAcntclsDtListRes.getCellData(2, "stdDt")));

    for (let i=0; i < 3; i++) {
        acntclsDtArray.push(dlt_productPriceTrendAcntclsDtListRes.getCellData(i, "stdDt"));
    }

    // 주요제품가격동향 조회
    scwin.fn_SearchMajProdPrcTrend();
        
};

/**
 * 주요제품가격동향  조회
 */
scwin.fn_SearchMajProdPrcTrend = async function() {

    dma_productPriceTrendInfoReq.set("kisCd", scwin.vKisCd);
    dma_productPriceTrendInfoReq.set("acntclsDtList", acntclsDtArray);

    const res = await $c.sbm.execute(sbm_productPriceTrend);
    dlt_productPriceTrendListRes.setJSON(res.responseJSON.body);

};

/**
 *  엑셀파일다운로드
 */
scwin.fn_excel_download = function() {

    if (dlt_productPriceTrendListRes.getTotalRow() <= 0) {
        alert("조회된 데이터가 없습니다.");
        return;
    }

    var options = {
        fileName : "주요제품가격동향",
        sheetName : "주요제품가격동향"
    };

    var infoArray = {};

    grd_majProdPrcTrend.advancedExcelDownload(options, infoArray);

};]]></script>

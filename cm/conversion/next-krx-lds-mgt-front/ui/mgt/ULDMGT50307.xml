    <head meta_screenName="FAQ 등록" meta_screenId="" meta_subsystem="">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap baseNode="map" id="dma_select_list" style="">
        			<w2:keyInfo>
        				<w2:key dataType="text" id="mode" name="mode"></w2:key>
        				<w2:key dataType="text" id="helpClssId" name="helpClssId"></w2:key>
        				<w2:key id="faqId" name="faqId" dataType="text"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataList baseNode="list" id="dlt_select_list_content" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="clssLvl" name="clssLvl" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpClssNmPath" name="helpClssNmPath" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpClssId" name="helpClssId" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="upHelpClssId" name="upHelpClssId" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpClssNm" name="helpClssNm" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpTpCd" name="helpTpCd" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="screnDpOrdNo" name="screnDpOrdNo" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="notiObjSysTpCd" name="notiObjSysTpCd" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="ldHelpUseAreaTpCd" name="ldHelpUseAreaTpCd" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="notiObjSysTpNm" name="notiObjSysTpNm" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="ldHelpUseAreaTpNm" name="ldHelpUseAreaTpNm" nullYN="true"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataMap baseNode="map" id="dma_save">
        			<w2:keyInfo>
        				<w2:key id="mode" name="mode" dataType="text"></w2:key>
        				<w2:key id="faqId" name="faqId" dataType="text"></w2:key>
        				<w2:key id="quesContn" name="quesContn" dataType="text"></w2:key>
        				<w2:key id="helpClssId" name="helpClssId" dataType="text"></w2:key>
        				<w2:key id="screnDpOrdNo" name="screnDpOrdNo" dataType="text"></w2:key>
        				<w2:key id="ldFaqAnsContn" name="ldFaqAnsContn" dataType="text"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataMap baseNode="map" id="dma_faqId_select" style="">
        			<w2:keyInfo>
        				<w2:key dataType="text" id="faqId" name="faqId"></w2:key>
        				<w2:key dataType="text" id="quesContn" name="quesContn"></w2:key>
        				<w2:key dataType="text" id="regEmpNo" name="regEmpNo"></w2:key>
        				<w2:key dataType="text" id="faqRegDdtm" name="faqRegDdtm"></w2:key>
        				<w2:key dataType="text" id="helpClssId" name="helpClssId"></w2:key>
        				<w2:key dataType="text" id="ldFaqAnsContn" name="ldFaqAnsContn"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        	<xf:submission id="sbm_faq_select" action="/api/mgmt/help-class-faq/select" method="get" mediatype="application/json" ref=""
        		target="" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="조회하는중..."
        		ev:submit="" ev:submitdone="scwin.sbm_faq_select_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="sbm_save" action="/api/mgmt/help-faq/save" method="post" mediatype="application/json" ref="" target=""
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="저장하는중..." ev:submit=""
        		ev:submitdone="scwin.sbm_save_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="sbm_faq_update" action="/api/mgmt/ld-faq/select" method="get" mediatype="application/json" ref=""
        		target="" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="조회중..."
        		ev:submit="" ev:submitdone="scwin.sbm_faq_update_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload =  function() {
	scwin.vScrenID = "ULDMGT50307";
   
    console.log( $c.data.getParameter("mode") ); 
    console.log( $c.data.getParameter("faqId") ); 
    console.log( $c.data.getParameter("helpClssId") );

    scwin.faqId =  $c.data.getParameter("faqId") ; 
    scwin.helpClssId =  $c.data.getParameter("helpClssId") ;


    // param 에서 mode가 없으면 무조건 create합니다.
    if ($c.data.getParameter("mode") === 'update')
    {

        scwin.mode = "update";

    }else {

        scwin.mode = "create";

    }

    scwin.select_list_call();

  
};

scwin.select_list_call =  function (){
    dma_select_list.set("mode", scwin.mode);
  
    $c.sbm.execute(sbm_faq_select, dma_select_list.getJSON());


        
}


scwin.sbm_faq_select_submitdone =  function (e) {

    const result = e.responseJSON;
    
    if(result.success) {

        // 전체 데이터 
        const obj = result.body.helpClasses;
      
        dlt_select_list_content.setJSON(obj); 
       
        //  selectbox에 담기 위한 데이터출력 조정
        var taps = "&nbsp;&nbsp;";
        
        for(var i = 0; i < dlt_select_list_content.getTotalRow(); i++)
        {
            var ltaps = "";
            var rClssLvl = dlt_select_list_content.getCellData(i, "clssLvl");
            for(var j=0; j < parseInt(rClssLvl); j++)
            {
                ltaps = ltaps + taps;
            }
            sel_upFaqArea.addItem(dlt_select_list_content.getCellData(i, "helpClssId"),  ltaps + dlt_select_list_content.getCellData(i, "helpClssNm"), i, false)
        }

        if(scwin.mode == 'update'){
            sel_upFaqArea.setValue( scwin.helpClssId );
        }else{
        
            sel_upFaqArea.setValue( "" );
        }


        if(scwin.mode == 'update'){
            dma_select_list.set("mode", scwin.mode);
            dma_select_list.set("faqId", scwin.faqId);

            //dma_select_list.set("faqId", "FAQ0000034");
            dma_select_list.set("helpClssId", scwin.helpClssId);
            
            $c.sbm.execute(sbm_faq_update, dma_select_list.getJSON());

        }        
      
    }
    else{
        $c.win.alert(result.message);
    }



};

scwin.sbm_faq_update_submitdone = function (e) {
    const result = e.responseJSON;
    

    console.log("result: "+ JSON.stringify(result.body));

    if(result.success) {

        // 전체 데이터 
        const obj = result.body;
      

        dma_faqId_select.setJSON(obj); 

        console.log("ldFaqAnsContn: "+ dma_faqId_select.get("ldFaqAnsContn"));
       
        sel_upFaqArea.setValue(dma_faqId_select.get("helpClssId"));
        txt_question.setValue(dma_faqId_select.get("quesContn"));
        txt_cont.setText(dma_faqId_select.get("ldFaqAnsContn"));
    }    
    else
    {
        $c.win.alert(result.message);
    }
};

scwin.btn_close_onclick = function (e) {
    $c.win.closePopup();	
};

scwin.btn_save_onclick = function (e) {
    dma_save.set ("mode", scwin.mode);

    if(scwin.mode == 'update'){
         dma_save.set ("faqId", scwin.faqId);
    }else{
        dma_save.set ("faqId", "");
    }
    dma_save.set ("quesContn", txt_question.getValue());
    dma_save.set ("helpClssId", sel_upFaqArea.getValue());

    console.log("txt_cont.getText() :"+ txt_cont.getText());
    dma_save.set ("ldFaqAnsContn", txt_cont.getText());

    $c.sbm.execute(sbm_save, dma_save.getJSON());

};

scwin.sbm_save_submitdone = function (e) {
    const result = e.responseJSON;
    
    if(result.success) {
      
        $c.win.moveUrl("/ui/mgt/ULDMGT50315.xml", dma_save.getJSON());
    }
    else{
        
        $c.win.alert(result.message);
    }
};


]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">

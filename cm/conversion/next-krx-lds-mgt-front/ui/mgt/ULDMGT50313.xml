        			<w2:keyInfo>
        				<w2:key dataType="text" id="mode" name="mode"></w2:key>
        				<w2:key id="clssLvl" name="clssLvl" dataType="text"></w2:key>
        				<w2:key dataType="text" id="helpClssId" name="helpClssId"></w2:key>
        				<w2:key id="upHelpClssId" name="upHelpClssId" dataType="text"></w2:key>
        				<w2:key dataType="text" id="helpClssNm" name="helpClssNm"></w2:key>

        				<w2:key dataType="text" id="helpTpCd" name="helpTpCd"></w2:key>
        				<w2:key dataType="text" id="notiObjSysTpCd" name="notiObjSysTpCd"></w2:key>

        				<w2:key id="ldHelpUseAreaTpCd" name="ldHelpUseAreaTpCd" dataType="text"></w2:key>

        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap baseNode="map" id="dma_select_list">
        			<w2:keyInfo>
        				<w2:key id="mode" name="mode" dataType="text"></w2:key>
        				<w2:key id="helpClssId" name="helpClssId" dataType="text"></w2:key>
        				<w2:key id="helpTpCd" name="helpTpCd" dataType="text"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataList baseNode="list" id="dlt_select_list_content" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column dataType="text" id="clssLvl" name="clssLvl" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpClssNmPath" name="helpClssNmPath" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpClssId" name="helpClssId" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="upHelpClssId" name="upHelpClssId" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpClssNm" name="helpClssNm" nullYN="true"></w2:column>
        				<w2:column dataType="text" id="helpTpCd" name="helpTpCd" nullYN="true"></w2:column>
        				<w2:column id="screnDpOrdNo" name="screnDpOrdNo" dataType="text" nullYN="true"></w2:column>
        				<w2:column id="notiObjSysTpCd" name="notiObjSysTpCd" dataType="text" nullYN="true"></w2:column>
        				<w2:column id="ldHelpUseAreaTpCd" name="ldHelpUseAreaTpCd" dataType="text" nullYN="true"></w2:column>
        				<w2:column id="notiObjSysTpNm" name="notiObjSysTpNm" dataType="text" nullYN="true"></w2:column>
        				<w2:column id="ldHelpUseAreaTpNm" name="ldHelpUseAreaTpNm" dataType="text" nullYN="true"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataList baseNode="list" repeatNode="map" id="dlt_sel_useArea">
        			<w2:columnInfo>
        				<w2:column id="cdId" name="cdId" dataType="text"></w2:column>
        				<w2:column id="cdVal" name="cdVal" dataType="text"></w2:column>
        				<w2:column id="cdValNm" name="cdValNm" dataType="text"></w2:column>
        				<w2:column id="validStrtDd" name="validStrtDd" dataType="text"></w2:column>
        				<w2:column id="validEndDd" name="validEndDd" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>

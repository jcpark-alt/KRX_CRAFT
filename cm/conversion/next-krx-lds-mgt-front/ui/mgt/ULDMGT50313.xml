        		processMsg="조회하는중..." ev:submit="" ev:submitdone="scwin.sbm_helpClassFaq_sel_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="sbm_save" action="/api/mgmt/help-class-faq/save" method="post" mediatype="application/json" ref="" target=""
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="저장하는중..." ev:submit=""
        		ev:submitdone="scwin.sbm_save_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	scwin.vScrenID = "ULDMGT50313";
   
    scwin.mode = "create";   
    scwin.jval = $c.data.getParameter("jval"); 
    scwin.callBack =  $c.data.getParameter("callBackFn"); 
    
    dma_param.setJSON(scwin.jval);

    scwin.select_list_call();
};

scwin.select_list_call = function (){
    dma_select_list.set("mode", scwin.mode);
    //dma_select_list.set("helpClssId", "0300000114");
    //dma_select_list.set("helpTpCd"  , "03");
    

    $c.sbm.execute(sbm_helpClassFaq_sel, dma_select_list.getJSON());
}



scwin.sbm_helpClassFaq_sel_submitdone = function (e) {
    const result = e.responseJSON;
    
    if(result.success) {

        // 전체 데이터 
        const obj = result.body.helpClasses;
      
        dlt_select_list_content.setJSON(obj); 
       
        //  selectbox에 담기 위한 데이터출력 조정
        var taps = "&nbsp;&nbsp;";
        
        for(var i = 0; i < dlt_select_list_content.getTotalRow(); i++)
        {
            var ltaps = "";
            var rClssLvl = dlt_select_list_content.getCellData(i, "clssLvl");
            for(var j=0; j < parseInt(rClssLvl); j++)
            {
                ltaps = ltaps + taps;
            }
            sel_upFaqArea.addItem(dlt_select_list_content.getCellData(i, "helpClssId"),  ltaps + dlt_select_list_content.getCellData(i, "helpClssNm"), i, false)
        }
        sel_upFaqArea.setValue("");
        
        //helpArea selectbox data
        const helpArea  = result.body.ldHelpUseAreaTpCds;

        dlt_sel_useArea.setJSON(helpArea);

    }
    else{
        $c.win.alert(result.message);
    }
};



scwin.btn_save_onclick = async function (e) {

    var vmsg = "저장 하시겠습니까?";
    //console.log("????"+ sel_upFaqArea.getValue());
    if(sel_upFaqArea.getValue() === "")
    {
        $c.win.alert("상위FAQ분류 값을 선택하십시요.");

        return;
    }

     if(ipt_helpClssNm.getValue() === "")
    {
        $c.win.alert("FAQ 분류명 값을 입력하십시요.");

        return;
    }

    if (await $c.win.confirm(vmsg)) { 
    
        dma_param.set("mode", "create");
        dma_param.set("clssLvl"   , "");    //create 일때는 빈값
        dma_param.set("helpClssId", "");    //create 일때는 빈값
        dma_param.set("ldHelpUseAreaTpCd", sel_helpArea.getValue());        //상장공시 도움말 사용영역 구분
        
        dma_param.set("upHelpClssId",      sel_upFaqArea.getValue());       // 상위faq분류
        dma_param.set("helpClssNm",        ipt_helpClssNm.getValue());       // faq분류명

        dma_param.set("notiObjSysTpCd", sel_systemGbn.getValue());     // 공지대상 시스템 구분
        
        console.log(dma_param.getJSON());

        $c.sbm.execute(sbm_save, dma_param.getJSON());
    }

  
};


scwin.sbm_save_submitdone = function (e) {
    const result = e.responseJSON;
    
    if(result.success) {
        
       $c.win.closePopup();	
    }
    else{
        
        $c.win.alert(result.message);
    }
};

scwin.btn_close_onclick = function (e) {
   $c.win.closePopup();	
};


]]></script>
    </head>

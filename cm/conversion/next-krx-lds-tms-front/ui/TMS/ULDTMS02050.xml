        				<w2:column id="formVer" name="서식버전" dataType="text"></w2:column>
        				<w2:column id="formKorNm" name="서식명" dataType="text"></w2:column>        				
        			</w2:columnInfo>
        		</w2:dataList>
            </w2:dataCollection>    
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[

            scwin.onpageload = function() {

                const formCd = $c.data.getParameter("formCd");	
                tbx_info.setValue("※ 본 서식(" + formCd + ")에 연결된 단위서식 목록입니다. 삽입할 단위서식을 선택하세요."); 
            };

            scwin.btn_select_onclick = function (e) {
                
                const params = {};
                for (let i=0; i < dlt_list.getRowCount(); i++) {
                    if (dlt_list.getCellData(i, "CHK")) {
                        
                    }
                }

                if (!$c.util.isEmpty(params)) {
                    $c.win.closePopup();
                } else {
                    $c.win.alert("추가 할 단위서식을 선택해 주세요.");
                }             
            };

            scwin.btn_close_onclick = function (e) {

                $c.win.closePopup();
            };

        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="pop_contents" id="" meta_snippetCategory="00_화면시작" meta_snippetKeyComponent="true"

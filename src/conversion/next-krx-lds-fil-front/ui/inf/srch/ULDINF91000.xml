};

scwin.sbm_search_submitdone = function (e) {
    var cdNm = "(" + dma_srchMap.get("isurCd") + ") " + dma_srchMap.get("comNm");
    dma_srchMap.set("cdNm", cdNm);

    var fornSecuKindNm =  dma_srchMap.get("fornSecuKindNm");
    var fornSecuIsuDate =  dma_srchMap.get("fornSecuIsuDate");
    var kindNmDate = fornSecuKindNm + "(발행일:" + fornSecuIsuDate + ")";
    if(fornSecuKindNm != "" && fornSecuIsuDate != "") {
        dma_srchMap.set("kindNmDate", kindNmDate);
    } else if (fornSecuKindNm != "" && fornSecuIsuDate == "") {
        dma_srchMap.set("kindNmDate", fornSecuKindNm);
    } else if (fornSecuKindNm == "" && fornSecuIsuDate != "") {
        dma_srchMap.set("kindNmDate", fornSecuIsuDate);
    }

    var continDeadlineStrtDd = dma_srchMap.get("continDeadlineStrtDd");
    var continDeadlineEndDd = dma_srchMap.get("continDeadlineEndDd");
    var continDeadlinePeriod = continDeadlineStrtDd + " ~ " + continDeadlineEndDd;
    if( continDeadlineStrtDd != "" && continDeadlineEndDd != "") {
        dma_srchMap.set("continDeadlinePeriod", continDeadlinePeriod);
    }

    var nparvalstkYn = dma_srchMap.get("nparvalstkYn");
    if(nparvalstkYn == "Y") {
        dma_srchMap.set("nparvalstkFormat", "무액면주식");
    } else {
        dma_srchMap.set("nparvalstkFormat", dma_srchMap.get("parAmtToFormat"));
    }

    var crwfndYn = dma_srchMap.get("crwfndYn");
    if(crwfndYn == "Y") {
        dma_srchMap.set("crwfndNm", "YES");
    } else {
        dma_srchMap.set("crwfndNm", "NO");
    }


};


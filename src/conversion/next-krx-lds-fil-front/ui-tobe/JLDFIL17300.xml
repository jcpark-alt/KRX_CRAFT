        <script lazy="false" type="text/javascript"><![CDATA[
scwin.vScrenID = "JLDFIL17300.xml";

// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function() {
	scwin.fn_Search(true);
};

// WebSquare 컴포넌트 이벤트 함수
/// EVENT ///

/**
 * 조회 버튼 클릭
 */
scwin.btn_search_onclick = function (e) {
    scwin.fn_Search(true);
};
/**
 * 페이지 사이즈 변경
 */
scwin.sel_size_onviewchange = function (info) {
	scwin.fn_Search(true);
};
/**
 * 페이지네이션 현재 페이지 변경
 */
scwin.pageList1_onviewchange = async function (info) {
    let currentPage = info.newSelectedIndex;
    dma_SearchReq.set("page", currentPage);
	await scwin.fn_Search(false);
};
/**
 * 질문 상세보기 row 선택
 */
scwin.grd_Grid_oncellclick = function (rowIndex, columnIndex, columnId) {
    let rowData = dlt_QnaList.getRowJSON(rowIndex);
    let contnId = rowData.contnId;
    let quesReadYn = rowData.quesReadYn;
    scwin.fn_SearchQnaView(quesReadYn, contnId);
};
/**
 * 질문작성 버튼 클릭
 */
scwin.btn_writeQna_onclick = function (e) {
	const move_url = "/ui/support/JLDFIL17301.xml";
    $p.url(move_url);
};
/**
 * 조회시작일 컴포넌트 blur 이벤트
 */
scwin.ipt_startDate_onblur = function () {
    //TODO : 공통 적용 예정
	//$c.cm.fn_CheckDate(ipt_startDate);
};
/**
 * 조회종료일 컴포넌트 blur 이벤트
 */
scwin.ipt_endtDate_onblur = function () {
    //TODO : 공통 적용 예정
	//$c.cm.fn_CheckDate(ipt_endDate);
};

// 일반 함수
/// FUNCTION ///

/**
 * 조회
 * @param 초기 조회 여부
 */
scwin.fn_Search = async function(isFirst) {
    if(isFirst) {
        dma_SearchReq.set("page", 1);//현재페이지 초기화
    }

    let res = await $c.sbm.executeDynamic({ id: "sbm_SelectQnaList", action: "/api/discls/support/qna/select-list", method: "get", ref: "dma_SearchReq", target: "dlt_QnaList=body.content,dma_SearchRes=body", isProcessMsg: false });
    if (res.responseJSON.success === true) {
        const resBody = res.responseJSON.body;
        
        for (let idx = 0; idx < resBody.size; idx++) {
            //rownum 커스텀 세팅(내림차순)
            dlt_QnaList.setCellData(idx, "rownum", (resBody.startRowNumDesc-idx));
            
            //제목
            let row = dlt_QnaList.getRowJSON(idx);
            let quesTitle = row.quesTitle;
            let contnDepth = row.contnDepth;
            let quesAnsTpCd = row.quesAnsTpCd;
            let opnYn = row.opnYn;

            let resultTitle = "";
            if(contnDepth !== "1") {
                resultTitle += "&nbsp;&nbsp;";
                resultTitle += "ㄴ"; //TODO: 이미지 필요
            }
            if(quesAnsTpCd === "1") {
                resultTitle += "Q."; //TODO: 이미지 필요
            } else if(quesAnsTpCd === "2") {
                resultTitle += "A."; //TODO: 이미지 필요
            }
            resultTitle += quesTitle;
            if(opnYn === "N") {
                resultTitle += "(자물쇠이미지)"; //TODO: 이미지 필요
            }
            dlt_QnaList.setCellData(idx, "quesTitle", resultTitle);

        }

        if (isFirst) {
            //페이지네이션 생성
            const totalCnt = $c.num.ceil(resBody.totalCount / resBody.size);
            pageList1.setCount(totalCnt);
        } else {
            //페이지네이션 선택
            pageList1.setSelectedIndex(resBody.page);
        }
    }
};
/**
 * QNA 상세보기
 */
scwin.fn_SearchQnaView = function (quesReadYn, contnId) {

    if(quesReadYn === 'Y') {
        const move_url = "/ui/support/JLDFIL17302.xml";
        const options = {};
        options.param = {"contnId": contnId};
        $p.url(move_url , options);

    } else {
        alert('비공개로 작성된 글은 작성자만 볼 수 있습니다.');
        return;
    }
};
]]></script>

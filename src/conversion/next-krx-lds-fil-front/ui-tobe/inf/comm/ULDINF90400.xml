scwin.sbm_searchPage_submitdone = function (e) {
    console.log(e.responseJSON.body.totalCount);
    const totalCount = e.responseJSON.body.totalCount;
    const tatalPage = $c.num.ceil(totalCount / scwin.pageItemCnt);
    pgl_pageList.setCount(tatalPage);
    pgl_pageList.setSelectedIndex(scwin.pageIndex);
};

scwin.search = async function () {
    const sbmObj = $p.getComponentById("sbm_search");
    sbmObj.action = "/api/sample/disclosure/select-list";

	const type = scwin.searchType;

    if(type !== "" && type !== null) {
        if( type.substring(0,4) === "WRNT" ){
            // url = "/common/corp.do?method=elwCorpNmList&search_type=" + type;
            sbmObj.action = "";
        } else if( $("#search_type").val() === "SPECLBND" ){
            // url = "/common/corp.do?method=specCorpNmList&search_type=SPECLBND";
            sbmObj.action = "";
        } else if( $("#search_type").val() === "BENFCERT" ){
            // url = "/common/corp.do?method=benefCorpNmList&search_type=BENFCERT";
            sbmObj.action = "";
        } else if( $("#search_type").val() === "DR" ){
            // url = "/common/corp.do?method=elwCorpNmList&search_type=DR";
            sbmObj.action = "";
        } else {
            // url = "/common/corp.do?method=corpNmList";	        
            sbmObj.action = "/common/api/corp/corpList-select";
        }    
    } else {
        // url = "/common/corp.do?method=corpNmList";	        
        sbmObj.action = "/common/api/corp/corpList-select";
    }

    dma_search.set("searchWord", ibx_searchWord.getValue());
    dma_search.set("page", 1);
    dma_search.set("size", scwin.pageItemCnt);

    const sbmOptions = {
        id : "sbm_searchPage",
        action : "/api/isin/common/api/corp/corpList-select-paging",
        method : "get",
        ref : "dma_search",
        target : "dlt_result=body.content",
        gridview : "grd_result",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_searchPage_submitdone(sbmRtn);
}

scwin.searchPage = async function (index) {
    dma_search.set("searchWord", ibx_searchWord.getValue());
    dma_search.set("page", index);
    dma_search.set("size", scwin.pageItemCnt);

    const sbmOptions = {
        id : "sbm_searchPage",
        action : "/api/isin/common/api/corp/corpList-select-paging",
        method : "get",
        ref : "dma_search",
        target : "dlt_result=body.content",
        gridview : "grd_result",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_searchPage_submitdone(sbmRtn);
}

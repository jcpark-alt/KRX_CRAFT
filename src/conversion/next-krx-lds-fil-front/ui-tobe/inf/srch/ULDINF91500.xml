            // return;
        }	
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDINF91500.btn_print_onclick" });
    }
};

scwin.btn_close_onclick = function (e) {
    try {
        $c.win.closePopup();	
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDINF91500.btn_close_onclick" });
    }
};
]]></script>

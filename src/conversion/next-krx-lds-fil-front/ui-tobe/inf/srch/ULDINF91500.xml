    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDINF91500.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.btn_print_onclick = async function (e) {
    try {
        if(await $c.win.confirm("신주인수권증권 상세정보를 출력하시겠습니까?")){

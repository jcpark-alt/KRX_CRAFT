scwin.param = "";

// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function() {
    scwin.param = $c.data.getParameter();

    dma_search.set("stdCd", scwin.param.stdCd);

    const sbmOptions = {
        id : "sbm_search",
        action : "/api/isin/search/stdCodeDtl/selectStdCdStkWrnt-dtl-info",
        method : "get",
        ref : "dma_search",
        target : "dma_reqCkMap=body.stdCdApplCnt,dma_srchMap=body.stdCdStkWrntDtlInfo",
        submitDoneHandler : scwin.sbm_search_submitdone,
        isProcessMsg : false
    };
    $c.sbm.executeDynamic(sbmOptions);

    
};

// WebSquare 컴포넌트 이벤트 함수
scwin.btn_print_onclick = async function (e) {
    if(await $c.win.confirm("주식워런트(ELW) 상세정보를 출력하시겠습니까?")){
        const stdCd = scwin.param.stdCd;
    } else {
        //return;
    }	
};

scwin.btn_close_onclick = function (e) {
    $c.win.closePopup();	
};

// 일반 함수
scwin.sbm_search_submitdone = function (e) {
    const uly1 = dma_srchMap.get("uly1");
    const ulyIsuNm1 = dma_srchMap.get("ulyIsuNm1");

    if(uly1 !== null && uly1 !== "") {
        dma_srchMap.set("ulyIsuNm1", ulyIsuNm1 + "  구성주식비율: " + uly1);
    }
};
]]></script>

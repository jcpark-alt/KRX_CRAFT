        <script lazy="false" type="text/javascript"><![CDATA[
scwin.vScrenID = "ULDINF05700.xml";
///////// 1. 변수 및 선언 영역 /////////
scwin.screenId = "ULDINF05700";
scwin.isurCd = "";

///////// 2. 초기화 영역 /////////
scwin.onpageload = async function() {
    tbx_info.hide();
	btn_infoChange.hide();

    //dma_search.set("isurCd", "00347");
    dma_search.set("isurCd", "00003");
    //scwin.isurCd =  $c.session.info("isurCd");
    //dma_search.set("isurCd", scwin.isurCd);

    const sbmOptions = {
        id : "sbm_search",
        action : "/api/isin/common/api/corp/corp-select",
        method : "get",
        ref : "dma_search",
        target : "dma_srchMap=body.corpDtlInfo,dlt_commCdComAttrTpCd=body.commCdComAttrTpCd,dlt_commCdTransstkAgntCd=body.commCdTransstkAgntCd",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_search_submitdone(sbmRtn);
};

///////// 3. 컴포넌트 이벤트 영역 /////////
///////// Component Event /////////
scwin.btn_infoChange_onclick = function (e) {
    const moveUrl = "/ui/inf/ULDINF05400.xml";

    const param = {};

    $c.win.moveUrl(moveUrl, param);
};

///////// 4. 서브미션 콜백 영역 /////////
///////// Submission 처리///////// 
scwin.sbm_search_submitdone = function (e) {
    dma_srchMap.set("fullAddr", dma_srchMap.get("zipcd") + ("  ") + dma_srchMap.get("addr") + ("  ") + dma_srchMap.get("dtlAddr"));
    dma_srchMap.set("fullEngAddr", dma_srchMap.get("engAddr") + ("  ") + dma_srchMap.get("engDtlAddr"));
    dma_srchMap.set("fullTelNo", dma_srchMap.get("corpTelNo") + ("  ") + dma_srchMap.get("telNo"));


    const comAttrTpCd =  dma_srchMap.get("comAttrTpCd");
    const comAttrTpCdVal = dlt_commCdComAttrTpCd.getMatchedColumnData("cdVal", comAttrTpCd, "cdValNm", true)[0];
    console.log("comAttrTpCdVal : " + comAttrTpCdVal);

    if(comAttrTpCdVal === "1") {
        spa_comAttrTpNm.setValue("주식회사");
        
    } else if (comAttrTpCdVal === "2") {
        spa_comAttrTpNm.setValue("증권투자회사사");
    } else if (comAttrTpCdVal !== "1" && comAttrTpCdVal !== "2") {
        spa_comAttrTpNm.setValue(dlt_commCdComAttrTpCd.getCellData(0, "cdValNm"));
    }

    
    const transstkAgntCd =  dma_srchMap.get("transstkAgntCd");
    //var length = dlt_commCdTransstkAgntCd.getMatchedColumnData("cdVal", transstkAgntCd, "cdValNm", true).length);
    const transstkAgntCdNm = dlt_commCdTransstkAgntCd.getMatchedColumnData("cdVal", transstkAgntCd, "cdValNm", true)[0];
    spa_transstkNm.setValue(transstkAgntCdNm);

    const spotIsuTrdMktTpCd = dma_srchMap.get("spotIsuTrdMktTpCd");
    const listStatCd = dma_srchMap.get("listStatCd");

    if(spotIsuTrdMktTpCd === "1" || spotIsuTrdMktTpCd === "2" || spotIsuTrdMktTpCd === "6") {
        if(listStatCd === "Y") {
            tbx_info.show();
        } else {
            btn_infoChange.show();
        }
    } else {
        btn_infoChange.show();
    }
    
};
]]></script>

        <script lazy="false" type="text/javascript"><![CDATA[
scwin.vScrenID = "ULDFIL52800.xml";

// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function() {
    ibx_comNm.setValue("씨엠"); //테스트 편의로 세팅
	scwin.search(true);
};

// WebSquare 컴포넌트 이벤트 함수
/**
 * 조회 버튼 클릭
 */
scwin.btn_search_onclick = function (e) {
    scwin.search(true);
};

/**
 * 페이지 사이즈 변경
 */
scwin.sel_size_onviewchange = function (info) {
	scwin.search(true);
};

/**
 * 페이지네이션 현재 페이지 변경
 */
scwin.pageList1_onviewchange = async function (info) {
    let currentPage = info.newSelectedIndex;
    dma_SearchReq.set("page", currentPage);
	await scwin.search(false);
};

// 일반 함수
/**
 * 조회
 * @param 초기 조회 여부
 */
scwin.search = async function(isFirst) {
    
    if(isFirst) {
      
        dma_SearchReq.set("userId", "KDBDW12_05") //userId 임시 let userID = $c.stf.getUserInfo("id"); 필수
        dma_SearchReq.set("comNm",  ibx_comNm.getValue()) //회사명(필수)
        dma_SearchReq.set("cmitPerfmYn", sbx_cmitPerfmYn.getValue()) //이행여부 (필수)
        dma_SearchReq.set("page", 1);//현재페이지 초기화
        dma_SearchReq.set("size", 10);//페이지당 데이터 개수 (기본값: 10, 최대: 100)

    }
    
    const sbmOptions = {
        id : "sbm_commitment",
        action : "/api/listing/listinvstg/commitments/select-list-paging",
        method : "get",
        ref : "dma_SearchReq",
        target : "dlt_CommitmentsRes=body.content",
        gridview : "grd_Grid",
        isProcessMsg : false
    };
    let res = await $c.sbm.executeDynamic(sbmOptions);
    if (res.responseJSON.success === true) {
        const resBody = res.responseJSON.body;
        
       if (isFirst) {
            //페이지네이션 생성
            const totalCnt = $c.num.ceil(resBody.totalCount / resBody.size);
            tbx_totalCount.setValue(resBody.totalCount)
            pageList1.setCount(totalCnt);
       } else {
            pageList1.setSelectedIndex(resBody.page);
       }
    }
};
]]></script>

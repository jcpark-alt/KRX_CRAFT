 */
scwin.changeUsrTpCd = function (usrTpCd) {
    if(usrTpCd === '14') {	// 사무관리회사/수탁회사 상장신청인
        scwin.getIsurCdTitle("2");

    } else if(usrTpCd === '22') {	// 상장 주간사
        scwin.getIsurCdTitle("3");

    } else if(usrTpCd === '15' || usrTpCd === '23') {	// 민원발급 신청자
        scwin.getIsurCdTitle("4");
        
    } else {
        scwin.getIsurCdTitle("1");
    }
};

/**
 * 회원가입분류에 따른 고유코드 타이틀 수정
 */
scwin.getIsurCdTitle = function (type) {
    if(type === "1") {
        txt_isurCd.setValue("회사코드(5자리)");
        grp_corpUsrNm.hide();
        
        //explain show/hide
        grp_explain_type1.show("");
        grp_explain_type2.hide();
        grp_explain_type3.hide();

    } else if(type === "2") {
        txt_isurCd.setValue("대상회사코드(5자리)");
        grp_corpUsrNm.show("");

        //explain show/hide
        grp_explain_type1.hide();
        grp_explain_type2.show("");
        grp_explain_type3.hide();

    } else if(type === "3") {
        txt_isurCd.setValue("회원고유코드");
        grp_corpUsrNm.hide();

        //explain show/hide
        grp_explain_type1.hide();
        grp_explain_type2.hide();
        grp_explain_type3.show("");

    } else if(type === "4") {
        txt_isurCd.setValue("회사코드(5자리)");
        grp_corpUsrNm.show("");
        
        //explain show/hide
        grp_explain_type1.show("");
        grp_explain_type2.hide();
        grp_explain_type3.hide();

    }
}

/**

        <script lazy="false" type="text/javascript"><![CDATA[///////// 2. 초기화 영역 /////////
scwin.onpageload = async function() {
    try {
        const param = $c.data.getParameter();
        dma_Req.set("thisYear", param.thisYear);
        const sbmOptions = {
            id : "sbm_SelectChrgEduSchdlList",
            action : "/api/discls/info/chrg/edu-schdl/select-list",
            method : "get",
            ref : "dma_Req",
            target : "dlt_Res=body",
            isProcessMsg : false
        };

        const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
        // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "JLDFIL00356.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * 닫기 버튼 클릭
 */
scwin.btn_cancel_onclick = function () {
    try {
        $c.win.closePopup();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "JLDFIL00356.btn_cancel_onclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * 교육일정 전년도, 다음년도 조회
 */
scwin.changeYear = async function (val) {
    let thisYear = Number(dma_Req.get("thisYear"));
    let paramYear = thisYear;

    if(val === "pre") {
        paramYear = thisYear - 1;
    } else if(val === "next") {
        paramYear = thisYear + 1;
    }
    
    txt_title.setValue("&nbsp;&nbsp;&nbsp;"+paramYear+"년도 교육일정&nbsp;&nbsp;&nbsp;");
    dma_Req.set("thisYear", paramYear);
    const sbmOptions = {
        id : "sbm_SelectChrgEduSchdlList",
        action : "/api/discls/info/chrg/edu-schdl/select-list",
        method : "get",
        ref : "dma_Req",
        target : "dlt_Res=body",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};
]]></script>

/**
 * 이메일포맷
 * @DESC : eds@krx.co.kr -> eds
 */
scwin.emailFormat = function (str) {
    if(str) {
        let endIdx = str.indexOf('@');
        if(endIdx > -1) {
            str = str.substring(0, endIdx);
        }
    }
    return str;
};

/**
 * 이메일포맷 도메인
 * @DESC : eds@krx.co.kr -> @krx.co.kr
 */
scwin.emailFormatDomain = function (str) {
    if(str) {
        let startIdx = str.indexOf('@')+1;
        str = str.substring(startIdx);
    }
    return str;
};

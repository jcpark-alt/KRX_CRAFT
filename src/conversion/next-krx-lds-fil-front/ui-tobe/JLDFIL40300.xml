/// EVENT ///

/**
 * 사용자구분 선택
 */
scwin.sel_corpUsrTpCd_onviewchange = function (info) {	
    const tpCd = sel_corpUsrTpCd.getValue();
    if(tpCd === "14") {
        txt_isurCdTitle.setValue("대상회사코드(5자리)");
    } else if(tpCd === "22") {
        txt_isurCdTitle.setValue("회원고유코드");
    } else {
        txt_isurCdTitle.setValue("회사코드(5자리)");
    }
};

/**
 * 이메일 도메인 선택
 */
scwin.sel_email_onviewchange = function (info) {
	const domain = sel_email.getValue();
    if(domain) {
        ipt_apctEmail2.setValue(domain);
    } else {
        ipt_apctEmail2.setValue("");
    }
};

/**
 * 확인 버튼 클릭
 */
scwin.btn_confirm_onclick = function (e) {
    //TODO: 삭제예정. Validation 공통 붙인 후 제거(fn_confirm에 내용 있음)
    let apctEmail = ipt_apctEmail1.getValue() + '@' + ipt_apctEmail2.getValue();
    dma_UsrInfoReq.set("apctEmail", apctEmail);

	scwin.fn_confirm();
};



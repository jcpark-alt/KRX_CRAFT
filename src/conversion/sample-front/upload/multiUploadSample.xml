         <script type="text/javascript" lazy="false"><![CDATA[
	
scwin.onpageload = function() {
	muc.changeAction("/api/discls/dsclinfo/insert-notice-content");	//action 설정

	let param = {"wrtrEmail":"eds@krx.co.kr","notiEndDd":"20261224","pw":"1234","notiObjSysTpCd":"1,2,3,B","wrtrEmpNm":"시스템관리자","bbsTpCd":"03","mktTpCd":"1","title":"공지사항 - 제출","contnMaindocContn":"string","notiStrtDd":"20260601","chrgInstId":"KRX"};
	muc.setParam(0, "data", JSON.stringify(param));	//data param 설정
};

scwin.onpageunload = function() {
	
};

// 파일 선택 이벤트
scwin.mUpBtn_onclick = function (e) {
	$c.util.onUploadClick(muc);
};

// 파일업로드시 파일정보 dataList에 세팅
scwin.selectCallback = function(fileInfoArr) {debugger;
	const fileInfos = muc.getFileInfos();
	//console.log("파일정보:::::"+fileInfos);
	dataList1.setJSON( fileInfos );
}

// 삭제버튼 클릭시 선택 row 삭제
scwin.delBtn_onclick = function(e) {
	const idxArrJson = gridView1.getCheckedJSON("chk");
	const idxArrIndex = gridView1.getCheckedIndex( "chk" );
	for( let i=0;i<idxArrJson.length;i++ ) {
		const fileName = idxArrJson[i].name;
		muc.removeFile( fileName );
	}
	dataList1.removeRows( idxArrIndex );
};

// 완료버튼 클릭시 실제 파일업로드 
scwin.upBtn_onclick = function(e) {
	muc.startUpload();
};

scwin.muc_ondone = function(data) {
	debugger;
	dataList1.removeAll();
	console.log(data);
};
	
scwin.muc_onprogress = function (data) {
	debugger;
};

scwin.muc_onComplete = function () {
	debugger;
};

scwin.muc_onerror = function (data) {
	debugger;
};

scwin.fileUploadOndone = function() {
	debugger;
};


]]></script>
			<style type="text/css"><![CDATA[ 

		]]></style>
    </head>
    <body ev:onpageload="scwin.onpageload" ev:onpageunload="scwin.onpageunload">
    <xf:group id="" style="padding: 10px">
    	<xf:trigger style="width: 80px;height: 23px;border-color:;" id="mUpBtn" type="button" ev:onclick="scwin.mUpBtn_onclick">
    		<xf:label><![CDATA[파일업로드]]></xf:label>
    	</xf:trigger>
    	<xf:trigger style="width: 80px;height: 23px;" id="delBtn" type="button" ev:onclick="scwin.delBtn_onclick">
    		<xf:label><![CDATA[파일삭제]]></xf:label>
    	</xf:trigger>
    	<xf:trigger style="width: 80px;height: 23px;" id="upBtn" type="button" ev:onclick="scwin.upBtn_onclick">
    		<xf:label><![CDATA[완료]]></xf:label>
    	</xf:trigger>
    	<w2:gridView id="gridView1" style="width: 1000px;height: 150px;margin-top: 10px;" scrollByColumn="false" defaultCellHeight="20"
    		scrollByColumnAdaptive="false" dataList="data:dataList1">
    		<w2:caption style="" id="caption1" value="this is a grid caption."></w2:caption>
    		<w2:header style="" id="header1">
    			<w2:row style="" id="row1">
    				<w2:column width="50" inputType="checkbox" style="height:20px" id="column7" displayMode="label" value="chk"></w2:column>
    				<w2:column width="200" inputType="text" style="height:20px;width:200px" id="column3" value="filename"
    					displayMode="label">
    				</w2:column>
    				<w2:column width="100" inputType="text" style="height:20px;width: 50px" id="column2" value="size" displayMode="label"></w2:column>
    				
    			</w2:row>
    		</w2:header>
    		<w2:gBody style="" id="gBody1">
    			<w2:row style="" id="row2">
    				<w2:column width="50" inputType="checkbox" style="height:20px" id="chk" displayMode="label"></w2:column>
    				<w2:column width="200" inputType="text" style="height:20px" id="name" displayMode="label"></w2:column>
    				<w2:column width="100" inputType="text" style="height:20px" id="displaySize" displayMode="label"></w2:column>
    			</w2:row>
    		</w2:gBody>
    	</w2:gridView>
		<w2:multiupload mode="html5_transparent" wmode="false" style="" id="muc" maxsize="52428800"
    		callbackSync ="false" uploadButton="" selectCallback="scwin.selectCallback" ev:ondone="scwin.muc_ondone" ev:onprogress="scwin.muc_onprogress" singleRequest="true" ev:onComplete="scwin.muc_onComplete" ev:onerror="scwin.muc_onerror">
    	</w2:multiupload>

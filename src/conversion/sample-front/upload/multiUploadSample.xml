        <w2:buildDate/>
        <xf:model>
            <xf:instance>
                <data xmlns=""/>
            </xf:instance>
            <w2:dataCollection baseNode="map">
            	<w2:dataList baseNode="list" repeatNode="map" id="dataList1" saveRemovedData="true">
            		<w2:columnInfo>
            			<w2:column id="chk" name="name4" dataType="text"></w2:column><w2:column id="name" name="filename" dataType="text"></w2:column>
            			<w2:column id="displaySize" name="size" dataType="text"></w2:column>
            			
            		</w2:columnInfo>
            	</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection>

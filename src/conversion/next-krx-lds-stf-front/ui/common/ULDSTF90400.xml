};

scwin.onpageunload = function () {
};

scwin.fn_list_sync = function () {
    let keyWord = ibx_Keyword.getValue();
    let condition1 = sbx_Cond.getValue();

    let url = "/api/discls/dsclinfo/select-list-help-content?";
    url += "condition1=" + condition1;
    url += "&condition2=3";
    url += "&keyword=" + keyWord;

    dlt_noticeList.setJSON();
    $c.sbm.setAction(sbm_noticeList, url);
    $c.sbm.execute(sbm_noticeList);
};

scwin.grd_List_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    if (columnId == 'saveFileNm') {
        let screnId = dlt_noticeList.getCellData(rowIndex, "screnId");             
        let url = "/api/discls/common/file/download";
        url += "?gubun=35&screnId=" + screnId;
        
        $p.download(url, {}, "get", true);
    }
};

scwin.btn_Search_onclick = function (e) {
    scwin.fn_list_sync();
};

scwin.ibx_Keyword_onkeydown = function (e) {
    if (window.event.keyCode == "13") {
        scwin.fn_list_sync();
    }
};

scwin.sbm_noticeList_submitdone = function (e) {
    grd_List.setFocusedCell(0, 0);
};

 */
scwin.fn_InitDs = function() {
    dlt_relatedCompanyListRes.setData([]);
};

/**
 *  조회조건 유효성 체크
 */
scwin.fn_ChkValid = function() {

    scwin.vKisCd = $p.parent().frame_head.getWindow().scwin.fn_GetKisCd();
    scwin.vAcntclsStrtDt = $p.parent().frame_head.getWindow().scwin.fn_GetAcntclsStrtDt();
    scwin.vAcntclsEndDt = $p.parent().frame_head.getWindow().scwin.fn_GetAcntclsEndDt();

    if (scwin.vKisCd == "" || scwin.vAcntclsStrtDt == "" || scwin.vAcntclsEndDt == "") {
        return false;
    }

    return true;

};

/**
 * 관계회사현황 조회
 */
scwin.fn_Search = async function() {

    //데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 체크.
    if (!scwin.fn_ChkValid()) {
        return;
    }

    dma_relatedCompanyInfoReq.set("kisCd", scwin.vKisCd);
    dma_relatedCompanyInfoReq.set("stdStrtDt", scwin.vAcntclsStrtDt);
    dma_relatedCompanyInfoReq.set("stdEndDt", scwin.vAcntclsEndDt);

    const res = await $c.sbm.execute(sbm_relatedCompany);
    dlt_relatedCompanyListRes.setJSON(res.responseJSON.body);

};

/**
 *  엑셀파일다운로드
 */
scwin.fn_excel_download = function() {

    if (dlt_relatedCompanyListRes.getTotalRow() <= 0) {
        alert("조회된 데이터가 없습니다.");
        return;
    }

    var options = {
        fileName : "관계회사현황",
        sheetName : "관계회사현황"
    };

    var infoArray = {};

    grd_relComStat.advancedExcelDownload(options, infoArray);

};]]></script>

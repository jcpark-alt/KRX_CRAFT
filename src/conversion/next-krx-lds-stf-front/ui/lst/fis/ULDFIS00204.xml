 *  현재 로딩된 페이지가 초기화되거나 종료될때(다른 화면으로 이동하거나 페이지를 닫기전) 발생하는 이벤트
 *  (주로 SPA(Single Page Application) 환경에서 전역 자원을 해제하거나 메모리 누수 방지)
 */
scwin.onpageunload = function() {
};

/**
 *  화면 초기화
 */
scwin.fn_Init = function() {

	// 결산일자 조회
    //결산일자 검색(FROM-TO)로 변경되어 아래 로직 삭제
	// frame.Provider("../frame_head").fn_SrchAcntclsDt();    
    scwin.fn_Search();

};

/**
 *  데이터셋 초기화
 */
scwin.fn_InitDs = function() {
    dlt_majorShareholderListRes.setData([]);
};

/**
 *  조회조건 유효성 체크
 */
scwin.fn_ChkValid = function() {

    // 필수항목 체크
	scwin.vKisCd = $p.parent().frame_head.getWindow().scwin.fn_GetKisCd();
	scwin.vAcntclsStrtDt = $p.parent().frame_head.getWindow().scwin.fn_GetAcntclsStrtDt();
	scwin.vAcntclsEndDt = $p.parent().frame_head.getWindow().scwin.fn_GetAcntclsEndDt();
		
	if( scwin.vKisCd == "" || scwin.vAcntclsStrtDt == "" || scwin.vAcntclsEndDt == "" ) {
	    return false;
	}

	return true;

};

/**
 * 주요주주 조회
 */
scwin.fn_Search = async function() {

    // 데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 체크 [임시주석 처리]
    if (!scwin.fn_ChkValid()) {
        return;
    }

    dma_majorShareholderInfoReq.set("kisCd", scwin.vKisCd);
    dma_majorShareholderInfoReq.set("stdStrtDt", scwin.vAcntclsStrtDt);
    dma_majorShareholderInfoReq.set("stdEndDt", scwin.vAcntclsEndDt);

    const res = await $c.sbm.execute(sbm_majorShareholder);
    dlt_majorShareholderListRes.setJSON(res.responseJSON.body);

};

/**
 *  엑셀파일다운로드
 */
scwin.fn_excel_download = function() {

    if (dlt_majorShareholderListRes.getTotalRow() <= 0) {
        alert("조회된 데이터가 없습니다.");
        return;
    }

    var options = {
        fileName : "주요주주",
        sheetName : "주요주주"
    };

    var infoArray = {};

    grd_majShrhd.advancedExcelDownload(options, infoArray);

};

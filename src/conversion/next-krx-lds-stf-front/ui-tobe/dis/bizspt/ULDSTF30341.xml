///////// 1. 변수 및 선언 영역 /////////
scwin.pData = {};

///////// 2. 초기화 영역 /////////

/**
 * @method
 * @name onpageload
 * @description 화면 진입점 — 파라미터 수신, 초기화 후 Q&A 상세를 조회한다.
 * @returns {void}
 * @hidden N
 * @example (body ev:onpageload 바인딩으로 자동 호출)
 */
scwin.onpageload = function() {
    try {
        scwin.setCode();
        scwin.init();
        scwin.search();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30341.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////

/**
 * @method
 * @name btn_close_onclick
 * @description 닫기버튼 클릭 이벤트 — 팝업을 닫는다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example scwin.btn_close_onclick(e);
 */
scwin.btn_close_onclick = function (e) {
    try {
        $c.win.closePopup();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30341.btn_close_onclick" });
    }
};

/**
 * @method
 * @name btn_reply_onclick
 * @description 답변버튼 클릭 이벤트 — Q&A 답변 화면(ULDSTF30342)을 열고, 저장 시 팝업을 닫는다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example scwin.btn_reply_onclick(e);
 */
scwin.btn_reply_onclick = function (e) {
    try {
        dma_qna.setJSON(scwin.pData);
        dma_qna.set("mode", "I");
        // TODO Stage2: $c.frame 대체 불가(형제/절대 프레임 접근) — 프레임 구조 재설계 필요
        const res = $c.frame.CreateDialogFrame("ULDSTF30342", "/ui/dis/bizspt/ULDSTF30342.xml", "고객의소리 Q&A 답변", {"width": 600, "height": 630}, dma_qna.getJSON());

        if(res.saveFlag)    $c.win.closePopup({}, "scwin.fn_search");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30341.btn_reply_onclick" });
    }
};

/**
 * @method
 * @name grd_fileList_oncellclick
 * @description 첨부파일 그리드 셀 클릭 이벤트 — 파일명 컬럼 클릭 시 해당 첨부파일을 다운로드한다.
 * @param {Number} rowIndex 클릭한 행 인덱스
 * @param {Number} columnIndex 클릭한 컬럼 인덱스
 * @param {String} columnId 클릭한 컬럼 id
 * @returns {void}
 * @hidden N
 * @example scwin.grd_fileList_oncellclick(0, 1, "attachFileNm");
 */
scwin.grd_fileList_oncellclick = function (rowIndex, columnIndex, columnId) {
    try {
        const fileData = dlt_fileList.getRowJSON(rowIndex);
        const contnId = dma_qna.get("contnId");

        if(columnId === "attachFileNm"){
            let url = "/api/discls/common/file/download";
            url += "?gubun=2&contnId=" + contnId + "&contnAttachSeq=" + fileData.contnAttachSeq;

            $p.download(url, {}, "get", true);
        }
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30341.grd_fileList_oncellclick" });
    }
};

///////// 5. 일반/업무 함수 영역 /////////

/**
 * @method
 * @name setCode
 * @description 부모 화면에서 전달받은 파라미터를 수신하여 scwin.pData에 세팅한다.
 * @returns {void}
 * @hidden N
 * @example scwin.setCode();
 */
scwin.setCode = function(){
    scwin.pData = $c.data.getParameter();
    console.log(scwin.pData);
};

/**
 * @method
 * @name init
 * @description 초기화 — 답변여부 항목을 숨기고, 이미 답변된 경우 답변버튼을 숨긴다.
 * @returns {void}
 * @hidden N
 * @example scwin.init();
 */
scwin.init = function(){
    txb_REPLY_YN.hide();

    if(dma_qna.get("replyYn") === "Y")  btn_reply.hide();
};

/**
 * @method
 * @name search
 * @description Q&A 상세정보 조회 — 상세 조회 submission을 실행한다.
 * @returns {void}
 * @hidden N
 * @example scwin.search();
 */
scwin.search = function(){

    // $c.sbm.execute(sbm_getQnaDetailInfo, scwin.pData);
};
]]></script>

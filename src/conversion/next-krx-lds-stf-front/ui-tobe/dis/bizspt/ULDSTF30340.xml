		<script type="text/javascript" lazy="false"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.cmCdObj = {};
scwin.tDay = $c.date.getServerDateTime();       // 오늘일자 yyyyMMdd
scwin.market = $c.stf.getUserInfo("market");    // 시장
scwin.depCd = $c.stf.getUserInfo("depCd");      // 부서코드

// page onload

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
    try {
        scwin.init();

    	// 검색조건으로 목록 조회
        scwin.search();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30340.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////
// 검색 버튼 이벤트
scwin.btn_search_onclick = function (e) {
    try {
        scwin.search();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30340.btn_search_onclick" });
    }
};

// 그리드 내 cell 더블클릭 이벤트 함수
scwin.grd_list_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    try {
    
        // 제목이면 Q&A 수정 팝업 띄우기
        if(columnId === "title")    scwin.fnOpenPopup(rowIndex);
	
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30340.grd_list_oncelldblclick" });
    }
};

// 기간선택 변경 이벤트
scwin.cmb_PeriodTp_onviewchange = function (info) {
    try {
        let selVal = info.newValue;
        $c.stf.setFromToDate(selVal, edt_SDate, edt_EDate);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30340.cmb_PeriodTp_onviewchange" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
// 목록조회 submission 완료 이벤트
scwin.sbm_getQnaList_submitdone = function (e) {

    let testData = [
        {
            "contnId" : "1"
            , "ansObjContnId" : "0"
            , "title" : "qna 질문 팝업가기"
        }
        , {
            "contnId" : "2"
            , "ansObjContnId" : "21"
            , "title" : "qna 질문 답변 팝업 가기"
        }
    ];

    dlt_list.setJSON(testData);

    // 총 건수 세팅
    panel_page.setTitle(dlt_list.getRowCount());
};

// 공통코드 목록 조회
scwin.sbm_getCmCdList_submitdone = function (e) {

    if(e.responseJSON.success)
    {
        let comp = $p.getComponentById(scwin.cmCdObj.dataList);
        comp.setJSON(e.responseJSON.body);
    }
};

///////// 5. 일반/업무 함수 영역 /////////
// 초기화
scwin.init = function() {

    // 공통코드 조회
    scwin.setCmCd();
    
    // 검색조건 내 시작일, 종료일 세팅
    edt_SDate.setValue($c.date.addMonth(scwin.tDay, -12));
    edt_EDate.setValue(scwin.tDay);

}

// 공통코드 조회
scwin.setCmCd = async function(){
    
    const cmCdObjArr = [
        {"cdEngNm" : "QUES_BZ_TP_CD", "type" : "R", "dataList" : "dlt_quesBzTpCdList"}  // 업무구분
        , {"cdEngNm" : "ANS_PROG_STAT_CD", "type" : "R", "dataList" : "dlt_ansProgStatCdList"}  // 진행상황
    ];

    // 업무구분초기화
    for(scwin.cmCdObj of cmCdObjArr){
        await $c.sbm.execute(sbm_getCmCdList, scwin.cmCdObj);
    }
    return;
}

// 검색조건으로 목록 조회
scwin.search = function() { // fn_list_sync

    // 검색조건 내 시작일, 종료일 기간 체크
    if(!scwin.fnDateCheck()) return;

    // 시장감시부?
    if(scwin.depCd.substr(0,1) === "5") dma_search.set("quesBzTpCd", "3");

    // 목록 조회
    // $c.sbm.execute(sbm_getQnaList);
    scwin.sbm_getQnaList_submitdone();

}

// 검색조건 내 시작일, 종료일 기간 체크
scwin.fnDateCheck = function() {    // scwin.dateCheck()
    let eDate = edt_EDate.getValue();
    let sDate = edt_SDate.getValue();
    let rtnVal = true;

    let diffDays = $c.date.diffDate(sDate, eDate);

    if(diffDays < 0)
    {
        $c.win.alert("[조회기간 시작일은 종료일보다 작아야 합니다.] 다시 입력해주세요");

        dma_search.set("dateS", scwin.tDay);
        dma_search.set("dateE", scwin.tDay);

        rtnVal = false;
    }

    return rtnVal;
}

// Q&A 질문, 답변 팝업 오픈
scwin.fnOpenPopup = async function(rowIndex) {

    let rowData = dlt_list.getRowJSON(rowIndex);
    let ansFlag = rowData.ansObjContnId === "0";

    let popupId = ansFlag? "ULDSTF30341" : "ULDSTF30342";

    let url = "/ui/dis/bizspt/" +popupId +".xml";

    const opts = {
        id: popupId
        , popupName: "고객의소리 Q&A " + (ansFlag? "질문" : " 답변")
        , width: 1080
        , height: 679
        , frameModal: "top"
    };

    let popupData = {
        "search" : dma_search.getJSON() // 검색조건 data
        , "row" : rowData // 그리드 행 선택 data
    };
    
    const res = await $c.win.openPopup(url, opts, rowData);
    
    // Q&A 등록,수정 화면에서 저장 버튼 클릭 했을때 
    if(res.saveFlag)    btn_search.click();

}
]]></script>

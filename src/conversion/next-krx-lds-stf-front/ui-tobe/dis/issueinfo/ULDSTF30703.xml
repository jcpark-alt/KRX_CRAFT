		<script type="text/javascript" lazy="false"><![CDATA[// hpage(신청내역-홈페이지), applRsltNm(신청내역-신청결과명) 리턴 결과 없는 항목
scwin.gEmpNo = $c.stf.getUserInfo($p, "empNo");
scwin.vScrenID = "ULDSTF30703.xml";
///////// 1. 변수 및 선언 영역 /////////
scwin.gLastJob = "";
scwin.vCORP_USR_REG_APPL_SEQ = "";

///////// 2. 초기화 영역 /////////
scwin.onpageload = function () {
    scwin.initPage();
};

scwin.onpageunload = function () {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.btn_Approv_onclick = function (e) {
    scwin.executeReissuePasswordApproval("Y");
};

scwin.btn_REJECT_onclick = function (e) {
    scwin.executeReissuePasswordApproval("N");
};

scwin.btn_Close_onclick = function (e) {
    $c.win.closePopup();
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_Save_submitdone = async function (e) {
    if (!e.responseJSON.success) {
        return;
    }

    let msg = $c.stf.getMessageParam("MSG-A001", scwin.gLastJob);
    await $c.win.alert(msg);
    $p.parent().scwin.fn_listReissuePassword();
    $c.win.closePopup();
};

///////// 5. 일반/업무 함수 영역 /////////
scwin.initPage = async function () {
    scwin.vAPCT_ID = $c.data.getParameter("apctId");
    scwin.vAPPL_DDTM = $c.data.getParameter("applDdtm");

    await scwin.readReissuePassword();    

    const vAPPL_RSLT_CD = ibx_APPL_RSLT_CD.getValue();
    if (vAPPL_RSLT_CD !== "R") {
        btn_Approv.hide(); // 승인버튼 숨기기.
        btn_REJECT.hide();
        grp_Appr.hide();

        if (vAPPL_RSLT_CD === "N") {
            txa_reject_rsn.setReadOnly(true);
            grp_reject.show("");// 거부사유 숨기기.
        } else {
            grp_reject.hide();// 거부사유 숨기기.
        }
    }

    ibx_EMP_NO.setValue(scwin.gEmpNo);
};

scwin.readReissuePassword = async function () {
    let url = "/api/discls/issueinfo/select-one-reissue-password";
    url += "?apctId=" + scwin.vAPCT_ID + "&applDdtm=" + scwin.vAPPL_DDTM;

    $c.sbm.setAction(sbm_Master, url)
    let ret = await $c.sbm.execute(sbm_Master);

    if (ret.responseJSON.success) {
        dma_Master.setJSON(ret.responseJSON.body);
    }
};

scwin.executeReissuePasswordApproval = async function (APPL_FLAG) {
    if (APPL_FLAG === "Y") {
        scwin.gLastJob = "승인";
    }
    else if (APPL_FLAG === "N") {
        if ($c.stf.checkMaxLength(txa_reject_rsn, 200, '거부사유') === false) {
            return;
        }

        scwin.gLastJob = "거부";
    }

    ibx_APPL_RSLT_CD.setValue(APPL_FLAG);

    let msg = $c.stf.getMessageParam("MSG-A006", scwin.gLastJob);
    let res = await $c.win.confirm(msg);
    if (res) {
        const sbmOptions = {
            id : "sbm_Save",
            action : "/api/discls/issueinfo/update-reissue-password-approval",
            ref : "dma_Master",
            isProcessMsg : false
        };

        const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
        scwin.sbm_Save_submitdone(sbmRtn);
    }
};
]]></script>

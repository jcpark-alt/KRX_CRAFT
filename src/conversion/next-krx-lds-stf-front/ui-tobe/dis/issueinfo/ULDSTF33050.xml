		<script type="text/javascript" lazy="false"><![CDATA[scwin.market = $c.stf.getUserInfo("market") || "";  //시장
scwin.vScrenID = "ULDSTF33050.xml";

// page onload

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
    $c.cm.fn_com_isur(acb_isurCd, ibx_isurCdNm);
    
    scwin.market = "9";
    dma_search.set("mktTpCd", scwin.market);

    // 시장구분 행 visible 세팅
    panel_mkt.visible(scwin.market === "9");

	// 검색조건으로 목록 조회
    scwin.search();

};

///////// 3. 컴포넌트 이벤트 영역 /////////
// 검색버튼 클릭 이벤트
scwin.btn_search_onclick = function (e) {
    scwin.search();
};

// 지주회사 구분 라디오버튼 변경 이벤트
scwin.rdo_parntcomKindTpCd_onviewchange = function (info) {

    let val = info.value;
    let disabled = (val === "1");

    // 회사코드, 회사명 초기화
    dma_search.set("isurCd", "");
    dma_search.set("isurCdNm", "");

    acb_isurCd.setReadOnly(!disabled);
    ibx_isurCdNm.setReadOnly(disabled);

    // acb_isurCd.setStyle("background-color", !disabled? "#b9d4f7" : "#ffffff");
    // ibx_isurCdNm.setStyle("background-color", disabled? "#b9d4f7" : "#ffffff");

};

//엑셀 다운로드 버튼 클릭 이벤트
scwin.btn_excel_onclick = function (e) {
    // $c.stf.doLogSave(scwin.vScrenID, $c.stf.info("SCREN_PROCS_TP_CD_07"), "");	

    const infoArr = [];
    const options = {
        fileName : "지주회사및자회사목록.xlsx" //[default : excel.xlsx] options.fileName 값이 없을 경우 default값 세팅
    };
    $c.data.downloadGridViewExcel(grd_list, options, infoArr); 
};

// 회사코드 검색버튼 클릭 이벤트
scwin.btn_isurCd_onclick = function (e) {
	
    $c.cm.IsurcdSearch(acb_isurCd, ibx_isurCdNm);
};

///////// 4. 서브미션 콜백 영역 /////////
// sbm 결과
scwin.sbm_getList_submitdone = function (e) {
    let res = e.responseJSON;
    let resultCnt = res.body.length;
    console.log(dlt_list.getAllJSON());

    panel_page.setValue(resultCnt);
};

///////// 5. 일반/업무 함수 영역 /////////
//검색조건으로 목록 조회
scwin.search = async function() { // fn_list_sync
    const sbmOptions = {
        id : "sbm_getList",
        action : "/api/discls/issueinfo/select-list-lnk-discls-isur_rel",
        method : "get",
        ref : "dma_search",
        target : "dlt_list=body",
        gridview : "grd_list",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_getList_submitdone(sbmRtn);
}
]]></script>

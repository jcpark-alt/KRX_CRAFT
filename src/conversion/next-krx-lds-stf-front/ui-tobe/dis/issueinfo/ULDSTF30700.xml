		<script type="text/javascript" lazy="false"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.vPAGENO = 0;
scwin.gDepCd = $c.stf.getUserInfo($p, "depCd");
scwin.gEmpNo = $c.stf.getUserInfo($p, "empNo");
scwin.gLdMktTp = $c.stf.getUserInfo($p, "market");
scwin.gBondYn = $c.stf.getUserInfo($p, "bondYn");
scwin.gIsurCd;

///////// 2. 초기화 영역 /////////
scwin.onpageload = function () {
    try {
        scwin.setCode();

        $c.cm.fn_com_isur(acb_ISUR_CD, ibx_COM_NM);

        scwin.init();
        scwin.listNewPassword();    
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.onpageload" });
    }
};

scwin.onpageunload = function () {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.pgl_list_onviewchange = function (info) {
    try {
        scwin.listNewPassword(info.newSelectedIndex);
        pgl_list.setSelectedIndex(info.newSelectedIndex);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.pgl_list_onviewchange" });
    }
};

scwin.btn_Search_onclick = function (e) {
    try {
        scwin.listNewPassword();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.btn_Search_onclick" });
    }
};

scwin.sbx_PeriodTp_onchange = function (info) {
    try {
        const vTp = info.newValue;
        $c.stf.setFromToDate(vTp, ica_SDATE, ica_EDATE);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.sbx_PeriodTp_onchange" });
    }
};

scwin.btn_Excel_onclick = function (e) {
    try {
        $c.stf.doLogSave("ULDSTF30700.xml", $c.stf.info("SCREN_PROCS_TP_CD_07"), "");

        const infoArr = [];
        const options = {
            fileName: "비밀번호신규 목록.xlsx" // [default : excel.xlsx] options.fileName 값이 없을 경우 default값 세팅
        };
        $c.data.downloadGridViewExcel(grd_Grid, options, infoArr);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.btn_Excel_onclick" });
    }
};

scwin.sbx_PerPage_onchange = function (info) {
	try {
		scwin.vCurrPageNo = 1;
	} catch (ex) {
		$c.exception.handleError(ex, { context : "ULDSTF30700.sbx_PerPage_onchange" });
	}
};

scwin.btn_ISUR_CD_onclick = function (e) {
    try {
        // 2009.09.01 채권공시관련 - 채권법인검색창    
        if (scwin.gBondYn === "Y") {
            $c.cm.IsurcdSearchBond(acb_ISUR_CD, ibx_COM_NM);
        } else {
            $c.cm.IsurcdSearch(acb_ISUR_CD, ibx_COM_NM);
        }
    
        // $c.cm.IsurcdSearch_IR(ibx_COM_NM, ibx_COM_NM);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.btn_ISUR_CD_onclick" });
    }
};

scwin.grd_Grid_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    try {
        scwin.readNewPassword(rowIndex, columnId);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.grd_Grid_oncelldblclick" });
    }
};

scwin.acb_ISUR_CD_onviewchange = function (info) {
    try {
        $c.cm.fn_com_Confirm_set();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.acb_ISUR_CD_onviewchange" });
    }
};

scwin.acb_ISUR_CD_oneditkeyup = function (info, e) {
    try {
        if (info.newValue === "") {
            txb_com_abbrv.setValue("");
        } 
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30700.acb_ISUR_CD_oneditkeyup" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_CorpUsrTpCd_submitdone = function (e) {
    // 채권상장신청자 제거
    dlt_CorpUsrTpCd.setBroadcast(false);
    for (let i = 0; i < dlt_CorpUsrTpCd.getRowCount(); i++) {
        if (dlt_CorpUsrTpCd.getCellData(i, "value") === "71") {
            dlt_CorpUsrTpCd.removeRow(i);
            break;
        }
    }
    dlt_CorpUsrTpCd.setBroadcast(true, true);
    sbx_CORP_USR_TP_CD.setValue("");
};

scwin.sbm_ApplRsltCd_submitdone = function (e) {

};

scwin.sbm_PassList_submitdone = function (e) {
    if (!e.responseJSON.success) {
        // $c.win.alert(e.responseJSON.errors);
        return;
    }

    if (e.responseJSON.body.page === 1) {
        scwin.pageCount = $c.num.ceil(e.responseJSON.body.totalCount / sbx_PerPage.getValue());
        pgl_list.setCount(scwin.pageCount);
        spn_totalCnt.setValue($c.num.formatNumber(e.responseJSON.body.totalCount));
        grd_Grid.setStartRowNumber(0);
    } else {
        let startIdx = (scwin.vPAGENO - 1) * sbx_PerPage.getValue();
        grd_Grid.setStartRowNumber(startIdx);
    }

    grd_Grid.setFocusedCell(0, "integUsrId");
};

scwin.listNewPassword = async function (vPageNo) {
    scwin.vPAGENO = ($c.util.isEmpty(vPageNo) === true) ? 1 : vPageNo;

    /******************************************************************
        2009.09.01 채권공시관련 - 채권상장팀이면 시장구분을 '4'로 셋팅
    ******************************************************************/
    if (scwin.gBondYn === "Y") {
        dma_PassList.set("mktTpCd", "4");
    }

    dma_PassList.set("page", scwin.vPAGENO);

    const sbmOptions = {
        id : "sbm_PassList",
        action : "/api/discls/issueinfo/select-list-paging-new-password",
        method : "get",
        ref : "dma_PassList",
        target : "dlt_PassList=body.content",
        gridview : "grd_Grid",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_PassList_submitdone(sbmRtn);
};

///////// 5. 일반/업무 함수 영역 /////////
scwin.init = function () {
    // 한달전 날짜 : 20081110: 허기영 요구사항
    let vCurDate = $c.date.getServerDateTime();
    ica_SDATE.setValue($c.date.addMonth(vCurDate, -1)); // 한달전 날짜   
    ica_EDATE.setValue(vCurDate);
    rdo_MKT_ID.setValue(scwin.gLdMktTp);

    if (scwin.gLdMktTp !== "9") {
        grp_mkt.hide();
    }
};

scwin.setCode = async function () {
    $c.stf.comboCbDataSet(sbx_PerPage);

    let url = "/api/discls/common/code/select-list-code-value?type=R&cdEngNm=CORP_USR_TP_CD";
    $c.sbm.setAction(sbm_CorpUsrTpCd, url);
    $c.sbm.execute(sbm_CorpUsrTpCd);

    // 신청구분코드 셋팅
    let url2 = "/api/discls/common/code/select-list-code-value?type=R&cdEngNm=APPL_RSLT_CD";
    $c.sbm.setAction(sbm_ApplRsltCd, url2);
    $c.sbm.execute(sbm_ApplRsltCd);
};

scwin.readNewPassword = function (row, colid) {
    if (colid === "integUsrId") {
        let vINTEG_USR_ID = dlt_PassList.getCellData(row, "corpUsrRegApplSeq"); // SEQ
        let param = { integUsrId: vINTEG_USR_ID };

        const opts = {
            width: 580,
            height: 800,
            frameModal: "top",
        };

        // TODO Stage2: $c.frame 대체 불가(형제/절대 프레임 접근) — 프레임 구조 재설계 필요
        $c.frame.CreateDialogFrame("NEWPASS_READ", "/ui/dis/issueinfo/ULDSTF30701.xml", "비밀번호 신규조회", opts, param);
    } else if (colid === "comNm") {
        scwin.gIsurCd = dlt_PassList.getCellData(row, "isurCd");
        $c.stf.fn_PopupCorpInfo();
    }
};

scwin.openPre = async function () {
    const opts = {
        width: 370,
        height: 250,
        frameModal: "top",
    };

    // 예비심사청구인 등록
    // TODO Stage2: $c.frame 대체 불가(형제/절대 프레임 접근) — 프레임 구조 재설계 필요
    $c.frame.CreateDialogFrame("NEWPASS_READ", "/ui/dis/issueinfo/ULDSTF30704.xml", "예비심사청구인 등록", opts);
};

scwin.applRsltExp = function (data, formattedData, rowIdx, colIdx) {
    if (data === "미처리") {
        grd_Grid.setCellColor(rowIdx, colIdx, "red");
    }

    return formattedData;
};
]]></script>
	</head>

		<script type="text/javascript" lazy="false"><![CDATA[// hpage(신청내역-홈페이지), applRsltNm(신청내역-신청결과명) 리턴 결과 없는 항목
scwin.gEmpNo = $c.stf.getUserInfo($p, "empNo");
scwin.vScrenID = "ULDSTF30701.xml";
// 전역 변수 선언
scwin.gLastJob = "";
scwin.vCORP_USR_REG_APPL_SEQ = "";

// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function () {
    scwin.initPage();
};

scwin.onpageunload = function () {
};

// WebSquare 컴포넌트 이벤트 함수
scwin.btn_Approv_onclick = function (e) {
    scwin.executeNewPasswordApproval("Y");
};

scwin.btn_REJECT_onclick = function (e) {
    scwin.executeNewPasswordApproval("N");
};

scwin.btn_Close_onclick = function (e) {
    $c.win.closePopup();
};

// 일반 함수
scwin.initPage = async function () {
    scwin.vCORP_USR_REG_APPL_SEQ = $c.data.getParameter("integUsrId");

    await scwin.readNewPassword();

    const vAPPL_RSLT_CD = ibx_APPL_RSLT_CD.getValue();
    if (vAPPL_RSLT_CD !== "R") {
        btn_Approv.hide(); // 승인버튼 숨기기.
        btn_REJECT.hide();
        grp_Appr.hide();
    }

    ibx_EMP_NO.setValue(scwin.gEmpNo);
};

scwin.readNewPassword = async function () {
    let url = "/api/discls/issueinfo/select-one-new-password";
    url += "?corpUsrRegApplSeq=" + scwin.vCORP_USR_REG_APPL_SEQ;

    $c.sbm.setAction(sbm_MASTER, url)
    let ret = await $c.sbm.execute(sbm_MASTER);

    if (ret.responseJSON.success) {
        dma_MASTER.setJSON(ret.responseJSON.body);

        scwin.checkIsMM();
    }
};

scwin.check4MM = async function () {
    const mm_a = ibx_MM_A.getValue();
    const mm_b = ibx_MM_B.getValue();

    //시장조성자 번호는 필수임.
    if (mm_a === '') {
        await $c.win.alert('시장조성자 번호가 없습니다. 시스템담당자에게 문의 하십시오.');
        return false;
    } else {
        //발행기관에 시장조성자 번호가 있는경우,  승인시 신청한 시장조성자 번호로 업데이트 하지 않음.(시장조성자 번호가 발행기관에 없는 경우에만 처기하기 위하여)
        if (mm_b !== '') {
            let res = await $c.win.confirm('발행기관 테이블에 시장조성자 번호가 있는경우,<br>시장조성자 번호는 업데이트 하지 않습니다.<br>계속 진행하시겠습니까?');
            if (res) {
                return true;
            } else return false;
        } else return true;
    }
};

scwin.executeNewPasswordApproval = async function (APPL_FLAG) {
    let canGoNext = true;
    let usrTpCd = dma_MASTER.get("corpUsrTpCd");

    if (APPL_FLAG === "Y") {
        scwin.gLastJob = "승인";
        if (usrTpCd === '32') {
            if (!await scwin.check4MM()) {
                canGoNext = false;
            }
        }
    } else if (APPL_FLAG === "N") {
        scwin.gLastJob = "거부";
    }

    if (canGoNext) {
        ibx_APPL_RSLT_CD.setValue(APPL_FLAG);        
        let msg = $c.stf.getMessageParam("MSG-A006", scwin.gLastJob);
        let res = await $c.win.confirm(msg);
        if (res) {
            const sbmOptions = {
                id : "sbm_Save",
                action : "/api/discls/issueinfo/update-new-password-approval",
                ref : "dma_MASTER",
                submitDoneHandler : scwin.sbm_Save_submitdone,
                isProcessMsg : false
            };
            $c.sbm.executeDynamic(sbmOptions);
        }
    }
};

scwin.checkIsMM = function () {
    let usrTpCd = dma_MASTER.get("corpUsrTpCd");
    if (usrTpCd === '32') {
        grp_MM.show("");
    } else {
        grp_MM.hide();
    }
};

scwin.sbm_Save_submitdone = async function (e) {
    if (!e.responseJSON.success) {
        return;
    } 

    let msg = $c.stf.getMessageParam("MSG-A001", scwin.gLastJob);
    await $c.win.alert(msg);
    $p.parent().scwin.fn_listNewPassword();
    $c.win.closePopup();
};
]]></script>

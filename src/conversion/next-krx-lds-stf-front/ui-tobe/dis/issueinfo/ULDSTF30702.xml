		<script type="text/javascript" lazy="false"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.vPAGENO = 0;
scwin.gDepCd = $c.stf.getUserInfo($p, "depCd");
scwin.gEmpNo = $c.stf.getUserInfo($p, "empNo");
scwin.gLdMktTp = $c.stf.getUserInfo($p, "market");
scwin.gIsurCd;

///////// 2. 초기화 영역 /////////
scwin.onpageload = function () {
    try {
        scwin.setCode();

        scwin.init();
        $c.cm.fn_com_isur(acb_ISUR_CD, ibx_COM_NM); // 회사코드, 회사명 나중에???????
        scwin.listReissuePassword();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30702.onpageload" });
    }
};

scwin.onpageunload = function () {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.pgl_list_onviewchange = function (info) {
    try {
        scwin.listReissuePassword(info.newSelectedIndex);
        pgl_list.setSelectedIndex(info.newSelectedIndex);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30702.pgl_list_onviewchange" });
    }
};

scwin.btn_Search_onclick = function (e) {
    try {
        scwin.listReissuePassword();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30702.btn_Search_onclick" });
    }
};

scwin.btn_Excel_onclick = function (e) {
    try {
        $c.stf.doLogSave("ULDSTF30702.xml", $c.stf.info("SCREN_PROCS_TP_CD_07"), "");

        const infoArr = [];
        const options = {
            fileName: "비밀번호재발급 목록.xlsx" // [default : excel.xlsx] options.fileName 값이 없을 경우 default값 세팅
        };
        $c.data.downloadGridViewExcel(grd_Grid, options, infoArr);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30702.btn_Excel_onclick" });
    }
};

scwin.sbx_PeriodTp_onchange = function (info) {
    try {
        const vTp = info.newValue;
        $c.stf.setFromToDate(vTp, ica_SDATE, ica_EDATE);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30702.sbx_PeriodTp_onchange" });
    }
};

scwin.sbx_PerPage_onchange = function (info) {
	try {
		scwin.vCurrPageNo = 1;
	} catch (ex) {
		$c.exception.handleError(ex, { context : "ULDSTF30702.sbx_PerPage_onchange" });
	}
};

scwin.btn_ISUR_CD_onclick = function (e) {
    try {
        // 2009.09.01 채권공시관련 - 채권법인검색창
        if (scwin.gBondYn === "Y") {
            $c.cm.IsurcdSearchBond(acb_ISUR_CD, ibx_COM_NM);
        } else {
            $c.cm.IsurcdSearch(acb_ISUR_CD, ibx_COM_NM);
        }
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30702.btn_ISUR_CD_onclick" });
    }
};

scwin.grd_Grid_oncelldblclick = function (rowIndex, columnIndex, columnId) {
	try {
		scwin.readReissuePassword(rowIndex, columnId);
	} catch (ex) {
		$c.exception.handleError(ex, { context : "ULDSTF30702.grd_Grid_oncelldblclick" });
	}
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_RePassList_submitdone = function (e) {
    if (!e.responseJSON.success) {
        // $c.win.alert(e.responseJSON.errors);
        return;
    }

    if (e.responseJSON.body.page === 1) {
        scwin.pageCount = $c.num.ceil(e.responseJSON.body.totalCount / sbx_PerPage.getValue());
        pgl_list.setCount(scwin.pageCount);
        spn_totalCnt.setValue($c.num.formatNumber(e.responseJSON.body.totalCount));
        grd_Grid.setStartRowNumber(0);
    } else {
        let startIdx = (scwin.vPAGENO - 1) * sbx_PerPage.getValue();
        grd_Grid.setStartRowNumber(startIdx);
    }

    grd_Grid.setFocusedCell(0, "integUsrId");
};

scwin.listReissuePassword = async function (vPageNo) {
    scwin.vPAGENO = ($c.util.isEmpty(vPageNo) === true) ? 1 : vPageNo;

    /******************************************************************
        2009.09.01 채권공시관련 - 채권상장팀이면 시장구분을 '4'로 셋팅
    ******************************************************************/
    if (scwin.gBondYn === "Y") {
        dma_RePassList.set("mktId", "4");
    }

    dma_RePassList.set("page", scwin.vPAGENO);

    const sbmOptions = {
        id : "sbm_RePassList",
        action : "/api/discls/issueinfo/select-list-paging-reissue-password",
        method : "get",
        ref : "dma_RePassList",
        target : "dlt_RePassList=body.content",
        gridview : "grd_Grid",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_RePassList_submitdone(sbmRtn);
};

///////// 5. 일반/업무 함수 영역 /////////
scwin.init = function () {
    // 한달전 날짜 : 20081110: 허기영 요구사항
    let vCurDate = $c.date.getServerDateTime();
    ica_SDATE.setValue($c.date.addMonth(vCurDate, -1)); // 한달전 날짜
    ica_EDATE.setValue(vCurDate);
    rdo_MKT_ID.setValue(scwin.gLdMktTp);

    // ica_SDATE.setValue("20250101"); // 한달전 날짜

    if (scwin.gLdMktTp !== "9") {
        grp_mkt.hide();
    }
};

scwin.setCode = function () {
    $c.stf.comboCbDataSet(sbx_PerPage);

    let url = "/api/discls/common/code/select-list-code-value?type=R&cdEngNm=CORP_USR_TP_CD";
    $c.sbm.setAction(sbm_CorpUsrTpCd, url);
    $c.sbm.execute(sbm_CorpUsrTpCd);

    // 신청구분코드 셋팅
    let url2 = "/api/discls/common/code/select-list-code-value?type=R&cdEngNm=APPL_RSLT_CD";
    $c.sbm.setAction(sbm_ApplRsltCd, url2);
    $c.sbm.execute(sbm_ApplRsltCd);
};

scwin.readReissuePassword = function (row, colid) {
    if (colid === "apctId") {
        const vAPCT_ID = dlt_RePassList.getCellData(row, "apctId");
        const vAPPL_DDTM = dlt_RePassList.getCellData(row, "applDdtm");

        let param = {
            apctId: vAPCT_ID,
            applDdtm: vAPPL_DDTM
        };

        const opts = {
            width: 580,
            height: 800,
            frameModal: "top",
        };

        // TODO Stage2: $c.frame 대체 불가(형제/절대 프레임 접근) — 프레임 구조 재설계 필요
        $c.frame.CreateDialogFrame("NEWPASS_READ", "/ui/dis/issueinfo/ULDSTF30703.xml", "비밀번호 재발급조회", opts, param);
    } else if (colid === "comNm") {
        scwin.gIsurCd = dlt_RePassList.getCellData(row, "isurCd");
        $c.stf.fn_PopupCorpInfo();
    }
};

scwin.applRsltExp = function (data, formattedData, rowIdx, colIdx) {
    if (data === "미처리") {
        grd_Grid.setCellColor(rowIdx, colIdx, "red");
    }

    return formattedData;
};
]]></script>

		<script type="text/javascript" lazy="false"><![CDATA[scwin.gDepCd = $c.stf.getUserInfo($p, "depCd");
scwin.gEmpNo = $c.stf.getUserInfo($p, "empNo");
scwin.gLdMktTp = $c.stf.getUserInfo($p, "market");
scwin.gBondYn = $c.stf.getUserInfo($p, "bondYn");

scwin.vScrenID = "ULDSTF30402.xml";
///////// 1. 변수 및 선언 영역 /////////
scwin.pageSize = 10; //페이지 size
scwin.totalCnt = 0; //전체 row
scwin.pageNoCnt = 10; //page 번호 개수
scwin.vCurrPageNo = 1; //현재 선택된 페이지번호

///////// 2. 초기화 영역 /////////
scwin.onpageload = function () {
    scwin.setCode();
    scwin.initPage();
    scwin.listDsclBbs();
};

scwin.onpageunload = function () {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.sbx_PeriodTp_onchange = function (info) {
    const vTp = sbx_PeriodTp.getValue();
    $c.stf.setFromToDate(vTp, ica_SDATE, ica_EDATE);
};

scwin.sbx_PerPage_onchange = function (info) {
    scwin.vCurrPageNo = 1;
};

scwin.btn_Search_onclick = function (e) {
    scwin.listDsclBbs();
};

scwin.grd_Grid_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    scwin.readDsclBbs(rowIndex, columnId);
};

scwin.btn_New_onclick = function (e) {
    scwin.new();
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_Select_submitdone = function (e) {
    if (!e.responseJSON.success) {
        return;
    }

    if (e.responseJSON.body.page === 1) {
        scwin.pageCount = $c.num.ceil(e.responseJSON.body.totalCount / sbx_PerPage.getValue());
        pgl_list.setCount(scwin.pageCount);
        tbx_totalCnt.setValue($c.num.formatNumber(e.responseJSON.body.totalCount));
        grd_Grid.setStartRowNumber(0);
    } else {
        let startIdx = (scwin.vPAGENO - 1) * sbx_PerPage.getValue();
        grd_Grid.setStartRowNumber(startIdx);
    }

    grd_Grid.setFocusedCell(0, 0);
};

///////// 5. 일반/업무 함수 영역 /////////
scwin.initPage = function () {
    // code default value setting
    // 1. 날짜 기본 6개월.
    const ToDay = $c.date.getServerDateTime();
    ica_EDATE.setValue(ToDay);
    const vSDATE = $c.date.addDate(ToDay, -6);
    ica_SDATE.setValue(vSDATE);
    rdo_mkt_gubun.setValue(scwin.gLdMktTp);

    if (scwin.gBondYn === 'Y') {
        rdo_mkt_gubun.setValue("4");
    }

    if (scwin.gLdMktTp === "9") {
        grp_mkt_gubun.show("");
    } else {
        grp_mkt_gubun.hide();
    }
};

scwin.listDsclBbs = function () {
    let url = "/IntegratedBBS.do?method=listDsclBbs";
    url += "&MKT_ID=" + rdo_mkt_gubun.getValue();
    url += "&KEYWORD_FLAG=" + sbx_KEYWORD.getValue();
    url += "&KEYWORD=" + ibx_KEYWORD.getValue();
    url += "&SDATE=" + ica_SDATE.getValue();
    url += "&EDATE=" + ica_EDATE.getValue();
    url += "&EMP_NM=" + ibx_EMP_NM.getValue();
    url += "&MENU_FLAG=" + sbx_MENU_FLAG.getValue();
    url += "&PAGENO=" + scwin.vCurrPageNo;
    url += "&PAGESIZE=" + sbx_PerPage.getValue();
    url += "&PDS=Y"; // 자료실 포함여부.(관리자일때만 자료실을 표시함.)

    $c.sbm.setAction(sbm_Select, url);
    $c.sbm.execute(sbm_Select); 
};

scwin.setCode = function () {
    $c.stf.comboCbDataSet(sbx_PerPage);
};

scwin.readDsclBbs = function (row, colid) {
    if (colid === "title") {
        let CONTN_ID = dlt_Grid.getCellData(row, "contnId");
        let param = { contnId: CONTN_ID };

        const opts = {
            width: 1000,
            height: 830,
            frameModal: "top",
        };

        frame.CreateDialogFrame("INTEBBS_READ", "/ui/dis/dsclinfo/ULDSTF30403.xml", "제도해설등 조회", opts, param);
    }
};

scwin.new = function () {
    let param = null;

    const opts = {
        width: 1000,
        height: 830,
        frameModal: "top",
    };

    $c.frame.CreateDialogFrame("INTEBBS_NEW", "/ui/dis/dsclinfo/ULDSTF30403.xml", "제도해설등 신규", opts, param);
};
]]></script>

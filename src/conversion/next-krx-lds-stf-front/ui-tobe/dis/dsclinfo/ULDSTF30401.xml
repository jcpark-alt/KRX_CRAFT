		<script type="text/javascript" lazy="false"><![CDATA[
scwin.vScrenID = "ULDSTF30401.xml";
// 전역 변수 선언
scwin.market = "";  // 시장
scwin.bondYn = "";  // 채권상장팀 여부
scwin.tDay = $c.date.getServerDateTime();  // 오늘일자 yyyyMMdd

let regPw = ""; // 등록된 비밀번호
let pData = {}; // 부모화면에서 넘어온 데이터

const crudList = [
    {"gubun" : "02", "confirmMsgStr" : "입력", "successMsgStr" : "등록", "apiUrl" : "/api/discls/dsclinfo/insert-notice-content"}   // 02 : SCREN_PROCS_TP_CD_02
    , {"gubun" : "03", "confirmMsgStr" : "수정", "successMsgStr" : "수정", "apiUrl" : "/api/discls/dsclinfo/update-notice-content"}   // 03 : SCREN_PROCS_TP_CD_03
    , {"gubun" : "04", "confirmMsgStr" : "삭제", "successMsgStr" : "삭제", "apiUrl" : "/api/discls/dsclinfo/delete-notice-content"}   // 04 : SCREN_PROCS_TP_CD_04
    ];

let crudObj = {};       // 등록, 수정, 삭제 object
let delFileList = [];   // 삭제 할 파일 목록

// page onload

// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function() {
    pData = $c.data.getParameter().pData; //부모화면에서 넘어온 데이터
    scwin.market = $c.stf.getUserInfo("market");
    
    if($c.util.isEmpty(pData))    return;
    else
    {
        // 컴포넌트 초기화
        scwin.compInit();

        // 부모화면에서 가져온 regFlag가 true인경우 (= 입력 버튼  클릭)
        if(pData.regFlag)
        {
            // 시장구분 행 visible 세팅
            pnl_mkt_gubun.visible(scwin.market === "9");

            //삭제버튼 visible false
            btn_delete.visible(false);

            //채권공시관련
            scwin.bondYn = $c.stf.getUserInfo("bondYn");

            let mktNm = "";

            if(scwin.bondYn === "Y")    mktNm = "(채)";
            else if(scwin.market === "1") mktNm = "(유)";
            else if(scwin.market === "2") mktNm = "(코)";

            //등록자 data setting
            dma_notice.set("wrtrEmpNm", mktNm + $c.stf.getUserInfo("depNm"));

        }else   // 수정버튼 클릭 시 
        {
            // 공지사항 내용 조회
            $c.sbm.execute(sbm_getNoticeDetail, pData.row);
        }
    }
};

// WebSquare 컴포넌트 이벤트 함수
// 취소 버튼 이벤트
scwin.btn_cancel_onclick = function (e) {
    $c.win.closePopup({"saveFlag": false});
};

// 공지대상시스템 checkbox 변경 이벤트
scwin.chk_notiObjSysCd_onviewchange = function (info) {
    let chk = info.checked;
    let val = info.value;

    scwin.notiObjSysTpCdChange(chk, val);
};

// 공지구분 라디오버튼 클릭 이벤트
scwin.rdo_bbs_tp_cd_onviewchange = function (info) {
    let val = info.value;   // 선택값
    
    rdo_mkt_gubun.setDisabled(false);

    // 밸류업 인 경우
    if(val === "60")
    {
        dma_notice.set("mktTpCd", "9");
        rdo_mkt_gubun.setDisabled(true);
        pnl_mkt_gubun.visible(true);
    }else
    {
        if(pData.regFlag)
        {
            dma_notice.set("mktTpCd", scwin.market);
            
            if(scwin.market === "9")
            {
                dma_notice.set("mktTpCd", "9");
                pnl_mkt_gubun.visible(true);
            }
        }
    }
};

// 파일 추가 클릭 이벤트
scwin.btn_fileAdd_onclick = function (e) {
	let listCnt = dlt_fileList.getRowCount();

    if(listCnt === 5){
        $c.win.alert("더이상 추가하실 수 없습니다.");
        return;
    }

    $c.win.alert("개발예정");
    return;
};

// 파일 삭제 클릭 이벤트
scwin.btn_fileRemove_onclick = function (e) {
    //초기화
    delFileList = [];
    
    // 삭제할 파일 list set
    delFileList = dlt_fileList.getMatchedJSON("chk", "T")

    // 그리드에서 행 삭제
    let chkIdxs = dlt_fileList.getMatchedIndex("chk", "T");
    dlt_fileList.removeRows(chkIdxs);

};

// 저장 버튼 클릭 이벤트
scwin.btn_save_onclick = function (e) {
    scwin.valid(pData.regFlag? "02" : "03");
};

// 삭제버튼 이벤트 함수
scwin.btn_delete_onclick = function (e) {
    scwin.valid("04");
};

scwin.mcu_file_ondone = function (data) {
    console.log("mcu_file_ondone::data:",data);

};

scwin.mcu_file_oncomplete = function () {
	console.log("mcu_file_onComplete");
};

// 파일목록 그리드 oncell click 이벤트
scwin.grd_fileList_oncellclick = function (rowIndex, columnIndex, columnId) {
    let fileData = dlt_fileList.getRowJSON(rowIndex);
    let contnId = dma_notice.get("contnId");

	if(columnId === "attachFileNm"){
        let url = "/api/discls/common/file/download";
        url += "?gubun=2&contnId=" + contnId + "&contnAttachSeq=" + fileData.contnAttachSeq;
        
        $p.download(url, {}, "get", true);
    }
};

// 일반 함수
// 컴포넌트 초기화
scwin.compInit = function() {

    //공지대상시스템 inputbox hide
    if(!ibx_notiObjSysCd.hasClass("hide"))  ibx_notiObjSysCd.addClass("hide");

    // 시장구분 
    if(scwin.market === "9")    pnl_mkt_gubun.visible(false);
    dma_notice.set("mktTpCd", scwin.market); // data setting

    // 공지구분 
    pnl_valueup.visible(false); 
    dma_notice.set("bbsTpCd", "03");

    //담당기관 visible
    pnl_kclic.visible(false);

}

// 시장구분값 visible
scwin.mktGubunVisible = function(flag) {
    if(scwin.market === "9")    pnl_mkt_gubun.visible(flag);
}

// 공지대상시스템 checkbox 함수
scwin.notiObjSysTpCdChange = function(chkFlag, val){

    switch (val) 
    {
        case "2":   // 조회(국문)
            pnl_valueup.visible(chkFlag);          // 공지구분 tr 
            break;
            
        case "D":   // 조회(영문)
            pnl_valueup.visible(chkFlag);       // 공지구분 tr 
            rdo_bbs_tp_cd.setValue("60");   // 공지구분값 세팅
            
            let chkArr = chk_notiObjSysCd.getValue(",").split(",");    // checked data
            let rslt = chkArr.includes(val);
            
            if(chkArr.length > 1 && rslt){
                $c.win.alert("조회(영문)시스템은 다른 시스템과 같이 사용할 수 없습니다.", () => {
                    chk_notiObjSysCd.setValue(val); //다른 체크박스는 체크 해제
                });
            }
 
            let allData = dlt_notiObjSysCd.getAllJSON();

            allData.forEach((item, idx) => {
                // unchecked 되면 다른 항목들도 enable
                chk_notiObjSysCd.setItemDisabled(idx, chkFlag? (item.code !== val) : chkFlag);  
            });
            
            break;

        case "3": case "1": // 처리시스템, 제출(국문)
            
            scwin.mktGubunVisible(chkFlag);
            break;
            
        case "B": //K-CLIC
            scwin.mktGubunVisible(chkFlag);
            pnl_kclic.visible(chkFlag);    // 담당기관

            break;
        default:
            break;
    }

}

// 저장, 삭제 시 유효성 체크
scwin.valid = function(val) {
    
    crudObj = crudList.find(item => item.gubun === val);

    const valInfo = [
        { id: "notiObjSysTpCd", mandatory: pData.regFlag }               // 공지대상시스템코드
        , { id: "wrtrEmail", mandatory: true, isEmail : true }  // 이메일
        , { id: "pw", mandatory: pData.regFlag }                         // 비밀번호
        , { id: "notiStrtDd", mandatory: true }                 // 게시물적용시작일
        , { id: "title", mandatory: true }                      // 제목
        , { id: "contnMaindocContn", mandatory: true }          // 내용
    ];

    if ($c.data.validateGroup(grp_table, valInfo)) 
    {
        let valid = true;

        // 등록인 경우
        if(crudObj.gubun === "02")
        {
            
            let notiObjSysCd = dma_notice.get("notiObjSysTpCd");

            // 공지대상시스템 체크값에 K-CLIC값(=B) 이 있으면
            if(notiObjSysCd.includes("B"))
            {
                if($c.util.isEmpty(dma_notice.get("chrgInstId")))
                {
                    $c.win.alert("[공지대상 시스템]이 K-CLIC 일경우 담당기관을 선택해주세요.", () => {cmb_chrg_inst.focus();});
                    valid = false;
                    return;
                }
            }

            //공지대상시스템 체크값이 조회(국문)(=2) 이고, 공지구분값이 밸류업(=60) 인 경우
            if(notiObjSysCd.includes("2") && dma_notice.get("bbsTpCd") === "60")
            {
                if(notiObjSysCd.length > 1) 
                {
                    $c.win.alert("[공지대상 시스템]이 조회(국문)이면서 밸류업일 경우 다른 시스템과 함께 사용할 수 없습니다. ", () => {chk_notiObjSysCd.focus(); });
                    valid = false;
                    return;
                }
            }
        }else   //수정 or 삭제인 경우
        {

            if(dma_notice.get("pw") !== regPw)
            {
                $c.win.alert("[비밀번호]를 잘못 입력하셨습니다.", () => {tbox_password.focus();});
                valid = false;
                return;
            }
        }

        if(valid)
        {
            $c.win.confirm("위사항을 "+ crudObj.confirmMsgStr +" 하시겠습니까?", (res) => {
                if (res.clickValue)
                {
                    //조회(영문)일 , 밸류업일 경우 bbs_tp_cd = 61 이다
                    if(dma_notice.get("notiObjSysTpCd") === "D")    dma_notice.set("bbsTpCd", "61");

                    // 적용 끝일자가 없으면 자동으로 99991231 입력한다.
                    if($c.util.isEmpty(dma_notice.get("notiEndDd")))    dma_notice.set("notiEndDd", "99991231");
                    
                    //삭제인 경우 submission
                    if(crudObj.gubun === "04")
                    {
                        $c.sbm.setAction(sbm_transNotice, crudObj.apiUrl);
                        $c.sbm.execute(sbm_transNotice, dma_notice.getJSON());

                    }else   // 등록, 수정은 startUpload
                    {
                        let paramData = dma_notice.getJSON();
                        paramData.deleteFiles = delFileList;    // 수정용 삭제파일list 추가

                        mcu_file.changeAction(crudObj.apiUrl);
                        mcu_file.setParam(0, "data", JSON.stringify(paramData));

                        mcu_file.startUpload();

                    }
                }
            });
        }
    }
}

// 공지사항 상세조회 submission 결과
scwin.sbm_getNoticeDetail_submitdone = function (e) {
    regPw = "";

    if(e.responseJSON.success)
    {
        let mergeData = {...pData.row, ...e.responseJSON.body};

        // dma_notice set 
        dma_notice.setJSON(mergeData);

        // dma_fileList set
        dlt_fileList.setJSON(mergeData?.attachFileInfoList?? []);

        // 공지대상시스템 checkbox click
        scwin.notiObjSysTpCdChange(true, dma_notice.get("notiObjSysTpCd"));

        // 공지대상 inputbox show, 공지대상시스템 체크박스 hide
        ibx_notiObjSysCd.removeClass("hide");
        chk_notiObjSysCd.addClass("hide");

        // 비밀번호 초기화
        regPw = dma_notice.get("pw");
        dma_notice.set("pw", ""); 

    }
};

// 등록, 수정, 삭제 submission 결과
scwin.sbm_transNotice_submitdone = function (e) {

    let msgCd = (e.responseJSON.success)? "MSG-A001" : "MSG-A002";

    $c.win.alert($c.stf.getMessageParam(msgCd, "공지사항" + crudObj.successMsgStr), () => {
        if(e.responseJSON.success)  $c.win.closePopup({"saveFlag": true});
        return;
    });
};


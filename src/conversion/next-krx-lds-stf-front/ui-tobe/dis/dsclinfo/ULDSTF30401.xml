scwin.selectCallback = function() {
    let fileInfos = mcu_file.getFileInfos();

    const fileList = fileInfos.map(({name, size, ...f}) => ({
        ...f
        , "attachFileNm" : name
        , "attachFileSz" : size
    }));
    
    dlt_fileList.setJSON(fileList, true);
}

		<script type="text/javascript" lazy="false"><![CDATA[
scwin.tDay = $c.date.getServerDateTime();  // 오늘일자 yyyyMMdd
scwin.market = $c.stf.getUserInfo("market");  // 시장

// page onload

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
    try {
        // 초기화
        scwin.init();

    	// 검색조건으로 목록 조회
        scwin.search();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30400.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////
// 검색 버튼 이벤트
scwin.btn_search_onclick = function (e) {
    try {
        scwin.search();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30400.btn_search_onclick" });
    }
};

// 입력버튼 클릭 이벤트
scwin.btn_input_onclick = function(e) {
    try {
        // 공지사항 입력 팝업 띄우기
        scwin.fnOpenPopup(-1);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30400.btn_input_onclick" });
    }
};

// 그리드 내 cell 더블클릭 이벤트 함수
scwin.grd_info_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    try {
    
        // 제목이면 공지사항 수정 팝업 띄우기
        if(columnId === "title")    scwin.fnOpenPopup(rowIndex);
	
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30400.grd_info_oncelldblclick" });
    }
};

// 기간선택 변경 이벤트
scwin.cmb_PeriodTp_onviewchange = function (info) {
    try {
        let selVal = info.newValue;
        $c.stf.setFromToDate(selVal, edt_SDate, edt_EDate);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30400.cmb_PeriodTp_onviewchange" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
// 목록조회 submission 완료 이벤트
scwin.sbm_getNoticeList_submitdone = function (e) {

    // 총 건수 세팅
    panel_page.setValue(dlt_noticeList.getRowCount());
};

// 검색조건으로 목록 조회
scwin.search = async function() { // fn_list_sync

    // 검색조건 내 시작일, 종료일 기간 체크
    if(!scwin.fnDateCheck()) return;

    // 로그인 한 사용자가 채권상장팀이면 시장구분값 4, 아니면 라디오버튼 선택값으로 세팅
    let selMtkId = (scwin.bondYn === "Y")? "4" : dma_search.get("mktTpCd");
    dma_search.set("mktTpCd", selMtkId);

    // 목록 조회
    const sbmOptions = {
        id : "sbm_getNoticeList",
        action : "/api/discls/dsclinfo/select-list-notice-content",
        method : "get",
        ref : "dma_search",
        target : "dlt_noticeList=body",
        gridview : "grd_info",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.sbm_getNoticeList_submitdone(sbmRtn);

}

///////// 5. 일반/업무 함수 영역 /////////
scwin.init = function() {

    // 검색조건 내 시작일, 종료일 세팅
    edt_SDate.setValue($c.date.addMonth(scwin.tDay, -1));
    edt_EDate.setValue(scwin.tDay);

    // 시장구분 data 세팅
    dma_search.set("mktTpCd", scwin.market);

    // 시장구분 행 visible 세팅
    tr_mkt_gubun.visible(scwin.market === "9");
}

// 검색조건 내 시작일, 종료일 기간 체크
scwin.fnDateCheck = function() {    // scwin.dateCheck()
    let eDate = edt_EDate.getValue();
    let sDate = edt_SDate.getValue();
    let rtnVal = true;

    let diffDays = $c.date.diffDate(sDate, eDate);

    if(diffDays < 0)
    {
        $c.win.alert("[조회기간 시작일은 종료일보다 작아야 합니다.] 다시 입력해주세요");

        dma_search.set("dateS", scwin.tDay);
        dma_search.set("dateE", scwin.tDay);

        rtnVal = false;
    }

    return rtnVal;
}

// 공지사항 입력, 수정 팝업 오픈
scwin.fnOpenPopup = async function(rowIndex) {
    let url = "/ui/dis/dsclinfo/ULDSTF30401.xml";
    let titleStr = "공지사항 " + (rowIndex === -1? "등록" : "수정");

    const opts = {
        id: "ULDSTF30401"  // 공지사항 입력 /수정
        , popupName: titleStr
        , width: 1080
        , height: 679
        , frameModal: "top"
    };

    let popupData = {
        "search" : dma_search.getJSON() // 검색조건 data
        , "row" : dlt_noticeList.getRowJSON(rowIndex) // 그리드 행 선택 data
        , regFlag : (rowIndex === -1)
    };
    
    const res = await $c.win.openPopup(url, opts, {"pData" : popupData});
    
    // 공지사항 등록,수정 화면에서 저장 버튼 클릭 했을때 
    if(res.saveFlag)    btn_search.click();

}
]]></script>

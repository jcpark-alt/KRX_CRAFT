		<script type="text/javascript" lazy="false"><![CDATA[
/* ★Wcraft guide★    
스크립트 수작업 유의사항
*/

scwin.vScrenID = "ULDFIS00205.xml";
///////// 1. 변수 및 선언 영역 /////////
scwin.vKisCd = ""; // 조회조건 기업코드

/**
 *  화면이 최초 로드될때 실행되는 초기화 이벤트
 *  (초기 데이터 조회나 컴포넌트 설정) 
 */

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
    scwin.init();
};

/**
 *  현재 로딩된 페이지가 초기화되거나 종료될때(다른 화면으로 이동하거나 페이지를 닫기전) 발생하는 이벤트
 *  (주로 SPA(Single Page Application) 환경에서 전역 자원을 해제하거나 메모리 누수 방지)
 */
scwin.onpageunload = function() {

};

///////// 5. 일반/업무 함수 영역 /////////
/**
 *  화면 초기화
 */
scwin.init = function() {
    scwin.search();
};

/**
 *  데이터셋 초기화
 */
scwin.initDs = function() {
    dlt_capitalChangeListRes.setData([]);
};

/**
 *  조회조건 유효성 체크
 */
scwin.chkValid = function() {

    scwin.vKisCd = $p.parent().frame_head.getWindow().scwin.fn_GetKisCd();

    if (scwin.vKisCd === "") {
        return false;
    }

    return true;

};

/**
 * 자본금변동 조회
 */
scwin.search = async function() {

    //데이터셋 초기화
    scwin.initDs();

    // 조회조건 체크
    if (!scwin.chkValid()) {
        return;
    }

    const kisCd = scwin.vKisCd;
    $c.sbm.setAction(sbm_capitalChange, "/api/listing/nice/company-status/" + kisCd + "/capital-change");
    const res = await $c.sbm.execute(sbm_capitalChange);
    dlt_capitalChangeListRes.setJSON(res.responseJSON.body);

};

/**
 *  엑셀파일다운로드
 */
scwin.excelDownload = function() {

    if (dlt_capitalChangeListRes.getRowCount() <= 0) {
        alert("조회된 데이터가 없습니다.");
        return;
    }

    const options = {
        fileName : "자본금변동",
        sheetName : "자본금변동"
    };

    const infoArray = {};

    $c.data.downloadGridViewExcel(grd_capChg, options, infoArray);

};
]]></script>

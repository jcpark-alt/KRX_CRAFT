scwin.vAcntclsDt = ""; // 조회조건 결산일자

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
    scwin.init();
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 *  화면 초기화
 */
scwin.init = function() {

    let ibxKisCd = $p.parent().wfm_header.getWindow().ibx_KisCd.getValue();
    //결산일자조회
    if(ibxKisCd !== "") {
        $p.parent().wfm_header.getWindow().scwin.fn_SrchAcntclsDt();
    } 
    scwin.search();
};

/**
 *  데이터셋 초기화.
 */
scwin.initDs = function() {
    dlt_AsstRevaluRes.removeAll();
};

/**
 *  조회조건 유효성 체크
 */
scwin.chkValid = function() {

    //필수항목 체크.
     scwin.vKisCd     = $p.parent().wfm_header.getWindow().ibx_KisCd.getValue();
     scwin.vAcntclsDt = $p.parent().wfm_header.getWindow().sbx_AcntclsDt.getValue();

    if (scwin.vKisCd === "" || scwin.vAcntclsDt === "") {
        return false;
    }
    return true;
};

/**
 * 자산재평가 조회
 */
scwin.search = function() {
    //데이터셋 초기화
    scwin.initDs();

    // 조회조건 체크.
    if (!scwin.chkValid()) {
        return;
    }
    const ibxKisCd = $p.parent().wfm_header.getWindow().ibx_CoSnm.getValue();
    const acntclsDt = $p.parent().wfm_header.getWindow().sbx_AcntclsDt.getValue();

    let url = "/api/listing/nice/individual-notes/asset-revaluation?kisCd="+ ibxKisCd +"&acntclsDt=" + acntclsDt;
    $c.sbm.setAction(sbm_dlt_AsstRevalu, url);
    $c.sbm.execute(sbm_dlt_AsstRevalu);
};

/**
 *  엑셀파일다운로드
 */
scwin.excelDownload = function() {
    if (dlt_AsstRevaluRes.getRowCount() <= 0) {
        alert("조회된 데이터가 없습니다.");
        return;
    }
    $c.data.downloadGridViewExcel(grd_AsstRevalu, {fileName: "자산재평가", type: "8"});
};
]]></script>

// 	//----W-Craft WebSquare 변환 확인: include----//

// 	//----W-Craft WebSquare 변환 확인: include----//

// 	//----W-Craft WebSquare 변환 확인: include----//

// 	//----W-Craft WebSquare 변환 확인: include----//

// 	//----W-Craft WebSquare 변환 확인: include----//
scwin.vScrenID = "ULDFIS00100.gfm";

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
    // 화면 초기화.
    scwin.init();

    // 기본값 세팅
    scwin.setDefaultVal();
};

scwin.onpageunload = function() {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.btn_Search_onclick = function() {
    // 조회버튼 클릭
    scwin.search();
};

scwin.btn_coSearch_onclick = function() {
    // 기업검색팝업 오픈
    scwin.comSrchOpen();
};

scwin.ibx_coSnm_onkeydown = function(e) {
    // 기업명 키다운.
    if (e.keyCode === 13) { //Enter
        if (ibx_coSnm.getValue() === "") {
            // 기업검색팝업 오픈
            scwin.comSrchOpen();
        } else {
            // 기업정보 조회
            scwin.comInfoSrch();
        }
    }
};

scwin.ibx_coSnm_onchange = function() {
    // 조회조건이 변경된 경우 초기화.
    ibx_kisCd.setValue("");
    ibx_indPttn.setValue("");
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_comOutLook_submitdone = function (e) {
    dlt_comOutLookRes.setJSON(e.responseJSON.body);
    dma_comOutLookRes.setJSON(e.responseJSON.body[0]);
    //재무정보 조회
    if (dlt_comOutLookRes.getRowCount() > 0) {
        scwin.searchFncInfo();
    }
};

scwin.sbm_fncInfo_submitdone = function (e) {
    dma_fncInfoRes.setJSON(e.responseJSON.body[0]);
};

scwin.sbm_comInfo_submitdone = function (e) {
    dlt_comInfoRes.setJSON(e.responseJSON.body);
    // 조회결과가 1개이면 기업개황 조회 아니면 기업팝업 오픈.
    if (dlt_comInfoRes.getRowCount() === 1) {
        // 조회조건에 값을 세팅하고..
        ibx_kisCd.setValue(dlt_comInfoRes.getCellData(0, "kisCd"));
        ibx_indPttn.setValue(dlt_comInfoRes.getCellData(0, "indPttn"));
        scwin.search(); // 기업개황 조회

    } else {
        scwin.comSrchOpen(); //기업검색 팝업 오픈
    }
};

///////// 5. 일반/업무 함수 영역 /////////
//var vCurDate = cGetToday("yyyymmdd");
//var pMenuID = InfoMenuID();

/**
 *  화면 초기화
 */
scwin.init = function() {
    // 패널 라운드 처리
    // $c.cm.PanelToGroupBox(panel_Top);
    // $c.libRoundPanel.PanelToGroupBox(panel_Mid);
    // $c.cm.PanelToGroupBox(panel_Bot);
};

/**
 *  데이터셋 초기화.
 */
scwin.initDs = function(pWorkFg) {
    if (pWorkFg === "1") { //기업개황 조회
        dlt_comOutLookRes.removeAll();
        dlt_fncInfoRes.removeAll();
    } else if (pWorkFg === "2") { //기업정보 조회(명으로 조회)
        dlt_comInfoRes.removeAll();
    }
};

/**
 *  기본값 세팅
 */
scwin.setDefaultVal = function() {

};

/**
 * 팝업으로 값을 넘김.
 */
scwin.getParKisCd = function() {
    const arrPar = new Array();
    arrPar[0] = ibx_coSnm.getValue(); // 기업명
    return arrPar;
};

/**
 * 팝업에서 넘어온 값 세팅. (as-is)
 */
scwin.setParKisCd = function(arrPar) {
    ibx_coSnm.setValue(arrPar[0].CO_SNM); //기업명
    ibx_kisCd.setValue(arrPar[0].KIS_CD); //기업코드
    ibx_indPttn.setValue(arrPar[0].IND_PTTN); //업종유형

    if (ibx_kisCd.getValue() !== "") {
        scwin.search();
    }
};

/**
 * 기업정보 조회(명으로 조회)
 */
scwin.comInfoSrch = function() {
    //데이터셋 초기화
    scwin.initDs("2");

    let reqMap = {
        coSnm: ibx_coSnm.getValue(), //기업코드
    };
    $c.sbm.execute(sbm_comInfo, reqMap);
};

/**
 * 기업검색 팝업
 */
scwin.comSrchOpen = async function() {
    // await $c.frame.CreateDialogFrame("KIS_CD", "./ULDFIS00100_P1.gfm", "기업 검색", 100, 100, 640 + 20, 445 + 45, "window");
    // $c.cm.ins_popupOpen("KIS_CD", ibx_SRCH_ISUR_NM, "ULDFIS00101", "기업 검색", "550", "450");

    const url = "/ui/lst/fis/ULDFIS00101.xml";
    const popTitle = "기업 검색";

    const opts = {
        id: "ULDFIS00101",
        popupName: popTitle,
        width: 900,
        height: 679,
        frameModal: "top",
        // popupParam: {
            data: {
                coSnm: ibx_coSnm.getValue(),
                kisCd: ibx_kisCd.getValue(),
                indPttn: ibx_indPttn.getValue(),
            },
            // callback: "fn_GetParKisCd",
        // },
    };

    const res = await $c.win.openPopup(url, opts);

    ibx_coSnm.setValue(res.coSnm); //기업명
    ibx_kisCd.setValue(res.kisCd); //기업코드
    ibx_indPttn.setValue(res.indPttn); //업종유형

    if (ibx_kisCd.getValue() !== "") {
        scwin.search();
    }
};

/**
 *  조회조건 유효성 체크
 */
scwin.chkValid = function() {
    //필수항목 체크.
    if (ibx_coSnm.getValue() === "") {
        alert("기업명을 입력하세요.");
        ibx_coSnm.focus();
        return false;
    }

    // 기업명은 있는데 기업코드가 없는 경우
    if (ibx_coSnm.getValue() !== "" && ibx_kisCd.getValue() === "") {
        scwin.comInfoSrch();
        return false;
    }
    return true;
};

/**
 * 기업개황 조회
 */
scwin.search = function() {
    //데이터셋 초기화
    scwin.initDs("1");

    // 조회조건 필수 체크.
    if (!scwin.chkValid()) {
        return;
    }

    let reqMap = {
        kisCd: ibx_kisCd.getValue(), //기업코드
    };
    $c.sbm.execute(sbm_comOutLook, reqMap);
};

/**
 * 기업개황_재무정보 조회
 */
scwin.searchFncInfo = function() {
    let reqMap = {
        kisCd: ibx_kisCd.getValue(), //기업코드
        indPttn: ibx_indPttn.getValue(), //업종유형
    };
    $c.sbm.execute(sbm_fncInfo, reqMap);
};
]]></script>

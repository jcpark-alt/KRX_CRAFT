};

/**
 * 외화부채 팝업조회
 */
scwin.search = function() {
    //데이터셋 초기화
    scwin.initDs();

    // 조회조건 체크.
    if (!scwin.chkValid()) {
        return;
    }

    const ibxKisCd  = scwin.comCd;
    const acntclsDt = scwin.basYymm;

    let url = "/api/listing/nice/individual-notes/foreign-currency/liabilities?kisCd="+ibxKisCd+"&acntclsDt="+acntclsDt;
    $c.sbm.setAction(sbm_dlt_ForncurrDebt, url);
    $c.sbm.execute(sbm_dlt_ForncurrDebt);
};

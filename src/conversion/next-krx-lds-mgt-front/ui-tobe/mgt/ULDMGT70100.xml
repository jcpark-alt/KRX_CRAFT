		<script type="text/javascript" lazy="false"><![CDATA[///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name onpageload
 * @description 화면 진입점 — 건수 표시 초기화 후 연/월 콤보를 구성하고 영업일 목록을 조회한다.
 * @returns {void}
 * @hidden N
 * @example (body ev:onpageload 바인딩으로 자동 호출)
 */
scwin.onpageload = function() {
    try {
        textbox_1.setValue("0");
        scwin.setCode();

        scwin.selectList();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT70100.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name btn_sys_search_onclick
 * @description 조회 버튼 클릭 — 선택 연월의 영업일 목록을 조회한다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example scwin.btn_sys_search_onclick(e);
 */
scwin.btn_sys_search_onclick = function (e) {
    try {
        scwin.selectList();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT70100.btn_sys_search_onclick" });
    }
};

/**
 * @method
 * @name btn_rollusr_save_onclick
 * @description 저장 버튼 클릭 — 그리드 변경분 저장(scwin.save)을 실행한다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example scwin.btn_rollusr_save_onclick(e);
 */
scwin.btn_rollusr_save_onclick = function(e) {
    try {
        scwin.save();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT70100.btn_rollusr_save_onclick" });
    }
};

/**
 * @method
 * @name MxLogicalTr_OnFail
 * @description 저장 실패 콜백 — 실패 알림을 표시한다.
 * @param {Object} e 서브미션 완료 이벤트/결과 객체
 * @returns {void}
 * @hidden N
 * @example scwin.MxLogicalTr_OnFail(e);
 */
scwin.MxLogicalTr_OnFail = function(e) {
    try {
        $c.win.alert('저장을 실패했습니다');
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT70100.MxLogicalTr_OnFail" });
    }
};

/**
 * @method
 * @name MxLogicalTr_OnSuccess
 * @description 저장 성공 콜백 — 완료 알림 후 목록을 재조회한다.
 * @param {Object} e 서브미션 완료 이벤트/결과 객체
 * @returns {void}
 * @hidden N
 * @example scwin.MxLogicalTr_OnSuccess(e);
 */
scwin.MxLogicalTr_OnSuccess = function(e) {
    try {
        $c.win.alert('저장하였습니다');
        scwin.selectList();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT70100.MxLogicalTr_OnSuccess" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name sbm_select_list_submitdone
 * @description 영업일 목록 조회 완료 콜백 — 성공 시 건수를 표시하고 결과를 dlt_select_list_content에 바인딩하며, 실패 시 오류 메시지를 표시한다.
 * @param {Object} e 서브미션 완료 이벤트/결과 객체
 * @returns {void}
 * @hidden N
 * @example scwin.sbm_select_list_submitdone(e);
 */
scwin.sbm_select_list_submitdone = function (e) {
    const result = e.responseJSON;
   
    if(result.success) {
        const obj = result.body;
        
        textbox_1.setValue(obj.length);
        
        dlt_select_list_content.setJSON(obj);
 
    }
    else{
        $c.win.alert(result.message);
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name setCode
 * @description 현재 일자 기준으로 연/월 콤보 초기값을 구성한다.
 * @returns {void}
 * @hidden N
 * @example scwin.setCode();
 */
scwin.setCode = function() {
    const ToDay = new Date();
   
    scwin.setYear(ToDay);
    scwin.setMonth(ToDay);
};

/**
 * @method
 * @name setYear
 * @description 연도 콤보(cyear)에 기준연도+20년부터 2007년까지 아이템을 구성하고 현재 연도를 선택한다.
 * @param {Date} ToDay 기준 일자
 * @returns {void}
 * @hidden N
 * @example scwin.setYear(new Date());
 */
scwin.setYear = function(ToDay) {
    
    const yyyy = ToDay.getFullYear();
    let idx = 0;
    for (let i = yyyy + 20; i >= 2007; i--) {
        
        cyear.addItem(i, i, idx, false);
        idx++;
    }

    cyear.setValue(yyyy);

};

/**
 * @method
 * @name setMonth
 * @description 월 콤보(cmonth)를 기준 일자의 월로 선택한다.
 * @param {Date} ToDay 기준 일자
 * @returns {void}
 * @hidden N
 * @example scwin.setMonth(new Date());
 */
scwin.setMonth = function(ToDay) {
    const idx = ToDay.getMonth() ;
    cmonth.setSelectedIndex(idx);
};

/**
 * @method
 * @name selectList
 * @description 선택된 연월(searchYearMonth)을 조건으로 영업일 목록 조회 서브미션(sbm_select_list)을 실행한다.
 * @returns {void}
 * @hidden N
 * @example scwin.selectList();
 */
scwin.selectList = function() {
    const yyyymm = cyear.getValue() + cmonth.getValue();

    dma_select_list.set("searchYearMonth", yyyymm);

    $c.sbm.execute(sbm_select_list, dma_select_list.getJSON());

};

/**
 * @method
 * @name save
 * @description 그리드 변경분(getUpdatedJSON)을 저장 서브미션(sbm_MxLogicalTr)으로 전송한다.
 * @returns {void}
 * @hidden N
 * @example scwin.save();
 */
scwin.save = function() {

    console.log(dlt_select_list_content.getUpdatedJSON());
    $c.sbm.execute(sbm_MxLogicalTr, dlt_select_list_content.getUpdatedJSON());
};

/* ★Wcraft guide★    
스크립트 수작업 유의사항
*/

//----W-Craft WebSquare 변환 확인: include----//

//----W-Craft WebSquare 변환 확인: include----//

//----W-Craft WebSquare 변환 확인: include----//
scwin.vScrenID = 'ULDMGT80500.gfm';
///////// 1. 변수 및 선언 영역 /////////
scwin.toDay = '';
scwin.clientnow = new Date();

/* 오늘 날짜를 구한다 */
scwin.curYear = scwin.clientnow.getYear();
scwin.curMonth = (scwin.clientnow.getMonth()) + 1;
scwin.curDay = scwin.clientnow.getDate();
if (scwin.curMonth <= 9) {
    scwin.curMonth = "0" + scwin.curMonth;
}
if (scwin.curDay <= 9) {
    scwin.curDay = "0" + scwin.curDay;
}
scwin.toDay = scwin.curYear + "" + scwin.curMonth + "" + scwin.curDay;

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
};

scwin.onpageunload = function() {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.dSetLst_OnLoadCompleted = function(rowcount) {
    textbox_1.setValue("총 " + rowcount + "건");
};

scwin.btn_cal_onclick = function(e) {

    //----W-Craft WebSquare 변환 확인: popUpCalendar----//
    popUpCalendar(txb_date_bg, 'txb_date', 'yyyymmdd'); //alert('image_2.onclick');

};

scwin.btn_sys_search_onclick = function(e) {
    if (txb_date.getValue() !== "") {
        scwin.listSync();
        scwin.cntSync();
    } else {
        alert("일자를 지정하십시요");
    }
};

scwin.txb_date_OnDblClick = function(e) {
    if (txb_date.getValue() !== "") {
        scwin.listSync();
        scwin.cntSync();
    }
};

scwin.tbMktG_onchange = function() {
    scwin.chkCntVal(tbMktG);
};

scwin.dSetCnt_OnLoadCompleted = function(rowcount) {

};

scwin.btn_toExcel_onmouseover = function() {
    btn_toExcel.setBackgroundImage("../img/2_butt_toexcel.gif");
};

scwin.btn_toExcel_onmouseout = function() {
    btn_toExcel.setBackgroundImage("../img/2_butt_toexcel_dis.gif");
};

scwin.btn_toExcel_onclick = function(e) {

    //----W-Craft WebSquare 변환 확인: GridToExcel----//
    if (dSetLst.CountRow !== 0) mgLst.GridToExcel("일별투자참고", "", "8");
};

///////// 5. 일반/업무 함수 영역 /////////
scwin.listSync = async function() {
    const sbmOptions = {
        id : "sbm_dSetLst",
        action : "/byddinvst.do",
        ref : "",
        target : "dSetLst=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

scwin.listSyncAuto = function() {

    //----W-Craft WebSquare 변환 확인: setInterval----//
    setInterval('fn_list_sync()', 30000);
    scwin.listSync();
};

scwin.cntSync = async function() {
    const sbmOptions = {
        id : "sbm_dSetCnt",
        action : "/byddinvst.do",
        ref : "",
        target : "dSetCnt=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

scwin.chkCntVal = function(obj) {
    alert(obj.value);
    const ver = obj.value;
    if (ver !== '120') obj.setValue(obj.value + ' 이상');
};

scwin.setToDate = function() {
    txb_date.setValue(scwin.toDay);
    scwin.listSync();
    scwin.cntSync();
};

scwin.gform_onload = async function() {
    const sbmOptions = {
        id : "sbm_dSetLst",
        action : "/gauceSystemierAdaptor.do",
        ref : "",
        target : "dSetLst=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    const sbmOptions2 = {
        id : "sbm_dSetCnt",
        action : "/gauceSystemierAdaptor.do",
        ref : "",
        target : "dSetCnt=body.content",
        isProcessMsg : false
    };

    const sbmRtn2 = await $c.sbm.executeDynamic(sbmOptions2);
    // TODO Stage2: sbmRtn2 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    $c.libRoundPanel.PanelToGroupBox_01(panel_1);
    //PanelToGroupBox_02(panel_2);
    scwin.setToDate();
    scwin.listSyncAuto();
};
]]></script>

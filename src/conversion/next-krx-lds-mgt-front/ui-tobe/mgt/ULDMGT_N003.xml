};

scwin.btn_newInsert_onclick = async function () {
    const data = { type: "confirm", msg: scwin.temp_getValue() , rdo:rdo_system.getValue()}; // 임시로 생성한 번호임 수정필요
    const options = {
        id: "ConfirmPop",
        title: "Confirm_Pop",
        width:"920px",
        height: "470px"
    };
    const result = await $c.win.openPopup("/ui/mgt/ULDMGT_N004.xml", options, data);
    scwin.btn_newInsertCallback(result);
};

scwin.grd_menu_oncellclick = async function (rowIndex, columnIndex, columnId) {
    console.log ("columnIndex :" + columnIndex + " rowIndex:"+ rowIndex+ "  columnId:"+ columnId);
    if(columnIndex === 9)
    {
        const data = { type: "confirm", jval: dlt_select_list_content.getRowJSON(rowIndex),  callBackParam:"scwin.grd_menuUpdateCallback" }; 
        const options = {
            id: "ConfirmPop",
            title: "Confirm_Pop",
            width:"920px",
            height: "470px"
        };

        const result = await $c.win.openPopup("/ui/mgt/ULDMGT_N002.xml", options, data);
        scwin.grd_menuUpdateCallback(result); 
    };
    if(columnIndex === 10)
    {
        const rmenuId = dlt_select_list_content.getCellData(rowIndex, "menuId");
        const rmenuNm = dlt_select_list_content.getCellData(rowIndex, "menuNm");
        const vmsg = "메뉴 "+ rmenuNm +"(" + rmenuId + ") 을(를) 삭제하시겠습니까?";
        

        if (await $c.win.confirm(vmsg)) 
        { 
            dma_delete.set("menuId", rmenuId);
            scwin.res = await $c.sbm.execute(sbm_delete,  dma_delete.getJSON());
            if (scwin.res.responseJSON.success === true) {
                scwin.res.saveFlag = "delete";
                $c.win.closePopup(scwin.res);
                scwin.grd_menuDelCallback(scwin.res);
               
            }            
        } else {
            $c.win.closePopup();
        }
        
    };
};

// 일반 함수
/********************************************** 
 * 함수명   : scwin.select_list_call()
 * 설명     : 초기 조회 
 ***********************************************/
scwin.select_list_call = function() {
    console.log("rdo : "+ rdo_system.getValue());
    console.log("menuNm : "+ ipt_menuNm.getValue());
    console.log("lvlCd : "+ sel_lvlCd.getValue());
    console.log("useYn : "+ sel_useYn.getValue());

    dma_select_list.set("notiObjSysTpCd", rdo_system.getValue());
    dma_select_list.set("menuNm", ipt_menuNm.getValue());
    dma_select_list.set("lvlCd",   sel_lvlCd.getValue());
    dma_select_list.set("useYn", sel_useYn.getValue());

    $c.sbm.execute(sbm_select_list, dma_select_list.getJSON());
};

scwin.sbm_select_list_submitdone = function (e) {
    const result = e.responseJSON;
    
       
    if(result.success) {
        const obj = result.body;

        console.log("cnt : "+ obj.length);
        textbox_1.setValue (obj.length);

        dlt_select_list_content.setJSON(obj); 
    }
    else{
        $c.win.alert(result.message);
    }
};

scwin.random3Digital = function(){
    return Math.floor(Math.random() * 900) + 100;
}

scwin.temp_getValue = function()
{
    let imsival = "";
    const imsi = dlt_select_list_content.getCellData(0, "menuId");
    const num = scwin.random3Digital();


    if(imsi.length > 3)
    {
        imsival = imsi.substring(0, 3) + "-" + num;
    }else{
        imsival = "000" + "-" + num;
    }

    imsival = "STF15920";
    return imsival;
}

/**
 * @method
 * @name fn_confirmCallback
 * @description confirm에 대한 callback 함수, 부모창으로 파라미터를 전송한다.
 * @param {String | Number} arg 부모창으로 전달할 값
 */
scwin.btn_newInsertCallback = function (arg) {

     console.log ("btn_newInsertCallback :" + arg);
};

scwin.sbm_delete_submitdone = function (e) {
    const result = e.responseJSON;

    if(result.success) {
       
        console.log ("success? : true");
        scwin.select_list_call();
    }
    else{
        $c.win.alert(result.message);
    }
};

scwin.grd_menuUpdateCallback = function ( arg ){
     console.log ("grd_menuUpdateCallback :" + arg);
}

scwin.grd_menuDelCallback = function ( arg ){
     console.log ("grd_menuDelCallback? :" + arg);
}
]]></script>

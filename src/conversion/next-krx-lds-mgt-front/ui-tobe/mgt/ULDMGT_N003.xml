        <script lazy="false" type="text/javascript"><![CDATA[// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function() {
	
    scwin.vScrenID = "ULDMGT_N003";
   
    scwin.res = {};
    scwin.select_list_call();
};

// WebSquare 컴포넌트 이벤트 함수
scwin.sel_lvlCd_onchange = function (info) {
    scwin.select_list_call	();
};

scwin.sel_useYn_onchange = function (info) {
	scwin.select_list_call	();
};

scwin.ipt_menuNm_onchange = function (info) {

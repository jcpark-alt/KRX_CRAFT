        <script lazy="false" type="text/javascript"><![CDATA[///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {

    scwin.vScrenID = "ULDMGT_N011";
   
    scwin.mode = $c.data.getParameter("mode"); 

    if(scwin.mode === "update")
    {    
        scwin.jval = $c.data.getParameter("jval");  
        dma_param.setJSON(scwin.jval);
   
    }else{
        scwin.jval = "";

    }

    sel_gbn.setValue("");
    
    scwin.select_list_call();
	
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.btn_cancel_onclick = function (e) {
  $c.win.closePopup();	
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_select_submitdone = function (e) {
    const result = e.responseJSON;
    
    if(result.success) {
        const obj = result.body;
        
        dlt_select_list_content.setJSON(obj); 

    }
    else{
        $c.win.alert(result.message);
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/********************************************** 
 * 함수명   : scwin.select_list_call()
 * 설명     : 상위부서 조회 
 ***********************************************/
scwin.select_list_call =  function ()
{
    
    dma_select_list.set("depCd", dma_param.get("depCd"));
    
    $c.sbm.execute(sbm_select, dma_select_list.getJSON());
        
}
]]></script>

<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="FAQ 목록">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
        	<w2:dataCollection baseNode="map">
        		<w2:dataMap baseNode="map" id="dma_select_list" style="">
        			<w2:keyInfo>
        				<w2:key dataType="text" id="helpClssId" name="helpClssId"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataList baseNode="list" id="dlt_select_list_content" repeatNode="map" saveRemovedData="true" style="">
        			<w2:columnInfo>
        				<w2:column id="faqId" name="faqId" dataType="text"></w2:column>
        				<w2:column id="quesContn" name="quesContn" dataType="text"></w2:column>
        				<w2:column id="regEmpNo" name="regEmpNo" dataType="text"></w2:column>
        				<w2:column id="faqRegDdtm" name="faqRegDdtm" dataType="text"></w2:column>
        				<w2:column id="helpClssId" name="helpClssId" dataType="text"></w2:column>
        				<w2:column id="ldFaqAnsContn" name="ldFaqAnsContn" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
        		<w2:dataMap baseNode="map" id="dma_param">
        			<w2:keyInfo>
        				<w2:key id="mode" name="mode" dataType="text"></w2:key>
        				<w2:key id="faqId" name="faqId" dataType="text"></w2:key>
        				<w2:key id="helpClssId" name="helpClssId" dataType="text"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        		<w2:dataMap baseNode="map" id="dma_delete" style="">
        			<w2:keyInfo>
        				<w2:key dataType="text" id="faqId" name="faqId"></w2:key>
        			</w2:keyInfo>
        		</w2:dataMap>
        	</w2:dataCollection>
        	<w2:workflowCollection />
        	<xf:submission id="sbm_select_list" action="/api/mgmt/ld-faq-list/select" method="get" mediatype="application/json" ref=""
        		target="" encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="" ev:submit=""
        		ev:submitdone="scwin.sbm_select_list_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        	<xf:submission id="sbm_delete" action="/api/mgmt/ld-faq/delete" method="post" mediatype="application/json" ref="" target=""
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="삭제하는중..." ev:submit=""
        		ev:submitdone="scwin.sbm_delete_submitdone" ev:submiterror="" abortTrigger="">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[// scwin.onpageload, scwin.onpageunload 함수
scwin.onpageload = function() {
    scwin.vScrenID = "ULDMGT50315";
   
    console.log( $c.data.getParameter("mode") ); 
   

    // param 에서 mode가 없으면 무조건 create합니다.
    if ($c.data.getParameter("mode") === 'update'){

        scwin.mode = "update";
        scwin.jval =  $c.data.getParameter("jval");
        console.log( scwin.jval ); 
        scwin.rHelpClssId = scwin.jval.helpClssId;
        console.log( scwin.rHelpClssId ); 
    }else {

        scwin.mode = "create";
        scwin.rHelpClssId = $c.data.getParameter("helpClssId");

    }

    scwin.select_list_call();	
};

// WebSquare 컴포넌트 이벤트 함수
scwin.grd_faqlist_oncellclick = async function (rowIndex, columnIndex, columnId) {
  console.log ("columnIndex :" + columnIndex + " rowIndex:"+ rowIndex+ "  columnId:"+ columnId);

   if(columnIndex === 3)
    {
        dma_param.set ("mode", "update");
        dma_param.setJSON(dlt_select_list_content.getRowJSON(rowIndex));

        console.log(dma_param.getJSON());

        $c.win.moveUrl("/ui/mgt/ULDMGT50307.xml", dma_param.getJSON());
            
    };
    if(columnIndex === 4)
    {
        const rfaqId = dlt_select_list_content.getCellData(rowIndex, "faqId");
        const rquesContn = dlt_select_list_content.getCellData(rowIndex, "quesContn");
        const vmsg = "메뉴 "+ rquesContn +"(" + rfaqId + ") 을(를) 삭제하시겠습니까?";
      

        if (await $c.win.confirm(vmsg)) 
        { 
            dma_delete.set("faqId", rfaqId);
            scwin.res = await $c.sbm.execute(sbm_delete,  dma_delete.getJSON());
            if (scwin.res.responseJSON.success === true) {
                scwin.res.saveFlag = "delete";
                $c.win.closePopup(scwin.res);

               
            }            
        } else {
            $c.win.closePopup();
        }
        
    };
}

scwin.btn_regist_onclick = function (e) {

    dma_param.set ("mode", "create");
   

    $c.win.moveUrl("/ui/mgt/ULDMGT50307.xml", dma_param.getJSON());	
};

// 일반 함수
scwin.select_list_call = function (){
   
    dma_select_list.set("helpClssId", scwin.rHelpClssId);

    //dma_select_list.set("helpClssId", "0100000006");
    $c.sbm.execute(sbm_select_list, dma_select_list.getJSON());
}

scwin.sbm_select_list_submitdone = function (e) {
    const result = e.responseJSON;
    
    if(result.success) {

        // 전체 데이터 
        const obj = result.body;
      
        dlt_select_list_content.setJSON(obj); 
      
    }
    else{
        $c.win.alert(result.message);
    }
};

scwin.sbm_delete_submitdone = function (e) {
         console.log("delete done");
         scwin.select_list_call();
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="pop_contents" id="" meta_componentContainer="true" meta_snippetCategory="00_화면시작" meta_snippetKeyComponent="true"
    		meta_snippetName="0_02 팝업페이지시작">
    		<xf:group class="titbox mt0" id="" meta_snippetCategory="02_타이틀" meta_snippetKeyComponent="true"
    			meta_snippetName="2_02 서브타이틀(h3)" style="">
    			<w2:textbox class="" id="" label="FAQ 목록" style="" tagname="h3"></w2:textbox>
    		</xf:group>
    		<xf:group adaptiveThreshold="" class="gvwbox" id="" meta_snippetCategory="06_그리드" meta_snippetKeyComponent="true"
    			meta_snippetName="6_01 그리드" style="">
    			<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_select_list_content"
    				focusMode="row" id="grd_faqlist" scrollByColumn="false" scrollByColumnAdaptive="false" style="height:253px;" ev:oncellclick="scwin.grd_faqlist_oncellclick">
    				<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    				<w2:header id="header2" style="">
    					<w2:row id="row3" style="">
    						<w2:column blockSelect="false" displayMode="label" id="column12" inputType="text" removeBorderStyle="false"
    							value="FAQ ID" width="70">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column11" inputType="text" removeBorderStyle="false"
    							value="질의" width="400">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column10" inputType="text" removeBorderStyle="false"
    							value="등록일시" width="120">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column9" inputType="text" removeBorderStyle="false"
    							width="100" colSpan="2">
    						</w2:column>
    					</w2:row>
    				</w2:header>
    				<w2:gBody id="gBody2" style="">
    					<w2:row id="row4" style="">
    						<w2:column blockSelect="false" displayMode="label" id="faqId" inputType="text" removeBorderStyle="false"
    							width="70" readOnly="true">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="quesContn" inputType="text" removeBorderStyle="false"
    							width="400" textAlign="left" readOnly="true">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="faqRegDdtm" inputType="text" removeBorderStyle="false"
    							width="120" editFormat="####/##/## ##:##:##" readOnly="true">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="col4" inputType="button" removeBorderStyle="false"
    							width="50" value="변경" fixColumnWidth="true">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="col5" inputType="button" removeBorderStyle="false"
    							width="50" value="삭제" fixColumnWidth="true">
    						</w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</xf:group>
    		<xf:group class="btnbox" id="" meta_snippetCategory="08_버튼" meta_snippetKeyComponent="true" meta_snippetName="8_05 팝업전체제어버튼"
    			style="">
    			<xf:group class="rt" id="" style="">
    				<xf:trigger class="btn_cm " id="btn_close" style="" type="button">
    					<xf:label><![CDATA[닫기]]></xf:label>
    				</xf:trigger>
    				<xf:trigger style="" id="btn_regist" type="button" class="btn_cm pt" ev:onclick="scwin.btn_regist_onclick">
    					<xf:label><![CDATA[등록]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>

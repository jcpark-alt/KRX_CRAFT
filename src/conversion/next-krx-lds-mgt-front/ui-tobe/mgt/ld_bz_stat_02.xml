    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="pop_contents" id="" meta_snippetCategory="00_화면시작" meta_snippetKeyComponent="true"
    		meta_snippetName="0_02 팝업페이지시작">
    		<xf:group class="msgbox " id="" style="">
    			<xf:group class="txt_list" id="" tagname="ul">
    				<xf:group id="" tagname="li">
    					<xf:group id="" class="flex">
    						<w2:textbox tagname="" for="" style="" id="" label="edit 모드에서 줄바꿈 처리는 " class="" escape="false"></w2:textbox>
    						<w2:textbox class="" escape="false" for="" id="" label="Shift + Enter"
    							style="border-radius:4px;background-color: var(--ws-gray-900);color:var(--ws-gray-0);padding:2px 6px;" tagname="">
    						</w2:textbox>
    						<w2:textbox class="" escape="false" for="" id="" label="입니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    				</xf:group>
    				<xf:group id="" tagname="li">
    					<w2:textbox class="" escape="false" for="" id=""
    						label="상장공시 개편현황 리스트는 최초 로드시 시작일(현재일)로부터 종료일(미지정)을 기준으로 진행, 완료 모든 목록을 나타냅니다." style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li">
    					<w2:textbox class="" escape="false" for="" id=""
    						label="일자 검색 영역 밑 'YYYYMMDD' 형식의 버튼은 검색 된 일자 중 저장 된 이행일을 나타냅니다.&lt;br/&gt;(해당 버튼은 검색 리스트의 필터 방식으로 on/off 기능을 내재하고 있습니다.)" style=""
    						tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li">
    					<w2:textbox class="" escape="false" for="" id="" label="그리드 위에서 마우스 우클릭시 다중행 추가, 최하단행추가, 행삭제, 열고정, 배경색변경의 기능이 있습니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" escape="false" for="" id="" label="ITSM No을 공란으로 저장시 'SrM-xxxxxxxxx'으로, 이행일을 공란으로 저장시 '99991231'로 저장됩니다. 단, 저장된 이행일이 '99991231'이면 화면에서 '미정'으로 표기됩니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" escape="false" for="" id="" label="『확대』 버튼은 그리드를 확대/축소 할 수 있습니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" escape="false" for="" id="" label="『다중행 추가』 는 여러행을 동시에 추가 하며, 『최하단행추가』 는 한개의 행을 추가합니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" escape="false" for="" id="" label="『행삭제』 는 해당행 또는 여러행을 삭제합니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" escape="false" for="" id="" label="『열고정』 은 헤더 영역에서 마우스 우클릭시 나타는 기능으로서 원하는 열을 고정 할 수 있습니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" escape="false" for="" id="" label="『배경색변경』 은 셀의 배경색을 변경 할 수 있습니다."
    						style="" tagname="">
    					</w2:textbox>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    	</xf:group>

        <script lazy="false" type="text/javascript"><![CDATA[///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
	try {
		scwin.rdo = $c.data.getParameter("rdo");
	    scwin.msg = $c.data.getParameter("jval");  

	    ipt_menuId.setValue(scwin.msg.menuId);   
	    ipt_menuNm.setValue(scwin.msg.menuNm); 
	    ipt_ordNo.setValue(scwin.msg.outputOrdNo);  
	    ipt_upMenuNm.setValue(scwin.msg.upMenuNm);

	    let now = new Date();
	    let year  = now.getFullYear();
	    let month = String(now.getMonth() + 1).padStart(2, '0');
	    let day   = String(now.getDate()).padStart(2, '0');
	    let hour  = String(now.getHours()).padStart(2, '0');
	    let min   = String(now.getMinutes()).padStart(2, '0');
	    let sec   = String(now.getSeconds()).padStart(2, '0');
   
	    scwin.dateTime = year + month + day + hour + min + sec;
	    console.log("scwin.dateTime :"+scwin.dateTime);
	    cal_stratDdtm.setValue(scwin.dateTime);
	    cal_endDdtm.setValue('99991231000000');

	    scwin.select_list_call();  // 상위메뉴조회
	} catch (ex) {
		$c.exception.handleError(ex, { context : "ULDMGT_N002.onpageload" });
	}
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.sel_upmenuChoice_onchange = function (info) {
    try {
        let idx = sel_upmenuChoice.getSelectedIndex();
    
        let d = parseInt(dlt_select_list_contents.getCellData(idx, "lvlCd"));
        d = d + 1;
    
        if(d > 4) {
             $c.win.alert("메뉴 Depth가 4depth 보다 큽니다.");
             return;
        }
        sel_depth.setValue(d)
        ipt_ordNo.setValue(dlt_select_list_contents.getCellData(idx, "outputOrdNo"));
        ipt_upMenuNm.setValue(dlt_select_list_contents.getCellData(idx, "menuNm"));
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT_N002.sel_upmenuChoice_onchange" });
    }
};

scwin.btn_cancel_onclick = function (e) {
    try {
        $c.win.closePopup();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT_N002.btn_cancel_onclick" });
    }
};

scwin.btn_save_onclick = function (e) {
    try {
        if((ipt_menuNm.getValue() === "") && (ipt_menuNm.getMandatory())){
             $c.win.alert("메뉴명이 없습니다.");
             return;
        }

        if((ipt_ordNo.getValue() === "") && (ipt_ordNo.getMandatory())){
             $c.win.alert("정렬순서가 없습니다.");
             return;
        }

        if((ipt_upMenuNm.getValue() === "") && (ipt_upMenuNm.getMandatory())){
             $c.win.alert("상위메뉴명이 없습니다.");
             return;
        }

    	 let idx = sel_upmenuChoice.getSelectedIndex();
         dma_save.set("screnId",        dlt_select_list_contents.getCellData(idx, "screnId"));
         dma_save.set("outputOrdNo",    ipt_ordNo.getValue());
         dma_save.set("lvlCd",          sel_depth.getValue());
         dma_save.set("menuNm",         ipt_menuNm.getValue());
         dma_save.set("notiObjSysTpCd", scwin.rdo);
         dma_save.set("upMenuId",       dlt_select_list_contents.getCellData(idx, "upMenuId"));
         dma_save.set("menuId",         ipt_menuId.getValue());
         // 아직 DB 미비 20260602
         $c.win.alert("아직 DB 미비 20260602");
         console.log(dma_save.getJSON());
          $c.sbm.execute(sbm_update, dma_save.getJSON());
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT_N002.btn_save_onclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_select_list_submitdone = function (e) {
    const result = e.responseJSON;
       
    if(result.success) {
        const obj = result.body;

        dlt_select_list_contents.setJSON(obj); 

        for(let i = 0;i < obj.length; i++) {
           const comp = obj[i];
           sel_upmenuChoice.addItem(comp.menuNm, comp.menuId, i, false);

        }    
    }
    else{
        $c.win.alert(result.message);
    }
};

scwin.sbm_update_submitdone = function (e) {
    const result = e.responseJSON;

    if(result.success) {
       
        console.log ("success-002 : true");
        $c.win.closePopup();
    }
    else{
        $c.win.alert(result.message);
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/********************************************** 
 * 함수명   : scwin.select_list_call()
 * 설명     : 상위메뉴조회
 ***********************************************/
scwin.select_list_call = function() {
  
    dma_select_list.set("menuId",   ipt_menuId.getValue());

    $c.sbm.execute(sbm_select_list, dma_select_list.getJSON());
};
]]></script>

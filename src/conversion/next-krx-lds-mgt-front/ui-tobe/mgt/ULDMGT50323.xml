        	</xf:submission>
        	<xf:submission id="sbm_update" action="/api/mgmt/help-faq/save" method="post" mediatype="application/json" ref="" target=""
        		encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous" processMsg="수정 하는중..." ev:submit=""

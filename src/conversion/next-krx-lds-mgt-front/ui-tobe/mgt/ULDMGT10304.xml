/* ★Wcraft guide★    
스크립트 수작업 유의사항

*/
/**
 * @method
 * @name onpageload
 * @description 화면 진입점 — 현재 별도 초기화 로직 없음.
 * @returns {void}
 * @hidden N
 * @example (body ev:onpageload 바인딩으로 자동 호출)
 */
scwin.onpageload = function() {
};

/**
 * @method
 * @name onpageunload
 * @description 화면 종료 시점 — 현재 별도 해제 로직 없음.
 * @returns {void}
 * @hidden N
 * @example (body ev:onpageunload 바인딩으로 자동 호출)
 */
scwin.onpageunload = function() {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name MxDataSet_OnLoadCompleted
 * @description 금감원문서정보파일 목록 조회 완료 콜백 — 총건수를 textbox_1 에 표시한다.
 * @param {Number} rowcount 조회 건수
 * @returns {void}
 * @hidden N
 * @example scwin.MxDataSet_OnLoadCompleted(MxDataSet.getRowCount());
 */
scwin.MxDataSet_OnLoadCompleted = function(rowcount) {
    try {
        textbox_1.setValue("총 " + rowcount + "건");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10304.MxDataSet_OnLoadCompleted" });
    }
};

/**
 * @method
 * @name btn_sys_search_onclick
 * @description 「조회」 버튼 클릭 — 금감원문서정보파일 목록을 조회한다(listSync).
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example (btn_sys_search ev:onclick 바인딩으로 자동 호출)
 */
scwin.btn_sys_search_onclick = function(e) {
    try {
        scwin.listSync(); // alert();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10304.btn_sys_search_onclick" });
    }
};

/**
 * @method
 * @name btn_toExcel_onclick
 * @description 「엑셀다운로드」 버튼 클릭 — 그리드(MxGrid_1) 내용을 엑셀로 다운로드한다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example (btn_toExcel ev:onclick 바인딩으로 자동 호출)
 */
scwin.btn_toExcel_onclick = function(e) {
    try {
        MxGrid_1.GridToExcel("금감원문서정보파일", "", "2");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10304.btn_toExcel_onclick" });
    }
};

/**
 * @method
 * @name btn_cal_onclick
 * @description 달력 버튼 클릭 — 수신기준일자(txb_date) 달력 팝업을 연다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example (btn_cal ev:onclick 바인딩으로 자동 호출)
 */
scwin.btn_cal_onclick = function(e) {
    try {
        popUpCalendar(txb_date_bg, 'txb_date', 'yyyymmdd'); // alert('image_2.onclick');
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10304.btn_cal_onclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name listSync
 * @description 금감원문서정보파일 목록(MxDataSet)을 조회(/dardocinfo.do)하고 완료 후 구 콜백(MxDataSet_OnLoadCompleted)으로 총건수를 갱신한다.
 * @returns {void}
 * @hidden N
 * @example scwin.listSync();
 */
scwin.listSync = async function() {
    const sbmOptions = {
        id : "sbm_MxDataSet",
        action : "/dardocinfo.do",
        ref : "",
        target : "MxDataSet=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.MxDataSet_OnLoadCompleted(MxDataSet.getRowCount()); // 구 콜백 연결

};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name gform_onload
 * @description 구 gform onload — 수신기준일자 기본값(toDaySet)을 설정하고 목록(MxDataSet)을 조회한다.
 * @returns {void}
 * @hidden N
 * @example scwin.gform_onload();
 */
scwin.gform_onload = async function() {

    toDaySet(txb_date);
    const sbmOptions = {
        id : "sbm_MxDataSet",
        action : "/gauceSystemierAdaptor.do",
        ref : "",
        target : "MxDataSet=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.MxDataSet_OnLoadCompleted(MxDataSet.getRowCount()); // 구 콜백 연결

};
]]></script>

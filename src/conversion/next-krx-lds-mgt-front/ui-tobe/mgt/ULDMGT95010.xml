// 일반 함수
scwin.PanelMsg = function(panelID, msg) {
    const vTotalArea = "<span style='font-size__9pt; font-family:굴림; color:#5C8BE0; font-weight:bold'>" + msg + "</span>";
    panelID.innerHTML = "<table border='0' cellpadding='0' cellspacing='0' height='22' width='100%'>" + "    <tr>" + "        <td align='left' width='2%' nowrap>" + vTotalArea + "</td>" + "        <td align='center'></td>" + "        <td align='right' width='30'></td>" + "        <td align='right' width='2%' nowrap>&nbsp;</td>" + "    </tr>" + "</table>";
};

scwin.search = function() {
    const vMKT_ID = rdo_MKT_ID.getValue();
    const vFORM_CD = txb_FORM_CD.getValue();
    const vFORM_VER = txb_FORM_VER.getValue();
    const vREP_FORM_VER_YN = rdo_REP_FORM_VER_YN.getValue();
    url += "&LD_MKT_TP_CD=" + vMKT_ID;
    url += "&FORM_CD=" + vFORM_CD;
    url += "&FORM_VER=" + vFORM_VER;
    url += "&REP_FORM_VER_YN=" + vREP_FORM_VER_YN;
    url += "&ELMT_KOR_NM=" + txb_ELMT_KOR_NM.getValue();
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    scwin.PanelMsg(panel_msg, "로딩중....기다려주세요.");
    const sbmOptions = {
        id : "sbm_dts_List",
        action : "/kclic.do",
        ref : "",
        target : "dts_List=body.content",
        submitDoneHandler : scwin.dts_List_OnLoadCompleted,
        submitErrorHandler : scwin.dts_List_OnLoadError,
        isProcessMsg : false
    };

    $c.sbm.executeDynamic(sbmOptions);


};

scwin.save = function() {

};

//----W-Craft WebSquare 변환 확인: open----//
scwin.openForm = function(form_cd, form_ver, x_path, elmt_kor_nm) {
    //서식별로 모든항목들에 대해서 보여주려 했으나 팝업호출시 문자열이 길어 호출시 에러발생. 건별로 양식보기에서 보여준다.
    //var form_x_path = getFormXPath(form_cd,x_path); 
    const form_x_path = scwin.StringToHex4(elmt_kor_nm) + ":" + x_path;
    let url = "/filing/findForm.do?method=scheduleFormView";
    url += "&formCd=" + form_cd;
    url += "&formVer=" + form_ver;
    url += "&form_x_path=" + form_x_path;

    //----W-Craft WebSquare 변환 확인: open----//
    window.open(url, "", "scrollbars=yes,toolbar=no,resizable=yes,width=850,height=700,left=0,top=0");
};

scwin.StringToHex4 = function(OriginalString) {
    let ReturnString = "";
    for (let i = 0; i < OriginalString.length; i++) {
        const tmp = "0000" + (parseInt(OriginalString.charCodeAt(i)).toString(16));
        const tmp2 = tmp.substring(tmp.length - 4);
        ReturnString += tmp2;
    }
    return ReturnString.toUpperCase();
};

scwin.getFormXPath = function(form_cd, x_path) {
    let str = "";
    for (let i = 0; i < dts_List.getRowCount(); i++) {
        if (form_cd === dts_List.getCellData(i, "FORM_CD")) {
            if (i === 0) {
                str += dts_List.getCellData(i, "ELMT_KOR_NM");
                str += ":" + dts_List.getCellData(i, "X_PATH");
            } else {
                str += "," + dts_List.getCellData(i, "ELMT_KOR_NM");
                str += ":" + dts_List.getCellData(i, "X_PATH");
            }
        }
    }
    return str;
};

scwin.gform_onload = function() {
    // 패널라운드 처리
    $c.libRoundPanel.PanelToGroupBox(panel_1);
};

		<script type="text/javascript" lazy="false"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.toDay = '';
/* ★Wcraft guide★    
스크립트 수작업 유의사항
*/

scwin.clientnow = new Date();

/* 오늘 날짜를 구한다 */
scwin.curYear = scwin.clientnow.getYear();
scwin.curMonth = (scwin.clientnow.getMonth()) + 1;
scwin.curDay = scwin.clientnow.getDate();
if (scwin.curMonth <= 9) {
    scwin.curMonth = "0" + scwin.curMonth;
}
if (scwin.curDay <= 9) {
    scwin.curDay = "0" + scwin.curDay;
}
scwin.toDay = scwin.curYear + "" + scwin.curMonth + "" + scwin.curDay;

///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
};

scwin.onpageunload = function() {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.dSetLst_OnLoadCompleted = function(rowcount) {
    try {
        textbox_1.setValue("총 " + rowcount + "건");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.dSetLst_OnLoadCompleted" });
    }
};

scwin.btn_cal_onclick = function(e) {
    try {
        popUpCalendar(txb_date_bg, 'txb_date', 'yyyymmdd'); // alert('image_2.onclick');
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.btn_cal_onclick" });
    }
};

scwin.btn_sys_search_onclick = function(e) {
    try {
        if (txb_date.getValue() !== "") {
            scwin.listSync();
        } else {
            alert("일자를 지정하십시요");
        }
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.btn_sys_search_onclick" });
    }
};

scwin.txb_date_OnDblClick = function(e) {
    try {
        if (txb_date.getValue() !== "") {
            scwin.listSync();
        }
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.txb_date_OnDblClick" });
    }
};

scwin.btn_toExcel_onmouseover = function() {
    try {
        btn_toExcel.setBackgroundImage("../img/2_butt_toexcel.gif");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.btn_toExcel_onmouseover" });
    }
};

scwin.btn_toExcel_onmouseout = function() {
    try {
        btn_toExcel.setBackgroundImage("../img/2_butt_toexcel_dis.gif");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.btn_toExcel_onmouseout" });
    }
};

scwin.btn_toExcel_onclick = function(e) {
    try {
        if (dSetLst.CountRow !== 0) mgLst.GridToExcel("종합감리투자주의공시", "", "8");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT80600.btn_toExcel_onclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.listSync = async function() {
    const sbmOptions = {
        id : "sbm_dSetLst",
        action : "/svinvst.do",
        ref : "",
        target : "dSetLst=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

///////// 5. 일반/업무 함수 영역 /////////
scwin.setToDate = function() {
    txb_date.setValue(scwin.toDay);
    scwin.listSync();
};

scwin.gform_onload = async function() {
    const sbmOptions = {
        id : "sbm_dSetLst",
        action : "/gauceSystemierAdaptor.do",
        ref : "",
        target : "dSetLst=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    $c.libRoundPanel.PanelToGroupBox_01(panel_1);
    scwin.setToDate();
};
]]></script>

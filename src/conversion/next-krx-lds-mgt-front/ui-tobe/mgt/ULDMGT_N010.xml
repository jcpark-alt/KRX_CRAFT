        <script lazy="false" type="text/javascript"><![CDATA[///////// 2. 초기화 영역 /////////
scwin.onpageload = function() {
	scwin.vScrenID = "ULDMGT_N010";

    //$c.mgt.sessionSaveKey("hello", "world"); 
    //console.log($c.mgt.getSessionKey("hello"));
     
    scwin.nowDate = $c.mgt.getSysDate();
    console.log(scwin.nowDate);
    cal_date.setValue(scwin.nowDate);
    
    $c.util.setGridViewDelCheckBox(grd_dept);
    $c.data.setChangeCheckedDc(dlt_select_list_content);

    scwin.select_list_call();
};

///////// 3. 컴포넌트 이벤트 영역 /////////
scwin.btn_search_onclick = function (e) 
{
    scwin.select_list_call();
};

scwin.btn_init_onclick = function (e) 
{
    ipt_depCd.setValue("");
    ipt_depNm.setValue("");
    sel_gbn.setValue("");
    sel_useYn.setValue("");
    cal_date.setValue("");

};

scwin.btn_deptDel_onclick =  function (e) 
{
    let chkCnt = grd_dept.getCheckedJSON("chk");
    let msg = "삭제할 부서를 선택하십시요";
    if(chkCnt.length === 0){  $c.win.alert(msg); return;}

    let rowIdx = grd_dept.getCheckedIndex("chk");
    let rdepCd = dlt_select_list_content.getCellData(rowIdx, "depCd");
    let rdepNm = dlt_select_list_content.getCellData(rowIdx, "depNm");

    scwin.deleteFn(rowIdx, rdepCd, rdepNm);
};

scwin.btn_deptUpdate_onclick = function (e) 
{
	let chkCnt = grd_dept.getCheckedJSON("chk");
    let msg = "수정할 부서를 선택하십시요";
    if(chkCnt.length === 0)
    {  
        $c.win.alert(msg); 
        return;
    }

    let rowIdx = grd_dept.getCheckedIndex("chk");

    scwin.updateFn(rowIdx);
};

scwin.grd_dept_oncellclick =  async function (rowIndex, columnIndex, columnId) 
{
    console.log ("columnIndex :" + columnIndex + " rowIndex:"+ rowIndex+ "  columnId:"+ columnId);

    let rowIdx = rowIndex;
    let rdepCd = dlt_select_list_content.getCellData(rowIdx, "depCd");
    let rdepNm = dlt_select_list_content.getCellData(rowIdx, "depNm");

    if(columnIndex === 10)  //수정
    {
        scwin.updateFn(rowIdx, rdepCd, rdepNm);
    }	

    if(columnIndex === 11)  //삭제
    {

        scwin.deleteFn(rowIdx, rdepCd, rdepNm);
    }	
};

scwin.btn_deptInsert_onclick = async function (e) 
{
	
    const data = { type: "confirm", mode:"create"}; 
    const options = {
        id: "ConfirmPop",
        title: "Confirm_Pop",
        width:"920px",
        height: "570px"
    };

    const result = await $c.win.openPopup("/ui/mgt/ULDMGT_N011.xml", options, data);
    scwin.grd_afterDeptInsertCallback(result);
};

///////// 4. 서브미션 콜백 영역 /////////
scwin.sbm_select_list_submitdone = function (e) 
{
    const result = e.responseJSON;
    
    if(result.success) {
        const obj = result.body;
        
        dlt_select_list_content.setJSON(obj); 

        lbl_total.setValue(dlt_select_list_content.getRowCount());
    }
    else{
        $c.win.alert(result.message);
    }
};

scwin.grd_afterDeptInsertCallback = function(str)
{
    console.log("grd_afterDeptInsertCallback");
    
    scwin.select_list_call();
}

scwin.grd_afterDeptUpdateCallback = function(str)
{
    console.log("grd_afterDeptUpdateCallback");
     
    scwin.select_list_call();
}

///////// 5. 일반/업무 함수 영역 /////////
/********************************************** 
 * 함수명   : scwin.select_list_call()
 * 설명     : 초기 조회 
 ***********************************************/
scwin.select_list_call = function() {

    dma_select_list.set("delYn",      sel_useYn.getValue());
    dma_select_list.set("targetDd",   cal_date.getValue());
    
    dma_select_list.set("admDepTpCd", sel_gbn.getValue());
    dma_select_list.set("depNm",      ipt_depNm.getValue());
    dma_select_list.set("depCd",      ipt_depCd.getValue());
    
    $c.sbm.execute(sbm_select_list, dma_select_list.getJSON());
}

scwin.deleteFn = async function (idx, depCd, depNm)
{
    let rowIdx = idx;
    let rdepCd = depCd;
    let rdepNm = depNm;

    const vmsg = "부서 "+ rdepNm +"(" + rdepCd + ") 을(를) 삭제하시겠습니까? <br/><br/> 하위 부서가 있을경우 함께 삭제됩니다."; 

    if (await $c.win.confirm(vmsg)) 
    { 
        dma_delete.set("depCd", rdepCd);
        
        scwin.res = await $c.sbm.execute(sbm_delete,  dma_delete.getJSON());
        if (scwin.res.responseJSON.success === true) {
            scwin.res.saveFlag = "delete";
            $c.win.closePopup(scwin.res);

        }            
    } else {
        $c.win.closePopup();
    }
}

scwin.updateFn = async function (rowIdx)
{
    const data = { type: "confirm", jval: dlt_select_list_content.getRowJSON(rowIdx), mode:"update"}; 
    const options = {
        id: "ConfirmPop",
        title: "Confirm_Pop",
        width:"920px",
        height: "570px"
    };

    const result = await $c.win.openPopup("/ui/mgt/ULDMGT_N011.xml", options, data);
    scwin.grd_afterDeptUpdateCallback(result);
}
]]></script>

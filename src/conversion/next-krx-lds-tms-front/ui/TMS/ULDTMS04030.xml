<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="유형분류관리">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">                
                <w2:dataMap baseNode="map" id="dma_search">
        			<w2:keyInfo>
        				<w2:key id="formUpclssCd" name="서식대분류코드" dataType="text" />        				        				
                        <w2:key id="keyfield" name="검색조건" dataType="text" />
                        <w2:key id="keyword" name="검색조건명" dataType="text" />
                        <w2:key id="totalYn" name="총건수조회여부" dataType="text" />
                        <w2:key id="page" name="페이지" dataType="text" />
                        <w2:key id="size" name="한페이지건수" dataType="text" />
        			</w2:keyInfo>
        		</w2:dataMap>
                <w2:dataList id="dlt_list" baseNode="list" saveRemovedData="true" repeatNode="map">
        			<w2:columnInfo>                        
        				<w2:column id="formUpclssCd" name="서식대분류코드" dataType="text"></w2:column>
        				<w2:column id="formUpclssNm" name="서식대분류명" dataType="text"></w2:column>
        				<w2:column id="tpClssCd" name="유형분류코드" dataType="text"></w2:column>
        				<w2:column id="disclsTpClssNm" name="유형분류명" dataType="text"></w2:column>
                        <w2:column id="disclsTpClssEngNm" name="유형분류영문명" dataType="text"></w2:column>
                        <w2:column id="ldMktTpCd" name="시장구분" dataType="text"></w2:column>
                        <w2:column id="ldMktTpNm" name="시장구분명" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
            </w2:dataCollection>
            <w2:workflowCollection/>
            <xf:submission id="sbm_upclss" action="/api/code/form-upclss" method="get" mediatype="application/json"
        		ref="" target="" encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_upclss_submitdone" processMsg="공통코드 조회중...">
        	</xf:submission>
            <xf:submission id="sbm_list" action="/api/code/type-clss" method="get" mediatype="application/json"
        		ref="data:json,dma_search" target='data:json,{"id":"dlt_list","key":"body.content"}' encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_list_submitdone" processMsg="조회중...">
        	</xf:submission>
            <xf:submission id="sbm_del" action="" method="get" mediatype="application/json"
        		ref="" target="" encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_del_submitdone" processMsg="삭제중...">               
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
        
            scwin.pageId = "ULDTMS04030";
            scwin.scrollTop = "";

            scwin.onpageload = function () {

                scwin.vScrenID = "ULDTMS04030.xml";
                // 서식분류 정보 조회
                $c.sbm.execute(sbm_upclss);                
                // 초기화
                pgl_list.hide();
            };

            scwin.sbm_upclss_submitdone = function (e) {

                // 조회 성공인 경우
                const result = e.responseJSON;
                if (result.success) {
                    // select box 자동 생성
                    $c.tms.setSelectData(result.body, sbx_formUpclssCd, "formUpclssNm", "formUpclssCd");                    
                    // 편의상 바로 조회
                    scwin.fnSearch("Y", 1);
                } else {
                    $c.win.alert(result.message);
                }                                                    
            };
                    
            scwin.btn_search_onclick = function (e) {

                scwin.fnSearch("Y", 1);
            };

            scwin.fnSearch = function (totYn, index) {

                dma_search.set("totalYn", totYn);
                dma_search.set("page", index);
                dma_search.set("size", sbx_page.getValue());
                                
                // 조회 
                $c.sbm.execute(sbm_list, dma_search.getJSON());
            };

            scwin.sbm_list_submitdone = function (e) {
            
                // 조회 성공인 경우
                const result = e.responseJSON;
                if (result.success) {
                    const obj = result.body;
                    const firstYn = dma_search.get("totalYn");
                    let totalCnt = 0;

                    // 최초 조회일 경우에만 전체 건수를 구하여 전역변수에 담는다.
                    if (firstYn == "Y") {
                        if (!$c.util.isEmpty(obj.totalCount)) {
                            tbx_totCnt.setValue($c.num.formatNumber(obj.totalCount));
                            totalCnt = parseInt(obj.totalCount) || 0;
                        }        
                                        
                        // 데이터가 있는 경우에만 페이지 리스트 표시
                        if (totalCnt > 0) { 
                            pgl_list.setCount(obj.totalPages);
                            pgl_list.show();
                        } else {
                            pgl_list.hide();
                        }            
                    }
                    
                    // 재조회 여부 체크
                    if (!$c.util.isEmpty(scwin.scrollTop)) {
                        grd_list.setScrollTop(scwin.scrollTop);                        
                        scwin.scrollTop = "";
                    }                    
                } else {
                    $c.win.alert(result.message);
                }               
            };

            scwin.sbx_page_onchange = function (info) {

                scwin.fnSearch("Y", 1);
            };

            scwin.pgl_list_onclick = function (index) {

                scwin.fnSearch("N", index);
            };

            scwin.ibx_keyword_onkeyup = function (e) {

                if (e.key == "Enter") {                    
                    scwin.fnSearch("Y", 1);
                }
            };
                          
            scwin.btn_excel_onclick = function (e) {

                // 파라미터 처리
                const url = "/api/code/type-clss/excel";                
                $c.tms.downloadProc(url, dma_search.getJSON());                
            };           
            
            scwin.btn_insert_onclick = async function (e) {
                                         
                const result = await scwin.fnPopUp("유형분류 등록", {});
                if (!$c.util.isEmpty(result) && result.refreshYn == "Y") {
                    scwin.fnSearch("Y", 1);
                }
            };

            scwin.grd_list_oncellclick = async function (rowIndex, columnIndex, columnId) {

                if (columnId == "update") {
                    const params = {};
                    params.formUpclssCd = dlt_list.getCellData(rowIndex, "formUpclssCd");
                    params.tpClssCd = dlt_list.getCellData(rowIndex, "tpClssCd");
                    params.ldMktTpCd = dlt_list.getCellData(rowIndex, "ldMktTpCd");
                    params.disclsTpClssNm = dlt_list.getCellData(rowIndex, "disclsTpClssNm");
                    params.disclsTpClssEngNm = dlt_list.getCellData(rowIndex, "disclsTpClssEngNm");
                    params.storageId = scwin.pageId;

                    // 위치 정보 저장
                    $c.tms.setKeywordSave(scwin.pageId, grd_list, dma_search);
                 
                    const result = await scwin.fnPopUp("유형분류 변경", params);
                    if (!$c.util.isEmpty(result) && result.refreshYn == "Y") {
                        let page = 1;
                        let refreshYn = "Y";
                        if (!$c.util.isEmpty(result.storageId)) {
                            scwin.scrollTop = $c.tms.getKeywordSave(result.storageId, dma_search);
                    
                            if (dma_search.get("page") != "") {
                                page = dma_search.get("page");
                                refreshYn = "N";
                            }
                        }  
                        scwin.fnSearch(refreshYn, page);
                    } else {
                        $c.tms.delKeyword(scwin.pageId);
                    }
                } else if (columnId == "delete") {
                    if (await $c.win.confirm("삭제 하시겠습니까?")) {                     
                        $c.sbm.setAction(sbm_del, "/api/code/type-clss/delete/" + dlt_list.getCellData(rowIndex, "formUpclssCd") + "/" + dlt_list.getCellData(rowIndex, "tpClssCd") + "/" + dlt_list.getCellData(rowIndex, "ldMktTpCd"));                    
                        $c.sbm.execute(sbm_del);
                    }
                }
            };

            scwin.sbm_del_submitdone = async function (e) {

                const result = e.responseJSON;
                if (result.success) {
                    await $c.win.alert("삭제 되었습니다.");
                    scwin.fnSearch("Y", 1);
                } else {
                    $c.win.alert(result.message);
                }
            };
           
            scwin.fnButtonUpdateHtml = function (data, formattedData, rowIndex, columnIndex) {

                return "<button class='btn-edit'>변경</button>";
            };

            scwin.fnButtonDeleteHtml = function (data, formattedData, rowIndex, columnIndex) {
            
                return "<button class='btn-del' style='color:red;'>삭제</button>";
            };

            scwin.fnPopUp = function (title, params) {

                const url_ = "/ui/TMS/ULDTMS04040.xml";
                const options = {
                    id: "ULDTMS04040_POP",
                    popupName: title,
                    width: "670",
                    height: "330",
                    frameModal: "top"
                };
                return $c.win.openPopup(url_, options, params);              
            }

        ]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" meta_componentContainer="true" style="">
    		<w2:wframe style="" id="wfm_pageHeader" src="/cm/xml/contentHeader.xml"></w2:wframe>
    		<xf:group class="schbox" id="" style="">
    			<xf:group class="schbox_inner" id="" style="">
    				<xf:group adaptive="layout" adaptiveThreshold="768" class="w2tb tbl " id="" style="" tagname="table">
    					<w2:attributes>
    						<w2:summary></w2:summary>
    					</w2:attributes>
    					<xf:group tagname="colgroup">
    						<xf:group tagname="col" style="width:90px;"></xf:group><xf:group tagname="col" style=""></xf:group><xf:group style="width:80px;" tagname="col"></xf:group>
    						<xf:group style="" tagname="col"></xf:group>
    					</xf:group>
    					<xf:group class="" id="" style="" tagname="tr">
    						<xf:group tagname="th" class="w2tb_th"><w2:attributes>
    								<w2:scope>row</w2:scope>
    							</w2:attributes><w2:textbox class="req" id="" label="서식대분류" ref="" style="" userData2=""></w2:textbox></xf:group>
    						<xf:group tagname="td" class="w2tb_td">
    							<w2:attributes>
    								<w2:scope>row</w2:scope>
    							</w2:attributes>
    							<xf:select1 allOption="" appearance="minimal" chooseOption="true" class="" direction="auto" disabled="false"
    								disabledClass="w2selectbox_disabled" id="sbx_formUpclssCd" ref="data:dma_search.formUpclssCd" renderType=""
    								style="width: 120px;" submenuSize="auto" chooseOptionLabel="전체">
    								<xf:choices></xf:choices>
    							</xf:select1>
    						</xf:group>
    						<xf:group class="w2tb_th" style="" tagname="th">
    							<w2:textbox class="req" id="" label="검색조건" ref="" style="" userData2=""></w2:textbox>
    						</xf:group>
    						<xf:group class="w2tb_td" id="" style="" tagname="td">
    							<xf:select1 allOption="" appearance="minimal" chooseOption="true" class="" direction="auto" disabled="false"
    								disabledClass="w2selectbox_disabled" id="" ref="data:dma_search.keyfield" renderType="" style="width: 120px;" submenuSize="auto"
    								chooseOptionLabel="전체">
    								<xf:choices>
    									<xf:item>
    										<xf:label><![CDATA[유형분류명]]></xf:label>
    										<xf:value><![CDATA[tpClssNm]]></xf:value>
    									</xf:item>
    									<xf:item>
    										<xf:label><![CDATA[유형분류코드]]></xf:label>
    										<xf:value><![CDATA[tpClssCd]]></xf:value>
    									</xf:item>
    								</xf:choices>
    							</xf:select1>
    							<xf:input class="" id="ibx_keyword" placeholder="검색어를 입력하세요" style="width:160px;" refSync="true" ref="data:dma_search.keyword" ev:onkeyup="scwin.ibx_keyword_onkeyup"></xf:input>
    						</xf:group>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    			<xf:group class="btn_schbox" id="" style="">
    				<xf:trigger class="btn_cm sch" cursor="pointer" ev:onclick="scwin.btn_search_onclick" id="btn_search"
    					src="../img/btn_select.gif" style="">
    					<xf:label><![CDATA[조회]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<xf:group class="titbox" id="" style="">
    			<xf:group class="rt" id="" style="">
    				<xf:group class="count" id="" style="">
    					<w2:textbox class="" id="" label="총" style=""></w2:textbox>
    					<w2:textbox class="num" id="tbx_totCnt" label="0" style=""></w2:textbox>
    					<w2:textbox class="" id="" label="건" style=""></w2:textbox>
    				</xf:group>
    				<xf:select1 allOption="" appearance="minimal" chooseOption="" class="" direction="auto" disabled="false"
    					disabledClass="w2selectbox_disabled" id="sbx_page" ref="" renderType="" style="width: 100px;" submenuSize="auto"
    					ev:onchange="scwin.sbx_page_onchange">
    					<xf:choices>
    						<xf:item>
    							<xf:label><![CDATA[15개]]></xf:label>
    							<xf:value><![CDATA[15]]></xf:value>
    						</xf:item>
    						<xf:item>
    							<xf:label><![CDATA[30개]]></xf:label>
    							<xf:value><![CDATA[30]]></xf:value>
    						</xf:item>
    						<xf:item>
    							<xf:label><![CDATA[50개]]></xf:label>
    							<xf:value><![CDATA[50]]></xf:value>
    						</xf:item>
    						<xf:item>
    							<xf:label><![CDATA[100개]]></xf:label>
    							<xf:value><![CDATA[100]]></xf:value>
    						</xf:item>
    					</xf:choices>
    				</xf:select1>
    				<xf:trigger class="btn_cm download" id="btn_excel" style="" type="button" ev:onclick="scwin.btn_excel_onclick">
    					<xf:label><![CDATA[엑셀다운로드]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<xf:group adaptiveThreshold="" class="gvwbox" id="" style="">
    			<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_list" focusMode="row"
    				id="grd_list" scrollByColumn="false" scrollByColumnAdaptive="false" style="height: 153px;" ev:oncellclick="scwin.grd_list_oncellclick">
    				<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    				<w2:header id="header2" style="">
    					<w2:row id="row3" style="">
    						<w2:column blockSelect="false" displayMode="label" id="column1" inputType="text" removeBorderStyle="false"
    							value="대분류코드" width="100">
    						</w2:column>
    						<w2:column width="80" style="" inputType="text" id="column2" value="대분류명"></w2:column>
    						<w2:column width="100" style="" inputType="text" id="column3" value="유형분류코드"></w2:column>
    						<w2:column width="150" style="" inputType="text" id="column4" value="유형분류명"></w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column5" inputType="text" removeBorderStyle="false"
    							value="유형분류 영문명" width="290">
    						</w2:column>
    						<w2:column width="70" style="" inputType="text" id="column6" value="시장구분"></w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column7" inputType="text" removeBorderStyle="false"
    							value="변경/삭제" width="90" colSpan="2" rowSpan="">
    						</w2:column>
    					</w2:row>
    				</w2:header>
    				<w2:gBody id="gBody2" style="">
    					<w2:row id="row4" style="">
    						<w2:column blockSelect="false" displayMode="label" id="formUpclssCd" inputType="text" removeBorderStyle="false"
    							width="100" readOnly="true">
    						</w2:column>
    						<w2:column width="80" style="" inputType="text" id="formUpclssNm" value="" readOnly="true"></w2:column>
    						<w2:column width="100" style="" inputType="text" id="tpClssCd" value="" readOnly="true"></w2:column>
    						<w2:column width="150" style="" inputType="text" id="disclsTpClssNm" value="" readOnly="true"></w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="disclsTpClssEngNm" inputType="text"
    							removeBorderStyle="false" width="290" textAlign="left" readOnly="true">
    						</w2:column>
    						<w2:column width="70" style="" inputType="text" id="ldMktTpNm" value="" readOnly="true"></w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="update" inputType="text" removeBorderStyle="false"
    							width="48" customFormatter="scwin.fnButtonUpdateHtml" fixColumnWidth="true">
    						</w2:column>
    						<w2:column width="48" style="" inputType="text" id="delete" value="" customFormatter="scwin.fnButtonDeleteHtml" fixColumnWidth="true"></w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</xf:group>
    		<xf:group class="pglbox" id="">
    			<w2:pageList class="pgl" displayButtonType="display" displayFormat="#" id="pgl_list" pageSize="10" pagingType="0"
    				style="" ev:onclick="scwin.pgl_list_onclick">
    			</w2:pageList>
    		</xf:group>
    		<xf:group class="btnbox" id="">
    			<xf:group class="rt" id="">
    				<xf:trigger class="btn_cm pt" cursor="pointer" id="btn_insert" src="../img/btn_close.gif" style="" text="닫기" ev:onclick="scwin.btn_insert_onclick">
    					<xf:label><![CDATA[등록]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>

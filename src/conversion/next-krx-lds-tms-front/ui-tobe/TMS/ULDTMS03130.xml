<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="서식권한관리">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dma_search">
        			<w2:keyInfo>        				        				
                        <w2:key id="keyfield" name="검색조건" dataType="text" />
                        <w2:key id="keyword" name="검색조건명" dataType="text" />
        			</w2:keyInfo>
        		</w2:dataMap>
                <w2:dataList id="dlt_list" baseNode="list" saveRemovedData="true" repeatNode="map">
        			<w2:columnInfo>
        				<w2:column id="authId" name="서식권한ID" dataType="text"></w2:column>
        				<w2:column id="authNm" name="서식권한명" dataType="text"></w2:column>
        				<w2:column id="authDsc" name="서식권한설명" dataType="text"></w2:column>
        				<w2:column id="formCnt" name="서식권한별 서식수" dataType="text"></w2:column>
        			</w2:columnInfo>    
        		</w2:dataList>
            </w2:dataCollection>
            <xf:submission id="sbm_list" action="/api/form/form-auth" method="get" mediatype="application/json"
        		ref="data:json,dma_search" target='data:json,{"id":"dlt_list","key":"body"}' encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_list_submitdone" processMsg="조회중...">
        	</xf:submission>            
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[///////// 2. 초기화 영역 /////////
            scwin.onpageload = function() {

                scwin.vScrenID = "ULDTMS03130.xml";
///////// 1. 변수 및 선언 영역 /////////
scwin.pageId = "ULDTMS03130";
scwin.scrollTop = "";
                const storageId = $c.data.getParameter("storageId");

                if (!$c.util.isEmpty(storageId)) {
                    scwin.scrollTop = $c.tms.getKeywordSave(storageId, dma_search);                    
                }
                // 조회
                scwin.fnSearch();
            };

///////// 3. 컴포넌트 이벤트 영역 /////////
             scwin.btn_search_onclick = function (e) {

                scwin.fnSearch();
            };

            scwin.ibx_keyword_onkeyup = function (e) {

                if (e.key === "Enter") {                    
                    scwin.fnSearch();
                }
            };

            scwin.grd_list_oncellclick = async function (rowIndex, columnIndex, columnId) {

                if (columnId === "authId") {
                    const url_ = "/ui/TMS/ULDTMS03150.xml";

                    // 위치 정보 저장
                    $c.tms.setKeywordSave(scwin.pageId, grd_list, dma_search);

                    const params = {};
                    params.authId = dlt_list.getCellData(rowIndex, "authId");
                    params.authNm = dlt_list.getCellData(rowIndex, "authNm");
                    params.authDsc = dlt_list.getCellData(rowIndex, "authDsc");
                    params.storageId = scwin.pageId;

                    $c.win.moveUrl(url_, params);                                                 
                }
            };

///////// 4. 서브미션 콜백 영역 /////////
            scwin.sbm_list_submitdone = function (e) {
                            
                // 조회 성공인 경우
                const result = e.responseJSON;
                if (result.success) {                                        
                    // 총 건수
                    tbx_totCnt.setValue($c.num.formatNumber(dlt_list.getRowCount()));
                                        
                    // 재조회 여부 체크
                    if (!$c.util.isEmpty(scwin.scrollTop)) {
                        grd_list.setScrollTop(scwin.scrollTop);                        
                        scwin.scrollTop = "";
                    }
                } else {
                    $c.win.alert(result.message);
                }
            };

///////// 5. 일반/업무 함수 영역 /////////
            scwin.fnSearch = function () {
                                
                // 조회 
                $c.sbm.execute(sbm_list, dma_search.getJSON());
            };
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" meta_componentContainer="true" style="">
    		<w2:wframe style="" id="wfm_pageHeader" src="/cm/xml/contentHeader.xml"></w2:wframe>
    		<xf:group class="schbox" id="" style="">
    			<xf:group class="schbox_inner" id="" style="">
    				<xf:group adaptive="layout" adaptiveThreshold="768" class="w2tb tbl " id="" style="" tagname="table">
    					<w2:attributes>
    						<w2:summary></w2:summary>
    					</w2:attributes>
    					<xf:group tagname="colgroup">
    						<xf:group style="width:80px;" tagname="col"></xf:group>
    						<xf:group style="" tagname="col"></xf:group>
    					</xf:group>
    					<xf:group class="" id="" style="" tagname="tr">
    						<xf:group class="w2tb_th" style="" tagname="th">
    							<w2:textbox class="req" id="" label="검색조건" ref="" style="" userData2=""></w2:textbox>
    						</xf:group>
    						<xf:group class="w2tb_td" id="" style="" tagname="td">
    							<xf:select1 allOption="" appearance="minimal" chooseOption="true" class="" direction="auto" disabled="false"
    								disabledClass="w2selectbox_disabled" id="" ref="data:dma_search.keyfield" renderType="" style="width: 120px;" submenuSize="auto"
    								chooseOptionLabel="전체">
    								<xf:choices>
    									<xf:item>
    										<xf:label><![CDATA[권한ID]]></xf:label>
    										<xf:value><![CDATA[authId]]></xf:value>
    									</xf:item>
    									<xf:item>
    										<xf:label><![CDATA[권한명]]></xf:label>
    										<xf:value><![CDATA[authNm]]></xf:value>
    									</xf:item>
    								</xf:choices>
    							</xf:select1>
    							<xf:input class="" id="ibx_keyword" placeholder="검색어를 입력하세요" style="width:160px;" ref="data:dma_search.keyword" refSync="true" ev:onkeyup="scwin.ibx_keyword_onkeyup"></xf:input>
    						</xf:group>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    			<xf:group class="btn_schbox" id="" style="">
    				<xf:trigger class="btn_cm sch" cursor="pointer" ev:onclick="scwin.btn_search_onclick" id="btn_search"
    					src="../img/btn_select.gif" style="">
    					<xf:label><![CDATA[조회]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<xf:group class="titbox" id="" style="">
    			<xf:group class="rt" id="" style="">
    				<xf:group class="count" id="" style="">
    					<w2:textbox class="" id="" label="총" style=""></w2:textbox>
    					<w2:textbox class="num" id="tbx_totCnt" label="0" style=""></w2:textbox>
    					<w2:textbox class="" id="" label="건" style=""></w2:textbox>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    		<xf:group adaptiveThreshold="" class="gvwbox" id="" style="">
    			<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_list" focusMode="row" id="grd_list"
    				scrollByColumn="false" scrollByColumnAdaptive="false" style="height: 153px;" ev:oncellclick="scwin.grd_list_oncellclick">
    				<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    				<w2:header id="header2" style="">
    					<w2:row id="row3" style="">
    						<w2:column width="100" inputType="text" id="column1" value="권한ID"></w2:column>
    						<w2:column width="200" inputType="text" id="column2" value="권한명"></w2:column>
    						<w2:column width="280" inputType="text" id="column3" value="설명"></w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column4" inputType="text" removeBorderStyle="false"
    							value="서식 수 " width="80">
    						</w2:column>
    					</w2:row>
    				</w2:header>
    				<w2:gBody id="gBody2" style="">
    					<w2:row id="row4" style="">    						
    						<w2:column width="100" inputType="text" id="authId" style="cursor: pointer;" readOnly="true"></w2:column>
    						<w2:column width="200" inputType="text" id="authNm" textAlign="left" readOnly="true"></w2:column>
    						<w2:column width="280" inputType="text" id="authDsc" textAlign="left" readOnly="true"></w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="formCnt" inputType="text" removeBorderStyle="false"
    							width="80" readOnly="true">
    						</w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</xf:group>            
    	</xf:group>
    </body>
</html>

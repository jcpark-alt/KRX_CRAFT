        <w2:publicInfo method="scwin.onpageload,scwin.rdo_code_onclick,scwin.btn_close_onclick,scwin.btn_select_onclick"></w2:publicInfo><script lazy="false" type="text/javascript"><![CDATA[///////// 2. 초기화 영역 /////////

/**
 * @method
 * @name onpageload
 * @description 화면 진입점 — 파라미터(id: Period/Unit/Decimals)별 기본값 안내 문구를 표시하고 DataPoint 선택 영역을 숨긴다.
 * @returns {void}
 * @hidden N
 * @example (body ev:onpageload 바인딩으로 자동 호출)
 */
scwin.onpageload = function() {

    const id = $c.data.getParameter("id");

    if (id === "Period") {
        tbx_info.setValue("기본값: 서식 제출일");
    } else if (id === "Unit") {
        tbx_info.setValue("기본값: KRW");
    } else if (id === "Decimals") {
        tbx_info.setValue("기본값: 일 (INF)");
    }
    grp_2.hide();
};

///////// 3. 컴포넌트 이벤트 영역 /////////

/**
 * @method
 * @name rdo_code_onclick
 * @description 매핑 방식 라디오 클릭 — 선택 값(1:공통코드, 2:DataPoint, 3:사용자 입력)에 따라 하위 선택 영역을 표시/숨김한다.
 * @param {Number} index 클릭한 아이템 인덱스
 * @param {String} value 선택 값
 * @returns {void}
 * @hidden N
 * @example scwin.rdo_code_onclick(0, "1");
 */
scwin.rdo_code_onclick = function(index, value) {

    if (value === "1") {
        grp_1.show();
        grp_2.hide();
    } else if (value === "2") {
        grp_1.hide();
        grp_2.show();
    } else {
        grp_1.hide();
        grp_2.hide();
    }
};

/**
 * @method
 * @name btn_select_onclick
 * @description [적용] 버튼 클릭 — 팝업을 닫는다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example scwin.btn_select_onclick(e);
 */
scwin.btn_select_onclick = function(e) {

    $c.win.closePopup();
};

/**
 * @method
 * @name btn_close_onclick
 * @description [취소] 버튼 클릭 — 팝업을 닫는다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 * @example scwin.btn_close_onclick(e);
 */
scwin.btn_close_onclick = function(e) {

    $c.win.closePopup();
};
]]></script>

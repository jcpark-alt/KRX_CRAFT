        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.vScrenID = "ULDTMS02040.xml";

///////// 2. 초기화 영역 /////////
            scwin.onpageload = function() {

                const id = $c.data.getParameter("id");
                
                if (id === "Period") {
                    tbx_info.setValue("기본값: 서식 제출일");
                } else if (id === "Unit") {
                    tbx_info.setValue("기본값: KRW");
                } else if (id === "Decimals") {
                    tbx_info.setValue("기본값: 일 (INF)");    
                }                
                grp_2.hide();
            };

///////// 3. 컴포넌트 이벤트 영역 /////////
            scwin.rdo_code_onclick = function (index, value) {
                
                if (value === "1") {
                    grp_1.show();
                    grp_2.hide();
                } else if (value === "2") {
                    grp_1.hide();
                    grp_2.show();
                } else {
                    grp_1.hide();
                    grp_2.hide();
                }
            };

            scwin.btn_select_onclick = function (e) {
                
                $c.win.closePopup();
            };

            scwin.btn_close_onclick = function (e) {

                $c.win.closePopup();
            };
        
]]></script>
    </head>

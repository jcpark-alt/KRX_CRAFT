<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="기재상 주의사항 관리(상세)">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dma_save">
        			<w2:keyInfo>
                        <w2:key id="formCd" name="서식번호" dataType="text" />
                        <w2:key id="formVer" name="서식버전" dataType="text" />
                        <w2:key id="formWrtCautnContn" name="기재상주의 내용" dataType="text" />
                    </w2:keyInfo>
                </w2:dataMap>
            </w2:dataCollection>
            <w2:workflowCollection/>
            <xf:submission id="sbm_detail" action="" method="get" mediatype="application/json"
        		ref="" target='data:json,{"id":"dma_save","key":"body"}' encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_detail_submitdone" processMsg="조회중...">
        	</xf:submission>
            <xf:submission id="sbm_save" action="/api/form/wrt-cautn" method="post" mediatype="application/json"
        		ref="data:json,dma_save" target="" encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_save_submitdone" processMsg="저장중...">
        	</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[// scwin.onpageload, scwin.onpageunload 함수
            scwin.onpageload = function() {

				scwin.vScrenID = "ULDTMS03180.xml";
// 전역 변수 선언
scwin.storageId = "";
                scwin.storageId = $c.data.getParameter("storageId");
                
                dma_save.set("formCd", $c.data.getParameter("formCd"));
                dma_save.set("formVer", $c.data.getParameter("formVer"));
                ibx_formKorNm.setValue($c.data.getParameter("formKorNm"));
                                
                $c.sbm.setAction(sbm_detail, "/api/form/wrt-cautn/" + dma_save.get("formCd") + "/" + dma_save.get("formVer"));
                $c.sbm.execute(sbm_detail);	
            };

// WebSquare 컴포넌트 이벤트 함수
            scwin.btn_save_onclick = async function (e) {
                  
                // 기재상 주의 내용 저장
                $c.sbm.execute(sbm_save, dma_save.getJSON());
            };

            scwin.btn_close_onclick = function (e) {
                
                $c.win.closePopup();
            };

// 일반 함수
            scwin.sbm_detail_submitdone = function (e) {

                // 조회 성공인 경우
				const result = e.responseJSON;
                if (!result.success) {                    
					$c.win.alert(result.message);
				}
            };

            scwin.sbm_save_submitdone = async function (e) {
                
                const result = e.responseJSON;
                if (result.success) {
                    await $c.win.alert("저장 되었습니다.");
                    
                    let params = {};
                    params.refreshYn = "Y";
                    params.storageId = scwin.storageId;

                    $c.win.closePopup(params);
				} else {
					$c.win.alert(result.message);	
                }
            };
        
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="pop_contents" id="" meta_componentContainer="true" style="">
    		<xf:group class="tblbox" id="" style="">
    			<xf:group class="w2tb tbl" id="" style="" tagname="table">
    				<w2:attributes>
    					<w2:summary></w2:summary>
    				</w2:attributes>
    				<xf:group tagname="colgroup">
    					<xf:group style="width:150px;" tagname="col"></xf:group>
    					<xf:group style="" tagname="col"></xf:group>
    					<xf:group style="width:110px;" tagname="col"></xf:group>
    					<xf:group style="" tagname="col"></xf:group>
    					<xf:group style="width:80px;" tagname="col"></xf:group>
    					<xf:group style="" tagname="col"></xf:group>
    				</xf:group>
    				<xf:group style="" tagname="tr">
    					<xf:group class="w2tb_th " tagname="th">
    						<w2:attributes>
    							<w2:scope>row</w2:scope>
    						</w2:attributes>
    						<w2:textbox class="" id="" label="서식명" ref="" style="" userData2=""></w2:textbox>
    					</xf:group>
    					<xf:group class="w2tb_td" tagname="td">
    						<w2:attributes>
    							<w2:colspan>5</w2:colspan>
    							<w2:rowspan>1</w2:rowspan>
    						</w2:attributes>
    						<xf:input class="" id="ibx_formKorNm" placeholder="" style="width:100%;" disabled="true"></xf:input>
    					</xf:group>
    				</xf:group>
    				<xf:group style="" tagname="tr">
    					<xf:group class="w2tb_th " tagname="th">
    						<w2:attributes>
    							<w2:scope>row</w2:scope>
    						</w2:attributes>
    						<w2:textbox class="" id="" label="기재상주의 내용" ref="" style="" userData2=""></w2:textbox>
    					</xf:group>
    					<xf:group class="w2tb_td" tagname="td">
    						<w2:attributes>
    							<w2:colspan>5</w2:colspan>
    							<w2:rowspan>1</w2:rowspan>
    						</w2:attributes>
    						<xf:textarea class="" id="" placeholder="" style="width:100%;height: 132px;" ref="data:dma_save.formWrtCautnContn"></xf:textarea>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    		<xf:group class="btnbox" id="">
    			<xf:group class="rt" id="">
    				<xf:trigger class="btn_cm pt" cursor="pointer" id="btn_save" src="../img/btn_close.gif" style="" text="닫기" ev:onclick="scwin.btn_save_onclick">
    					<xf:label><![CDATA[저장]]></xf:label>
    				</xf:trigger>
    				<xf:trigger class="btn_cm" cursor="pointer" id="btn_close"
    					src="../img/btn_close.gif" style="" text="닫기" ev:onclick="scwin.btn_close_onclick">
    					<xf:label><![CDATA[닫기]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>

    				<w2:tabs disabled="false" id="tabs1" label="권한 서식" style=""></w2:tabs>
    				<w2:tabs disabled="false" id="tabs2" label="소속 User" style=""></w2:tabs>
    				<w2:content alwaysDraw="false" id="content1" style="">
    					<xf:group class="schbox" id="" style="">
    						<xf:group class="schbox_inner" id="" style="">
    							<xf:group adaptive="layout" adaptiveThreshold="768" class="w2tb tbl " id="" style="" tagname="table">
    								<w2:attributes>
    									<w2:summary></w2:summary>
    								</w2:attributes>
    								<xf:group tagname="colgroup">
    									<xf:group style="" tagname="col"></xf:group>
    								</xf:group>
    								<xf:group class="" id="" style="" tagname="tr">
    									<xf:group class="w2tb_td" style="" tagname="td">
    										<xf:select1 allOption="" appearance="minimal" chooseOption="true" class="" direction="auto"
    											disabled="false" disabledClass="w2selectbox_disabled" id="sbx_ldMktTpCd" ref="data:dma_search.ldMktTpCd" renderType=""
    											style="width: 100px;" submenuSize="auto" chooseOptionLabel="전체 시장">
    											<xf:choices></xf:choices>
    										</xf:select1>
    										<xf:input class="" id="ibx_formKorNm" placeholder="서식명 검색" style="width:160px;" ref="data:dma_search.formKorNm" refSync="true" ev:onkeyup="scwin.ibx_formKorNm_onkeyup"></xf:input>
    									</xf:group>
    								</xf:group>
    							</xf:group>
    						</xf:group>
    						<xf:group class="btn_schbox" id="" style="">
    							<xf:trigger class="btn_cm sch" cursor="pointer" id="btn_search"
    								src="../img/btn_select.gif" style="" ev:onclick="scwin.btn_search_onclick">
    								<xf:label><![CDATA[조회]]></xf:label>
    							</xf:trigger>
    						</xf:group>
    					</xf:group>
    					<xf:group class="titbox" id="" style="">
    						<xf:group class="rt" id="" style="">
    							<xf:trigger class="btn_cm" cursor="pointer" id="btn_del" src="../img/btn_close.gif" style="" text="닫기" ev:onclick="scwin.btn_del_onclick">
    								<xf:label><![CDATA[선택 삭제]]></xf:label>
    							</xf:trigger>
    							<xf:trigger class="btn_cm pt" cursor="pointer" id="btn_insert" src="../img/btn_close.gif" style="" text="닫기" ev:onclick="scwin.btn_insert_onclick">
    								<xf:label><![CDATA[서식 추가]]></xf:label>
    							</xf:trigger>
    						</xf:group>
    					</xf:group>
    					<xf:group adaptiveThreshold="" class="gvwbox" id="" style="">

<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="서식 권한 상세">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map">
                <w2:dataMap baseNode="map" id="dma_search">
        			<w2:keyInfo>        				        				
                        <w2:key id="ldMktTpCd" name="시장구분코드" dataType="text" />
                        <w2:key id="formKorNm" name="서식한글명" dataType="text" />
        			</w2:keyInfo>
        		</w2:dataMap>
                <w2:dataList id="dlt_list" baseNode="list" saveRemovedData="true" repeatNode="map">
        			<w2:columnInfo>
                        <w2:column id="CHK" name="선택" dataType="text" ignoreStatus="true"></w2:column>                        
        				<w2:column id="formAuthId" name="서식권한ID" dataType="text"></w2:column>
        				<w2:column id="ldMktTpCd" name="시장구분코드" dataType="text"></w2:column>
        				<w2:column id="ldMktTpNm" name="시장구분명" dataType="text"></w2:column>
        				<w2:column id="formCd" name="서식코드" dataType="text"></w2:column>
                        <w2:column id="formVer" name="서식버전" dataType="text"></w2:column>
                        <w2:column id="formKorNm" name="서식한글명" dataType="text"></w2:column>
                        <w2:column id="formUpclssNm" name="서식대분류명" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
                <w2:dataList id="dlt_usrList" baseNode="list" saveRemovedData="true" repeatNode="map">
        			<w2:columnInfo>
        				<w2:column id="depNm" name="부서명" dataType="text"></w2:column>
        				<w2:column id="empNo" name="사원번호" dataType="text"></w2:column>
        				<w2:column id="empNm" name="사원명" dataType="text"></w2:column>
        			</w2:columnInfo>
        		</w2:dataList>
            </w2:dataCollection>
            <xf:submission id="sbm_ldMktTpCd" action="/api/common/common-code" method="get" mediatype="application/json"
        		ref="" target="" encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_ldMktTpCd_submitdone" processMsg="공통코드 조회중...">
        	</xf:submission>
            <xf:submission id="sbm_list" action="" method="get" mediatype="application/json"
        		ref="data:json,dma_search" target='data:json,{"id":"dlt_list","key":"body"}' encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_list_submitdone" processMsg="조회중...">
        	</xf:submission>
            <xf:submission id="sbm_usrList" action="" method="get" mediatype="application/json"
        		ref="" target='data:json,{"id":"dlt_usrList","key":"body"}' encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_usrList_submitdone" processMsg="조회중...">
        	</xf:submission>
            <xf:submission id="sbm_del" action="/api/form/form-auth/end" method="post" mediatype="application/json"
        		ref="" target="" encoding="UTF-8" mode="asynchronous" ev:submitdone="scwin.sbm_del_submitdone" processMsg="삭제중...">               
        	</xf:submission>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[// scwin.onpageload, scwin.onpageunload 함수
            scwin.onpageload = function() {
                
                scwin.vScrenID = "ULDTMS03150.xml";
// 전역 변수 선언
scwin.storageId = "";
                scwin.storageId = $c.data.getParameter("storageId");

                tbx_authId.setValue($c.data.getParameter("authId"));
                tbx_authNm.setValue($c.data.getParameter("authNm"));
                tbx_authDsc.setValue($c.data.getParameter("authDsc"));

                sp_title.innerHTML = $c.data.getParameter("authId");
                // 시장구분코드
                const list = ["LD_MKT_TP_CD"];
                const params = {"cdEngNmList":list};

                // 시장구분 정보 조회
                $c.sbm.execute(sbm_ldMktTpCd, params);
                
                // 소속 User 정보 조회
                $c.sbm.setAction(sbm_usrList, "/api/form/form-auth/" + tbx_authId.getValue() + "/users");
                $c.sbm.execute(sbm_usrList);
            };

// WebSquare 컴포넌트 이벤트 함수
            scwin.ibx_formKorNm_onkeyup = function (e) {

                if (e.key === "Enter") {                    
                    scwin.fnSearch();
                }
            };

            scwin.btn_search_onclick = function (e) {

                scwin.fnSearch();
            };

            scwin.btn_list_onclick = function (e) {

                let params = {};
                if (scwin.storageId !== "") {
                    params.storageId = scwin.storageId;
                }
                const url_ = "/ui/TMS/ULDTMS03130.xml";
                $c.win.moveUrl(url_, params);
            };

            scwin.btn_del_onclick = async function (e) {

                // 체크된 삭제 대상 수집
                let formAuthIdList = [];
                for (let i=0; i < dlt_list.getRowCount(); i++) {
                    if (dlt_list.getCellData(i, "CHK") === "1") {						
                        let params = {};
                        params.formAuthId = dlt_list.getCellData(i, "formAuthId");
                        params.formCd = dlt_list.getCellData(i, "formCd");
                        params.formVer = dlt_list.getCellData(i, "formVer");

                        formAuthIdList.push(params);
                    }                    
                }

                // 삭제 처리
                if (formAuthIdList.length > 0) {
                    if (await $c.win.confirm("삭제 하시겠습니까?")) {  
                        $c.sbm.execute(sbm_del, formAuthIdList);
                    }                    
                } else {
                    $c.win.alert("삭제할 서식을 체크 해주세요.");
                }
            };

            scwin.btn_insert_onclick = async function (e) {
                 
                const url_ = "/ui/TMS/ULDTMS03160.xml";
                const options = {
                    id: "ULDTMS03160_POP",
                    popupName: "서식 추가",
                    width: "800",
                    height: "480",
                    frameModal: "top"
                };
                
                // 권한ID
                let params = {};
                params.authId = tbx_authId.getValue();
            
                const result = await $c.win.openPopup(url_, options, params);
                if (!$c.util.isEmpty(result) &&  result.refreshYn === "Y") {
                    scwin.fnSearch();
                }
            };

// 일반 함수
            scwin.sbm_ldMktTpCd_submitdone = function (e) {

                // 조회 성공인 경우
                const result = e.responseJSON;
                if (result.success) {
                    // select box 자동 생성
                    $c.tms.setSelectData(result.body, sbx_ldMktTpCd, "cdValNm", "cdVal", "LD_MKT_TP_CD", "cdEngNm");
                    scwin.fnSearch();                    
                } else {
                    $c.win.alert(result.message);
                }
            };

            scwin.fnSearch = function () {

                $c.sbm.setAction(sbm_list, "/api/form/form-auth/" + tbx_authId.getValue());
                // 조회 
                $c.sbm.execute(sbm_list, dma_search.getJSON());
            };

            scwin.sbm_list_submitdone = function (e) {
                                            
                // 조회 성공인 경우
                const result = e.responseJSON;
                if (!result.success) {                    
                    $c.win.alert(result.message);
                }            
            };

            scwin.sbm_usrList_submitdone = function (e) {
                                            
                // 조회 성공인 경우
                const result = e.responseJSON;
                if (!result.success) {                    
                    $c.win.alert(result.message);
                }                
            };

            scwin.sbm_del_submitdone = async function (e) {

                const result = e.responseJSON;
                if (result.success) {
                    await $c.win.alert("삭제 되었습니다.");
                    scwin.fnSearch();
                } else {
                    $c.win.alert(result.message);
                }
            };
    

        
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" meta_componentContainer="true" style="">
    		<xf:group class="pgtbox" id="" style="">
    			<w2:textbox class="pgt_tit" id="" label="서식권한 상세 - &lt;span id='sp_title' class='blue'&gt;&lt;/span&gt;" style="" tagname=""
    				escape="false">
    			</w2:textbox>
    		</xf:group>
    		<xf:group class="tblbox" id="" style="">

    										removeBorderStyle="false" value="서식버전" width="80">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="column5" inputType="text"
    										removeBorderStyle="false" value="서식명" width="500">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="column6" inputType="text"
    										removeBorderStyle="false" value="대분류" width="100">
    									</w2:column>
    								</w2:row>
    							</w2:header>
    							<w2:gBody id="gBody2" style="">
    								<w2:row id="row4" style="">
    									<w2:column blockSelect="false" displayMode="label" id="CHK" inputType="checkbox"
    										removeBorderStyle="false" width="50">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="ldMktTpNm" inputType="text"
    										removeBorderStyle="false" width="80">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="formCd" inputType="text"
    										removeBorderStyle="false" width="80">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="formVer" inputType="text"
    										removeBorderStyle="false" width="80">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="formKorNm" inputType="text"
    										removeBorderStyle="false" width="500" textAlign="left">
    									</w2:column>
    									<w2:column blockSelect="false" displayMode="label" id="formUpclssNm" inputType="text"
    										removeBorderStyle="false" width="100">
    									</w2:column>
    								</w2:row>
    							</w2:gBody>
    						</w2:gridView>
    					</xf:group>
    				</w2:content>
    				<w2:content alwaysDraw="false" id="content2" style="">
    					<w2:textbox class="txt_info mb15" id="" label="이 권한에 배정된 사용자 목록입니다." ref="" style="" userData2=""></w2:textbox>

]]></event>
<event for="chk_SRI_BND_TP_CD" eventname="onclick"><![CDATA[
	if( getObjectValue(chk_SRI_BND_TP_CD) == "Y" && tab_Main.ActiveIndex != 1){
		alert("[개별종목], [일괄상장종목] 탭은 ESG채권과 함께 사용 할 수 없습니다.");
		setObjectValue(chk_SRI_BND_TP_CD, "N");
	}
	if( getObjectValue(chk_SRI_BND_TP_CD) == "Y" ){
		setObjectValue(rdo_DD_TP, "1");
		rdo_DD_TP.Enable = false;
	} else {
		rdo_DD_TP.Enable = true;
	}
]]></event></events>
</gform>

	vs_G_BND_MKTACT_TP_NM = dts_List3.NameString(row, 'MKT_NM'); //종목상세조회화면팝업에 쓰임 
	vs_G_BKBND_TP_CD	         = dts_List3.NameString(row, 'BKBND_TP_CD'); //종목상세조회화면팝업에 쓰임 	
	vs_G_STRT_DD	                 = dts_List3.NameString(row, 'APL_DT'); //종목상세조회화면팝업에 쓰임 
	vs_G_STRT_DD = vs_G_STRT_DD.replace(/-/g,"");
	vs_G_STD_CD	                     = dts_List3.NameString(row, 'ISU_CD'); //종목상세조회화면팝업에 쓰임 
	if(vs_G_BND_MKTACT_TP_CD == "112"||vs_G_BND_MKTACT_TP_CD == "122"||vs_G_BND_MKTACT_TP_CD == "132"){
		vs_G_BND_MKTACT_TP_CD = vs_G_BND_MKTACT_TP_CD+"Y";

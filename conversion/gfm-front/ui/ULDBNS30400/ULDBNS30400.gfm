	vs_G_BND_MKTACT_TP_CD = dts_List2.NameString(row, 'BND_MKTACT_TP_CD'); //종목상세조회화면팝업에 쓰임 
	vs_G_BND_MKTACT_TP_NM = dts_List2.NameString(row, 'MKT_NM'); //종목상세조회화면팝업에 쓰임 
	vs_G_BKBND_TP_CD            = dts_List2.NameString(row, 'BKBND_TP_CD'); //종목상세조회화면팝업에 쓰임 	
	vs_G_STRT_DD	                 = dts_List2.NameString(row, 'APL_DT'); //종목상세조회화면팝업에 쓰임 
	vs_G_STRT_DD = vs_G_STRT_DD.replace(/-/g,"");
	vs_G_STD_CD	                     = dts_List2.NameString(row, 'ISU_CD'); //종목상세조회화면팝업에 쓰임 
    vs_G_ISUR_CD                     = dts_List2.NameString(row, 'ISUR_CD'); //발행기관코드

	fn_GetPar = fn_GetCommonKey;
	fn_PopClsProcesStatIsuInfo(vs_G_BND_MKTACT_TP_CD);
]]></event>
<event for="grd_List3" eventname="OnDblClick(row, colid)"><![CDATA[

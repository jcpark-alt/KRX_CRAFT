]]></event>
<event for="tab_Main" eventname="OnSelChanged(nIndex)"><![CDATA[
/********************************************** 
	* 함수명   : tab_Main > OnSelChanged
	* 설명      : 텝 변경
	***********************************************/
	//전체
	if(nIndex==1){
		
		cmb_BndStsGb.CBData = "0^전체,1^미처리,2^처리중,3^처리완료,4^반송";
		cmb_BndStsGb.ResetData();
		
		txb_ISU_CD.disabled = false;
		btn_ISU_CD_SEARCH.disabled = false;
		btn_ISU_CD_SEARCH.src = "../img/btn_search.gif";

		rdo_DD_TP.Enable = true;
	//개별종목
	}else if(nIndex==2){
		
		if( getObjectValue(chk_SRI_BND_TP_CD) == "Y" ){
			alert("[개별종목], [일괄상장종목] 탭은 ESG채권과 함께 사용 할 수 없습니다.");
			tab_Main.ActiveIndex = 1;
			return;
		}

		cmb_BndStsGb.CBData = "0^전체,1^미처리,2^처리중,3^처리완료,4^반송";
		cmb_BndStsGb.ResetData();
		
		txb_ISU_CD.disabled = false;
		btn_ISU_CD_SEARCH.disabled = false;
		btn_ISU_CD_SEARCH.src = "../img/btn_search.gif";

		rdo_DD_TP.Enable = true;
	// 일괄상장종목
	}else if(nIndex==3){

		if( getObjectValue(chk_SRI_BND_TP_CD) == "Y" ){
			alert("[개별종목], [일괄상장종목] 탭은 ESG채권과 함께 사용 할 수 없습니다.");
			tab_Main.ActiveIndex = 1;
			return;
		}
	
		cmb_BndStsGb.CBData = "0^전체,1^미처리,3^접수완료,4^반송";
		cmb_BndStsGb.ResetData();
		
		txb_ISU_CD.value = "";
		txb_ISU_NM.value = "";
		txb_ISU_CD.blur();
		txb_ISU_CD.disabled = true;
		btn_ISU_CD_SEARCH.disabled = true;	
		btn_ISU_CD_SEARCH.src = "../img/btn_search_d.gif";

		setObjectValue(rdo_DD_TP, "1");
		rdo_DD_TP.Enable = false;
	}
]]></event>
<event for="grd_List1" eventname="OnDblClick(row, colid)"><![CDATA[
/********************************************** 
	* 함수명   : grd_List1 > OnDblClick
	* 설명      : 팝업호출
	***********************************************/
	if (row == 0) return;
	vs_G_BND_APPL_ID             = dts_List1.NameString(row, 'BND_APPL_ID');             //종목상세조회화면팝업에 쓰임 
	vs_G_BND_MKTACT_TP_CD = dts_List1.NameString(row, 'BND_MKTACT_TP_CD'); //종목상세조회화면팝업에 쓰임 
	vs_G_BND_MKTACT_TP_NM = dts_List1.NameString(row, 'MKT_NM'); //종목상세조회화면팝업에 쓰임 
	vs_G_BKBND_TP_CD	         = dts_List1.NameString(row, 'BKBND_TP_CD'); //종목상세조회화면팝업에 쓰임 
	vs_G_STRT_DD	                 = dts_List1.NameString(row, 'APL_DT'); //종목상세조회화면팝업에 쓰임 
	vs_G_STRT_DD = vs_G_STRT_DD.replace(/-/g,"");
	vs_G_STD_CD	                     = dts_List1.NameString(row, 'ISU_CD'); //종목상세조회화면팝업에 쓰임 
    vs_G_ISUR_CD                     = dts_List1.NameString(row, 'ISUR_CD'); //발행기관코드

	if(dts_List1.NameString(row,"SEARCH_GB_NM") == "일괄상장종목"){
		if(vs_G_BND_MKTACT_TP_CD == "112"||vs_G_BND_MKTACT_TP_CD == "122"||vs_G_BND_MKTACT_TP_CD == "132"){
			vs_G_BND_MKTACT_TP_CD = vs_G_BND_MKTACT_TP_CD+"Y";
		}	
	}
	
	fn_GetPar = fn_GetCommonKey;
	fn_PopClsProcesStatIsuInfo(vs_G_BND_MKTACT_TP_CD);
]]></event>
<event for="grd_List2" eventname="OnDblClick(row, colid)"><![CDATA[
/********************************************** 
	* 함수명   : grd_List2 > OnDblClick

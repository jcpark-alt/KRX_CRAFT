<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/PopupCalendar.js");
	#include("../js/stf.js"); // showObj(ObjID, flag) SetWindowPos(ObjID, nTop, nLeft, nWidth, nHeight)
	#include("../js/utils.js");
	#include("../js/common.js");
	#include("../js/list_common.js");
	#include("../js/pre_newlisting.js"); 
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/bns_common.js");

	var clickBzProcsNo = "";
	var vScrenID = "ULDBNS30400.gfm";
	var vs_G_BND_APPL_ID = "";             //종목상세조회화면팝업에 쓰임 
	var vs_G_BND_MKTACT_TP_CD = ""; //종목상세조회화면팝업에 쓰임 
	var vs_G_BND_MKTACT_TP_NM = ""; //종목상세조회화면팝업에 쓰임 
	var vs_G_BKBND_TP_CD = "";           //종목상세조회화면팝업에 쓰임 
	var vs_G_STRT_DD = "";                   //종목상세조회화면팝업에 쓰임 
	var vs_G_STD_CD = "";                     //종목상세조회화면팝업에 쓰임 
	
	var fn_GetPar,fn_SetPar;
	
	/********************************************** 
	* 설명       : 일자 조회
	***********************************************/
	function fn_getDate(){
		var url = "/listingCommon.do?method=listGeneral&outputMessageId=ULDSTF41001_INOUT" +
			"&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			"&queryId=lds.stf.lstmgt.elwko.select.getPrevBusiDt";

		dts_getDate.DataID = encodeURI(url);
		dts_getDate.reset();
	}
	
	/********************************************** 
	* 함수명   : fn_GetCommonKey
	* 설명       : 팝업에 넘길 키데이터를 정의한다.
	***********************************************/
	function fn_GetCommonKey(arrPar) { 
		arrPar[0] = {
			  BND_APPL_ID	 		    : vs_G_BND_APPL_ID			
			, BND_MKTACT_TP_CD	: vs_G_BND_MKTACT_TP_CD
			, BND_MKTACT_TP_NM	: vs_G_BND_MKTACT_TP_NM
			, BKBND_TP_CD       : vs_G_BKBND_TP_CD			
			, STRT_DD           : vs_G_STRT_DD
			, STD_CD            : vs_G_STD_CD
            , ISUR_CD           : vs_G_ISUR_CD
		};
		return arrPar, length;
	}
	
	/********************************************** 
	* 설명       : 종목선택목록 세팅
	***********************************************/
	function fn_SetParForIsuCd(arrPar) {
		txb_ISU_CD.value = arrPar[0].ISU_CD;
		txb_ISU_NM.value = arrPar[0].ISU_NM;
	}
	
	/********************************************** 
	* 함수명   : fn_GetParIsurCd
	* 설명       : 발행기관 팝업에 넘길 데이터를 정의한다.
	***********************************************/
	function fn_GetParIsurCd(arrPar) { 
		arrPar[0] = {
			ISUR_CD			: getObjectValue(txb_ISUR_CD)
		};
		return arrPar, length;
	}

	/********************************************** 
	* 함수명   : fn_SetParIsurCd
	* 설명       : 발행기관 팝업에서 받은 데이터를 설정한다.
	***********************************************/
	function fn_SetParIsurCd(arrPar) { 
		setObjectValue(txb_COM_NM, arrPar[0].ISUR_NM);
		setObjectValue(txb_ISUR_CD, arrPar[0].ISUR_CD);
	}
	
	/********************************************** 
	* 함수명   : fn_ShowIsur
	* 설명       : 발행기관 팝업을 보여준다.
	***********************************************/
	function fn_ShowIsur(img_CoSearch) {
		fn_GetPar = fn_GetParIsurCd;
		fn_SetPar = fn_SetParIsurCd;
		fn_PopIsurSearch(img_CoSearch);	
	}
	
	/********************************************** 
	* 함수명   : fn_GetParListBndIsu
	* 설명       : 상장종목 팝업에 넘길 데이터를 정의한다.
	***********************************************/
	function fn_GetParListBndIsu(arrPar) { 
		arrPar[0] = {
			LIST_TYPE_CD : '2'
			, ISUR_NM	: getObjectValue(txb_ISUR_CD)
			, ISU_NM 	: getObjectValue(txb_ISU_CD)
		};
		return arrPar, length;
	}	
	/********************************************** 
	* 함수명   : fn_SetParListBndIsu
	* 설명       : 상장종목 팝업에서 받은 데이터를 설정한다.
	***********************************************/
	function fn_SetParListBndIsu(arrPar) { 
		setObjectValue(txb_ISU_CD, arrPar[0].STD_CD);
		setObjectValue(txb_ISU_NM, arrPar[0].ISU_NM);
	}	

	/********************************************** 
	* 설명       : 조회
	***********************************************/
	function fn_Search() {
		var vsTabSel = tab_Main.ActiveIndex;
		
		// 전체조회
		if(vsTabSel=="1"){
			fn_Search1() ;
		// 개별종목조회
		}else if(vsTabSel=="2"){
			fn_Search2() ;
		// 일괄상장종목조회
		}else if(vsTabSel=="3"){
			fn_Search3() ;
		}
	}

	/********************************************** 
	* 설명       : 전체조회
	***********************************************/
	function fn_Search1() {

		var url = "/listingCommon.do?method=listGeneralForDynamicName" ;
			url += "&service=krx.lds.stf.listingcommon.services.ListingCommonApp";
			url += "&outputMessageId=BNS_CLS_PROCES_STAT_LIST";
			url += "&queryId=lds.stf.bnscls_proces_stat.select.list1";
			url += "&SCREN_ID="+ vScrenID ;
			url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_01 ;
			url += "&{P}V_CO_NM="           + txb_ISUR_CD.value;
			url += "&{P}V_ISU_NM="           + txb_ISU_CD.value;
			url += "&{P}V_EMP_NM="         + txb_EmpNm.value;			
			url += "&{P}V_MKT_RSN_CD=" + getObjectValue(cmb_MktStsGb);
			url += "&{P}V_STATE="            + getObjectValue(cmb_BndStsGb);
			url += "&{P}V_STRT_DD="       + getObjectValue(edt_SDate);
			url += "&{P}V_END_DD="         + getObjectValue(edt_EDate);
			url += "&{P}V_SRI_BND_TP_CD="  + getObjectValue(chk_SRI_BND_TP_CD);
			url += "&{P}V_DD_TP="  + getObjectValue(rdo_DD_TP);		 

		dts_List1.DataID = encodeURI(url);
		dts_List1.Reset();
		
		ShowWin(grd_List1);
	}
	
	/********************************************** 
	* 설명       : 개별종목조회
	***********************************************/
	function fn_Search2() {

		var url = "/listingCommon.do?method=listGeneralForDynamicName" ;
			url += "&service=krx.lds.stf.listingcommon.services.ListingCommonApp";
			url += "&outputMessageId=BNS_CLS_PROCES_STAT_LIST";
			url += "&queryId=lds.stf.bnscls_proces_stat.select.list2";
			url += "&SCREN_ID="+ vScrenID ;
			url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_01 ;
			url += "&{P}V_CO_NM="           + txb_ISUR_CD.value;
			url += "&{P}V_ISU_NM="           + txb_ISU_CD.value;
			url += "&{P}V_EMP_NM="         + txb_EmpNm.value;			
			url += "&{P}V_MKT_RSN_CD=" + getObjectValue(cmb_MktStsGb);
			url += "&{P}V_STATE="            + getObjectValue(cmb_BndStsGb);			
			url += "&{P}V_STRT_DD="       + getObjectValue(edt_SDate);
			url += "&{P}V_END_DD="         + getObjectValue(edt_EDate);
			url += "&{P}V_DD_TP="  + getObjectValue(rdo_DD_TP);		 

		dts_List2.DataID = encodeURI(url);
		dts_List2.Reset();
		
		ShowWin(grd_List2);
	}
	
	/********************************************** 
	* 설명       : 일괄상장종목
	***********************************************/
	function fn_Search3() {
		
		var url = "/listingCommon.do?method=listGeneralForDynamicName" ;
			url += "&service=krx.lds.stf.listingcommon.services.ListingCommonApp";
			url += "&outputMessageId=BNS_CLS_PROCES_STAT_LIST";
			url += "&queryId=lds.stf.bnscls_proces_stat.select.list3";
			url += "&SCREN_ID="+ vScrenID ;
			url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_01 ;
			url += "&{P}V_CO_NM="           + txb_ISUR_CD.value;
			//url += "&{P}V_ISU_NM="           + txb_ISU_CD.value;
			url += "&{P}V_EMP_NM="         + txb_EmpNm.value;			
			url += "&{P}V_MKT_RSN_CD=" + getObjectValue(cmb_MktStsGb);
			url += "&{P}V_STATE="            + getObjectValue(cmb_BndStsGb);
			url += "&{P}V_STRT_DD="       + getObjectValue(edt_SDate);
			url += "&{P}V_END_DD="         + getObjectValue(edt_EDate);
		 
		dts_List3.DataID = encodeURI(url);
		dts_List3.Reset();
		
		ShowWin(grd_List3);
	}	
	
	/********************************************** 
	* 설명       : 일괄은행채권 월별등록현황
	***********************************************/
	function fn_SearchDetail(row){
	
		var url = "/listingCommon.do?method=listGeneralForDynamicName" ;
			url += "&service=krx.lds.stf.listingcommon.services.ListingCommonApp";
			url += "&outputMessageId=BNS_CLS_PROCES_STAT_LIST_DETAIL";
			url += "&queryId=lds.stf.bnscls_proces_stat.select.list3detail";
			url += "&SCREN_ID="+ vScrenID ;
			url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_01 ;
			url += "&{P}V_BND_APPL_ID="           + dts_List3.NameString(row, 'BND_APPL_ID');        //
		 
		dts_ListDet.DataID = encodeURI(url);
		dts_ListDet.Reset();
		
		ShowWin(grd_ListDetail);
	}

	/********************************************** 
	* 설명       : 정보를 excel로 다운 받는다.
	***********************************************/
	function fn_ExcelDown(){

		var vsTabSel = tab_Main.ActiveIndex;
		var voDtsList = null;
		var voGrid     = null;
		var excelSheet = '';
		var today = cGetToday("yyyymmddhhmmss");
		var xls_path = getExcelDownPath();

		// 전체조회
		if(vsTabSel=="1"){
			xls_path = xls_path + "채권처리현황(전체)_" + today + ".xlsx";
			voDtsList = dts_List1;
			voGrid    = grd_List1;
		// 개별종목조회
		}else if(vsTabSel=="2"){
			xls_path = xls_path + "채권처리현황(개별)_" + today + ".xlsx";
			voDtsList = dts_List2;
			voGrid    = grd_List2;
		// 일괄상장종목조회
		}else if(vsTabSel=="3"){
			xls_path = xls_path + "채권처리현황(일괄)_" + today + ".xlsx";
			voDtsList = dts_List3;
			voGrid    = grd_List3;
		}

		if (voDtsList.countrow > 0){
			//엑셀 로그 
		    doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
			voGrid.GridToOffice("sheet1", xls_path, 8, 0); 
		} else {
			alert("해당데이터가 없습니다. 조회후 다운받으십시요.");
		}
		
	}

	/********************************************** 
	* 설명       : 정보를 excel로 다운 받는다.
	***********************************************/
	function fn_ExcelDown3(){	
		var today = cGetToday("yyyymmddhhmmss");
		var xls_path = getExcelDownPath() + "채권처리현황(일괄월별)_" + today + ".xlsx";
		if (dts_ListDet.countrow > 0){
		    doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
			grd_ListDetail.GridToOffice("sheet1", xls_path, 8, 0); 
		} else {
			alert("해당데이터가 없습니다. 조회후 다운받으십시요.");
		}
	}

]]></script>

<events><event for="gform" eventname="onload"><![CDATA[
/********************************************** 
	* 함수명   : gform > onload
	* 설명      : 화면 Onload
	***********************************************/
	BnsPanelToGroupBox(panel_Top);

	//시장조치
	var arrCid = [];
	arrCid.push({cid:'03057', cnm:'cmb_MktStsGb'});				
	fn_SetBnsComboToCode2(vScrenID, dts_Temp, arrCid, '전체');		
	
	fn_initSearchDate(edt_SDate, edt_EDate);                       // 신청일 기간
	var vCurDate = cGetToday("yyyymmdd");
	fn_getDate();
	setObjectValue(edt_SDate, dts_getDate.NameString(3, "CALND_DD"));	
	edt_EDate.text = cGetMinusDate2(cGetToday("yyyymmdd"),0);
	edt_SDate.text = cGetMinusDate2(cGetToday("yyyymmdd"),0);
	
	fn_Search();
]]></event>
<event for="btn_Search" eventname="onclick"><![CDATA[
/********************************************** 
	* 함수명   : btn_Search > onclick
	* 설명      : 조회버튼 클릭
	***********************************************/
	if ( compareFromToDate2(edt_SDate, edt_EDate) ) {
		fn_Search();
	}
]]></event>

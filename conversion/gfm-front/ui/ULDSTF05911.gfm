<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="980" height="480" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
		@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_3" left="10" top="10" width="960" height="410" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_22" class="TopCondition_01" left="20" top="10" width="60" height="20" text="변경상장일">
			<extproperty font-size="12" text-align="left"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="35" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_23" class="TopCondition_01" left="20" top="35" width="60" height="20" text="변경사유">
			<extproperty font-size="12" text-align="left"></extproperty>
			</label>
			<mxmaskedit id="edt_MktactEnforceDd" class="panel_maskedit_write_01" left="85" top="10" width="70" height="18">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_MktactEnforceDd" left="160" top="10" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<textbox id="txb_ChgRsnContn" class="TopCondition_01_write" left="85" top="35" width="450" height="20" maxlength="2000">
			<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<image id="img_SetIsuCd" left="10" top="60" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxgrid id="grd_isu" class="Grid_01" left="30" top="60" width="926" height="343">
			<property editable="True" fillarea="True" fixsizing="True" focusrect="False" gtitleheight="18" titleheight="18" xtitleheight="0"></property>
			<format>
				<fcolumn id="BZ_PROCS_NO" width="60" show="False" name="BZ_PROCS_NO"></fcolumn>
				<fcolumn id="번호" width="30" edit="none" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<fcolumn id="ISU_CD" width="100" show="True" name="종목코드" align="center" edit="none"></fcolumn>
				<fcolumn id="ISU_NM" width="210" show="True" name="종목명" edit="none"></fcolumn>
				<group name="변경전">
					<column id="BFCHG_EXER_PRC" width="85" name="행사가격" decao="8" edit="none"></column>
					<column id="BFCHG_ELW_KO_OCCR_BAS_PRC" width="125" align="right" name="조기종료발생기준가격" decao="3" edit="none"></column>
					<column id="BFCHG_CONV_RTO" width="80" name="전환비율" decao="6" edit="none"></column>
				</group>
				<group name="변경후">
					<column id="AFCHG_EXER_PRC" width="85" name="행사가격" decao="8"></column>
					<column id="AFCHG_ELW_KO_OCCR_BAS_PRC" width="125" align="right" name="조기종료발생기준가격" decao="3" edit="{IF(ELW_RGHT_TP_KIND_CD='3', 'true','false')}"></column>
					<column id="AFCHG_CONV_RTO" width="80" name="전환비율" decao="6"></column>
				</group>
			</format>
			<ref dataid="dts_Isu"></ref>
			</mxgrid>
		</panel>
		<image id="btn_Close" left="920" top="425" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="868" top="425" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="813" top="425" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Save" left="758" top="425" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="img_Excel" left="674" top="425" width="78" height="22" src="../img/btn_excelsave.gif"></image>
		<image id="btn_exelUpload" left="590" top="425" width="80" height="22" src="../img/btn_excelupload.gif"></image>
		<label id="label_3" class="TopCondition_01" left="8" top="425" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
		</label>
		<label id="label_1" left="18" top="425" width="570" height="20" text="엑셀업로드 에러시 체크사항 : 확장자 xls(Excel 97/2003) 확인, 암호화 해제 확인, 쉬트명 &quot;Sheet1&quot; 확인">
			<extproperty font-family="굴림" font-size="12"></extproperty>
		</label>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF05911.gfm";
	var Isur_cd = "", Isur_nm = "", Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" ,  gubun = "" ;

	var trsIdx ;  // insert, update 구분
	 
	var isFirstLoad = false ;
	
	function fn_search() {
		if (fr_bz_procs_no != "") {
			var url = "/Listing.do?method=searchChgList" + 
						"&DIV_IDX="+DIV_IDX_CHGLIST_PRC + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			
			dts_Isu.DataID = encodeURI(url);
			dts_Isu.reset();
		}
	}
	
	function fn_new_onload() {
		var url = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=CHGLIST_PRC_INOUT";
		url += "&SCREN_ID=" + vScrenID;
		url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
		
		//dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=CHGLIST_PRC_INOUT";
		dts_Isu.DataID = encodeURI(url);
		dts_Isu.reset();
	}
	
	function fn_GetParIsu(arrPar , param_dts) {
		arrPar[0] = Isur_cd;
		arrPar[1] = gubun ;
		CopyDataSet( dts_Isu , param_dts) ;
	}
	
	function fn_SetParIsu(param_dts) {
		CopyDataSet( param_dts , dts_Isu) ;
	//alert(dts_Isu.text + "\n\n" + param_dts.text);
	}
	
	function fn_CheckForm() {
		if( ! checkDdTm ( "DD" , edt_MktactEnforceDd   , "변경상장", false )  ) return false ; 
		if( ! checkEmptyValue( txb_ChgRsnContn       , "변경사유"     ) ) return false ;
		if( ! checkMaxLength( txb_ChgRsnContn , 2000 , "변경사유" ) ) return false ;
	
		if( dts_Isu.CountRow == 0 ) {
			alert("[종목]을 선택하세요.");return false;
		}
		
		for (var i = 1 ; i <= dts_Isu.CountRow ; i++) 
		{ 
			if(  dts_Isu.NameString(i, "AFCHG_EXER_PRC") == ""  || dts_Isu.NameString(i, "AFCHG_EXER_PRC") == 0  ||
			    dts_Isu.NameString(i, "AFCHG_CONV_RTO") == ""  || dts_Isu.NameString(i, "AFCHG_CONV_RTO") == 0  ) 
			{
				alert(getMessageParam("MSG-0019", ""));
				return false ;
			} 
		}
		return true;
	}
	
	function fn_save_trs() {
		
		grd_isu.redraw=false ;
		for (var i = 1 ; i <= dts_Isu.CountRow  ; i++) { 
			dts_Isu.NameString(i, "ISUR_CD")	                 = Isur_cd ;
			dts_Isu.NameString(i, "BZ_PROCS_NO")	     = fr_bz_procs_no ;
			dts_Isu.NameString(i, "CHG_DD")					 = edt_MktactEnforceDd.Text ;
			dts_Isu.NameString(i, "CHG_RSN_CONTN")   = txb_ChgRsnContn.value ;
		};
		grd_isu.redraw=true ;
		
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if         ( trsIdx == TRS_IDX_INSERT )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( trsIdx == TRS_IDX_DELETE )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
			
		trs.Action 	     =fn_encodeNSession( "/Listing.do?method=saveChgList&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD);
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Isu )";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=1" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_147 + 
								",DIV_IDX[0]=" + DIV_IDX_CHGLIST_PRC  ;
		trs.Post();
	}
	
	function fn_save() {
		
		if (fn_CheckForm()) {
			if (! fn_isProcess('I') )  return ;
			fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );

			if (fr_bz_procs_no.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {
				trsIdx = TRS_IDX_INSERT ;
				fn_save_trs();
			}
		}
	}
	
   function fn_update() {
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			fn_save_trs();
		}	
	}

	function fn_delete() {
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_save_trs();
	}
	
	
	function fn_drft() { }
	function fn_makt() { }
	
]]></script>

<events><event for="trs" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
]]></event>

<event for="trs" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	
	if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
		frame.CloseFrame();
	} else {
		fn_search();
	}	
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar; // Provider화면에서 fn_GetPar명칭으로 선언된 함수를 획득
	var arrPar = new Array;
	
	if (fnc != undefined) {
		fnc(arrPar  ); // Provider화면의 callback함수를 호출하여 필요한 인수를 넘겨받는다.
		
		Isur_cd 		        = (arrPar.length >= 1 ? arrPar[0] : "");	// 발행기관코드
		Isur_nm 		        = (arrPar.length >= 2 ? arrPar[1] : "");	// 발행기관명
		Secugrp_id 		= (arrPar.length >= 3 ? arrPar[2] : "");	// 증권그룹ID
		Mkt_id	    	    = (arrPar.length >= 4 ? arrPar[3] : "");	// 시장구분코드
		fr_bz_procs_no 	= (arrPar.length >= 5 ? arrPar[4] : "");	// 업무처리번호(수정시만 유효)
		gubun   		        = (arrPar.length >= 6 ? arrPar[5] : "");	// 발행사/기초자산 구분값
	}
	
	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	//buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성

	if (fr_bz_procs_no != "")  { // Provider화면 에서 넘겨받은 업무처리번호가 ""가 아니라면 신규작성으로 간주한다.
		fn_search(); 
	} else {
		fn_new_onload();    // 신규작성시 호출
	}
	
	PanelToGroupBox(panel_3);
	
]]></event>
<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
<event for="img_MktactEnforceDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_MktactEnforceDd); 
]]></event>
<event for="dts_Isu" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (fr_bz_procs_no == "") {
		buttonSet.setInsertStatus();
	//	dts_Isu.AddRow();
	} else {
		if( dts_Isu.CountRow > 0 ) {
			edt_MktactEnforceDd.Text  = dts_Isu.NameString(1, "CHG_DD")				
			txb_ChgRsnContn.value     = dts_Isu.NameString(1, "CHG_RSN_CONTN")    ;
		}
		setButtonSetWithDate( edt_MktactEnforceDd , false ) ;
	}
]]></event>
<event for="img_SetIsuCd" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsu;
	fn_SetPar = fn_SetParIsu;
	
	fn_PopFindElwCode() ; 

]]></event>
<event for="img_Excel" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	if (dts_Isu.CountRow > 0) {
		grd_isu.GridToExcel("ELW 행사겨격/전환비율 변경", "", "8");
	} else {
		alert( NO_EXCEL_DATA );
	}
]]></event>
<event for="btn_exelUpload" eventname="onclick"><![CDATA[

		var res = window.confirm("엑셀자료를 업로드 하시면 그리드의 내용이 엑셀 데이터로 변경됩니다.");
        
		if(res){
	        dts_Isu.SetDataHeader("번호:,ISU_CD:,ISU_NM:,BFCHG_EXER_PRC:decimal,BFCHG_ELW_KO_OCCR_BAS_PRC:decimal,BFCHG_CONV_RTO:decimal,AFCHG_EXER_PRC:decimal,AFCHG_ELW_KO_OCCR_BAS_PRC:decimal,AFCHG_CONV_RTO:decimal,BZ_PROCS_NO:,ISUR_CD:,CHG_DD:,CHG_RSN_CONTN:,");
		    dts_Isu.Do("LoadExcelData","'','Sheet1',2,0,2");
		 }

]]></event></events>
</gform>

<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="610" height="680" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
		@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Mst">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="ISUR_CD" ctrl="txb_ISUR_CD" param="value" readonly="False"></column>
				<column col="ISUR_NM" ctrl="txb_COM_NM" param="value" readonly="False"></column>
				<column col="MKTACT_ENFORCE_DD" ctrl="edt_MKTACT_ENFORCE_DD" param="text" readonly="False"></column>
				<column col="CHG_DD" ctrl="edt_CHG_DD" param="text" readonly="False"></column>
				<column col="REMK" ctrl="txa_REMK" param="text" readonly="False"></column>
				<column col="FISCYY_CHG_RSN_CD" ctrl="cmb_FISCYY_CHG_RSN_CD" param="BindColVal" readonly="False"></column>
				<column col="FISCYY_CHG_STRT_DD" ctrl="edt_ChgStatDd" param="text" readonly="False"></column>
				<column col="FISCYY_CHG_END_DD" ctrl="edt_ChgEndDd" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_DtlBf">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_DtlAf">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Mst_Check">
			<property syncload="True" usechangeinfo="True" useupdate="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_3" left="5" top="5" width="595" height="635" class="TopCondition_01">
			<extproperty></extproperty>
			<label id="label_11" class="TopCondition_01" left="19" top="9" width="111" height="20" text="1. 회사코드(명)">
			<extproperty font-size="12" color="#343434" background-color="#d9e9fc"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="19" top="34" width="111" height="20" text="2. 수입분배기준일">
			<extproperty font-size="12" color="#343434" background-color="#d9e9fc"></extproperty>
			</label>
			<textbox id="txb_ISUR_CD" class="TopCondition_01_write" left="142" top="9" width="60" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<textbox id="txb_COM_NM" class="TopCondition_01_write" left="207" top="9" width="375" height="20" readonly="readonly" maxlength="1000" tabindex="1">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
			<label id="label_1" class="TopCondition_01" left="140" top="35" width="110" height="20" text="가. 변경전(월,일)">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="center"></extproperty>
			</label>
			<label id="label_4" class="TopCondition_01" left="280" top="35" width="110" height="20" text="나. 변경후(월,일)">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="center"></extproperty>
			</label>
			<label id="label_3" class="TopCondition_01" left="270" top="35" width="10" height="20" text="*">
			<extproperty font-size="12" color="#343434" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_13" class="Comment_02" left="240" top="396" width="170" height="20" text="(시스템 반영일자를 입력)">
			<extproperty font-size="12"></extproperty>
			</label>
			<image id="img_MKTACT_ENFORCE_DD" left="215" top="396" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_12" class="TopCondition_01" left="20" top="396" width="110" height="20" text="4. 시장조치시행일">
			<extproperty font-size="12" background-color="#d9e9fc"></extproperty>
			</label>
			<label id="label_5" class="TopCondition_01" left="10" top="396" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<mxmaskedit id="edt_MKTACT_ENFORCE_DD" class="panel_maskedit_write_01" left="140" top="395" width="70" height="20" tabindex="5">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_6" class="TopCondition_01" left="20" top="372" width="110" height="20" text="3. 변경일">
			<extproperty font-size="12" background-color="#d9e9fc"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="372" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<image id="img_CHG_DD" left="215" top="372" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_CHG_DD" class="panel_maskedit_write_01" left="140" top="371" width="70" height="20" tabindex="4">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxgrid id="grd_DIST_PAY_AF" class="Grid_01" left="275" top="57" width="108" height="316" tabindex="3">
			<property allshowedit="False" borderstyle="0" colsizing="True" editable="True" fillarea="False" gtitleheight="25" headborder="4" indwidth="0" titleheight="25" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<group name="수입분배기준일">
					<fcolumn id="BAS_MM" width="54" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="월" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
					<column id="BAS_DD" width="54" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				</group>
			</format>
			<ref dataid="dts_DtlAf"></ref>
			</mxgrid>
			<mxgrid id="grd_DIST_PAY_BF" class="Grid_01" left="140" top="57" width="108" height="308" tabindex="2">
			<property allshowedit="False" borderstyle="0" colsizing="True" editable="False" fillarea="False" gtitleheight="25" headborder="4" indwidth="0" titleheight="25" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<group name="수입분배기준일">
					<fcolumn id="BAS_MM" width="54" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="월" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
					<column id="BAS_DD" width="54" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				</group>
			</format>
			<ref dataid="dts_DtlBf"></ref>
			</mxgrid>
			<label id="label_10" class="TopCondition_01" left="20" top="500" width="110" height="20" text="6. 변경사유">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_7" class="TopCondition_01" left="20" top="524" width="110" height="20" text="7. 기타">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_9" class="TopCondition_01" left="10" top="500" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<mxcombo id="cmb_FISCYY_CHG_RSN_CD" class="TopCondition_01" left="140" top="500" width="440" height="20" tabindex="6">
			<property bindcolumn="code" cbdata="1^임시주주총회에서 결의,2^정기주주총회에서 결의,9^기타" cbdatacolumns="code,value" listcount="10" listexprformat="value^0^410"></property>
			</mxcombo>
			<mxtextarea id="txa_REMK" class="TextArea_01" left="140" top="524" width="438" height="99" tabindex="7">
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<label id="label_14" class="TopCondition_01" left="10" top="425" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_15" class="TopCondition_01" left="20" top="425" width="135" height="20" text="5. 변경 후 최초 사업연도">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_16" class="TopCondition_01" left="64" top="450" width="65" height="20" text="가. 시작일">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="left"></extproperty>
			</label>
			<label id="label_17" class="TopCondition_01" left="64" top="476" width="65" height="20" text="나. 종료일">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="left"></extproperty>
			</label>
			<mxmaskedit id="edt_ChgStatDd" class="panel_maskedit_write_01" left="140" top="450" width="70" height="18" tabindex="6">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_ChgEndDd" class="panel_maskedit_write_01" left="140" top="476" width="70" height="18" tabindex="7">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_ChgStatDd" left="215" top="450" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_ChgEndDd" left="215" top="476" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_18" left="30" top="55" width="60" height="20" text=" 변경내역"></label>
		</panel>
		<image id="btn_Save" left="236" top="646" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="291" top="646" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="346" top="646" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Drft" left="402" top="646" width="50" height="22" src="../img/btn_draft.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="456" top="646" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Close" left="551" top="646" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF05621.gfm";
    var vScrenTpCD = "";
	var Isur_cd = "", Isur_nm = "", Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" , haltTpCd = "";
	var fn_GetPar , fn_SetPar;

	var trsIdx;  // insert, update 구분
	 
	function fn_search() {
		if (fr_bz_procs_no != "") {
			var url = "/fiscalYearChange.do";
			url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
			url += "&method=searchFiscalYearChange&DIV_IDX="+DIV_IDX_FSC_MST + "&BZ_PROCS_NO=" + fr_bz_procs_no;
			
			dts_Mst.DataID = encodeURI(url);
			dts_Mst.reset();	
			
			url = "/fiscalYearChange.do";
			url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
			url += "&method=searchFiscalYearChange&DIV_IDX="+DIV_IDX_DTL_DIST_BF + "&BZ_PROCS_NO=" + fr_bz_procs_no;
			 
			dts_DtlBf.DataID = encodeURI(url);
			dts_DtlBf.reset();
			
			url = "/fiscalYearChange.do";
			url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
			url += "&method=searchFiscalYearChange&DIV_IDX="+DIV_IDX_DTL_DIST_AF + "&BZ_PROCS_NO=" + fr_bz_procs_no;
			 
			dts_DtlAf.DataID = encodeURI(url);
			dts_DtlAf.reset();
		}
	}


	function fn_new_onload() {

		dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=FSCCHG_MST_INOUT";
		dts_Mst.reset();
		
		dts_DtlAf.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=FSCCHG_DTL_INOUT";
		dts_DtlAf.reset();

		/* useupdate를 false로 지정함. */
		var url = "/fiscalYearChange.do";
			url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
			url += "&method=searchFiscalYearChange&DIV_IDX="+DIV_IDX_DTL_DIST_BF + "&TRS_IDX="+TRS_IDX_NEWSEL2 + "&ISUR_CD=" + Isur_cd;
				  
		dts_DtlBf.DataID = encodeURI(url); /* 관련종목을 모두 담고 SELECT 컬럼의 플래그로 선택여부를 확인한다. */
		dts_DtlBf.reset();
		
	}

	function fn_CheckForm() {

		for (i = 1;  i  <= dts_DtlAf.CountRow; i++) {
			dts_DtlAf.NameString(i ,  "BAS_MMDD") = dts_DtlAf.NameString(i ,  "BAS_MM") + dts_DtlAf.NameString(i ,  "BAS_DD");
			if( dts_DtlAf.NameString(i ,  "BAS_MMDD") != ""  && dts_DtlAf.NameString(i ,  "BAS_MMDD") .length != 4 ) {
				alert("입력한 항목중 [변경후(월,일)]을 정확히 입력해주세요. \n\n예 : 5월1일 -> 0501 " );  return false;
			} 
		}

		if (edt_CHG_DD.text.length != 8 ) { alert("[변경일]을 정확히 입력하세요."); edt_CHG_DD.focus(); return false; }		

		if( ! checkDdTm ( "DD" , edt_MKTACT_ENFORCE_DD   , "시장조치시행" , false)  ) return false; 

		if( cmb_FISCYY_CHG_RSN_CD.BindColVal == "" ) {
			alert("[변경사유]를  선택해주세요"); 	cmb_FISCYY_CHG_RSN_CD.focus(); return false;
		}		

		if( ! checkMaxLength( txa_REMK , 2000 , "기타" ) ) return false;

		return true;
	}
	
	function fn_save_trs() {
	
		if(trsIdx=='1'){
			vScrenTpCD = SCREN_PROCS_TP_CD_02;
		}else if(trsIdx=='2'){
			vScrenTpCD = SCREN_PROCS_TP_CD_03;
		}else if(trsIdx=='3'){
			vScrenTpCD = SCREN_PROCS_TP_CD_04;
		}

		//시장조치시행일가 변경일자가 다름.
		//dts_Mst.NameString(dts_Mst.RowPosition, "CHG_DD") = dts_Mst.NameString(dts_Mst.RowPosition, "MKTACT_ENFORCE_DD");

		for (i = 1;  i  <= dts_DtlAf.CountRow; i++) {
			if( dts_DtlAf.NameString(i ,  "BAS_MMDD") == "" ) {
				dts_DtlAf.DeleteRow(  i  );
				i--; // 삭제한 경우는 해당하는 위치에서 한번더 검색하게 함.
			} 
		}

		//매매거래정지 사유는 매번 업무처리 번호를 세팅함
		//사유별 추가,삭제가 있을수 있기때문
		for (var i = 1; i <= dts_DtlBf.CountRow; i++) { 
			dts_DtlBf.NameString(i, "BZ_PROCS_NO") = fr_bz_procs_no 
			dts_DtlBf.NameString(i, "BYBZPROCS_SEQ") = eval(i + 0 );
			dts_DtlBf.NameString(i, "ISUR_CD") = Isur_cd 
			dts_DtlBf.NameString(i, "CHG_BFAF_TP_CD") = "1"; // 변경전후구분코드 , 1:변경전 , 2:변경후
		};

		for (var i = 1; i <= dts_DtlAf.CountRow; i++) { 
			dts_DtlAf.NameString(i, "BZ_PROCS_NO") = fr_bz_procs_no 
			dts_DtlAf.NameString(i, "BYBZPROCS_SEQ") = eval( i + 12  );
			dts_DtlAf.NameString(i, "ISUR_CD") = Isur_cd 
			dts_DtlAf.NameString(i, "CHG_BFAF_TP_CD") = "2"; // 변경전후구분코드 , 1:변경전 , 2:변경후
		};
//alert(dts_DtlBf.Text );
//alert(dts_DtlAf.Text );
		trs.Action 	     =fn_encodeNSession( "/fiscalYearChange.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+vScrenTpCD+"&method=saveFiscalYearChange" );
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_DtlAf, I:dtsParm3= dts_DtlBf)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=3" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_232 + 
								",DIV_IDX[0]=" + DIV_IDX_FSC_MST+
								",DIV_IDX[1]=" + DIV_IDX_DTL_DIST_AF+
								",DIV_IDX[2]=" + DIV_IDX_DTL_DIST_BF;
								
		trs.Post();
		
	}
	
	function fn_save() {
		
		if (fn_CheckForm()) {
			if (! fn_isProcess('I') )  return;
			
			if (! fn_mst_check( dts_Mst_Check , "2" ) )  return;
			
			fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );

			if (fr_bz_procs_no.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {

				trsIdx = TRS_IDX_INSERT;

				dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO") = fr_bz_procs_no;
				dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = Isur_cd;
				dts_Mst.NameString(dts_Mst.RowPosition, "FISCYY_DISTR_BASDD_TP_CD") = "2"; // 1:결산기 , 2:수입분배기준일

				fn_save_trs();
			}
		}
	}
	
   function fn_update() {
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE;
			
			if (dts_Mst.IsUpdated || dts_DtlAf.IsUpdated) {
				if (! fn_isProcess('U') )  return;
				fn_save_trs();
			} else {
				fn_alertNoUpdate();
			}
		}	
	}

	function fn_delete() {
		if (! fn_isProcess('D') )  return;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE;
		fn_save_trs();
	}
	
	function fn_dscl() {
	
		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2,param_dts3) {
			
			arr[0] = "68212C";
			arr[1] = fr_bz_procs_no;
			arr[2] = Isur_cd;
			arr[3] = '1';

			//CopyDataSet( dts_Isu , param_dts_isu);
			CopyDataSet( dts_Mst , param_dts_mst);
			CopyDataSet( dts_DtlBf , param_dts2);
			CopyDataSet( dts_DtlAf , param_dts3);
			for (var i = 1; i <= param_dts3.countRow; i++) {
				if ( (param_dts3.NameString(i, "BAS_MM") == "") && (param_dts3.NameString(i, "BAS_DD") == "") ) {
					param_dts3.DeleteRow(i);
					i--;
				}
			}
			
			return arr.length;
		}
		
		fn_SetPar = function(arr) { }
	
		var wth = 730 + 5;
		var hgt = 785 + 30;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}
	

	function fn_drft() {
		var OldGet = fn_GetPar;
		
		fn_GetPar = function(arr) {
			arr[0] = fr_bz_procs_no;
			return arr.length;
		}
		
		fn_PopFindDraft();
		fn_GetPar = OldGet;
	}

	function fn_makt() { }
]]></script>

<events><event for="trs" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F');
]]></event>

<event for="trs" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S');
	
	if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
		frame.CloseFrame();
	} else {
		fn_search();
	}	
]]></event>

<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[

	if (fr_bz_procs_no == "") {	dts_Mst.AddRow(); 	}
			
	// 신규처리에 의한 조회인지,  수정에 의한 조회인지를 구별
	if (fr_bz_procs_no == "") {
		buttonSet.setInsertStatus();
	} else {
		setButtonSetWithDate( edt_MKTACT_ENFORCE_DD , false );
	}
	
	//alert(" dts_TrdSsp OnLoadCompleted \n" + dts_TrdSsp.Text  + "\n\n" + fn_logDSet(dts_TrdSsp) ); 
]]></event>
<event for="dts_DtlBf" eventname="OnLoadCompleted(rowcount)"><![CDATA[
//	alert(dts_DtlBf.Text);
]]></event>
<event for="dts_DtlAf" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	// 변경후는 항상 12개 row를 생성해줌
	for(var i=dts_DtlAf.CountRow; i < 13; i ++ ) {
		dts_DtlAf.AddRow(); 	
	}
]]></event>

<event for="img_MKTACT_ENFORCE_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_MKTACT_ENFORCE_DD);
]]></event>

<event for="img_CHG_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_CHG_DD);
]]></event>
 <event for="grd_DIST_PAY_AF" eventname="OnExit(row, colid, olddata)"><![CDATA[
//alert('MxGrid_1.OnExit('+row+','+ colid+','+ olddata+')');
	if( colid == "BAS_MM" && eval(dts_DtlAf.NameString(row , "BAS_MM") ) > 12 ) {
		alert("입력월을 확인하세요.");
		dts_DtlAf.NameString(row , "BAS_MM")  = "";
	} else if( colid == "BAS_DD" && eval(dts_DtlAf.NameString(row , "BAS_DD") ) > 31 ) {
		alert("입력일을 확인하세요.");
		dts_DtlAf.NameString(row , "BAS_DD")  = "";
	}
]]></event>
<event for="img_ChgStatDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ChgStatDd);
]]></event>
<event for="img_ChgEndDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ChgEndDd);
]]></event>
<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>


<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar; // Provider화면에서 fn_GetPar명칭으로 선언된 함수를 획득
	var arrPar = new Array;
	
	if (fnc != undefined) {
		fnc(arrPar); // Provider화면의 callback함수를 호출하여 필요한 인수를 넘겨받는다.
		Isur_cd 		        = (arrPar.length >= 1 ? arrPar[0] : "");	// 발행기관코드
		Isur_nm 		        = (arrPar.length >= 2 ? arrPar[1] : "");	// 발행기관명
		Secugrp_id 		    = (arrPar.length >= 3 ? arrPar[2] : "");	// 증권그룹ID
		Mkt_id	    	        = (arrPar.length >= 4 ? arrPar[3] : "");	// 시장구분코드
		fr_bz_procs_no 	= (arrPar.length >= 5 ? arrPar[4] : "");	// 업무처리번호(수정시만 유효)
		haltTpCd		        = (arrPar.length >= 6 ? arrPar[5] : "");	 // 결산기분배기준일구분코드 1 : 결산기, 2 : 분배기준일
	}
	
	//alert( "Isur_cd =  " +Isur_cd + "\n"  + " Isur_nm = " + Isur_nm + "\n" + "  Secugrp_id = " + Secugrp_id + "\n" + 
	//		 "Mkt_id =  " +Mkt_id + "\n" + " fr_bz_procs_no = " + fr_bz_procs_no+ "\n"  );
			
	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성
	buttonSet.setDrftInfo( btn_Drft, fn_drft );			// 기안

	if (fr_bz_procs_no != "")  { // Provider화면 에서 넘겨받은 업무처리번호가 ""가 아니라면 신규작성으로 간주한다.
		fn_search(); 
	} else {
		fn_new_onload();    // 신규작성시 호출
	}
	
	dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = Isur_cd;			
	dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_NM") = Isur_nm;			
	
	PanelToGroupBox(panel_3);
	
]]></event>
<event for="grd_DIST_PAY_AF" eventname="CanColumnPosChange(row, colid)"><![CDATA[
return true;
]]></event></events>
</gform>

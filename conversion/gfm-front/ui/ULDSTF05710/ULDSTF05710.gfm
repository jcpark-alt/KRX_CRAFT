					 ,{uid: "TARSTK_ISU_NM"	,			unm: dts_Report.NameString(1, "TARSTK_ISU_NM")}
					 ,{uid: "SUBSRGHT_EP_CONTN",	unm: dts_Report.NameString(1, "SUBSRGHT_EP_CONTN")}

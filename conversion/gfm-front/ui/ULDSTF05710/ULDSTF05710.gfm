	var fr_SecuGrpId;
	var vSPOT_ISU_TRD_MKT_TP_CD;
	var VListBzTpCd = LIST_BZ_TP_CD_121; //신주인수권증권 신주상장

	function fn_GetParIsuCd(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = fr_SecuGrpId;
		arrPar[1] = vIsurCd; 	// 코드값을 포함할 컨트롤
		arrPar[2] = "S";
		//alert('fr_SecuGrpId'+fr_SecuGrpId);
		return arrPar, length;
	} 
	
	function fn_SetParIsuCd(arrPar) {
		if ( arrPar[0].ISU_CD != "" ) {
			txb_ISU_CD.value = arrPar[0].ISU_CD;
			txb_ISU_KOR_NM.value = arrPar[0].ISU_KOR_NM;
			txb_ISU_KOR_ABBRV.value = arrPar[0].ISU_KOR_ABBRV;
			txb_ISU_ENG_NM.value = arrPar[0].ISU_ENG_NM;
			txb_ISU_ENG_ABBRV.value = arrPar[0].ISU_ENG_ABBRV;
			txb_ISU_SRT_CD.value = arrPar[0].ISU_SRT_CD;
			edt_ISU_RND.text = arrPar[0].ISU_RND;
			edt_ISU_DD.text = arrPar[0].ISU_DD;
			txb_TARSTK_ISU_NM.value = arrPar[0].TARSTK_ISU_NM;
			dts_Isu.NameString(1, "TARSTK_ISU_CD") = arrPar[0].TARSTK_ISU_CD;
		}

	}

	function fn_SetHeader() {
		dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=SW_LIST_LISTING_INOUT";
		dts_Isu.reset();
		dts_Isu.AddRow();
		//alert(dts_Isu.text+" dts_Isu.text");
	}
	
	function fn_initItem() {
		setObjectValue(cmb_LIST_METHD_TP_CD, LIST_METHD_TP_CD_1);
	}

	function fn_recv_read_sync(row) {
	
		dts_Isu.NameString(1, "BZ_PROCS_NO") = dts_Recv.NameString(row, "BZ_PROCS_NO");
		dts_Isu.NameString(1, "ACPT_NO") = dts_Recv.NameString(row,"ACPT_NO");
		//dts_Isu.NameString(1, "LIST_METHD_TP_CD") = LIST_METHD_TP_CD_1
		dts_Isu.NameString(1, "ISU_DD") = dts_Recv.NameString(row, "ISU_DD");
		dts_Isu.NameString(1, "LIST_SHRS") = dts_Recv.NameString(row, "LIST_SHRS");
		dts_Isu.NameString(1, "NPARVALSTK_YN") = dts_Recv.NameString(row, "NPARVALSTK_YN");
		dts_Isu.NameString(1, "EXER_PRC") = dts_Recv.NameString(row, "EXER_PRC");
		dts_Isu.NameString(1, "ISU_SHRS") = dts_Recv.NameString(row, "ISU_SHRS");
		dts_Isu.NameString(1, "TOT_ISU_PRC") = dts_Recv.NameString(row, "TOT_ISU_PRC");
		dts_Isu.NameString(1, "EXER_STRT_DD") = dts_Recv.NameString(row, "EXER_STRT_DD");
		dts_Isu.NameString(1, "EXER_END_DD") = dts_Recv.NameString(row, "EXER_END_DD");
		dts_Isu.NameString(1, "REMK") = dts_Recv.NameString(row, "REMK");
		
		if (vSPOT_ISU_TRD_MKT_TP_CD == "2") {
			dts_Isu.NameString(1, "LIST_DD") = dts_Recv.NameString(row, "LIST_DD");
		}
		
		if (dts_Isu.NameValue(1, "NPARVALSTK_YN") == 'Y') {
			chk_NPARVALSTK_YN.checked=true;
		}else{
			chk_NPARVALSTK_YN.checked=false;
		}
		
		fn_initItem() ;
	}

	function fn_read_sync() {
		var url = "/Listing.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchIsuIssChgList&DIV_IDX="+DIV_IDX_NEW_ISS_SWR_HIST + "&TRS_IDX="+TRS_IDX_NEWSEL + "&BZ_PROCS_NO=" + vBzProcsNo;
		dts_Isu.DataID = encodeURI(url);
		dts_Isu.reset();
		
		if (dts_Isu.NameValue(1, "NPARVALSTK_YN") == 'Y') {
			chk_NPARVALSTK_YN.checked=true;
		}		
		dts_Eng_Isu.DataID = encodeURI(url);
		dts_Eng_Isu.reset();
	}

	function fn_CheckForm() {
		var vCurDate = cGetToday("yyyymmdd");

		if (getObjectValue(txb_ISU_CD) == "") {
			alert("[종목]을 선택하세요.");img_ISU_CD.focus();return false;
		}
		if (TR_JOB == 'I') {
			if ( fn_checkDoubleInput(dts_DoubleChk, getObjectValue(txb_ISU_CD)) )  return false;
		}		
		if (getObjectValue(txb_ISU_SRT_CD) == "") {
			alert("[종목단축코드]항목값이  없습니다.");//txb_ISU_SRT_CD.focus();return false;
		}
		if (getObjectValue(txb_ISU_KOR_NM) == "") {
			alert("[한글종목명]을 입력하세요.");txb_ISU_KOR_NM.focus();return false;
		}
		if (getObjectValue(txb_ISU_KOR_ABBRV) == "") {
			alert("[한글종목약명]을 입력하세요.");txb_ISU_KOR_ABBRV.focus();return false;
		}
		if (getObjectValue(txb_ISU_ENG_NM) == "") {
			alert("[영문종목명]을 입력하세요.");txb_ISU_ENG_NM.focus();return false;
		}
		if (getObjectValue(txb_ISU_ENG_ABBRV) == "") {
			alert("[영문종목약명]을 입력하세요.");txb_ISU_ENG_ABBRV.focus();return false;
		}
		if (getObjectValue(edt_ISU_DD) == "") {
			alert("[발행일]을 입력하세요.");edt_ISU_DD.focus();return false;
		}
		if (getObjectValue(edt_LIST_DD) == "") {
			alert("[상장일]을 입력하세요.");edt_LIST_DD.focus();return false;
		}
		if (vCurDate >= getObjectValue(edt_LIST_DD)) {
			alert("[상장일]을 현재일이후로 입력하세요.");edt_LIST_DD.focus();return false;
		}
		
		/*if (getObjectValue(edt_EXER_STRT_DD) == "") {
			alert("[행사시작일]을 입력하세요.");edt_EXER_STRT_DD.focus();return false;
		}*/
		/* 2009.09.24 행사 시작일을 이전도 입력할 수 있게 
			
		if (vCurDate >= getObjectValue(edt_EXER_STRT_DD)) {
			alert("[행사시작일]을 현재일이후로 입력하세요.");edt_EXER_STRT_DD.focus();return false;
		}
		*/
		
		
		if (getObjectValue(edt_EXER_END_DD) == "") {
			alert("[행사종료일]을 입력하세요.");edt_EXER_END_DD.focus();return false;
		}
		if (vCurDate >= getObjectValue(edt_EXER_END_DD)) {
			alert("[행사종료일]을 현재일이후로 입력하세요.");edt_EXER_END_DD.focus();return false;
		}
		if (parseInt(edt_EXER_STRT_DD.Text, 10) >= parseInt(edt_EXER_END_DD.Text, 10) ) {
			alert("[행사시작일]은 [행사종료일]보다 작아야 합니다. 다시 입력해주세요");return false;
		}		
		if (getObjectValue(cmb_LIST_METHD_TP_CD) == "") {
			alert("[상장방식]을 선택하세요.");cmb_LIST_METHD_TP_CD.focus();return false;
		}

		if (getObjectValue(edt_LIST_SHRS) == "") {
			alert("[상장증권수량]을 입력하세요.");edt_LIST_SHRS.focus();return false;
		}
		//if (! fn_checkNumber(edt_LIST_SHRS, '상장증권수량')) return false;

		if (getObjectValue(edt_ISU_SHRS) == "") {
			alert("[발행주식수]을 입력하세요.");edt_ISU_SHRS.focus();return false;
		}
		//if (! fn_checkNumber(edt_ISU_SHRS, '발행주식수')) return false;
		
		if (dts_Isu.NameValue(1, "NPARVALSTK_YN") != 'Y' && getObjectValue(edt_EXER_PRC) == "") {
			alert("[행사가격]을 입력하세요.");edt_EXER_PRC.focus();return false;
		}
		//if (! fn_checkNumber(edt_EXER_PRC, '행사가격')) return false;

		if (getObjectValue(edt_TOT_ISU_PRC) == "") {
			alert("[발행가액총액]을 입력하세요.");edt_TOT_ISU_PRC.focus();return false;
		}
		//if (! fn_checkNumber(edt_TOT_ISU_PRC, '발행가액총액')) return false;
		
		if (getObjectValue(txb_ISU_RSN_CONTN) == "") {
			alert("[발행사유]를 입력하세요.");txb_ISU_RSN_CONTN.focus();return false;
		}
		if (getObjectValue(txb_SUBSRGHT_CONTN) == "") {
			alert("[신주인수권의 내용]를 입력하세요.");txb_SUBSRGHT_CONTN.focus();return false;
		}
		if (getObjectValue(txb_SUBSRGHT_EXERTM_PAYMETHD_CONTN) == "") {
			alert("[신주의 납입방법]를 입력하세요.");txb_SUBSRGHT_EXERTM_PAYMETHD_CONTN.focus();return false;
		}
		
		/* 2009-04-24  신주인수권증권 신주상장 중복입력체크 */
		///*
		if (! fn_check_bz_doubleinput(	dts_BZ_CHECK, 
														getObjectValue(txb_ISU_CD),
														getObjectValue(edt_LIST_DD),
														vBzProcsNo,
														LIST_BZ_TP_CD_121)) {
			return false;
		}
		return true;
	}

	function fn_checkNumber(obj, str) {
		if (getObjectValue(obj) <= 100) {
			alert("["+str+"]를 '"+getObjectValue(obj)+"'으로 입력하셨습니다. 확인 후 재입력바랍니다.");obj.focus();return false;
		}
		return true;
	}


	function fn_save() {
		TR_JOB = 'I';
		if (fn_CheckForm()) {
			
			if (! fn_isProcess(TR_JOB) )  return ;

			if (vAcptNo == "") {
				vBzProcsNo = fn_getNewBzProcNo( dts_BzProcsNo );
			}
			
			if (vBzProcsNo.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {
				//dts_Isu.UserStatus(1) = TB_JOB_INSERT;
				dts_Isu.NameValue(1, "BZ_PROCS_NO") = vBzProcsNo;
				fn_trs(TRS_IDX_INSERT)
			}
		}
	}
	
	function fn_update() {
		TR_JOB = 'U';
		if (fn_CheckForm()) {
			if (! fn_isProcess(TR_JOB) )  return ;

			fn_trs(TRS_IDX_UPDATE);
		}
	}

	function fn_delete() {
		TR_JOB = 'D';
		if (! fn_isProcess(TR_JOB) )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		fn_trs(TRS_IDX_DELETE);
	}
	
	function fn_trs(trsIdx) {
		
		if(TR_JOB=='I'){
			vScrenTpCD = SCREN_PROCS_TP_CD_02;
		}else if(TR_JOB=='U'){
			vScrenTpCD = SCREN_PROCS_TP_CD_03;
		}else if(TR_JOB=='D'){
			vScrenTpCD = SCREN_PROCS_TP_CD_04;
		}

		//alert("[fn_trs vBzProcsNo] ."+vBzProcsNo);
		//dts_Isu.NameValue(1, "JOB_TYPE") = trsIdx;
		dts_Isu.NameString(1, "ISUR_CD") = vIsurCd;
		dts_Isu.NameString(1, "LIST_BZ_TP_CD") = VListBzTpCd;
		dts_Isu.NameString(1, "NPARVALSTK_YN") =  (fn_getCheckboxData(chk_NPARVALSTK_YN) == "Y" ? "Y" :'') ;

		trs_Save.Action=fn_encodeNSession("/Listing.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+vScrenTpCD+"&method=saveIsuIssChgList");
		trs_Save.KeyName="toinb_dataid4";
		trs_Save.KeyValue="JSP(I:pInput=dts_Isu)";
		trs_Save.Parameters  = "TRS_IDX=" + trsIdx + 
								",ACPT_NO="+ vAcptNo +
								",BZ_PROCS_NO="+ vBzProcsNo +
								",COUNT=1" +
								",LIST_BZ_TP_CD=" + VListBzTpCd + 
								",DIV_IDX[0]=" + DIV_IDX_NEW_ISS_SWR_HIST
		trs_Save.Post();
	}
	
	function fn_RecvtIsuDel() {
		if (vAcptNo == "") {
			alert('발행예정내역에서 대상종목을 선택하세요');  return ;
		}
		
		fn_delete();
	}

	function fn_dscl() {
	
		if (getObjectValue(txb_ISU_CD) == "") {
			alert("[종목]을 선택하세요.");img_ISU_CD.focus();return false;
		}

		//if (  dts_Isu.IsUpdated  ) {
		//	alert(getMessageParam("MSG-0022", ""));
		//	return ;
		//}

		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") { // 유가경우
			fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2,param_dts3) {
				arr[0] = "68912";
				arr[1] = vBzProcsNo ;
				arr[2] = vIsurCd;
				//CopyDataSet( dts_Delistdetail , param_dts_isu) ;
				CopyDataSet( dts_Isu , param_dts_mst) ;
				return arr.length;
			}
		} else if (vSPOT_ISU_TRD_MKT_TP_CD == "2") { // 코스닥인경우
			fn_GetPar = function(arr, param_dts_isu, param_dts_mst, param_dts2, param_dts3, param_dts4, param_dts_isu_eng, param_dts_mst_eng, param_dts_dtl_eng, param_dts_rel_eng, param_dts_dtl_all_eng) {
				arr[0] = "70920";
				arr[1] = vBzProcsNo ;
				arr[2] = vIsurCd;
				arr[3] = vSPOT_ISU_TRD_MKT_TP_CD;
				
				CopyDataSet( dts_Isu , param_dts_mst) ;
				CopyDataSet( dts_Eng_Isu , param_dts_mst_eng) ;
				return arr.length;
			}		
		}

		fn_SetPar = function(arr) { }
		var wth = 750;
		var hgt = 825;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}

	function fn_drft() {
		var OldGet = fn_GetPar;
		
		fn_GetPar = function(arr) {
			arr[0] = vBzProcsNo ;
			return arr.length;
		}
		
		fn_PopFindDraft();
		fn_GetPar = OldGet;
	}
	
	function fn_parentRefresh() {
		var fr_fn_list_sync = frame.Provider("../").fn_all_list_sync;
		fr_fn_list_sync();
	}

	function fn_setBtnRecvIsuDel() {
		if (vOpenTyp == "R" && vBzProcsNo != "") {
			btn_RecvIsuDel.src = "../img/btn_RcvdocDel.gif";
			btn_RecvIsuDel.disabled = false;
		} else {
			btn_RecvIsuDel.src = "../img/btn_RcvdocDel_d.gif";
			btn_RecvIsuDel.disabled = true;
		}
	}

/* =============================== */
/*       인쇄버튼 추가 2010.01.21        */
/* =============================== */

function fn_report_read_sync(vBzProcsNo, reportCd) {
		var url = "/Listing.do?method=searchIssReport" + 
			"&DIV_IDX="+reportCd + "&BZ_PROCS_NO=" + vBzProcsNo ;
		dts_Report.DataID = encodeURI(url);
		dts_Report.Reset();
}
	
function fn_print(){
	dts_Print.SetDataHeader("TEST:STRING(80)"); //껍데기만 만들고 사용자필드를 사용함
	dts_Print.AddRow();

	fn_report_read_sync(vBzProcsNo, DIV_IDX_NEW_ISS_SWR_REPORT);
	
	//PDF 리포트 파일명
	var pdf_rptname = "RLDSTF00029";
	var userParam = [
				  {uid: "COM_NM",	 			unm: dts_Report.NameString(1, "COM_NM") }
				 ,{uid: "ISU_INFO",	 			unm: dts_Report.NameString(1, "ISU_CD") + " / " + dts_Report.NameString(1, "ISU_SRT_CD")} 
				 ,{uid: "ISU_KOR_NM",			unm: dts_Report.NameString(1, "ISU_KOR_NM")}
				 ,{uid: "ISU_KOR_ABBRV"	,		unm: dts_Report.NameString(1, "ISU_KOR_ABBRV")}
				 ,{uid: "ISU_ENG_NM",			unm: dts_Report.NameString(1, "ISU_ENG_NM")}
				 ,{uid: "ISU_ENG_ABBRV",		unm: dts_Report.NameString(1, "ISU_ENG_ABBRV")}
				 ,{uid: "ISU_RSN_CONTN",		unm: dts_Report.NameString(1, "ISU_RSN_CONTN")}
				 ,{uid: "TARSTK_ISU_NM"	,		unm: dts_Report.NameString(1, "TARSTK_ISU_NM")}
				 ,{uid: "SUBSRGHT_EP_CONTN",	unm: dts_Report.NameString(1, "SUBSRGHT_EP_CONTN")}
				 ,{uid: "LIST_SHRS"	,			unm: FormatNumberEx(dts_Report.NameString(1, "LIST_SHRS"))}
				 ,{uid: "EXER_PRC",				unm: FormatNumberEx(dts_Report.NameString(1, "EXER_PRC"))}  
				 ,{uid: "ISU_SHRS",				unm: FormatNumberEx(dts_Report.NameString(1, "ISU_SHRS"))} 
				 ,{uid: "TOT_ISU_PRC"	,		unm: FormatNumberEx(dts_Report.NameString(1, "TOT_ISU_PRC"))}
				 ,{uid: "EXER_STRT_DD"	,		unm: FormatDateEx(dts_Report.NameString(1, "EXER_STRT_DD"))}
				 ,{uid: "EXER_END_DD"	,		unm: FormatDateEx(dts_Report.NameString(1, "EXER_END_DD"))}
				 ,{uid: "COMMIT_DD"	,			unm: FormatDateEx(getObjectValue(edt_APPROV_DD))}
				 ,{uid: "ISU_DD"			,	unm: FormatDateEx(dts_Report.NameString(1, "ISU_DD"))}
				 ,{uid: "ISU_DD_INFO"	,		unm: dts_Report.NameString(1, "ISU_DD")+" / 제" + dts_Report.NameString(1, "ISU_RND") + "회"} 
				 ,{uid: "LIST_DD"	,			unm: FormatDateEx(dts_Report.NameString(1, "LIST_DD"))}
			];		
				 
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_05);
	
	//PDF Convert
	fn_open_report_pdf(pdf_rptname, userParam);
}


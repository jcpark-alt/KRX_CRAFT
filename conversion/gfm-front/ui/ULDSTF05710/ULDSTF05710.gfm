					 ,{uid: "EXER_PRC",						unm: dts_Report.NameString(1, "EXER_PRC")}  
                     ,{uid: "ISU_SHRS",						unm: dts_Report.NameString(1, "ISU_SHRS") } 
					 ,{uid: "TOT_ISU_PRC"	,				unm: dts_Report.NameString(1, "TOT_ISU_PRC")}
					 ,{uid: "EXER_STRT_DD"	,			unm: dts_Report.NameString(1, "EXER_STRT_DD")}
					 ,{uid: "EXER_END_DD"	,				unm: dts_Report.NameString(1, "EXER_END_DD")}
					 ,{uid: "COMMIT_DD"	,				unm: dts_Report.NameString(1, "COMMIT_DD")}
					 ,{uid: "ISU_DD"			,				unm: dts_Report.NameString(1, "ISU_DD")}
					 ,{uid: "ISU_DD_INFO"	,				unm: dts_Report.NameString(1, "ISU_DD")+" / 제" + dts_Report.NameString(1, "ISU_RND") + "회"} 
					 ,{uid: "LIST_DD"	,						unm: dts_Report.NameString(1, "LIST_DD")}
					 ];		
					 
		doLogSave(vScrenID, SCREN_PROCS_TP_CD_05);
		//Rexpert 미리보기 호출			
		fn_open_report(testDateSet, rex_rptname, userParam);

}

function fn_getCheckboxData(obj) {
	if (obj.checked) {
		return 'Y';
	} else {
		return 'N';
	}
}
]]></script>

<events><event for="img_ISU_CD" eventname="onclick"><![CDATA[
	if (vIsurCd == "") {
		alert("[회사]를 선택하세요.");	return;
	}

	fn_GetPar = fn_GetParIsuCd;
	fn_SetPar = fn_SetParIsuCd;
	fn_PopFindNewIsuOfIsur();
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
<event for="btn_RecvIsuDel" eventname="onclick"><![CDATA[
	fn_RecvtIsuDel();
]]></event>

<event for="dts_BZ_CHECK" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_BZ_CHECK);
]]></event>

<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>

<event for="dts_Isu" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (vOpenTyp == "N" || (vOpenTyp == "R" && vBzProcsNo== '')) {
		buttonSet.setInsertStatus();
	} else {
		setButtonSetWithDate( edt_LIST_DD, false ) ;
		setButtonSetWithDate2( dts_Isu.NameValue(1, "DISCLS_YN") ) ;
	}
	fn_setBtnRecvIsuDel();
]]></event>


<event for="trs_Save" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
]]></event>

<event for="trs_Save" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	fn_parentRefresh(); // 목록 다시 조회
	if (TR_JOB == 'D') {
		frame.CloseFrame();
	} else {
		fn_read_sync();
		buttonSet.setUpdateStatus();
	
		//코스닥일때 보임
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") {
				showObj(btn_Print, false);
		}
		else{
			if (vOpenTyp == "R" && vBzProcsNo == ""){
				showObj(btn_Print, false);
			}
			else{
				showObj(btn_Print, true);
			}
		}
	}
]]></event>

<event for="img_LIST_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_LIST_DD);
]]></event>
<event for="img_ISU_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ISU_DD);
]]></event>

<event for="img_EXER_END_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_EXER_END_DD);
]]></event>
<event for="img_EXER_STRT_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_EXER_STRT_DD);
]]></event>

<event for="btn_Print" eventname="onclick"><![CDATA[
	fn_print();
]]></event>
<event for="gform" eventname="onload"><![CDATA[
	//var parentWin = fn_GetProvider();
	var parentWin = frame.Provider("../");
	//alert('[parentWin]'+parentWin);
	dts_Recv = parentWin.dts_Recv;
	vBzProcsNo = parentWin.clickBzProcsNo;
	vAcptNo = parentWin.vAcptNo;
	vIsurCd = getObjectValue(parentWin.txb_ISUR_CD);
	fr_SecuGrpId = parentWin.pSecuGrpId;
	vSPOT_ISU_TRD_MKT_TP_CD = parentWin.vSPOT_ISU_TRD_MKT_TP_CD;
	edt_APPROV_DD.text = cGetToday("yyyymmdd");		
	
	vOpenTyp = parentWin.vOpenTyp;
	
	PanelToGroupBox(panel_Item);

	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성s
	//buttonSet.setDrftInfo( btn_Drft, fn_drft );			// 기안

	if (vOpenTyp == "R") {   //접수
		fn_SetHeader();
		fn_recv_read_sync(dts_Recv.RowPosition);
		buttonSet.setInsertStatus();
	} else if (vOpenTyp == "H") {    //이력
		fn_read_sync();
	} else if (vOpenTyp == "N") {   //신규
		fn_SetHeader();
		fn_initItem();
		buttonSet.setInsertStatus();
		fn_setBtnRecvIsuDel();
	}
	
	//코스닥일때 보임
	if (vSPOT_ISU_TRD_MKT_TP_CD == "1") {
			showObj(btn_Print, false);
			showObj(label_26, false);
			showObj(edt_APPROV_DD, false);
			showObj(img_APPROV_DD, false);
	}
	else{
		if (vOpenTyp == "R" && vBzProcsNo == ""){
			showObj(btn_Print, false);
			showObj(label_26, false);
			showObj(edt_APPROV_DD, false);
			showObj(img_APPROV_DD, false);
		}
		else{
			showObj(btn_Print, true);
			showObj(label_26, true);
			showObj(edt_APPROV_DD, true);
			showObj(img_APPROV_DD, true);
		}
	}
]]></event>
<event for="img_APPROV_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_APPROV_DD);
]]></event></events>
</gform>

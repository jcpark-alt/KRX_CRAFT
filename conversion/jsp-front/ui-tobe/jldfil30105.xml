///////// 1. 변수 및 선언 영역 /////////
scwin.screenId = "jldfil30105";
scwin.tbh_defaultIndex = 1;
scwin.tbh_labels = ["연부과금조회","영수증 발급"];

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {void}
 * @hidden N
 */
scwin.onpageload = function () {
    try {
        scwin.init_tab();
    } catch (e) {
        $c.exception.handleError(e, { context: 'jldfil30105.onpageload' });
    }
};

// 탭 선택 = 진입 파라미터(tab) > 기본 탭. onpageload 는 엔진 초기화 뒤라 이 시점의 대입이 산다.

/**
 * @method
 * @name init_tab
 * @description 초기화 — tab
 * @returns {void}
 * @hidden N
 */
scwin.init_tab = function () {
    let idx = scwin.tbh_defaultIndex;
    const pd = $c.data.getParameter();
    if (pd && pd.tab !== undefined) { idx = Number(pd.tab); }
    let tc = $c.util.getComponent('tbh_tabs');
    if (!tc || !tc.getSelectedTabIndex) { return; }
    if (tc.getSelectedTabIndex() !== idx) { tc.setSelectedTabIndex(idx); }
    scwin.tbh_setLeaf(idx);
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name tbh_tabs_onchange
 * @description 탭 전환 시 breadcrumb 리프를 선택 탭 라벨로 갱신한다. onchange 는 tabControl 이 제공하는 사용자 이벤트다.
 * @returns {void}
 * @hidden N
 */
scwin.tbh_tabs_onchange = function () {
    try {
        let tc = $c.util.getComponent('tbh_tabs');
        if (tc && tc.getSelectedTabIndex) { scwin.tbh_setLeaf(tc.getSelectedTabIndex()); }
    } catch (ex) {
        $c.exception.handleError(ex, { context : "jldfil30105.tbh_tabs_onchange" });
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name tbh_setLeaf
 * @description tbh set Leaf 처리
 * @param {Number} i i
 * @returns {void}
 * @hidden N
 */
scwin.tbh_setLeaf = function (i) {
    const a = $c.util.getComponent('tbh_crumb_leaf');
    if (a && a.setValue) { a.setValue(scwin.tbh_labels[i] || ''); }
};
]]></script>

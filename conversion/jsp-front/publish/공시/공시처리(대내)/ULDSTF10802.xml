};
scwin.txb_DISCLS_DDTM3_ondblclick = function() {
    scwin.fn_openDiscls('3');
};
scwin.gform_onload = function() {
    scwin.fn_read();
    setTimeout("fn_init()", 1000); //데이터 로딩시간이 있어 1초후 화면초기화 작업한다.

};

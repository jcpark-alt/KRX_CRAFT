scwin.gDepCd = js_dep_cd;
//사이버정보분석팀일경우 팀코드가 시장마다 다르기 때문에 상위부서코드로 넣어준다. 20240510
if (scwin.gDepCd.substring(0, 2) == '5B') {
    scwin.gDepCd = '5B10';
}
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.link_num = '';
scwin.acpt_num = '';
scwin.key_row = frame.opener.scwin.key_row;

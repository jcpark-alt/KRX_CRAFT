};
scwin.fn_init = function() {
    //(유가/코스닥)공시총괄팀 당번아이디로 수정할수 있게 세팅.
    if (js_dep_cd == '2600' || js_dep_cd == '3400') {
        scwin.gDepCd = $c.stf.getObjectValue(txb_DEP_CD2);
    }
    $c.stf.showObj(txb_NOTI_SEQ, false);
    $c.stf.showObj(txb_ISUR_CD, false);
    $c.stf.showObj(txb_EMP_NO, false);
    for (var i = 1; i < 4; i++) {
        $c.stf.showObj(eval("txb_ACPT_NO" + i), false);
        $c.stf.showObj(eval("txb_DEP_CD" + i), false);
        var dep_cd = $c.stf.getObjectValue(eval("txb_DEP_CD" + i));
        //alert("gDepCd : " + gDepCd + " : dep_cd : " + dep_cd);
        if (scwin.gDepCd == dep_cd) {
            eval("txb_REMK" + i).setReadOnly("");
        } else {
            eval("txb_REMK" + i).style.backgroundColor = '#b9d4f7';
        }

        //시장감시부일때만 '공시시각','반송사유' 를 보여주고 다른팀일때 보여주지 않는다.
        if (scwin.gDepCd != '5B10') {
            if (i == 1) {
                $c.stf.showObj(label_13, false);
                $c.stf.showObj(label_18, false);
                $c.stf.showObj(label_25, false);
                panel_1.style.height = 457;
                panel_2.style.height = 145;
                btn_Save.style.top = 357;
                btn_Cancel.style.top = 357;
                label_31.style.top = 357;
                label_21.style.top = 378;
                label_22.style.top = 399;
                label_23.style.top = 420;
                label_24.style.top = 441;
            }
            $c.stf.showObj(eval("txb_DISCLS_DDTM" + i), false);
            $c.stf.showObj(eval("txb_RET_RSN" + i), false);
        }
    }
    $c.cm.PanelToGroupBox(panel_1);
};
scwin.fn_read = function() {
    var url = "/OnlineNotice.do?method=readDetailOnlineNoticeMaster";
    url += "&NOTI_SEQ=" + frame.opener.dts_Grid.getCellData(scwin.key_row, "NOTI_SEQ");
    url += "&ISUR_CD=" + frame.opener.dts_Grid.getCellData(scwin.key_row, "ISUR_CD");
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Master.DataID = encodeURI(url);
    dts_Master.Reset();
    url = "/OnlineNotice.do?method=readDetailOnlineNoticeSub";
    url += "&NOTI_SEQ=" + frame.opener.dts_Grid.getCellData(scwin.key_row, "NOTI_SEQ");
    url += "&ISUR_CD=" + frame.opener.dts_Grid.getCellData(scwin.key_row, "ISUR_CD");
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Sub.DataID = encodeURI(url);
    dts_Sub.Reset();
};
scwin.fn_Save = function() {
    $c.stf.setObjectValue(txb_EMP_NO, scwin.gEmpNo);
    var res = window.confirm("[저장]하시겠습니까?");
    if (res) {
        gLastJob = "저장";
        var url = "/OnlineNotice.do?method=saveDetailOnlineNotice" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
        //alert(dts_MASTER.Text);
        trs_Sub.Action = url;
        trs_Sub.KeyName = "toinb_dataid4";
        trs_Sub.KeyValue = "JSP(I:pInputMaster=dts_Sub)";
        trs_Sub.post();
    }
};
scwin.fn_openDiscls = async function(num) {
    fn_SetPar = fn_setDiscls;
    scwin.link_num = num;
    if (scwin.gDepCd != '5B10' || $c.stf.getObjectValue(eval("txb_DEP_CD" + num)) == '') {
        //alert("시장감시부에서만 공시연결할 수 있습니다.");
        return;
    }
    if ($c.stf.getObjectValue(eval("txb_ACPT_STAT" + scwin.link_num)) == '접수' || $c.stf.getObjectValue(eval("txb_ACPT_STAT" + scwin.link_num)) == '반송거부') {
        await $c.frame.CreateDialogFrame("wndDiscls|ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD), "/dsclmgt/ULDSTF30007.gfm", "공시선택", 100, 100, 10, 20, "window");
    } else {
        $c.win.alert("[접수],[반송거부]상태에서 공시연결 할 수 있습니다.");
    }
};
scwin.fn_setDiscls = function(arrPar) {
    //공시팝업에서 공시선택시 값 셋팅.
    //alert("arrPar[0] : " + arrPar[0] + " : arrPar[1] : " + arrPar[1] + " :arrPar[2] : " + arrPar[2]);
    var acpt_no = arrPar[0];
    var discls_title = arrPar[1];
    var discls_date = arrPar[2];
    discls_date = discls_date.substring(0, 4) + "-" + discls_date.substring(4, 6) + "-" + discls_date.substring(6, 8) + " " + discls_date.substring(8, 10) + ":" + discls_date.substring(10, 12) + "(" + discls_title + ")";
    $c.stf.setObjectValue(eval("txb_ACPT_NO" + scwin.link_num), acpt_no);
    $c.stf.setObjectValue(eval("txb_DISCLS_DDTM" + scwin.link_num), discls_date);
};
scwin.fn_onlineAcpt = async function(num) {
    scwin.acpt_num = num;
    var wrtr_dep_cd = $c.stf.getObjectValue(eval("txb_DEP_CD" + num));
    if ($c.stf.getObjectValue(eval("txb_ACPT_STAT" + scwin.acpt_num)) == '미접수') {
        /* 기존 상세뷰(30412)에서 호출했으나 장과장님 요청으로  리스트(30410)부분에서 호출변경 여기서 호출은 반송외에는 막는다.
        if(gDepCd == wrtr_dep_cd) {
        	frame.CreateDialogFrame("ONLINE", "/dsclinfo/ULDSTF30413.gfm", "온라인통보 접수", 100, 100, 550, 280, "window");
        } else {
        	alert("담당부서만 접수할 수 있습니다.");
        }
        */
    } else if ($c.stf.getObjectValue(eval("txb_ACPT_STAT" + scwin.acpt_num)) == '반송' && scwin.gDepCd == '5B10') {
        //반송승인페이지 작업.
        await $c.frame.CreateDialogFrame("ONLINE", "/dsclproc/ULDSTF10804.gfm", "온라인통보 반송", 100, 100, 505, 280, "window");
    }
};
scwin.trs_Sub_OnFail = function() {
    $c.stf.alert_error(trs_Sub);
};
scwin.trs_Sub_OnSuccess = async function() {
    var msg = $c.stf.getMessageParam("MSG-A001", gLastJob);
    $c.win.alert(msg);
    var fr_fn_Search = $c.frame.path("../").fn_Search;
    fr_fn_Search();
    await $c.frame.CloseFrame();
};
scwin.btn_Save_onclick = function() {
    scwin.fn_Save();
};
scwin.btn_Cancel_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.txb_ACPT_STAT1_ondblclick = function() {

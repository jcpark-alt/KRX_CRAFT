스크립트 수작업 유의사항
*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.vScrenID = "ULDSTF30703.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.initPage = function() {
    scwin.fn_readReissuePassword();
    var vAPPL_RSLT_CD = $c.stf.getObjectValue(txb_APPL_RSLT_CD);
    if (vAPPL_RSLT_CD != "R") {
        $c.stf.showObj(btn_Approv, false); // 승인버튼 숨기기.
        $c.stf.showObj(btn_REJECT, false); // 승인버튼 숨기기.

        if (vAPPL_RSLT_CD == "N") {
            txa_reject_rsn.setReadOnly(true);
            $c.stf.showObj(panel_reject, true); // 거부사유 숨기기.

        } else {
            $c.stf.showObj(panel_reject, false); // 거부사유 숨기기.

        }
    }
    $c.stf.setObjectValue(txb_EMP_NO, scwin.gEmpNo); // 세션정보 넘기기. 이런 ㅈㄹ같은.;;	

};
scwin.fn_readReissuePassword = function() {
    //"REPASS_READ|APCT_ID=" + vAPCT_ID + "&APPL_DDTM=" + vAPPL_DDTM,
    var vTemp = frame.FrameID;
    var realQueryString = (vTemp.indexOf("|") > -1) ? vTemp.split("|")[1] : queryString;
    var items = realQueryString.split("&"); // items[0] = APCT_ID=1, items[1] = APCT_ID=APPL_DDTM=20080101
    var vAPCT_ID = items[0].split("=")[1];
    var vAPPL_DDTM = items[1].split("=")[1];
    //alert(vAPCT_ID + ", " + vAPPL_DDTM);
    var url = "/ListedCompanyPassword.do?method=readReissuePassword";
    url += "&APCT_ID=" + encodeURIComponent(vAPCT_ID);
    url += "&APPL_DDTM=" + vAPPL_DDTM;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    //alert(url);
    dts_Master.DataID = encodeURI(url);
    dts_Master.Reset();
};
scwin.fn_HideDebugCtrls = function() {
    $c.stf.showObj(panel_debug, false);
};
scwin.fn_executeReissuePasswordApproval = function(APPL_FLAG) {
    if (APPL_FLAG == "Y") {
        gLastJob = "승인";
    } else if (APPL_FLAG == "N") {
        var vRejectRsn = $c.stf.getObjectValue(txa_reject_rsn);
        if ($c.stf.checkMaxLength(txa_reject_rsn, 200, '거부사유') == false) {
            return;
        }
        gLastJob = "거부";
    }
    $c.stf.setObjectValue(txb_APPL_RSLT_CD, APPL_FLAG);
    var msg = $c.stf.getMessageParam("MSG-A006", gLastJob);
    var res = window.confirm(msg);
    if (res) {
        trs_Save.Action = "/ListedCompanyPassword.do?method=executeReissuePasswordApproval" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02;
        trs_Save.KeyName = "toinb_dataid4";
        trs_Save.KeyValue = "JSP(I:pInput=dts_Master)";
        trs_Save.Post();
    }
};
scwin.dts_MASTER_OnLoadError = function() {
    $c.stf.alert_error(dts_MASTER);
};
scwin.trs_Save_OnFail = function() {
    var msg = $c.stf.getMessageParam("MSG-A002", gLastJob);
    $c.win.alert(msg);
    $c.stf.alert_error(trs_Save);
};
scwin.trs_Save_OnSuccess = async function() {
    var msg = $c.stf.getMessageParam("MSG-A001", gLastJob);
    $c.win.alert(msg);
    var fr_fn_Search = $c.frame.path("../").fn_listReissuePassword;
    fr_fn_Search();
    await $c.frame.CloseFrame();
};
scwin.btn_Approv_onclick = function() {
    scwin.fn_executeReissuePasswordApproval("Y");
};
scwin.btn_REJECT_onclick = function() {
    scwin.fn_executeReissuePasswordApproval("N");
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.gform_onload = function() {
    scwin.fn_HideDebugCtrls();
    scwin.initPage();
};
]]></script>

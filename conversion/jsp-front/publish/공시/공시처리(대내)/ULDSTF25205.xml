};
scwin.dts_STD_INDTP2_OnFilter = function(row) {
    var vVal = $c.stf.getObjectValue(cmb_STD_INDTP1);
    if (vVal == "") {
        // 대분류가 전체일 경우
        return true;
    } else {
        var vVal2 = dts_STD_INDTP2.getCellData(row, "value");
        if (vVal2 == "") return true;
        if (vVal.substring(0, 2) == vVal2.substring(0, 2)) {
            return true;
        } else {
            return false;
        }
    }
};
scwin.dts_STD_INDTP3_OnFilter = function(row) {
    var vVal = $c.stf.getObjectValue(cmb_STD_INDTP2);

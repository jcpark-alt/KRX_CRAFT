scwin.fn_Search = function() {
    var vMKT_ID = $c.stf.getObjectValue(rdo_MKT_ID);
    var vFORM_CD = $c.stf.getObjectValue(txb_FORM_CD);
    var vUSE_YN = $c.stf.getObjectValue(cmb_USE_YN);
    var vDELETE = $c.stf.getObjectValue(cmb_DELETE); // N : 미폐지, D : 폐지
    var vADM_BAS_TP_CD = $c.stf.getObjectValue(cmb_ADM_BAS_TP_CD);
    var vDepCD = $c.stf.getObjectValue(cmb_DEP_CD);
    var vDepCD = $c.stf.getObjectValue(txb_FORM_KOR_NM); // 서식명, 일정내용

    if (scwin.vUsrTpCd != null && scwin.vUsrTpCd == '4') {
        //현업사용자
        vUSE_YN = "Y";
        vDELETE = "N";
        vDepCD = js_team;
        if (vDepCD != '' && vDepCD != '13') {
            vDepCD = '0';
        }
    }
    var url = "/DisclosureSchedule.do?method=listScheduleAdmItems";
    url += "&MKT_ID=" + vMKT_ID;
    url += "&FORM_CD=" + vFORM_CD;
    url += "&USE_YN=" + vUSE_YN;
    url += "&DELETE=" + vDELETE;
    url += "&ADM_BAS_TP_CD=" + vADM_BAS_TP_CD;
    url += "&DEP_CD=" + vDepCD;
    url += "&SCHDL_ADM_ITM_TP_NM=" + $c.stf.getObjectValue(txb_SCHDL_ADM_ITM_TP_NM);
    url += "&SUBMIT_SYS_USE_YN=" + $c.stf.getObjectValue(cmb_SUBMIT_SYS_USE_YN);
    url += "&SMS_TRNSM_YN=" + $c.stf.getObjectValue(cmb_SMS_TRNSM_YN);
    url += "&FORM_KOR_NM=" + $c.stf.getObjectValue(txb_FORM_KOR_NM);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;

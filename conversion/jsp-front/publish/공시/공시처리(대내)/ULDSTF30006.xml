scwin.fn_openForm = async function(form_cd, form_ver, dep_cd, x_path, schdl_adm_itm_tp_nm) {
    //서식별로 모든항목들에 대해서 보여주려 했으나 팝업호출시 문자열이 길어 호출시 에러발생. 건별로 양식보기에서 보여준다.
    //var form_x_path = getFormXPath(form_cd,x_path); 
    var form_x_path = scwin.StringToHex4(schdl_adm_itm_tp_nm) + ":" + x_path;
    var url;
    if (js_svrGubun.indexOf("test") > -1) {
        url = g_test_manager_url + "/filing/findForm.do?method=scheduleFormView";
    } else if (js_svrGubun == 'dev') {
        url = g_dev_manager_url + "/filing/findForm.do?method=scheduleFormView";
    } else {
        url = g_real_manager_url + "/filing/findForm.do?method=scheduleFormView";
    }
    url += "&formCd=" + form_cd;
    url += "&formVer=" + form_ver;
    url += "&form_x_path=" + form_x_path;
    var winTitle = url;
    await $c.frame.CreateDialogFrame("formPop", url, winTitle, 10, 10, 800, 700, "window");
};
scwin.StringToHex4 = function(OriginalString) {
    var ReturnString = "";
    for (var i = 0; i < OriginalString.length; i++) {
        var tmp = "0000" + (parseInt(OriginalString.charCodeAt(i)).toString(16));
        var tmp2 = tmp.substring(tmp.length - 4);
        ReturnString += tmp2;
    }
    return ReturnString.toUpperCase();
};
scwin.getFormXPath = function(form_cd, x_path) {
    var str = "";
    for (var i = 0; i < dts_SCHEDULE.getTotalRow(); i++) {
        if (form_cd == dts_SCHEDULE.getCellData(i, "FORM_CD")) {
            if (i == 0) {
                str += dts_SCHEDULE.getCellData(i, "SCHDL_ADM_ITM_TP_NM");
                str += ":" + dts_SCHEDULE.getCellData(i, "X_PATH");
            } else {
                str += "," + dts_SCHEDULE.getCellData(i, "SCHDL_ADM_ITM_TP_NM");
                str += ":" + dts_SCHEDULE.getCellData(i, "X_PATH");
            }
        }
    }
    return str;
};

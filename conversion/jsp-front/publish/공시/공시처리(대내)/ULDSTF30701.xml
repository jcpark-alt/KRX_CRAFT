스크립트 수작업 유의사항
*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.gLastJob = "";
scwin.vScrenID = "ULDSTF30701.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.initPage = function() {
    scwin.fn_readNewPassword();
    var vAPPL_RSLT_CD = $c.stf.getObjectValue(txb_APPL_RSLT_CD);
    if (vAPPL_RSLT_CD != "R") {
        $c.stf.showObj(btn_Approv, false); // 승인버튼 숨기기.
        $c.stf.showObj(btn_REJECT, false);
    }
    $c.stf.setObjectValue(txb_EMP_NO, js_emp_no); // 세션정보 넘기기. 이런 ㅈㄹ같은.;;	

};
scwin.fn_readNewPassword = function() {
    //NEWPASS_READ|INTEG_USR_ID=" + vINTEG_USR_ID
    var vTemp = frame.FrameID;
    var Temp2 = vTemp.split("|")[1];
    var vCORP_USR_REG_APPL_SEQ = Temp2.split("=")[1]; // CORP_USR_REG_APPL_SEQ
    //alert(vCORP_USR_REG_APPL_SEQ);
    //alert(vCONTN_ID);
    var url = "/ListedCompanyPassword.do?method=readNewPassword";
    url += "&CORP_USR_REG_APPL_SEQ=" + vCORP_USR_REG_APPL_SEQ;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_MASTER.DataID = encodeURI(url);
    dts_MASTER.Reset();
};
scwin.fn_HideDebugCtrls = function() {
    $c.stf.showObj(panel_debug, false);
};
scwin.check4MM = function() {
    var mm_a = txt_MM_A.getValue();
    var mm_b = txt_MM_B.getValue();
    //시장조성자 번호는 필수임.
    if (mm_a == '') {
        $c.win.alert('시장조성자 번호가 없습니다. 시스템담당자에게 문의 하십시오.');
        return false;
    } else {
        //발행기관에 시장조성자 번호가 있는경우,  승인시 신청한 시장조성자 번호로 업데이트 하지 않음.(시장조성자 번호가 발행기관에 없는 경우에만 처기하기 위하여)
        if (mm_b != '') {
            var res = window.confirm('발행기관 테이블에 시장조성자 번호가 있는경우,\r\n시장조성자 번호는 업데이트 하지 않습니다.\r\n계속 진행하시겠습니까?');
            if (res) {
                return true;
            } else return false;
        } else return true;
    }
};
scwin.fn_executeNewPasswordApproval = function(APPL_FLAG) {
    var canGoNext = true;
    var usrTpCd = dts_MASTER.getCellData(1, "CORP_USR_TP_CD");
    if (APPL_FLAG == "Y") {
        scwin.gLastJob = "승인";
        if (usrTpCd == '32') {
            if (!scwin.check4MM()) {
                canGoNext = false;
            }
        }
    } else if (APPL_FLAG == "N") {
        scwin.gLastJob = "거부";
    }
    if (canGoNext) {
        $c.stf.setObjectValue(txb_APPL_RSLT_CD, APPL_FLAG);
        //	return;
        var msg = $c.stf.getMessageParam("MSG-A006", scwin.gLastJob);
        var res = window.confirm(msg);
        if (res) {
            trs_Save.Action = "/ListedCompanyPassword.do?method=executeNewPasswordApproval" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02;
            trs_Save.KeyName = "toinb_dataid4";
            trs_Save.KeyValue = "JSP(I:pInput=dts_MASTER)";
            trs_Save.Post();
        }
    }
};
scwin.checkIsMM = function() {
    var usrTpCd = dts_MASTER.getCellData(1, "CORP_USR_TP_CD");
    if (usrTpCd == '32') {
        $c.stf.showObj(pnl_MM, true);
    } else {
        $c.stf.showObj(pnl_MM, false);
    }
};
scwin.dts_MASTER_OnLoadError = function() {
    $c.stf.alert_error(dts_MASTER);
};
scwin.dts_MASTER_OnLoadCompleted = function(rowcount) {
    scwin.checkIsMM();
};
scwin.trs_Save_OnFail = function() {
    var msg = $c.stf.getMessageParam("MSG-A002", scwin.gLastJob);
    $c.win.alert(msg);
    $c.stf.alert_error(trs_Save);
};
scwin.trs_Save_OnSuccess = async function() {
    var msg = $c.stf.getMessageParam("MSG-A001", scwin.gLastJob);
    $c.win.alert(msg);
    var fr_fn_Search = $c.frame.path("../").fn_listNewPassword;
    fr_fn_Search();
    await $c.frame.CloseFrame();
};
scwin.btn_Approv_onclick = function() {
    scwin.fn_executeNewPasswordApproval("Y");
};
scwin.btn_REJECT_onclick = function() {
    scwin.fn_executeNewPasswordApproval("N");
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.gform_onload = function() {
    scwin.fn_HideDebugCtrls();

    //fn_SetCode();
    scwin.initPage();
};
]]></script>

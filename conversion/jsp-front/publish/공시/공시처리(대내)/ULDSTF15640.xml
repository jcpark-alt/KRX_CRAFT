    var vTp = $c.cp.valueOfIndex(cmb_Tab1_PeriodTp, "VALUE", cmb_Tab1_PeriodTp.getSelectedIndex());
    $c.stf.fn_setFromToDate(vTp, edt_Tab1_FromDate, edt_Tab1_ToDate);
};
scwin.cmb_Tab2_PeriodTp_OnSelChange = function() {

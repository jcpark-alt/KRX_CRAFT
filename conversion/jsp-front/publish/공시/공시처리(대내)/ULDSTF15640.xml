    MxTab_1.setSelectedTabIndex("1");
    scwin.fn_SetCode();

    //두번째 탭 회사검색
    $c.cm.fn_com_isur(txb_isur_cd, txb_com_abbrv);
    $c.stf.Combo_CBDataSetPeriod(cmb_Tab1_PeriodTp);
    $c.stf.Combo_CBDataSetPeriod(cmb_Tab2_PeriodTp);
    scwin.fn_CheckCond();
};

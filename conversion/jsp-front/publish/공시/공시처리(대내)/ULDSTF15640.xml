scwin.fn_SetCode = function() {
    chb_SecuAA.setValue(1);
    if (js_market == "9") {
        $c.stf.setObjectValue(rdo_Tab1_MARKET_TP_CD, "A");
        $c.stf.setObjectValue(rdo_Tab2_MARKET_TP_CD, "A");
    } else {
        $c.stf.setObjectValue(rdo_Tab1_MARKET_TP_CD, js_market);
        $c.stf.setObjectValue(rdo_Tab2_MARKET_TP_CD, js_market);
    }

    //위탁회사명
    dts_BCComList.DataID = "/DisclosureSearch.do?method=listCompanySecuGrp" + "&inputMessageId=CODEVALUE_INOUT&outputMessageId=CODE_OUT" + "&For=R&SecuGrp=BC";
    dts_BCComList.Reset();

    //수익증권 서식목록
    dts_FormCdList.DataID = "/DisclosureSearch.do?method=listCompanyBCFormCdList" + "&inputMessageId=CODEVALUE_INOUT&outputMessageId=CODE_OUT" + "&For=R";
    dts_FormCdList.Reset();

    //  Tab1 : 기간 from~ to  셋팅	
    var vCurDate = $c.ut.cGetToday("yyyymmdd");
    edt_Tab1_FromDate.setValue($c.ut.cGetMinusDate2(vCurDate, 7)); // 7일전 날짜
    edt_Tab1_ToDate.setValue(vCurDate); // 현재날짜

    //  Tab2 : 기간 from~ to  셋팅	
    var vCurDate = $c.ut.cGetToday("yyyymmdd");
    edt_Tab2_FromDate.setValue($c.ut.cGetMinusDate2(vCurDate, 7)); // 7일전 날짜
    edt_Tab2_ToDate.setValue(vCurDate); // 현재날짜

};
scwin.fn_CheckCond = function() {
    if (MxTab_1.getSelectedTabIndex() == 1) {
        // 일자 체크
        if ($c.stf.getObjectValue(edt_Tab1_FromDate).length < 8) {
            $c.win.alert("일자 올바르게 입력하십시오.");
            edt_Tab1_FromDate.focus();
            return;
        }

        // 일자 체크
        if ($c.stf.getObjectValue(edt_Tab1_ToDate).length < 8) {
            $c.win.alert("일자 올바르게 입력하십시오.");
            edt_Tab1_ToDate.focus();
            return;
        }
        if ($c.stf.compareFromToDate2(edt_Tab1_FromDate, edt_Tab1_ToDate) == false) {
            return;
        }
        scwin.fn_Search1();
    } else if (MxTab_1.getSelectedTabIndex() == 2) {
        // 일자 체크
        if ($c.stf.getObjectValue(edt_Tab2_FromDate).length < 8) {
            $c.win.alert("일자 올바르게 입력하십시오.");
            edt_Tab2_FromDate.focus();
            return;
        }

        // 일자 체크
        if ($c.stf.getObjectValue(edt_Tab2_ToDate).length < 8) {
            $c.win.alert("일자 올바르게 입력하십시오.");
            edt_Tab2_ToDate.focus();
            return;
        }
        if ($c.stf.compareFromToDate2(edt_Tab2_FromDate, edt_Tab2_ToDate) == false) {
            return;
        }

        //보고서 코드 체크
        var vFormCd2 = $c.stf.getObjectValue(txb_FormCd);
        if (vFormCd2.length > 0 && vFormCd2.length != 5) {
            $c.win.alert("보고서코드 5자리를 입력하십시오.");
            txb_FormCd.focus();
            return;
        }
        scwin.fn_Search2();
    }
};
scwin.fn_Search1 = function() {
    var url = "/DisclosureSearch.do?method=listSecuGrpDsclSrch" + "&inputMessageId=DSCLSECUGRPCOND_IN" + "&outputMessageId=DSCLSECUGRPCOND_OUT" + "&SECU_TYPE=BC" + "&BASIS_TP=" + $c.stf.getObjectValue(cmb_Tab1_Basis) + "&FROM_DATE=" + $c.stf.getObjectValue(edt_Tab1_FromDate) + "&TO_DATE=" + $c.stf.getObjectValue(edt_Tab1_ToDate) + "&LAST_YN=" + scwin.getChkValue(chb_Tab1_Last) + "&FORM_CD=" + $c.stf.getObjectValue(cmb_FormCdList) + "&ISUR_CD=" + $c.stf.getObjectValue(cmb_BCComList) + "&LD_MKT_TP_CD=" + $c.stf.getObjectValue(rdo_Tab1_MARKET_TP_CD) + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_DsclList.DataID = encodeURI(url);
    dts_DsclList.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.fn_Search2 = function() {
    //com_attr_tp_cd
    var secuGrpId = "";
    if (scwin.getChkValue(chb_SecuRT) == '1') secuGrpId += '4,';
    if (scwin.getChkValue(chb_SecuSC) == '1') secuGrpId += '6,';
    if (scwin.getChkValue(chb_SecuMT) == '1') secuGrpId += '2,';
    if (scwin.getChkValue(chb_SecuAA) == '1') secuGrpId = '';
    var url = "/DisclosureSearch.do?method=listSecuGrpDsclSrch" + "&inputMessageId=DSCLSECUGRPCOND_IN" + "&outputMessageId=DSCLSECUGRPCOND_OUT" + "&SECU_TYPE=" + secuGrpId + "&BASIS_TP=" + $c.stf.getObjectValue(cmb_Tab2_Basis) + "&FROM_DATE=" + $c.stf.getObjectValue(edt_Tab2_FromDate) + "&TO_DATE=" + $c.stf.getObjectValue(edt_Tab2_ToDate) + "&LAST_YN=" + scwin.getChkValue(chb_Tab2_Last) + "&FORM_CD=" + $c.stf.getObjectValue(txb_FormCd) + "&FORM_NM=" + $c.stf.getObjectValue(txb_FormNm) + "&ISUR_CD=" + $c.stf.getObjectValue(txb_isur_cd) + "&LD_MKT_TP_CD=" + $c.stf.getObjectValue(rdo_Tab2_MARKET_TP_CD) + "&LIST_STAT=" + scwin.getChkValue(chb_ListStatCd) + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_DsclList2.DataID = encodeURI(url);
    dts_DsclList2.reset();
    $c.cm.ShowWin(grd_Grid2);
};
scwin.fn_allCheck = function() {
    var checkArray = [chb_SecuRT, chb_SecuSC, chb_SecuMT];
    if (chb_SecuAA.checked == true) {
        for (var i = 0; i < checkArray.length; i++) {
            checkArray[i].setValue(0);
        }
    }
};
scwin.getChkValue = function(obj) {
    //return (obj.checked) ? "Y" : "N";
    if (obj.checked == true) {
        return obj.getValue();
    } else {
        return "";
    }
};



// 그리드에서 클릭 row의 변수셋팅
scwin.fn_setContnId_Tab1 = function(obj) {
    scwin.gAcptNo = dts_DsclList.getCellData(eval(obj), "ACPT_NO");
};



scwin.btn_Tab1_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    $c.data.downloadGridViewExcel(grd_Grid, "수익증권 공시상세검색  목록", "", "8");
};
scwin.btn_Tab2_Excel_onclick = function() {
    var secuGrpNm = "";
    if ($c.stf.getObjectValue(chb_SecuRT) == '1') secuGrpNm = "부동산투자";
    if ($c.stf.getObjectValue(chb_SecuSC) == '1') secuGrpNm = "선박투자";
    if ($c.stf.getObjectValue(chb_SecuMT) == '1') secuGrpNm = "투자회사";
    if ($c.stf.getObjectValue(chb_SecuAA) == ' 1') secuGrpNm = "전체";
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);

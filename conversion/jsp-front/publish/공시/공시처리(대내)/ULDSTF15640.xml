    $c.stf.alert_error(dts_DsclList);
    $c.cm.CloseWin('', grd_Grid);
};
scwin.dts_DsclList_OnLoadCompleted = function(rowcount) {
    if (dts_DsclList.errorMsg) {
        $c.win.alert("OnLoadCompleted => " + dts_DsclList.errorMsg);
    } else {
        $c.stf.FillGridHeaderTotalCnt(rowcount, panel_Tab1_page);
    }
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.grd_Grid_OnDblClick = function(row, colid) {
    // 클릭된 값 변수에 셋팅
    scwin.fn_setContnId_Tab1(row);
    if (colid == "DOC_TITLE") {
        $c.stf.fn_OpenDisclViewer(scwin.gAcptNo, "R");
    }
};

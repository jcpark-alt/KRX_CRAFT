scwin.fn_Old_Status = function() {
    $c.frame.path("../../").GWinOpen("ULDSTF26501", "/dsclsrch/ULDSTF26501.gfm", "구 공시접수통계", 20, 20, 1080, 620 + 40, "");
};
scwin.fn_HideDebugCtrls = function() {
    $c.stf.showObj(panel_mkt, false);
};
scwin.btn_Search_onclick = function() {
    scwin.fn_listDisclosureReceiveStatistic();
};
scwin.dts_PERIOD_OnLoadError = function() {
    $c.stf.alert_error(dts_PERIOD);
};
scwin.btn_SDATE_onclick = function() {
    popUpCalendar2(edt_SDATE);
};
scwin.btn_EDATE_onclick = function() {
    popUpCalendar2(edt_EDATE);
};
scwin.cmb_PeriodTp_OnSelChange = function() {
    var vTp = $c.stf.getObjectValue(cmb_PeriodTp);
    $c.stf.fn_setFromToDate(vTp, edt_SDATE, edt_EDATE);
};
scwin.btn_Excel_Today_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    $c.data.downloadGridViewExcel(grd_TODAY, "공시접수통계", 'c:\\abs\\test.xls', 16);
};
scwin.chk_TODAY_onclick = function() {
    if ($c.stf.getObjectValue(chk_TODAY) == "Y") {
        $c.cm.setColumnProp(grd_PERIOD, 'SEND_D', 'Show', 'true');
        dts_PERIOD.removeAll();
        dts_TODAY.removeAll();
        $c.stf.setObjectValue(chk_PERIOD, "N");
        $c.stf.showObj(panel_period, false);
        $c.stf.showObj(panel_today, true);
    }
};
scwin.chk_PERIOD_onclick = function() {
    if ($c.stf.getObjectValue(chk_PERIOD) == "Y") {
        $c.cm.setColumnProp(grd_PERIOD, 'SEND_D', 'Show', 'false');
        dts_PERIOD.removeAll();
        dts_TODAY.removeAll();
        $c.stf.setObjectValue(chk_TODAY, "N");
        $c.stf.showObj(panel_period, true);
        $c.stf.showObj(panel_today, false);
    }
};
scwin.dts_TODAY_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_TODAY);
};
scwin.dts_TODAY_OnLoadError = function() {
    $c.stf.alert_error(dts_TODAY);
};
scwin.dts_PERIOD_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_PERIOD);
};
scwin.btn_Excel_Period_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    $c.data.downloadGridViewExcel(grd_PERIOD, "공시접수통계", 'c:\\abs\\test.xls', 16);
};
scwin.btn_TODAY_onclick = function() {
    popUpCalendar2(edt_TODAY);
};
scwin.btn_Status_Cnt_onclick = function() {
    scwin.fn_StatusCnt();
};
scwin.btn_Old_Status_onclick = function() {
    scwin.fn_Old_Status();
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    $c.stf.showObj(panel_kos, false);
    scwin.fn_HideDebugCtrls();
    scwin.initPage();
};
]]></script>

		<script type="text/javascript" lazy="false"><![CDATA[
/* ★Wcraft guide★    
스크립트 수작업 유의사항
*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
// session 값을 control 에 binding 시키는 함수.

scwin.vScrenID = 'ULDSTF26504.xml';
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.initPage = function() {
    if (js_market == "9") {
        rdo_MKT_ID.setDisabled(false);
    } else {
        rdo_MKT_ID.setDisabled(true);
        if (js_market != '1') {
            // 유가가 아닐때만 보여줌	
            $c.stf.showObj(panel_kos, true);
        }
    }
    $c.stf.setObjectValue(rdo_MKT_ID, scwin.gLdMktTp);
    $c.stf.setObjectValue(chk_TODAY, "Y");
    $c.stf.setObjectValue(edt_TODAY, $c.ut.cGetToday2());
    $c.stf.showObj(panel_today, true);
    // alert(gLdMktTp);
    $c.stf.setObjectValue(chk_PERIOD, "N");
    $c.stf.showObj(panel_period, false);
    $c.stf.setObjectValue(cmb_PeriodTp, "5");
};
scwin.fn_listDisclosureReceiveStatistic = function() {
    var MKT_ID = $c.stf.getObjectValue(rdo_MKT_ID);
    if (MKT_ID == "") {
        $c.win.alert("[시장구분]을 선택하세요.");
        return;
    }
    var MKT_ID = $c.stf.getObjectValue(rdo_MKT_ID);
    var SDATE = $c.stf.getObjectValue(edt_SDATE);
    var EDATE = $c.stf.getObjectValue(edt_EDATE);
    var TODAY = $c.stf.getObjectValue(edt_TODAY);
    var bTODAY = $c.stf.getObjectValue(chk_TODAY);
    var bPERIOD = $c.stf.getObjectValue(chk_PERIOD);
    if (bTODAY == "N" && bPERIOD == "N") {
        $c.win.alert("[금일] 또는 [기간별]을 선택하세요.");
        return;
    }
    var FLAG = "TODAY";
    FLAG = (bTODAY == "Y") ? "TODAY" : "PERIOD";
    if (FLAG == "TODAY") {
        if (TODAY == "") {
            $c.win.alert("[금일-일자]를 입력하세요.");
            edt_TODAY.focus();
            return;
        }
    } else {
        if (SDATE == "") {
            $c.win.alert("[기간별-시작일]을 입력하세요.");
            edt_SDATE.focus();
            return;
        }
        if (EDATE == "") {
            $c.win.alert("[기간별-종료일]을 입력하세요.");
            edt_EDATE.focus();
            return;
        }
    }
    $c.cm.ShowWin(grd_TODAY);
    $c.cm.ShowWin(grd_PERIOD);
    var url = "/DisclosureCountStatistics.do?method=listDisclosureReceiveStatisticNew";
    url += "&MKT_ID=" + MKT_ID;
    url += "&TODAY=" + TODAY;
    url += "&SDATE=" + SDATE;
    url += "&EDATE=" + EDATE;
    url += "&FLAG=" + FLAG;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_TODAY.DataID = url;
    dts_TODAY.Reset();
    url = "/DisclosureCountStatistics.do?method=listDisclosureReceivePeriodNew";
    url += "&MKT_ID=" + MKT_ID;
    url += "&TODAY=" + TODAY;
    url += "&SDATE=" + SDATE;
    url += "&EDATE=" + EDATE;
    url += "&FLAG=" + FLAG;
    dts_PERIOD.DataID = url;
    dts_PERIOD.Reset();
};
scwin.fn_StatusCnt = function() {
    $c.frame.path("../../").GWinOpen("ULDSTF26505", "/dsclsrch/ULDSTF26505.gfm", "공시건수조회", 20, 20, 1270, 780, "");

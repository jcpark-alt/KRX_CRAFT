scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    var file_name = "불성실공시 심의관리 목록";
    var today = $c.ut.cGetToday('yyyymmddhhmmss');
    var xls_path = $c.session.getExcelDownPath() + today + "_" + file_name + ".xlsx";
    $c.data.downloadGridViewOffice(grd_Grid, file_name, xls_path, "8", 0);
};

scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
    $c.cm.CloseWin('', grd_Grid);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        txb_TotalCnt.setValue("총건수 : " + rowcount);
    }
    dts_List.setRowPosition(scwin.gRow, 0);
    scwin.gRow = 1;
    $c.cm.CloseWin(rowcount, grd_Grid);
};

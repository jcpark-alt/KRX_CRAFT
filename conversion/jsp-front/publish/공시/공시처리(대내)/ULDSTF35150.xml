scwin.fn_SetCode = function() {
    //  기간 from~ to  셋팅	
    var vCurDate = $c.ut.cGetToday("yyyymmdd");
    $c.stf.setObjectValue(cmb_PeriodTp, vCurDate.substring(0, 4));
    scwin.fn_setFromToDateYear(edt_FromDate, edt_ToDate);

    // 위반중요성유형  셋팅
    //dts_SignifTp.DataID = "/CodeAction.do?method=listCodeValueName&inputMessageId=CODEVALUE_INOUT&outputMessageId=CODE_OUT"+
    //						"&FOR=C&CD_ENG_NM=DISCLS_VIOL_SIGNIF_TP_CD";
    //dts_SignifTp.Reset();

    // 위반동기유형  셋팅
    //dts_MotivTp.DataID = "/CodeAction.do?method=listCodeValueName&inputMessageId=CODEVALUE_INOUT&outputMessageId=CODE_OUT"+
    //						"&FOR=C&CD_ENG_NM=DISCLS_VIOL_MOTIV_TP_CD";
    //dts_MotivTp.Reset();

    // 불성실유형  셋팅
    dts_NfaithTp.DataID = "/CodeAction.do?method=listCodeValueName&inputMessageId=CODEVALUE_INOUT&outputMessageId=CODE_OUT" + "&FOR=C&CD_ENG_NM=NFAITH_TP_CD";
    dts_NfaithTp.Reset();
};
scwin.fn_CheckCond = function() {
    // 일자 체크
    if ($c.stf.getObjectValue(edt_FromDate).length < 8) {
        $c.win.alert("위원회 일시를 올바르게 입력하십시오.");
        edt_FromDate.focus();
        return;
    }

    // 일자 체크
    if ($c.stf.getObjectValue(edt_ToDate).length < 8) {
        $c.win.alert("위원회 일시를 올바르게 입력하십시오.");
        edt_ToDate.focus();
        return;
    }
    if ($c.stf.compareFromToDate2(edt_FromDate, edt_ToDate) == false) {
        return;
    }
    scwin.fn_Search();
};


// 그리드에서 클릭 row의 변수셋팅
scwin.fn_setContnId = function(obj) {
    scwin.gIsurCd = dts_List.getCellData(eval(obj), "ISUR_CD");
};
scwin.fn_Search = function() {
    txb_TotalCnt.setValue("총건수 : ");
    var url = "/UnfaithfulDesign.do?method=listUnfaithfulComite" + "&ISUR_CD=" + $c.stf.getObjectValue(txb_isur_cd) + "&FROM_DATE=" + $c.stf.getObjectValue(edt_FromDate) + "&TO_DATE=" + $c.stf.getObjectValue(edt_ToDate) + "&NFAITH_TP=" + $c.stf.getObjectValue(cmb_NfaithTp) + "&MOTIV_TP=" + $c.stf.getObjectValue(cmb_MotivTp) + "&SIGNIF_TP=" + $c.stf.getObjectValue(cmb_SignifTp) + "&NFAITH_CONTN=" + $c.stf.getObjectValue(txb_NFAITH_CONTN) + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;

    // 그리드의 데이타 조회
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.Combo_CBDataSetPeriodYear = function(sval) {
    var date = new Date();
    var yy = date.getFullYear();
    var usrCBData = "";
    while (yy >= 2000) {
        if (yy != date.getFullYear()) usrCBData += ",";
        usrCBData += yy + "년도^" + yy;
        yy--;
    }
    sval.CBData = usrCBData;
};
scwin.fn_setFromToDateYear = function(pObjFrom, pObjTo) {
    var yy = $c.stf.getObjectValue(cmb_PeriodTp);
    //var today = cGetToday("yyyymmdd");
    var vFrom = yy + "0101";
    var vTo = yy + "1231";
    $c.stf.setObjectValue(pObjFrom, vFrom);
    //setObjectValue(pObjTo,  today>vTo?vTo:today);
    $c.stf.setObjectValue(pObjTo, vTo);
};
scwin.grd_Grid_OnDblClick = async function(row, colid) {
    // 클릭된 값 변수에 셋팅
    scwin.seq = dts_List.getCellData(row, "SEQ");
    scwin.gRow = row;
    scwin.fn_setContnId(row);
    if (scwin.seq != "") {
        if (colid == "COMITE_DD") {
            await $c.frame.CreateDialogFrame("gform", "/dsclmgt/ULDSTF35151.gfm", "불성실공시 심의 관리(코) 수정", 100, 50, 630, 750, "window");
        } else if (colid == "COM_ABBRV") {
            $c.stf.fn_PopupCorpInfo();
        }
    }
};
scwin.btn_Insert_onclick = async function() {
    scwin.seq = "";
    await $c.frame.CreateDialogFrame("gform", "/dsclmgt/ULDSTF35151.gfm", "불성실공시 심의 관리(코) 등록", 100, 50, 630, 750, "window");
};

scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_Search = function() {
    scwin.vMKT_TP_CD = $c.stf.getObjectValue(rdo_MKT_ID);
    var vFORM_CD = $c.stf.getObjectValue(txb_form_cd);
    var vFORM_NM = $c.stf.getObjectValue(txb_form_nm);
    var url = "/ByPass.do?method=listPreRevwForm";
    url += "&MKT_TP_CD=" + scwin.vMKT_TP_CD;
    url += "&FORM_CD=" + vFORM_CD;
    url += "&FORM_NM=" + vFORM_NM;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    }
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
    $c.cm.CloseWin('', grd_Grid);
};
scwin.btn_Search_onclick = function() {
    scwin.fn_Search();
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
    var sMsg = '';
    scwin.vMKT_TP_CD = $c.stf.getObjectValue(rdo_MKT_ID);
    if (scwin.vMKT_TP_CD == '1') {
        sMsg = "확인절차  대상서식";
    } else {
        sMsg = "사전확인면제대상서식";
    }
    $c.data.downloadGridViewExcel(grd_Grid, sMsg, "", "8");
};
scwin.txb_form_nm_onkeypress = function() {
    if (window.event.keyCode == 13) {
        scwin.fn_Search();
    }
};
scwin.txb_form_cd_onkeypress = function() {
    if (window.event.keyCode == 13) {
        scwin.fn_Search();
    }
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    $c.stf.showObj(panel_mkt, false);
    $c.stf.setObjectValue(rdo_MKT_ID, '1');
    scwin.fn_Search();
};

};
scwin.fn_SetCode = function() {

};
scwin.initPage = function() {
    scwin.gNOTI_SVC_ID = $c.stf.getQuery(frame.srcUrl, "NOTI_SVC_ID");
};
scwin.fn_read = function() {
    var url = "/EmailMgt.do?method=readSendMailInfo" + "&inputMessageId=BIZSPT_EMAIL_SMS_RECEIVER_INOUT" + "&NOTI_SVC_ID=" + scwin.gNOTI_SVC_ID + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    //alert(url);
    dts_Master.DataID = encodeURI(url);
    dts_Master.Reset();
    var urlFile = "/EmailMgt.do?method=listAttachFile" + "&inputMessageId=BIZSPT_EMAIL_SMS_RECEIVER_INOUT" + "&NOTI_SVC_ID=" + scwin.gNOTI_SVC_ID + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    //alert(url);
    dts_fileData.DataID = encodeURI(urlFile);
    dts_fileData.Reset();
    var urlReceiver = "/EmailMgt.do?method=listSendReceiver" + "&inputMessageId=BIZSPT_EMAIL_SMS_RECEIVER_INOUT" + "&NOTI_SVC_ID=" + scwin.gNOTI_SVC_ID + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Receiver.DataID = encodeURI(urlReceiver);
    dts_Receiver.Reset();
};


// 첨부파일 다운로드
scwin.fn_filedown = function(vNotiSvcId, vSeq) {
    //var vNotiSvcId= getObjectValue(txb_NOTI_SVC_ID);
    //var vSeq= getObjectValue(txb_file_seq);

    var link = "/filedownload.do?NOTI_SVC_ID=" + vNotiSvcId + "&SEQ=" + vSeq + "&gubun=11";
    location.href = encodeURI(link);
};
scwin.fn_HideDebugCtrls = function() {
    $c.stf.showObj(panel_debug, false);
};


// 그리드에서 클릭 row의 변수셋팅
scwin.fn_setContnId = function(obj) {
    scwin.gIsurCd = dts_Receiver.getCellData(eval(obj), "ISUR_CD");
    //alert("부모창:"+ gIsurCd);

};
scwin.grd_fileList_CanColumnPosChange = function(row, colid) {
    return true;
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.grd_Receiver_OnDblClick = function(row, colid) {
    // 클릭된 값 변수에 셋팅
    scwin.fn_setContnId(row);
    if (colid == "COM_ABBRV") {

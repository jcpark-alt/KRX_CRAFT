};
scwin.dts_fileData_OnLoadCompleted = function(rowcount) {
    $c.stf.setObjectValue(txb_file_cnt, "(총 : " + rowcount + " 건)");
};
scwin.dts_attach_file_OnLoadError = function() {
    $c.win.alert(dts_attach_file);
};
scwin.dts_attach_file_OnLoadCompleted = function(rowcount) {
    gImprRegDd = dts_attach_file.getCellData(1, "IMPR_REG_DD");
};
scwin.grd_fileList_OnDblClick = function(row, colid) {
    if (dts_fileData.getRowStatus(dts_fileData.getRowPosition()) == 0) {
        scwin.fn_filedown(dts_fileData.getCellData(row, "NOTI_SVC_ID"), dts_fileData.getCellData(row, "FILE_SEQ"));
    }
};
scwin.gform_onload = function() {
    $c.libRoundPanel.PanelToGroupBox(panel_1);
    scwin.fn_HideDebugCtrls();
    scwin.fn_SetCode();
    scwin.initPage();
    scwin.fn_read();
};

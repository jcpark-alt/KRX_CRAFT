scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_init = function() {
    for (var i = 1; i <= 10; i++) $c.stf.showObj(eval("txb_ISUR_CD" + i), false);
    $c.stf.showObj(txb_NOTI_SEQ, false);
    $c.stf.showObj(txb_MODE, false);
    $c.stf.showObj(txb_EMP_NO, false);
    $c.stf.showObj(txb_CHRG_NM, false);
};
scwin.fn_SetCode = function() {
    scwin.mode = frame.opener.scwin.mode;
    if (scwin.mode == "I") {
        dts_Save.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ONLINE_NOTICE_NOTI_SAVE";
        dts_Save.Reset();
        dts_Save.insertRow();
        $c.stf.showObj(btn_Delete, false);
    } else {
        scwin.key_row = frame.opener.scwin.key_row;
        scwin.noti_seq = frame.opener.dts_Grid.getCellData(scwin.key_row, "NOTI_SEQ");
        scwin.fn_Read();
    }
    $c.stf.setObjectValue(txb_EMP_NO, scwin.gEmpNo);
};
scwin.fn_Read = function() {
    var url = "/OnlineNotice.do?method=readOnlineNotice";
    url += "&NOTI_SEQ=" + scwin.noti_seq;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Save.DataID = encodeURI(url);
    dts_Save.Reset();
};
scwin.fn_Save = function() {
    if ($c.stf.getObjectValue(txb_NOTI_SEQ) == "") {
        $c.stf.setObjectValue(txb_MODE, "I"); //인서트

    } else {
        $c.stf.setObjectValue(txb_MODE, "U"); //업데이트

    }
    rtn = scwin.fn_CheckForm();
    if (rtn) {
        var res = window.confirm("[저장]하시겠습니까?");
        if (res) {
            gLastJob = "저장";
            var url = "/OnlineNotice.do?method=saveOnlineNotice" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02;
            trs_Save.Action = url;
            trs_Save.KeyName = "toinb_dataid4";
            trs_Save.KeyValue = "JSP(I:pInputMaster=dts_SAVE)";
            trs_Save.post();
        }
    }
};
scwin.fn_Transmit = function() {
    var rtn = false;
    if ($c.stf.getObjectValue(txb_NOTI_SEQ) == "") {
        $c.stf.setObjectValue(txb_MODE, "TI"); //전송하면서 인서트

    } else {
        $c.stf.setObjectValue(txb_MODE, "TU"); //전송하면서 업데이트

    }
    rtn = scwin.fn_CheckForm();
    if (rtn) {
        var res = window.confirm("[전송]하시겠습니까?");
        if (res) {
            gLastJob = "전송";
            var url = "/OnlineNotice.do?method=saveOnlineNotice" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02;
            //alert(dts_MASTER.Text);
            trs_Save.Action = url;
            trs_Save.KeyName = "toinb_dataid4";
            trs_Save.KeyValue = "JSP(I:pInputMaster=dts_SAVE)";
            trs_Save.post();
        }
    }
};
scwin.fn_CheckForm = function() {
    var isur_cd = "";
    var com_abbrv = "";
    var contn = "";
    var halt_yn = "";
    for (var i = 1; i <= 10; i++) {
        isur_cd = $c.stf.getObjectValue(eval("txb_ISUR_CD" + i));
        com_abbrv = $c.stf.getObjectValue(eval("txb_COM_ABBRV" + i));
        contn = $c.stf.getObjectValue(eval("txb_INQDISCLS_REQ_CONTN" + i));
        halt_yn = $c.stf.getObjectValue(eval("rdo_HALT_YN" + i));
        //if(i==1)	alert("isur_cd : " + isur_cd + " : contn : " + contn + " : online_notice_yn : " +  online_notice_yn);

        if (isur_cd != '') {
            if (contn == '') {
                $c.win.alert("[" + com_abbrv + "]의 '내용'을 입력해주세요.");
                return false;
            }
            if (halt_yn == '') {
                $c.win.alert("[" + com_abbrv + "] 의 '매매거래정지여부'를 선택해주세요.");
                return false;
            }
        }
    }
    return true;
};
scwin.fn_Del = function() {
    $c.stf.setObjectValue(txb_EMP_NO, scwin.gEmpNo);
    var res = window.confirm("[삭제]하시겠습니까?");
    if (res) {
        gLastJob = "삭제";
        var url = "/OnlineNotice.do?method=deleteOnlineNotice";
        trs_Save.Action = url;
        trs_Save.KeyName = "toinb_dataid4";
        trs_Save.KeyValue = "JSP(I:pInputMaster=dts_Save)";
        trs_Save.post();
    }
};
scwin.fn_delete = function(row_num) {
    eval("txb_COM_ABBRV" + row_num).setValue("");
    eval("txb_INQDISCLS_REQ_CONTN" + row_num).setValue("");
    $c.stf.setObjectValue(eval("rdo_HALT_YN" + row_num), '');
    eval("txb_ISUR_CD" + row_num).setValue("");
    eval("txb_CHRG_NM" + row_num).setValue("");
};
scwin.afterExec = function(isur_cd, ld_mkt_tp_cd) {
    //담당자(내선번호)셋팅
    txb_CHRG_NM.setValue(isur_cd);
    var url = "/OnlineNotice.do?method=getChrgNmTel";
    url += "&ISUR_CD=" + isur_cd;
    dts_EMP_NM.DataID = encodeURI(url);
    dts_EMP_NM.Reset();
    var url = "/IntegratedBBS.do?method=registerKifrs";
    trs_EMP_NM.Action = url;
    trs_EMP_NM.KeyName = "toinb_dataid4";
    trs_EMP_NM.KeyValue = "JSP(I:pInputMaster=dts_EMP_NM)";
    trs_EMP_NM.post();
};
scwin.setChrgNM = function() {
    $c.stf.setObjectValue(eval('txb_CHRG_NM' + scwin.corp_row), $c.stf.getObjectValue(txb_CHRG_NM));
};
scwin.afterTransmit = function(dtsObj) {
    var USER_DEFINE = new Array("INFO");
    for (var i = 0; i < USER_DEFINE.length; i++) {
        var errorCount = dtsObj.SrvErrCount(USER_DEFINE[i]);
        var j;
        for (j = 0; j < errorCount; j++) {
            //alert("dtsObj.SrvErrMsg(USER_DEFINE[i], j) : " + dtsObj.SrvErrMsg(USER_DEFINE[i], j));
            scwin.fn_runThread(dtsObj.SrvErrMsg(USER_DEFINE[i], j));
            //setTimeout("fn_runThread('"+ dtsObj.SrvErrMsg(USER_DEFINE[i], j) + "')",30000);
            //alert("[CODE: " + dtsObj.SrvErrCode(USER_DEFINE[i], j)+ "] " + dtsObj.SrvErrMsg(USER_DEFINE[i], j));

        }
    }
};
scwin.fn_runThread = function(key) {
    $c.frame.path("/top").runOnlineThread(key);
};
scwin.trs_Save_OnFail = async function() {
    $c.stf.alert_error(trs_Save); //에러일경우 에러메시지 보여준다.
    scwin.afterTransmit(trs_Save);
    var fr_fn_Search = $c.frame.path("../").fn_Search;
    fr_fn_Search();
    await $c.frame.CloseFrame();
};
scwin.trs_Save_OnSuccess = async function() {
    var msg = $c.stf.getMessageParam("MSG-A001", gLastJob);
    $c.win.alert("[" + gLastJob + "] 성공하였습니다.");
    var fr_fn_Search = $c.frame.path("../").fn_Search;
    fr_fn_Search();
    await $c.frame.CloseFrame();
};
scwin.trs_EMP_NM_OnSuccess = function() {
    setTimeout("setChrgNM()", 700);
};

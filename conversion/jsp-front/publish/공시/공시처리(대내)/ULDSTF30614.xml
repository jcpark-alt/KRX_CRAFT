*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.key_isur_cd = '';
scwin.key_chrg_tp_cd = '';
scwin.key_seq = '';
scwin.key_assgn_dd = '';
scwin.vScrenID = "ULDSTF30614.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_Init = function() {
    $c.stf.setObjectValue(rdo_MARKET_FLAG, js_market);
    if (js_market != "9") {
        $c.stf.showObj(panel_mkt, false);
    }
};
scwin.fn_SetCode = function() {
    dts_EMP_NO.DataID = "/CodeAction.do?method=getEmpNoDepCode&inputMessageId=CODE_EMPDEP_IN&For=R&DEP_CD=" + scwin.gDepCd;
    dts_EMP_NO.Reset();
    dts_DEP_CD.DataID = "/CodeAction.do?method=getDepUpCode&inputMessageId=CODE_EMPDEP_IN&For=R&DEP_CD=" + scwin.gDepCd;
    dts_DEP_CD.Reset();
};
scwin.fn_Search = function() {
    var url = "/ListedCompany.do?method=listChargeIssueInfoRegisterStatusNew";
    url += "&MKT_ID=" + $c.stf.getObjectValue(rdo_MARKET_FLAG);
    url += "&ISUR_CD=" + $c.stf.getObjectValue(txb_isur_cd);
    url += "&DEP_CD=" + $c.stf.getObjectValue(cmb_DEP_CD);
    url += "&EMP_NO=" + $c.stf.getObjectValue(cmb_EMP_NO);
    url += "&CHRG_TP_CD=" + $c.stf.getObjectValue(cmb_CHRG_TP_CD);
    url += "&LST_HIST_YN=" + $c.stf.getObjectValue(chk_LST_HIST_YN);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.Reset();
    $c.cm.ShowWin(grd_List);
};
scwin.fn_OpenDetailInfo = async function(isur_cd, chrg_tp_cd, seq, assgn_dd) {
    scwin.key_isur_cd = isur_cd;
    scwin.key_chrg_tp_cd = chrg_tp_cd;
    scwin.key_seq = seq;
    scwin.key_assgn_dd = assgn_dd;
    await $c.frame.CreateFrame("child01", "/issueinfo/ULDSTF30615.gfm", "상세보기", 10, 10, 770, 610, "window", 0, 0, true);
};
scwin.cmb_DEP_CD_OnSelChange = function() {
    scwin.gDepCd = $c.stf.getObjectValue(cmb_DEP_CD); //;.ValueOfIndex("VALUE", cmb_DEP_CD.Index);

    dts_EMP_NO.UseFilter = true;
    dts_EMP_NO.Filter();
};
scwin.dts_EMP_NO_OnFilter = function(row) {
    if (scwin.gDepCd == "") {
        // 전체일 경우 모두 보여준다.
        return true;
    } else {
        if (dts_EMP_NO.getCellData(row, "dep_cd") == scwin.gDepCd ||
            dts_EMP_NO.getCellData(row, "dep_cd") == "") {
            return true;
        } else {
            return false;
        }
    }
};
scwin.btn_Search_onclick = function() {
    scwin.fn_Search();
};
scwin.dts_Grid_OnLoadCompleted = function(rowcount) {
    //if (rowcount > 0)
    //	grd_List.AutoResizeAllCol(true);
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    //alert(rowcount);
    $c.cm.CloseWin(rowcount, grd_List);
};
scwin.dts_Grid_OnLoadError = function() {
    $c.stf.alert_error(dts_Grid);
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
    $c.data.downloadGridViewExcel(grd_List, "정보등록현황", "", "2");
};
scwin.MxDataSet_com_isur_OnFilter = function(row) {
    if (skw != "" && foColum == "1") {
        f1 = MxDataSet_com_isur.getCellData(row, "COM_ABBRV");
        f2 = MxDataSet_com_isur.getCellData(row, "OLD_COM_ABBRV");
        if (f1.indexOf(skw) != -1 || f2.indexOf(skw) != -1) return true;

        else return false;
    } else {
        return true;
    }
};
scwin.txb_isur_cd_onblur = function() {
    if (stFocusGrid == false) {
        Grd_com_isur.style.display = "none";
    }
    if (txb_isur_cd.getValue() == "") {
        txb_com_abbrv.setValue("");
    }
};
scwin.txb_isur_cd_onfocus = function() {
    Grd_com_isur.style.display = "none";
};
scwin.txb_isur_cd_onkeyup = function() {
    if (txb_isur_cd.getValue() == "") {
        Grd_com_isur.style.display = "none";
    } else {
        if (window.event.keyCode == 40) {
            //아래화살표눌렀을때 그리드로 포커스
            Grd_com_isur.focus();
        } else {
            $c.cm.fn_com_isur_nm(window.event.keyCode);
        }
    }
};
scwin.Grd_com_isur_OnKeyPress = function(kcode) {
    if (kcode == '13') {
        $c.cm.fn_com_Confirm_set();
    }
};
scwin.Grd_com_isur_OnDblClick = function(row, colid) {
    $c.cm.fn_com_Confirm_set();
};
scwin.Grd_com_isur_OnClick = function(row, colid) {
    Grd_com_isur.style.display = "";
};
scwin.Grd_com_isur_OnSetFocus = function() {
    stFocusGrid = true;
};
scwin.Grd_com_isur_OnKillFocus = function() {
    stFocusGrid = false;
    Grd_com_isur.style.display = "none";
};
scwin.img_com_srch_onclick = function() {
    $c.cm.IsurcdSearch(txb_isur_cd, txb_com_abbrv);
};
scwin.grd_List_OnDblClick = function(row, colid) {
    if (colid == 'DETAIL') {
        scwin.fn_OpenDetailInfo(dts_Grid.getCellData(row, "ISUR_CD"), dts_Grid.getCellData(row, "CHRG_TP_CD"), dts_Grid.getCellData(row, "SEQ"), dts_Grid.getCellData(row, "DISCLS_BZ_CHRG_ASSGN_DD"));
    } else if (colid == 'REMK') {
        var acpt_no = dts_Grid.getCellData(row, "ACPT_NO");
        if (acpt_no != '') {
            $c.stf.fn_OpenDisclViewer(dts_Grid.getCellData(row, "ACPT_NO"), "R"); //(정정)공시일 컬럼 더블클릭시 관련 보고서 뷰잉

        }
    }
};
scwin.gform_onload = function() {
    //fn_HideDebugCtrls();
    $c.cm.PanelToGroupBox(panel_1);
    scwin.fn_SetCode();
    scwin.fn_Init();
    $c.cm.fn_com_isur(txb_isur_cd, txb_com_abbrv);
    if (scwin.gLdMktTp == '1') {
        //유가시에만 공시담당자1,공시담당자2 --> 공시담당자(정),공시담당자(부)로 변경
        var tmp = grd_List.Format;
        tmp = tmp.replace("공시담당자1", "공시담당자(정)");
        tmp = tmp.replace("공시담당자2", "공시담당자(부)");
        grd_List.Format = tmp;
    }
    scwin.fn_Search();
};
]]></script>

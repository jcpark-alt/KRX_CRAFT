//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.vScrenID = "ULDSTF32011.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_SetCodes = function() {
    dts_ETN_ISUR_CD.DataID = "/ETNInfo.do?method=listCompanyCd&For=R";
    dts_ETN_ISUR_CD.Reset();
};
scwin.fn_Search = function() {
    var url = "/ETNInfo.do?method=listETNPersonInCharge&ISUR_CD=" + $c.stf.getObjectValue(cmb_ETN_ISUR_CD);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
    if (dts_List.getTotalRow() > 0) {
        scwin.fn_readETNPersonInCharge(grd_List, 1, "ISUR_CD");
    } else {
        $c.stf.setObjectValue(txb_Corp_COM_NM, '');
        dts_Chrg1_Info.removeAll();
        dts_Chrg2_Info.removeAll();
        dts_Chrg3_Info.removeAll();
    }
};
scwin.fn_readETNPersonInCharge = function(GridID, row, colid) {
    if (row < 1) return;
    var objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..

    var vISUR_CD = objDataID.getCellData(row, "ISUR_CD");
    $c.stf.setObjectValue(txb_Corp_COM_NM, objDataID.getCellData(row, "COM_NM"));
    var url = "";

    // 공시책임자
    url = "/ETNInfo.do?method=readETNLPInfo&Flag=1&ISUR_CD=" + vISUR_CD;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Chrg1_Info.DataID = encodeURI(url);
    dts_Chrg1_Info.Reset();

    // 공시담당자1, 공시담당자
    url = "/ETNInfo.do?method=readETNLPInfo&Flag=2&ISUR_CD=" + vISUR_CD;
    dts_Chrg2_Info.DataID = encodeURI(url);
    dts_Chrg2_Info.Reset();

    // 공시담당자2, 공시담당자
    url = "/ETNInfo.do?method=readETNLPInfo&Flag=3&ISUR_CD=" + vISUR_CD;
    dts_Chrg3_Info.DataID = encodeURI(url);
    dts_Chrg3_Info.Reset();
};
scwin.fn_changeFormat = function() {
    var ar = new Array(txb_Chrg1_WORK_TM, txb_Chrg2_WORK_TM, txb_Chrg3_WORK_TM);
    for (var i = 0; i < ar.length; i++) {
        var bfVal = $c.stf.getObjectValue(ar[i]);
        if (bfVal != "") {
            var afVal = $c.stf.FormatDateEx(bfVal);
            $c.stf.setObjectValue(ar[i], afVal);
        }
    }
};
scwin.dts_Chrg3_Info_OnLoadCompleted = function(rowcount) {
    scwin.fn_changeFormat();
};
scwin.btn_Search_onclick = function() {
    scwin.fn_Search();
};
scwin.grd_List_OnClick = function(row, colid) {
    scwin.fn_readETNPersonInCharge(grd_List, row, colid);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
};
scwin.gform_onload = function() {
    //fn_HideDebugCtrls();
    $c.libRoundPanel.PanelToGroupBox(panel_1);
    scwin.fn_SetCodes();
    scwin.fn_Search();
};
]]></script>

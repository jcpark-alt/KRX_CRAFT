};X < !접수정보--;
데이타;
읽어오기-- > function() {
    var url = "/Viewer.do?method=getDsclHeaderBasic&inputMessageId=VIEWER_OUT&outputMessageId=VIEWER_OUT" + "&ACPT_NO=" + scwin.gAcptNo + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_AcptProcs.DataID = encodeURI(url);
    dts_AcptProcs.reset();
} < !공시사유--;
개별검색-- > function() {
    var url = "/DisclosureStatus.do?method=readDisclosureReserve&inputMessageId=DSCLRESERVELIST_OUT" + "&outputMessageId=DSCLRESERVELIST_OUT" + "&ACPT_NO=" + scwin.gAcptNo + "&DISCLS_PROCS_TP_CD=40";
    dts_ReservInfo.DataID = encodeURI(url);
    dts_ReservInfo.reset();
};
scwin.dts_AcptProcs_OnLoadCompleted = function(rowcount) {
    // *** 처리일시 타이틀 셋팅
    txb_ProcsStatDdtm_Title.setValue(txb_ProcsStatNm.getValue() + " 처리일시");
    scwin.gLdMktTpCd = dts_AcptProcs.getCellData(1, "LD_MKT_TP_CD");
    scwin.gRAcptNo = dts_ReservInfo.getCellData(1, "REDISCLS_ACPT_NO");
    if (scwin.gLdMktTpCd == '1') {
        txb_ReservTp.disable = true;
        $c.stf.showObj(label_noti, false);
    } else {
        txb_ReservTp.disable = false;
        $c.stf.showObj(label_noti, true);
    }
};
scwin.dts_ReservInfo_OnLoadCompleted = function(rowcount) {
    scwin.gRAcptNo = dts_ReservInfo.getCellData(1, "REDISCLS_ACPT_NO");
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.txb_rediscls_doc_title_onclick = function() {
    if (scwin.gRAcptNo != "") {
        $c.stf.fn_OpenDisclViewer(scwin.gRAcptNo, "R");
    }
};
scwin.gform_onload = function() {
    // 패널라운드 처리
    $c.libRoundPanel.PanelToGroupBox(pnl_1);
    scwin.fn_setParamData();

    // 가우스헤더 셋팅

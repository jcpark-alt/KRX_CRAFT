    //alert(gAcptNo);

    // 코스닥일 경우는 재공시여부 나타냄
    if (scwin.gDoc_LdMktTp == '2' || scwin.gDoc_LdMktTp == '6') {
        $c.stf.showObj(pnl_rediscl, true);
    } else {
        $c.stf.showObj(pnl_rediscl, false);

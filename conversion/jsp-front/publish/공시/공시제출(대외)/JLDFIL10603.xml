    							<xf:select1 ref="" submenuSize="auto" appearance="minimal" disabledClass="w2selectbox_disabled"
    								chooseOption="" disabled="false" style="width: 200px;" allOption="true" id="" renderType="" class="" direction="auto">
    								<xf:choices>
    									<xf:item>
    										<xf:label><![CDATA[new row]]></xf:label>
    										<xf:value></xf:value>
    									</xf:item>
    									<xf:item>
    										<xf:label><![CDATA[new row]]></xf:label>

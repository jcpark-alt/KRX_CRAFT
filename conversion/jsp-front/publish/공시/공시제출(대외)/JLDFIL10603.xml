    						<w2:attributes></w2:attributes>
    						<xf:group id="" class="flex flex_no">
    							<xf:input style="width:150px;" id="" placeholder="" class=""></xf:input>
    							<w2:textbox style="" id="" label="(20자 이하)" class="txt_info blue" escape="false"></w2:textbox>

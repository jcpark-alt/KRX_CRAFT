    			<w2:textbox class="" id="" label="증권표준코드의 도입배경" style="" tagname="h3"></w2:textbox>
    		</xf:group>
    		<w2:span id="" label="금융시장의 글로벌화로 인해 국제 증권거래가 증가하고 금융거래의 모든 과정이 전산시스템을 통해 처리됨에 따라, 매매, 결제, 관리 등의 편의를 도모하기 위해 표준화된 식별번호가 필요하게 되었습니다." meta_snippetCategory="10_입력폼" meta_snippetKeyComponent="true" meta_snippetName="10_16 출력텍스트"
    			style="">
    		</w2:span>
    		<xf:group class="titbox" id="" meta_snippetCategory="02_타이틀" meta_snippetKeyComponent="true" meta_snippetName="2_02 서브타이틀(h3)"

};

/********************************************** 
 * 함수명   : ins_search
 * 설명       : 발행기관 신청 상세정보
 ***********************************************/
scwin.ins_search = function() {
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=ULDINS91700_DETAIL_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.common.select.readCorpInfoReqViewInquiry" + "&{P}param01=" + txb_pISUR_APPL_ID.getValue();
    dts_detail.DataID = encodeURI(url);
    dts_detail.reset();
};


/********************************************** 
 * 함수명   : fn_GetParam
 * 설명       : 값 전달하기 위한 함수 
 ***********************************************/
scwin.fn_GetParam = function(arrPar) {
    scwin.arrPar[0] = txb_param1.getValue(); // txb_ISUR_CD.value; // 발행기관코드  
    scwin.arrPar[1] = txb_param2.getValue(); // txb_ISUR_NM.value; // 발행기관명    
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    scwin.arrPar, length;
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    $c.cm.PanelToGroupBox(panel_2);
    $c.cm.PanelToGroupBox(panel_3);
    //PanelToGroupBox(panel_4);   
    $c.cm.PanelToGroupBox(panel_5);
    $c.stf.showObj(txb_param1, false);
    $c.stf.showObj(txb_param2, false);
    $c.stf.showObj(panel_4, false);
    txb_pISUR_APPL_ID.focus();
    var arrPar = new Array();
    var parentWin = $c.frame.path("../");
    var fn_GetPar = parentWin.fn_GetParam;
    if (fn_GetPar != undefined) {
        fn_GetPar(scwin.arrPar);
        scwin.param1 = ((scwin.arrPar.length >= 1) && (scwin.arrPar[0] != undefined) ? scwin.arrPar[0] : "");
        txb_pISUR_APPL_ID.setValue(scwin.param1);
        scwin.ins_search();
    }
};
scwin.dts_detail_OnLoadError = function() {
    $c.stf.alert_error(dts_detail);
};
scwin.btn_search_onclick = function() {
    scwin.ins_search();
};
scwin.btn_close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_detail_OnLoadCompleted = function(rowcount) {
    var ISUR_CD = txb_ISUR_CD.getValue();
    //alert(ISUR_CD.substring(0,1));
    // 임시 발행기관은 발행기관 상세 불가 
    if (ISUR_CD.substring(0, 1) == "#") {
        btn_master.src = "../img/btn_master_d.gif";
        btn_master.setDisabled(true);
    } else {
        btn_master.src = "../img/btn_master.gif";
        btn_master.setDisabled(false);
    }
    // 미처리 , 반송된 대상은 첨부파일 선택불가 
    // 미처리된 대상 접수에서 확인하세요.
    if (txb_APPL_PROCS_TP_CD.getValue() == "미처리" || txb_APPL_PROCS_TP_CD.getValue() == "반송") {
        btn_file.src = "../img/btn_file_d.gif";
        btn_file.setDisabled(true);
    } else {
        btn_file.src = "../img/btn_file.gif";
        btn_file.setDisabled(false);
    }
};
scwin.btn_file_onclick = function() {
    if (txb_ISUR_CD.getValue() == "") return;
    /*
    txb_param1 에는 신청ID
    txb_param2 에는 구분값을 넣는데.. 
    	         + "1 : 발행기관신청, 팩스-발행기관신청 \n"
    			 + "2 : 표준코드신청, 팩스-표준코드신청 \n"
    			 + "3 : 팩스-다운로드IP 로 값을 넣어주세요.\n"
    			 */
    txb_param1.setValue(txb_ISUR_CD.getValue());
    txb_param2.setValue("1");
    fn_GetPar = fn_GetParam;
    ins_popupOpen("", "", "ULDINS91100", "첨부파일", "655", "350");
};
scwin.btn_master_onclick = function() {
    txb_param1.setValue(txb_ISUR_CD.getValue()); // 발행기관코드  
    txb_param2.setValue(txb_ISUR_NM.getValue()); // 발행기관명    

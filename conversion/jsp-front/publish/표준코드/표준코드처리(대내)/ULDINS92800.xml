scwin.ins_search = function() {
    //alert(param2); 
    var queryId = "";
    // 전자단기채권상세정보 상세팝업이다. 
    // param1 => 신청번호 STD_CD_APPL_ID
    // param2 => R 신청 / 마스터 구분 
    if (scwin.param2 == "R") {
        queryId = "lds.ins.common.select.readStdCdReqCpBndInfoViewInfo";
    } else {
        queryId = "lds.ins.common.select.readStdCdCpBndInfoViewInfo";
    }
    // 전자단기사채 정보 
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=ULDINS92800_DETAIL_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=" + queryId + "&{P}param01=" + txb_pSTD_CD_APPL_ID.getValue();
    dts_detail.DataID = encodeURI(url);
    dts_detail.reset();
    if (scwin.param2 == "R") {
        queryId = "lds.ins.common.select.listReqBndCreditValu1";
    } else {
        queryId = "lds.ins.common.select.listBndCreditValu1";
    }
    // 신용 평가기관 등급정보 
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=BNDCREDITVALUE_LIST_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=" + queryId + "&{P}param01=" + txb_pSTD_CD_APPL_ID.getValue();
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    $c.stf.showObj(label_11, false);
    $c.stf.showObj(txb_pSTD_CD_APPL_ID, false);
    $c.stf.showObj(txb_REF_CONTN, false);
    var arrPar = new Array();
    var parentWin = $c.frame.path("../");
    var fn_GetPar = parentWin.fn_GetParam;
    if (fn_GetPar != undefined) {
        fn_GetPar(arrPar);
        txb_pSTD_CD_APPL_ID.setValue(((arrPar.length >= 1) && (arrPar[0] != undefined) ? arrPar[0] : ""));
        scwin.param2 = ((arrPar.length >= 1) && (arrPar[1] != undefined) ? arrPar[1] : "");
        scwin.ins_search();
    }
};
scwin.dts_detail_OnLoadError = function() {

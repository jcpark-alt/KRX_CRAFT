scwin.ins_search = function() {
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamicName" + "&outputMessageId=ULDINS30000_LIST_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.search.select.listIssInstStdCdListInquiry" + "&{P}ISUR_CD=" + txb_pISUR_CD.getValue();
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid); // 그리드명을 표기

};
scwin.arrPar = new Array();
/********************************************** 
 * 함수명   : fn_GetParam
 * 설명       : 전달 값을 정의한다.
 ***********************************************/
scwin.fn_GetParam = function(arrPar) {
    scwin.arrPar[0] = txb_param1.getValue(); // ISUR_APPL_ID  
    scwin.arrPar[1] = ""; // R 신청 

    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    scwin.arrPar, length;
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        txb_TotalCnt.setValue("총 " + rowcount + "건");
    }

};
scwin.grd_Grid_OnDblClick = function(row, colid) {
    if (row == 0) return;
    var KND = dts_List.getCellData(row, "KND");
    var STD_CD = dts_List.getCellData(row, "STD_CD");
    if (KND == "지표" || KND == "선물옵션" || KND == "스트립") {
        txb_param1.setValue(dts_List.getCellData(row, "STD_CD"));
    } else {
        txb_param1.setValue(dts_List.getCellData(row, "STD_CD"));
    }
    fn_GetPar = fn_GetParam;
    ins_ViewIsuMaster(KND, STD_CD);
};
scwin.img_BND_CLSS_CD_ERASER_onclick = function() {
    txb_pISUR_CD.setValue("");

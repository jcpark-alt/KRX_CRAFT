 ***********************************************/
scwin.ins_search = function() {
    //데이터셋 초기화
    dts_List.removeAll();
    $c.cm.ShowWin(grd_Grid); // 그리드명을 표기

    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamicName" + "&outputMessageId=ULDINS26500_VIEW_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.download.select.listDownloadInfoInquiry" + "&{P}WRTR_NM=" + txb_pWRTR_NM.getValue() + "&{P}ENCRYP_EMAIL=" + txb_pENCRYP_EMAIL.getValue() + "&{P}COM_NM=" + txb_pCOM_NM.getValue() + "&{P}DNLD_INST_TP_CD=" + $c.stf.getObjectValue(cmb_pDNLD_INST_TP_CD) + "&{P}APPL_PROCS_TP_CD=" + $c.stf.getObjectValue(cmb_pAPPL_PROCS_TP_CD) + "&{P}WRT_DD_SDATE=" + edt_pWRT_DD_SDATE.getValue() + "&{P}WRT_DD_EDATE=" + edt_pWRT_DD_EDATE.getValue();
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
};



/********************************************** 
 * 함수명   : ins_process	
 * 설명       : 다운로드 관리저장 , 수정 한다. screenProcsTpCd 02,03
 ***********************************************/
scwin.ins_process = function(screenProcsTpCd) {
    if (screenProcsTpCd == '03') {
        // 수정

        dts_List.setCellData(dts_List.getRowPosition(), "CRDUSTATUS", $c.ut.cGetToday("yyyymmddhhmmss"));
        if (!confirm('다운로드 관리 내용을 처리완료 하시겠습니까?')) {
            return false;
        }
        trs_save.Action = "/DownLoadInfoAction.do?method=modifyDownLoadInfo" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + screenProcsTpCd;
        trs_save.KeyName = "toinb_dataid4";
        trs_save.KeyValue = "JSP(I:pInput=dts_List)";
        trs_save.Parameters = "EMP_NO=" + js_emp_no + ",EMP_NM=관리자,EMAIL=listing2@krx.co.kr";
        trs_save.Post();
    }
};




/********************************************** 
 * 함수명   : ins_process	
 * 설명       : 다운로드관리 반송처리 한다. screenProcsTpCd 02,03
 ***********************************************/
scwin.ins_retrun = function() {
    dts_List.setCellData(dts_List.getRowPosition(), "CRDUSTATUS", $c.ut.cGetToday("yyyymmddhhmmss"));
    if ($c.stf.getObjectValue(txb_RET_RSN) == "") {
        $c.win.alert($c.stf.getMessageParam("MSG-A005", "반송사유"));
        txb_RET_RSN.focus();
        return false;
    }
    if (!confirm('다운로드 관리 내용을 반송 하시겠습니까?')) {
        return false;
    }
    trs_save.Action = "/DownLoadInfoAction.do?method=returnDownLoadInfo" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_03;

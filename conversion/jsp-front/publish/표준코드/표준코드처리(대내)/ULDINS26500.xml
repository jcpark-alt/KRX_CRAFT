};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
    scwin.cnt = 0;
    $c.cm.CloseWin(0, grd_Grid); //데이터 로딩중닫기 및 조회없음 처리

    if (document.getElementById("btn_save")) {
        btn_save.setDisabled(true);
        btn_save.src = "../img/ins/btn_down_d.gif";
    }
    if (document.getElementById("btn_ret")) {
        btn_ret.setDisabled(true); // 반송
        btn_ret.src = "../img/ins/btn_Ret_d.gif";
    }
};
scwin.dts_List_OnRowPosChanged = function(row) {
    if (dts_List.getRowStatus(row) == 1) return;
    dts_List.undoRow(scwin.prevRow);
    scwin.prevRow = row;
    if (document.getElementById("btn_save")) {
        btn_save.setDisabled(false);
        btn_save.src = "../img/ins/btn_down.gif";
    }
    if (document.getElementById("btn_ret")) {
        btn_ret.setDisabled(false); // 반송
        btn_ret.src = "../img/ins/btn_Ret.gif";
    }
    var nRow = dts_List.getRowPosition();
    if (dts_List.getCellData(nRow, "APPL_PROCS_TP_CD") == "3") {
        btn_ret.setDisabled(true); // 반송
        btn_ret.src = "../img/ins/btn_Ret_d.gif";
    }
};

scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        txb_TotalCnt.setValue("총 " + rowcount + "건");
    }
    scwin.cnt = rowcount;
    $c.cm.CloseWin(rowcount, grd_Grid); //데이터 로딩중닫기 및 조회없음 처리

    if (document.getElementById("btn_save")) {
        btn_save.setDisabled(true);
        btn_save.src = "../img/ins/btn_down_d.gif";
    }
    if (document.getElementById("btn_ret")) {
        btn_ret.setDisabled(true); // 반송
        btn_ret.src = "../img/ins/btn_Ret_d.gif";
    }
};

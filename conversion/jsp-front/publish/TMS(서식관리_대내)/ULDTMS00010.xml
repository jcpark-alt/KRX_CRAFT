    						</xf:input>
    					</xf:group>
    					<xf:group id="" tagname="li">
    						<w2:textbox class="tit" id="" label="비밀번호" style="" tagname="label"></w2:textbox>
    						<xf:secret class="" ev:onkeyup="" id="" mandatory="true" nextTabID="" ref="" refSync="" style="" placeholder="비밀번호를 입력하세요"></xf:secret>
    					</xf:group>
    				</xf:group>
    				<xf:group class="login_btn" id="" style="">
    					<xf:trigger class="btn_login" ev:onclick="" id="" style="" type="button">
    						<xf:label><![CDATA[로그인]]></xf:label>
    					</xf:trigger>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    	</xf:group>

//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/mgt.js");
scwin.vScrenID = 'ULDMGT70100.xml';
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_SetCode = function() {
    var ToDay = new Date();
    scwin.setYear(ToDay);
    scwin.setMonth(ToDay);
};
scwin.setYear = function(ToDay) {
    var yyyy = parseInt(ToDay.getYear(), 10) + 20;
    var str = "";
    for (var i = yyyy; i >= 2007; i--) {
        str += i + "^" + i + ",";
    }
    str = str.substring(0, str.length - 1);
    cyear.CBData = str;
    cyear.setSelectedIndex(20);
};
scwin.setMonth = function(ToDay) {
    //alert(cmonth.ListCount);
    cmonth.setSelectedIndex(ToDay.getMonth());
};
scwin.fn_list_sync = function() {
    var url = "/calnd.do?method=searchCalNd&inputMessageId=calnd&outputMessageId=calnd&CALND_DD=" + cyear.getText() + cmonth.getText() + "%" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    MxDataSet.DataID = encodeURI(url);
    MxDataSet.reset();
    $c.cm.ShowWin(MxGrid_1);
};
scwin.fn_save = function() {
    MxLogicalTr.Action = "/calnd.do?method=saveCalNd&inputMessageId=calnd";
    MxLogicalTr.KeyName = "toinb_dataid4";
    MxLogicalTr.KeyValue = "JSP(I:pInput=MxDataSet)";
    MxLogicalTr.Post();
};
scwin.MxDataSet_OnLoadCompleted = function(rowcount) {
    textbox_1.setValue("총 " + rowcount + "건");
    $c.cm.CloseWin(rowcount, MxGrid_1);
};
scwin.gform_onload = function() {
    MxDataSet.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=calnd";
    MxDataSet.reset();
    //MxDataSet_code1.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=tbmccdval";
    //MxDataSet_code1.reset();
    $c.cm.PanelToGroupBox_01(panel_1);
    scwin.fn_SetCode();

    //fn_code1_sync();
    //toDaySet(txb_date);

};
scwin.btn_cal_onclick = function() {
    popUpCalendar(txb_date_bg, 'txb_date', 'yyyymmdd'); //alert('image_2.onclick');

};
scwin.btn_sys_search_onclick = function() {
    if (cyear.getText() != "" && cmonth.getText() != "") {
        scwin.fn_list_sync(); //alert();

    } else if (cyear.getText() == "") {
        $c.win.alert("년도를 지정하십시요");
        cyear.focus();
    } else if (cmonth.getText() == "") {
        $c.win.alert("월을 지정하십시요");
        cmonth.focus();
    }
};
scwin.btn_rollusr_save_onclick = function() {
    scwin.fn_save();
};
scwin.MxLogicalTr_OnFail = function() {
    $c.win.alert('저장을 실패했습니다');
};
scwin.MxLogicalTr_OnSuccess = function() {
    $c.win.alert('저장하였습니다');
    scwin.fn_list_sync();
};
]]></script>

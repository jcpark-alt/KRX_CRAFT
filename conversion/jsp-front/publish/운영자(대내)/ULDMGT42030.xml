};
scwin.onpageunload = function() {
};
scwin.fn_SetCode = function() {
    edt_FromDate.setValue($c.ut.cGetToday("yyyymmdd")); // 현재날짜

};
scwin.fn_Search = function() {
    // 일자 체크
    if (getObjectValue(edt_FromDate).length < 8) {
        $c.win.alert("접속일자 올바르게 입력하십시오.");
        edt_FromDate.focus();
        return;
    }
    btn_Search.setDisabled(true);
    btn_Search.src = "../img/btn_select_d.gif";
    var url = "/usrlog.do?method=listUsrScrenLog" + "&DATE_DD=" + getObjectValue(edt_FromDate) + "&CHKSCREN=" + scwin.getChkValue(chk_scren) + "&SYSTEM_ID=" + getObjectValue(cmb_LD_OPER_SYS_TP_CD) + "&USR_ID=" + getObjectValue(txb_INTEG_USR_ID) + "&SCREN_ID=" + getObjectValue(txb_SCREN_ID);
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.getChkValue = function(obj) {
    return (obj.checked) ? "Y" : "N";
};
scwin.btn_Search_onclick = function() {
    scwin.fn_Search();
};
scwin.btn_Excel_onclick = function() {
    $c.data.downloadGridViewExcel(grd_Grid, "접속로그", "", "8");
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        FillGridHeaderTotalCnt(rowcount, panel_page);
    }
    btn_Search.setDisabled(false);
    btn_Search.src = "../img/btn_select.gif";
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.dts_List_OnLoadError = function() {
    alert_error(dts_List);
    btn_Search.setDisabled(false);
    btn_Search.src = "../img/btn_select.gif";
    $c.cm.CloseWin('', grd_Grid);
};
scwin.img_FromCal_onclick = function() {
    popUpCalendar2(edt_FromDate);
};
scwin.gform_onload = function() {
    // 패널라운드 처리
    $c.cm.PanelToGroupBox(panel_1);
    scwin.fn_SetCode();
};

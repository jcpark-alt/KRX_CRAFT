scwin.vScrenID = "ULDSTF05400.xml";
scwin.vScrenTpCD = "";
scwin.clickBzProcsNo = "";
scwin.mktTpCd = "1";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
}; //거래시장구분 1= 유가, 2=코스닥

scwin.fn_GetPar = function(arrPar) {
    // 넘길 인수를 지정하는 펑션
    arrPar[0] = $c.stf.getObjectValue(txb_ISU_CD); // 코드값을 포함할 컨트롤
    arrPar[1] = $c.stf.getObjectValue(txb_ISU_NM); // 명칭값을 포함할 컨트롤
    arrPar[2] = $c.stf.getObjectValue(rdo_SECUGRP_ID);
    arrPar[3] = scwin.mktTpCd;
    arrPar[4] = SEARCH_TYP_SER;
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    arrPar, length;
};
scwin.fn_SetPar = function(arrPar) {
    txb_ISU_CD.setValue(arrPar[0].ISU_CD);
    txb_ISU_NM.setValue(arrPar[0].ISU_ENG_NM);
};
scwin.fn_setBzProcsNo = function(obj) {
    scwin.clickBzProcsNo = dts_List.getCellData(eval(obj), "BZ_PROCS_NO");
    //alert("fn_setBzProcsNo():"+clickBzProcsNo);

};
scwin.fn_getBzProcsNo = function() {
    return scwin.clickBzProcsNo;
};
scwin.fn_list_sync = function() {
    var url = "/Prelisting.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=listBenfcertPrelisting&inputMessageId=PREEXAM_SEARCH_OUT";
    url += "&LIST_LM_CD=" + $c.stf.getObjectValue(rdo_ListLMCd);
    url += "&SECUGRP_ID=" + $c.stf.getObjectValue(rdo_SECUGRP_ID);
    url += "&ISU_CD=" + $c.stf.getObjectValue(txb_ISU_CD);
    url += "&DATE_TYPE=" + $c.stf.getObjectValue(rdo_DateType);
    url += "&S_DATE=" + $c.stf.getObjectValue(edt_SDate);
    url += "&E_DATE=" + $c.stf.getObjectValue(edt_EDate);
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
    $c.cm.ShowWin(grd_List);
};


/********************************************** 
 * 함수명   : fn_ExcelDown()
 * 설명       : 정보를 excel로 다운 받는다.
 ***********************************************/
scwin.fn_ExcelDown = function() {
    if (dts_List.getTotalRow() > 0) {
        $c.data.downloadGridViewExcel(grd_List, "예비심사리스트", "", "3");
    } else {
        $c.win.alert("해당데이터가 없습니다. 조회후 다운받으십시요.");
    }
};
scwin.fn_OpenDetail = async function(row) {
    var secugrpId;
    if (row > 0) {
        //그리드에서 선택시
        scwin.fn_setBzProcsNo(row);
        secugrpId = dts_List.getCellData(row, 'SECUGRP_ID');
    } else {
        //신규버튼 선택시
        scwin.clickBzProcsNo = ""; //초기화
        secugrpId = $c.stf.getObjectValue(rdo_SECUGRP_ID);
    }
    await $c.frame.CreateDialogFrame("BNEFCERT_PREEXAM", "/lstproc/ULDSTF05401.gfm", $c.lc.fn_getSecuGrpNm(secugrpId) + " 예비심사관리", 200, 100, 560, 470, "window");
};
scwin.btn_Search_onclick = function() {
    if ($c.stf.compareFromToDate2(edt_SDate, edt_EDate)) {
        scwin.fn_list_sync();
    }
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_List);
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    scwin.fn_ExcelDown();
};
scwin.grd_List_OnDblClick = function(row, colid) {
    //if (colid=='COM_NM'){
    scwin.fn_OpenDetail(row);
    //}

};
scwin.btn_New_onclick = function() {
    scwin.fn_OpenDetail(-999);
};
scwin.btn_EDate_onclick = function() {
    popUpCalendar2(edt_EDate);
};
scwin.btn_SDate_onclick = function() {
    popUpCalendar2(edt_SDate);
};
scwin.btn_IsuSearch_onclick = function() {
    $c.lc.fn_PopFindExamIsu($c.stf.getObjectValue(rdo_SECUGRP_ID));
};
scwin.txb_ISU_CD_onblur = function() {
    if (txb_ISU_CD.getValue() == "") {

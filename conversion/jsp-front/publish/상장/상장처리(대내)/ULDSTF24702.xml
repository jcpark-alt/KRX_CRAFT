scwin.fn_list_sync = function() {
    var secuGrpId = "";
    if ($c.stf.getObjectValue(chb_Grp_St) == 'Y') secuGrpId += 'ST,';
    if ($c.stf.getObjectValue(chb_Grp_Mf) == 'Y') secuGrpId += 'MF,';
    if ($c.stf.getObjectValue(chb_Grp_Rt) == 'Y') secuGrpId += 'RT,';
    if ($c.stf.getObjectValue(chb_Grp_Sc) == 'Y') secuGrpId += 'SC,';
    if ($c.stf.getObjectValue(chb_Grp_Fs) == 'Y') secuGrpId += 'FS,';
    if ($c.stf.getObjectValue(chb_Grp_Dr) == 'Y') secuGrpId += 'DR,';
    if ($c.stf.getObjectValue(chb_Grp_If) == 'Y') secuGrpId += 'IF,';
    if ($c.stf.getObjectValue(chb_Grp_All) == ' Y') secuGrpId = '';

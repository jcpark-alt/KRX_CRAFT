scwin.contnId;
scwin.gLdMktTp = js_market;
scwin.bbsTypeCd = "4";
scwin.vScrenID = "ULDMGT07220.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_list_sync = function() {
    var url = "/lstinvstg/ListCommBoard.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=getList" + "&BBS_TP_CD=" + scwin.bbsTypeCd + "&LD_MKT_TP=" + $c.stf.getObjectValue(rdo_MKT_ID);
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.fn_setContnId = function(obj) {
    if (scwin.contnId != "input") {
        scwin.contnId = dts_List.getCellData(eval(obj), "CONTN_ID");
    }
};
scwin.fn_getContnId = function() {
    return scwin.contnId;
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.grd_Grid_OnDblClick = async function(row, colid) {
    if (colid == 'CONTN_TITLE') {
        scwin.fn_setContnId(row);
        await $c.frame.CreateDialogFrame("gform", "/lstinvstg/ULDSTF07221.gfm", "양식자료실 수정", 10, 10, 780, 630, "window");
        scwin.fn_list_sync();
    }
};
scwin.btn_new_onclick = async function() {
    scwin.contnId = "input";
    await $c.frame.CreateDialogFrame("gform", "/lstinvstg/ULDSTF07221.gfm", "양식자료실 신규", 10, 10, 780, 630, "window");
    scwin.contnId = "";
    scwin.fn_list_sync();
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.gform_onload = function() {
    $c.stf.setObjectValue(rdo_MKT_ID, scwin.gLdMktTp);
    if (js_market == "1" || js_market == "2") {
        rdo_MKT_ID.setDisabled(true);
    } else {
        rdo_MKT_ID.setDisabled(false);
    }
    $c.cm.PanelToGroupBox(panel_Top);
    scwin.fn_list_sync();
};
]]></script>

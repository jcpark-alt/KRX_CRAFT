    url += "&ISU_CD=" + $c.stf.getObjectValue(txb_ISU_CD);
    url += "&DISCLS_DD=" + $c.stf.getObjectValue(edt_Date);
    dts_List2.DataID = encodeURI(url);
    dts_List2.reset();
};

/*
	일괄등록
*/
scwin.fn_input = async function() {
    await $c.frame.CreateDialogFrame("ULDSTF05328", "/lstproc/ULDSTF05328.gfm", "합성ETF 신용등급/순자본비율 입력", 300, 200, 780, 445, "window");
};

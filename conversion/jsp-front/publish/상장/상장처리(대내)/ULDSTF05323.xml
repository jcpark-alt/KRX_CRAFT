    MaxTab_01.setSelectedTabIndex(1);
    scwin.fn_list_sync();
};


/*
	합성ETF 팝업호출
*/
scwin.fn_PopFindSynthEftIsu = async function() {
    await $c.frame.CreateDialogFrame("SYNTHETF_DLG_ISU_CD", "../lstproc/ULDSTF05016.gfm", "합성EFT종목선택", 30, 50, 420, 720, "window");
};
scwin.fn_list_sync = function() {
    /*
    	신용등급현황조회
    */
    var url = "/SynthEtfTrctptInfo.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listCreditGrade";
    url += "&inputMessageId=LISTCREDITGRADE_INOUT&outputMessageId=LISTCREDITGRADE_INOUT";
    url += "&ISU_CD=" + $c.stf.getObjectValue(txb_ISU_CD);
    url += "&DISCLS_DD=" + $c.stf.getObjectValue(edt_Date);
    dts_List1.DataID = encodeURI(url);
    dts_List1.reset();
    $c.cm.ShowWin(grd_List1);

    /*
    	영업용순자본비율 조회
    */

    var url = "/SynthEtfTrctptInfo.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listNetCapitalRatio";

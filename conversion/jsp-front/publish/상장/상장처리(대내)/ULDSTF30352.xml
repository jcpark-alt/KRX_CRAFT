		<script type="text/javascript" lazy="false"><![CDATA[
/* ★Wcraft guide★    
스크립트 수작업 유의사항
*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
scwin.contnId;
scwin.vScrenID = "ULDSTF30352.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_list_sync = function() {
    if (scwin.dateCheck() == false) {
        return;
    }
    var KeyWord = $c.cp.valueOfIndex(cmb_keyword, "VALUE", cmb_keyword.getSelectedIndex());
    var Condition1 = keyword.getValue();
    var SDate = edt_SDate.getValue();
    var EDate = edt_EDate.getValue();
    url = "/IRMgt.do?method=listInvestInfo&KeyWord=" + KeyWord + "&Condition1=" + Condition1 + "&SDate=" + SDate + "&EDate=" + EDate + "&MKT_ID=" + $c.stf.getObjectValue(rdo_mkt_gubun);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_noticeList.DataID = encodeURI(url);
    dts_noticeList.reset();
    $c.cm.ShowWin(MxGrid_2);
    scwin.contnId = "";
};
scwin.fn_setContnId = function(obj) {
    if (scwin.contnId != "input") {
        scwin.contnId = dts_noticeList.getCellData(eval(obj), "CONTN_ID");
    }
};
scwin.fn_getContnId = function() {
    return scwin.contnId;
};
scwin.dateCheck = function() {
    if (parseInt(edt_SDate.getValue(), '10') > parseInt(edt_EDate.getValue(), '10')) {
        $c.win.alert("[조회기간 시작일은 종료일보다 작아야 합니다.]다시 입력해주세요");
        edt_SDate.setValue($c.ut.cGetToday("yyyymmdd"));
        edt_EDate.setValue($c.ut.cGetToday("yyyymmdd"));
        return false;
    }
};
scwin.fn_Init = function() {
    $c.stf.setObjectValue(rdo_mkt_gubun, js_market);
    if (js_market == "9") {
        $c.stf.showObj(panel_mkt_gubun, true);
    } else {
        $c.stf.showObj(panel_mkt_gubun, false);
    }
};
scwin.cmb_PeriodTp_OnSelChange = function() {
    var vTp = $c.cp.valueOfIndex(cmb_PeriodTp, "VALUE", cmb_PeriodTp.getSelectedIndex());
    $c.stf.fn_setFromToDate(vTp, edt_SDate, edt_EDate);
};
scwin.dts_noticeList_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    if (rowcount <= 0) {
        dts_noticeList.removeAll();
    }
    $c.cm.CloseWin(rowcount, MxGrid_2); //데이터 로딩중닫기 및 조회없음 처리

};
scwin.MxGrid_2_OnDblClick = async function(row, colid) {
    if (colid == 'TITLE') {
        scwin.fn_setContnId(row);
        await $c.frame.CreateDialogFrame("gform", "/bizspt/ULDSTF30353.gfm", "투자유의안내 수정", 200, 100, 875, 530, "window");
        scwin.fn_list_sync();
    }
};
scwin.btn_Input_onclick = async function() {
    scwin.contnId = "input";
    await $c.frame.CreateDialogFrame("gform", "/bizspt/ULDSTF30353.gfm", "투자유의안내 등록", 200, 100, 875, 530, "window");
    scwin.fn_list_sync();
};
scwin.bnt_Select_onclick = function() {
    scwin.fn_list_sync();
};
scwin.icn_SCal_onclick = function() {
    popUpCalendar2(edt_SDate);
};
scwin.icn_ECal_onclick = function() {
    popUpCalendar2(edt_EDate);
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_Top);
    edt_SDate.setValue($c.ut.calcMonth($c.ut.cGetToday2(), -1));
    edt_EDate.setValue($c.ut.cGetToday2());
    scwin.fn_Init();
    scwin.fn_list_sync();
};
]]></script>

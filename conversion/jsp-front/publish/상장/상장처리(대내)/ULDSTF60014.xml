scwin.fr_MktId = $c.lc.fn_getMktId(); // 시장구분코드(유가, 코스닥) 전체), 기준은 로그인 사용자의 부서 소속을 기준으로 한다.
scwin.fn_GetPar, scwin.fn_SetPar;
// dialog 호출용 함수
// 발행기관목록관련
scwin.vScrenID = "ULDSTF60009.xml";
String.prototype.trim = function() {
    return this.replace(/(^\s*)|(\s*$)/gi, "");
};
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_list_sync = function() {
    var url = "/ListCaseWrtDtl.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listPrelmInvstgCase";
    url += "&LD_MKT_TP=" + $c.stf.getObjectValue(rdo_SPOT_ISU_TRD_MKT_TP_CD);
    url += "&COM_NM=" + $c.stf.getObjectValue(txb_COM_NM).trim(); // 회사명

    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_List);
};
scwin.fn_setBzProcsNo = function(obj) {
    scwin.clickBzProcsNo = dts_List.getCellData(eval(obj), "BZ_PROCS_NO");
};


//위원회안건작성 상세 팝업호출
scwin.fn_OpenInvstgCaseDtl = async function() {
    var url = "/lstmgt/ULDSTF60015.gfm";
    await $c.frame.CreateDialogFrame("ULDSTF60015.gfm", url, "상장심사 안건 작성", 50, 50, 680, 450, "window");
};
scwin.fn_Open = async function() {
    var url = "/lstmgt/JLDSTF60016.jsp?bzProcsNo=clickBzProcsNo";
    await $c.frame.CreateDialogFrame("JLDSTF60016.jsp", url, "상장심사 안건 작성", 50, 50, 660, 420, "window");

};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.img_Excel_onclick = function() {
    if (dts_List.getTotalRow() > 0) {
        //엑셀 로그 
        $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
        $c.data.downloadGridViewOffice(grd_List, "상장예비심사신청현황", "", 8, 0);
    } else {
        $c.win.alert(NO_EXCEL_DATA);
    }
};
scwin.grd_List_OnDblClick = function(row, colid) {
    if (row > 0) {
        //그리드에서 선택시
        scwin.fn_setBzProcsNo(row);
    }
    if ("COMITE_CASE_FILE_YN" == colid) {
        scwin.fn_OpenInvstgCaseDtl();
    }
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_List);
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_Top);
    if (js_market == "1" || js_market == "2") {
        $c.stf.setObjectValue(rdo_SPOT_ISU_TRD_MKT_TP_CD, js_market);
        $c.stf.showObj(panel_mkt_gubun, false);
    } else {
        $c.stf.showObj(panel_mkt_gubun, true);
    }
    scwin.fn_list_sync();
};
scwin.txb_COM_NM_onkeydown = function() {
    if (window.event.keyCode == 13) {
        scwin.fn_list_sync();
    }
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};

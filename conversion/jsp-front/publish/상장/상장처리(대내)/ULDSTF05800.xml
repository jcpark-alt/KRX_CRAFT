		<script type="text/javascript" lazy="false"><![CDATA[
/* ★Wcraft guide★    
스크립트 수작업 유의사항
*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
// 세션정보를 얻기위한 함수사용

scwin.vScrenID = "ULDSTF05800.xml";
scwin.fn_GetPar, scwin.fn_SetPar;
scwin.clickBzProcsNo = "";
scwin.vAcptNo = "";
scwin.fr_SecuGrpId = SECUGRP_ID_SR;
scwin.vOpenTyp = ""; // R=접수, H = 이력, N : 신규

scwin.pSecuGrpId = SECUGRP_ID_SR;
scwin.gIsurCd;
scwin.gComAbbrv;
scwin.gSecugrpId;
scwin.gMktTpCd;
scwin.vSPOT_ISU_TRD_MKT_TP_CD = "";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_GetParIsur = function(arrPar) {
    // 넘길 인수를 지정하는 펑션
    arrPar[0] = txb_ISUR_CD.getValue(); // 발행기관코드값
    arrPar[1] = txb_COM_NM.getValue(); // 발행기관명
    return arrPar.length;
};
scwin.fn_SetParIsur = function(arrPar) {
    var dbClickYn = arrPar[0].DBCLICKYN;
    if (dbClickYn == "Y") {
        txb_ISUR_CD.setValue(arrPar[0].ISUR_CD);
        txb_COM_NM.setValue(arrPar[0].COM_NM);
        scwin.vSPOT_ISU_TRD_MKT_TP_CD = arrPar[0].SPOT_ISU_TRD_MKT_TP_CD;
        scwin.fn_all_list_sync();
    }
};
scwin.fn_getBzProcsNo = function() {
    return scwin.clickBzProcsNo;
};
scwin.fn_all_list_sync = function() {
    scwin.fn_recv_list_sync();
    scwin.fn_list_sync();
};
scwin.fn_recv_list_sync = function() {
    if (scwin.vSPOT_ISU_TRD_MKT_TP_CD == "1") {
        // 유가경우
        $c.cm.setColumnProp(grd_Recv, "LIST_SCH_STRT_DD", "Show", false);
        var url = "/Listing.do";
        url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
        url += "&method=searchIsuIssChgList&DIV_IDX=" + DIV_IDX_NEW_ISS_SR_RECV_S + "&ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD);
        dts_Recv.DataID = encodeURI(url);
        dts_Recv.reset();
    } else if (scwin.vSPOT_ISU_TRD_MKT_TP_CD == "2") {
        // 코스닥인경우
        $c.cm.setColumnProp(grd_Recv, "LIST_SCH_STRT_DD", "Show", true);
        var url = "/Listing.do";
        url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
        url += "&method=searchIsuIssChgList" + "&DIV_IDX=" + DIV_IDX_NEW_ISS_SR_RECV_K + "&ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD);
        dts_Recv.DataID = encodeURI(url);
        dts_Recv.reset();
    }
};
scwin.fn_list_sync = function() {
    var url = "/Listing.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=searchIsuIssChgList&DIV_IDX=" + DIV_IDX_NEW_ISS_SWR_HIST + "&ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD) + "&SECUGRP_ID=" + scwin.pSecuGrpId;
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};
scwin.fn_setBzProcsNo = function(dsjObj, row) {
    scwin.clickBzProcsNo = dsjObj.getCellData(eval(row), "BZ_PROCS_NO");
    //alert("fn_setBzProcsNo():"+clickBzProcsNo);

};
scwin.fn_OpenDetailRecv = function(row) {
    scwin.vOpenTyp = "R";
    scwin.fn_setBzProcsNo(dts_Recv, row);
    scwin.vAcptNo = dts_Recv.getCellData(row, "ACPT_NO");
    if (scwin.vAcptNo != "") {
        scwin.fn_OpenPopup();
    }
};
scwin.fn_OpenDetailMng = function(row) {
    scwin.vAcptNo = ""; //초기화
    if (row > 0) {
        //그리드에서 선택시
        scwin.vOpenTyp = "H";
        scwin.fn_setBzProcsNo(dts_List, row);
    } else {
        //신규버튼 선택시
        scwin.vOpenTyp = "N";
        scwin.clickBzProcsNo = ""; //초기화

    }
    scwin.fn_OpenPopup();
};
scwin.fn_OpenPopup = async function() {
    await $c.frame.CreateDialogFrame("ULDSTF05711.gfm", "/lstproc/ULDSTF05801.gfm", "신주인수권증서 신주상장 관리", 200, 200, 870, 450, "window");
};
scwin.btn_Search_onclick = function() {
    if ($c.stf.getObjectValue(txb_ISUR_CD) == "") {
        $c.win.alert("[회사]를 선택하세요.");
        txb_ISUR_CD.focus();
        return;
    } else {
        scwin.fn_all_list_sync();
    }
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    $c.data.downloadGridViewExcel(grd_List, "신주인수권증권 발행내역", "", "8");
};
scwin.img_COM_NM_onclick = function() {
    scwin.fn_GetPar = fn_GetParIsur;
    scwin.fn_SetPar = fn_SetParIsur;

    //"1" :신주상장, "2" :변경상장
    $c.lc.fn_PopFindCorpChrgSW(scwin.fr_SecuGrpId, "1");
};
scwin.btn_New_onclick = function() {
    if ($c.stf.getObjectValue(txb_ISUR_CD) == "") {
        $c.win.alert("[회사]를 선택하세요.");
        txb_ISUR_CD.focus();
        return;
    }
    scwin.fn_OpenDetailMng(-1);
};
scwin.grd_Recv_OnDblClick = function(row, colid) {
    $c.elw.fn_OpenDetailRecv(row);
};
scwin.grd_List_OnDblClick = function(row, colid) {
    scwin.fn_OpenDetailMng(row);
};
scwin.dts_Recv_OnLoadError = function() {
    $c.stf.alert_error(dts_Recv);
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_Recv_OnLoadCompleted = function(rowcount) {
    $c.stf.setObjectValue(edt_TotalCnt_1, "총 " + dts_Recv.getTotalRow() + " 건");
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.setObjectValue(edt_TotalCnt_2, "총 " + dts_List.getTotalRow() + " 건");
    dts_List.setRowPosition(dts_List.getTotalRow(), 0);
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_Top);
    var parentWin = $c.lc.fn_GetRecvDocProvider();
    //var parentWin = frame.Provider("../");
    //alert('[parentWin]'+parentWin);
    if (scwin.gIsurCd != "" && scwin.gIsurCd != undefined) {
        txb_ISUR_CD.setValue(scwin.gIsurCd);
        txb_COM_NM.setValue(scwin.gComAbbrv);
        scwin.fr_SecuGrpId = scwin.gSecugrpId;
        scwin.vSPOT_ISU_TRD_MKT_TP_CD = scwin.gMktTpCd;
        btn_Search.trigger("onclick");
    }
};
]]></script>

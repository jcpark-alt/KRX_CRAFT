//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gBzProcsNo;
scwin.gListStatCd;
scwin.vScrenID = "ULDSTF21502.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_list_sync = function() {
    var vMarketTpCd = "";
    if (js_market == "1" || js_market == "2" || js_market == "6") {
        vMarketTpCd = js_market;
    } else {
        vMarketTpCd = $c.stf.getObjectValue(rdo_MARKET_TP_CD);
    }
    var url = "/listingCommon.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=listGeneral" + "&outputMessageId=LIST_TREASURYSTOCK_LIST_OUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstsrch.listSearchTreasury.tabthree.select.condition" + "&{P}param01=" + $c.stf.getObjectValue(edt_SDate) + // 시작일자
        "&{P}param02=" + vMarketTpCd + // 시장구분
        "&{P}param03=" + vMarketTpCd; // 시장구분

    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_List);
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07); // 엑셀
    $c.data.downloadGridViewExcel(grd_List, "자사주누적체결량 관리대상종목", "", "8");
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_List);
};
scwin.btn_Close_onclick = function() {
    self.close();
};
scwin.btn_SDate_onclick = function() {
    popUpCalendar2(edt_SDate);
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_Top);
    var vCurDate = $c.ut.cGetToday("yyyymmdd");
    edt_SDate.setValue($c.ut.cGetMinusDate2(vCurDate, 1)); // 전 날짜

    if (js_market == "1" || js_market == "2" || js_market == "6") {
        $c.cm.setColumnProp(grd_List, "TR_MKT_NM", "Show", false);
        $c.stf.showObj(panel_mkt_gubun, false);
    } else {
        $c.stf.showObj(panel_mkt_gubun, true);
    }
    scwin.fn_list_sync();
};
]]></script>

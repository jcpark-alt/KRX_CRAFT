scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_Top);
    getId = $c.frame.path("../").fn_getId;
    scwin.params = getId();

    //alert("11111=="+cGetDifTodayInputday('20160101','20160102'));

    if (scwin.params[2] == '2') {
        // 코스닥이면
        var strANULFEE_EXMPT_YN = "Y^Y,E^Y(일부면제),N^N";
        cmb_ANULFEE_EXMPT_YN.CBData = strANULFEE_EXMPT_YN;
    } else {
        var strANULFEE_EXMPT_YN = "Y^Y,N^N";
        cmb_ANULFEE_EXMPT_YN.CBData = strANULFEE_EXMPT_YN;
    }
    scwin.fn_read();

    //코스닥이면서 외국주권일 경우, 환율를 입력할 수 있다. 20100106  - params[2] == "2" 
    //(3393)유가도 환율정보를 입력할 수 있도록 함.2011.03
    if (dts_yearAssessmentFee.getCellData(1, "SECUGRP_ID") == "FS") {
        $c.stf.showObj(panel_APPL_EXCHRT, true);
    } else {
        $c.stf.showObj(panel_APPL_EXCHRT, false);
    }
    var basYear = 2014;
    if (parseInt(scwin.params[1]) >= basYear && scwin.params[2] == '2') {
        $c.stf.showObj(txb_CAP, false);
        $c.stf.showObj(lbl_CAP, false);
        $c.stf.showObj(txb_AVG_MKTCAP, true);
        $c.stf.showObj(lbl_AVG_MKTCAP, true);
    } else {
        $c.stf.showObj(txb_CAP, true);
        $c.stf.showObj(lbl_CAP, true);
        $c.stf.showObj(txb_AVG_MKTCAP, false);
        $c.stf.showObj(lbl_AVG_MKTCAP, false);
    }
};

        url += "&BAS_YY=" + scwin.params[1];
        url += "&MKT_ID=" + scwin.params[2];
        url += "&ANULFEE_NOTI_IMPOST_NO=" + scwin.params[3];
        url += "&ANULFEE_EXMPT_YN=" + cmb_ANULFEE_EXMPT_YN.BindColVal;
        cmb_ANULFEE_EXMPT_YN;
        trs_Update.Action = encodeURI(url);
        trs_Update.KeyValue = "JSP(I:pInput=dts_yearAssessmentFee)";
        trs_Update.Post();
    }
};

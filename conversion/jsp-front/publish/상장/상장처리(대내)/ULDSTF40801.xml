scwin.fn_read = function() {
    var url = "/YearAssessmentFeeManagement.do?method=readYearAssessmentFee&inputMessageId=YEAR_ASSESSMENT_FEE_READ_INOUT&outputMessageId=YEAR_ASSESSMENT_FEE_READ_INOUT";
    url += "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&ISUR_CD=" + scwin.params[0];
    url += "&BAS_YY=" + scwin.params[1];
    url += "&MKT_ID=" + scwin.params[2];
    url += "&ANULFEE_NOTI_IMPOST_NO=" + scwin.params[3];
    dts_yearAssessmentFee.DataID = encodeURI(url);
    dts_yearAssessmentFee.reset();
    if (cmb_ANULFEE_EXMPT_YN.BindColVal == "E") {
        $c.stf.showObj(panel_EXMPT, true);
    } else {
        $c.stf.showObj(panel_EXMPT, false);
    }
};
scwin.fn_update = function() {
    if (cmb_ANULFEE_EXMPT_YN.BindColVal == "N") {
        if (txb_ANULFEE_EXMPT_RSN_DSC.getValue() != "") {
            $c.win.alert("[면제여부]가 'N'일경우 입력하실 수 없습니다.");
            txb_ANULFEE_EXMPT_RSN_DSC.setValue("");
            return;
        }
    }
    if (!$c.stf.checkMaxLength(txb_ANULFEE_EXMPT_RSN_DSC, 200, "면제사유")) {
        txb_ANULFEE_EXMPT_RSN_DSC.setValue("");
        txb_ANULFEE_EXMPT_RSN_DSC.focus();
        return false;
    }
    if (cmb_ANULFEE_EXMPT_YN.BindColVal != "E") {
        $c.stf.setObjectValue(edt_ANULFEE_EXMPT_STRT_DD, "");
        $c.stf.setObjectValue(edt_ANULFEE_EXMPT_END_DD, "");
    } else {
        if ($c.ut.cIsNull(edt_ANULFEE_EXMPT_STRT_DD)) {
            $c.win.alert("면제기간 시작일자를 입력해 주세요.");
            edt_ANULFEE_EXMPT_STRT_DD.focus();
            return false;
        }
        if ($c.ut.cIsNull(edt_ANULFEE_EXMPT_END_DD)) {
            $c.win.alert("면제기간 종료일자를 입력해 주세요.");
            edt_ANULFEE_EXMPT_END_DD.focus();
            return false;
        }
        if ($c.stf.getObjectValue(edt_ANULFEE_EXMPT_STRT_DD) > $c.stf.getObjectValue(edt_ANULFEE_EXMPT_END_DD)) {
            $c.win.alert("면제기간 종료일자는 면제기간시작일자보다 커야합니다.");
            edt_ANULFEE_EXMPT_STRT_DD.focus();
            return false;
        }
    }
    var rtn = confirm('내용을 수정 하시겠습니까?');
    if (rtn == 1) // [확인] 버튼이 눌려졌을 경우

    {
        var url = "/YearAssessmentFeeManagement.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_03 + "&method=updateYearAssessmentFee";

        cnm: "cmb_SKIL_VALU_PROG_STAT_CD"
    }];
    var objCod;
    var url = "/CodeAction.do?method=listCodeValueNameM&inputMessageId=CODE_M_IN&outputMessageId=CODE_M_OUT" + "&CD_ID_M='SKIL_VALU_PROG_STAT_CD'";

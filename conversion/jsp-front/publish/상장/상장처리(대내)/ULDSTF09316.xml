scwin.fn_SetParIsuCd = function(arrPar) {
    var dbClickYn = arrPar[0].DBCLICKYN;
    if (dbClickYn == "Y") {
        txb_ISU_CD.setValue(arrPar[0].ISU_CD);
        txb_ISU_NM.setValue(arrPar[0].ISU_KOR_NM);
        scwin.vIsurCd = arrPar[0].ISUR_CD;
        btn_Search.trigger("onclick");
    }
};
scwin.fn_all_list_sync = function() {
    scwin.fn_recv_list_sync();
    scwin.fn_list_sync();
};
scwin.fn_recv_list_sync = function() {
    var url = "/pf/PfLstinvstg.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=searchIsuNmChgList&DIV_IDX=" + DIV_IDX_ISU_NM_PF_RECV_LIST + "&SECUGRP_ID=" + scwin.fr_SecuGrpId;
    dts_Recv.DataID = encodeURI(url);
    dts_Recv.reset();
};
scwin.fn_list_sync = function() {
    var url = "/pf/PfLstinvstg.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=searchIsuNmChgList&DIV_IDX=" + DIV_IDX_ISU_NM_PF_HIST_LIST + "&ISU_CD=" + $c.stf.getObjectValue(txb_ISU_CD);
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};
scwin.fn_bok_list_sync = function() {
    var url = "/pf/PfLstinvstg.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=searchIsuNmChgList&DIV_IDX=" + DIV_IDX_PF_BOK_RECV_LIST;

    MaxTab_01.setSelectedTabIndex(1);
    $c.libRoundPanel.PanelToGroupBox(panel_Top);
    scwin.vSYMBL_INPUT_CD = js_market;
    scwin.fn_setComponentSymbl();
    scwin.fn_recv_list_sync();
};

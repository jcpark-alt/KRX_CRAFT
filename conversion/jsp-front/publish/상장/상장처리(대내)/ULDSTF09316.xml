    if (MaxTab_01.getSelectedTabIndex() == 1) {
        scwin.fn_all_list_sync();
    } else if (MaxTab_01.getSelectedTabIndex() == 2) {
        scwin.fn_bok_list_sync();
    }
    // jackal_11.05.12
    else if (MaxTab_01.getSelectedTabIndex() == 3) {
        fn_bok_list_tuja_sync();
    }
};
scwin.btn_Excel_onclick = function() {
    if (MaxTab_01.getSelectedTabIndex() == 1) {
        $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
        $c.data.downloadGridViewExcel(grd_List, "종목명변경 내역", "", "8");
    } else if (MaxTab_01.getSelectedTabIndex() == 2) {
        $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
        $c.data.downloadGridViewExcel(grd_Bok_Recv, "원부변경 내역", "", "8");

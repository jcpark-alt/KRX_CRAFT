    await $c.frame.CloseFrame();
};
scwin.MaxTab_01_OnSelChanged = function(nIndex) {
    var rCnt = '';
    if (nIndex == '1') {
        $c.stf.showObj(panel_New, true);
        rCnt = dts_List.getTotalRow();
    } else if (nIndex == '2') {
        $c.stf.showObj(panel_New, false);
        rCnt = dts_Bok_Recv.getTotalRow();
    }
    // jackal_11.05.12
    else if (nIndex == '3') {
        $c.stf.showObj(panel_New, false);
        rCnt = dts_Bok_Recv_Tuja.getTotalRow();
    }
    $c.stf.FillGridHeaderTotalCnt(rCnt, panel_page);
};

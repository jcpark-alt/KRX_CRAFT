};
scwin.fn_OpenDetailRecv = function(row) {
    scwin.vOpenTyp = "R";
    scwin.clickBzProcsNo = ""; //초기화
    scwin.vAcptNo = dts_Recv.getCellData(row, "ACPT_NO");
    scwin.vIsurCd = dts_Recv.getCellData(row, "ISUR_CD");
    scwin.clickBzProcsNo = dts_Recv.getCellData(row, "BZ_PROCS_NO");
    scwin.fn_OpenPopup();
};
scwin.fn_OpenDetailMng = function(row) {
    scwin.vAcptNo = ""; //초기화
    if (row > 0) {
        //그리드에서 선택시
        scwin.vOpenTyp = "H";
        scwin.fn_setBzProcsNo(row);
    } else {
        //신규버튼 선택시
        scwin.vOpenTyp = "N";
        scwin.clickBzProcsNo = ""; //초기화

    }
    scwin.fn_OpenPopup();
};
scwin.fn_OpenDetailBokRecv = async function(row) {
    scwin.clickBokRow = row;
    await $c.frame.CreateDialogFrame("ULDSTF09318.gfm", "/pf/ULDSTF09318.gfm", "원부변경 관리", 200, 200, 665 + 25, 390 + 50, "window");
};
scwin.fn_OpenPopup = async function() {
    await $c.frame.CreateDialogFrame("ULDSTF09317.gfm", "/pf/ULDSTF09317.gfm", "종목명변경 관리", 200, 200, 942 + 35, 250 + 60, "window");
};
scwin.fn_setBzProcsNo = function(obj) {
    scwin.clickBzProcsNo = dts_List.getCellData(eval(obj), "BZ_PROCS_NO");
    scwin.vIsurCd = dts_List.getCellData(eval(obj), "ISUR_CD");
    //alert("fn_setBzProcsNo():"+clickBzProcsNo);


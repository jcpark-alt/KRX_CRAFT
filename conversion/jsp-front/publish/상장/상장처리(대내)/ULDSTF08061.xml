//초기화
scwin.fn_init = function() {
    var dateTmp = $c.ut.cGetToday("yyyymmdd");
    $c.stf.setObjectValue(cmb_month1, dateTmp.substring(4, 6));
    $c.stf.setObjectValue(cmb_month2, dateTmp.substring(4, 6));
    $c.stf.setObjectValue(cmb_month3, dateTmp.substring(4, 6));
    $c.stf.setObjectValue(cmb_month4, dateTmp.substring(4, 6));
    $c.stf.setObjectValue(cmb_month5, dateTmp.substring(4, 6));
    $c.stf.setObjectValue(cmb_month6, dateTmp.substring(4, 6));

    //기준년 (콤보박스)
    var urlYear = "/ElwNcr.do?method=selectElwNcrYear&inputMessageId=ELW_NCR_YEAR_INOUT";
    dts_year1.DataID = encodeURI(urlYear);
    dts_year1.reset();
    dts_year2.DataID = encodeURI(urlYear);
    dts_year2.reset();
    dts_year3.DataID = encodeURI(urlYear);
    dts_year3.reset();
    dts_year4.DataID = encodeURI(urlYear);
    dts_year4.reset();
    dts_year5.DataID = encodeURI(urlYear);
    dts_year5.reset();
    dts_year6.DataID = encodeURI(urlYear);
    dts_year6.reset();
    dts_inst.DataID = "/etn/EtnCodeAct.do?method=listIsurCd&For=R";
    dts_inst.Reset();
    dts_lp.DataID = "/etn/EtnCodeAct.do?method=listLPCd&For=R";
    dts_lp.Reset();
    dts_srty.DataID = "/etn/EtnCodeAct.do?method=listSrtyCd&For=R";
    dts_srty.Reset();
    cmb_inst_lp.ComboDataID = "dts_inst";
    scwin.fn_change_gubun1("1");
    scwin.fn_change_gubun2("1");
};


//데이타 가져와서 뿌리기 List
scwin.fn_list_sync1 = function() {
    var url = "/etn/EtnStatMgt.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=searchIsurLpNcrDetailList";
    url += "&inputMessageId=ETN_ISUR_LP_NCR_INOUT&outputMessageId=ETN_ISUR_LP_NCR_INOUT";
    if (rdo_gubun1.getValue() == "1") {
        if (cmb_instlp_select1.BindColVal == "01") url += "&GUBUN=isur";

        else url += "&GUBUN=lp";
        url += "&FROM_YYMM=" + cmb_year1.BindColVal + cmb_month1.BindColVal;
        $c.cm.setColumnProp(grid_list1, 'NCR_PRE1', 'Show', true);
        $c.cm.setColumnProp(grid_list1, 'NCR_PRE2', 'Show', true);
    } else {
        if (cmb_instlp_select2.BindColVal == "01") url += "&GUBUN=isur";

        else url += "&GUBUN=lp";
        url += "&FROM_YYMM=" + cmb_year2.BindColVal + cmb_month2.BindColVal;
        url += "&TO_YYMM=" + cmb_year3.BindColVal + cmb_month3.BindColVal;
        url += "&ISUR_LP_CD=" + cmb_inst_lp.BindColVal;
        $c.cm.setColumnProp(grid_list1, 'NCR_PRE1', 'Show', false);
        $c.cm.setColumnProp(grid_list1, 'NCR_PRE2', 'Show', false);
    }
    dts_list_1.DataID = encodeURI(url);
    dts_list_1.reset();
    $c.cm.ShowWin(grid_list1);
};
scwin.fn_list_sync2 = function() {
    var url = "/etn/EtnStatMgt.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=searchSrtyCapRatioDetailList";
    url += "&inputMessageId=ETN_SRTY_CAP_RATIO_INOUT&outputMessageId=ETN_SRTY_CAP_RATIO_INOUT";
    if (rdo_gubun2.getValue() == "1") {
        url += "&FROM_YYMM=" + cmb_year4.BindColVal + cmb_month4.BindColVal;
        $c.cm.setColumnProp(grid_list2, 'CAP_RTO_PRE1', 'Show', true);
        $c.cm.setColumnProp(grid_list2, 'CAP_RTO_PRE2', 'Show', true);
    } else {
        url += "&FROM_YYMM=" + cmb_year5.BindColVal + cmb_month5.BindColVal;
        url += "&TO_YYMM=" + cmb_year6.BindColVal + cmb_month6.BindColVal;
        url += "&SRTY_CD=" + cmb_srty.BindColVal;
        $c.cm.setColumnProp(grid_list2, 'CAP_RTO_PRE1', 'Show', false);
        $c.cm.setColumnProp(grid_list2, 'CAP_RTO_PRE2', 'Show', false);
    }
    dts_list_2.DataID = encodeURI(url);
    dts_list_2.reset();
    $c.cm.ShowWin(grid_list2);
};
scwin.fn_change_gubun1 = function(gubun) {
    if (gubun == "1") {
        cmb_instlp_select1.setDisabled(true);
        cmb_year1.setDisabled(true);
        cmb_month1.setDisabled(true);
        cmb_instlp_select2.setDisabled(true);
        cmb_inst_lp.setDisabled(true);
        cmb_year2.setDisabled(true);
        cmb_month2.setDisabled(true);
        cmb_year3.setDisabled(true);
        cmb_month3.setDisabled(true);
    } else if (gubun == "2") {
        cmb_instlp_select1.setDisabled(true);
        cmb_year1.setDisabled(true);
        cmb_month1.setDisabled(true);
        cmb_instlp_select2.setDisabled(true);
        cmb_inst_lp.setDisabled(true);
        cmb_year2.setDisabled(true);
        cmb_month2.setDisabled(true);
        cmb_year3.setDisabled(true);
        cmb_month3.setDisabled(true);
    }
};
scwin.fn_change_gubun2 = function(gubun) {
    if (gubun == "1") {
        //cmb_instlp_select1.Enable2="true";
        cmb_year4.setDisabled(true);
        cmb_month4.setDisabled(true);
        cmb_srty.setDisabled(true);
        //cmb_instlp_select2.Enable2="false";
        //cmb_inst_lp.Enable2="false";
        cmb_year5.setDisabled(true);
        cmb_month5.setDisabled(true);
        cmb_year6.setDisabled(true);
        cmb_month6.setDisabled(true);
    } else if (gubun == "2") {
        //cmb_instlp_select1.Enable2="false";
        cmb_year4.setDisabled(true);
        cmb_month4.setDisabled(true);
        cmb_srty.setDisabled(true);
        //cmb_instlp_select2.Enable2="true";
        //cmb_inst_lp.Enable2="true";
        cmb_year5.setDisabled(true);
        cmb_month5.setDisabled(true);
        cmb_year6.setDisabled(true);
        cmb_month6.setDisabled(true);
    }
};




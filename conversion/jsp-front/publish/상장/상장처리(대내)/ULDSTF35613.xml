//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/calendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
// 상장관련공통함수
//★Wcraft guide★ include부분 주석처리 -> include("../js/stockSearch.js");
scwin.vScrenID = "ULDSTF35613.xml";
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_SetCode = function() {
    dts_DepCd.DataID = "/AdminAndDlstedDetection.do?method=getComboList&For=DR&outputMessageId=AADD_OUT_COMBO";
    dts_DepCd.Reset();
    dts_EmpNo.DataID = "/AdminAndDlstedDetection.do?method=getComboList&For=ER&outputMessageId=AADD_OUT_COMBO";
    dts_EmpNo.Reset();
};


// 종류주식 주주수요건 검색 
scwin.fn_list_sync = function() {
    var isu_cd = txb_ISU_CD.getValue();
    var team_cd = $c.cp.valueOfIndex(cmb_dep_cd, "VALUE", cmb_dep_cd.getSelectedIndex());
    var charge_id = $c.cp.valueOfIndex(cmb_emp_no, "VALUE", cmb_emp_no.getSelectedIndex());
    var url = "/AdminAndDlstedDetection.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=getStockList&For=KCD&inputMessageId=AADD_IN&outputMessageId=AADD_OUT_KCD&ISU_CD=" + isu_cd + "&TEAM_CD=" + team_cd + "&CHARGE_ID=" + charge_id;
    dts1.DataID = encodeURI(url);
    dts1.reset();
    $c.cm.ShowWin(grd_corp_dtl); // 그리드명을 표기

};
scwin.dts1_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_corp_dtl); //데이터 로딩중닫기 및 조회없음 처리

};
scwin.dts1_OnLoadError = function() {
    $c.stf.alert_error(dts1);
    $c.cm.CloseWin(0, grd_corp_dtl); //데이터 로딩중닫기 및 조회없음 처리

};
scwin.cmb_dep_cd_OnSelChange = function() {
    scwin.gDepCd = $c.cp.valueOfIndex(cmb_dep_cd, "VALUE", cmb_dep_cd.getSelectedIndex());
    dts_EmpNo.UseFilter = true;
    dts_EmpNo.Filter();
    cmb_emp_no.ComboDataID = "dts_EmpNo";
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.txb_ISU_CD_onblur = function() {
    if (txb_ISU_CD.getValue() == "") {
        txb_ISU_NM.setValue("");
    }
};
scwin.img_ISU_NM_onclick = function() {
    $c.stockSearch.JongmokSearch(txb_ISU_CD, txb_ISU_NM, SECUGRP_ID_ST, js_market, "A");
};
scwin.dts_EmpNo_OnFilter = function(row) {
    //  부서코드에  해당하는 사원을 가져온다.
    if (scwin.gDepCd == "%") {
        // 전체일 경우 모두 보여준다.
        return true;
    } else {
        //alert(dts_EmpNo.NameValue(row, "DEP_CD") );
        if (dts_EmpNo.getCellData(row, "DEP_CD") == scwin.gDepCd ||
            dts_EmpNo.getCellData(row, "DEP_CD") == "") {
            return true;
        } else {
            return false;
        }
    }
};
scwin.btn_Excel_onclick = function() {
    $c.data.downloadGridViewExcel(grd_corp_dtl, "종류주식-주주수 요건", "", "8");
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.gform_onload = function() {
    scwin.fn_SetCode();
};
]]></script>

};
scwin.edt_BfhgIsuAmt_OnKillFocus = function() {
    edt_BfhgIsuAmt.RightMargin = 5;
};
scwin.dts_DtlInfo_OnColumnChanged = function(row, colid) {
    if (colid == "EXER_AMT") {
        /** 최초행사금액(화면 자동 계산) */
        if (scwin.vBndListProcsTpCd = 2) {
            $c.stf.setObjectValue(edt_AfhgIsuAmt, Number($c.stf.getObjectValue(edt_BfhgIsuAmt)) - Number($c.stf.getObjectValue(edt_ExerAmt)));
            $c.stf.setObjectValue(edt_AfchgListAmt, Number($c.stf.getObjectValue(edt_BfchgListAmt)) - Number($c.stf.getObjectValue(edt_ExerAmt)));
        }
    }
};

    scwin.vDtlInfoRowCount = rowcount;
    edt_StkRelCorpbndExerPrc.RightMargin = 5;
    edt_ExerAmt.RightMargin = 5;
    edt_BfhgIsuAmt.RightMargin = 5;
    edt_AfhgIsuAmt.RightMargin = 5;
    edt_BfchgListAmt.RightMargin = 5;
    edt_AfchgListAmt.RightMargin = 5;
    edt_NewIsuAmt.RightMargin = 5;
    edt_NewListAmt.RightMargin = 5;
};
scwin.img_StrtDd_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    popUpCalendar2(edt_StrtDd);
};
scwin.img_BasIsuNm_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    if (dts_DtlInfo.getCellData(1, "BFCHG_ISUR_NM") == '') return;
    scwin.fn_GetPar = fn_GetBasNm;
    scwin.fn_SetPar = fn_SetBasNm;
    $c.bns.fn_PopBndBasNmSearch(lbl_BndApplId);
};
scwin.btn_Attach_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    if ("N" == dts_DtlInfo.getCellData(1, "HAS_ATTACH_DOC")) {
        $c.win.alert("연결된 팩스/첨부문서가 없습니다.");
        return;
    }
    scwin.fn_GetPar = fn_GetCommonKey;
    $c.bns.fn_PopAttachDocSearch(lbl_BndApplId);
};
scwin.btn_Dtl_Bfchg_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    scwin.fn_GetPar = fn_GetParIsuDelInfo;
    $c.bns.fn_PopIsuDetail(lbl_BndApplId);
};
scwin.btn_Dtl_Div_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    if (scwin.vBndListProcsTpCd != 2) return;
    if (dts_DtlInfo.getCellData(dts_DtlInfo.getRowPosition(), "BND_NEW_ISU_CD") != '') {
        scwin.fn_GetPar = fn_GetParDivIsuDelInfo;
        scwin.fn_PopDetailDiv(lbl_BndApplId);
    } else {
        $c.win.alert("종목이 생성되지 않았습니다.");
    }
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};

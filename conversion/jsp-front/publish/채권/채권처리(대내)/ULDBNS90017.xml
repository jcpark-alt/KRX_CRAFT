};
scwin.btn_TogetApply_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    if (cmb_IsuNm.getSelectedIndex() != -1) {
        //체크박스 체크 개수 구하기
        var chk, chkSize = 0;
        var chkRnum = [];
        for (var i = 1; i <= dts_IsuList.getTotalRow(); i++) {
            chk = dts_IsuList.getCellData(i, "CHECKED");
            if (chk == "T") {
                chkRnum.push(i);
                chkSize = chkSize + 1;
            }
        }
        var vIdx = cmb_IsuNm.getSelectedIndex() + 1;
        //체크 개수가 0인 경우 (전체 일괄적용)
        if (chkSize == 0) {
            for (var i = 1; i <= dts_IsuList.getTotalRow(); i++) {
                //그리드 설정
                dts_IsuList.setCellData(i, "AFCHG_ISU_NM", dts_IsuSelList.getCellData(vIdx, "TEXT"));
                dts_IsuList.setCellData(i, "AFCHG_ISU_ABBRV", dts_IsuSelList.getCellData(vIdx, "TEXT2"));
                dts_IsuList.setCellData(i, "AFCHG_ISU_ENG_NM", dts_IsuSelList.getCellData(vIdx, "TEXT3"));
                dts_IsuList.setCellData(i, "AFCHG_ISU_ENG_ABBRV", dts_IsuSelList.getCellData(vIdx, "TEXT4"));
            }
        } else {
            //체크 개수가 0이 아닌 경우 (체크항목만 일괄적용)
            for (var i = 1; i <= dts_IsuList.getTotalRow(); i++) {
                for (var j = 0; j < chkRnum.length; j++) {
                    if (i == chkRnum[j]) {
                        //그리드 설정
                        dts_IsuList.setCellData(i, "AFCHG_ISU_NM", dts_IsuSelList.getCellData(vIdx, "TEXT"));
                        dts_IsuList.setCellData(i, "AFCHG_ISU_ABBRV", dts_IsuSelList.getCellData(vIdx, "TEXT2"));
                        dts_IsuList.setCellData(i, "AFCHG_ISU_ENG_NM", dts_IsuSelList.getCellData(vIdx, "TEXT3"));
                        dts_IsuList.setCellData(i, "AFCHG_ISU_ENG_ABBRV", dts_IsuSelList.getCellData(vIdx, "TEXT4"));
                    }
                }
            }
        }
    } else {
        $c.win.alert("종목기준명을 선택 하십시오.");
        return;
    }
};
scwin.btn_SingApply_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    var vIdx = cmb_IsuNm.getSelectedIndex() + 1;
    if (cmb_IsuNm.getSelectedIndex() != -1) {
        if (dts_IsuList.getRowPosition() > 0) {
            //그리드 설정
            dts_IsuList.setCellData(dts_IsuList.getRowPosition(), "AFCHG_ISU_NM", dts_IsuSelList.getCellData(vIdx, "TEXT"));
            dts_IsuList.setCellData(dts_IsuList.getRowPosition(), "AFCHG_ISU_ABBRV", dts_IsuSelList.getCellData(vIdx, "TEXT2"));
            dts_IsuList.setCellData(dts_IsuList.getRowPosition(), "AFCHG_ISU_ENG_NM", dts_IsuSelList.getCellData(vIdx, "TEXT3"));
            dts_IsuList.setCellData(dts_IsuList.getRowPosition(), "AFCHG_ISU_ENG_ABBRV", dts_IsuSelList.getCellData(vIdx, "TEXT4"));
        } else {
            $c.win.alert("해당종목을 선택 하십시오.");
            return;
        }
    } else {
        $c.win.alert("종목기준명을 선택 하십시오.");
        return;
    }
};

};
scwin.img_RsnOccrDd_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    popUpCalendar2(edt_RsnOccrDd);
};
scwin.btn_Attach_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    if ("N" == dts_DtlInfo.getCellData(1, "HAS_ATTACH_DOC")) {
        $c.win.alert("연결된 팩스/첨부문서가 없습니다.");
        return;
    }
    scwin.fn_GetPar = fn_GetCommonKey;
    $c.bns.fn_PopAttachDocSearch(lbl_PopLoc);
};
scwin.btn_Dtl_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    scwin.fn_GetPar = fn_GetParIsuDelInfo;
    $c.bns.fn_PopIsuDetail(lbl_PopLoc);
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};

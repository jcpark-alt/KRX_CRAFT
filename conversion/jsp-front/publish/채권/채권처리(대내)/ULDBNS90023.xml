//★Wcraft guide★ include부분 주석처리 -> include("../js/bns_common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
scwin.vScrenID = 'ULDBNS90023.xml';
scwin.vMktactCd = '311'; //채권시장조치구분코드
scwin.pBndApplId = '';
scwin.vBndListProcsTpCd = 1; //채권처리구분(1:신청,2:접수)
scwin.vDtlInfoRowCount = 0;
scwin.arrPar = new Array();
scwin.fn_GetPar, scwin.fn_SetPar;
scwin.vViewYN = 'Y';
scwin.pIsurCd = '';
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};

/********************************************** 
 * 함수명   : fn_SetParam
 * 설명       : 부모창에서 받은 데이터를 설정한다.
 ***********************************************/
scwin.fn_SetParam = function() {
    var prt = $c.frame.path("../");
    if (prt != undefined) {
        scwin.fn_GetPar = prt.scwin.fn_GetPar;
        scwin.fn_SetPar = prt.scwin.fn_SetPar;
    }
    if (scwin.fn_GetPar != undefined) {
        scwin.fn_GetPar(scwin.arrPar);
        scwin.pBndApplId = scwin.arrPar[0].BND_APPL_ID;
        scwin.pIsurCd = scwin.arrPar[0].ISUR_CD;
    }
};



/********************************************** 
 * 함수명  	 : fn_dtl_sync
 * 설명       : 상세조회
 ***********************************************/
scwin.fn_dtl_sync = function() {
    var dsNm = 'BNS_ISU_CHG_INFO';
    var qryId = 'lds.stf.bnsisuchg.select.readIsuChgInfoExePrcOpDd';
    var param = '&{P}V_BND_LIST_PROCS_TP_CD=' + scwin.vBndListProcsTpCd;
    param += '&{P}V_MKTACT_CD=' + scwin.vMktactCd;
    param += '&{P}V_BND_APPL_ID=' + scwin.pBndApplId;
    param += '&{P}V_VIEW_YN=' + scwin.vViewYN;
    $c.bns.fn_SearchBns(scwin.vScrenID, dts_DtlInfo, dsNm, qryId, param);
};


/********************************************** 
 * 설명 : 채권신고담당자 조회
 ***********************************************/
scwin.fn_Search2 = function() {
    dts_List3.removeAll();
    var dsNm = 'BNS_BND_DECL_CHRG_LIST';
    var qryId = 'lds.stf.bnsdecl_mgr.select.selectBndDeclChrgList';
    var param = '&{P}V_ISUR_CD=' + scwin.pIsurCd;
    $c.bns.fn_SearchBns(scwin.vScrenID, dts_List3, dsNm, qryId, param);
};


/********************************************** 
 * 함수명   : fn_GetCommonKey
 * 설명       : 팝업에 넘길 키데이터를 정의한다.
 ***********************************************/
scwin.fn_GetCommonKey = function(arrPar) {
    scwin.arrPar[0] = {
        //첨부문서 목록 팝업	
        BND_APPL_ID: dts_DtlInfo.getCellData(1, "BND_APPL_ID"),
        BND_LIST_PROCS_TP_CD: dts_DtlInfo.getCellData(1, "BND_LIST_PROCS_TP_CD"),
        ISU_CD: dts_DtlInfo.getCellData(1, "ISU_CD")
    };
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    scwin.arrPar, length;
};


/********************************************** 
 * 함수명   : fn_GetParIsuDelInfo
 * 설명       : 종목상세 목록 팝업에 넘길 데이터를 정의한다.
 ***********************************************/
scwin.fn_GetParIsuDelInfo = function(arrPar) {
    scwin.arrPar[0] = {
        STD_CD: dts_DtlInfo.getCellData(1, "ISU_CD"),
        BND_LIST_PROCS_TP_CD: scwin.vBndListProcsTpCd
    };
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    scwin.arrPar, length;
};


/********************************************** 
 * 함수명  	 : fn_ChgTab_Act
 * 설명       : 필드 ReadOnly 속성 제거/부여
 ***********************************************/
scwin.fn_ChgTab_Act = function(vBndListProcsTpCd) {
    //변경후 최초이자지급일, 변경후 특이발행조건, 사유발생일, 사유
    if (scwin.vBndListProcsTpCd == 1) {
        edt_AfchgFstIntPayDd.setReadOnly("true");
        edt_RsnOccrDd.setReadOnly("true");
        $c.stf.showObj(img_RsnOccrDd, false); //사유발생일 달력
        $c.stf.showObj(img_AfchgFstIntPayDd, false); //변경후 최초이자지급일 달력
        txb_ChgRsn.style.color = "#15549c";
        txb_ChgRsn.style.backgroundColor = "#b9d4f7";
        txb_ChgRsn.setReadOnly(true);
    } else if (scwin.vBndListProcsTpCd == 2) {
        edt_AfchgFstIntPayDd.setReadOnly("false");
        edt_RsnOccrDd.setReadOnly("false");
        $c.stf.showObj(img_RsnOccrDd, true); //사유발생일 달력
        $c.stf.showObj(img_AfchgFstIntPayDd, true); //변경후 최초이자지급일 달력
        txb_ChgRsn.style.color = "#343434";
        txb_ChgRsn.style.backgroundColor = "#FFFFFF";
        txb_ChgRsn.setReadOnly(false);
    }
};
scwin.gform_onload = function() {
    $c.stf.showObj(lbl_PopLoc, false); //팝업위치 레이블 숨김
    $c.bns.BnsPanelToGroupBox(pnl_Req); //패널라운드처리(신청)
    $c.bns.BnsPanelToGroupBox(pnl_DtlInfo); //패널라운드처리(상세)
    $c.bns.BnsPanelToGroupBox(pnl_Acpt); //패널라운드처리(접수)	

    tab_List.setSelectedTabIndex(1);
    scwin.fn_SetParam(); //호출파라미터설정	
    scwin.fn_dtl_sync(); //상세조회	
    //필드 ReadOnly 속성 제거/부여
    scwin.fn_ChgTab_Act(scwin.vBndListProcsTpCd);

    // 채권신고담당자 조회
    scwin.fn_Search2();
};
scwin.tab_List_OnSelChanged = function(nIndex) {
    scwin.vBndListProcsTpCd = nIndex;
    scwin.fn_dtl_sync(); //상세조회
    //필드 ReadOnly 속성 제거/부여
    scwin.fn_ChgTab_Act(scwin.vBndListProcsTpCd);

    // 채권신고담당자 조회
    scwin.fn_Search2();
};
scwin.dts_DtlInfo_OnLoadCompleted = function(rowcount) {
    scwin.vDtlInfoRowCount = rowcount;
};
scwin.img_StrtDd_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;
    popUpCalendar2(edt_StrtDd);
};
scwin.img_RedmptDd_onclick = function() {
    if (scwin.vDtlInfoRowCount == 0) return;

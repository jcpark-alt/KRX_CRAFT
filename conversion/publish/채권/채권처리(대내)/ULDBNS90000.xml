//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
scwin.vScrenID = "ULDBNS90000.xml";
scwin.fn_GetPar, scwin.fn_SetPar;
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};

/********************************************** 
 * 함수명   : fn_Search
 * 설명       : 신청인정보를 조회한다.
 ***********************************************/
scwin.fn_Search = function() {
    var url = "/listingCommon.do?method=listGeneralForDynamicName";
    url += "&service=krx.lds.stf.listingcommon.services.ListingCommonApp";
    url += "&outputMessageId=BNS_APCT_INFO";
    url += "&queryId=lds.stf.bnscommon.select.readApctInfo";
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&{P}V_BND_APPL_ID=" + $c.stf.getObjectValue(txb_BndApplId);
    url += "&{P}V_BND_LIST_PROCS_TP_CD=" + $c.stf.getObjectValue(txb_BndListProcsTpCd);
    dts_ApctInfo.DataID = encodeURI(url);
    dts_ApctInfo.Reset();
};


/********************************************** 
 * 함수명   : fn_Change
 * 설명       : 신청인정보를 변경한다.
 ***********************************************/
scwin.fn_Change = function() {
    var url = "/bns/BnsCommon.do?method=updateApctInfoChg";
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_03;
    trs_Save.Action = $c.lc.fn_encodeNSession(url);
    trs_Save.KeyName = "toinb_dataid4";
    trs_Save.KeyValue = "JSP(I:pInput=dts_ApctInfo)";
    //trs_Save.Parameters = param;
    trs_Save.Post();
};


/********************************************** 
 * 함수명   : fn_SetParam
 * 설명       : 부모창에서 받은 데이터를 설정한다.
 ***********************************************/
scwin.fn_SetParam = function() {
    var prt = $c.frame.path("../");
    if (prt != undefined) {
        scwin.fn_GetPar = prt.scwin.fn_GetPar;
        scwin.fn_SetPar = prt.scwin.fn_SetPar;
    }
    if (scwin.fn_GetPar != undefined) {
        var arrPar = new Array();
        scwin.fn_GetPar(arrPar);
        $c.stf.setObjectValue(txb_BndApplId, arrPar[0].BND_APPL_ID);
        $c.stf.setObjectValue(txb_BndListProcsTpCd, arrPar[0].BND_LIST_PROCS_TP_CD);
    }
};
scwin.gform_onload = function() {
    //숨기기
    $c.stf.showObj(txb_BndApplId, false);
    $c.stf.showObj(txb_BndListProcsTpCd, false);
    //호출파라미터설정
    scwin.fn_SetParam();
    //신청인정보조회
    scwin.fn_Search();
};
scwin.btn_Change_onclick = function() {
    if (!$c.cp.isModified(dts_ApctInfo)) return;
    if (!window.confirm("현재 발행기관담당자 정보를 신청인정보로 변경하시겠습니까?")) return;
    scwin.fn_Change();
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_ApctInfo_OnLoadCompleted = function(rowcount) {
    if (rowcount == 0) $c.win.alert('신청인 정보를 가져오지 못했습니다.');
};
scwin.trs_Save_OnFail = function() {
    $c.win.alert($c.stf.getMessageParam("MSG-0002"));
};
scwin.trs_Save_OnSuccess = function() {
    $c.win.alert('정상적으로 처리되었습니다.');
    scwin.fn_Search();
};
]]></script>

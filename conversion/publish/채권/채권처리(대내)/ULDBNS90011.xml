    tab_List.setSelectedTabIndex(1);
    scwin.fn_SetParam();
    $c.bns.BnsPanelToGroupBox(pnl_Acpt); //접수
    $c.bns.BnsPanelToGroupBox(pnl_Req); //신청
    $c.bns.BnsPanelToGroupBox(pnl_DtlInfo); //상세	
    $c.bns.BnsPanelToGroupBox(pnl_StripCls); //마감	

    scwin.fn_SetMktactCd(); //시장조치구분 설정	
    scwin.fn_dtl_sync();
};
scwin.tab_List_OnSelChanged = function(nIndex) {
    scwin.vBndListProcsTpCd = nIndex;
    if (nIndex == 3) {
        $c.stf.showObj(pnl_DtlInfo, false);
        scwin.fn_SearchStripCls();
    } else {
        $c.stf.showObj(pnl_DtlInfo, true);
        scwin.fn_dtl_sync();
    }
};
scwin.dts_IsuInfo_OnLoadCompleted = function(rowcount) {
    scwin.vRowCount = rowcount;
    if (rowcount > 0) {
        //당일 스트립설정
        if (dts_IsuInfo.getCellData(1, 'TDD_ADD_LIST_MKTACT_YN') == 'Y') {
            $c.stf.setObjectValue(chk_TddAddListMktactYn, 'Y');
        } else {
            $c.stf.setObjectValue(chk_TddAddListMktactYn, 'N');
        }
    }
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.btn_Dtl_onclick = function() {
    if (scwin.vRowCount == 0) return;
    scwin.fn_GetPar = fn_StripIsuDetail;
    $c.bns.fn_PopStripAddIsuDetail(lbl_BndApplId);
};
scwin.btn_Attach_onclick = function() {
    if (scwin.vRowCount == 0) return;
    if ("N" == dts_IsuInfo.getCellData(1, "HAS_ATTACH_DOC")) {
        $c.win.alert("연결된 팩스/첨부문서가 없습니다.");
        return;
    }
    scwin.fn_GetPar = fn_GetCommonKey;
    $c.bns.fn_PopAttachDocSearch(lbl_BndApplId);
};
scwin.img_StdCd_onclick = function() {
    if (scwin.vRowCount == 0) return;
    if ($c.stf.getObjectValue(txb_StdCd) == '') return;
    scwin.fn_GetPar = fn_GetParIsuDtlAndMktactDtl;
    $c.bns.fn_PopIsuDtlAndMktactDtl(lbl_BndApplId);
};
scwin.img_BndAddSprtDd_onclick = function() {
    if (scwin.vRowCount == 0) return;
    popUpCalendar2(edt_BndAddSprtDd);
};
scwin.img_RecombinEfctOccrDd_onclick = function() {
    if (scwin.vRowCount == 0) return;
    popUpCalendar2(edt_RecombinEfctOccrDd);
};
scwin.img_StrtDd_onclick = function() {
    if (scwin.vRowCount == 0) return;
    popUpCalendar2(edt_StrtDd);
};
scwin.img_StripAmtCfm_onclick = function() {
    if (scwin.vRowCount == 0) return;
    if ($c.stf.getObjectValue(chk_TddAddListMktactYn) == 'Y') {
        scwin.vStripAmtCfm = "View";
        scwin.fn_GetPar = fn_GetAddAndStripMktactAmtCfm;
        scwin.fn_SetPar = fn_SetAddAndStripMktactAmtCfm;
        $c.bns.fn_PopAddAndStripMktactAmtCfm(lbl_BndApplId);
    }
};

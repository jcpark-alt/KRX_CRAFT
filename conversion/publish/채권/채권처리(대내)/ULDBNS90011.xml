    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    arrPar, length;
};


/********************************************** 
 * 함수명   : fn_StripIsuDetail
 * 설명       : 스트립종목상세 목록 팝업에 넘길 데이터를 정의한다.
 ***********************************************/
scwin.fn_StripIsuDetail = function(arrPar) {
    arrPar[0] = {
        STD_CD: dts_IsuInfo.getCellData(1, 'STD_CD')
    };
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    arrPar, length;
};


/********************************************** 
 * 함수명   : fn_GetAddAndStripMktactAmtCfm
 * 설명       : 추가상장/스트립 동시 시장조치 금액확인 팝업에 넘길 데이터를 정의한다.
 ***********************************************/
scwin.fn_GetAddAndStripMktactAmtCfm = function(arrPar) {
    arrPar[0] = {
        VIEW_YN: scwin.vStripAmtCfm,
        BND_APPL_ID: dts_IsuInfo.getCellData(1, "BND_APPL_ID"),
        BND_LIST_PROCS_TP_CD: dts_IsuInfo.getCellData(1, "BND_LIST_PROCS_TP_CD"),
        BND_MKTACT_TP_CD: scwin.vMktactCd,
        ISU_CD: dts_IsuInfo.getCellData(1, "STD_CD"),
        ADD_ISU_AMT: dts_IsuInfo.getCellData(1, "ADD_ISU_AMT")
    };
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    arrPar, length;
};

/********************************************** 
 * 함수명   : fn_SetRegYnReturn

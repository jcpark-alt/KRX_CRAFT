 ***********************************************/
scwin.fn_SetMktactCd = function() {
    //채권시장조치구분코드
    scwin.vMktactCd = "402";
};


/********************************************** 
 * 함수명   : fn_dtl_sync
 * 설명       : 상세종목을 조회한다.
 ***********************************************/
scwin.fn_dtl_sync = function() {
    var param = '';
    param += "&{P}V_BND_APPL_ID=" + scwin.vBndApplId;
    param += "&{P}V_BND_LIST_PROCS_TP_CD=" + scwin.vBndListProcsTpCd;


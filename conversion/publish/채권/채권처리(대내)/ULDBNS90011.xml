 ***********************************************/
scwin.fn_SetRegYnReturn = function(arrPar) {
    vRegYn = arrPar[0].REG_YN;
    dts_IsuInfo.setCellData(1, 'BND_APPL_DD', arrPar[0].BND_APPL_DD);
    dts_IsuInfo.setCellData(1, 'ADD_LIST_APPL_NO', arrPar[0].ADD_LIST_APPL_NO);
    dts_IsuInfo.setCellData(1, 'STRIP_APPL_NO', arrPar[0].STRIP_APPL_NO);
    dts_IsuInfo.setCellData(1, 'ADD_STRIP_APPL_NO', arrPar[0].ADD_STRIP_APPL_NO);
    dts_IsuInfo.setCellData(1, 'AFCHG_ISU_AMT', arrPar[0].AFCHG_ISU_AMT);
    dts_IsuInfo.setCellData(1, 'AFCHG_LIST_AMT', arrPar[0].AFCHG_LIST_AMT);
    dts_IsuInfo.setCellData(1, 'AFCHG_STRIP_NSPRT_BAL', arrPar[0].AFCHG_STRIP_NSPRT_BAL);
};


/********************************************** 
 * 함수명   : fn_GetParIsuDtlAndMktactDtl

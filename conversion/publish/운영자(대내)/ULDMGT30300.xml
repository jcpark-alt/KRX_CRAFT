scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_list_sync = function() {
    if (scwin.dateCheck() == false) {
        return;
    }
    var KeyWord = $c.cp.valueOfIndex(keyword, "VALUE", keyword.getSelectedIndex());
    var Condition = condition1.getValue();
    var UserId = condition2.getValue();
    var SDate = edt_SDate.getValue();
    var EDate = edt_EDate.getValue();
    var ProcsStat = $c.cp.valueOfIndex(cmb_Procs_Stat, "VALUE", cmb_Procs_Stat.getSelectedIndex());
    var CreatlocTpCd = $c.cp.valueOfIndex(cmb_Creatloc_Tp_Cd, "VALUE", cmb_Creatloc_Tp_Cd.getSelectedIndex());
    url = "/ShareRoom.do?method=listHelpDeskRoom&KeyWord=" + KeyWord + "&Condition=" + Condition + "&UserId=" + UserId + "&SDate=" + SDate + "&EDate=" + EDate + "&LD_MKT_TP=" + $c.stf.getObjectValue(rdo_MKT_ID) + "&ProcsStat=" + ProcsStat + "&CreatlocTpCd=" + CreatlocTpCd + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_listShareRoom.DataID = encodeURI(url);
    dts_listShareRoom.reset();
    $c.cm.ShowWin(grd_tmp_1);
};
scwin.fn_setContnId = function(obj) {
    if (scwin.contnId != "input") {
        scwin.contnId = dts_listShareRoom.getCellData(eval(obj), "CONTN_ID");
    }
};
scwin.fn_getContnId = function() {
    return scwin.contnId;
};
scwin.dateCheck = function() {
    if (parseInt(edt_SDate.getValue(), '10') > parseInt(edt_EDate.getValue(), '10')) {
        $c.win.alert("[조회기간 시작일은 종료일보다 작아야 합니다.]다시 입력해주세요");
        edt_SDate.setValue($c.ut.cGetToday("yyyymmdd"));
        edt_EDate.setValue($c.ut.cGetToday("yyyymmdd"));
        return false;
    }
};
scwin.grd_tmp_1_OnDblClick = async function(row, colid) {
    if (colid == 'TITLE') {
        scwin.fn_setContnId(row);
        await $c.frame.CreateDialogFrame("gform", "/bizspt/ULDMGT30301.gfm", "HelpDesk 수정", 10, 10, 655, 510, "window");
        scwin.fn_list_sync();
    }
};
scwin.cmb_PeriodTp_OnSelChange = function() {
    var vTp = $c.cp.valueOfIndex(cmb_PeriodTp, "VALUE", cmb_PeriodTp.getSelectedIndex());
    $c.stf.fn_setFromToDate(vTp, edt_SDate, edt_EDate);
};
scwin.btn_input_onclick = async function() {
    scwin.contnId = "input";
    await $c.frame.CreateDialogFrame("gform", "/bizspt/ULDMGT30301.gfm", "HelpDesk 등록", 10, 10, 655, 510, "window");
    scwin.contnId = "";
    scwin.fn_list_sync();
};
scwin.dts_listShareRoom_OnLoadCompleted = function(rowcount) {
    txb_TotCnt.setValue("총 " + rowcount + "건");
    if (rowcount <= 0) {
        dts_listShareRoom.removeAll();
    }
    $c.cm.CloseWin(rowcount, grd_tmp_1); //데이터 로딩중닫기 및 조회없음 처리

};
scwin.dts_listShareRoom_OnLoadError = function() {
    $c.cm.CloseWin('', grd_tmp_1);
};
scwin.btn_select_onclick = function() {
    scwin.fn_list_sync();
};
scwin.icn_SCal_onclick = function() {
    popUpCalendar2(edt_SDate);
};
scwin.icn_ECal_onclick = function() {
    popUpCalendar2(edt_EDate);
};
scwin.img_toExcel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
    $c.data.downloadGridViewExcel(grd_tmp_1, "건의사항 목록", "", "2");
};
scwin.rdo_MKT_ID_OnSelChange = function() {
    //fn_SetCtrlByMktId();

};
scwin.gform_onload = function() {
    $c.libRoundPanel.PanelToGroupBox(panel_Top);
    //edt_SDate.text = cGetToday("yyyymmdd");
    $c.stf.showObj(btn_input, true);
    vCurDate = $c.ut.cGetToday("yyyymmdd");
    edt_SDate.setValue($c.ut.cGetMinusMonth(vCurDate.substring(0, 4), vCurDate.substring(4, 6), vCurDate.substring(6, 8), 1)); // 한달전 날짜
    edt_EDate.setValue($c.ut.cGetToday("yyyymmdd"));
    $c.stf.setObjectValue(rdo_MKT_ID, scwin.gLdMktTp);
    if (scwin.gLdMktTp == '1' || scwin.gLdMktTp == '2') {
        //showObj(panel_mkt, false);
        $c.stf.showObj(panel_mkt, true);
    }
    scwin.fn_list_sync();
};
]]></script>

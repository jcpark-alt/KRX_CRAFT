scwin.strQueryId = "";
scwin.strBzCalndDd = "";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};

/*익일영업일 가져옴*/
scwin.fn_getDate = function() {
    var url = "/listingCommon.do?method=listGeneral&outputMessageId=ULDSTF41001_INOUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstmgt.mktverif.date.select";
    dts_getDate.DataID = encodeURI(url);
    dts_getDate.reset();
};
scwin.fn_list_sync = function() {
    // 현재 조회일이 익일영업일과 같은경우 -> 신규임시테이블 데이터 조회
    if (tbx_changeListDd.getValue() == scwin.strBzCalndDd) {
        scwin.strQueryId = "lds.stf.pf.lstlst.select.chglist.recv.newtempcount";
        $c.stf.showObj(lab_comment, false);
        $c.stf.showObj(lab_comment_new, true);
        // 현재 조회일이 익일영업일과 다른경우 -> 기존테이블 데이터 조회

    } else {
        scwin.strQueryId = "lds.stf.pf.lstlst.select.chglist.recv.count";
        $c.stf.showObj(lab_comment_new, false);
        $c.stf.showObj(lab_comment, true);
    }
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=PF_CHGLIST_RECV_COUNT_SEARCH_OUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=" + scwin.strQueryId + "&{P}param01=" + tbx_changeListDd.getValue() + "&{P}param02=" + tbx_changeListDd.getValue() + "&{P}param03=" + tbx_changeListDd.getValue();
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_List);
};
scwin.fn_SetHeader = function() {
    dts_List.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=PF_CHGLIST_RECV_COUNT_SEARCH_OUT";
    dts_List.reset();
    //alert(dts_List.text+" dts_List.text");

};



/********************************************** 
 * 함수명   : fn_ExcelDown()
 * 설명       : 정보를 excel로 다운 받는다.
 ***********************************************/
scwin.fn_ExcelDown = function() {
    if (dts_List.getTotalRow() > 0) {
        $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
        $c.data.downloadGridViewExcel(grd_List, "상장형 수익증권 변경상장 수량 ", "", "3");
    } else {
        $c.win.alert("해당데이터가 없습니다. 조회후 다운받으십시요.");
    }
};
scwin.dts_getDate_OnLoadError = function() {
    $c.stf.alert_error(dts_getDate);
};
scwin.dts_getDate_OnLoadCompleted = function(rowcount) {
    scwin.strBzCalndDd = dts_getDate.getCellData(1, "CALND_DD");
    tbx_changeListDd.setValue(scwin.strBzCalndDd);
    scwin.fn_list_sync();
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_List);
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.gform_onload = function() {
    $c.stf.showObj(btn_Excel, true);

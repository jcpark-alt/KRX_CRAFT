/* ★Wcraft guide★    
스크립트 수작업 유의사항
 ASIS에서 문법에 어긋난 문장이 발견되었습니다. 이는 WCRAFT에서 X 로 변환합니다.  
 X 로 변환된 곳을 찾아 ASIS소스를 참고하여 문법에 맞도록 변환해주세요. 

----------------------------------------------------
[0] 기존 문법 오류
----------------------------------------------------
	> X 오류 확인 - 기존 소스 확인 필요

*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/jquery-1.11.0.min.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/elastic_search.js");
scwin.bzProcsNo;
scwin.gListStatCd;
scwin.vScrenID = "ULDSTF21601.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_read = function() {
    var url = "/CertificateApprove.do";
    url += "?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=readIsurEtcInfo&inputMessageId=ISUR_ETC_READ_INOUT&ISUR_ETC_READ_INOUT";
    url += "&bzProcsNo=" + scwin.bzProcsNo;
    dts_readIsurEtcInfo.DataID = encodeURI(url);
    dts_readIsurEtcInfo.reset();
};
scwin.fn_update = function() {
    var rtn = confirm('법인정보 변경내용을 수정 하시겠습니까?');
    if (rtn == 1) // [수정] 버튼이 눌려졌을 경우

    {
        trs_Update.Action = "/CertificateApprove.do?method=modifyIsurEtcInfo&bzProcsNo=" + scwin.bzProcsNo + "&gubun=&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_03;
        trs_Update.KeyValue = "JSP(I:pInput=dts_readIsurEtcInfo)";
        trs_Update.Post();
    }
};
scwin.fn_approve = function() {
    var rtn = confirm('법인정보 변경내용을 승인 하시겠습니까?');
    if (rtn == 1) // [승인] 버튼이 눌려졌을 경우

    {

        // ********************************************************************
        // [WebSquare 전환 추가] 원본 소스와 비교 필요
        // 
        // ********************************************************************

        /*ORG SRC: dts_readIsurEtcInfo.UserStatus(1) = 1;*/
        X = 1;
        trs_Approve.Action = "/CertificateApprove.do?method=modifyIsurEtcInfo&bzProcsNo=" + scwin.bzProcsNo + "&gubun=approve&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02;
        trs_Approve.KeyValue = "JSP(I:pInput=dts_readIsurEtcInfo)";
        trs_Approve.Post();
    }
};



//카프카 법인정보 인덱싱 호출
scwin.callElastic_CACHE_EVICT_fromText = function() {
    $.ajax({
        type: "POST",
        url: "/elasticNoti.do",
        data: {
            method: "indexingElasitcSearchFromText",
            text: "corp",
            url: "/api/kafka/producer/CACHE_EVICT/text",
            type: "POST"
        },
        async: true
    });
};
scwin.trs_Update_OnSuccess = async function() {
    $c.win.alert($c.stf.getMessageParam("MSG-A001", "법인기타정보 수정"));
    await $c.frame.CloseFrame();
};
scwin.trs_Update_OnFail = function() {
    $c.win.alert($c.stf.getMessageParam("MSG-A002", "법인기타정보 수정"));
    $c.win.alert(trs_Update.ErrorMsg);
    //alert(dts_C_All.ErrorMsg);

};
scwin.trs_Approve_OnSuccess = async function() {
    $c.win.alert($c.stf.getMessageParam("MSG-A001", "법인기타정보 승인"));
    await $c.frame.CloseFrame();
};
scwin.trs_Approve_OnFail = function() {
    $c.win.alert($c.stf.getMessageParam("MSG-A002", "법인기타정보 승인"));
    $c.win.alert(trs_Approve.ErrorMsg);
    //alert(dts_C_All.ErrorMsg);

};
scwin.btn_modify_onclick = function() {
    scwin.fn_update();
};
scwin.btn_close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.btn_approve_onclick = function() {
    scwin.callElastic_CACHE_EVICT_fromText();
    scwin.fn_approve();
};
scwin.gform_onload = function() {
    $c.libRoundPanel.PanelToGroupBox(panel_Top);
    var parentWin = $c.frame.path("../");
    scwin.bzProcsNo = parentWin.gBzProcsNo;
    scwin.gListStatCd = parentWin.scwin.gListStatCd;
    if (scwin.gListStatCd == '10' || scwin.gListStatCd == '02') {
        //승인, 반려
        $c.stf.showObj(btn_approve, false);
        $c.stf.showObj(btn_modify, false);
        $c.stf.showObj(label_lb, false);
    }
    scwin.fn_read();
};

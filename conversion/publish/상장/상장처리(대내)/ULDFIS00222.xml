};
scwin.gform_onload = function() {
    $c.libRoundPanel.PanelToGroupBox(panel_Top); // 패널라운드 처리
    window.document.body.scroll = "no";
    var arrPar = new Array();
    /***************************************

	//----W-Craft WebSquare 변환 확인: fn_GetPar----//
    opener에  fn_GetPar의 이름을 가진 함수가 있다면, 이 펑션에 인수를 넘겨 값을 채워 이용한다. 없다면 업종조회후  최초 지정 코드값이 없는 상태
    opener에  fn_SetPar의 이름을 가진 함수가 있다면, 이 펑션에 인수를 넘겨 값을 채워 이용한다. 없다면 선택한 코드값과 코드명칭을 지정하지 않는다.
    ***************************************/
    var parentWin = $c.frame.path("../");

	//----W-Craft WebSquare 변환 확인: fn_GetPar----//
    scwin.fn_GetPar = parentWin.scwin.fn_GetPar;

	//----W-Craft WebSquare 변환 확인: fn_GetPar----//
    if (scwin.fn_GetPar != undefined) {

	//----W-Craft WebSquare 변환 확인: fn_GetPar----//
        scwin.fn_GetPar(arrPar);
        scwin.v_arrKey = arrPar;
    }
    if (scwin.v_arrKey.length >= 1) {
        scwin.fn_Search();
    } else {
        alert("조회 조건이 없습니다");
    }
};
scwin.img_Close_onclick = async function() {
    // 닫기 버튼 클릭
    await $c.frame.CloseFrame();
};

 */
scwin.fn_InitDs = function() {
    dts_MngAdmDtl.removeAll();
};


/**
 *  조회조건 유효성 체크
 */
scwin.fn_ChkValid = function() {
    return true;
};


/**
 * 인물정보 조회
 */
scwin.fn_Search = function() {
    //데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 필수 체크.
    if (!scwin.fn_ChkValid()) {
        return;
    }

    // Lodaing~~~ 표시
    $c.cm.ShowWin(panel_Top);
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamic" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=krx.lds.stf.fis.select.mngAdmDtl" + "&outputMessageId=FIS_MNG_ADM_DTL" + "&param01=" + scwin.v_arrKey[0] + "&param02=" + scwin.v_arrKey[1];
    dts_MngAdmDtl.DataID = encodeURI(url);

	//----W-Craft WebSquare 변환 확인: Reset----//
    dts_MngAdmDtl.Reset();
};
scwin.dts_MngAdmDtl_OnLoadError = function() {
    $c.stf.alert_error(dts_MngAdmDtl);
    $c.cm.CloseWin(-1, panel_Top);

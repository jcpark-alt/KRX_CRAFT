scwin.clickBackListDesignDD = "";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_SetCode = function() {
    cmb_SEL_STAT_CD.CBData = scwin.strCbd_SEL_STAT_CD;
    $c.stf.setObjectValue(cmb_SEL_STAT_CD, "1");
};
scwin.fn_list_sync = function() {
    var url = "/RepMajagnt.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&method=searchBackListCom";
    url += "&inputMessageId=BACKLIST_COM_INPUT_OUT";
    url += "&ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD);
    url += "&BACKLIST_ADM_TP_CD=" + $c.stf.getObjectValue(rdo_BACKLIST_ADM_TP_CD);
    url += "&LIST_STAT_CD=" + $c.stf.getObjectValue(rdo_LIST_STAT_CD);
    url += "&SEL_STAT_CD=" + $c.stf.getObjectValue(cmb_SEL_STAT_CD);
    url += "&LIST_BZ_PROCS_STA=" + $c.stf.getObjectValue(edt_BzSDate);
    url += "&LIST_BZ_PROCS_END=" + $c.stf.getObjectValue(edt_BzEDate);
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};
scwin.fn_setContnId = function(obj) {
    if (eval(obj) > 0) {
        //그리드에서 선택시
        scwin.clickIsurCd = dts_List.getCellData(eval(obj), "ISUR_CD");
        scwin.clickBackListDesignDD = dts_List.getCellData(eval(obj), "BACKLIST_DESIGN_DD");
    } else {
        scwin.clickIsurCd = "";
        scwin.clickBackListDesignDD = "";
    }
};
scwin.fn_OpenDetail = async function(row) {
    scwin.fn_setContnId(row);
    if (row < 0) {
        //그리드에서 선택시
        scwin.clickIsurCd = "";
        scwin.clickBackListDesignDD = "";
    }
    var hight = "490";
    var pageNM = "ULDSTF41531";
    await $c.frame.CreateDialogFrame("우회상장기업 입력", "/lstmgt/" + pageNM + ".gfm", "우회상장기업 입력", 200, 200, 1050, hight, "window");
};
scwin.fn_ExcelDown = function() {
    $c.data.downloadGridViewExcel(grd_List, "우회상장기업현황", "", "2"); //

};
scwin.img_COM_NM_onclick = function() {
    $c.cm.IsurcdSearch(txb_ISUR_CD, txb_COM_NM);
};
scwin.img_BzSDate_onclick = function() {
    popUpCalendar2(edt_BzSDate);
};
scwin.img_BzEDate_onclick = function() {
    popUpCalendar2(edt_BzEDate);
};
scwin.txb_ISUR_CD_onblur = function() {
    if (txb_ISUR_CD.getValue() == "") {
        txb_COM_NM.setValue("");
    }
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_List);
    edt_TotalCnt.setValue("총 " + dts_List.getTotalRow() + " 건");
};
scwin.grd_List_OnDblClick = function(row, colid) {
    scwin.fn_OpenDetail(row);
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.btn_New_onclick = function() {
    scwin.fn_OpenDetail(-999);
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    scwin.fn_ExcelDown();
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_Top);
    var vCurDate = $c.ut.cGetToday("yyyymmdd");
    //var vCurMonth = cGetMinusMonth(vCurDate.substring(0,4), vCurDate.substring(4,6), vCurDate.substring(6,8), 2);
    var vCurMonth = "19000101";
    edt_BzSDate.setValue(vCurMonth);
    edt_BzEDate.setValue(vCurDate);
    scwin.fn_SetCode();
    //fn_Search();

};
]]></script>

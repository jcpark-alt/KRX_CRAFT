scwin.fn_searchCode = function() {
    var arrCid = [{
        cid: "DELIB_COMITE_TP_CD",
        cnm: "cmb_DelibComiteTpCd"
    }];
    var objCod;
    var url = "/CodeAction.do?method=listCodeValueNameM";
    url += "&inputMessageId=CODE_M_IN&outputMessageId=CODE_M_OUT";
    url += "&CD_ID_M='DELIB_COMITE_TP_CD'";
    dts_Code.DataID = encodeURI(url);
    dts_Code.reset();
    var strCbd = "",
        i, j;
    for (i = 0; i < arrCid.length; i++) {
        objCod = document.getElementById(arrCid[i].cnm);
        if (objCod == null) {
            $c.win.alert(arrCid[i].cnm);
        }
        strCbd = "A^전체";
        for (j = 1; j <= dts_Code.getTotalRow(); j++) {
            if (dts_Code.getCellData(j, "CD_ENG_NM") == arrCid[i].cid) {
                strCbd = strCbd + (strCbd == "" ? "" : ",") + dts_Code.getCellData(j, "VALUE") + "^" + dts_Code.getCellData(j, "TEXT");
            }
        }
        objCod.CBData = strCbd;
    }
    cmb_DelibComiteTpCd.setSelectedIndex(0);

    //
    strCbd = "A^전체";
    strCbd = strCbd + ',Y' + "^" + '상장유지';
    strCbd = strCbd + ',D' + "^" + '상장폐지';
    cmb_ListComiteDelibRsltCd.CBData = strCbd;
    cmb_ListComiteDelibRsltCd.setSelectedIndex(0);

    //
    strCbd = "A^전체";
    strCbd = strCbd + ',N' + "^" + '미대상';
    strCbd = strCbd + ',Y' + "^" + '대상';
    cmb_OpnReservYn.CBData = strCbd;
    cmb_OpnReservYn.setSelectedIndex(0);
};
scwin.fn_list_sync = function() {
    var url = "/listingCommon.do?method=listGeneralForDynamicName&outputMessageId=DELIST_MTBK_INOUT&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&SCREN_ID=" + scwin.vScrenID + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstproc.delistmtbk.list" + "&{P}V_ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD) + "&{P}V_SDATE=" + $c.stf.getObjectValue(edt_SDate) + "&{P}V_EDATE=" + $c.stf.getObjectValue(edt_EDate) + "&{P}V_COMITE_TP_CD=" + $c.stf.getObjectValue(cmb_DelibComiteTpCd) + "&{P}V_RSLT_TP_CD=" + $c.stf.getObjectValue(cmb_ListComiteDelibRsltCd) + "&{P}V_OPN_RESERV_YN=" + $c.stf.getObjectValue(cmb_OpnReservYn);
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.fn_setPara = function(obj) {
    if (scwin.vJobMode == "M") {
        scwin.vIsurCd = dts_List.getCellData(obj, "ISUR_CD");
        scwin.vSeq = dts_List.getCellData(obj, "SEQ");
    } else {
        scwin.vIsurCd = "";
        scwin.vSeq = "";
    }
};
scwin.fn_getParaIsurCd = function() {
    return scwin.vIsurCd;
};
scwin.fn_getParaSeq = function() {
    return scwin.vSeq;
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.grd_Grid_OnDblClick = async function(row, colid) {
    scwin.vJobMode = "M";
    scwin.fn_setPara(row);
    var wth = 780;
    var hgt = 370;
    var pt = $c.stf.fn_getModalCenterPos(frame, wth, hgt);

    //frame.CreateDialogFrame("gform", "/lstmgt/ULDSTF60012.gfm", "심사관련 이슈사항 수정" ,10, 10, 790, 470, "window" );
    await $c.frame.CreateDialogFrame("gform", "/lstproc/ULDSTF20504.gfm", "상장폐지 의사록 수정", pt.x, pt.y, wth, hgt, "window");

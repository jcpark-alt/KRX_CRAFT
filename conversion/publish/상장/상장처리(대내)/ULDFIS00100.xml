    scwin.fn_ComSrchOpen();
};
scwin.txb_CoSnm_onkeydown = function() {
    // 기업명 키다운.
    if (event.keyCode == 13) {
        if ($c.stf.getObjectValue(txb_CoSnm) == "") {
            // 기업검색팝업 오픈
            scwin.fn_ComSrchOpen();
        } else {
            // 기업정보 조회
            scwin.fn_ComInfoSrch();
        }
    }
};
scwin.txb_CoSnm_onchange = function() {
    // 조회조건이 변경된 경우 초기화.
    txb_KisCd.setValue("");
    txb_IndPttn.setValue("");

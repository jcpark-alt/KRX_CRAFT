/**
 *  화면 초기화
 */
scwin.fn_Init = function() {
    // 패널 라운드 처리
    $c.cm.PanelToGroupBox(panel_Top);
    $c.libRoundPanel.PanelToGroupBox(panel_Mid);
    $c.cm.PanelToGroupBox(panel_Bot);
};


/**
 *  데이터셋 초기화.
 */
scwin.fn_InitDs = function(pWorkFg) {
    if (pWorkFg == "1") {
        dts_ComOutLook.removeAll();
        dts_FncInfo.removeAll();
    } else if (pWorkFg == "2") {
        dts_ComInfo.removeAll();
    }
};



/**
 *  기본값 세팅
 */
scwin.fn_SetDefaultVal = function() {

};

/**
 * 팝업으로 값을 넘김.
 */
scwin.fn_GetParKisCd = function() {
    var arrPar = new Array();
    arrPar[0] = txb_CoSnm.getValue(); // 기업명
    return arrPar;
};


/**
 * 팝업에서 넘어온 값 세팅.
 */
scwin.fn_SetParKisCd = function(arrPar) {
    txb_CoSnm.setValue(arrPar[0].CO_SNM); //기업명
    txb_KisCd.setValue(arrPar[0].KIS_CD); //기업코드
    txb_IndPttn.setValue(arrPar[0].IND_PTTN); //업종유형

    if ($c.stf.getObjectValue(txb_KisCd) != "") {
        scwin.fn_Search();
    }
};



/**
 * 기업정보 조회(명으로 조회)
 */
scwin.fn_ComInfoSrch = function() {
    //데이터셋 초기화
    scwin.fn_InitDs("2");
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamic" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=krx.lds.stf.fis.select.comInfo" + "&outputMessageId=FIS_COM_INFO" + "&param01=" + $c.stf.getObjectValue(txb_CoSnm);
    dts_ComInfo.DataID = encodeURI(url);
    dts_ComInfo.Reset();

    // 조회결과가 1개이면 기업개황 조회 아니면 기업팝업 오픈.
    if (dts_ComInfo.getTotalRow() == 1) {
        // 조회조건에 값을 세팅하고..
        txb_KisCd.setValue(dts_ComInfo.getCellData(0, "KIS_CD"));
        txb_IndPttn.setValue(dts_ComInfo.getCellData(0, "IND_PTTN"));
        scwin.fn_Search(); // 기업개황 조회

    } else {
        scwin.fn_ComSrchOpen(); //기업검색 팝업 오픈

    }
};



/**
 * 기업검색 팝업
 */
scwin.fn_ComSrchOpen = async function() {
    await $c.frame.CreateDialogFrame("KIS_CD", "./ULDFIS00100_P1.gfm", "기업 검색", 100, 100, 640 + 20, 445 + 45, "window");
};


/**
 *  조회조건 유효성 체크
 */
scwin.fn_ChkValid = function() {
    //필수항목 체크.
    if ($c.stf.getObjectValue(txb_CoSnm) == "") {
        $c.win.alert("기업명을 입력하세요.");
        txb_CoSnm.focus();
        return false;
    }

    // 기업명은 있는데 기업코드가 없는 경우
    if ($c.stf.getObjectValue(txb_CoSnm) != "" && $c.stf.getObjectValue(txb_KisCd) == "") {
        scwin.fn_ComInfoSrch();
        return false;
    }
    return true;
};


/**
 * 기업개황 조회
 */
scwin.fn_Search = function() {
    //데이터셋 초기화
    scwin.fn_InitDs("1");

    // 조회조건 필수 체크.
    if (!scwin.fn_ChkValid()) {
        return;
    }
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamic" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=krx.lds.stf.fis.select.comOutLook" + "&outputMessageId=FIS_COM_OUT_LOOK" + "&param01=" + $c.stf.getObjectValue(txb_KisCd);
    dts_ComOutLook.DataID = encodeURI(url);
    dts_ComOutLook.Reset();

    //재무정보 조회
    if (dts_ComOutLook.getTotalRow() > 0) {
        scwin.fn_SearchFncInfo();
    }
};



/**
 * 기업개황_재무정보 조회
 */
scwin.fn_SearchFncInfo = function() {
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamic" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=krx.lds.stf.fis.select.fncInfo" + "&outputMessageId=FIS_FNC_INFO" + "&param01=" + $c.stf.getObjectValue(txb_KisCd) + "&param02=" + $c.stf.getObjectValue(txb_IndPttn);
    dts_FncInfo.DataID = encodeURI(url);
    dts_FncInfo.Reset();
};
scwin.gform_onload = function() {
    // 화면 초기화.

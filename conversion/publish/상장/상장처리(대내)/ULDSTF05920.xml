//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
// 호출메뉴ID를 식별하기 위한 함수사용
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
// 세션정보를 얻기위한 함수사용
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
// 상장관련공통함수
//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
scwin.vScrenID = "ULDSTF05920.xml";
scwin.fr_SecuGrpId = SECUGRP_ID_EW; // mid 부모프레임으로 부터 받은 menu id로 증권그룹id를 반환하는 함수 호출, 법인선택팝업에서 fr_SecuGrpId 변수를 참조. 
scwin.fr_MktId = $c.lc.fn_getMktId(); // 시장구분코드(유가, 코스닥) 전체), 기준은 로그인 사용자의 부서 소속을 기준으로 한다.

scwin.fn_GetPar, scwin.fn_SetPar;
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_search2 = function() {
    var url = "/Delisting.do?method=searchDelList" + "&DIV_IDX=" + DIV_IDX_DELLIST_LIST_INFO + "&TRS_IDX=" + TRS_IDX_SELECT + "&ISUR_CD=99999";
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts2.DataID = encodeURI(url);
    dts2.reset();
    $c.cm.ShowWin(grd2);
};
scwin.fn_GetParUpdate2 = function(arrPar) {
    // 넘길 인수를 지정하는 펑션
    arrPar[0] = scwin.fr_SecuGrpId; // 증권그룹구분	
    arrPar[1] = scwin.fr_MktId; // 시장구분
    arrPar[2] = dts2.getCellData(dts2.getRowPosition(), "bz_procs_no"); // 업무처리번호
    arrPar[3] = dts2.getCellData(dts2.getRowPosition(), "WRT_DD"); // 최종거래일

    return arrPar.length;
};
scwin.fn_GetParNew2 = function(arrPar) {
    // 신규생성시 지정하는 평션
    arrPar[0] = scwin.fr_SecuGrpId; // 증권그룹구분	
    arrPar[1] = scwin.fr_MktId; // 시장구분
    arrPar[2] = ""; // 신규작성시 업무처리번호는 없다.
    arrPar[3] = $c.ut.cGetToday("yyyymmdd");
};
scwin.fn_newpre_create_frame2 = async function() {
    await $c.frame.CreateDialogFrame("DLG_DELLIST", "../lstproc/ULDSTF05922.gfm", $c.lc.fn_getSecuGrpNm(scwin.fr_SecuGrpId) + " 행사종료일 1개월전(D-1MONTH) 상장폐지 예고", 200, 100, 680, 570, "window");
    scwin.fn_search2(); // 다이얼로그 창이 닫히면 조회를 보낸다.

};
scwin.img_Search2_onclick = function() {
    scwin.fn_search2();
};
scwin.dts2_OnLoadError = function() {
    $c.stf.alert_error(dts2);
};
scwin.dts2_OnLoadCompleted = function(rowcount) {
    txb_TotCnt2.setValue("총 " + rowcount + " 건");
    //dts2.RowPosition = rowcount;
    $c.cm.CloseWin(rowcount, grd2);
};
scwin.img_Close2_onclick = function() {
    window.close();
};
scwin.img_Regist2_onclick = function() {
    scwin.fn_GetPar = fn_GetParNew2;
    scwin.fn_SetPar = undefined;
    scwin.fn_newpre_create_frame2();
};
scwin.img_Excel2_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    if (dts2.getTotalRow() > 0) {
        $c.data.downloadGridViewExcel(grd2, $c.lc.fn_getSecuGrpNm(scwin.fr_SecuGrpId) + "행사종료일(D-30) 상장폐지 예고내역", "", "8");
    } else {
        $c.win.alert(NO_EXCEL_DATA);
    }
};
scwin.grd2_OnDblClick = function(row, colid) {
    scwin.fn_GetPar = fn_GetParUpdate2; // 수정시 인수를 넘기는 function을 fn_GetPar란 변수에 할당, (팝업화면에서 참조하는 변수명이 fn_GetPar임)
    scwin.fn_SetPar = undefined;
    scwin.fn_newpre_create_frame2();
};
scwin.gform_onload = function() {
    $c.libRoundPanel.PanelToGroupBox(pan_Cnd2);

    //img_Elwlist.ActiveIndex = 1 ;
    scwin.fn_search2();
};

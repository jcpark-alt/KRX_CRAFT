scwin.fn_Init = function() {
    var strBzProcsNo = $c.stf.getQuery(frame.srcUrl, "BZ_PROCS_NO");
    scwin.vBzProcsNo = strBzProcsNo;
    if (strBzProcsNo == "") {
        $c.stf.showObj(btn_Save, false);
        $c.win.alert("예비심사 내용을 저장 한 후에 예비심사절차를 등록하여 주십시오.");
    }
    $c.stf.setObjectValue(txb_BZ_PROCS_NO, strBzProcsNo);
    var url = "/Prelisting.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listPrepareStatus&inputMessageId=PREPARE_CORP_STATUS";
    url += "&BZ_PROCS_NO=" + strBzProcsNo;
    dts_Grid.DataID = url;
    dts_Grid.Reset();
    var sSEQ = $c.stf.getObjectValue(txb_BYBZPROCS_SEQ);
    //alert(dts_Grid.Text);

    if (sSEQ == "") {
        // 추가모드.
        dts_Grid.insertRow(); // syncload = true;
        dts_Grid.setCellData(1, "BZ_PROCS_NO", strBzProcsNo);
        dts_Grid.setCellData(1, "STEP01", "0");
        dts_Grid.setCellData(1, "STEP06", "0");

        sSTEP10 == "0" && sSTEP11 == "0" &&
        sSTEP12 == "0" && sSTEP13 == "0" &&
        sSTEP14 == "0" && sSTEP15 == "0" &&
        sSTEP17 == "0" && sSTEP18 == "0") {
        // 20180406
        $c.win.alert("저장할 상태가 없습니다.");
        return false;
    }

    //상장위원회 결과
    if (sSTEP17 == "1") {
        if (dts_Grid.getCellData(1, "STEP17_APPROV_YN") == '' || cSTEP17 == '') {
            $c.win.alert("'상장위원회결과 통보'의 '결과'와 '일자'는 필수값 입니다.");

scwin.fn_list_sync = function() {
    var vMarketTpCd = "";
    if (js_market == "1" || js_market == "2" || js_market == "6") {
        vMarketTpCd = js_market;
    } else {
        vMarketTpCd = $c.stf.getObjectValue(rdo_MARKET_TP_CD);
    }
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=LISTCERT_INOUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstmgt.certapprove.listCertificate.select.condition" + "&{P}param01=" + vMarketTpCd + // 시장구분
        "&{P}param02=" + vMarketTpCd + // 시장구분
        "&{P}param03=" + $c.stf.getObjectValue(rdo_LIST_CERT_PROCS_STAT_CD) + "&{P}param04=" + $c.stf.getObjectValue(rdo_LIST_CERT_PROCS_STAT_CD) + "&{P}param05=" + $c.stf.getObjectValue(txb_ISUR_CD) + "&{P}param06=" + $c.stf.getObjectValue(txb_ISUR_CD) + "&{P}param07=" + $c.stf.getObjectValue(edt_SDate) + "&{P}param08=" + $c.stf.getObjectValue(edt_EDate); // 법인코드


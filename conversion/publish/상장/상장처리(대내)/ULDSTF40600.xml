    } else {
        $c.stf.showObj(panel_mkt_gubun, true);
    }
    edt_SDate.setValue($c.ut.cGetMinusDate2($c.ut.cGetToday("yyyymmdd"), 7));
    edt_EDate.setValue($c.ut.cGetToday("yyyymmdd"));
    $c.stf.Combo_CBDataSetPeriod(cmb_PeriodTp);
    scwin.fn_list_sync();
    $c.cm.fn_com_isur(txb_ISUR_CD, txb_COM_NM);
};

    var url = "/CertificateApprove.do?method=listCertificate&inputMessageId=LISTCERT_INOUT";
    url += "&startDate="+edt_SDate.Text;
    url += "&endDate="+edt_EDate.Text;
    url += "&market_gubun="+market_gubun;
    */

    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_List);
};
scwin.fn_setId = function(obj) {
    scwin.list_cert_id = dts_List.getCellData(eval(obj), "LIST_CERT_APPL_ID");
};
scwin.fn_getId = function() {
    return scwin.list_cert_id;
};
scwin.btn_Search_onclick = function() {
    if ($c.stf.compareFromToDate2(edt_SDate, edt_EDate)) {

scwin.fn_list_sync = function() {
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=CASHDIV_DISCLS_SND_DATA_INOUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstmgt.cashdvdmgt.select.cashdiv.discls.list.condition" + "&{P}param01=" + $c.stf.getObjectValue(edt_TASK_DD) + "&{P}param02=" + scwin.fr_MktId + "&{P}param03=" + scwin.fr_MktId;
    dts_List_1.DataID = encodeURI(url);
    dts_List_1.reset();
    $c.cm.ShowWin(grd_List_1);
    url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=CASHDIV_DISCLS_SND_DATA_INOUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstmgt.cashdvdmgt.select.cashdiv.discls.make.condition" + "&{P}param01=" + $c.stf.getObjectValue(edt_TASK_DD) + "&{P}param02=" + scwin.fr_MktId + "&{P}param03=" + scwin.fr_MktId;
    dts_List_2.DataID = encodeURI(url);
    dts_List_2.reset();
    $c.cm.ShowWin(grd_List_2);

    dts_Item.DataID = encodeURI(url);
    dts_Item.reset();
};


// 클릭된 값 변수에 셋팅
scwin.fn_OpenDetail = function(row, colid) {
    var gViewerStat = "R"; // 처리시 뷰어=P,  조회시 뷰어=R

scwin.MxDataSet_com_isur_OnFilter = function(row) {
    if (skw != "" && foColum == "1") {
        f1 = MxDataSet_com_isur.getCellData(row, "COM_ABBRV");
        f2 = MxDataSet_com_isur.getCellData(row, "OLD_COM_ABBRV");
        if (f1.indexOf(skw) != -1 || f2.indexOf(skw) != -1) return true;

        else return false;
    } else return true;
};
scwin.txb_ISUR_CD_onkeyup = function() {
    if (txb_ISUR_CD.getValue() == "") {
        Grd_com_isur.style.display = "none";
    } else {
        if (window.event.keyCode == 40) {
            //아래화살표눌렀을때 그리드로 포커스
            Grd_com_isur.focus();
        } else {
            $c.cm.fn_com_isur_nm(window.event.keyCode);
        }
    }
};
scwin.txb_ISUR_CD_onfocus = function() {
    Grd_com_isur.style.display = "none";
};
scwin.txb_ISUR_CD_onblur = function() {
    if (stFocusGrid == false) {
        Grd_com_isur.style.display = "none";
    }
    if (txb_ISUR_CD.getValue() == "") {
        txb_COM_NM.setValue("");
    }

scwin.gform_onload = function() {
    $c.libRoundPanel.PanelToGroupBox(panel_1);
    var vCurDate = $c.ut.cGetToday("yyyymmdd");
    //edt_SDate.text = cGetMinusDate2(vCurDate, 7);
    edt_SDate.setValue("20110101");
    edt_EDate.setValue($c.ut.cGetToday("yyyymmdd")); // 현재날짜

    $c.stf.Combo_CBDataSetPeriod(cmb_PeriodTp);
    if (js_market == "1" || js_market == "2") {
        $c.stf.showObj(panel_mkt_gubun, false);
    } else {
        $c.stf.showObj(panel_mkt_gubun, true);
    }
    scwin.fn_SetCode();
    scwin.fn_setGrdCode();
    cmb_DELIST_REAL_INVSTG_RSN_CD.BindColVal = "";
    scwin.fn_list_sync();
    $c.cm.fn_com_isur(txb_ISUR_CD, txb_COM_NM);
};

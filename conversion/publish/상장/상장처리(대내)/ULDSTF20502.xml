scwin.fn_SetCode = function() {
    /*
    02549-상장폐지 실질심사 사유코드
    */
    var arrCid = [{
        cid: "DELIST_REAL_INVSTG_RSN_CD",
        cnm: "cmb_DELIST_REAL_INVSTG_RSN_CD"
    }];
    var objCod;
    var url = "/CodeAction.do?SCREN_ID=ULDSTF20502.gfm&SCREN_PROCES_TP_CD=01&method=listCodeValueNameM&inputMessageId=CODE_M_IN&outputMessageId=CODE_M_OUT" + "&CD_ID_M='DELIST_REAL_INVSTG_RSN_CD','DELIST_REAL_INVSTG_MISC_CD','AUDT_OPIN_TP_CD'";
    dts_Cod.DataID = encodeURI(url);
    dts_Cod.reset();
    var strCbd = "",
        i, j;
    for (i = 0; i < arrCid.length; i++) {
        objCod = document.getElementById(arrCid[i].cnm);
        if (objCod == null) {
            $c.win.alert(arrCid[i].cnm);
        }
        strCbd = "^전체,";
        for (j = 1; j <= dts_Cod.getTotalRow(); j++) {
            if (dts_Cod.getCellData(j, "CD_ENG_NM") == arrCid[i].cid) {
                strCbd = strCbd + (strCbd == "" ? "" : ",") + dts_Cod.getCellData(j, "VALUE") + "^" + dts_Cod.getCellData(j, "TEXT").replace(/,/g, "','");
            }
        }
        objCod.CBData = strCbd;
    }
};
scwin.fn_list_sync = function() {
    var pRealInvstgYN = "";
    if (chb_Grp_All.checked) {
        pRealInvstgYN = "Y";
    }
    var vMarketTpCd = "";
    if (js_market == "1" || js_market == "2") {
        vMarketTpCd = js_market;
    } else {
        vMarketTpCd = $c.stf.getObjectValue(rdo_MARKET_TP_CD);
    }
    var url = "/listingCommon.do?SCREN_ID=ULDSTF20502.gfm&SCREN_PROCES_TP_CD=01&method=listGeneral" + "&outputMessageId=REALINVSTG_SEARCH_NEW" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstsrch.select.delist.realinvstg.condition" + "&{P}param01=" + $c.stf.getObjectValue(txb_ISUR_CD) + "&{P}param02=" + $c.stf.getObjectValue(txb_ISUR_CD) + "&{P}param03=" + pRealInvstgYN + "&{P}param04=" + pRealInvstgYN + "&{P}param05=" + vMarketTpCd + "&{P}param06=" + vMarketTpCd + "&{P}param07=" + $c.stf.getObjectValue(cmb_DELIST_REAL_INVSTG_RSN_CD) + "&{P}param08=" + $c.stf.getObjectValue(cmb_DELIST_REAL_INVSTG_RSN_CD) + "&{P}param09=" + $c.stf.getObjectValue(edt_SDate) + "&{P}param10=" + $c.stf.getObjectValue(edt_EDate);
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.fn_OpenFile = async function(pRow, pColid) {
    var vProcsNo = "";
    if (pColid == "COM_ABBRV") {
        vProcsNo = dts_List.getCellData(pRow, "BZ_PROCS_NO");
        var url = "/lstsrch/ULDSTF20502_FILELIST.gfm?BZ_PROCS_NO=" + vProcsNo;
        await $c.frame.CreateDialogFrame("DELIB_CASE_ATTACH_FILE", url, "상장적격성 실질심사 첨부파일", 100, 0, 710, 300, "window");
    }
};
scwin.fn_setGrdCode = function() {
    var strCbdReason = "' ':"; //초기값
    var strAudtOpin = "' ':";
    for (k = 1; k <= dts_Cod.getTotalRow(); k++) {
        if (dts_Cod.getCellData(k, "CD_ENG_NM") == "DELIST_REAL_INVSTG_MISC_CD") {
            strCbdReason = strCbdReason + (strCbdReason == "" ? "" : ",") + dts_Cod.getCellData(k, "VALUE") + ":" + dts_Cod.getCellData(k, "TEXT");
        } else if (dts_Cod.getCellData(k, "CD_ENG_NM") == "AUDT_OPIN_TP_CD") {
            strAudtOpin = strAudtOpin + (strAudtOpin == "" ? "" : ",") + dts_Cod.getCellData(k, "VALUE") + ":" + dts_Cod.getCellData(k, "TEXT");
        }
    }
    $c.cm.setColumnProp(grd_Grid, 'DELIST_REAL_INVSTG_MISC_CD', 'Data', strCbdReason);
    $c.cm.setColumnProp(grd_Grid, 'THSBZYY_AUDT_OPIN_TP_CD', 'Data', strAudtOpin);
};

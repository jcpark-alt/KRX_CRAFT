    $c.cm.PanelToGroupBox(panel_2);
    $c.cm.PanelToGroupBox(panel_3);
    $c.cm.PanelToGroupBox(panel_4);
    edt_BASE_DD_4.setValue($c.ut.cGetToday("yyyymmdd"));
    MaxTab_01.setSelectedTabIndex(1);
    if (js_market == "1" || js_market == "2") {
        $c.stf.showObj(panel_mkt_gubun, false);
        $c.stf.setObjectValue(rdo_MARKET_TP_CD, js_market);
    }
};

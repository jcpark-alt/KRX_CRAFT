scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07); // 엑셀
    var tIndex = MaxTab_01.getSelectedTabIndex();
    var today = $c.ut.cGetToday("yyyymmddhhmmss");
    //파일형식 today_화면명.xls
    var xls_path = $c.session.getExcelDownPath() + today + "_상장통계_STF20000.xls";
    if (tIndex == 1) {
        $c.data.saveExcel(grd_List_1_1, "결산기별 주권 상장회사 현황(팀별)", false, false, false, xls_path);
        $c.data.downloadGridViewExcel(grd_List_1_2, "결산기별 주권 상장회사 현황(담당자별)", xls_path, 40);
    } else if (tIndex == 2) {
        $c.data.saveExcel(grd_List_2_1, "결산기별 주권 상장종목 현황(팀별)", false, false, false, xls_path);
        $c.data.downloadGridViewExcel(grd_List_2_2, "결산기별 주권 상장종목 현황(담당자별)", xls_path, 40);
    } else if (tIndex == 3) {
        $c.data.saveExcel(grd_List_3_1, "상장,매매주식개요(상장시스템)", false, false, false, xls_path);
        $c.data.downloadGridViewExcel(grd_List_3_2, "상장,매매주식개요(매매시스템)", xls_path, 40);
    } else if (tIndex == 4) {
        $c.data.downloadGridViewExcel(grd_List_4, "상장회사 및 종목수(" + $c.stf.getObjectValue(edt_BASE_DD_4) + ")", "", "8");
    }
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_mkt_gubun);

    scwin.vAcntclsEndDt = $c.frame.path("../frame_head").fn_GetAcntclsEndDt();
    if (scwin.vKisCd == "" || scwin.vAcntclsStrtDt == "" || scwin.vAcntclsEndDt == "") {
        return false;
    }
    return true;
};


/**
 * 관계회사현황 조회
 */
scwin.fn_Search = function() {
    //데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 체크.
    if (!scwin.fn_ChkValid()) {

        return;
    }
    $c.data.downloadGridViewExcel(grd_RelComStat, "관계회사현황", "", "8");
};
scwin.gform_onload = function() {
    scwin.fn_Init();
};
scwin.dts_RelComStat_OnLoadError = function() {

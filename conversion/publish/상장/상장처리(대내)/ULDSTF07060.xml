스크립트 수작업 유의사항
*/


//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/list_common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.vScrenID = "ULDSTF07060.xml";
scwin.vExcelTitle = "상장수수료_" + $c.ut.cGetToday("yyyymmdd");
scwin.fr_MktId = $c.lc.fn_getMktId(); // 시장구분코드(유가, 코스닥) 전체), 기준은 로그인 사용자의 부서 소속을 기준으로 한다.

scwin.clickBzProcsNo = "";
scwin.clickListProcsStatCd = "";
scwin.clickListBzDtlTpCd = "";
//수정요청 창에 넘겨주기 위한 변수
scwin.clickListInvstgBzTpCd = "160";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
}; //심사수수료

scwin.fn_list_sync = function() {
    var url = "/lstinvstg/ListFee.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=getList";
    url += "&LD_MKT_TP=" + $c.stf.getObjectValue(rdo_MKT_ID);
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.fn_setProcsNo = function(obj) {
    //alert(procsNo);
    scwin.clickBzProcsNo = dts_List.getCellData(eval(obj), "BZ_PROCS_NO");
    scwin.clickListProcsStatCd = dts_List.getCellData(eval(obj), "LIST_PROCS_STAT_CD");
    scwin.clickListBzDtlTpCd = dts_List.getCellData(eval(obj), "LIST_BZ_DTL_TP_CD");
};
scwin.fn_getProcsNo = function() {
    return scwin.clickBzProcsNo;
};
scwin.fn_OpenDetail = async function(row) {
    scwin.fn_setProcsNo(row);
    //수정요청 리스트 팝업창
    if ("34" == scwin.clickListProcsStatCd) {
        //수정요청 리스트 팝업창
        var adjreqUrl = "/lstinvstg/ULDSTF07090.gfm";
        await $c.frame.CreateDialogFrame("ULDSTF07090.gfm", adjreqUrl, "상장수수료 수정요청 리스트", 50, 50, 800, 300, "window");
    }
    await $c.frame.CreateDialogFrame("gform", "/lstinvstg/ULDSTF07061.gfm", "심사수수료", 10, 10, 700, 400, "window");
    //fn_list_sync();			

};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    $c.data.downloadGridViewExcel(grd_Grid, scwin.vExcelTitle, "", "8");
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.grd_Grid_OnDblClick = function(row, colid) {
    scwin.fn_OpenDetail(row);
};
scwin.gform_onload = function() {
    $c.stf.setObjectValue(rdo_MKT_ID, js_market);
    if (js_market == "1" || js_market == "2") {
        rdo_MKT_ID.setDisabled(true);
    } else {
        rdo_MKT_ID.setDisabled(false);
    }
    $c.cm.PanelToGroupBox(panel_Top);
    scwin.fn_list_sync();
};
]]></script>

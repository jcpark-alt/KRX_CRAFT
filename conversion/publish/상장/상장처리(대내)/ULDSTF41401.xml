    //기간조회
    var url = "/listingCommon.do?method=listGeneral" + "&outputMessageId=PERIOD_OUT" + "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + "&queryId=lds.stf.lstmgt.select.period.condition";

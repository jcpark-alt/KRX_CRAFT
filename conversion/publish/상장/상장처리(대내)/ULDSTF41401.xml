scwin.cmd_Period_OnSelChange = function() {
    scwin.periodYYYY = dts_Period.getCellData(dts_Period.getRowPosition(), "YYYY");
    scwin.periodTmCd = dts_Period.getCellData(dts_Period.getRowPosition(), "VALU_TM_TP_CD");
    if (scwin.periodYYYY >= scwin.basYYYY) {
        edt_SDate_all.setValue((scwin.periodYYYY - 1) + "0101");
        edt_EDate_all.setValue((scwin.periodYYYY - 1) + "1231");
    } else {
        edt_SDate_all.setValue(dts_Period.getCellData(dts_Period.getRowPosition(), "STRT_DD"));
        edt_EDate_all.setValue(dts_Period.getCellData(dts_Period.getRowPosition(), "END_DD"));
    }
};
scwin.dts_Period_OnLoadCompleted = function(rowcount) {
    scwin.periodYYYY = dts_Period.getCellData(dts_Period.getRowPosition(), "YYYY");
    scwin.periodTmCd = dts_Period.getCellData(dts_Period.getRowPosition(), "VALU_TM_TP_CD");

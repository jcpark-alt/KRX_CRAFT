            scwin.procJob = "담당자 확인";
            trs_Save.Action = $c.lc.fn_encodeNSession("/RepMajagnt.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02 + "&method=insertRepMajagntValuEmpNo");

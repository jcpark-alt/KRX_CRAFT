//담당자 확인 
scwin.fn_emplog = function() {
    if (dts_EmpNo.getTotalRow() > 0) {
        $c.win.alert("이미 담당자 확인을 하셨습니다.");
    } else {
        var res = window.confirm("담당자 확인을 하시겠습니까?");

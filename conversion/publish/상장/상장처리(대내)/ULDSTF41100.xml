    dts_Isu_1.setCellData(1, "ISUR_CD", dts_List_1.getCellData(row, "ISUR_CD"));
    dts_Isu_1.setCellData(1, "LIST_STAT_CD", dts_List_1.getCellData(row, "LIST_STAT_CD"));

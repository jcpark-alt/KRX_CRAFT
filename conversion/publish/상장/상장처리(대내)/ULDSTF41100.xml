};
scwin.fn_CheckForm = function() {
    if ($c.stf.getObjectValue(txb_ISUR_CD) == "") {
        $c.win.alert("[회사]를 선택하세요.");
        txb_ISUR_CD.focus();
        return false;
    }
    if (!$c.stf.checkEmptyValue(txb_WRNT_ISUR_NM, "한글발행사종목명")) return false;
    if (!$c.stf.checkMaxLength(txb_WRNT_ISUR_NM, 6, "한글발행사종목명")) return false;
    if (!$c.stf.checkEmptyValue(txb_WRNT_ISUR_ENG_NM, "영문발행사종목명")) return false;
    if (!$c.stf.checkMaxLength(txb_WRNT_ISUR_ENG_NM, 6, "영문발행사종목명")) return false;
    return true;
};
scwin.fn_save = function() {
    var TR_JOB;
    TR_JOB = 'I';
    if (scwin.fn_CheckForm()) {
        if (!$c.lc.fn_isProcess(TR_JOB)) return;

        //alert('[dts_Uly]'+dts_Uly.text);
        trs_Save.Action = $c.lc.fn_encodeNSession("/ELWUnderlyingAsset.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02 + "&method=saveELWIsurCd");

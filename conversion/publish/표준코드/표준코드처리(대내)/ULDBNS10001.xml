};

/********************************************** 
 * 함수명   : fn_Search
 * 설명       : 스트립종목정보를 조회한다.
 ***********************************************/
scwin.fn_Search = function() {
    var param = '';
    param += "&{P}V_BND_APPL_ID=" + scwin.vBndApplId;
    param += "&{P}V_BND_LIST_PROCS_TP_CD=" + scwin.vBndListProcsTpCd;
    var dsNm = 'BNS_STRIP_INFO';
    var qryId = 'lds.stf.bnschg.select.listStripIsuInfo';
    $c.bns.fn_SearchBns(scwin.vScrenID, dts_List, dsNm, qryId, param);
};


/********************************************** 
 * 함수명   : fn_SetParam
 * 설명       : 부모창에서 받은 데이터를 설정한다.
 ***********************************************/
scwin.fn_SetParam = function() {
    var prt = $c.frame.path("../");
    if (prt != undefined) {
        scwin.fn_GetPar = prt.scwin.fn_GetPar;
    }
    if (scwin.fn_GetPar != undefined) {
        var arrPar = new Array();
        scwin.fn_GetPar(arrPar);
        scwin.vBndApplId = arrPar[0].BND_APPL_ID;
        scwin.vBndListProcsTpCd = arrPar[0].BND_LIST_PROCS_TP_CD;
    }
};
scwin.gform_onload = function() {
    //패널라운드처리
    $c.bns.BnsPanelToGroupBox(pnl_Top);
    //호출파라미터설정
    scwin.fn_SetParam();
    //목록조회
    scwin.fn_Search();
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    txb_TotalCnt.setValue("총 " + rowcount + "건");
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
    var fileNm = $c.session.getExcelDownPath() + $c.ut.cGetToday("yyyymmddhhmmss") + "_스트립종목상세(신규).xls";

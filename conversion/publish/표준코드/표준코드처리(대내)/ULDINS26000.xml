    btn_search.setDisabled(false);
    btn_search.src = "../img/btn_select.gif";
};
scwin.btn_Excel_onclick = function() {
    if (dts_List.getTotalRow() <= 0) {
        $c.win.alert("조회된 데이터가 없습니다.");
        return;
    }
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07); // 로그 남기고..	
    var today = $c.ut.cGetToday("yyyymmddhhmmss");
    var title = "지표다운로드";
    var xls_path = $c.session.getExcelDownPath() + today + "_" + title + ".xls";
    $c.data.downloadGridViewOffice(grd_List, title, xls_path, 8, 0);
    //grd_List.GridToExcel(title, "", "8");

};

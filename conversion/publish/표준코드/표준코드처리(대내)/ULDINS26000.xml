 * 주권조회
 */
scwin.ins_search = function() {
    //데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 체크.
    if (!scwin.fn_ChkValid()) {
        return;
    }

    // Lodaing~~~ 표시
    $c.cm.ShowWin(grd_List);

    // 조회 버튼 클릭 후 바로 버튼 클릭 안되게 처리 20210528
    btn_search.setDisabled(true);
    btn_search.src = "../img/btn_select_d.gif";
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamicName" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.down.select.listStdCdIndcDownLoadInquiry" + "&outputMessageId=INS_LIST_STDCD_INDC_DOWNLOAD_INQUIRY" + "&{P}ACTIV_TP_CD=" + $c.stf.getObjectValue(cmb_ACTIV_TP_CD) + "&{P}STD_CD_GRNT_DD_FROM=" + $c.stf.getObjectValue(edt_FROM_STD_CD_GRNT_DD) + "&{P}STD_CD_GRNT_DD_TO=" + $c.stf.getObjectValue(edt_TO_STD_CD_GRNT_DD);
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};


/**
 * 사전체크
 */
scwin.fn_ChkValid = function() {
    // 코드부여일 체크
    if ($c.stf.compareFromToDate2(edt_FROM_STD_CD_GRNT_DD, edt_TO_STD_CD_GRNT_DD) == false) {
        return false;
    }
    return true;
};


/**
 * 체크박스 체크 시 그리드 항목 show
 */
scwin.fn_GridCtrl = function(pObj) {
    var sColId = pObj.id;
    sColId = sColId.replace("chb_", "");
    var bChecked = $c.stf.getObjectValue(pObj);
    if (bChecked == "Y" && $c.cm.getColumnProp(grd_List, sColId, "Show") != "TRUE") {
        $c.cm.setColumnProp(grd_List, sColId, "Show", true);
    } else if (bChecked == "N" && $c.cm.getColumnProp(grd_List, sColId, "Show") == "TRUE") {
        $c.cm.setColumnProp(grd_List, sColId, "Show", false);
    }
    //grd_List.AutoResizeAllCol(true);

};




/**
 * 전체선택 체크 시 나머지 모두 언체크.
 */
scwin.fn_AllUnCheck = function() {
    var sAllChecked = $c.stf.getObjectValue(chb_ALL);
    var oCheckBoxs = document.getElementsByName("chk");
    for (var nRow = 0; nRow < oCheckBoxs.length; nRow++) {
        oCheckBoxs[nRow].setValue((sAllChecked == "Y") ? true : false);
        scwin.fn_GridCtrl(oCheckBoxs[nRow]);
    }
};

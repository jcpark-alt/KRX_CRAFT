 ***********************************************/
scwin.ins_search = function() {
    var queryId = "";
    queryId = "lds.ins.corpinfo.select.listTbldBIsuInstHistoryInquiry";
    //alert(queryId); 
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=ULDINS05600_AF_DETAIL_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=" + queryId + "&{P}param01=" + scwin.param1;
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
};



/**
 * 발생기관 팝업에서 값 받음.
 */
scwin.fn_GetParam = function(arrPar) {
    arrPar[0] = txb_param1.getValue();
    arrPar[1] = txb_param2.getValue();
    return
    // ********************************************************************
    // [WebSquare 전환 추가] 원본 소스와 비교 필요
    // 
    // ********************************************************************
    arrPar, length;
};
scwin.gform_onload = function() {
    var arrPar = new Array();
    var parentWin = $c.frame.path("../");
    var fn_GetPar = parentWin.fn_GetParam;
    if (fn_GetPar != undefined) {
        fn_GetPar(arrPar);
        scwin.param1 = ((arrPar.length >= 1) && (arrPar[0] != undefined) ? arrPar[0] : "");
        //  param2  = ((arrPar.length >= 1) && (arrPar[1] != undefined) ? arrPar[1] : "");

        scwin.ins_search();
    }
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.btn_close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    //alert('dts_List.OnLoadCompleted('+rowcount+')');

};
scwin.grd_Grid_OnDblClick = function(row, colid) {

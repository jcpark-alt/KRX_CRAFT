    dts_List.Reset();
};


/**
 * 사전체크
 */
scwin.fn_ChkValid = function() {
    // 코드부여일 체크
    if ($c.stf.compareFromToDate2(edt_FROM_STD_CD_GRNT_DD, edt_TO_STD_CD_GRNT_DD) == false) {
        return false;
    }
    return true;
};


/**
 * 체크박스 체크 시 그리드 항목 show
 */
scwin.fn_GridCtrl = function(pObj) {
    var sColId = pObj.id;
    sColId = sColId.replace("chb_", "");
    var bChecked = $c.stf.getObjectValue(pObj);
    if (bChecked == "Y" && $c.cm.getColumnProp(grd_List, sColId, "Show") != "TRUE") {
        $c.cm.setColumnProp(grd_List, sColId, "Show", true);
    } else if (bChecked == "N" && $c.cm.getColumnProp(grd_List, sColId, "Show") == "TRUE") {
        $c.cm.setColumnProp(grd_List, sColId, "Show", false);
    }
    //grd_List.AutoResizeAllCol(true);

};




/**
 * 전체선택 체크 시 나머지 모두 언체크.
 */
scwin.fn_AllUnCheck = function() {
    var sAllChecked = $c.stf.getObjectValue(chb_ALL);
    var oCheckBoxs = document.getElementsByName("chk");
    for (var nRow = 0; nRow < oCheckBoxs.length; nRow++) {
        oCheckBoxs[nRow].setValue((sAllChecked == "Y") ? true : false);
        scwin.fn_GridCtrl(oCheckBoxs[nRow]);
    }
};

scwin.ins_search = function() {
    //데이터셋 초기화
    scwin.fn_InitDs();

    // 조회조건 체크.
    if (!scwin.fn_ChkValid()) {
        return;
    }

    // Lodaing~~~ 표시
    $c.cm.ShowWin(grd_List);

    // 조회 버튼 클릭 후 바로 버튼 클릭 안되게 처리 20210528
    btn_search.setDisabled(true);
    btn_search.src = "../img/btn_select_d.gif";
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamicName" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.down.select.listStdCdFtrOptDownLoadInquiry" + "&outputMessageId=INS_LIST_STDCD_FTROPT_DOWNLOAD_INQUIRY" + "&{P}ACTIV_TP_CD=" + $c.stf.getObjectValue(cmb_ACTIV_TP_CD) + "&{P}STD_CD_GRNT_DD_FROM=" + $c.stf.getObjectValue(edt_FROM_STD_CD_GRNT_DD) + "&{P}STD_CD_GRNT_DD_TO=" + $c.stf.getObjectValue(edt_TO_STD_CD_GRNT_DD) + "&{P}FUTOPT_LIST_TP=" + $c.stf.getObjectValue(cmb_FUTOPT_LIST_TP_CD) + "&{P}FUTOPT_UPCLSS_CD=" + $c.stf.getObjectValue(cmb_FUTOPT_UPCLSS_CD) + "&{P}LIST_DD_TP=" + $c.stf.getObjectValue(cmb_ListDdTp) + "&{P}LIST_DD_FROM=" + $c.stf.getObjectValue(edt_FROM_LIST_DD) + "&{P}LIST_DD_TO=" + $c.stf.getObjectValue(edt_TO_LIST_DD);
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};


/**
 * 사전체크
 */
scwin.fn_ChkValid = function() {
    // 시장구분이 [전체, KSE] 선택 시 KSE상장일 필수 및 6개월 제한.
    var sListTp = $c.stf.getObjectValue(cmb_FUTOPT_LIST_TP_CD);
    if (sListTp == "" || sListTp == "K") {
        if (($c.stf.getObjectValue(edt_FROM_LIST_DD) == "" || $c.stf.getObjectValue(edt_TO_LIST_DD) == "") &&
            ($c.stf.getObjectValue(edt_FROM_STD_CD_GRNT_DD) == "" || $c.stf.getObjectValue(edt_TO_STD_CD_GRNT_DD) == "")) {
            $c.win.alert(" 시장구분이 [전체, KSE] 인 경우 \n 코드부여일 또는 상장일을 1년 이내로 입력해야 합니다.");
            edt_FROM_STD_CD_GRNT_DD.focus();
            return false;
        } else {
            // 코드부여일
            if (($c.stf.getObjectValue(edt_FROM_STD_CD_GRNT_DD) != "" && $c.stf.getObjectValue(edt_TO_STD_CD_GRNT_DD) != "") &&
                eval($c.ut.cGetPlusYear(edt_FROM_STD_CD_GRNT_DD.getValue(), 1)) < eval(edt_TO_STD_CD_GRNT_DD.getValue())) {
                $c.win.alert("코드부여일의 검색 기간은 1년 이내로만 가능합니다.");
                edt_FROM_STD_CD_GRNT_DD.focus();
                return false;
            }

            // 상장일
            if (($c.stf.getObjectValue(edt_FROM_LIST_DD) != "" && $c.stf.getObjectValue(edt_TO_LIST_DD) != "") &&
                eval($c.ut.cGetPlusYear(edt_FROM_LIST_DD.getValue(), 1)) < eval(edt_TO_LIST_DD.getValue())) {
                $c.win.alert("상장일의 검색 기간은 1년 이내로만 가능합니다.");
                edt_FROM_LIST_DD.focus();
                return false;
            }
        }
    }
    // 코드부여일 체크
    if ($c.stf.compareFromToDate2(edt_FROM_STD_CD_GRNT_DD, edt_TO_STD_CD_GRNT_DD) == false) {
        return false;
    }

    // 발행일 체크
    if ($c.stf.compareFromToDate2(edt_FROM_LIST_DD, edt_TO_LIST_DD) == false) {
        return false;
    }
    return true;
};


/**
 * 체크박스 체크 시 그리드 항목 show
 */
scwin.fn_GridCtrl = function(pObj) {
    var sColId = pObj.id;
    sColId = sColId.replace("chb_", "");
    var bChecked = $c.stf.getObjectValue(pObj);
    if (bChecked == "Y" && $c.cm.getColumnProp(grd_List, sColId, "Show") != "TRUE") {
        $c.cm.setColumnProp(grd_List, sColId, "Show", true);
    } else if (bChecked == "N" && $c.cm.getColumnProp(grd_List, sColId, "Show") == "TRUE") {
        $c.cm.setColumnProp(grd_List, sColId, "Show", false);
    }
    //grd_List.AutoResizeAllCol(true);

};




/**
 * 전체선택 체크 시 나머지 모두 언체크.
 */
scwin.fn_AllUnCheck = function() {
    var sAllChecked = $c.stf.getObjectValue(chb_ALL);
    var oCheckBoxs = document.getElementsByName("chk");
    for (var nRow = 0; nRow < oCheckBoxs.length; nRow++) {
        oCheckBoxs[nRow].setValue((sAllChecked == "Y") ? true : false);
        scwin.fn_GridCtrl(oCheckBoxs[nRow]);
    }
};



/**
 * 상장상태가 [전체, 비상장, 상장폐지]인 경우 일자를 기본값으로 세팅.
 */

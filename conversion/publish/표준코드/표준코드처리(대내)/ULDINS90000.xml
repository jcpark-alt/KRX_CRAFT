scwin.vScrenID = "ULDINS90000.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};


/********************************************** 
 * 함수명   : ins_search
 * 설명       : 국가 코드 조회한다.
 ***********************************************/
scwin.ins_search = function(cntrNm) {
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneral" + "&outputMessageId=ULDINS90000_LIST_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.common.select.listNatCdInquiry" + "&{P}param01=" + cntrNm + "&{P}param02=" + cntrNm;
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
};
scwin.grd_Grid_OnDblClick = async function(row, colid) {
    var CNTR_CD = dts_List.getCellData(row, "CNTR_CD");
    var CNTR_NM = dts_List.getCellData(row, "CNTR_NM");
    $c.frame.path("../").ins_popupRtn_cdnm(CNTR_CD, CNTR_NM);
    await $c.frame.CloseFrame();
};
scwin.btn_close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.btn_search_onclick = function() {
    scwin.ins_search(txb_CNTR_NM.getValue());
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        txb_TotalCnt.setValue("총 " + rowcount + "건");
    }
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.txb_CNTR_NM_onkeyup = function() {
    fn_DelChar(this);
    if (txb_CNTR_NM.getValue() == "") {

    } else {
        if (window.event.keyCode == 13) {
            scwin.ins_search(txb_CNTR_NM.getValue());
        } else {

        }
    }
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_2);
    txb_CNTR_NM.focus();
};
]]></script>

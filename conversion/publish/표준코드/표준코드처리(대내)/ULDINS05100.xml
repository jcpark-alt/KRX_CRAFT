/********************************************** 
 * 함수명   : ins_search
 * 설명       : 워런트발행기관 조회한다.
 ***********************************************/
scwin.ins_search = function() {
    var url = "/listingCommon.do?SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 + "&method=listGeneralForDynamicName" + "&outputMessageId=ULDINS05100_LIST_OUT" + "&service=krx.lds.ins.listingcommon.services.ListingCommonApp" + "&queryId=lds.ins.corpinfo.select.readCorpElwInfoView" + "&{P}ISUR_CD=" + txb_pISUR_CD.getValue() + "&{P}WRNT_ISUR_CD_YN=" + $c.stf.getObjectValue(cmb_WRNT_ISUR_CD_YN) + "&{P}ISUR_APPL_SDATE=" + $c.stf.getObjectValue(edt_pISUR_APPL_SDATE) + "&{P}ISUR_APPL_EDATE=" + $c.stf.getObjectValue(edt_pISUR_APPL_EDATE) + "&{P}ACTIV_YN=" + $c.stf.getObjectValue(cmb_pACTIV_YN) + "&{P}SECU_TP1=" + $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD1_1) + "&{P}SECU_TP2=" + $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD2_1) + "&{P}SECU_TP3=" + $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD3_1) + "&{P}SECU_TP4=" + $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD4_1);
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
};


/********************************************** 
 * 함수명   : ins_register
 * 설명       : 워런트발행기관 신규 접수 등록한다.
 ***********************************************/
scwin.ins_register = function() {
    var str = "";
    var str1 = "";
    var SCREN_PROCS_TP_CD = "";
    if (txb_WRNT_ISUR_CD.getValue() == "") {
        str = "파생상품발행기관코드 등록";
        str1 = "저장";
        SCREN_PROCS_TP_CD = SCREN_PROCS_TP_CD_02;
    } else {
        str = "수정";
        str1 = "수정";
        SCREN_PROCS_TP_CD = SCREN_PROCS_TP_CD_03;
    }
    if ($c.stf.getObjectValue(txb_WRNT_ISUR_NM) == "") {
        $c.win.alert($c.stf.getMessageParam("MSG-A005", "파생상품발행자명(한글)"));
        txb_WRNT_ISUR_NM.focus();
        return;
    }
    if ($c.stf.getObjectValue(txb_WRNT_ISUR_ENG_NM) == "") {
        $c.win.alert($c.stf.getMessageParam("MSG-A005", "파생상품발행자명(영문)"));
        txb_WRNT_ISUR_ENG_NM.focus();
        return;
    }
    if (!$c.stf.checkMaxLength(txb_WRNT_ISUR_NM, 6, "파생상품발행자명(한글)")) {
        //txb_COM_NM.value = "";
        txb_WRNT_ISUR_NM.focus();
        return false;
    }
    if (!$c.stf.checkMaxLength(txb_WRNT_ISUR_ENG_NM, 6, "파생상품발행자명(영문)")) {
        //txb_COM_NM.value = "";
        txb_WRNT_ISUR_ENG_NM.focus();
        return false;
    }

    //textarea 개행문자제거
    //txa_WRNT_MEMO_CONTN.text = txa_WRNT_MEMO_CONTN.text.replace(/[\r|\n]/g, "");

    if (!confirm(str + " 하시겠습니까?")) {
        return;
    }
    //dts_detail.setDataHeader(); // W-Craft 주석처리 및 필요시 asis 파라미터 확인 
    dts_detail.insertRow();
    dts_detail.setCellData(1, "ISUR_CD", txb_ISUR_CD.getValue());
    dts_detail.setCellData(1, "WRNT_ISUR_CD", txb_WRNT_ISUR_CD.getValue());
    dts_detail.setCellData(1, "WRNT_ISUR_NM", txb_WRNT_ISUR_NM.getValue());
    dts_detail.setCellData(1, "WRNT_ISUR_ENG_NM", txb_WRNT_ISUR_ENG_NM.getValue());
    dts_detail.setCellData(1, "ELS_DLS_ISUR_CD", txb_ELSDLS_ISUR_CD.getValue());
    dts_detail.setCellData(1, "WRNT_MEMO_CONTN", txa_WRNT_MEMO_CONTN.text);
    dts_detail.setCellData(1, "CRUD", str1);
    dts_detail.setCellData(1, "TP_CD1", $c.stf.getObjectValue(txb_ISUR_SECU_TP_CD1));
    dts_detail.setCellData(1, "TP_CD2", $c.stf.getObjectValue(txb_ISUR_SECU_TP_CD2));
    dts_detail.setCellData(1, "TP_CD3", $c.stf.getObjectValue(txb_ISUR_SECU_TP_CD3));
    dts_detail.setCellData(1, "TP_CD4", $c.stf.getObjectValue(txb_ISUR_SECU_TP_CD4));
    trs_save.Action = "/CorpInfoAction.do?method=registerWrntIsurCd" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD;
    trs_save.KeyName = "toinb_dataid4";
    trs_save.KeyValue = "JSP(I:pInput=dts_detail)";
    trs_save.Parameters = "EMP_NO=" + js_emp_no + ",EMP_NM=" + js_emp_nm + ",EMAIL=" + js_email;
    trs_save.Post();
};


/********************************************** 
 * 함수명   : fn_set_ISUR_SECU_TP_CD
 * 설명 : 그리드가 선택될때마다 발행가능증권 구분자 체크박스 자동 체크        
 ***********************************************/
scwin.fn_set_ISUR_SECU_TP_CD = function(row) {
    var BND_ISUR_SECU_TP_CD1 = dts_List.getCellData(row, "ISUR_SECU_TP_CD1");
    var BND_ISUR_SECU_TP_CD2 = dts_List.getCellData(row, "ISUR_SECU_TP_CD2");
    var BND_ISUR_SECU_TP_CD3 = dts_List.getCellData(row, "ISUR_SECU_TP_CD3");
    var BND_ISUR_SECU_TP_CD4 = dts_List.getCellData(row, "ISUR_SECU_TP_CD4");
    if (BND_ISUR_SECU_TP_CD1 == "Y") {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD1, "Y");
    } else {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD1, "N");
    }
    if (BND_ISUR_SECU_TP_CD2 == "Y") {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD2, "Y");
    } else {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD2, "N");
    }
    if (BND_ISUR_SECU_TP_CD3 == "Y") {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD3, "Y");
    } else {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD3, "N");
    }
    if (BND_ISUR_SECU_TP_CD4 == "Y") {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD4, "Y");
    } else {
        $c.stf.setObjectValue(ckb_ISUR_SECU_TP_CD4, "N");
    }
};



/********************************************** 
 * 함수명   : fn_sel_ISUR_SECU_TP_CD
 * 설명 : 발행가능증권 구분자 체크될때마다 바인딩된 txtbox 에 값 설정
 ***********************************************/
scwin.fn_sel_ISUR_SECU_TP_CD = function(chk) {
    var chkDiv = chk;
    if (chkDiv == "1") {
        $c.stf.setObjectValue(txb_ISUR_SECU_TP_CD1, $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD1));
    } else if (chkDiv == "2") {
        $c.stf.setObjectValue(txb_ISUR_SECU_TP_CD2, $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD2));
    } else if (chkDiv == "3") {
        $c.stf.setObjectValue(txb_ISUR_SECU_TP_CD3, $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD3));
    } else {
        $c.stf.setObjectValue(txb_ISUR_SECU_TP_CD4, $c.stf.getObjectValue(ckb_ISUR_SECU_TP_CD4));
    }
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    $c.cm.PanelToGroupBox(panel_2);
    $c.stf.showObj(txb_ISUR_SECU_TP_CD1, false);
    $c.stf.showObj(txb_ISUR_SECU_TP_CD2, false);
    $c.stf.showObj(txb_ISUR_SECU_TP_CD3, false);
    $c.stf.showObj(txb_ISUR_SECU_TP_CD4, false);

    //fn_setFromToDate(1,edt_pISUR_APPL_SDATE,edt_pISUR_APPL_EDATE); 
    cmb_WRNT_ISUR_CD_YN.setSelectedIndex(2);
    txb_pISUR_CD.focus();
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    if (dts_List.errorMsg) {
        $c.win.alert(dts_List.errorMsg);
    } else {
        txb_TotalCnt.setValue("총 " + rowcount + "건");
        scwin.fn_set_ISUR_SECU_TP_CD("1");
    }
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.btn_search_onclick = function() {

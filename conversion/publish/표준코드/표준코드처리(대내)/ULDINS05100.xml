};
scwin.trs_save_OnSuccess = function() {
    $c.win.alert('파생상품발행기관 저장되었습니다.');
    scwin.ins_search();
};
scwin.ckb_ISUR_SECU_TP_CD2_onclick = function() {
    scwin.fn_sel_ISUR_SECU_TP_CD("2");
};
scwin.ckb_ISUR_SECU_TP_CD1_onclick = function() {
    scwin.fn_sel_ISUR_SECU_TP_CD("1");
};
scwin.ckb_ISUR_SECU_TP_CD3_onclick = function() {
    scwin.fn_sel_ISUR_SECU_TP_CD("3");
};
scwin.ckb_ISUR_SECU_TP_CD4_onclick = function() {
    scwin.fn_sel_ISUR_SECU_TP_CD("4");
};
scwin.grd_Grid_OnClick = function(row, colid) {
    if (row == 0) return;
    scwin.fn_set_ISUR_SECU_TP_CD(row);
};
scwin.grd_Grid_OnColumnPosChanged = function(row, colid) {
    if (row == 0) return;
    scwin.fn_set_ISUR_SECU_TP_CD(row);
};
]]></script>

<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="연계공시신청안내">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="pop_contents" id="" meta_componentContainer="true" style="">
    		<xf:group class="msgbox " id="" style="">
    			<xf:group id="" tagname="ul" class="txt_list char circle">
    				<xf:group tagname="li" id="">
    					<w2:textbox class="" id=""
    						label="지주회사의 신청내용을 근거로 하여서만 상장자회사의 수시공시 내용이 지주횟 ㅏ종목공시에 연계하여 공표되므로, 연계공시 신청서 작성시 착오가 발생하지 않도록 주의하시기 바라며, 변동사실* 발생시에는 동 사실을 즉시 정정하여 신청서를 제출하여야 함"
    						style="">
    					</w2:textbox>
    					<w2:textbox class="" id="" label="* 변동사실" style=""></w2:textbox>
    					<xf:group class="txt_list char ko" id="" tagname="ul" style="">
    						<xf:group id="" tagname="li">
    							<w2:textbox class="" id="" label="상장 여부의 변동, 상장된 증권시장의 이동 등" style=""></w2:textbox>
    						</xf:group>
    						<xf:group id="" tagname="li" style="">
    							<w2:textbox class="" id="" label="지주회사가 소유하고 있는 상장자회사 주식의 최근 사업연도말 재무제표상 가액이 지주회사의 최근 사업연도말 자산총액의 10% 이상.미만 등" style=""></w2:textbox>
    						</xf:group>
    					</xf:group>
    				</xf:group>
    				<xf:group id="" tagname="li" style="">
    					<w2:textbox class="" id="" label="상장자회사의 변동사실을 거래소에 미신고함으로써 발생하는 모든 책임은 지주회사에게 있음" style=""></w2:textbox>
    				</xf:group>
    				<xf:group id="" style="" tagname="li">
    					<w2:textbox class="" id="" label="정정공시의 경우에는 연계공시 적용일 이후의 공시내용이 정정되는 경우에 한하여만 연계공표되므로 적용일 이전의 상장자회사가 제출한 수시공시 내용에 대한 정정공시에 대하여는 지주회사가 이를 별도로 제출하여야 함" style=""></w2:textbox>
    				</xf:group>
    				<xf:group id="" style="" tagname="li">
    					<w2:textbox class="" id="" label="지주회사 - 자회사간 상장된 증권시장이 상이한 경우에는 자회사 공시내용의 지주회사 연계공표시 자회사가 상장된 증권시장을 기준으로 생성됨을 원칙으로 함" style=""></w2:textbox>
    				</xf:group>
    				<xf:group id="" style="" tagname="li">
    					<w2:textbox class="" id="" label="연계공시 신청에 의하여 상장자회사의 수시공시 내용이 지주회사의 별도 공시제출없이 증권시장에 공표된 경우, 연계공시 내용에 대한 지주회사의 공시내용 정정을 위한 수정.편집 기능은 제공하지 않음" style=""></w2:textbox>
    				</xf:group>
    				<xf:group id="" style="" tagname="li">
    					<w2:textbox class="" id="" label="상장자회사가 상장폐지된 후 신규상장(재상장), 이전상장 등 사실이 발생하고 그 자회사가 상장 당시에 제출한 공시내용에 대한 정정공시를 제출하는 경우에는 지주회사에 연계공시가 생성되지 않음" style=""></w2:textbox>
    				</xf:group>
    			</xf:group></xf:group>
    		<xf:group class="msgbox " id="" style="">
    			<xf:group id="" class="tac">
    				<xf:select1 ref="" appearance="full" disabled="" style="" id="" renderType="radiogroup" rows="" cols=""
    					selectedIndex="1">
    					<xf:choices>
    						<xf:item>
    							<xf:label><![CDATA[위 내용에 동의하지 않음]]></xf:label>
    							<xf:value><![CDATA[]]></xf:value>
    						</xf:item>
    						<xf:item>
    							<xf:label><![CDATA[위 내용에 동의함]]></xf:label>
    							<xf:value><![CDATA[]]></xf:value>
    						</xf:item>
    					</xf:choices>
    				</xf:select1>
    			</xf:group>
    		</xf:group>
    		<xf:group class="btnbox" id="" style="">
    			<xf:group class="rt" id="" style="">
    				<xf:trigger class="btn_cm pt" id="" style="" type="button">
    					<xf:label><![CDATA[제출]]></xf:label>
    				</xf:trigger>
    				<xf:trigger class="btn_cm " id="" style="" type="button">
    					<xf:label><![CDATA[취소]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>

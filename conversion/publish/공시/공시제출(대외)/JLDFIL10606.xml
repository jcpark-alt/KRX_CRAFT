<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="제출완료">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" meta_componentContainer="true" style="">
    		<xf:group class="step_list" id="" tagname="ul" style="">
    			<xf:group class="" id="" style="" tagname="li">
    				<w2:span id="" label="공시작성" style=""></w2:span>
    			</xf:group>
    			<xf:group aria-hidden="true" class="line" id="" style="" tagname="li"></xf:group>
    			<xf:group id="" tagname="li" class="wip">
    				<w2:span id="" label="문서내용확인" style=""></w2:span>
    			</xf:group>
    			<xf:group aria-hidden="true" class="line" id="" style="" tagname="li"></xf:group>
    			<xf:group id="" tagname="li" class="">
    				<w2:span id="" label="제출정보입력" style=""></w2:span>
    			</xf:group>
    			<xf:group aria-hidden="true" class="line" id="" style="" tagname="li"></xf:group>
    			<xf:group id="" style="" tagname="li">
    				<w2:span id="" label="인증" style=""></w2:span>
    			</xf:group>
    			<xf:group aria-hidden="true" class="line" id="" style="" tagname="li"></xf:group>
    			<xf:group id="" style="" tagname="li" class="wip">
    				<w2:span id="" label="최종확인" style=""></w2:span>
    			</xf:group>
    			<xf:group aria-hidden="true" class="line" id="" style="" tagname="li"></xf:group>
    			<xf:group class="wip" id="" style="" tagname="li">
    				<w2:span id="" label="제출완료" style=""></w2:span>
    			</xf:group>
    		</xf:group>
    		<xf:group class="titbox" id="" style="">
    			<w2:textbox class="txt_info" id="" label="공시제출 결과 입니다." style="" escape="false"></w2:textbox>
    			<xf:group class="rt" id="" style="">
    				<xf:trigger class="btn_cm " id="" style="" type="button">
    					<xf:label><![CDATA[도움말]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<w2:textbox class="txt_info blue tac bold" escape="false" id="" label="공시제출이 정상 접수되었습니다." style=""></w2:textbox>
    		<w2:textbox class="txt_info orange tac" escape="false" id="" label="공시처리결과는 제출정보에서 입력하신 이메일과 SMS를 통해 보내드립니다." style="">
    		</w2:textbox>
    		<w2:textbox class="txt_info orange tac" escape="false" id="" label="처리 진행상황은 '제추현황'에서 확인 하실 수 있습니다." style=""></w2:textbox>
    		<xf:group class="btnbox" id="" style="">
    			<xf:group class="rt" id="" style="">
    				<xf:trigger class="btn_cm " id="" style="" type="button">
    					<xf:label><![CDATA[제출현황바로가기]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>

<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="인증서등록">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
            <w2:dataCollection baseNode="map"/>
            <w2:workflowCollection/>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.onpageload = function() {
	
};
]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="sub_contents" id="" meta_componentContainer="true" style="">
    		<xf:group class="pgtbox" id="" style="">
    			<w2:textbox class="pgt_tit" id="" label="인증서등록" style="" tagname=""></w2:textbox>
    			<xf:group class="breadcrumb" id="" style="">
    				<xf:group id="" style="" tagname="ul">
    					<xf:group class="home" id="" style="" tagname="li">
    						<w2:anchor id="" outerDiv="false" style="">
    							<xf:label><![CDATA[Home]]></xf:label>
    						</w2:anchor>
    					</xf:group>
    					<xf:group id="" style="" tagname="li">
    						<w2:anchor id="" outerDiv="false" style="">
    							<xf:label><![CDATA[1Depth Menu]]></xf:label>
    						</w2:anchor>
    					</xf:group>
    					<xf:group id="" style="" tagname="li">
    						<w2:anchor id="" outerDiv="false" style="">
    							<xf:label><![CDATA[2Depth Menu]]></xf:label>
    						</w2:anchor>
    					</xf:group>
    					<xf:group id="" style="" tagname="li">
    						<w2:span id="" label="3Depth Menu" style=""></w2:span>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    		<xf:group class="lybox" id="" style="">
    			<xf:group adaptiveThreshold="" class=" col_5" id="" meta_componentContainer="true" style="">
    				<xf:group class="titbox mt0" id="" style="">
    					<w2:textbox class="" id="" label="인증서 등록" style="" tagname="h3"></w2:textbox>
    					<xf:group class="rt" id="" style="">
    						<xf:trigger class="btn_cm" id="" style="" type="button">
    							<xf:label><![CDATA[등록하기]]></xf:label>
    						</xf:trigger>
    					</xf:group>
    				</xf:group>
    				<xf:group id="" tagname="ul" style="" class="txt_list">
    					<xf:group id="" tagname="li">
    						<w2:textbox class="" for="" id="" label="법인용 공인인증서만 등록 가능하며, 등록된 인증서 이외의 공인인증서는 공시제출 시 사용하실 수 없습니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    					<xf:group id="" tagname="li" style="">
    						<w2:textbox class="" for="" id="" label="공인인증서 등록 후에는 사설인증서를 사용하실 수 없습니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    					<xf:group id="" tagname="li" style="">
    						<w2:textbox class="" for="" id="" label="인증서 발급과 관련된 업무는 인증서 등록기관이나 대행기관을 이용하세요." style="" tagname=""></w2:textbox>
    					</xf:group>
    				</xf:group>
    				<xf:group class="titbox" id="" style="">
    					<w2:textbox class="" id="" label="등록 인증서 조회" style="" tagname="h3"></w2:textbox>
    					<xf:group class="rt" id="" style="">
    						<xf:trigger class="btn_cm" id="" style="" type="button">
    							<xf:label><![CDATA[조회하기]]></xf:label>
    						</xf:trigger>
    					</xf:group>
    				</xf:group>
    				<xf:group id="" tagname="ul" style="" class="txt_list">
    					<xf:group id="" tagname="li">
    						<w2:textbox class="" for="" id="" label="등록하신 인증서의 정보를 조회할 수 있습니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    					<xf:group id="" tagname="li" style="">
    						<w2:textbox class="" for="" id="" label="인증서가 유효하지 않거나 만료일이 도래한 인증서는 해당 인증서의 발급기관을 통해 재발급 받으신 후 재등록 절차를 통해 등록하십시요." style="" tagname=""></w2:textbox>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    			<xf:group class=" col_5" id="" meta_componentContainer="true" style="">
    				<xf:group class="titbox mt0" id="" style="">
    					<w2:textbox class="" id="" label="인증서 재등록" style="" tagname="h3"></w2:textbox>
    					<xf:group class="rt" id="" style="">
    						<xf:trigger class="btn_cm" id="" style="" type="button">
    							<xf:label><![CDATA[재등록하기]]></xf:label>
    						</xf:trigger>
    					</xf:group>
    				</xf:group>
    				<xf:group id="" tagname="ul" style="" class="txt_list">
    					<xf:group id="" tagname="li">
    						<w2:textbox class="" for="" id="" label="법인용 공인인증서만 재등록 가능합니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    					<xf:group id="" tagname="li" style="">
    						<w2:textbox class="" for="" id="" label="인증서가 만료 되었거나 폐지 되어서 더이상 사용이 불가할때 재발급 받은 인증서나 다른 인증서로 재등록 하실 수 있습니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    					<xf:group id="" tagname="li" style="">
    						<w2:textbox class="" for="" id="" label="다른 인증서로 재등록 하시고 싶으시면 해당 발급기관에 가서 인증서를 폐기하신 후 이용해주시기 바랍니다." style="" tagname=""></w2:textbox>
    					</xf:group>
    				</xf:group>
    				<xf:group class="titbox" id="" style="">
    					<w2:textbox class="" id="" label="인증서 관리" style="" tagname="h3"></w2:textbox>
    					<xf:group class="rt" id="" style="">
    						<xf:trigger class="btn_cm" id="" style="" type="button">
    							<xf:label><![CDATA[관리하기]]></xf:label>
    						</xf:trigger>
    					</xf:group>
    				</xf:group>
    				<xf:group id="" tagname="ul" class="txt_list">
    					<xf:group id="" tagname="li">
    						<w2:textbox tagname="" for="" style="" id="" label="내 PC의 인증서 백업(copy)/복원/삭제 및 인증서 상태조회를 하실 때 사용합니다." class=""></w2:textbox>
    					</xf:group>
    				</xf:group>
    			</xf:group>
    		</xf:group>
    	</xf:group>
    </body>
</html>

};
scwin.fn_Search = function() {
    var url = "/digital/Digitalissueinfo.do?method=listDigitalPersonInCharge&ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD1);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
    if (dts_List.getTotalRow() > 0) {
        scwin.fn_readDigitalPersonInCharge(grd_List, 1, "ISUR_CD");
    } else {
        $c.stf.setObjectValue(txb_Corp_COM_NM, '');
        dts_Chrg1_Info.removeAll();
        dts_Chrg2_Info.removeAll();
        dts_Chrg3_Info.removeAll();
        dts_Chrg4_Info.removeAll();
        dts_Chrg5_Info.removeAll();
    }
};
scwin.fn_readDigitalPersonInCharge = function(GridID, row, colid) {
    if (row < 1) return;
    var objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..

    var vISUR_CD = objDataID.getCellData(row, "ISUR_CD");
    $c.stf.setObjectValue(txb_Corp_COM_NM, objDataID.getCellData(row, "COM_NM"));
    var url = "";
    // 공시책임자
    url = "/digital/Digitalissueinfo.do?method=readDigitalPersonInCharge&Flag=1&ISUR_CD=" + vISUR_CD;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Chrg1_Info.DataID = encodeURI(url);
    dts_Chrg1_Info.Reset();

    // 공시담당자 정, 
    url = "/digital/Digitalissueinfo.do?method=readDigitalPersonInCharge&Flag=2&ISUR_CD=" + vISUR_CD;
    dts_Chrg2_Info.DataID = encodeURI(url);
    dts_Chrg2_Info.Reset();

    // 공시담당자 부, 
    url = "/digital/Digitalissueinfo.do?method=readDigitalPersonInCharge&Flag=3&ISUR_CD=" + vISUR_CD;
    dts_Chrg3_Info.DataID = encodeURI(url);
    dts_Chrg3_Info.Reset();

    // 공시대리인 정, 
    url = "/digital/Digitalissueinfo.do?method=readDigitalPersonInCharge&Flag=4&ISUR_CD=" + vISUR_CD;
    dts_Chrg4_Info.DataID = encodeURI(url);
    dts_Chrg4_Info.Reset();

    // 공시대리인 부, 
    url = "/digital/Digitalissueinfo.do?method=readDigitalPersonInCharge&Flag=5&ISUR_CD=" + vISUR_CD;
    dts_Chrg5_Info.DataID = encodeURI(url);
    dts_Chrg5_Info.Reset();
    scwin.fn_changeFormat();
};
scwin.fn_changeFormat = function() {
    var ar = new Array(txb_Chrg1_WORK_TM, txb_Chrg2_WORK_TM, txb_Chrg3_WORK_TM, txb_Chrg4_WORK_TM, txb_Chrg5_WORK_TM);
    for (var i = 0; i < ar.length; i++) {
        var bfVal = $c.stf.getObjectValue(ar[i]);
        if (bfVal != "") {
            var afVal = $c.stf.FormatDateEx(bfVal);
            $c.stf.setObjectValue(ar[i], afVal);
        }
    }
};




// 상장신청인 선택 팝업호출용
scwin.fn_GetParIsur = function(arrPar) {
    // 넘길 인수를 지정하는 펑션
    arrPar[0] = ""; // 코드값을 포함할 컨트롤
    arrPar[1] = ""; // 명칭값을 포함할 컨트롤
    //arrPar[2] = fr_SecuGrpId;	  					  // 명칭값을 포함할 컨트롤

    return arrPar.length;
};


// 상장신청인 선택 팝업호출용
scwin.fn_SetParIsur = function(arrPar) {
    var dbClickYn = arrPar[0].DBCLICKYN;
    if (dbClickYn == "Y") {
        txb_ISUR_CD1.setValue(arrPar[0].ISUR_CD);
        txb_COM_NM1.setValue(arrPar[0].ISUR_NM);
        vIsurCd = arrPar[0].ISUR_CD;
    }
    scwin.fn_Search();
};

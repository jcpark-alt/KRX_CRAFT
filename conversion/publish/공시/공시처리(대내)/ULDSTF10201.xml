        $c.stf.setObjectValue(txb_BFPYY_BFTAX_LOSS_EXCS50PCT_YN, gExcs50PtYes);
    } else {
        $c.stf.setObjectValue(txb_BFPYY_BFTAX_LOSS_EXCS50PCT_YN, gExcs50PtNo);
    }
    if (rowcount > 0) {
        $c.lcd.fn_setCheckBox();
    } else {
        var lbStr = '[ 공시데이타가 추출되지 않았습니다. 시스템담당자에게 연락하십시요.]';

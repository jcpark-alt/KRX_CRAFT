    $c.stf.showObj(txt_NO_EXTR_MSG, false);
    scwin.fn_getParam();
    $c.stf.showObj(panel_THSBZYY_AUDT_OPIN_TP_CD, true);
    $c.stf.showObj(panel_REAL_INVSTG_COND, true);
    $c.stf.showObj(panel_FNC_COND, true);
    if (scwin.gWinTyp == '1') {
        //재무요건
        $c.stf.showObj(panel_REAL_INVSTG_COND, false);
        if (scwin.gMainFormCd == '70016' || scwin.gMainFormCd == '70443') {
            //매출액또는손익구조30%(자산총액2조원이상인법인은15%)미만변동
            $c.stf.showObj(panel_THSBZYY_AUDT_OPIN_TP_CD, false);
        }
        panel_NOTI.style.top = "220px";
    } else if (scwin.gWinTyp == '2') {
        //실질심사요건
        $c.stf.showObj(panel_FNC_COND, false);
        $c.stf.showObj(panel_REAL_INVSTG_COND, true);
        panel_REAL_INVSTG_COND.style.top = "90px";
        panel_NOTI.style.top = "120px";
    }
    scwin.fn_read_sync();
};

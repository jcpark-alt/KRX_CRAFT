    } else {
        $c.stf.setObjectValue(txb_CURYY_BFTAX_LOSS_EXCS50PCT_YN, gExcs50PtNo);
    }
    if (dts_Item.getCellData(1, "LSTYY_BFTAX_LOSS_EXCS50PCT_YN") == 'Y') {
        $c.stf.setObjectValue(txb_LSTYY_BFTAX_LOSS_EXCS50PCT_YN, gExcs50PtYes);

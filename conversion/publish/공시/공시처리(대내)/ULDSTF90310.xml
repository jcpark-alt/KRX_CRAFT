        await $c.frame.CreateFrame("viewer" + pAcptNo, url, winTitle, 10, 10, 1000, 800, "window", 0, 0, true);
    }
};
scwin.fn_setNoti = function(rowcount) {
    var k_1 = 0;
    var k_2 = 0;
    var k_3 = 0;
    var k_4 = 0;
    for (var i = 1; i <= rowcount; i++) {
        var gLNK_DISCLS_MAKE_YN = dts_List.getCellData(i, "LNK_DISCLS_MAKE_YN");
        var gHDCOM_ACPT_NO = dts_List.getCellData(i, "HDCOM_ACPT_NO");
        var gSUBCOM_DISCLS_PROCS_STAT_CD = dts_List.getCellData(i, "SUBCOM_DISCLS_PROCS_STAT_CD");
        if (gLNK_DISCLS_MAKE_YN == 'Y') {
            k_1++;
            if (gSUBCOM_DISCLS_PROCS_STAT_CD == '30' || gSUBCOM_DISCLS_PROCS_STAT_CD == '35') {
                k_3++;
            }
            if (gSUBCOM_DISCLS_PROCS_STAT_CD == '40') {
                //유보
                k_4++;
            }
        }
        if (gHDCOM_ACPT_NO != '') {
            k_2++;
        }
    }
    var gStr = '연계공시생성대상건수 : ' + k_1 + '     연계공시생성건수 ' + k_2 + ' (승인건수 : ' + k_3 + ' , 유보건수 : ' + k_4 + ')';

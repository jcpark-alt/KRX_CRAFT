    var vHttp;
    if (js_svrGubun == 'dev') {
        vHttp = g_dev_stf_url;
    } else {
        vHttp = g_real_stf_url;
    }
    var url = vHttp + "/dsclproc/ULDSTF10001.gfm?" + "gAcptNo=" + pAcptNo + "&gViewerStat=" + pViewerStat + "&frameID=" + frame.FrameID + "&gAccssAuthTpCd=01" + "&screnID=" + scwin.vScrenID;

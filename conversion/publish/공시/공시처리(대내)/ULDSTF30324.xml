    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_SetCode = function() {
    scwin.gLdMktTp = js_market;
};



// opener에 셋팅된 값을 체크하기 
scwin.fn_Confirm = async function() {
    var vKeywordTemp = "";
    var vKeywordList = "";
    var vCnt = 0;

    // 셋팅된것이 있을때만...
    for (var i = 1; i <= 71; i++) {
        if (eval('checkbox_' + i + '.checked') == true) {
            vKeywordTemp += (eval('checkbox_' + i + '.name') + ", ");
            vCnt++;
        }
    }
    if (vCnt < 1 || vCnt > 5) {
        $c.win.alert("주요키워드는 5개 이내로 선택하시기 바랍니다.");
        return false;
    }

    // 맨뒤에 ",  " 제거 하기 
    vKeywordList = vKeywordTemp.substr(0, vKeywordTemp.length - 2);
    //alert( vKeywordList );	
    frame.opener.tbox_may_keywrd.setValue(vKeywordList);
    await $c.frame.CloseFrame();
};
scwin.getChkValue = function(obj) {
    //return (obj.checked) ? "Y" : "N";
    if (obj.checked == true) {
        return obj.getValue();
    } else {
        return "0";
    }
};
scwin.img_close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.img_confirm_onclick = function() {
    scwin.fn_Confirm();
};
scwin.gform_onload = function() {
    // 패널라운드 처리
    $c.cm.PanelToGroupBox(panel_1);
    scwin.fn_SetCode();
};
]]></script>

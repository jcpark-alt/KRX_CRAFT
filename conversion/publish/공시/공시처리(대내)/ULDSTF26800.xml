scwin.fn_changeHeader = function(obj) {
    var clientnow = new Date();
    var curYear = "" + clientnow.getYear();
    var curMonth = "" + ((clientnow.getMonth()) + 1);
    var NOW_MONTH = curYear.substring(2, 4) + "." + curMonth;
    var ONE_YEAR = (curYear.substring(2, 4) - 1);
    var TWO_YEAR = (curYear.substring(2, 4) - 2);
    var THREE_YEAR = "" + (curYear.substring(2, 4) - 3);
    if (THREE_YEAR.length == 1) {
        THREE_YEAR = "0" + THREE_YEAR;
    }
    var FOUR_YEAR = "" + (curYear.substring(2, 4) - 4);
    if (FOUR_YEAR.length == 1) {
        FOUR_YEAR = "0" + FOUR_YEAR;
    }
    var FIVE_YEAR = "" + (curYear.substring(2, 4) - 5);
    if (FIVE_YEAR.length == 1) {
        FIVE_YEAR = "0" + FIVE_YEAR;
    }
    obj.setColumnProp('NOW_MONTH', 'Name', "`" + NOW_MONTH + "월");
    obj.setColumnProp('ONE_YEAR', 'Name', "`" + ONE_YEAR);
    obj.setColumnProp('TWO_YEAR', 'Name', "`" + TWO_YEAR);
    obj.setColumnProp('THREE_YEAR', 'Name', "`" + THREE_YEAR);
    obj.setColumnProp('FOUR_YEAR', 'Name', "`" + FOUR_YEAR);
    obj.setColumnProp('FIVE_YEAR', 'Name', "`" + FIVE_YEAR);
};

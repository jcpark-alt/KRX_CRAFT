//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gLdMktTp = js_market;
scwin.pageSize = 10; //페이지 size
scwin.totalCnt = 0; //전체 row
scwin.pageNoCnt = 10; //page 번호 개수
scwin.vCurrPageNo = 1; //현재 선택된 페이지번호

scwin.vScrenID = "ULDSTF30402.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.initPage = function() {
    // code default value setting
    // 1. 날짜 기본 6개월.
    var ToDay = $c.ut.cGetToday2();
    $c.stf.setObjectValue(edt_EDATE, ToDay);
    var vSDATE = $c.ut.calcMonth(ToDay, -6);
    $c.stf.setObjectValue(edt_SDATE, vSDATE);
    $c.stf.setObjectValue(rdo_mkt_gubun, js_market);
    if (js_bond_yn == 'Y') {
        $c.stf.setObjectValue(rdo_mkt_gubun, '4');
    }
    if (js_market == "9") {
        $c.stf.showObj(panel_mkt_gubun, true);
    } else {
        $c.stf.showObj(panel_mkt_gubun, false);
    }
};
scwin.fn_listDsclBbs = function() {
    $c.cm.ShowWin(grd_Grid);
    var url = "/IntegratedBBS.do?method=listDsclBbs";
    url += "&MKT_ID=" + $c.stf.getObjectValue(rdo_mkt_gubun);
    url += "&KEYWORD_FLAG=" + $c.stf.getObjectValue(cmb_KEYWORD);
    url += "&KEYWORD=" + $c.stf.getObjectValue(txb_KEYWORD);
    url += "&SDATE=" + $c.stf.getObjectValue(edt_SDATE);
    url += "&EDATE=" + $c.stf.getObjectValue(edt_EDATE);
    url += "&EMP_NM=" + $c.stf.getObjectValue(txb_EMP_NM);
    url += "&MENU_FLAG=" + $c.stf.getObjectValue(cmb_MENU_FLAG);
    url += "&PAGENO=" + scwin.vCurrPageNo;
    url += "&PAGESIZE=" + $c.stf.getObjectValue(cmb_PerPage);
    url += "&PDS=Y"; // 자료실 포함여부.(관리자일때만 자료실을 표시함.)
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.Reset();
};
scwin.PageNoCall = function(vPageNo) {
    scwin.vCurrPageNo = vPageNo;
    scwin.fn_listDsclBbs();
};
scwin.fn_SetCode = function() {
    $c.stf.Combo_CBDataSet(cmb_PerPage);
};
scwin.fn_readDsclBbs = async function(row, colid) {
    if (colid == "TITLE") {
        var CONTN_ID = dts_Grid.getCellData(row, "CONTN_ID");
        await $c.frame.CreateDialogFrame("INTEBBS_READ|CONTN_ID=" + CONTN_ID, "/dsclinfo/ULDSTF30403.gfm", "제도해설등 조회", 200, 100, 750, 570 + 30, "window");
    }
};
scwin.fn_New = async function() {
    await $c.frame.CreateDialogFrame("INTEBBS_NEW", "/dsclinfo/ULDSTF30403.gfm", "제도해설등 신규", 200, 100, 750, 570 + 30, "window");
};
scwin.btn_SDATE_onclick = function() {
    popUpCalendar2(edt_SDATE);
};
scwin.btn_EDATE_onclick = function() {
    popUpCalendar2(edt_EDATE);
};
scwin.cmb_PeriodTp_OnSelChange = function() {
    var vTp = $c.stf.getObjectValue(cmb_PeriodTp);
    $c.stf.fn_setFromToDate(vTp, edt_SDATE, edt_EDATE);
};
scwin.cmb_PerPage_OnSelChange = function() {
    scwin.vCurrPageNo = 1;
};
scwin.btn_Search_onclick = function() {
    scwin.fn_listDsclBbs();
};
scwin.dts_Grid_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_Grid);
    var vTotalCnt = dts_Grid.getCellData(1, "CNT");
    //alert("vTotalCnt=" + vTotalCnt);
    $c.stf.FillGridHeader2(scwin.pageNoCnt, $c.stf.getObjectValue(cmb_PerPage), vTotalCnt, panel_page);
};
scwin.dts_Grid_OnLoadError = function() {
    $c.stf.alert_error(dts_Grid);
};
scwin.grd_Grid_OnDblClick = function(row, colid) {
    scwin.fn_readDsclBbs(row, colid);
};
scwin.btn_New_onclick = function() {
    scwin.fn_New();
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    scwin.fn_SetCode();
    scwin.initPage();
    scwin.fn_listDsclBbs();
};
]]></script>

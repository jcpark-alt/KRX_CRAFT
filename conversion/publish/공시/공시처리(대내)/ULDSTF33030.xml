scwin.vScrenID = "ULDSTF33030.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_Init = function() {
    if (js_market == "9") {
        $c.stf.setObjectValue(rdo_MARKET_TP_CD, 'A');
    } else {
        $c.stf.setObjectValue(rdo_MARKET_TP_CD, js_market);
    }
};
scwin.fn_list_sync = function() {
    var url = "/LnkDisclsApplCorp.do?method=selectLnkDisclsApplCorp" + "&SEARCH_TYP=LINK_FORM" + "&LD_MKT_TP_CD=" + $c.stf.getObjectValue(rdo_MARKET_TP_CD) + // 시장구분
        "&FORM_CD=" + $c.stf.getObjectValue(txb_FormCd) + "&FORM_NM=" + $c.stf.getObjectValue(txb_FormNm) + "&FORM_SEARCH_CD=" + $c.stf.getObjectValue(rdo_FORM_SEARCH_CD);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_List.DataID = encodeURI(url);
    dts_List.reset();
    $c.cm.ShowWin(grd_Grid);
};
scwin.img_FindForm_onclick = async function() {
    // *** 셋팅할 필드명 정의를 아래처럼 해야함.
    // => 보고서명: txb_FormNm, 보고서코드 : txb_FormCd
    var url = "/common/ULDSTF91003.gfm";
    var winTitle = "공시제목선택 ";
    await $c.frame.CreateDialogFrame("FORMLIST", url, winTitle, 100, 10, 690, 570, "window");
};
scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
    $c.data.downloadGridViewExcel(grd_Grid, "연계공시대상서식목록", "", "8");
};
scwin.txb_FormCd_onblur = function() {
    if (txb_FormCd.getValue() == "") {
        txb_FormNm.setValue("");
    }
};
scwin.dts_List_OnLoadError = function() {
    $c.stf.alert_error(dts_List);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    $c.cm.CloseWin(rowcount, grd_Grid);
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    scwin.fn_Init();
    scwin.fn_list_sync();
};
]]></script>

scwin.vScrenID = "ULDSTF30900.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_SetCodes = function() {
    dts_WRNT_ISUR_CD.DataID = "/CodeAction.do?method=listBCSubmitter&For=R";
    dts_WRNT_ISUR_CD.Reset();
};
scwin.fn_Search = function() {
    var url = "/BCSubmitter.do?method=listBCSubmitter&ISUR_CD=";
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};
scwin.fn_readBCSubmitter = function(GridID, row, colid) {
    if (row < 1) return;
    var objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..

    var vISUR_CD = objDataID.getCellData(row, "ISUR_CD");
    $c.stf.setObjectValue(txb_Corp_COM_NM, objDataID.getCellData(row, "COM_NM"));
    var url = "";
    // 위탁회사 제출인 정보
    url = "/BCSubmitter.do?method=readBCSubmitter&Flag=1&ISUR_CD=" + vISUR_CD;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_BCSubmitter1.DataID = encodeURI(url);
    dts_BCSubmitter1.Reset();

    // 사무관리회사 제출인 정보 
    url = "/BCSubmitter.do?method=readBCSubmitter&Flag=2&ISUR_CD=" + vISUR_CD;
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.Reset();
};
scwin.grd_List_OnClick = function(row, colid) {
    scwin.fn_readBCSubmitter(grd_List, row, colid);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
};
scwin.gform_onload = function() {
    //fn_HideDebugCtrls();
    scwin.fn_SetCodes();
    //PanelToGroupBox(panel_1);
    scwin.fn_Search();
};
]]></script>

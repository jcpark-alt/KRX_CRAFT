    scwin.g_hdcom_com_abbrv = $c.frame.path("../").scwin.g_hdcom_com_abbrv;
    scwin.g_hdcom_lm_mkt_tp_cd = $c.frame.path("../").scwin.g_hdcom_lm_mkt_tp_cd;
};
scwin.fn_Init = function() {
    $c.stf.setObjectValue(txb_HDCOM_ISUR_CD, scwin.g_hdcom_isur_cd);
    $c.stf.setObjectValue(txb_HDCOM_COM_ABBRV, scwin.g_hdcom_com_abbrv);
    $c.stf.setObjectValue(txb_HDCOM_LM_MKT_TP_CD, scwin.g_hdcom_lm_mkt_tp_cd);
    scwin.fn_subcom_read_sync();
};
scwin.fn_read_sync = function() {
    var url = "/LnkDisclsApplCorp.do?method=selectLnkDisclsApplCorp" + "&SEARCH_TYP=APPL_HIST" + "&HDCOM_ISUR_CD=" + scwin.g_hdcom_isur_cd + "&SUBCOM_ISUR_CD=" + $c.stf.getObjectValue(cmb_SUBCOM_ISUR_CD);

    dts_SUBCOM.DataID = encodeURI(url);
    dts_SUBCOM.reset();
};
scwin.cmb_SUBCOM_ISUR_CD_OnCloseUp = function() {
    scwin.fn_read_sync();
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_Grid_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_Grid);
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
};
scwin.dts_Grid_OnLoadError = function() {
    $c.stf.alert_error(dts_Grid);
};
scwin.dts_SUBCOM_OnLoadError = function() {
    $c.stf.alert_error(dts_SUBCOM);
};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
    $c.data.downloadGridViewExcel(grd_Grid, "상장자회사 신청내역 ", "", "8");
};
scwin.gform_onload = function() {
    $c.cm.PanelToGroupBox(panel_1);
    scwin.fn_GetParentValue();
    scwin.fn_Init();
    scwin.fn_read_sync();
};

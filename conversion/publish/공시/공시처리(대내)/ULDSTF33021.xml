    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    $c.cm.ShowWin(grd_Grid);
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.reset();
};
scwin.fn_subcom_read_sync = function() {
    var url = "/LnkDisclsApplCorp.do?method=selectLnkDisclsApplCorp" + "&SEARCH_TYP=SUBCOM_LIST" + "&ISUR_CD=" + scwin.g_hdcom_isur_cd;

//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gDepCd = js_dep_cd;
scwin.gEmpNo = js_emp_no;
scwin.gIsurCd;
scwin.gMktTp;
scwin.gChrgTpCd;
scwin.vScrenID = "ULDSTF71001.xml";
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_Init = function() {
    var ISUR_CD = $c.stf.getQuery(frame.srcUrl, "ISUR_CD"); // 다른 페이지(기업정보조회)에서 넘어오는 경우 처리.
};
scwin.fn_Search = function() {
    $c.cm.ShowWin(grd_List);

    // 지정자문인 가져오기
    var url = "/digital/Digitalissueinfo.do?method=listDigitalDesignAdviserProcs";
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.Reset();
    if (dts_Grid.getTotalRow() > 0) {
        // 회사정보, 자문현황 가져오기
        scwin.fn_readChargeIssue(grd_List, 1, "ISUR_CD");
    } else {
        dts_Corp_Info.removeAll();
    }
};




// 다른창에서 담당종목 조회를 클릭할때
scwin.fn_InitSearch = function() {
    scwin.fn_getChargeIssue(scwin.gIsurCd, scwin.gMktTp);
};
scwin.fn_readChargeIssue = function(GridID, row, colid) {
    if (row < 1) return;
    var objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..

    var vISUR_CD = objDataID.getCellData(row, "ISUR_CD");
    var vMKT_TP_CD = objDataID.getCellData(row, "SPOT_ISU_TRD_MKT_TP_CD");
    scwin.gIsurCd = vISUR_CD;
    scwin.fn_getChargeIssue(vISUR_CD, vMKT_TP_CD);
};
scwin.fn_getChargeIssue = function(vISUR_CD, vMKT_TP_CD) {
    var url = "/digital/Digitalissueinfo.do?method=readDigitalChargeIssue&Flag=1&ISUR_CD=" + vISUR_CD + "&BOND_YN=N";
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;

    // 회사개요
    dts_Corp_Info.DataID = encodeURI(url);
    dts_Corp_Info.Reset();


    // 자문종목 현황
    url = "/digital/Digitalissueinfo.do?method=listDigitalAdviserProcs&ISUR_CD=" + vISUR_CD;
    dts_Grid_Adviser.DataID = encodeURI(url);
    dts_Grid_Adviser.Reset();


    // 회사개요>자기자본
    var vStr = $c.stf.getObjectValue(txb_Corp_CAP);
    if (vStr != "") {
        vStr2 = $c.stf.FormatNumberEx(vStr);
        $c.stf.setObjectValue(txb_Corp_CAP, vStr2);
    }
};
scwin.FormatDateEx = function(str) {
    if (str == "") return "";
    return str.substring(0, 4) + "-" + str.substring(4, 6) + "-" + str.substring(6, 8);
};
scwin.grd_List_OnClick = function(row, colid) {
    scwin.fn_readChargeIssue(grd_List, row, colid);
    scwin.gIsurCd = dts_Grid.getCellData(eval(row), "ISUR_CD");
};
scwin.dts_Grid_OnLoadError = function() {
    $c.stf.alert_error(dts_Grid);
};
scwin.dts_Grid_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_List);
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page);
    scwin.fn_readChargeIssue(grd_List, 1, "ISUR_CD");
};
scwin.btn_Excel_onclick = function() {
    if (grd_adviser.getTotalRow() < 1) {
        $c.win.alert("저장할 정보가 없습니다.");
    } else {
        $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07, '');
        $c.data.downloadGridViewExcel(grd_adviser, "지정자문인현황", "", "2");
    }
};
scwin.gform_onload = function() {
    scwin.fn_Init();
    scwin.fn_Search();
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
]]></script>

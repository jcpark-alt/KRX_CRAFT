//★Wcraft guide★ include부분 주석처리 -> include("../js/libRoundPanel.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/utils.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/PopupCalendar.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/controlResize.js");
// 화면 리사이징

scwin.gDepCd;
scwin.gEmpNo;
scwin.gLdMktTp = js_market;
scwin.gAcptNo;
scwin.colorCnt = 0; //조회한 이후에만 컬럼에  color 변경하기 위한 변수 

scwin.vScrenID = 'ULDSTF25101.xml';
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_GetProvider = function() {
    var url = frame.srcUrl;
    var arr = url.split("?");
    return (arr.length >= 1 ? arr[1] : "");
};
scwin.fn_GetParentValue = function() {
    var pvd = scwin.fn_GetProvider();
    if (pvd != null) {
        var Temp0 = pvd.split("&")[0];
        var Temp1 = pvd.split("&")[1];
        var Temp2 = pvd.split("&")[2];
        var gIsurCd = Temp0.split("=")[1];
        if ($c.ut.trim(gIsurCd).length == 5) {
            $c.stf.setObjectValue(txb_ISUR_CD, gIsurCd);
        }
        var gMktCd = Temp1.split("=")[1];
        scwin.gLdMktTp = gMktCd;
        var gComNm = Temp2.split("=")[1];
        txb_COM_NM.setValue(gComNm);
        scwin.fn_Init();
        scwin.fn_Search();
    }
};



// 시장구분 라디오버튼
scwin.fn_Init = function() {
    $c.stf.setObjectValue(rdo_MKT_ID, scwin.gLdMktTp);
    if (scwin.gLdMktTp == "1" || scwin.gLdMktTp == "2" || scwin.gLdMktTp == "6") {
        $c.cm.fn_com_isur(txb_ISUR_CD, txb_COM_NM);
        $c.cm.setColumnProp(grd_Grid, "MKT_NM", "Show", false);
        rdo_MKT_ID.setDisabled(true);
    } else {
        $c.cm.fn_com_isur_all(txb_ISUR_CD, txb_COM_NM);
        $c.stf.setObjectValue(rdo_MKT_ID, '9');
        rdo_MKT_ID.setDisabled(false);
        rdo_MKT_ID.addClass("TopCondition_Blue");
    }
};



// 공시일자, 팀, 담당자 세팅
scwin.fn_SetCode = function() {
    scwin.gDepCd = js_dep_cd;
    scwin.gEmpNo = js_emp_no;

    //  기간 from~ to  셋팅(공시일자)
    vCurDate = $c.ut.cGetToday("yyyymmdd");
    edt_SDATE.setValue($c.ut.cGetMinusYear(vCurDate, 1)); // 1년전 날짜
    edt_EDATE.setValue(vCurDate); // 현재날짜	

    // 팀 리스트 박스(소속부서와 같은 상위부서인 팀)	
    dts_dep.DataID = "/CodeAction.do?method=getDepUpCode" + "&inputMessageId=CODE_EMPDEP_IN&outputMessageId=CODE_EMPDEP_OUT" + "&For=R&DEP_CD=" + scwin.gDepCd;
    dts_dep.Reset();


    //담당자 리스트 박스(소속부서와 같은 상위부서인 팀원)	
    dts_emp.DataID = "/CodeAction.do?method=getEmpNoDepCode" + "&inputMessageId=CODE_EMPDEP_IN&outputMessageId=CODE_EMPDEP_OUT" + "&For=R&DEP_CD=" + scwin.gDepCd;
    dts_emp.Reset();
};


//조회 버튼
scwin.fn_Search = function() {
    scwin.colorCnt = 1; //조회를 클릭한 경우에만 컬럼 color 변경해줌

    var flag = $c.stf.getObjectValue(rdo_MKT_ID);
    if (flag == "") {
        $c.win.alert("[시장구분]을 선택하세요.");
        rdo_MKT_ID.focus();
        return;
    } else {
        scwin.gDepCd = $c.stf.getObjectValue(cmb_TeamList);
        scwin.gEmpNo = $c.stf.getObjectValue(cmb_EmpList);
        if (scwin.gEmpNo == "") {
            scwin.gEmpNo = '%';
        }
        if (scwin.gDepCd == "") {
            scwin.gDepCd = 'all';
        }
    }
    $c.cm.ShowWin(grd_Grid);
    var url = "/InvestStatistics.do?method=listPaidCapincAll";
    url += "&MKT_ID=" + $c.stf.getObjectValue(rdo_MKT_ID); //시장구분
    url += "&ISUR_CD=" + $c.stf.getObjectValue(txb_ISUR_CD); //법인코드
    url += "&LIST_STAT_CD=" + $c.stf.getObjectValue(chb_TAB1_LIST_STAT_CD); //상장폐지법인 제외
    url += "&SDATE=" + $c.stf.getObjectValue(edt_SDATE); //공시일자 from
    url += "&EDATE=" + $c.stf.getObjectValue(edt_EDATE); //공시일자 to				
    url += "&DEP_CD=" + scwin.gDepCd; //팀			->수정		
    url += "&EMP_NO=" + scwin.gEmpNo; //담당자	->수정
    url += "&UP_DEP_CD=" + js_belngdepcd; //->수정
    url += "&ACNTCLS_MMDD1=" + $c.stf.getObjectValue(cmb_f_mm_1); //결산월		
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    url += "&TEAM_YN=" + scwin.getChkValue(chb_Team);
    url += "&EMP_YN=" + scwin.getChkValue(chb_Emp);
    url += "&FMM_YN=" + scwin.getChkValue(chb_Fmm);
    url += "&IND_YN=" + scwin.getChkValue(chb_Ind);
    url += "&BIG_YN=" + scwin.getChkValue(chb_BigYN);
    url += "&URL_YN=" + scwin.getChkValue(chb_URL);
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.Reset();
};


// 그리드에서 클릭 row의 변수셋팅
scwin.fn_setContnId = function(obj) {
    scwin.gAcptNo = dts_Grid.getCellData(eval(obj), "ACPT_NO");
};


// 공시팀 전체 목록에 추가
scwin.fn_addDsclTeamAll = function(rowcount) {
    dts_dep.setCellData(2, "VALUE", 'UPTEAM'); //
    dts_dep.setCellData(2, "TEXT", '공시팀 전체');
    dts_dep.setCellData(2, "DEP_CD", 'UPTEAM');
    for (var i = 3; i <= rowcount; i++) {
        dts_dep.setCellData(i, "VALUE", dts_dep1.getCellData(i - 1, "VALUE")); //
        dts_dep.setCellData(i, "TEXT", dts_dep1.getCellData(i - 1, "TEXT"));
        dts_dep.setCellData(i, "DEP_CD", dts_dep1.getCellData(i - 1, "DEP_CD"));
    }
    dts_dep.insertRow();
    dts_dep.setCellData(rowcount + 1, "VALUE", dts_dep1.getCellData(rowcount, "VALUE")); //
    dts_dep.setCellData(rowcount + 1, "TEXT", dts_dep1.getCellData(rowcount, "TEXT"));
    dts_dep.setCellData(rowcount + 1, "DEP_CD", dts_dep1.getCellData(rowcount, "DEP_CD"));
};
scwin.getChkValue = function(obj) {
    return (obj.checked) ? "Y" : "N";
};
scwin.setGridHiddenColumnProp = function() {
    if (chb_Team.checked == true) {
        //담당팀
        $c.cm.setColumnProp(grd_Grid, "DEP_NM", 'Show', true);
    } else {
        $c.cm.setColumnProp(grd_Grid, "DEP_NM", 'Show', false);
    }
    if (chb_Emp.checked == true) {
        //담당자
        $c.cm.setColumnProp(grd_Grid, "EMP_NM", 'Show', true);
    } else {
        $c.cm.setColumnProp(grd_Grid, "EMP_NM", 'Show', false);
    }
    if (chb_Fmm.checked == true) {
        //결산월
        $c.cm.setColumnProp(grd_Grid, "ACNTCLS_MMDD1", 'Show', true);
    } else {
        $c.cm.setColumnProp(grd_Grid, "ACNTCLS_MMDD1", 'Show', false);
    }
    if (chb_Ind.checked == true) {
        //업종
        $c.cm.setColumnProp(grd_Grid, "STD_IND_NM", 'Show', true);
    } else {
        $c.cm.setColumnProp(grd_Grid, "STD_IND_NM", 'Show', false);
    }
    if (chb_BigYN.checked == true) {
        //대규모법인여부
        $c.cm.setColumnProp(grd_Grid, "BIG_YN", 'Show', true);
    } else {
        $c.cm.setColumnProp(grd_Grid, "BIG_YN", 'Show', false);
    }
};
scwin.txb_ISUR_CD_onkeyup = function() {
    if (txb_ISUR_CD.getValue() == "") {
        Grd_com_isur.style.display = "none";
    } else {
        if (window.event.keyCode == 40) {
            //아래화살표눌렀을때 그리드로 포커스
            Grd_com_isur.focus();
        } else {
            $c.cm.fn_com_isur_nm(window.event.keyCode);
        }
    }
};
scwin.txb_ISUR_CD_onfocus = function() {
    Grd_com_isur.style.display = "none";
};
scwin.txb_ISUR_CD_onblur = function() {
    if (stFocusGrid == false) {
        Grd_com_isur.style.display = "none";
    }
    if (txb_ISUR_CD.getValue() == "") {
        txb_COM_NM.setValue("");
    }
};
scwin.btn_ISUR_CD_onclick = function() {
    $c.cm.IsurcdSearch(txb_ISUR_CD, txb_COM_NM); // 법인명 검색 팝업

};
scwin.Grd_com_isur_OnKeyPress = function(kcode) {
    if (kcode == '13') {
        $c.cm.fn_com_Confirm_set();
    }
};
scwin.Grd_com_isur_OnDblClick = function(row, colid) {
    $c.cm.fn_com_Confirm_set();
};
scwin.Grd_com_isur_OnClick = function(row, colid) {
    Grd_com_isur.style.display = "";
};
scwin.Grd_com_isur_OnSetFocus = function() {
    stFocusGrid = true;
};
scwin.Grd_com_isur_OnKillFocus = function() {
    stFocusGrid = false;
    Grd_com_isur.style.display = "none";
};
scwin.cmb_PeriodTp_OnSelChange = function() {
    var vTp = $c.stf.getObjectValue(cmb_PeriodTp);
    $c.stf.fn_setFromToDate(vTp, edt_SDATE, edt_EDATE); //기간선택 콤보박스

};
scwin.btn_EDATE_onclick = function() {
    popUpCalendar2(edt_EDATE); //공시일자-시작일 이미지 버튼 클릭 시 달력 팝업

};
scwin.btn_SDATE_onclick = function() {
    popUpCalendar2(edt_SDATE); //공시일자-종료일 이미지 버튼 클릭 시 달력 팝업

};
scwin.btn_Search_onclick = function() {
    scwin.fn_Search(); //조회 버튼

};
scwin.grd_Grid_OnDblClick = function(row, colid) {
    // 클릭된 값 변수에 셋팅
    scwin.fn_setContnId(row);
    if (colid == "PUBL_DDTM") {
        $c.stf.fn_OpenDisclViewer(scwin.gAcptNo, "R"); //(정정)공시일 컬럼 더블클릭시 관련 보고서 뷰잉

    }
};
scwin.dts_Grid_OnLoadError = function() {
    $c.stf.alert_error(dts_Grid);
};
scwin.dts_Grid_OnLoadCompleted = function(rowcount) {
    $c.cm.CloseWin(rowcount, grd_Grid); //조회완료시 LOADING 이미지 종료
    scwin.setGridHiddenColumnProp(); //Grid hidden 컬럼 속성 설정
    $c.stf.FillGridHeaderTotalCnt(rowcount, panel_page); //총 건수

};
scwin.btn_Excel_onclick = function() {
    $c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);
    //grd_Grid.GridToExcel("유상증자", "", "2");//엑셀 다운로드
    $c.data.downloadGridViewOffice(grd_Grid, "유상증자", "유상증자.xlsx", "8", 0);
};
scwin.cmb_TeamList_OnSelChange = function() {
    scwin.gDepCd = $c.cp.valueOfIndex(cmb_TeamList, "VALUE", cmb_TeamList.getSelectedIndex());
    if (scwin.gDepCd == '' || scwin.gDepCd == 'UPTEAM') {
        $c.stf.setObjectValue(cmb_EmpList, '');
    }
    dts_emp.UseFilter = true;
    dts_emp.Filter();
    dts_emp.sort("DEP_CD", 0);
    //dts_emp.sort(); // W-Craft 주석처리 
    if (scwin.gDepCd != '' && scwin.gDepCd != 'UPTEAM') {
        cmb_EmpList.trigger("onclick");
    }
};
scwin.dts_dep_OnLoadCompleted = function(rowcount) {
    if (js_dep_cd.substring(0, 2) == '26' || js_dep_cd.substring(0, 2) == '34') {
        $c.stf.CopyDataSet(dts_dep, dts_dep1);
        scwin.fn_addDsclTeamAll(rowcount);
        $c.stf.setObjectValue(cmb_TeamList, 'UPTEAM');
    }
};
scwin.dts_emp_OnFilter = function(row) {
    //  부서코드에  해당하는 사원을 가져온다.
    if (scwin.gDepCd == "" || scwin.gDepCd == "UPTEAM") {
        // 전체일 경우 모두 보여준다.
        return true;
    } else {
        if (dts_emp.getCellData(row, "dep_cd") == scwin.gDepCd ||
            dts_emp.getCellData(row, "dep_cd") == "UPTEAM" ||
            dts_emp.getCellData(row, "dep_cd") == "") {
            return true;
        } else {
            return false;
        }
    }
};
scwin.MxDataSet_com_isur_OnFilter = function(row) {
    if (skw != "" && foColum == "1") {
        f1 = MxDataSet_com_isur.getCellData(row, "COM_ABBRV");
        f2 = MxDataSet_com_isur.getCellData(row, "OLD_COM_ABBRV");
        if (f1.indexOf(skw) != -1 || f2.indexOf(skw) != -1) return true;

        else return false;
    } else {
        return true;
    }
};
scwin.dts_dep_OnLoadCompleted = function(rowcount) {
    if (js_dep_cd.substring(0, 2) == '26' || js_dep_cd.substring(0, 2) == '34') {
        $c.stf.CopyDataSet(dts_dep, dts_dep1);
        scwin.fn_addDsclTeamAll(rowcount);
        $c.stf.setObjectValue(cmb_TeamList, 'UPTEAM');
    }
};
scwin.dts_emp_OnFilter = function(row) {
    //  부서코드에  해당하는 사원을 가져온다.
    if (scwin.gDepCd == "" || scwin.gDepCd == "UPTEAM") {
        // 전체일 경우 모두 보여준다.
        return true;
    } else {
        if (dts_emp.getCellData(row, "dep_cd") == scwin.gDepCd ||
            dts_emp.getCellData(row, "dep_cd") == "UPTEAM" ||
            dts_emp.getCellData(row, "dep_cd") == "") {
            return true;
        } else {
            return false;
        }
    }
};
scwin.gform_onload = function() {
    //fn_com_isur(txb_ISUR_CD, txb_COM_NM);	//법인코드 및 법인명(회사명) 관련
    Grd_com_isur.style.zIndex = 30;
    $c.cm.PanelToGroupBox(panel_1); // 검색조건 패널에 스타일 적용

    scwin.fn_SetCode(); //공시일자(from~to)
    scwin.fn_Init(); //시장구분

    scwin.fn_GetParentValue(); //시장운영 관련 공시조회_STF38600 화면에서 링크됐을때 202005

};
scwin.chb_Team_onclick = function() {
    if (chb_Team.checked == true) {
        cmb_TeamList.setDisabled(false);
    } else {
        cmb_TeamList.setDisabled(true);
    }
};
scwin.chb_Emp_onclick = function() {
    if (chb_Emp.checked == true) {
        cmb_EmpList.setDisabled(false);
    } else {
        cmb_EmpList.setDisabled(true);
    }
};
scwin.chb_Fmm_onclick = function() {
    if (chb_Fmm.checked == true) {
        cmb_f_mm_1.setDisabled(false);
    } else {
        cmb_f_mm_1.setDisabled(true);
    }
};
]]></script>

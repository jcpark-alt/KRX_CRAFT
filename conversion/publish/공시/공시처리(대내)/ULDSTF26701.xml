scwin.fn_Save = function() {
    if (dts_Grid.getTotalRow() == 0) {
        $c.win.alert("대상을 선택하세요");
        return;
    }
    var gCnt = 0;
    var gStat;
    grd_Grid.Redraw = false;
    for (var k = 1; k <= dts_Grid.getTotalRow(); k++) {
        gStat = dts_Grid.getRowStatus(k);
        if (gStat == TB_JOB_UPDATE) {
            gCnt++;
            var str_1 = (dts_Grid.getCellData(k, "CHECK_1") == 'T' ? 'Y' : 'N');
            var str_2 = (dts_Grid.getCellData(k, "CHECK_2") == 'T' ? 'Y' : 'N');
            var str_3 = (dts_Grid.getCellData(k, "CHECK_3") == 'T' ? 'Y' : 'N');
            dts_Grid.setCellData(k, "WRTRPT_SUBMIT_OBJ_ISU_YN", str_1);
            dts_Grid.setCellData(k, "WRTRPT_ANL_OBJ_ISU_YN", str_2);
            dts_Grid.setCellData(k, "WRTRPT_STAT_OBJ_ISU_YN", str_3);
        }
    }
    grd_Grid.Redraw = true;

    //alert(dts_Grid.text);

    if (gCnt == 0) {
        $c.win.alert("저장할 내용이 없습니다.");
        return;
    }
    if (!window.confirm($c.stf.getMessageParam("MSG-A006", '총 ' + gCnt + '건을 저장'))) return;
    scwin.fn_trs();
};
scwin.fn_trs = function() {
    trs_Save.Action = "/SubmitStatus.do?method=saveSubmitStatusNew&inputMessageId=GRID_READSUBMITSTATUS_NEW_IN&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_02;
    trs_Save.KeyName = "toinb_dataid4";

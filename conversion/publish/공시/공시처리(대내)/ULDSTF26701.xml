scwin.fn_read = function(GridID, row, colid) {
    if (row < 1) return;
    var objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..	
    if (colid == "WRTRPT_KIND_CDNM") {
        var AcptNo = objDataID.getCellData(row, "ACPT_NO");
        if (AcptNo != "") {
            $c.stf.fn_OpenDisclViewer(AcptNo, "R");
        }
    } else if (colid == "COM_ABBRV") {
        scwin.fn_setContnId(row);
        $c.stf.fn_PopupCorpInfo();
    } else if (colid == "SUBMIT_YN") {
        var AcptNo = objDataID.getCellData(row, "ACPT_NO");
        if (AcptNo == "") {
            if (scwin.vIMKT_ID == '2') {
                // 코스닥일때만 적용
                // 미제출일때만 링크한다.	
                scwin.fn_OpenNSubmitMgt(objDataID.getCellData(row, "ISUR_CD"));
            }
        } else {
            // 제출일땐 공시뷰어 링크
            $c.stf.fn_OpenDisclViewer(AcptNo, "R");
        }
    } else if (colid == "DELIST_DD") {
        var DelAcptNo = objDataID.getCellData(row, "DELIST_ACPT_NO");
        if (DelAcptNo != "") {
            $c.stf.fn_OpenDisclViewer(DelAcptNo, "R");
        }
    }
};
scwin.fn_OpenNSubmitMgt = async function(obj) {
    var url = "/dsclsrch/ULDSTF26610.gfm?ISUR_CD=" + obj;
    var winTitle = "정기보고서 미제출법인 관리";
    await $c.frame.CreateDialogFrame("NSUBMITINFO1", url, winTitle, 10, 10, 700, 350, "window");
};
scwin.fn_Search = function() {
    $c.cm.setColumnProp(grd_Grid, 'CHECK_1', 'HeadCheck', "false");
    $c.cm.setColumnProp(grd_Grid, 'CHECK_2', 'HeadCheck', "false");
    $c.cm.setColumnProp(grd_Grid, 'CHECK_3', 'HeadCheck', "false");
    var vIBAS_YY = $c.stf.getObjectValue(txb_BAS_YY);
    var vIBAS_ACNTCLS_MM = $c.stf.getObjectValue(txb_BAS_ACNTCLS_MM);
    var vIWRTRPT_KIND_CD = $c.stf.getObjectValue(txb_WRTRPT_KIND_CD);
    var vIISUR_CD = $c.stf.getObjectValue(txb_ISUR_CD);
    var vIACP_YN = $c.stf.getObjectValue(cmb_ACP_YN);
    var vILIST_STAT_CD = $c.stf.getObjectValue(cmb_LIST_STAT_CD);
    var vATTATCH_YN = $c.stf.getObjectValue(cmb_ATC_YN); // 첨부확인 검색조건 추가 by LDJ_20130726

    $c.cm.ShowWin(grd_Grid);
    var url = "/SubmitStatus.do?method=readSubmitStatusNew";
    url += "&BAS_YY=" + vIBAS_YY;
    url += "&BAS_ACNTCLS_MM=" + vIBAS_ACNTCLS_MM;
    url += "&WRTRPT_KIND_CD=" + vIWRTRPT_KIND_CD;
    url += "&ISUR_CD=" + vIISUR_CD;
    url += "&ACP_YN=" + vIACP_YN;
    url += "&MKT_ID=" + scwin.vIMKT_ID;
    url += "&DEP_CD=" + scwin.vDepCd;
    url += "&BOND_YN=" + scwin.gBondYn;
    url += "&LIST_STAT_CD=" + vILIST_STAT_CD;
    url += "&WRTRPT_SUBMIT_OBJ_ISU_YN=" + $c.stf.getObjectValue(cmb_WRTRPT_SUBMIT_OBJ_ISU_YN);
    url += "&WRTRPT_ANL_OBJ_ISU_YN=" + $c.stf.getObjectValue(cmb_WRTRPT_ANL_OBJ_ISU_YN);
    url += "&WRTRPT_STAT_OBJ_ISU_YN=" + $c.stf.getObjectValue(cmb_WRTRPT_STAT_OBJ_ISU_YN);
    url += "&ATTATCH_YN=" + $c.stf.getObjectValue(cmb_ATC_YN); // 첨부확인 검색조건 추가 by LDJ_20130726
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Grid.DataID = encodeURI(url);
    dts_Grid.Reset();

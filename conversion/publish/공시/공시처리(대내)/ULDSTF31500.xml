scwin.fn_Search = function() {
    var url = "/VotingRightsDisclosureSubmitter.do?method=listVotingRightsDisclosureSubmitter&COM_NM=" + $c.stf.getObjectValue(txb_ISUR_CD);
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_List.DataID = encodeURI(url);
    dts_List.Reset();
};
scwin.fn_readBCSubmitter = function(GridID, row, colid) {
    if (row < 1) return;
    var objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..

    var vISUR_CD = objDataID.getCellData(row, "ISUR_CD");
    $c.stf.setObjectValue(txb_Corp_COM_NM, objDataID.getCellData(row, "COM_NM"));
    var url = "";
    // 의결권공시  제출인 정보
    url = "/VotingRightsDisclosureSubmitter.do?method=readVotingRightsDisclosureSubmitter&ISUR_CD=" + vISUR_CD;
    url += "&SCREN_ID=" + scwin.vScrenID;
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_vrd.DataID = encodeURI(url);
    dts_vrd.Reset();
};
scwin.btn_Search_onclick = function() {
    scwin.fn_Search();
};
scwin.grd_List_OnClick = function(row, colid) {
    scwin.fn_readBCSubmitter(grd_List, row, colid);
};
scwin.dts_List_OnLoadCompleted = function(rowcount) {

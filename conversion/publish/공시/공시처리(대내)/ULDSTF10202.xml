//★Wcraft guide★ include부분 주석처리 -> include("../js/session.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/stf.js");
//★Wcraft guide★ include부분 주석처리 -> include("../js/common.js");
scwin.gPvd;
scwin.gAcptNo;
scwin.gMainFormCd;
scwin.gWinTyp;
scwin.gLdMktTp = js_market;
scwin.vScrenID = 'ULDSTF10202.xml';
scwin.onpageload = function() {
    scwin.gform_onload();
};
scwin.onpageunload = function() {
};
scwin.fn_getParam = function() {
    var pvd = scwin.fn_GetProvider();
    var Temp0 = pvd.split("&")[0];
    var Temp1 = pvd.split("&")[1];
    var Temp2 = pvd.split("&")[2];
    var Temp3 = pvd.split("&")[3];
    //alert(pvd +' / '+ Temp0  +' / '+  Temp1 +' / '+ Temp2);

    scwin.gAcptNo = Temp0.split("=")[1];
    scwin.gMainFormCd = Temp1.split("=")[1]; // 처리시 뷰=P,  조회시 뷰=R
    scwin.gWinTyp = Temp2.split("=")[1];
    scwin.gPvd = Temp3.split("=")[1];
    //alert('gPvd='+gPvd);

};
scwin.fn_GetProvider = function() {
    var url = frame.srcUrl;
    var arr = url.split("?")[1];
    return (arr.length >= 1 ? arr : undefined);
};
scwin.fn_read_sync = function() {
    var url = "/DisclosureStatus.do?method=readDisclosureFncCond" + "&ACPT_NO=" + scwin.gAcptNo + "&GUBUN=B" + "&SCREN_ID=" + scwin.vScrenID + "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    dts_Item.DataID = encodeURI(url);
    dts_Item.reset();
};
scwin.fn_getNullValue = function(obj) {
    var str = $c.stf.getObjectValue(obj);
    if (str == '') {
        str = 0;
    }
    return str;
};
scwin.fn_setCheckBox = function() {
    if (scwin.gLdMktTp == "1" || scwin.gLdMktTp == "6") {
        // 유가,코넥스 : 0이하일 경우 해당
        if (scwin.fn_getNullValue(edt_QTR_SALES) <= 0) {
            chk_QTR_SALES.setValue(1);
            edt_QTR_SALES.ReadOnlyForeColor = 'red';
        }
    } else if (scwin.gLdMktTp == "2") {
        // 코스닥 : 3억미만일 경우 해당
        if (scwin.fn_getNullValue(edt_QTR_SALES) < 300000000) {
            chk_QTR_SALES.setValue(1);
            edt_QTR_SALES.ReadOnlyForeColor = 'red';
        }
    }
};
scwin.btn_Close_onclick = async function() {
    await $c.frame.CloseFrame();
};
scwin.dts_Item_OnLoadError = function() {
    $c.stf.alert_error(dts_Item);
};
scwin.dts_Item_OnLoadCompleted = function(rowcount) {
    $c.lcd.fn_setCheckBox();
};
scwin.gform_onload = function() {
    // 패널라운드 처리
    $c.cm.PanelToGroupBox(panel_Item);
    scwin.fn_getParam();
    if (scwin.gMainFormCd == '70567' || scwin.gMainFormCd == '00567' ||
        scwin.gMainFormCd == '91567' || scwin.gMainFormCd == '31001' ||
        scwin.gMainFormCd == '70443' || scwin.gMainFormCd == '70016') {
        $c.stf.showObj(panel_Hidden, true);
    } else {
        $c.stf.showObj(panel_Hidden, false);
    }
    scwin.fn_read_sync();
    if (scwin.gLdMktTp == "1") {
        // 유가,코넥스 : 0이하일 경우 해당
        txa_2_3.Text = '분기매출액 = 결산 - 3분기\r\n결산=[91567]감사보고서제출 당기누적금액\r\n3분기=[50003]XBRL재무제표(3분기 당기누적금액)';
        txa_2_3.color = '#15549c';
        txa_3_1.Text = '당기 3개월 매출액이 0원인 경우 "해당"으로 표시';
        txa_3_1.color = '#15549c';
    } else if (scwin.gLdMktTp == "2") {
        txa_2_3.Text = '분기매출액 = 결산 - 3분기\r\n결산=[70567]감사보고서제출 당기누적금액\r\n3분기=[50003]XBRL재무제표(3분기 당기누적금액)';
        txa_2_3.color = '#15549c';
        txa_3_1.Text = '당기 3개월 매출액이 3억 미만인 경우 "해당"으로 표시';
        txa_3_1.color = '#15549c';
    } else if (scwin.gLdMktTp == "6") {
        txa_2_3.Text = '분기매출액 = 결산 - 3분기\r\n결산=[31001]감사보고서제출 당기누적금액\r\n3분기=[50003]XBRL재무제표(3분기 당기누적금액)';
        txa_2_3.color = '#15549c';
        txa_3_1.Text = '당기 3개월 매출액이 0원인 경우 "해당"으로 표시';
        txa_3_1.color = '#15549c';
    }
};
]]></script>

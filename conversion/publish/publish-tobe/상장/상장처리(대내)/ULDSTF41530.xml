/**
 * @method
 * @name setContnId
 * @description set Contn Id 처리
 * @param {Object} obj 컴포넌트
 * @returns {void}
 * @hidden N
 */
scwin.setContnId = function(obj) {
    if (Number(obj) > 0) {
        // 그리드에서 선택시
        scwin.clickIsurCd = dts_List.getCellData(Number(obj), "ISUR_CD");
        scwin.clickBackListDesignDD = dts_List.getCellData(Number(obj), "BACKLIST_DESIGN_DD");
    } else {
        scwin.clickIsurCd = "";
        scwin.clickBackListDesignDD = "";
    }
};

/**
 * @method
 * @name openDetail
 * @description open Detail 처리
 * @param {Number} row 행 인덱스
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.openDetail = async function(row) {
    scwin.setContnId(row);
    if (row < 0) {
        // 그리드에서 선택시
        scwin.clickIsurCd = "";
        scwin.clickBackListDesignDD = "";
    }
    const hight = "490";
    const pageNM = "ULDSTF41531";
    const options = {
        id: "" + pageNM + "",
        title: "우회상장기업 입력",
        type: "browserPopup",
        width: "1050px",
        height: hight,
        callbackFn: "scwin.popupCallback"
    };

    $c.win.openPopup("/lstmgt/" + pageNM + ".gfm", options);
};


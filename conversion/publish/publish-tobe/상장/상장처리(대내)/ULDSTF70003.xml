/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.onpageload = async function() {
    try {
        const parentWin = $c.frame.path("../");
        scwin.vID = parentWin.clickID;
        await scwin.readSync(); // 조회수행
    } catch (ex) {

    return scwin.clickBzProcsNo;
};

/**
 * @method
 * @name openDetail
 * @description open Detail 처리
 * @param {Number} row 행 인덱스
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.openDetail = async function(row) {
    let hight = "700";
    let yPoint = "100";
    let secugrpId;
    if (row > 0) {
        // 그리드에서 선택시
        scwin.setBzProcsNo(row);
        secugrpId = dts_List.getCellData(row, 'SECUGRP_ID');
    } else {
        // 신규버튼 선택시
        scwin.clickBzProcsNo = ""; // 초기화
        secugrpId = cmb_NEW_SECUGRP_ID.getValue();
    }
    // alert("[secugrpId]"+secugrpId);
    if (secugrpId === SECUGRP_ID_DR || secugrpId === SECUGRP_ID_FS) {
        hight = "830";
        yPoint = "0";
    }
    // alert("[hight]"+hight);
    const options = {
        id: "ULDSTF05003",
        title: $c.lc.fn_getSecuGrpNm(secugrpId) + " 예비심사관리",
        type: "browserPopup",
        width: "1030px",
        height: hight,
        callbackFn: "scwin.popupCallback"
    };

    $c.win.openPopup("/lstproc/ULDSTF05003.gfm", options);
};

/**
 * @method
 * @name excelDown
 * @description 정보를 excel로 다운 받는다.
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.excelDown = async function() {
    if (dts_List.getRowCount() > 0) {
        // 엑셀 로그
        $c.stf.doLogSave("ULDSTF05002.xml", SCREN_PROCS_TP_CD_07);
        $c.data.downloadGridViewExcel(grd_List, {fileName: "예비심사리스트", type: "3"});
    } else {
        await $c.win.alert("해당데이터가 없습니다. 조회후 다운받으십시요.");
    }
};

/**
 * @method
 * @name btn_Search_onclick
 * @description btn_Search 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_Search_onclick = async function() {
    try {
        await scwin.search();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDMGT42030.btn_Search_onclick" });
    }
};

/**
 * @method
 * @name btn_Excel_onclick
 * @description btn_Excel 클릭 이벤트
 * @returns {void}
 * @hidden N
 */
scwin.btn_Excel_onclick = function() {
    try {
        $c.data.downloadGridViewExcel(grd_Grid, {fileName: "접속로그", type: "8"});
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT42030.btn_Excel_onclick" });
    }
};

/**
 * @method
 * @name dts_List_OnLoadCompleted
 * @description dts_List 로드 완료 후처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @param {Number} rowcount 조회 건수
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.dts_List_OnLoadCompleted = async function(rowcount) {
    try {
        if (dts_List.errorMsg) {
            await $c.win.alert(dts_List.errorMsg);
        } else {
            FillGridHeaderTotalCnt(rowcount, panel_page);
        }
        btn_Search.setDisabled(false);
        btn_Search.src = "../img/btn_select.gif";
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDMGT42030.dts_List_OnLoadCompleted" });
    }
};

/**
 * @method
 * @name dts_List_OnLoadError
 * @description dts_List 로드 오류 처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @returns {void}
 * @hidden N
 */
scwin.dts_List_OnLoadError = function() {
    try {
        $c.win.alert + $c.data.getMessage(dts_List);
        btn_Search.setDisabled(false);
        btn_Search.src = "../img/btn_select.gif";
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT42030.dts_List_OnLoadError" });
    }
};

/**
 * @method
 * @name img_FromCal_onclick
 * @description img_FromCal 클릭 이벤트

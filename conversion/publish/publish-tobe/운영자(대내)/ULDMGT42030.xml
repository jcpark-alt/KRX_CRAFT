/**
 * @method
 * @name search
 * @description 일자 체크
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.search = async function() {
    // 일자 체크
    if (getObjectValue(edt_FromDate).length < 8) {
        await $c.win.alert("접속일자 올바르게 입력하십시오.");
        edt_FromDate.focus();
        return;
    }
    btn_Search.setDisabled(true);
    btn_Search.src = "../img/btn_select_d.gif";
    const sbmOptions = {
        id : "sbm_dts_List",
        action : "/usrlog.do",
        ref : "",
        target : "dts_List=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};


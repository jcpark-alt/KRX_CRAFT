/**
 * @method
 * @name setCode
 * @description set Code 처리
 * @returns {void}
 * @hidden N
 */
scwin.setCode = function() {
    edt_FromDate.setValue($c.ut.cGetToday("yyyymmdd")); // 현재날짜

};

/**
 * @method
 * @name getChkValue
 * @description get Chk Value 처리
 * @param {Object} obj 컴포넌트
 * @returns {void}
 * @hidden N
 */
scwin.getChkValue = function(obj) {
    return (obj.checked) ? "Y" : "N";
};

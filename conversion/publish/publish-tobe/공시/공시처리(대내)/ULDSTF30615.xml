};

/**
 * @method
 * @name init
 * @description 화면 초기화 — 파라미터 수신·기본값·컴포넌트 초기 설정(onpageload 에서 순차 호출)
 * @returns {void}
 * @hidden N
 */
scwin.init = function() {
    scwin.isur_cd = frame.opener.key_isur_cd;
    scwin.chrg_tp_cd = frame.opener.key_chrg_tp_cd;
    scwin.seq = frame.opener.key_seq;
    scwin.assgn_dd = frame.opener.key_assgn_dd;
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name btn_Cancel_onclick
 * @description 「닫기」 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_Cancel_onclick = async function() {
    try {
        await $c.win.closePopup();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF30615.btn_Cancel_onclick" });
    }
};

/**
 * @method
 * @name dts_Master_OnLoadCompleted
 * @description dts_Master 로드 완료 후처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @param {Number} rowcount 조회 건수
 * @returns {void}
 * @hidden N
 */
scwin.dts_Master_OnLoadCompleted = function(rowcount) {
    try {
        scwin.compareInfo();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF30615.dts_Master_OnLoadCompleted" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name read
 * @description read 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.read = async function() {
    url += "&ISUR_CD=" + scwin.isur_cd;
    url += "&CHRG_TP_CD=" + scwin.chrg_tp_cd;
    url += "&SEQ=" + scwin.seq;
    url += "&ASSGN_DD=" + scwin.assgn_dd;
    url += "&SCREN_ID=" + "ULDSTF30615.xml";
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    const sbmOptions = {
        id : "sbm_dts_Master",
        action : "/ListedCompany.do",
        ref : "",
        target : "dts_Master=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name compareInfo
 * @description compare Info 처리
 * @returns {void}
 * @hidden N
 */
scwin.compareInfo = function() {
    const columnID = new Array('CHRG_NM', 'DEP_NM', 'JOBTITL_NM', 'TEL_NO', 'CELLPHONE_NO', 'FAX_NO', 'EMAIL', 'EDU_COMPLT_YN', 'EDU_CRS_NM', 'EDU_COMPLT_DD', 'DISCLS_PROFS_YN', 'DISCLS_PROFS_AHTH_DD', 'LOC_ADDR', 'LOC_DTL_ADDR');
    let obj1;
    let obj2;
    for (let i = 0; i < columnID.length; i++) {
        obj1 = $p.getComponentById("txb_" + columnID[i]);
        obj2 = $p.getComponentById("txb_BF_" + columnID[i]);
        if (obj1.getValue() !== obj2.getValue()) {
            obj2.style.backgroundColor = '#98fb98';
        }
    }
};

 * @returns {void}
 * @hidden N
 */
scwin.getParIsur = function(arrPar) {
    // 넘길 인수를 지정하는 펑션
    arrPar[0] = ""; // 코드값을 포함할 컨트롤
    arrPar[1] = ""; // 명칭값을 포함할 컨트롤
    // arrPar[2] = fr_SecuGrpId;                            // 명칭값을 포함할 컨트롤

    return arrPar.length;
};

/**
 * @method
 * @name setParIsur
 * @description 상장신청인 선택 팝업호출용
 * @param {Array} arrPar 팝업 파라미터 배열(참조 채움)
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.setParIsur = async function(arrPar) {
    const dbClickYn = arrPar[0].DBCLICKYN;
    if (dbClickYn === "Y") {
        txb_ISUR_CD1.setValue(arrPar[0].ISUR_CD);
        txb_COM_NM1.setValue(arrPar[0].ISUR_NM);
        vIsurCd = arrPar[0].ISUR_CD;
    }
    await scwin.search();
};

/**
 * @method
 * @name changeFormat
 * @description change Format 처리
 * @returns {void}
 * @hidden N
 */
scwin.changeFormat = function() {
    const ar = new Array(txb_Chrg1_WORK_TM, txb_Chrg2_WORK_TM, txb_Chrg3_WORK_TM, txb_Chrg4_WORK_TM, txb_Chrg5_WORK_TM);
    for (let i = 0; i < ar.length; i++) {
        const bfVal = ar[i].getValue();
        if (bfVal !== "") {
            const afVal = $c.stf.FormatDateEx(bfVal);
            ar[i].setValue(afVal);
        }
    }
};

/**
 * @method
 * @name getParIsur
 * @description 상장신청인 선택 팝업호출용

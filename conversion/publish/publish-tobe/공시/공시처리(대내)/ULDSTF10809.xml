		<script type="text/javascript" lazy="false"><![CDATA[

scwin.time_no = frame.opener.scwin.time_no;
scwin.time_field = frame.opener.scwin.time_field;

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {void}
 * @hidden N
 */
scwin.onpageload = function() {
    try {
        scwin.init();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF10809.onpageload" });
    }
};

/**
 * @method
 * @name onpageunload
 * @description 화면 언로드 시 정리 처리
 * @returns {void}
 * @hidden N
 */
scwin.onpageunload = function() {
};

/**
 * @method
 * @name init
 * @description 화면 초기화 — 파라미터 수신·기본값·컴포넌트 초기 설정(onpageload 에서 순차 호출)
 * @returns {void}
 * @hidden N
 */
scwin.init = function() {
    const clientnow = new Date();
    const curYear = "" + clientnow.getYear();
    let curMonth = "" + ((clientnow.getMonth()) + 1);
    if (curMonth.length === 1) curMonth = "0" + curMonth;
    let curDay = "" + clientnow.getDate();
    if (curDay.length === 1) curDay = "0" + curDay;
    let hours = "" + clientnow.getHours();
    if (hours.length === 1) hours = "0" + hours;
    let minutes = "" + clientnow.getMinutes();
    if (minutes.length === 1) minutes = "0" + minutes;
    let date = curYear + curMonth + curDay;
    edt_Date.setValue(date);
    cmb_Hour.setValue(hours);
    cmb_Minute.setValue(minutes);
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name btn_Save_onclick
 * @description 「저장」 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_Save_onclick = async function() {
    try {
        await scwin.confirm();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF10809.btn_Save_onclick" });
    }
};

/**
 * @method
 * @name img_FromCal_onclick
 * @description img_FromCal 클릭 이벤트
 * @returns {void}
 * @hidden N
 */
scwin.img_FromCal_onclick = function() {
    try {
        popUpCalendar2(edt_Date);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF10809.img_FromCal_onclick" });
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name confirm
 * @description confirm 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.confirm = async function() {
    let date = edt_Date.getValue();
    const hour = cmb_Hour.getValue();
    const minute = cmb_Minute.getValue();
    if (date === '') {
        await $c.win.alert("날자를 입력해 주세요.");
        return;
    }
    if (hour === '') {
        await $c.win.alert("시간을 입력해 주세요.");
        return;
    }
    if (minute === '') {
        await $c.win.alert("분을 입력해 주세요.");
        return;
    }
    const msg = date + "일" + hour + "시" + minute + "분 을 입력하시겠습니까?";
    const time = '' + date + hour + minute + "00";
    if (scwin.time_field === 'N') {
        let obj = opener.eval("txb_NOTI_DDTM" + scwin.time_no);
    } else if (scwin.time_field === 'A') {
        let obj = opener.eval("txb_ACPT_DDTM" + scwin.time_no);
    }
    obj.setValue(time);
    await $c.win.closePopup();
};
]]></script>

/**
 * @method
 * @name setCodes
 * @description set Codes 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.setCodes = async function() {
    const sbmOptions = {
        id : "sbm_dts_WRNT_ISUR_CD",
        action : "/CodeAction.do",
        ref : "",
        target : "dts_WRNT_ISUR_CD=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

/**
 * @method
 * @name search
 * @description search 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.search = async function() {
    url += "&SCREN_ID=" + "ULDSTF32000.xml";
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    const sbmOptions = {
        id : "sbm_dts_List",
        action : "/ELWInfo.do",
        ref : "",
        target : "dts_List=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    if (dts_List.getRowCount() > 0) {
        await scwin.readELWPersonInCharge(grd_List, 1, "ISUR_CD");
    } else {
        txb_Corp_COM_NM.setValue('');
        dts_Chrg1_Info.removeAll();
        dts_Chrg2_Info.removeAll();
        dts_Chrg3_Info.removeAll();
    }
};

/**
 * @method
 * @name readELWPersonInCharge
 * @description read ELWPerson In Charge 처리
 * @param {String} GridID GridID
 * @param {Number} row 행 인덱스
 * @param {*} colid colid
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.readELWPersonInCharge = async function(GridID, row, colid) {
    if (row < 1) return;
    const objDataID = document.all(GridID.DataID); // 가져오는 방식이 좀 특이하다..

    const vISUR_CD = objDataID.getCellData(row, "ISUR_CD");
    txb_Corp_COM_NM.setValue(objDataID.getCellData(row, "COM_NM"));
    let url = "";

    // 공시책임자(유, 코)
    url += "&SCREN_ID=" + "ULDSTF32000.xml";
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    const sbmOptions = {
        id : "sbm_dts_Chrg1_Info",
        action : "/ELWInfo.do",
        ref : "",
        target : "dts_Chrg1_Info=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    // 공시담당자1, 공시담당자(유, 코)
    const sbmOptions2 = {
        id : "sbm_dts_Chrg2_Info",
        action : "/ELWInfo.do",
        ref : "",
        target : "dts_Chrg2_Info=body.content",
        isProcessMsg : false
    };

    const sbmRtn2 = await $c.sbm.executeDynamic(sbmOptions2);
    // TODO Stage2: sbmRtn2 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    // 공시담당자2, 공시실무자(유, 코)
    const sbmOptions3 = {
        id : "sbm_dts_Chrg3_Info",
        action : "/ELWInfo.do",
        ref : "",
        target : "dts_Chrg3_Info=body.content",
        isProcessMsg : false
    };

    const sbmRtn3 = await $c.sbm.executeDynamic(sbmOptions3);
    // TODO Stage2: sbmRtn3 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

/**
 * @method
 * @name btn_Search_onclick
 * @description 「조회」 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_Search_onclick = async function() {
    try {
        await scwin.search();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF32000.btn_Search_onclick" });
    }
};

/**
 * @method
 * @name grd_List_OnClick
 * @description grd_List 클릭 처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @param {Number} row 행 인덱스
 * @param {*} colid colid
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.grd_List_OnClick = async function(row, colid) {
    try {
        await scwin.readELWPersonInCharge(grd_List, row, colid);
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF32000.grd_List_OnClick" });
    }
};

/**
 * @method
 * @name dts_List_OnLoadCompleted
 * @description dts_List 로드 완료 후처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @param {Number} rowcount 조회 건수
 * @returns {void}
 * @hidden N
 */
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    try {
        $c.stf.fillGridHeaderTotalCnt(rowcount, panel_page);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF32000.dts_List_OnLoadCompleted" });
    }
};


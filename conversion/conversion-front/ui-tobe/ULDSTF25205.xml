/**
 * @method
 * @name scwin.btn_Search_onclick
 * @author Inswave
 * @date 2026. 10. 30
 * @description 조회 버튼 클릭 (조회 영역 Enter 키도 이 핸들러). (원본 btn_Search onclick → fn_Search)
 * @param {Object} e 이벤트 객체
 * @returns
 * @hidden N
 */
scwin.btn_Search_onclick = async function (e) {
    try {
        await scwin.selectList();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF25205.btn_Search_onclick" });
    }
};


/**
 * @method
 * @name scwin.selectList
 * @author Inswave
 * @date 2026. 10. 30
 * @description 감사보고서 제출 목록 조회 — 조회조건은 dma_search 에 바인딩돼 있다. 건수를 적는다. (원본 fn_Search + dts_Grid OnLoadCompleted — §5.1)
 * @returns {Promise<Boolean>} 조회 성공 여부
 * @hidden N
 */
scwin.selectList = async function () {
    const sbmOptions = {
        id : "sbm_selectList",
        method : "get",
        // TODO: 명세 TO-BE 경로가 "get /api/discls/" 로 끝이 잘려 있다 — 명세 원문 그대로 둔다, 실제 끝 경로 확인 (§10 #1)
        action : "/api/discls/",
        ref : "dma_search",
        target : "dlt_list=body",
        gridview : "grd_Grid"
    };

    const result = await $c.sbm.executeDynamic(sbmOptions);
    if (result?.skipped) return false;    // 진행 중 조회가 있어 이번 호출은 건너뜀
    if (!result.responseJSON?.success) return false;    // 실패 안내는 공통 오류 핸들러(원본 dts_Grid OnLoadError → alert_error)

    spn_page.setValue(dlt_list.getRowCount());
    return true;
};


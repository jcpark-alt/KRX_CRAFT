// 원본 : /dsclproc/ULDSTF25205.gfm (감사보고서 제출 — 공시 통계)
/*
 * 화면 동작
 *  - 시장구분·법인코드·검색일자 기간·표준산업업종(대·중·소)·결산월로 감사보고서 제출 현황을 조회한다(명세 GET /api/discls/).
 *  - 시장구분은 전체 권한(9) 사용자만 고를 수 있고, 유가·코스닥 사용자는 자기 시장으로 고정되며 시장구분 열을 숨긴다.
 *  - (정정)공시일 칸을 더블클릭하면 그 공시를 공시뷰어로 연다. [엑셀다운로드]는 목록을 내려받는다.
 * 업무 분석 : conversion/conversion-front/ui/completed/ULDSTF25205/ULDSTF25205.md (§번호는 이 문서의 절)
 */

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name scwin.onpageload
 * @author Inswave
 * @date 2026. 10. 30
 * @description 페이지로드. 로딩 로직은 scwin.init 하나에 둔다(code-convention 초기화 절). (§3)
 * @returns
 * @hidden N
 */
scwin.onpageload = async function () {
    try {
        await scwin.init();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF25205.onpageload" });
    }
};

/**
 * @method
 * @name scwin.init
 * @author Inswave
 * @date 2026. 10. 30
 * @description 로딩 — 법인 자동완성 → 기간선택 콤보·기본 조회조건 → 기간 달력·조회 Enter 키 바인딩 → 사용자 시장구분. 원본처럼 자동 조회는 하지 않는다. (원본 gform_onload — §3)
 * @returns
 * @hidden N
 */
scwin.init = async function () {
    // 1) 법인코드 자동완성 — 입력 중 회사 목록을 보여 주고 고르면 법인명을 채운다 (원본 fn_com_isur + Grd_com_isur 이벤트 묶음)
    await $c.cm.comIsur(txb_ISUR_CD, txb_COM_NM);

    // 2) 기간선택 콤보와 기본 조회조건 (원본 fn_SetCode)
    //    TODO: 표준산업업종 대·중·소 코드 목록 API 가 명세에 없어 콤보는 「전체」만 있다 — 원본 /CodeAction.do?method=listStdIndtp Flag 1·2·3 (§10 #2)
    $c.data.comboCbDataSetPeriod(cmb_PeriodTp);
    scwin.setDefaultSearch();

    // 3) 기간 달력 선후 검사(규칙 37)·조회 영역 Enter 키(규칙 22)
    $c.date.compareFromToDate(edt_SDATE, edt_EDATE, ["검색 시작일", "검색 종료일"]);
    $c.win.setEnterKeyEvent(panel_1, scwin.btn_Search_onclick);

    // 4) 사용자 시장구분 (원본 fn_Init)
    scwin.applyUserMarket();
};


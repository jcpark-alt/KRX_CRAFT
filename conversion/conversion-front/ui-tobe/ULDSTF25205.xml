/**
 * @method
 * @name scwin.setDefaultSearch
 * @author Inswave
 * @date 2026. 10. 30
 * @description 기본 조회조건 — 검색일자는 1년 전 ~ 오늘, 결산월은 전체. (원본 fn_SetCode 의 기간 설정 — §6.1)
 * @returns
 * @hidden N
 */
scwin.setDefaultSearch = function () {
    const today = $c.date.getServerDateTime("yyyyMMdd");
    dma_search.set("dateS", $c.date.addYear(today, -1));
    dma_search.set("dateE", today);
    dma_search.set("acntclsMm", scwin.ACNTCLS_MM_ALL);
};

/**
 * @method
 * @name scwin.applyUserMarket
 * @author Inswave
 * @date 2026. 10. 30
 * @description 사용자 시장구분 — 시장구분을 사용자 시장으로 두고, 전체(9) 사용자만 고를 수 있게 연다. 그 밖의 사용자는 시장구분 열을 숨긴다. (원본 fn_Init — §6.1)
 * @returns
 * @hidden N
 */
scwin.applyUserMarket = function () {
    const userMarket = $c.session.getUserInfo("market") ?? "";
    dma_search.set("ldMktTpCd", userMarket);

    if (userMarket === scwin.MKT_ALL) {
        rdo_MKT_ID.setDisabled(false);
    } else {
        grd_Grid.setColumnVisible("ldMktTpNm", false);
    }
};

/**
 * @method
 * @name scwin.filterStdIndtp
 * @author Inswave
 * @date 2026. 10. 30
 * @description 표준산업업종 하위 목록을 상위 코드 앞자리로 거르고 하위 선택을 「전체」로 돌린다. 상위가 전체면 거르지 않는다. (원본 dts_STD_INDTP2/3 OnFilter — §6.4)
 * @param {Object} dataList 거를 하위 목록 dataList
 * @param {Object} combo 하위 콤보
 * @param {String} parentValue 상위 콤보에서 고른 코드
 * @param {Number} len 비교할 앞자리 수 (중분류 2, 소분류 4)
 * @returns
 * @hidden N
 */
scwin.filterStdIndtp = function (dataList, combo, parentValue, len) {
    dataList.clearFilter();
    if (!$c.util.isEmpty(parentValue)) {
        const prefix = String(parentValue).substring(0, len);
        dataList.setColumnFilter({
            type : "func",
            colIndex : "value",
            key : function (value) {
                return $c.util.isEmpty(value) || String(value).substring(0, len) === prefix;
            },
            condition : "and"
        });
    }
    // 원본은 하위 선택을 그대로 두었다 — 걸러져 사라진 코드가 조회조건에 남지 않게 「전체」로 돌린다 (§8 #3)
    combo.setSelectedIndex(0);
};

/**
 * @method
 * @name scwin.openViewer
 * @author Inswave
 * @date 2026. 10. 30
 * @description 공시뷰어 — 그 행의 접수번호로 공시뷰어를 조회 모드("R")로 연다. 접수번호가 없으면 열지 않는다. (원본 fn_setContnId + fn_OpenDisclViewer — §6.3)
 * @param {Number} rowIndex 행 인덱스(화면 번호)
 * @returns
 * @hidden N
 */
scwin.openViewer = async function (rowIndex) {
    // TODO: 접수번호(acptNo)는 명세 응답에 없다 — 원본 ACPT_NO 를 camelCase 로 가정 (§10 #3)
    const acptNo = dlt_list.getCellData(rowIndex, "acptNo");
    if ($c.util.isEmpty(acptNo)) return;
    await $c.stf.openDisclViewer(acptNo, "R");
};

/**
 * @method
 * @name scwin.excelDown
 * @author Inswave
 * @date 2026. 10. 30
 * @description 목록을 엑셀로 내려받는다. (원본 GridToExcel("감사보고서 제출") — 작업 로그 doLogSave 는 옮기지 않음, §6.5)
 * @returns
 * @hidden N
 */
scwin.excelDown = function () {
    $c.data.downloadGridViewExcel(grd_Grid, {
        // 파일명 {menuId}_{이름}_{yyyyMMddHHmmss}.xlsx (전환 규칙 42)
        fileName : $c.win.getProgramId() + "_감사보고서 제출_" + $c.date.getServerDateTime("yyyyMMddHHmmss") + ".xlsx"
    });
};

/**
 * @method
 * @name scwin.fmtListStat
 * @author Inswave
 * @date 2026. 10. 30
 * @description 상장여부·회사명 글자색 — 상장상태코드가 D(폐지)면 red, N(비상장)이면 green, 그 밖(Y 상장)은 기본색. 값은 그대로 표시한다. (원본 Decode(LIST_STAT_CD, …) color — 규칙 40·43)
 * @param {String} data 셀 값
 * @param {String} formattedData 형식 적용 값
 * @param {Number} rowIndex 행 인덱스
 * @param {Number} colIndex 열 인덱스
 * @returns {String} 표시 값
 * @hidden N
 */
scwin.fmtListStat = function (data, formattedData, rowIndex, colIndex) {
    const cls = scwin.LIST_STAT_CLASS[this.getCellData(rowIndex, "listStatCd")];
    if (cls) {
        this.setCellClass(rowIndex, colIndex, cls);
    } else {
        this.removeCellClass(rowIndex, colIndex);
    }
    return formattedData;
};

/**
 * @method
 * @name scwin.fmtDisclsDdtm
 * @author Inswave
 * @date 2026. 10. 30
 * @description (정정)공시일 — 더블클릭으로 공시뷰어를 여는 칸이라 배경을 bg_orange 로 표시한다. 날짜 형식은 열의 displayFormat 그대로. (원본 bgcolor #ffff99 — 규칙 40·43)
 * @param {String} data 셀 값
 * @param {String} formattedData 형식 적용 값
 * @param {Number} rowIndex 행 인덱스
 * @param {Number} colIndex 열 인덱스
 * @returns {String} 표시 값
 * @hidden N
 */
scwin.fmtDisclsDdtm = function (data, formattedData, rowIndex, colIndex) {
    this.setCellClass(rowIndex, colIndex, "bg_orange");
    return formattedData;
};

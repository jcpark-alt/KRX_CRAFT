 * (원본 fn_read_sync — §5.1)
 * @param {String} bzProcsNo 조회할 업무처리번호
 * @returns {Promise<Boolean>} 통신 성공 여부
 * @hidden N
 */
scwin.selectOne = async function (bzProcsNo) {
    const sbmOptions = {
        id : "sbm_selectOne",
        action : "/api/listing/lstproc/stock/issuance-manage-kindstk-detail/select-one",
        method : "get",
        target : "dma_Item=body",
        isProcessMsg : false
    };

    dma_Item.setEmptyValue();
    const result = await $c.sbm.executeDynamic(sbmOptions, { bzProcsNo : bzProcsNo });
    if (result?.skipped) return false;    // 진행 중 처리가 있어 이번 호출은 건너뜀
    return result?.responseJSON?.success === true;
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name scwin.applyForm
 * @author Inswave
 * @date 2026. 10. 29
 * @description 조회 뒤 체크 값을 "Y"/"N" 으로 맞추고, 체크 상태에 따라 하위 영역을 펼치거나 접는다.
 * (원본 initForm — 빈 값을 0 으로 채운 뒤 showObj, §6.1)
 * @returns
 * @hidden N
 */
scwin.applyForm = function () {
    // 원본 Gauce 는 체크 1 / 해제 0 이었다. 서버가 "1" 로 줘도 체크로 보이게 "Y"/"N" 으로 맞춘다 (§8 #2, §10 #1)
    scwin.YN_KEYS.forEach(key => {
        const value = String(dma_Item.get(key) ?? "");
        dma_Item.set(key, (value === "Y" || value === "1") ? "Y" : "N");
    });

    // 상위 영역이 접히면 하위 영역(panel_6·7 ⊂ panel_5, panel_9·10 ⊂ panel_8)도 함께 가려진다
    scwin.showPanel(panel_1, dma_Item.get("proftDivYn"));
    scwin.showPanel(panel_2, dma_Item.get("remainProprtDistrYn"));
    scwin.showPanel(panel_3, dma_Item.get("voterghtExcldYn"));
    scwin.showPanel(panel_4, dma_Item.get("voterghtLmtYn"));
    scwin.showPanel(panel_5, dma_Item.get("redmptYn"));
    scwin.showPanel(panel_6, dma_Item.get("comRedmptRghtYn"));
    scwin.showPanel(panel_7, dma_Item.get("shrhdRedmptRghtYn"));
    scwin.showPanel(panel_8, dma_Item.get("convYn"));
    scwin.showPanel(panel_9, dma_Item.get("comConvRghtYn"));
    scwin.showPanel(panel_10, dma_Item.get("shrhdConvRghtYn"));
};

/**
 * @method
 * @name scwin.showPanel
 * @author Inswave
 * @date 2026. 10. 29
 * @description 체크 값이 "Y" 이면 영역을 보이고 아니면 감춘다. (원본 $c.stf.showObj(panel, flag) — 규칙 V29)
 * @param {Object} panel 영역 그룹 컴포넌트
 * @param {String} yn 체크 값
 * @returns
 * @hidden N
 */
scwin.showPanel = function (panel, yn) {
    if (yn === "Y") {
        panel.show("");
    } else {
        panel.hide();
    }
};
]]></script>

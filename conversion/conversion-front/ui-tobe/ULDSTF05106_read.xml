/*
 * 화면 동작
 *  - 부모(92002 · 92050 종류주식 관련 공통 화면)가 연 종류주식 상세를 조회만 한다(저장·수정 버튼 없음).
 *  - 이익배당·잔여재산분배·의결권배제·의결권제한·상환·전환 체크에 따라 하위 영역을 펼치고 접는다.
 *  - 닫을 때 부모에게 돌려주는 값은 없다.
 * 업무 분석 : conversion/conversion-front/ui/completed/ULDSTF05106/ULDSTF05106_read.md (§번호는 이 문서의 절)
 */

// 체크박스 여부 키 — 체크 "Y" / 해제 "N" (마크업 trueValue·falseValue, §2.2)
scwin.YN_KEYS = [
    "proftDivYn", "cmstkPct1DivYn", "lwstDivRtDscYn", "miscDivYn", "cashDivYn", "partctpYn", "acctpYn", "ndivtmVoterghtYn",
    "remainProprtDistrYn", "voterghtExcldYn", "voterghtLmtYn",
    "redmptYn", "comRedmptRghtYn", "comCashRedmptYn", "shrhdRedmptRghtYn", "shrhdCashRedmptYn",
    "convYn", "comConvRghtYn", "shrhdConvRghtYn"
];

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name scwin.onpageload
 * @author Inswave
 * @date 2026. 10. 29
 * @description 페이지로드. 로딩 로직은 scwin.init 하나에 둔다(code-convention 초기화 절). (§3)
 * @returns
 * @hidden N
 */
scwin.onpageload = async function () {
    try {
        await scwin.init();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF05106_read.onpageload" });
    }
};

/**
 * @method
 * @name scwin.init
 * @author Inswave
 * @date 2026. 10. 29
 * @description 로딩 — 업무처리번호 수신 → 달력 바인딩 → 상세 조회(번호가 있을 때) → 체크 상태에 맞춰 영역 표시.
 * (원본 init/gform_onload — §3)
 * @returns
 * @hidden N
 */
scwin.init = async function () {
    // 1) 업무처리번호 — openPopup data 우선(05106 과 같은 키, 가이드 §6.5).
    //    범위 밖 호출자 92002·92050 은 아직 data 없이 열고 자기 scwin.pBzProcsNo 에 번호를 둔다 → 그때만 부모 값을 읽는다(호환, §1.2).
    //    원본은 pBzProcsNo 를 읽은 직후 부모 vBzProcsNo 로 덮어써 92002 가 준 번호를 버렸다 → 고침 (§8 #1)
    const param = $c.data.getParameter() ?? {};
    scwin.bzProcsNo = String(param.bzProcsNo ?? "");
    if ($c.util.isEmpty(scwin.bzProcsNo)) {
        // TODO: 92002·92050 이 openPopup data { bzProcsNo } 로 넘기게 바뀌면 이 호환 분기를 지운다 (§10 #3)
        scwin.bzProcsNo = String($c.win.getParent()?.scwin?.pBzProcsNo ?? "");
    }

    // 2) 달력 검사 바인딩(1회) — 기간 쌍은 compareFromToDate 만(규칙 37). 달력은 읽기 전용이다.
    $c.date.compareFromToDate(tbx_COM_REDMPT_PD_STRT_DD, tbx_COM_REDMPT_PD_END_DD, ["회사 상환기간 시작일", "회사 상환기간 종료일"]);
    $c.date.compareFromToDate(tbx_SHRHD_REDMPT_PD_STRT_DD, tbx_SHRHD_REDMPT_PD_END_DD, ["주주 상환기간 시작일", "주주 상환기간 종료일"]);
    $c.date.compareFromToDate(tbx_COM_CONV_PD_STRT_DD, tbx_COM_CONV_PD_END_DD, ["회사 전환기간 시작일", "회사 전환기간 종료일"]);
    $c.date.compareFromToDate(tbx_SHRHD_CONV_PD_STRT_DD, tbx_SHRHD_CONV_PD_END_DD, ["주주 전환기간 시작일", "주주 전환기간 종료일"]);

    // 3) 상세 조회 — 번호가 없으면 빈 값(원본 KIND_STK_DTL_INOUT 헤더 빈 행)
    if ($c.util.isEmpty(scwin.bzProcsNo)) {
        dma_Item.setEmptyValue();
    } else {
        await scwin.selectOne(scwin.bzProcsNo);
    }

    // 4) 체크 값 정리 + 하위 영역 표시
    scwin.applyForm();
};


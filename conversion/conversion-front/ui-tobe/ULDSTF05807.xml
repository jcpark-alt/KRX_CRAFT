		<script lazy="false" type="text/javascript"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.screenId = "ULDSTF05807";
// 원본 : /lstproc/ULDSTF05807.gfm (상장원부 — 신주인수권증서)
/*
 * 화면 동작
 *  - [종목 찾기](ULDSTF92017 상장종목찾기)로 신주인수권증서(SR) 종목을 고르면 상장원부 상세를 조회한다(진입 시 조회 없음).
 *  - 모든 항목이 조회 전용이다(수정·저장 없음).
 * 업무 분석 : conversion/conversion-front/ui/completed/ULDSTF05807/ULDSTF05807.md (§번호는 이 문서의 절)
 */

// 고정값
scwin.secugrpId = "";       // 증권그룹ID — init 에서 신주인수권증서(SR) (원본 vSecugrpID = SECUGRP_ID_SR)

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name scwin.onpageload
 * @author Inswave
 * @date 2026. 10. 29
 * @description 페이지로드. 로딩 로직은 scwin.init 하나에 둔다(code-convention 초기화 절). (§3)
 * @returns
 * @hidden N
 */
scwin.onpageload = async function () {
    try {
        await scwin.init();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF05807.onpageload" });
    }
};

/**
 * @method
 * @name scwin.init
 * @author Inswave
 * @date 2026. 10. 29
 * @description 로딩 — 증권그룹 고정 → 달력 바인딩. 진입 시 조회는 없다(종목을 골라야 조회). (원본 gform onload — §3)
 * @returns
 * @hidden N
 */
scwin.init = async function () {
    // 1) 증권그룹 — 원본 전역 vSecugrpID = SECUGRP_ID_SR ("메뉴단에서 파라미터로 받자" 주석이 있으나 상수, §1.2)
    scwin.secugrpId = $c.lc.glb.SECUGRP_ID_SR;

    // 2) 달력 검사 바인딩(1회) — 단일 달력은 checkCalendarFormat, 기간 쌍은 compareFromToDate 만(규칙 37)
    $c.date.checkCalendarFormat(edt_ISU_DD, "yyyyMMdd");
    $c.date.checkCalendarFormat(edt_LIST_DD, "yyyyMMdd");
    $c.date.checkCalendarFormat(edt_MKT_DELIST_DD, "yyyyMMdd");
    $c.date.compareFromToDate(edt_EXER_STRT_DD, edt_EXER_END_DD, ["목적주권 청약시작일", "목적주권 청약종료일"]);
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name scwin.img_ISU_CD_onclick
 * @author Inswave
 * @date 2026. 10. 29
 * @description 종목 찾기(돋보기) 버튼 클릭 — 종목을 고르면 바로 조회한다. (원본 img_ISU_CD onclick — §4)
 * @param {Object} e 이벤트 객체
 * @returns
 * @hidden N
 */
scwin.img_ISU_CD_onclick = async function (e) {
    try {
        await scwin.openIsuPopup();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF05807.img_ISU_CD_onclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name scwin.selectDetail
 * @author Inswave
 * @date 2026. 10. 29
 * @description 상장원부 상세 조회 → dma_detail. (원본 fn_read_sync dts_Item readIssueBook — §5.1)
 * @param {String} isuCd 종목코드
 * @returns
 * @hidden N
 */
scwin.selectDetail = async function (isuCd) {
    const sbmOptions = {
        id : "sbm_selectDetail",
        method : "get",
        action : "/api/listing/lstproc/warrant/listedregister/select-one",
        target : "dma_detail=body",
        isProcessMsg : false
    };

    // TODO: 원본이 URL 에 붙이던 SCREN_ID·SCREN_PROCES_TP_CD(01) 는 명세에 없어 보내지 않는다 (§10 #3)
    const result = await $c.sbm.executeDynamic(sbmOptions, { isuCd : isuCd, secugrpId : scwin.secugrpId });
    if (result?.skipped) return;    // 진행 중 조회가 있어 이번 호출은 건너뜀
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name scwin.openIsuPopup
 * @author Inswave
 * @date 2026. 10. 29
 * @description 상장종목찾기(ULDSTF92017) — 고른 종목을 조회 조건에 넣고 바로 조회한다. 취소·닫기면 아무것도 하지 않는다.
 * (원본 JongmokSearch(txb_SearchCd, txb_SearchNm, vSecugrpID, js_market, "A") + fn_read_sync — §6.1)
 * @returns
 * @hidden N
 */
scwin.openIsuPopup = async function () {
    // TODO: 원본은 stockSearch.js JongmokSearch(ULDCOM00003 종목검색창)였다. 전환된 종목 팝업 계약이 있는 92017 로 연다 (§10 #1)
    const result = await $c.lc.popFindIsu(scwin.secugrpId);

    // 취소·닫기(X)도 { isCloseButtonClick } 객체가 온다 → 종목코드로 판정한다(원본은 취소해도 다시 조회 — §8 #2)
    if ($c.util.isEmpty(result?.isuCd)) return;

    dma_search.set("isuCd", result.isuCd);
    dma_search.set("isuKorNm", result.isuKorNm ?? "");

    await scwin.search();
};

/**
 * @method
 * @name scwin.search
 * @author Inswave
 * @date 2026. 10. 29
 * @description 상장원부 조회 — 이전 종목의 값이 남지 않게 상세를 비우고 고른 종목으로 조회한다. (원본 fn_read_sync — §1.4 업무 2)
 * @returns
 * @hidden N
 */
scwin.search = async function () {
    dma_detail.setEmptyValue();
    await scwin.selectDetail(dma_search.get("isuCd"));
};
]]></script>

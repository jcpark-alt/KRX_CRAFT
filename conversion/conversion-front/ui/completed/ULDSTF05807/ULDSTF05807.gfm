<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="540" height="365" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
	@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Item">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Cod">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Item">
			<bindinfo>
				<column col="ISU_CD" ctrl="txb_ISU_CD" param="value" readonly="False"></column>
				<column col="ISU_SRT_CD" ctrl="txb_ISU_SRT_CD" param="value" readonly="False"></column>
				<column col="ISU_KOR_NM" ctrl="txb_ISU_KOR_NM" param="value" readonly="False"></column>
				<column col="ISU_KOR_ABBRV" ctrl="txb_ISU_KOR_ABBRV" param="value" readonly="False"></column>
				<column col="ISU_ENG_NM" ctrl="txb_ISU_ENG_NM" param="value" readonly="False"></column>
				<column col="ISU_ENG_ABBRV" ctrl="txb_ISU_ENG_ABBRV" param="value" readonly="False"></column>
				<column col="STKCERT_KIND_NM" ctrl="txb_STKCERT_KIND_NM" param="value" readonly="False"></column>
				<column col="ISU_RND" ctrl="edt_ISU_RND" param="text" readonly="False"></column>
				<column col="ISU_DD" ctrl="edt_ISU_DD" param="text" readonly="False"></column>
				<column col="LIST_DD" ctrl="edt_LIST_DD" param="text" readonly="False"></column>
				<column col="DELIST_DD" ctrl="edt_MKT_DELIST_DD" param="text" readonly="False"></column>
				<column col="LIST_SHRS" ctrl="edt_LIST_SHRS" param="text" readonly="False"></column>
				<column col="EXER_PRC" ctrl="edt_EXER_PRC" param="text" readonly="False"></column>
				<column col="EXER_STRT_DD" ctrl="edt_EXER_STRT_DD" param="text" readonly="False"></column>
				<column col="EXER_END_DD" ctrl="edt_EXER_END_DD" param="text" readonly="False"></column>
				<column col="NPARVALSTK_YN" ctrl="edt_NPARVALSTK_YN" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Item"></ref>
		</mxbinder>
	</model>
    <components>
		<panel id="panel_Item" left="5" top="5" width="519" height="325" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_22" class="TopCondition_01" left="9" top="10" width="120" height="20" text="종목코드(명)">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" border-color="#FFFFFF"></extproperty>
		</label>
			<textbox id="txb_ISU_SRT_CD" class="TopCondition_01_write" left="327" top="55" width="70" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<label id="label_17" class="TopCondition_01" left="273" top="55" width="50" height="20" text="단축코드">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_14" class="TopCondition_01" left="9" top="55" width="120" height="20" text="종목코드">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ISU_KOR_NM" class="TopCondition_01_write" left="134" top="79" width="373" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7"></extproperty>
			</textbox>
			<label id="label_2" class="TopCondition_01" left="9" top="79" width="120" height="20" text="한글종목명">
			<extproperty font-size="12"></extproperty>
			</label>
			<textbox id="txb_ISU_KOR_ABBRV" class="TopCondition_01_write" left="134" top="103" width="266" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7"></extproperty>
			</textbox>
			<label id="label_16" class="TopCondition_01" left="9" top="103" width="120" height="20" text="한글종목약명">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ISU_ENG_NM" class="TopCondition_01_write" left="134" top="127" width="373" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7"></extproperty>
			</textbox>
			<label id="label_3" class="TopCondition_01" left="9" top="127" width="120" height="20" text="영문종목명">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_SearchCd" class="TopCondition_01_write" left="134" top="10" width="98" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<textbox id="txb_ISU_CD" class="TopCondition_01_write" left="134" top="55" width="98" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<textbox id="txb_SearchNm" class="TopCondition_01_write" left="238" top="10" width="246" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7"></extproperty>
			</textbox>
			<label id="label_8" class="TopCondition_01" left="9" top="151" width="120" height="20" text="영문종목약명">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ISU_ENG_ABBRV" class="TopCondition_01_write" left="134" top="151" width="266" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7"></extproperty>
			</textbox>
			<label id="label_4" class="TopCondition_01" left="9" top="176" width="120" height="20" text="발행회차">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<image id="img_ISU_CD" left="489" top="10" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_ISU_RND" class="panel_maskedit_write_02" left="134" top="175" width="65" height="20">
			<property alignment="2" datemodify="True" generaledit="False" numeric="True" readonly="True" readonlybackcolor="#b9d4f7" showliteral="false" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_20" class="TopCondition_01" left="9" top="297" width="120" height="20" text="목적주권 청약종료일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_19" class="TopCondition_01" left="9" top="273" width="120" height="20" text="목적주권 청약시작일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_6" class="TopCondition_01" left="9" top="249" width="120" height="20" text="상장폐지일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_13" class="TopCondition_01" left="9" top="225" width="120" height="20" text="상장일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<mxmaskedit id="edt_LIST_DD" class="panel_maskedit_write_01" left="134" top="225" width="65" height="20">
			<property format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" readonlybackcolor="#b9d4f7"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_MKT_DELIST_DD" class="panel_maskedit_write_01" left="134" top="249" width="65" height="20">
			<property format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" readonlybackcolor="#b9d4f7"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_EXER_STRT_DD" class="panel_maskedit_write_01" left="134" top="273" width="65" height="20">
			<property format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" readonlybackcolor="#b9d4f7"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_EXER_END_DD" class="panel_maskedit_write_01" left="134" top="297" width="65" height="20">
			<property format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" readonlybackcolor="#b9d4f7"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_ISU_DD" class="panel_maskedit_write_01" left="134" top="201" width="65" height="20">
			<property format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" readonlybackcolor="#b9d4f7"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_1" class="TopCondition_01" left="9" top="201" width="120" height="20" text="발행일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<image id="image_3" left="8" top="36" width="500" height="6" src="../img/img_line1.gif"></image>
			<label id="label_7" class="TopCondition_01" left="220" top="225" width="170" height="20" text="목적주권 1주의 발행가액(원)">
			<extproperty font-size="12" color="#343434" text-align="right" border-color="#0000FF"></extproperty>
			</label>
			<mxmaskedit id="edt_EXER_PRC" class="panel_maskedit_write_02" left="394" top="224" width="113" height="20">
			<property alignment="2" datemodify="True" generaledit="False" numeric="True" readonly="True" readonlybackcolor="#b9d4f7" showliteral="false" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_10" class="TopCondition_01" left="270" top="201" width="120" height="20" text="신주인수권증서수량">
			<extproperty font-size="12" color="#343434" text-align="left" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_18" class="TopCondition_01" left="270" top="176" width="120" height="20" text="목적주권 주식의종류">
			<extproperty font-size="12" color="#000000" text-align="left" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_STKCERT_KIND_NM" class="TopCondition_01_write" left="394" top="176" width="115" height="20" readonly="readonly" maxlength="1000">
			<extproperty color="#343434" background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<mxmaskedit id="edt_LIST_SHRS" class="panel_maskedit_write_02" left="394" top="200" width="113" height="20">
			<property alignment="2" datemodify="True" generaledit="False" numeric="True" readonly="True" readonlybackcolor="#b9d4f7" showliteral="false" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_50" class="TopCondition_01" left="297" top="248" width="92" height="20" text="무액면주식 여부"></label>
			<mxmaskedit id="edt_NPARVALSTK_YN" class="panel_maskedit_write_02" left="394" top="248" width="30" height="20">
			<property alignment="1" numeric="False" readonly="True" readonlybackcolor="#b9d4f7"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
		</panel>
		<image id="btn_Close" left="472" top="335" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js");
	#include("../js/list_common.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/stockSearch.js");
	
	var vScrenID = "ULDSTF05807.gfm";
	var vSecugrpID = SECUGRP_ID_SR; //(신주인수권증서)메뉴단에서 파라미터로 받자..
	var fn_GetPar, fn_SetPar;

/*
	function fn_GetParIsuCd(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = getObjectValue(txb_SearchCd); 	// 코드값을 포함할 컨트롤
		arrPar[1] = getObjectValue(txb_SearchNm);	// 명칭값을 포함할 컨트롤
		arrPar[2] = vSecugrpID;
		return arrPar, length;
	} 

	function fn_SetParIsuCd(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			txb_SearchCd.value = arrPar[0].ISU_CD;
			txb_SearchNm.value = arrPar[0].ISU_KOR_NM;
			fn_read_sync();
		}	
	}
*/

	function fn_read_sync() {
		var url = "/IssueBook.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=readIssueBook&inputMessageId=LISTING_ISUBOOK_SEARCH_OUT";
		url += "&SECUGRP_ID=" + vSecugrpID;
		url += "&P_KEY=" + getObjectValue(txb_SearchCd);
		dts_Item.DataID = encodeURI(url);
		dts_Item.Reset();
	}
]]></script>

<events><event for="img_ISU_CD" eventname="onclick"><![CDATA[
	// 2009.02.26 팝업창변경.
	//fn_GetPar = fn_GetParIsuCd;
	//fn_SetPar = fn_SetParIsuCd;
	//fn_PopFindIsu(vSecugrpID);

	JongmokSearch(txb_SearchCd, txb_SearchNm, vSecugrpID, js_market, "A");
	fn_read_sync();
]]></event>

<event for="btn_Update" eventname="onclick"><![CDATA[
	fn_update();
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="dts_Item" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Item);
]]></event>

<event for="dts_Item" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	//alert('[dts_Item.Status]'+dts_Item.Status);
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Item);
]]></event></events>
</gform>

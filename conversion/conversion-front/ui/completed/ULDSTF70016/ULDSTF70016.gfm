					<column width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="명" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" id="LIST_APPLNT_ISUR_NM"></column>
				</group>
				<group name="신탁기관">
					<column id="TRST_INST_ISUR_CD" width="110" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="발행기관코드" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
					<column id="TRST_INST_ISUR_NM" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="명" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
				</group>
				<column id="BAS_EXP_YN" width="78" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="만기일유무" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
				<column id="EXP_DD" width="80" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="만기일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" mask="XXXX-XX-XX"></column>
				<column id="TAX_TP_NM" width="220" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="과세유형" color="#343434" decao="3" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" align="left"></column>
				<column id="LSTTRD_DD" width="77" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="최종거래일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" mask="XXXX-XX-XX"></column>
				<group name="LP회원1">
					<column id="LP_MBR_NO1" width="80" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="회원사번호" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
					<column id="LP_MBR_NM1" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="명" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
				</group>
				<group name="LP회원2">
					<column id="LP_MBR_NO2" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="회원사번호" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
					<column id="LP_MBR_NM2" width="99" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="명" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" tooltipshow="False"></column>
				</group>
				<group name="LP회원3">
					<column id="LP_MBR_NO3" width="99" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="회원사번호" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" align="center"></column>
					<column id="LP_MBR_NM3" width="99" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="명" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" align="left"></column>
				</group>
				<column id="DISTR_PAY_BAS_DD" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="분배기준일1" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" mask="XX-XX"></column>
				<column id="DISTR_PAY_BAS_DD2" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="분배기준일2" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" mask="XX-XX" align="center"></column>
				<column id="DISTR_PAY_BAS_DD3" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="분배기준일3" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" mask="XX-XX" align="center"></column>
				<column id="DISTR_PAY_BAS_DD4" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="분배기준일4" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True" mask="XX-XX" align="center"></column>
				<column name="분배기준일5" width="90" id="DISTR_PAY_BAS_DD5" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일6" width="90" id="DISTR_PAY_BAS_DD6" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일7" width="90" id="DISTR_PAY_BAS_DD7" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일8" width="90" id="DISTR_PAY_BAS_DD8" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일9" width="90" id="DISTR_PAY_BAS_DD9" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일10" width="90" id="DISTR_PAY_BAS_DD10" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일11" width="90" id="DISTR_PAY_BAS_DD11" mask="XX-XX" sort="True" align="center"></column>
				<column name="분배기준일12" width="90" id="DISTR_PAY_BAS_DD12" mask="XX-XX" sort="True" align="center"></column>
			</format>
			<ref dataid="dts_New_Search"></ref>
			</mxgrid>
		</panel>
		<mxtab id="MaxTab_01" class="Tab_01" left="5" top="65" width="1255" height="20">
			<property activeindex="1"></property>
			<format>
				<tabpage divid="panel_1" title="마감처리"></tabpage>
				<tabpage divid="panel_2" title="마감처리내역"></tabpage>
			</format>
		</mxtab>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js"); // showObj(ObjID, flag) SetWindowPos(ObjID, nTop, nLeft, nWidth, nHeight)
	#include("../js/utils.js");
	#include("../js/list_common_digital.js");
	#include("../js/common.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/PopupCalendar.js");
	//#include("../js/elw_recv_common.js");

	var vScrenID = "ULDSTF70016.gfm";
	var procJob = "";
	var pMngId = js_id;
	var pJobTitl = js_jobtitl;      //권한
	var vBzProcsNo;
	var vIsuCd;
	
	function fn_list_sync() {
	
	
		var urltaskdd = "&TASK_DD=" + getObjectValue(edt_TASK_DD); // 마감일
		
		var url;
		
		//상장일자 가져오기 (TBLD_BZ_CALND 테이블사용)
		url = "/ElwListedReceive.do?method=getElwListingListDd&inputMessageId=ELW_LISTING_TR_SEND_LOG_INOUT";
		url += urltaskdd;
		dts_Get_ListDD.DataID = encodeURI(url);
		dts_Get_ListDD.Reset();
		
		//마감이력가져오기
		url = "/digital/DigitalListinvstg.do?method=searchDigitalFinalLog&inputMessageId=DIGITAL_FINAL_LOG";
		url += urltaskdd;
		dts_Item.DataID = encodeURI(url);
		dts_Item.Reset();
		
		if (MaxTab_01.ActiveIndex == 1) {

			//마감처리 조회
			var url_new = "/listingCommon.do?method=listGeneral" +
			"&outputMessageId=DIGITAL_NEWLISTING_SEARCH_OUT" +
			//"&outputMessageId=DIGITAL_NEWLISTING_SEARCH_RV_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.digital.newlst.select.list.condition"+
			 
			 "&{P}param01=" + getObjectValue(edt_LIST_DD);
			url_new += "&SCREN_ID=" + vScrenID;
			url_new += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
		
			dts_New_Proc.DataID = encodeURI(url_new);
			dts_New_Proc.Reset();
			ShowWin(grd_New_Proc); 


		} else if (MaxTab_01.ActiveIndex == 2) {

			//마감처리내역 조회
			var url_new = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=DIGITAL_NEWLISTING_SEARCH_RV_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.digital.newlst.select.log.condition"+
			 "&{P}param01=" + getObjectValue(edt_TASK_DD);
			url_new += "&SCREN_ID=" + vScrenID;
			url_new += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_New_Search.DataID = encodeURI(url_new);
			dts_New_Search.Reset();
			ShowWin(grd_New_ProcLog); 
		
		}
	}


	//재마감 버튼 클릭시 (현업관리자만 버튼보임)
	function fn_recls() {
		procJob = "재마감처리";
		if (! fn_checkProcDt(procJob))  return;
		
		var res = window.confirm("재마감처리를 선택 하셨습니다.\n재마감처리는 이전마감처리기록을 삭제하므로\n재마감처리후 다시 마감처리를 하셔야 됩니다.\n\n재마감처리를 하시겠습니까?");
		if (res) {
			fn_trSetHeader();
			
			trs_Cls.Action="/digital/DigitalListinvstg.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_04+"&method=DigitalReClsProcsSave";
			trs_Cls.KeyName="toinb_dataid4";
			trs_Cls.KeyValue="JSP(I:pInput=dts_Cls)";
			trs_Cls.Post();
		}
	}

	function fn_trSetHeader() {
		// CHRG_EMP_NO,LIST_DD 설정 
		dts_Cls.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DIGITAL_FINAL_LOG_EMP";
		dts_Cls.reset();
		dts_Cls.AddRow();
	}

	//담당자 확인 버튼 클릭시
	function fn_revw(){
		procJob = "담당자 확인";
		if (! fn_checkProcDt(procJob))  return;
		
		res = window.confirm("담당자 확인 하시겠습니까?");
		if (res) {
			fn_trs_revw();
		}
	}

	//담당자 확인
	function fn_trs_revw() {
		fn_trSetHeader();
		dts_Cls.NameValue(1, "CHRG_EMP_NO") =  js_emp_no;
		
		trs_revw.Action="/digital/DigitalListinvstg.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_02+"&method=DigitalRevwProcsSave";
		trs_revw.KeyName="toinb_dataid4";
		trs_revw.KeyValue="JSP(I:pInput=dts_Cls)";
		trs_revw.Post();
	}	

	//팀장승인 버튼 클릭시
	function fn_cls() {
	
		if ( getObjectValue(txb_APPROV_TM) == "") {
			alert("담당자가 확인하지 않았습니다. 담당자 확인 후 마감처리를 해주십시오.");
			return true;
		} 
		
		procJob = "마감처리";
        if (getObjectValue(edt_LIST_DD) == "") {
			alert("[상장일]이 없습니다.");edt_LIST_DD.focus();return;
		}
	
		var commit = window.confirm("팀장 승인 하시겠습니까?");
		
		if (commit) {
			fn_trs();
		}
	}

	//팀장승인 
	function fn_trs() {
		fn_trSetHeader();
		dts_Cls.NameValue(1, "LIST_DD") = getObjectValue(edt_LIST_DD);
		dts_Cls.NameValue(1, "CHRG_EMP_NO") =  js_emp_no;
		
		trs_Cls.Action="/digital/DigitalListinvstg.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_02+"&method=DigitalClsProcsSave";
		trs_Cls.KeyName="toinb_dataid4";
		trs_Cls.KeyValue="JSP(I:pInput=dts_Cls)";
		trs_Cls.Post();
	}	

	// 담당자 승인, 팀장승인, 재마감처리 
	function buttonSetDis() {
	
		//담당자일때
		if(pJobTitl == "03"){
			if (getObjectValue(txb_BZ_CLS_TM) != "" ){
				btn_Revw.src = "../img/btn/btn_revw_d.gif";
				btn_Revw.disabled = true;
				btn_Cls.src = "../img/btn_BosApv_d.gif";
				btn_Cls.disabled = true;
			} else {
				if (getObjectValue(txb_APPROV_EMP_NM) == "") { //담당자확인을 않했을 경우
					btn_Revw.src = "../img/btn/btn_revw.gif";
					btn_Revw.disabled = false;
				}else{
					btn_Revw.src = "../img/btn/btn_revw_d.gif";
					btn_Revw.disabled = true;
				}
				btn_Cls.src = "../img/btn_BosApv_d.gif";
				btn_Cls.disabled = true;
			}
		//	showObj(btn_Recls, false);
		}
		//팀장일때 - 마감처리
		else{
			if (getObjectValue(txb_BZ_CLS_TM) != ""  ){
				btn_Revw.src = "../img/btn/btn_revw_d.gif";
				btn_Revw.disabled = true;
				btn_Cls.src = "../img/btn_BosApv_d.gif";
				btn_Cls.disabled = true;
			} else {	
				if (getObjectValue(txb_APPROV_EMP_NM) == "") { //담당자확인을 안했을 경우		
					btn_Revw.src = "../img/btn/btn_revw.gif";
					btn_Revw.disabled = false;
					btn_Cls.src = "../img/btn_BosApv_d.gif";
					btn_Cls.disabled = true;
				}else{		
					btn_Revw.src = "../img/btn/btn_revw_d.gif";
					btn_Revw.disabled = true;
					btn_Cls.src = "../img/btn_BosApv.gif";
					btn_Cls.disabled = false;
				}		
			}
		//	showObj(btn_Recls, false);
		}
			
		//재마감 처리 버튼 - 시스템 관리자 
		if( js_dep_cd == 'ZSYS' ){
			btn_Recls.src = "../img/btn_ReCls.gif";
			btn_Recls.disabled = false;
			showObj(btn_Recls, true);
		} else {
			showObj(btn_Recls, false);
	    }
	}

	function fn_checkProcDt(str) {
		var vCurDate = cGetToday("yyyymmdd");
		var pCheck = true;
		
		if (getObjectValue(edt_TASK_DD) != vCurDate) {
			alert("[마감일]이 현재일경우만 '"+str+"'를 할수 있습니다.");
			pCheck = false;
		} 
		
		/*
		if(pCheck){
			for ( var i=1; i<=dts_New_Proc.CountRow; i++ ) 
			{
				if ( dts_New_Proc.NameValue(i,"ISU_MKTPARTC_NO") == "" ) 
				{
					alert("발행회사명에 대한 시장참가자번호가 없는 종목이 있습니다. 시스템관리자에게 문의바랍니다.");
					pCheck = false;
					break;
				} 
			}
		}
		*/
		return pCheck;
	}

	function fn_ExcelDown(){
		if (MaxTab_01.ActiveIndex == 1) {
			grd_New_Proc.GridToExcel("신규상장 마감처리목록", "", "8");
		} else if (MaxTab_01.ActiveIndex == 2) {
			grd_New_ProcLog.GridToExcel("신규상장 마감처리이력목록", "", "8");
		}
	}
	
]]></script>
	
		<events><event for="MaxTab_01" eventname="OnSelChanged(nIndex)"><![CDATA[
	if (nIndex == "1") {
		edt_TASK_DD.ReadOnly = true;
		img_TASK_DD.disabled = true;
		edt_TASK_DD.ReadOnlyBackColor = "#b9d4f7";
		edt_TASK_DD.Text = cGetToday("yyyymmdd");
	} else if (nIndex == "2") {
		edt_TASK_DD.ReadOnly = false;
		img_TASK_DD.disabled = false;
	}
	fn_list_sync();
	
]]></event>
		<event for="btn_Search" eventname="onclick"><![CDATA[
	fn_list_sync();
]]></event>
		<event for="btn_ProcClose" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
		<event for="btn_ProcExcel" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	fn_ExcelDown();
]]></event>
		<event for="btn_SearchExcel" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	fn_ExcelDown();
]]></event>
		<event for="img_TASK_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_TASK_DD);
]]></event>
		<event for="dts_Get_ListDD" eventname="OnLoadError()"><![CDATA[
	//alert_error(dts_Get_ListDD);
	alert(getMessageParam("MSG-0002", ""));
]]></event>
		<event for="dts_Item" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Item);
]]></event>
		<event for="dts_New_Proc" eventname="OnLoadError()"><![CDATA[
	//alert_error(dts_New_Proc);
	alert(getMessageParam("MSG-0002", ""));
]]></event>
		<event for="dts_New_Search" eventname="OnLoadError()"><![CDATA[
	//alert_error(dts_New_Search);
	alert(getMessageParam("MSG-0002", ""));
]]></event>
		<event for="dts_New_Proc" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	edt_New_Proc_TotalCnt.value = "총 " + dts_New_Proc.CountRow + " 건";
	CloseWin(rowcount, grd_New_Proc);

	//dts_Add_Proc.ClearData();
	vBzProcsNo = dts_New_Proc.NameValue(0, 'BZ_PROCS_NO');

	buttonSetDis();
	
]]></event>
		<event for="dts_New_Search" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	edt_New_Search_TotalCnt.value = "총 " + dts_New_Search.CountRow + " 건";
	CloseWin(rowcount, grd_New_ProcLog); 
]]></event>
		<event for="trs_Save" eventname="OnFail()"><![CDATA[
	alert(getMessageParam("MSG-A002", procJob));
	alert_error(trs_Save);	
]]></event>
		<event for="trs_Save" eventname="OnSuccess()"><![CDATA[
	alert(getMessageParam("MSG-0001", procJob));
	fn_list_sync();
]]></event>
		<event for="btn_ProcClose" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
		<event for="btn_SearchClose" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
		<event for="gform" eventname="onload"><![CDATA[

	//재마감 처리 관리자만 보일 수 있도록 
	if(js_dep_cd == 'ZSYS' ){
			btn_Recls.src = "../img/btn_ReCls.gif";
			btn_Recls.disabled = false;
			showObj(btn_Recls, true);
	} else {
		showObj(btn_Recls, false);
	}
	
	//담당자, 팀장확인 버튼
	btn_Revw.src = "../img/btn/btn_revw_d.gif";
	btn_Revw.disabled = true;
	btn_Cls.src = "../img/btn_BosApv_d.gif";
	btn_Cls.disabled = true;

	//마감일
	var vCurDate = cGetToday("yyyymmdd");
	setObjectValue(edt_TASK_DD, vCurDate);

	MaxTab_01.ActiveIndex = 1;
	PanelToGroupBox(panel_Top);
	fn_list_sync();

]]></event>
		<event for="btn_Recls" eventname="onclick"><![CDATA[
		// 재마감처리
	fn_recls();
]]></event>
		<event for="btn_Revw" eventname="onclick"><![CDATA[
		// 담당자 확인
	fn_revw();
]]></event>
		<event for="btn_Cls" eventname="onclick"><![CDATA[
		//팀장 승인
	fn_cls();
]]></event>
		<event for="trs_revw" eventname="OnFail()"><![CDATA[
	alert(getMessageParam("MSG-A002", procJob));
]]></event>
		<event for="trs_revw" eventname="OnSuccess()"><![CDATA[
	alert(getMessageParam("MSG-0001", procJob));
	fn_list_sync();
]]></event>
		<event for="trs_Cls" eventname="OnFail()"><![CDATA[
	alert(getMessageParam("MSG-A002", procJob));
]]></event>
		<event for="trs_Cls" eventname="OnSuccess()"><![CDATA[
	alert(getMessageParam("MSG-0001", procJob));
	fn_list_sync();
]]></event>
		<event for="grd_New_Proc" eventname="OnClick(row, colid)"><![CDATA[]]></event></events>
</gform>

<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="500" height="410" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
	@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_code">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_selectleadcom">
			<property syncload="False"></property>
		</mxdataset>
	</model>
    <components>
		<mxgrid id="grd_leadcom" class="Grid_01" left="10" top="20" width="210" height="325">
			<property borderstyle="0" editable="False" gtitleheight="0" headborder="4" headlinecolor="#c0c0c0" indwidth="0" linecolor="#c0c0c0" titleheight="25" usingoneclick="1" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<column id="ISU_CD" width="70" show="False" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" headfontstyle="bold" name="코드" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_NM" width="190" headalign="center" headbgcolor="#598fd5" headcolor="#FFFFFF" headfontstyle="bold" name="종목명" color="#000000" sumbgcolor="#fefaef" sumcolor="#343434"></column>
			</format>
			<ref dataid="dts_code"></ref>
		</mxgrid>
		<mxgrid id="grd_selectleadcom" class="Grid_01" left="270" top="20" width="210" height="325">
			<property borderstyle="0" gtitleheight="0" headborder="4" headlinecolor="#c0c0c0" indicatorbkcolor="#FFFFFF" indwidth="0" linecolor="#c0c0c0" titleheight="25" usingoneclick="1" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<column id="ISU_CD" width="70" show="False" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" headfontstyle="bold" name="코드" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_NM" width="190" headalign="center" headbgcolor="#598fd5" headcolor="#FFFFFF" headfontstyle="bold" name="종목명" color="#000000" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="PAGE_IDX" width="60" show="False"></column>
			</format>
			<ref dataid="dts_selectleadcom"></ref>
		</mxgrid>
		<panel id="panel_3" left="350" top="360" width="130" height="32">
			<extproperty></extproperty>
			<image id="btn_confirm" left="10" top="5" width="50" height="22" src="../img/btn_confirm.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="btn_close" left="70" top="5" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<image id="img_rightarr_all" left="237" top="115" width="24" height="20" src="../img/btn_new_arrowR_all.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_rightarr" left="237" top="85" width="24" height="20" src="../img/btn_new_arrowR.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_leftarr_all" left="237" top="230" width="24" height="20" src="../img/btn_new_arrowL_all.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_leftarr" left="237" top="200" width="24" height="20" src="../img/btn_new_arrowL.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/list_common_etn.js");
	
	var fn_GetPar, fn_SetPar;
	var keyIsurCd , keyGubun ; 
	var vScrenID = "ULDSTF08037.gfm";

	// dts_code의 인덱스에 해당하는 값을 dts_selectleadcom에 add한다.
	function fn_add_dts_select(add_index) {
		
		dts_selectleadcom.addRow();
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ISU_CD") = dts_code.NameValue(add_index,"ISU_CD")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ISU_NM") = dts_code.NameValue(add_index,"ISU_NM")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ISUR_CD") = dts_code.NameValue(add_index,"ISUR_CD")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ISUR_NM") = dts_code.NameValue(add_index,"ISUR_NM")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "COM_NM") = dts_code.NameValue(add_index,"COM_NM")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "LIST_DD") = dts_code.NameValue(add_index,"LIST_DD")  ;
		
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "BZ_PROCS_NO") = dts_code.NameValue(add_index,"BZ_PROCS_NO")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_DESIGN_BZ_TP_CD") = dts_code.NameValue(add_index,"ADMISU_DESIGN_BZ_TP_CD")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "MKTACT_ENFORCE_DD") = dts_code.NameValue(add_index,"MKTACT_ENFORCE_DD")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "MKTACT_RELEAS_DD") = dts_code.NameValue(add_index,"MKTACT_RELEAS_DD")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "MKTACT_RSN_CHG_DD") = dts_code.NameValue(add_index,"MKTACT_RSN_CHG_DD")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "GRND_REGUL_NM") = dts_code.NameValue(add_index,"GRND_REGUL_NM")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_RELEAS_GRND_REGUL_NM") = dts_code.NameValue(add_index,"ADMISU_RELEAS_GRND_REGUL_NM")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_RSN_CHG_GRND_REGUL_NM") = dts_code.NameValue(add_index,"ADMISU_RSN_CHG_GRND_REGUL_NM")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_RELEAS_RSN_CONTN") = dts_code.NameValue(add_index,"ADMISU_RELEAS_RSN_CONTN")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_RSN_CONTN") = dts_code.NameValue(add_index,"ADMISU_RSN_CONTN")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_RSN_CHG_CONTN") = dts_code.NameValue(add_index,"ADMISU_RSN_CHG_CONTN")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "ADMISU_DESIGN_BZ_PROCS_NO") = dts_code.NameValue(add_index,"ADMISU_DESIGN_BZ_PROCS_NO")  ;
		dts_selectleadcom.NameValue(dts_selectleadcom.RowPosition , "REMK")  = dts_code.NameValue(add_index,"REMK")  ;
	}
	
	function fn_add(){
		for(i=1; i<=dts_selectleadcom.countrow; i++){
			if( dts_selectleadcom.NameValue(i, "ISU_CD") == dts_code.NameValue(dts_code.RowPosition,"ISU_CD") ) {
				return;
			}
		}

		fn_add_dts_select( dts_code.RowPosition) ;
		
		dts_selectleadcom.SortExpr="+ISU_NM";
		dts_selectleadcom.Sort();
	}	

	function fn_add_all(){
		
		dts_selectleadcom.DeleteAll() ;
		
		grd_selectleadcom.redraw=false ;
		
		for(i=1; i<=dts_code.countrow; i++){
			fn_add_dts_select( i ) ;
		}
		
		grd_selectleadcom.redraw=true ;

		grd_selectleadcom.Focus();
		dts_selectleadcom.RowPosition = "1";

		//dts_selectleadcom.SortExpr="+ISU_NM";
		//dts_selectleadcom.Sort();
	}	

	function fn_del(){
		//var RowPos = dts_selectleadcom.ValueRow(dts_selectleadcom.RowPosition, MTr_2.ItemText);
		var RowPos = dts_selectleadcom.RowPosition;
		dts_selectleadcom.DeleteRow(RowPos);
	}	
	function fn_del_all(){
		dts_selectleadcom.DeleteAll() ;
	}	

	function fn_confirm(){
		fn_SetPar(dts_selectleadcom) ;
		frame.CloseFrame();
	}

	function fn_set_code() {
		if(keyGubun == "3") keyIsurCd = "";	//전체 선택 한 후 진입시엔 모든 종목 검색되도록 발행회사코드 초기화
		
		var url = "/etn/EtnMktAct.do?method=searchEtnAdministrativeIssue&DIV_IDX="+DIV_ETN_IDX_ADMISU_ISU_RELEAS + "&ISUR_CD=" + keyIsurCd ;
		dts_code.DataID = encodeURI(url);
		dts_code.reset();
	}

]]></script>
<events><event for="gform" eventname="onload"><![CDATA[
	gform.scroll="no";

	var arrPar = new Array();
	var prt = frame.Provider("../");
	if (prt != undefined) {
		fn_GetPar = prt.fn_GetPar;
		fn_SetPar = prt.fn_SetPar;
	}
	if (fn_GetPar != undefined) {
		fn_GetPar(arrPar , dts_selectleadcom);
		keyIsurCd	 = (arrPar.length >= 1 ? arrPar[0] : "");
		keyGubun	 = (arrPar.length >= 2 ? arrPar[1] : "");
		
		// elw 종목 조회 보내기
		fn_set_code() ;
	}
	
]]></event>
<event for="grd_leadcom" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_add();
]]></event>

<event for="grd_selectleadcom" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_del();
]]></event>

<event for="btn_confirm" eventname="onclick"><![CDATA[
	fn_confirm();
]]></event>

<event for="btn_close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="dts_code" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_code);
]]></event>

<event for="dts_code" eventname="OnFail()"><![CDATA[
	alert_error(dts_code);
]]></event>

<event for="dts_selectleadcom" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_selectleadcom);
]]></event>

<event for="dts_selectleadcom" eventname="OnFail()"><![CDATA[
	alert_error(dts_selectleadcom);
]]></event>

<event for="img_rightarr" eventname="onclick"><![CDATA[
	fn_add();
]]></event>

<event for="img_leftarr" eventname="onclick"><![CDATA[
	fn_del();
]]></event>

<event for="img_rightarr_all" eventname="onclick"><![CDATA[
	fn_add_all();
]]></event>

<event for="img_leftarr_all" eventname="onclick"><![CDATA[
	fn_del_all();
]]></event></events>
</gform>

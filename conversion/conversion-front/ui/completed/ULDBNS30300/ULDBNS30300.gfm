			<property activeindex="1"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="13"></extproperty>
			<format>
				<tabpage title="상장마감" divid="pnl_Item"></tabpage>
				<tabpage title="상장마감내역" divid="pnl_Item2"></tabpage>

<script><![CDATA[
	#include("../js/PopupCalendar.js");
	#include("../js/libRoundPanel.js");
	#include("../js/list_common.js");
	#include("../js/bns_common.js");
	#include("../js/common.js");
	#include("../js/session.js");
	#include("../js/stf.js");
	#include("../js/utils.js");

	var vScrenID = "ULDBNS30300.gfm";
	var vSelObj;
	var processGp;
	var vRowCount = 0;
	var fn_GetPar, fn_SetPar;
	var vMktCd = '';
	var vStrtDd = '';
	
	/********************************************** 
	* 함수명   : fn_SearchClsDtl
	* 설명       : 상장마감 종목정보 조회한다.
	***********************************************/
	function fn_SearchClsDtl() {
		var param = '';
		param += "&{P}V_BND_MKTACT_TP_CD="+ vMktCd;

		var qryId = '';
		if(processGp == '1') {
			qryId = fn_GetQryId();
			param += "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
			// 분할상환 전송관련 추가 JACKAL_190220
			param += "&{P}V_CLS_DD="+ getObjectValue(edt_PrsntDd);
		}else if(processGp == '2') {
			qryId = fn_GetQryIdEnd();
			param += "&{P}V_STRT_DD="+ dts_CheckCls.NameValue(1, 'END_CLS_DD');
		}

		var dsNm = 'BNS_CLS_ISU_INFO';
		fn_SearchBns(vScrenID, dts_IsuList, dsNm, qryId, param);		

		ShowWin(grd_IsuList);		
	}
	
	/********************************************** 
	* 함수명   : fn_SearchSendData
	* 설명       : 매매전송 종목정보 조회한다.
	***********************************************/
	function fn_SearchSendData() {
		var param = '';
		param += "&{P}V_CLS_DD="+ getObjectValue(edt_BizClsDd);
		param += "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);

		var qryId = 'lds.stf.bnscls.select.listClsEndSendInfo';
		var dsNm = 'BNS_SEND_ISU_INFO';
		fn_SearchBns(vScrenID, dts_SendInfo, dsNm, qryId, param);		

		ShowWin(grd_SendList);		
	}	
	
	/********************************************** 
	* 함수명   : fn_SearchSendData1
	* 설명       : 매매전송 종목정보 조회한다.
	***********************************************/
	function fn_SearchSendData1() {
		var param = '';
		param += "&{P}V_CLS_DD="+ getObjectValue(edt_BizClsDd);
		param += "&{P}V_STRT_DD="+ dts_CheckCls.NameValue(1, 'END_CLS_DD');

		var qryId = 'lds.stf.bnscls.select.listClsEndSendInfo';
		var dsNm = 'BNS_SEND_ISU_INFO';
		fn_SearchBns(vScrenID, dts_SendInfo1, dsNm, qryId, param);		
	}	
	
	/********************************************** 
	* 함수명   : fn_SearchCls
	* 설명       : 상장마감 조회한다.
	***********************************************/
	function fn_SearchCls() {
		var param = '';
		param+= "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
		// 분할상환 전송관련 추가 JACKAL_190220
		param += "&{P}V_CLS_DD="+ getObjectValue(edt_PrsntDd);

		var dsNm = 'BNS_CLS_LIST';
		var qryId = 'lds.stf.bnscls.select.listCls';
		fn_SearchBns(vScrenID, dts_MktList, dsNm, qryId, param);		
		ShowWin(grd_MktList);
	}

	/********************************************** 
	* 함수명   : fn_SearchSendIsuInfo
	* 설명       : 상장마감완료 전송정보 조회한다.
	***********************************************/
	function fn_SearchSendIsuInfo() {
		var param = '';
		param+= "&{P}V_TASK_DD="+ getObjectValue(edt_BizClsDd);

		var dsNm = 'BNS_CLS_SEND_INFO';
		var qryId = 'lds.stf.bnscls.select.listClsSendInfo';
		fn_SearchBns(vScrenID, dts_ClsSendInfo, dsNm, qryId, param);	
		ShowWin(grd_ClsSendInfo);		
	}

	/********************************************** 
	* 함수명   : fn_SearchClsEnd
	* 설명       : 상장마감한 데이터 조회한다.
	***********************************************/
	function fn_SearchClsEnd() {		
		var param = '';
		param += "&{P}V_STRT_DD="+ dts_CheckCls.NameValue(1, 'END_CLS_DD');

		var dsNm = 'BNS_CLS_LIST';
		var qryId = 'lds.stf.bnscls.select.listClsEnd';
		fn_SearchBns(vScrenID, dts_MktList, dsNm, qryId, param);		
		ShowWin(grd_MktList1);
	}

	/********************************************** 
	* 함수명   : fn_SearchClsDd
	* 설명       : 마감일 데이터 조회한다.
	***********************************************/
	function fn_SearchClsDd(clsDd) {
		var param = '';
		param += "&{P}V_STRT_DD="+ clsDd; 

		var dsNm = 'BNS_CHECK_CLS_DD';
		var qryId = 'lds.stf.bnscls.select.readChkClsDd';
		fn_SearchBns(vScrenID, dts_CheckCls, dsNm, qryId, param);		
	}

	/********************************************** 
	* 함수명   : fn_ClsProcs
	* 설명       : 마감처리 한다.
	***********************************************/
	function fn_ClsProcs() {		
		var param = '';
		param+= "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
		var dsNm = 'BNS_CHECK_CLS_PROC';
		var qryId = 'lds.stf.bnscls.select.readChkClsProc';
		dts_CheckClsProc.SyncLoad = "true";
		fn_SearchBns(vScrenID, dts_CheckClsProc, dsNm, qryId, param);	

		//채권마감이력 확인
		if(dts_CheckClsProc.NameValue(1, 'VALID_SEND_CFM') != 'Y') {
			alert('시장조치내역생성 처리를 하십시오.'); 
			return;
		}
		if(dts_CheckClsProc.NameValue(1, 'VALID_BND_CLS') == 'Y') {
			alert('업무마감작업이 이미 종료되었습니다.'); return;
		}

		if(! window.confirm(getMessageParam("MSG-A006", "상장마감"))) return;
		var url = "/bns/ListCls.do?method=processCls" ;
		url += "&SCREN_ID="+ vScrenID ;
		url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_02 ;

		var param = "STRT_DD="+ getObjectValue(edt_StrtDd);
		// 분할상환 전송관련 추가 JACKAL_190220
		param += ",CLS_DD="+ getObjectValue(edt_PrsntDd);	
		
		trs_Save.Action = fn_encodeNSession(url);
		trs_Save.KeyName = "toinb_dataid4";
		trs_Save.KeyValue = "JSP(I:pInput=dts_Temp)";
		trs_Save.Parameters = param;
		trs_Save.Post();		
	}
	
	/********************************************** 
	* 함수명   : fn_SendCfm
	* 설명       : 전송내역 생성 한다.
	***********************************************/
	function fn_SendCfm() {		

		//발행기관 데이터 (종목명, 주소 등) 완성형한글 체크
		var urlck = "/bns/ListCls.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=processCompleteKoreanCheck";
		urlck += "&outputMessageId=BNS_CHECK_CLS_COMPLETE_KOREAN";
		urlck += "&STRT_DD="+ getObjectValue(edt_StrtDd);
		dts_completeKorean.SyncLoad = "true";
		dts_completeKorean.DataID = encodeURI(urlck);
		dts_completeKorean.Reset();

		var div = dts_completeKorean.NameValue(1, 'DIV');
		var isurCd = dts_completeKorean.NameValue(1, 'ISUR_CD');
		var comNm = dts_completeKorean.NameValue(1, 'COM_NM');
		var comAbbrv = dts_completeKorean.NameValue(1, 'COM_ABBRV');
		
		var msg = '';
		if( div == '1' ){
			msg += ' 금일 발행기관 데이터에 문제가 있습니다.';
			msg += '\n\n 문제발생 발행기관코드 : '+ isurCd;
			msg += '\n 문제발생 발행기관명 : '+ comNm;
		}else if( div == '2' ){
			msg += '금일 채권마스터 데이터에 문제가 있습니다.';
			msg += '\n\n 문제발생 표준코드 : '+ isurCd;
			msg += '\n 문제발생 한글종목명 : '+ comNm;
		}
		msg += '\n\n 시스템담당자에게 연락바랍니다.';
		msg += '\n\n 계속 진행하시겠습니까?';

		if(dts_completeKorean.CountRow > 0){
			if(! window.confirm(msg)){
				processGp = '1';
				return;
			}
		}

		var param = '';
		param+= "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
		var dsNm = 'BNS_CHECK_CLS_PROC';
		var qryId = 'lds.stf.bnscls.select.readChkClsProc';
		dts_CheckClsProc.SyncLoad = "true";
		fn_SearchBns(vScrenID, dts_CheckClsProc, dsNm, qryId, param);	

		if(dts_CheckClsProc.NameValue(1, 'VALID_BND_CLS') == 'Y') {
			alert('업무마감작업이 이미 종료되었습니다.'); return;
		}
				
		//발행기관, 채권마스터 종목명에 엔터값 있는지 확인
		var stdCd = dts_CheckClsProc.NameValue(1, 'STD_CD');
		var stdCdAppl = dts_CheckClsProc.NameValue(1, 'STD_CD_APPL');  // jackal_140819 라인구분체크 추가
		var isurCd = dts_CheckClsProc.NameValue(1, 'ISUR_CD');
		var msg = '금일 발행기관, 채권마스터 데이터에 문제가 있습니다.';
		msg += '\n 문제발생 발행기관코드 : '+ isurCd;
		msg += '\n 문제발생 채권마스터코드 : '+ stdCd;
		msg += '\n 문제발생 신청마스터코드 : '+ stdCdAppl;
		msg += '\n 시스템담당자에게 연락바랍니다.';
		if(isurCd != '' || stdCd != '' || stdCdAppl != '') 
		{
			alert(msg); 
			return;
		}
		
		//금일 수신된 신용등급정보를 처리했는지 확인.
		if(dts_CheckClsProc.NameValue(1, 'HAS_CREDIT_RCV') == 'Y') {
			if(dts_CheckClsProc.NameValue(1, 'VALID_CREDIT_RCV') == 'Y') {
				alert('금일 수신된 신용등급정보를 처리하지 않았습니다.\n 신용평가 수신내역을 확인바랍니다.'); return;
			}
		}
		//스트립 통합처리 완료 확인.
		if(dts_CheckClsProc.NameValue(1, 'VALID_STRIP') == 'Y') {
			alert('마감처리 전 스트립 통합처리를 하시기 바랍니다.'); return;
		}
		if(dts_CheckClsProc.NameValue(1, 'VALID_STRIP') == 'F') {
			alert("스트립 시장조치(스트립신규, 추가 및 재결합)와\n\n'스트립 통합처리' 화면내용이 불일치함.\n\n'스트립 통합처리'를 취소 후 다시 진행바람."); return;
		}
		
		// 미처리건 있는지 확인 2026.01.05 추가.
		qryId = 'lds.stf.bnscls.select.listCheckNotComplt';
		dts_notComplt.SyncLoad = "true";
		fn_SearchBns(vScrenID, dts_notComplt, "BNS_CHECK_CLS_NOT_COMPLT", qryId, param);	
		if(dts_notComplt.CountRow > 0) {
		   var msg = "미처리건이 존재합니다. 계속하시겠습니까?\n\n";
			for(var idx = 1; idx <= dts_notComplt.CountRow; idx++) {
				msg += dts_notComplt.NameValue(idx, 'BND_MKTACT_TP_NM') + " : " + dts_notComplt.NameValue(idx, 'CNT') + "건" + "\n";
			}

			if( !window.confirm(msg) ){
				return;
			}
		}

		//종목중복체크
		qryId = 'lds.stf.bnscls.select.listCheckListIsuDupl';
		dts_CheckDup.SyncLoad = "true";
		fn_SearchBns(vScrenID, dts_CheckDup, dsNm, qryId, param);	
		if(dts_CheckDup.CountRow > 0) {
		   var dupMsg = '';
			for(var idx = 1; idx <= dts_CheckDup.CountRow; idx++) {
				dupMsg += dts_CheckDup.NameValue(idx, 'DUP_ISU') +'\n';
			}
			dupMsg += '로 중복조치되었습니다.\n확인 후 다시 처리하여 주십시오.';
			alert(dupMsg);
			return;
		}

		if(! window.confirm(getMessageParam("MSG-A006", "시장조치내역생성"))) return;
		var url = "/bns/ListCls.do?method=processSendCfm" ;
		url += "&SCREN_ID="+ vScrenID ;
		url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_02 ;

		var param = "STRT_DD="+ getObjectValue(edt_StrtDd);
		// 분할상환 전송관련 추가 JACKAL_190220
		param += ",CLS_DD="+ getObjectValue(edt_PrsntDd);	
		
		trs_Save.Action = fn_encodeNSession(url);
		trs_Save.KeyName = "toinb_dataid4";
		trs_Save.KeyValue = "JSP(I:pInput=dts_Temp)";
		trs_Save.Parameters = param;
		trs_Save.Post();		
	}
	
	/********************************************** 
	* 함수명   : fn_ReClsProcs
	* 설명       : 재마감처리 한다.
	***********************************************/
	function fn_ReClsProcs() {
		processGp = '9';

		var param = '';
		param+= "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
		var dsNm = 'BNS_CHECK_CLS_PROC';
		var qryId = 'lds.stf.bnscls.select.readChkClsProc';
		dts_CheckClsProc.SyncLoad = "true";
		fn_SearchBns(vScrenID, dts_CheckClsProc, dsNm, qryId, param);	
		
		//채권마감이력 확인
		var msg = '';
		//시장조치반영완료
		if(dts_CheckClsProc.NameValue(1, 'VALID_BND_CLS1') == 'Y') {
			alert('이미 일일 시장조치반영이 완료 되었습니다.');
			return;		
		}
		if(dts_CheckClsProc.NameValue(1, 'VALID_BND_CLS') == 'Y') {
			msg += '채권송신(매매)데이타를 다시 생성하여 송신 할 경우에 해당합니다.';
			msg += '\n다음 데이타가 클리어(Delete)됩니다.';
			msg += '\n- 채권마감이력';
			msg += '\n- 시장조치 전송내역';
			msg += '\n- 신용평가 전송내역';
			alert(msg);
		}else {
			msg += '업무마감이 되지 않아 업무마감처리를';
			msg += '\n다시 하실수 없습니다.';
			alert(msg);
			return;
		}
				
		if(! window.confirm(getMessageParam("MSG-A006", "재마감처리"))) return;
		dts_SendInfo.ClearData();
		dts_List.ClearData();
		
		var url = "/bns/ListCls.do?method=reProcessCls" ;
		url += "&SCREN_ID="+ vScrenID ;
		url += "&SCREN_PROCES_TP_CD="+ SCREN_PROCS_TP_CD_02 ;

		var param = "STRT_DD="+ getObjectValue(edt_StrtDd);
		
		trs_Save.Action = fn_encodeNSession(url);
		trs_Save.KeyName = "toinb_dataid4";
		trs_Save.KeyValue = "JSP(I:pInput=dts_Temp)";
		trs_Save.Parameters = param;
		trs_Save.Post();		
	}	

	/********************************************** 
	* 함수명   : fn_GetParMktFile
	* 설명       : 시장지파일 팝업에 넘길 데이터를 정의한다.
	***********************************************/
	function fn_GetParMktFile(arrPar) { 
		arrPar[0] = {
			TRD_DD : getObjectValue(edt_BizClsDd)
		};
		return arrPar, length;
	}		
	
	/********************************************** 
	* 함수명   : fn_GetParIsuDtlAndMktactDtl
	* 설명       : 시장조치상세내역 팝업에 넘길 데이터를 정의한다.
	***********************************************/
	function fn_GetParIsuDtlAndMktactDtl(arrPar) { 
		arrPar[0] = {
			STD_CD 		: dts_IsuList.NameValue(dts_IsuList.RowPosition, 'STD_CD')
			, STRT_DD 	: dts_IsuList.NameValue(dts_IsuList.RowPosition, 'STRT_DD')
		};
		return arrPar, length;
	}		
	
		/********************************************** 
	* 함수명   : fn_IntiIsuCol
	* 설명       : 종목정보를 초기화한다.
	***********************************************/
	function fn_IntiIsuCol() {
		grd_IsuList.Redraw = false;
		
		fn_showFalse();

		//상호변경
		if(vMktCd == '201') fn_show201();
		//합병/회사분할
		else if(vMktCd == '202') fn_show202();
		//종목분할
		else if(vMktCd == '203') fn_show202();
		//변경상장종목분할
		else if(vMktCd == '105') fn_show105();
		//BW 신주인수권행사
		else if(vMktCd == '205') fn_show205();
		//BW 분리종목
		else if(vMktCd == '104') fn_show104();
		//일괄상장채권 상장금액조정(월별,일별) 301,320
		else if(vMktCd == '301' || vMktCd == '320') fn_show301320();
		//주식관련사채 권리행사 302
		else if(vMktCd == '302' ) fn_show302();
		//중도상환 303,304
		else if(vMktCd == '303'  || vMktCd == '304') fn_show303304();
		//국고채추가발행 305
		else if(vMktCd == '305' ) fn_show305();
		//권리행사가액 변경 306
		else if(vMktCd == '306' ) fn_show306();
		//발행가액 변경 307
		else if(vMktCd == '307' ) fn_show307();
		//표면이자율,FRN 변동금리 변경 308, 309
		else if(vMktCd == '308' || vMktCd == '309') fn_show308309();
		//옵션상환일 변경 311
		else if(vMktCd == '311') fn_show311();
		//수동상장폐지 314
		else if(vMktCd == '314') fn_show314();
		//기타변경 316
		else if(vMktCd == '316') fn_show316();
		//BW(일반사채)권리행사 315
		else if(vMktCd == '315') fn_show315();
		//분할상환정보 JACKAL_190220
		else if(vMktCd == '500') fn_show500();
		//자동상장폐지(상환일만기) 900
		else if(vMktCd == '900') fn_show900();
		//신용평가등급수신 321
		else if(vMktCd == '321') fn_show321();
		//스트립신규 401
		else if(vMktCd == '401') fn_show401();
		//스트립추가재결합 402
		else if(vMktCd == '402') fn_show402();
		//추가상장 및 스트립신규 403
		else if(vMktCd == '403') fn_show403();
		//추가상장 및 스트립추가 / 재결합, 스트립통합 404,405
		else if(vMktCd == '404' || vMktCd == '405') fn_show404405();
		//WIT지정
		else if(vMktCd == '113' ) fn_show113();
		//WIT종목정보확정
		else if(vMktCd == '330' ) fn_show330();
		//default
		else {
			//국채,지방채,특수채,회사채,외국채권 신규상장
			fn_showDefault();
		}

		grd_IsuList.Redraw = true;
	}
	/********************************************** 
	* 함수명   : fn_GetQryId
	* 설명       : 종목정보 조회 쿼리id를 리턴한다.
	***********************************************/
	function fn_GetQryId() {
		//상호변경
		if(vMktCd == '201') 										return 'lds.stf.bnscls.select.listClsIsuInfo'+'201';
		//합병(영업양수도) 및 분할
		else if(vMktCd == '202')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'202';
		//종목분할
		else if(vMktCd == '203')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'203';
		//변경상장종목분할
		else if(vMktCd == '105')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'105';
		//BW 신주인수권행사
		else if(vMktCd == '205')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'205';
		//BW 분리종목
		else if(vMktCd == '104')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'104';
		//일괄상장채권 상장금액조정(월별) 301
		else if(vMktCd == '301')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'301';
		//일괄상장채권 상장금액조정(일별) 320
		else if(vMktCd == '320')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'320';
		//주식관련사채 권리행사 302
		else if(vMktCd == '302' )								return 'lds.stf.bnscls.select.listClsIsuInfo'+'302';
		//중도상환 303,304
		else if(vMktCd == '303')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'303';
		else if(vMktCd == '304')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'304';
		//국고채추가발행 305
		else if(vMktCd == '305' )								return 'lds.stf.bnscls.select.listClsIsuInfo'+'305';
		//권리행사가액 변경 306
		else if(vMktCd == '306' ) 							return 'lds.stf.bnscls.select.listClsIsuInfo'+'306';
		//발행가액 변경 307
		else if(vMktCd == '307' ) 							return 'lds.stf.bnscls.select.listClsIsuInfo'+'307';
		//표면이자율
		else if(vMktCd == '308') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'308';
		//FRN 변동금리 변경 
		else if(vMktCd == '309') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'309';
		//옵션상환일 변경 311
		else if(vMktCd == '311') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'311';
		//수동상장폐지 314
		else if(vMktCd == '314') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'314';
		//기타변경 316
		else if(vMktCd == '316') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'316';
		//BW(일반사채)권리행사 315
		else if(vMktCd == '315') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'315';
		//분할상환정보 대상500 JACKAL_190220
		else if(vMktCd == '500') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'500';
		//자동상장폐지(상환일만기) 900
		else if(vMktCd == '900') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'900';
		//신용평가등급수신 321
		else if(vMktCd == '321') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'321';
		//스트립신규 401
		else if(vMktCd == '401') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'401';
		//스트립추가재결합 402
		else if(vMktCd == '402')								return 'lds.stf.bnscls.select.listClsIsuInfo'+'402';
		//추가상장 및 스트립신규 403
		else if(vMktCd == '403') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'403';
		//추가상장 및 스트립추가 / 재결합 404
		else if(vMktCd == '404') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'404';
		//스트립통합 405
		else if(vMktCd == '405') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'405';
		//WIT 종목지정 113
		else if(vMktCd == '113') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'113';
		//WIT종목정보확정 330
		else if(vMktCd == '330') 								return 'lds.stf.bnscls.select.listClsIsuInfo'+'330';
		//default, 국채,지방채,특수채,회사채,외국채권 신규상장
		else															return 'lds.stf.bnscls.select.listClsIsuInfo'+'111121131141151';
	}
	
	/********************************************** 
	* 함수명   : fn_GetQryIdEnd
	* 설명       : 종목정보 조회 쿼리id를 리턴한다.
	***********************************************/
	function fn_GetQryIdEnd() {
		//분할상환 전송500 JACKAL_190220
		if	   (vMktCd == '500')  			return 'lds.stf.bnscls.select.listClsEndIsuInfo'+'500';
		//자동상장폐지(상환일만기) 900
		else if(vMktCd == '900')  			return 'lds.stf.bnscls.select.listClsEndIsuInfo'+'900';
		//수동상장폐지 314
		else if(vMktCd == '314')		return 'lds.stf.bnscls.select.listClsEndIsuInfo'+'314';
		//수동상장폐지 314
		else if(vMktCd == '111' || vMktCd == '121' || vMktCd == '131' || vMktCd == '141' || vMktCd == '151' || vMktCd == '104' || vMktCd == '105' 
				|| vMktCd == '113' // WIT종목지정 추가
				)		
			return 'lds.stf.bnscls.select.listClsEndIsuInfo'+'111121131141151104105';
		else return 'lds.stf.bnscls.select.listClsEndIsuInfoDefault';
	}


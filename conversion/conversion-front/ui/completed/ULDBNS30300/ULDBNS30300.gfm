	* 설명       : 종목헤더를 초기화한다.
	***********************************************/
	function fn_showDefault() {
			grd_IsuList.ColumnProp("BND_APPL_ID"	, "Show") = true;
			grd_IsuList.ColumnProp("STD_CD"      	    , "Show") = true;
			grd_IsuList.ColumnProp("ISU_NM"   		, "Show") = true;
			grd_IsuList.ColumnProp("ISU_AMT"          , "Show") = true;
			grd_IsuList.ColumnProp("ISU_DD"        	,"Show") = true;
			grd_IsuList.ColumnProp("LIST_DD"        , "Show") = true;	
			grd_IsuList.ColumnProp("REDMPT_DD"    , "Show") = true;
	}	
	
	function fn_showFalse() {		
		grd_IsuList.ColumnProp("SPRT_PAR_AMT"  		, "Name") = '신청 액면금액';
		grd_IsuList.ColumnProp("ISUR_NM"   					, "Name") = '발행기관명';
		grd_IsuList.ColumnProp("RECOMBIN_PAR_AMT" 	, "Name") = '재결합신청금액';
		//grd_IsuList.ColumnProp("BF_EXER_PRC" 			, "Name") = '변경전행사가액(원)';
		//grd_IsuList.ColumnProp("AF_EXER_PRC" 			, "Name") = '변경후행사가액(원)';

		grd_IsuList.ColumnProp("BND_APPL_ID"	    , "Show") = false;
		grd_IsuList.ColumnProp("STD_CD"      	    , "Show") = false;
		grd_IsuList.ColumnProp("ISU_NM"   		    , "Show") = false;
		grd_IsuList.ColumnProp("REDMPT_DD"          , "Show") = false;
		grd_IsuList.ColumnProp("ISU_AMT"            , "Show") = false;
		grd_IsuList.ColumnProp("ISU_DD"        	    , "Show") = false;
		grd_IsuList.ColumnProp("LIST_DD"           , "Show") = false;
		grd_IsuList.ColumnProp("ISUR_NM"   		    , "Show") = false;
		grd_IsuList.ColumnProp("BF_ISU_NM"   	    , "Show") = false;
		grd_IsuList.ColumnProp("AF_ISU_NM"   	    , "Show") = false;
		grd_IsuList.ColumnProp("TP_NM"   		    , "Show") = false;
		grd_IsuList.ColumnProp("BF_LIST_AMT"        , "Show") = false;
		grd_IsuList.ColumnProp("AF_LIST_AMT"        , "Show") = false;
		grd_IsuList.ColumnProp("EXER_AMT"   	    , "Show") = false;
		grd_IsuList.ColumnProp("BW_ISU_NM"   	    , "Show") = false;
		grd_IsuList.ColumnProp("GE_ISU_NM"   	    , "Show") = false;
		grd_IsuList.ColumnProp("BW_LIST_AMT"        , "Show") = false;
		grd_IsuList.ColumnProp("GE_LIST_AMT"        , "Show") = false;
		grd_IsuList.ColumnProp("REDMPT_AMT"    	    , "Show") = false;
		grd_IsuList.ColumnProp("ADD_LIST_AMT"       , "Show") = false;
		grd_IsuList.ColumnProp("BF_EXER_PRC"        , "Show") = false;
		grd_IsuList.ColumnProp("AF_EXER_PRC"        , "Show") = false;
		grd_IsuList.ColumnProp("BF_ISUR_PRC"        , "Show") = false;
		grd_IsuList.ColumnProp("AF_ISUR_PRC"        , "Show") = false;
		grd_IsuList.ColumnProp("CHG_RSN_CONTN"      , "Show") = false;
		grd_IsuList.ColumnProp("BF_COUPN_RT"        , "Show") = false;
		grd_IsuList.ColumnProp("AF_COUPN_RT"        , "Show") = false;
		grd_IsuList.ColumnProp("BF_REDMPT_DD"       , "Show") = false;
		grd_IsuList.ColumnProp("AF_REDMPT_DD"       , "Show") = false;
		grd_IsuList.ColumnProp("BF_FST_DD"    	    , "Show") = false;
		grd_IsuList.ColumnProp("AF_FST_DD"    	    , "Show") = false;
		grd_IsuList.ColumnProp("DELIST_RSN_CONTN"   , "Show") = false;
		grd_IsuList.ColumnProp("DELIST_DD"   		, "Show") = false;
		grd_IsuList.ColumnProp("SPRT_PAR_AMT"   	, "Show") = false;
		grd_IsuList.ColumnProp("BF_STRIP_NSPRT_BAL" , "Show") = false;
		grd_IsuList.ColumnProp("AF_STRIP_NSPRT_BAL" , "Show") = false;
		grd_IsuList.ColumnProp("RECOMBIN_PAR_AMT" 	, "Show") = false;
		grd_IsuList.ColumnProp("BF_CREDIT"   		, "Show") = false;
		grd_IsuList.ColumnProp("AF_CREDIT"   		, "Show") = false;			
		grd_IsuList.ColumnProp("CHG_LIST_DTL"   	, "Show") = false;			
		grd_IsuList.ColumnProp("ISUR_NM"   			, "Show") = false;			
		grd_IsuList.ColumnProp("STRT_DD_WIT"   		, "Show") = false;			
		
		// 분할상환일 추가항목 JACKAL_190220
		grd_IsuList.ColumnProp("SPLIT_REDMPT_DD"  	, "Show") = false;
		grd_IsuList.ColumnProp("CHG_SPLIT_REDMPT_DD", "Show") = false;
		grd_IsuList.ColumnProp("BK_HOLDY_PRINC_PAY_DD_DECSN_NM", "Show") = false;
		grd_IsuList.ColumnProp("INDEX_NM"			, "Show") = false;
	}
	
	/********************************************** 
	* 함수명   : fn_SearchMktact
	* 설명       : 시장조치내역 조회한다.
	***********************************************/
	var vStdCd;
	function fn_SearchMktact() {
		var param = '';
		param += "&{P}V_STD_CD="+ vStdCd;
		param += "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
		param += "&{P}V_APPL_YN=N";
		//param += "&{P}V_STD_CD=KR6015861S58";

		var dsNm = 'BNS_MKTACT_DTL';
		var qryId = 'lds.stf.bnscommon.select.listMktactDtlMulty';
		fn_SearchBns(vScrenID, dts_List, dsNm, qryId, param);		
	}		

	/********************************************** 
	* 함수명   : fn_SearchMktact1
	* 설명       : 시장조치내역 조회한다.
	***********************************************/
	var vClsApplyYn;
	function fn_SearchMktact1() {
		var param = '';
		param += "&{P}V_STD_CD="+ vStdCd;
		param += "&{P}V_STRT_DD="+ dts_CheckCls.NameValue(1, 'END_CLS_DD');
		//param += "&{P}V_STD_CD=KR6015861S58";

		var dsNm = 'BNS_MKTACT_DTL';
		var qryId = 'lds.stf.bnscommon.select.listMktactDtlMulty';
		if(vClsApplyYn == 'Y') {
			param += "&{P}V_APPL_YN=Y";
		}else {
			param += "&{P}V_APPL_YN=N";
		}
		fn_SearchBns(vScrenID, dts_List1, dsNm, qryId, param);		
	}		
]]></script>

<events><event for="gform" eventname="onload"><![CDATA[
	//숨기기
	if(js_usr_tp_cd == '1') { //운영자이면
		showObj(btn_ReClsProcs, true);		
	}else {
		showObj(btn_ReClsProcs, false);	
	}
	
	//탭선택
	tab_List.ActiveIndex = 1;	
	tab_ListCls.ActiveIndex = 1;	
	tab_ListCls1.ActiveIndex = 1;	
	
	//패널라운드처리
	BnsPanelToGroupBox(pnl_Item);
	BnsPanelToGroupBox(pnl_Item2);
	BnsPanelToGroupBox(pnl_Cls);		
	BnsPanelToGroupBox(pnl_ClsDtl);		
	BnsPanelToGroupBox(pnl_SendDtl);		
	BnsPanelToGroupBox(pnl_ClsDtl1);		
	BnsPanelToGroupBox(pnl_SendDtl1);		
	
	//종목정보 컬럼 초기화
	fn_IntiIsuCol();
	
	//마감조회
	processGp = '1';
	fn_SearchClsDd('');
	
	//임시데이터셋설정
	dts_Temp.SetDataHeader('TEMP:String');
	dts_Temp.AddRow();
]]></event>
<event for="btn_Search" eventname="onclick"><![CDATA[
	if(getObjectValue(edt_BizClsDd) == '') {
		alert('업무마감일을 입력 하십시오.'); return;
	}	
	processGp = '2';
	fn_SearchClsDd(getObjectValue(edt_BizClsDd));
]]></event>
<event for="dts_MktList" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	vRowCount = rowcount;
	CloseWin(rowcount, grd_MktList);
	
	if(rowcount == 0) {
		dts_MktList.ClearData();
		dts_IsuList.ClearData();
		grd_MktList.ColumnProp('BND_MKTACT_TP_NM','Name') = "총 0 건";
		if(processGp == '2') {
			grd_MktList1.ColumnProp('BND_MKTACT_TP_NM','Name') = "총 0 건";
		}
	}else {
		//최종호가,CD최종호가 조회
		//fn_SearchLastOrdYd();		
		//헤더설정
		if(processGp == '1') {
			grd_MktList.ColumnProp('BND_MKTACT_TP_NM','Name') = "마감전 : 총 "+ dts_MktList.NameValue(1, "TOT_MKTACT_CNT") +"건";			
		}else {
			grd_MktList1.ColumnProp('BND_MKTACT_TP_NM','Name') = "총 "+ dts_MktList.NameValue(1, "TOT_MKTACT_CNT") +"건";					
		}
	}
	//종목전송정보조회
	if(processGp == '2') {
		fn_SearchSendIsuInfo();
	}		
]]></event>
<event for="dts_ClsSendInfo" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	CloseWin(rowcount, grd_ClsSendInfo);
]]></event>
<event for="dts_MktList" eventname="OnLoadError()"><![CDATA[
	alert(getMessageParam("MSG-0002"));
	alert_error(dts_MktList);
]]></event>
<event for="dts_MktList" eventname="OnRowPosChanged(row)"><![CDATA[
	dts_IsuList.ClearData();
	if(row == 0) return;

	vMktCd = dts_MktList.NameValue(row, 'BND_MKTACT_TP_CD');
	var cnt = dts_MktList.NameValue(row, "MKTACT_CNT");
	
	//종목헤더설정
	if(processGp == '1') {
		fn_IntiIsuCol();
	}		
	
	//종목조회
	if(cnt > 0) {
		fn_SearchClsDtl();
	}
]]></event>
<event for="trs_Save" eventname="OnFail()"><![CDATA[
	alert(getMessageParam("MSG-0002"));
	alert_error(trs_Save);
]]></event>
<event for="trs_Save" eventname="OnSuccess()"><![CDATA[
	alert(getMessageParam("MSG-0001"));	
	processGp = '1';
	fn_SearchClsDd('');
]]></event>
<event for="dts_CheckCls" eventname="OnLoadCompleted(rowcount)"><![CDATA[	
	if(getObjectValue(edt_BizClsDd) == '') {
		setObjectValue(edt_BizClsDd, dts_CheckCls.NameValue(1, 'PRSNT_DD'));
	}
	
	if(processGp == '1') {
		setObjectValue(edt_PrsntDd, dts_CheckCls.NameValue(1, 'PRSNT_DD'));
		setObjectValue(edt_StrtDd, dts_CheckCls.NameValue(1, 'CLS_DD'));
		vStrtDd = getObjectValue(edt_StrtDd);
		fn_SearchSendData();
		
		var param = '';
		param+= "&{P}V_STRT_DD="+ getObjectValue(edt_StrtDd);
		var dsNm = 'BNS_CHECK_CLS_PROC';
		var qryId = 'lds.stf.bnscls.select.readChkClsProc';
		dts_CheckClsProc.SyncLoad = "true";
		fn_SearchBns(vScrenID, dts_CheckClsProc, dsNm, qryId, param);	
		if(dts_CheckClsProc.NameValue(1, 'VALID_BND_CLS') == 'Y') {
			setObjectValue(txb_ClsDtl, '* 마감처리 완료');
		}else if(dts_CheckClsProc.NameValue(1, 'VALID_SEND_CFM') == 'Y') {
			setObjectValue(txb_ClsDtl, '* "상장마감"이 완료되지 않았습니다. 상장마감 시 "시장조치내역생성" 후 "상장마감" 하시기 바랍니다.');
			tab_ListCls.ActiveIndex = 2;
		}else {
			setObjectValue(txb_ClsDtl, '* "상장마감"이 완료되지 않았습니다. 상장마감 시 "시장조치내역생성" 후 "상장마감" 하시기 바랍니다.');
		}
		
		fn_SearchCls();
	}else if(processGp == '2') {
		if(dts_CheckCls.NameValue(1, "VALID_BIZ_CLS_DD") == "Y") {
			alert("업무마감일이 아닙니다."); 
			dts_MktList.ClearData();
			dts_SendInfo1.ClearData();
			dts_List1.ClearData();
			dts_ClsSendInfo.ClearData();
			dts_IsuList.ClearData();			
			grd_MktList1.ColumnProp('BND_MKTACT_TP_NM','Name') = "총 0 건";
			return;
		}	
		fn_SearchClsEnd();
		fn_SearchSendData1();
	}
]]></event>
<event for="img_BizClsDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_BizClsDd);
]]></event>
<event for="btn_ClsProcs" eventname="onclick"><![CDATA[
	if(js_jobtitl == '03' && (js_duty == 'N' && js_duty_chrg == 'N')) {
		alert('팀장권한만 가능합니다.');
		return;
	}
	processGp = '4';
	fn_ClsProcs();
]]></event>

<event for="dts_SendInfo" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	setObjectValue(txb_TotalCnt, '총 '+ rowcount +'건')
	CloseWin(rowcount, grd_SendList);
]]></event>
<event for="dts_SendInfo1" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	setObjectValue(txb_TotalCnt1, '총 '+ rowcount +'건')
]]></event>

<event for="dts_IsuList" eventname="OnLoadError()"><![CDATA[
	alert(getMessageParam("MSG-0002"));
	alert_error(dts_IsuList);
]]></event>
<event for="dts_IsuList" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	CloseWin(rowcount, grd_IsuList);
]]></event>
<event for="tab_List" eventname="OnSelChanged(nIndex)"><![CDATA[
	dts_MktList.ClearData();
	dts_IsuList.ClearData();
	processGp = nIndex;
	if(processGp == '1') {
		fn_SearchClsDd('');
	}
]]></event>
<event for="btn_MktFileConfrm" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParMktFile;
	fn_PopMktFile(grd_IsuList1);
]]></event>
<event for="grd_IsuList1" eventname="OnDblClick(row, colid)"><![CDATA[
	if(dts_IsuList.CountRow == 0) return;
	//if(colid != 'STD_CD')  return;
	
	fn_GetPar = fn_GetParIsuDtlAndMktactDtl;
	fn_PopIsuDtlAndMktactDtl(grd_MktList1);	
]]></event>
<event for="btn_ReClsProcs" eventname="onclick"><![CDATA[
	fn_ReClsProcs();
]]></event>
<event for="dts_List" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	vRowCount = rowcount;
	CloseWin(rowcount, grd_List);
]]></event>
<event for="btn_Excel" eventname="onclick"><![CDATA[
	var fileNm = getObjectValue(edt_StrtDd) + '_' + '시장조치내역';
	//grd_SendList.GridToExcel('', fileNm, '29');
	grd_SendList.GridToExcel('', fileNm, '8');
]]></event>
<event for="btn_Excel1" eventname="onclick"><![CDATA[
	var fileNm = dts_CheckCls.NameValue(1, 'END_CLS_DD') + '_' + '시장조치내역';
	//grd_SendList1.GridToExcel('', fileNm, '29');
	grd_SendList1.GridToExcel('', fileNm, '8');
]]></event>
<event for="grd_SendList" eventname="OnClick(row, colid)"><![CDATA[
	if(row == 0) return;
	dts_List.ClearData();
	//if(dts_SendInfo.NameValue(row, 'MULTY_YN') != 'Y') return;
	
	vStdCd = dts_SendInfo.NameValue(row, 'STD_CD');
	fn_SearchMktact();
]]></event>
<event for="grd_SendList1" eventname="OnClick(row, colid)"><![CDATA[
	if(row == 0) return;
	dts_List1.ClearData();
	//if(dts_SendInfo1.NameValue(row, 'MULTY_YN') != 'Y') return;
	
	vStdCd = dts_SendInfo1.NameValue(row, 'STD_CD');
	vClsApplyYn = dts_SendInfo1.NameValue(row, 'CLS_APPLY_YN');
	fn_SearchMktact1();
]]></event>
<event for="btn_SendCfm" eventname="onclick"><![CDATA[
	processGp = '3';
	fn_SendCfm();
]]></event>
<event for="grd_MktList" eventname="OnClick(row, colid)"><![CDATA[
	if(row == 0) return;
	if(tab_ListCls.ActiveIndex == 2) {
		tab_ListCls.ActiveIndex = 1;
	}
]]></event>
<event for="grd_MktList1" eventname="OnClick(row, colid)"><![CDATA[
	if(row == 0) return;
	if(tab_ListCls1.ActiveIndex == 2) {
		tab_ListCls1.ActiveIndex = 1;
	}
]]></event></events>
</gform>

		<image id="btn_Save" left="390" top="616" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="445" top="616" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="500" top="616" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="555" top="616" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>

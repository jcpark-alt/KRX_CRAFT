<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="710" height="650" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts_Mst">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="MKTACT_ENFORCE_DD" ctrl="edt_MktactEnforceChgDd" param="text" readonly="False"></column>
				<column col="ADMISU_RSN_CONTN" ctrl="txa_ChgRsnContn" param="text" readonly="False"></column>
				<column col="GRND_REGUL_NM" ctrl="txb_ChgAdmisuDesignGrndRegulNm" param="value" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_Rsn_Af">
			<property usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Status">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_BZ_CHECK">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Mst_Bf">
			<property usechangeinfo="False"></property>
		</mxdataset>
		<mxbinder id="bnd_Mst_Bf">
			<property activebind="true"></property>
			<bindinfo>
				<column col="MKTACT_ENFORCE_DD" ctrl="edt_MktactEnforceDd" param="text" readonly="False"></column>
				<column col="GRND_REGUL_NM" ctrl="txb_AdmisuDesignGrndRegulNm" param="value" readonly="False"></column>
				<column col="REMK" ctrl="txa_Remk" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst_Bf"></ref>
		</mxbinder>
	</model>
	<components>
		<panel id="panel_3" left="10" top="10" width="690" height="360" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="20" top="10" width="130" height="20" text="1. 관리종목지정 종목">
				<extproperty font-size="12"></extproperty>
			</label>
			<label id="label_11" class="TopCondition_01" left="10" top="175" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_5" class="TopCondition_01" left="20" top="175" width="130" height="20" text="3. 지정사유">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="150" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="20" top="150" width="130" height="20" text="2. 관리종목지정일">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_6" class="TopCondition_01" left="20" top="265" width="130" height="20" text="4. 근거규정">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_12" class="TopCondition_01" left="10" top="265" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<mxmaskedit id="edt_MktactEnforceDd" class="panel_maskedit_write_01" left="155" top="150" width="70" height="18">
				<property alignment="1" border="False" datemodify="True" numeric="False" readonly="True" readonlybackcolor="#b9d4f7" valign="1"></property>
				<extproperty font-size="12" background-color="#b9d4f7" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<textbox id="txb_AdmisuDesignGrndRegulNm" class="TopCondition_01_write" left="155" top="265" width="445" height="20" readonly="readonly" maxlength="1000">
				<extproperty font-size="12" background-color="#b9d4f7" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</textbox>
			<label id="label_7" class="TopCondition_01" left="20" top="290" width="130" height="20" text="5. 기타">
				<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="155" top="290" width="443" height="60">
				<property enable="True" readonly="True"></property>
				<extproperty font-size="12" background-color="#b9d4f7" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxtextarea>
			<mxgrid id="MxGrid_1" class="Grid_01" left="155" top="175" width="443" height="83">
				<property borderstyle="0" editable="True" emptyareacolor="#b9d4f7" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" rowheight="18" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="97" show="False" name="업무처리번호" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_CD" width="70" name="사유코드" align="center" edit="none" listalign="left" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_NM" width="356" name="사유내용" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" color="#343434"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Rsn"></ref>
			</mxgrid>
			<mxgrid id="grid_1" class="Grid_01" left="155" top="10" width="525" height="132">
				<property borderstyle="0" editable="True" emptyareacolor="#b9d4f7" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="120" show="False" name="BZ_PROCS_NO" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_CD" width="100" name="종목코드" align="center" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column headbgcolor="#598fd5" headcolor="#FFFFFF" name="발행회사" width="100" id="ISUR_NM" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_NM" width="240" name="종목명" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="LIST_DD" width="80" name="상장일" mask="XXXX-XX-XX"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Isu"></ref>
			</mxgrid>
		</panel>
		<panel id="panel_2" class="TopCondition_01" left="10" top="375" width="690" height="235">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_9" class="TopCondition_01" left="20" top="10" width="130" height="20" text="1. 관리종목지정사유 변경일">
				<extproperty font-size="10" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_17" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<image id="img_MktactEnforceDd" left="230" top="10" width="21" height="20" src="../img/icn_calendar.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_MktactEnforceChgDd" class="panel_maskedit_write_01" left="155" top="10" width="70" height="18">
				<property alignment="1" border="False" datemodify="True" numeric="False" valign="1"></property>
				<extproperty font-size="12" color="#343434" background-color="#FFFFFF" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<label id="label_16" class="TopCondition_01" left="20" top="125" width="130" height="20" text="3. 변경사유">
				<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<mxtextarea id="txa_ChgRsnContn" class="TextArea_01" left="155" top="125" width="513" height="78">
				<extproperty font-size="12" color="#343434" background-color="#FFFFFF" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxtextarea>
			<label id="lbl_1" class="TopCondition_01" left="20" top="210" width="130" height="20" text="4. 근거규정">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ChgAdmisuDesignGrndRegulNm" class="TopCondition_01_write" left="155" top="210" width="445" height="20" value="유가증권시장상장규정 제149조의6제1항" maxlength="1000">
				<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<label id="lbl_2" class="TopCondition_01" left="10" top="125" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="lbl_3" class="TopCondition_01" left="10" top="35" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="lbl_4" class="TopCondition_01" left="20" top="35" width="130" height="20" text="2. 지정사유 변경">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<image id="btn_rsn_del" left="605" top="65" width="76" height="22" src="../img/btn_rsn_del.gif">
				<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
			</image>
			<image id="btn_rsn_add" left="605" top="35" width="76" height="22" src="../img/btn_rsn_add.gif">
				<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
			</image>
			<mxgrid id="grid_2" class="Grid_01" left="155" top="35" width="443" height="83">
				<property borderstyle="0" editable="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" rowheight="18" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="97" show="False" name="업무처리번호" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_CD" width="70" name="사유코드" align="center" edit="none" listalign="left" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_NM" width="356" name="사유내용" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" color="#343434"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>

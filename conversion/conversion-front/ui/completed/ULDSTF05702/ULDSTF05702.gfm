<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="785" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
			@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_List">
			<property syncload="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs_Save"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Mst">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_BZ_CHECK">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="CHG_DD" ctrl="edt_CHG_DD" param="text" readonly="False"></column>
				<column col="CHG_RSN_CONTN" ctrl="txb_CHG_RSN_CONTN" param="value" readonly="False"></column>
				<column col="BFCHG_EXER_PRC" ctrl="edt_BFCHG_EXER_PRC" param="text" readonly="False"></column>
				<column col="AFCHG_EXER_PRC" ctrl="edt_AFCHG_EXER_PRC" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
	</mxbinder>
	</model>
    <components>
		<panel id="panel_Top" class="TopCondition_01" left="5" top="5" width="1253" height="40">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_2_top" class="TopCondition_01" left="20" top="10" width="80" height="20" text="종목코드(명)">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ISU_CD" class="TopCondition_01_write" left="104" top="10" width="90" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<image id="btn_Search" left="1195" top="7" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_tmp_11" left="1187" top="4" width="2" height="30" src="../img/img_line2.gif"></image>
			<image id="img_ISU_NM" left="475" top="10" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<textbox id="txb_ISU_NM" class="TopCondition_01_write" left="198" top="10" width="272" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
		</panel>
		<panel id="panel_page" left="5" top="692" width="335" height="20">
			<extproperty></extproperty>
	</panel>
		<image id="btn_close" left="1211" top="691" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Save" left="1050" top="691" width="50" height="22" src="../img/btn_save.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="1104" top="691" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="1158" top="691" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<panel id="panel_Item" left="6" top="53" width="1253" height="129" class="TopCondition_01">
			<extproperty border-style="none" border-width="4" background-color="#d9e9fc"></extproperty>
			<label id="label_7" class="TopCondition_01" left="2" top="147" width="119" height="20" text="행사가격 조정내역">
			<extproperty font-weight="bold" font-size="12" color="#333399" background-color="#FFFFFF" border-color="#000000"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="10" top="13" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="21" top="13" width="80" height="20" text="변경상장일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<mxmaskedit id="edt_CHG_DD" class="panel_maskedit_write_01" left="144" top="12" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_CHD_DD" left="213" top="13" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_5" class="TopCondition_01" left="21" top="38" width="80" height="20" text="변경사유">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="38" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<textbox id="txb_CHG_RSN_CONTN" class="TopCondition_01_write" left="144" top="38" width="420" height="20" maxlength="1000">
			<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<label id="label_3" class="TopCondition_01" left="21" top="64" width="119" height="20" text="변경전 행사가격(원)">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<mxmaskedit id="edt_BFCHG_EXER_PRC" class="panel_maskedit_write_02" left="145" top="63" width="120" height="20">
			<property alignment="2" datemodify="True" generaledit="False" numeric="True" readonly="True" readonlybackcolor="#b9d4f7" showliteral="false" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_6" class="TopCondition_01" left="10" top="90" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<mxmaskedit id="edt_AFCHG_EXER_PRC" class="panel_maskedit_write_02" left="145" top="91" width="120" height="20">
			<property alignment="2" datemodify="True" generaledit="False" numeric="True" readonly="False" readonlybackcolor="#b9d4f7" showliteral="false" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_4" class="TopCondition_01" left="21" top="91" width="119" height="20" text="변경후 행사가격(원)">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
		</panel>
		<mxgrid id="grd_List" class="Grid_01" left="7" top="226" width="1253" height="448">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" titleheight="40" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="RNUM" width="50" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<column id="ISU_CD" width="110" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="종목코드" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_NM" width="200" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="종목명" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="CHG_DD" width="80" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경상장일" align="center" mask="XXXX-XX-XX" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="CHG_RSN_CONTN" width="330" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경사유" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="BFCHG_EXER_PRC" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경전\\행사가격(원)" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" decao="17"></column>
				<column id="AFCHG_EXER_PRC" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경후\\행사가격(원)" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" decao="17"></column>
				<column id="EMP_NM" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="최종처리자" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="BZ_PROCS_NO" width="130" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="업무처리번호" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
			</format>
			<ref dataid="dts_List"></ref>
		</mxgrid>
		<image id="btn_New" left="996" top="691" width="50" height="22" src="../img/btn_new.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/PopupCalendar.js");
	#include("../js/stf.js");
	#include("../js/utils.js");
	#include("../js/list_common.js");
	#include("../js/buttonSet.js");
	#include("../js/session.js");  			// 세션정보를 얻기위한 함수사용
	
	var vScrenID = "ULDSTF05702.gfm";
    var vScrenTpCD = "";
	var vBzProcsNo = "";
	var vIsurCd = "";
	var trsIdx ;  // insert, update 구분
	var rowPos;
	var vISU_ENG_NM = "";

	var fr_SecuGrpId = fn_getSecuGrpId(InfoMenuID());
	var vSPOT_ISU_TRD_MKT_TP_CD;
	var listCount = "";
	
	function fn_GetParIsuCd(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = ""; 	// 코드값을 포함할 컨트롤
		//arrPar[1] = getObjectValue(txb_SearchNm);	// 명칭값을 포함할 컨트롤
		arrPar[1] = "";	// 명칭값을 포함할 컨트롤
		arrPar[2] = fr_SecuGrpId;
		return arrPar, length;
	} 

	/*
	 * 종목코드 선택시 
	 */
	function fn_SetParIsuCd(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			txb_ISU_CD.value = arrPar[0].ISU_CD;
			txb_ISU_NM.value = arrPar[0].ISU_KOR_NM;

			vSPOT_ISU_TRD_MKT_TP_CD = arrPar[0].SPOT_ISU_TRD_MKT_TP_CD;
			vIsurCd = arrPar[0].ISUR_CD;
			
			fn_initItem() ;
			fn_list_sync(); //행사가격 조정내역
			fn_bfprc();       //변경전 행사가격
		
		}	
	}

	function fn_initItem() {
		buttonSet.setInsertStatus();
		dts_Isu.ClearData();
		dts_Isu.AddRow();
		
		dts_Mst.ClearData();
		dts_Mst.AddRow();
		vBzProcsNo = ""; //초기화 
	}
	
	//종목코드 선택시 변경전 행사가격을 가져온다.
    function fn_bfprc(){	
		var url ="/Listing.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchSWPrclist&inputMessageId=CHGLIST_PRC_INOUT&ISU_CD=" + getObjectValue(txb_ISU_CD); 
		dts_Mst.DataID =encodeURI(url);
		dts_Mst.reset();	
		
	}
	
	 //종목코드선택시 행사가격 조정 내역 조회
	function fn_list_sync() {
		var url = "/Listing.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchChgList&DIV_IDX=10&ISU_CD=" + getObjectValue(txb_ISU_CD); 
		dts_List.DataID =encodeURI(url);
		dts_List.reset();		
		
	}

	function fn_getListBzTpCd() {
		var VListBzTpCd =""; 

		if	(fr_SecuGrpId == SECUGRP_ID_SW) { //SW : 신주인수권증권
			VListBzTpCd = LIST_BZ_TP_CD_150;   //상장업무구분코드 : 150 - 신주인수권증권 행사가격
		}
		return VListBzTpCd;
		
	}

		//그리드  더블 클릭시 조회
	function fn_read_sync(row) {
		vBzProcsNo = dts_List.NameString(row, "BZ_PROCS_NO");
		var url =  "/Listing.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchChgList&DIV_IDX=12&BZ_PROCS_NO=" + vBzProcsNo; 
		dts_Mst.DataID =encodeURI(url);
		dts_Mst.reset();	
		
	}
	
	
	function fn_CheckForm() {
		var vCurDate = cGetToday("yyyymmdd");
		
		if (getObjectValue(txb_ISU_CD) == "") {
			alert("[종목코드]를 선택하세요.");txb_ISU_CD.focus();return false;
		}
	    if (getObjectValue(edt_CHG_DD) == "") {
			alert("[변경상장일]을 입력하세요.");edt_CHG_DD.focus();return false;
		}
		if (cGetToday("yyyymmdd") >= getObjectValue(edt_CHG_DD)) {
			alert("[변경상장일]을 현재일이후로 입력하세요.");edt_CHG_DD.focus();return false;
		}
		
		if (getObjectValue(txb_CHG_RSN_CONTN) == "") {
			alert("[변경사유]을 입력하세요.");txb_CHG_RSN_CONTN.focus();return false;
		} 

		if ( !checkMaxLength( txb_CHG_RSN_CONTN , 1000 , "변경사유" ) ) return false ;

		if (getObjectValue(edt_AFCHG_EXER_PRC) == "") {
			alert("[변경후 행사가격(원)]을 입력하세요.");edt_AFCHG_EXER_PRC.focus();return false;
		} 

		if (! fn_check_bz_doubleinput(	dts_BZ_CHECK, 
														getObjectValue(txb_ISU_CD),
														getObjectValue(edt_CHG_DD),
														dts_Mst.NameString(1, "BZ_PROCS_NO"),
														fn_getListBzTpCd() 
														)) {
			return false;
		}
		
		return true;
	}


	//저장
    function fn_save() {
		trsIdx = TRS_IDX_INSERT ;
		
		if (! fn_CheckForm()) return;
		if (! fn_isProcess('I') )  return ;
		
		vBzProcsNo = fn_getNewBzProcNo( dts_BzProcsNo );

		if (vBzProcsNo.length != 14) {
			alert(getMessageParam("MSG-0010", ""));
		} else {

			dts_Mst.NameString(1, "BZ_PROCS_NO") = vBzProcsNo;
			//alert('[dts_Mst]'+dts_Mst.text);
			fn_trs();
		}
	}

	function fn_update() {
		trsIdx = TRS_IDX_UPDATE ;
		if (! fn_CheckForm() ) return;
		if (! fn_isProcess('U') )  return ;
		fn_trs();
	}	
	
	function fn_delete() {
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_trs();
	}

	function fn_trs() {
		if(trsIdx=='1'){
			vScrenTpCD = SCREN_PROCS_TP_CD_02;
		}else if(trsIdx=='2'){
			vScrenTpCD = SCREN_PROCS_TP_CD_03;
		}else if(trsIdx=='3'){
			vScrenTpCD = SCREN_PROCS_TP_CD_04;
		}
	
		dts_Mst.NameString(1, "ISUR_CD") = vIsurCd;
		dts_Mst.NameString(1, "BZ_PROCS_NO") = vBzProcsNo;
		dts_Mst.NameString(1, "ISU_CD") = getObjectValue(txb_ISU_CD) ;
		dts_Mst.NameString(1, "BFCHG_EXER_PRC") = edt_BFCHG_EXER_PRC.text;
		dts_Mst.NameString(1, "AFCHG_EXER_PRC") = edt_AFCHG_EXER_PRC.text ;
		
		trs_Save.Action 	     =fn_encodeNSession( "/Listing.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+vScrenTpCD+"&method=saveChgList" ) ;
		trs_Save.KeyName     = "toinb_dataid4";
		trs_Save.KeyValue     = "JSP(I: dtsParm1= dts_Mst )";
		trs_Save.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ vBzProcsNo +
								",COUNT=1" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_150 + 
								",DIV_IDX[0]=" + DIV_IDX_CHGLIST_SWPRC  ;
		trs_Save.Post();
		
	}
	
]]></script>


<events><event for="btn_Search" eventname="onclick"><![CDATA[
	if (getObjectValue(txb_ISU_CD) == "") {
		alert("[종목]을 선택하세요.");txb_ISU_CD.focus();return;
	} else {
		fn_initItem();
		fn_bfprc()
		fn_list_sync();
	}
]]></event>

<event for="img_ISU_NM" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsuCd;
	fn_SetPar = fn_SetParIsuCd;
	fn_PopFindIsu(fr_SecuGrpId);
]]></event>

<event for="img_CHD_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_CHG_DD);
]]></event>


<event for="dts_BZ_CHECK" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_BZ_CHECK);
]]></event>
<event for="dts_Mst" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Mst);
]]></event>
<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>
<event for="dts_List" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_List);
]]></event>


<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (vBzProcsNo == "") {
		buttonSet.setInsertStatus();
	} else {
		if (cGetToday("yyyymmdd") < getObjectValue(edt_CHG_DD)) {
			buttonSet.setUpdateStatus();
		} else {
			buttonSet.setErrorStatus();
		}
	}
]]></event>

<event for="dts_List" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	FillGridHeaderTotalCnt(rowcount, panel_page);
	if (vBzProcsNo == "") {
		buttonSet.setInsertStatus();
	}
]]></event>

<event for="grd_List" eventname="OnClick(row, colid)"><![CDATA[
	fn_read_sync(row);
]]></event>


<event for="trs_Save" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	fn_initItem() ;
	fn_list_sync();
	fn_bfprc(); 
]]></event>

<event for="trs_Save" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
	alert_error(trs_Save);	
]]></event>

<event for="btn_close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="btn_New" eventname="onclick"><![CDATA[
	if (getObjectValue(txb_ISU_CD) == "") {
		alert("[종목]을 선택하세요.");txb_ISU_CD.focus();return;
	} else {
		fn_initItem();
		fn_bfprc()
		fn_list_sync();
	}
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top);
	PanelToGroupBox(panel_Item);
	
   /* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 			// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 		// 삭제
	
	
	buttonSet.setInsertStatus();
	
	dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DELISTING_ISU_INOUT";
	dts_Isu.reset();	

]]></event></events>
</gform>

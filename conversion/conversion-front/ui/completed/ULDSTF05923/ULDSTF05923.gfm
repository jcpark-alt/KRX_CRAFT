	#include("../js/list_common.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/elw_recv_common.js");

	var vScrenID = "ULDSTF05923.gfm";
	var fn_GetPar, fn_SetPar;
	var TR_JOB;
	var vBzProcsNo;
	var vIsurCd;

	var vSecugrpID = SECUGRP_ID_EW; //(elw)메뉴단에서 파라미터로 받자..
	var fn_GetPar, fn_SetPar;

	function fn_GetParIsuCd(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = ""; 	// 코드값을 포함할 컨트롤
		arrPar[1] = getObjectValue(txb_SearchNm);	// 명칭값을 포함할 컨트롤
		arrPar[2] = vSecugrpID;
		return arrPar, length;
	} 

	function fn_SetParIsuCd(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			txb_SearchCd.value = arrPar[0].ISU_CD;
			txb_SearchNm.value = arrPar[0].ISU_KOR_NM;
			vIsurCd = arrPar[0].ISUR_CD;
			fn_read_sync(txb_SearchCd.value);
		}	
	}


	function fn_SetInstCdComboCode() {
		dts_INST_CD.DataID = "/CodeAction.do?method=listInstCd&For=";
		dts_INST_CD.Reset();
		
		dts_LEADCOM_MBR_NO.DataID = "/CodeAction.do?method=listLeadCom&For=";
		dts_LEADCOM_MBR_NO.Reset();
	}
	
	function fn_read_sync() {
		var url;
		url = "/IssueBook.do?method=readIssueBook&inputMessageId=LISTING_ISUBOOK_SEARCH_OUT";
		url += "&SECUGRP_ID=" + vSecugrpID;
		url += "&P_KEY=" + txb_SearchCd.value;
		url += "&SCREN_ID=" + vScrenID;
		url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
		dts_Isu.DataID = encodeURI(url);
		dts_Isu.Reset();
		
		url = "/IssueBook.do?method=readLpMbrNoIssueBook&inputMessageId=LISTING_ISUBOOK_SEARCH_OUT";
		url += "&P_KEY=" + txb_SearchCd.value;
		dts_LP.DataID = encodeURI(url);
		dts_LP.Reset();
		
		url = "/IssueBook.do?method=readUlyIssueBook&inputMessageId=LISTING_ISUBOOK_SEARCH_OUT";
		url += "&P_KEY=" + txb_SearchCd.value;
		dts_UlyIsu.DataID = encodeURI(url);
		dts_UlyIsu.Reset();
	}

	function fn_CheckForm() {
		if (getObjectValue(txb_ISU_CD) == "") {
			alert("[종목]을 선택하세요.");txb_ISU_CD.focus();return false;
		}
		//if (! dts_Isu.IsUpdated) {
			//fn_alertNoUpdate() ;return false;
		//}

		return true;
	}
	

	function fn_update() {
		TR_JOB = 'U';
		if (fn_CheckForm()) {

			if (! fn_isProcess(TR_JOB) )  return ;
			
			vBzProcsNo = fn_getNewBzProcNo( dts_BzProcsNo );
			
			//alert("[bz_procs_no]"+bz_procs_no);
			if (vBzProcsNo.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {
				fn_trs(TR_JOB_UPDATE);
			}
		}
	}

	function fn_trs(trsIdx) {

		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if         ( TR_JOB == "I" )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( TR_JOB == "U" )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		else if ( TR_JOB == "D" )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
			
		trs_Save.Action=fn_encodeNSession("/IssueBook.do?method=updateIssueBook&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD);
		trs_Save.KeyName="toinb_dataid4";
		trs_Save.KeyValue="JSP(I:pInput=dts_Isu)";
		trs_Save.Parameters  = "TRS_IDX=" + trsIdx + 
											",SECUGRP_ID=" + vSecugrpID + 
											",BZ_PROCS_NO="+ vBzProcsNo +
											",ISUR_CD=" + vIsurCd+ 
											",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_309;
		trs_Save.Post();

	}
	
]]></script>

<events><event for="img_ISU_CD" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsuCd;
	fn_SetPar = fn_SetParIsuCd;
	fn_PopFindIsu(vSecugrpID);
]]></event>

<event for="img_PAY_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_PAY_DD);
]]></event>
<event for="img_SUBS_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_SUBS_DD);
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>

<event for="dts_UlyIsu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_UlyIsu);
]]></event>

<event for="dts_LP" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_LP);
]]></event>

<event for="trs_Save" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
	alert_error(trs_Save);	
]]></event>

<event for="trs_Save" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	fn_read_sync();
]]></event>

<event for="btn_Update" eventname="onclick"><![CDATA[
	fn_update();
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top);
	PanelToGroupBox(panel_Item);

	fn_searchCode();
	fn_SetInstCdComboCode();
	//	dts_UDWRT_INST_CD.DataID = "/CodeAction.do?method=listInstCd&For=";
	//	dts_UDWRT_INST_CD.Reset();
	CopyDataSet(dts_INST_CD, dts_UDWRT_INST_CD);
	CopyDataSet(dts_INST_CD, dts_PAY_BK_INST_CD);
	CopyDataSet(dts_INST_CD, dts_BZAGNT_INST_CD);
	CopyDataSet(dts_INST_CD, dts_DEPO_INST_CD);
	
]]></event></events>
</gform>

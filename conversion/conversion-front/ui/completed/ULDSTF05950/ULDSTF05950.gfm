	}
	function fn_list_sync() {
		fn_Disable_Item();
	    if (MaxTab_01.ActiveIndex == 1) {					// 상장제한종목	
			var url = "/listingCommon.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=listGeneralForDynamicName&outputMessageId=ELW_ULY_CHG_INFO_INOUT" +
					"&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 				
					"&queryId=lds.stf.lstproc.select.elw.list.isu.lmt.condition"+
					"&{P}ELW_MBR_INFO_TP_CD=1" +			
                    "&{P}CHK_YN=" + getObjectValue(chk_DelYn)  ;							
			dts_List_1.DataID = encodeURI(url);
			dts_List_1.Reset();
			ShowWin(grd_List_1); 
		} else if (MaxTab_01.ActiveIndex == 2) {		// 지수구성종목변동
			var url = "/ElwListedReceive.do?method=listElwUlyChgInfo&inputMessageId=ELW_ULY_CHG_INFO_INOUT";
			url += "&ELW_MBR_INFO_TP_CD=2" ;
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			dts_List_2.DataID = encodeURI(url);
			dts_List_2.Reset();
			ShowWin(grd_List_2); 
		} else if (MaxTab_01.ActiveIndex == 3) {		// 발행가능 스타지수 기초자산
			var url = "/ElwListedReceive.do?method=listElwStarIndexByTop5Com&inputMessageId=ELW_STARIDX_BYMM_TOP5_COM_INOUT";
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 +"&BAS_YYMM=" + getObjectValue(txb_YYYYMM);
			dts_List_3.DataID = encodeURI(url);
			dts_List_3.Reset();
			ShowWin(grd_List_3); 
		} else if (MaxTab_01.ActiveIndex == 4) {		// 심사서류첨부
			var url = "/ElwListedReceive.do?method=listElwExchDeclInfo&inputMessageId=ELW_EXCH_DECL_INFO_INOUT";
			url += "&ELW_MBR_INFO_TP_CD=3" ;
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			dts_List_4.DataID = encodeURI(url);
			dts_List_4.Reset();
			ShowWin(grd_List_4); 
		} else if (MaxTab_01.ActiveIndex == 5) {		// 기타안내
			var url = "/ElwListedReceive.do?method=listElwExchDeclInfo&inputMessageId=ELW_EXCH_DECL_INFO_INOUT";
			url += "&ELW_MBR_INFO_TP_CD=4" ;
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			dts_List_5.DataID = encodeURI(url);
			dts_List_5.Reset();
			ShowWin(grd_List_5); 
		} else if (MaxTab_01.ActiveIndex == 6) {		// 발행가능  KOSPI 200 기초자산
			var url = "/ElwListedReceive.do?method=listElwUlyNmInfo&inputMessageId=ELW_ULY_NM_INOUT";
			url += "&ELW_MBR_INFO_TP_CD=6&BAS_YYMM=" + getObjectValue(cmb_Bas_YYMM);
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			dts_List_6.DataID = encodeURI(url);
			dts_List_6.Reset();
			ShowWin(grd_List_6); 
		} else if (MaxTab_01.ActiveIndex == 7) {		// 발행가능행사가격
			var url = "/ElwListedReceive.do?method=listElwIsuPosblExerPrcInfo&inputMessageId=ELW_ISU_POSBL_EXER_PRC_INOUT";
			url += "&ELW_MBR_INFO_TP_CD=7&BAS_YYMM=" + getObjectValue(txb_YYYYMM);
			url += "&RGHT_TP_CD=" + getObjectValue(rdo_RGHT_TP_CD);
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			dts_List_7.DataID = encodeURI(url);
			dts_List_7.Reset();
			ShowWin(grd_List_7); 
		
		}
	}
	function fn_Bas_YYMM_sync() {
		dts_Bas_YYMM.DataID = encodeURI("/CodeAction.do?method=listUlyYYMM&For=Q");
		dts_Bas_YYMM.Reset();
	}
	function fn_MakeInfo(){
		var contents = "";
		if (fn_CheckForm()) {		
			if(ELW_MBR_INFO_TP_CD == 2){
				contents = getObjectValue(txb_COM_NM_2) + " 종목이 " 
							  + FormatDateEx(getObjectValue(edt_SDate_2)) + " 에 " 
							  + getObjectValue(cmb_NotiTitle_2) + " 에서 편출될 예정이므로 \n"
							  + "해당 종목을 기초자산으로 하는 주식워런트증권은 상장이 불가합니다.\n"
							  + "자세한 사항은 상품상장팀 담당자에게 문의하여 주시기 바랍니다.";
				setObjectValue(txa_NotiContn_2, contents);
			}
		}
	}
	function fn_CheckForm() {
		if(ELW_MBR_INFO_TP_CD == 1){
			if (getObjectValue(txb_ISUR_CD_1) == "") {
				alert("[종목명]를 입력하세요.");
				txb_ISUR_CD_1.focus();
				return false;
			}
			if (getObjectValue(edt_SDate_1) == "") {
				alert("[제한사유 발생시점]을 입력하세요.");
				edt_SDate_1.focus();
				return false;
			}
			if (getObjectValue(edt_EDate_1) == "") {
				alert("[제한사유 종료시점]을 입력하세요.");
				edt_EDate_1.focus();
				return false;
			}
			if (getObjectValue(txb_NotiTitle_1) == "") {
				alert("[제한사유]를 입력하세요.");
				txb_NotiTitle_1.focus();
				return false;
			}
			if(getObjectValue(edt_SDate_1) > getObjectValue(edt_EDate_1)) {
				alert("[제한사유 종료시점]을  이전으로 입력하세요."); 
				edt_SDate_1.focus();
				return false;
			}
		}else if(ELW_MBR_INFO_TP_CD == 2){
			if (getObjectValue(txb_ISUR_CD_2) == "") {
				alert("[종목명]를 입력하세요.");txb_ISUR_CD_2.focus();
				return false;
			}
			if (getObjectValue(edt_SDate_2) == "") {
				alert("[지수편출일]을 입력하세요.");edt_SDate_2.focus();
				return false;
			}
			if (getObjectValue(cmb_NotiTitle_2) == "") {
				alert("[지수구분]을 선택하세요.");cmb_NotiTitle_2.focus();
				return false;
			}
		}else if(ELW_MBR_INFO_TP_CD == 3){
			if (getObjectValue(txb_ISUR_CD_1_1) == "") {
				alert("[종목명]를 입력하세요.");txb_ISUR_CD_1_1 .focus();
				return false;
			}
		}else if(ELW_MBR_INFO_TP_CD == 4){
			if(TR_JOB !="D"){
				if (getObjectValue(txb_NotiTitle_4) == "") {
					alert("[제목]을 입력하세요.");txb_NotiTitle_4 .focus();
					return false;
				}
				if (getObjectValue(txa_NotiContn_4) == "") {
					alert("[내용]을 입력하세요.");txa_NotiContn_4 .focus();
					return false;
				} else {
					var vtxa_NotiContn_4 = getObjectValue(txa_NotiContn_4);
					if(fn_chkXss(vtxa_NotiContn_4)){
						alert("허용되지 않는 문자가 들어가 있습니다.");txa_NotiContn_4 .focus();
						return false;
					}
				}			
				if (getObjectValue(edt_SDate_4_1) == "") {
					alert("[메시지 표시기간]을 입력하세요.");edt_SDate_4_1.focus();
					return false;
				}
				if (getObjectValue(edt_SDate_4_2) == "") {
					alert("[메시지 표시기간]을 입력하세요.");edt_SDate_4_2.focus();
					return false;
				}
				
				if(getObjectValue(edt_SDate_4_1) > getObjectValue(edt_SDate_4_2)){
					alert("[메시지 표시기간]의 시작일자는 종료일자보다 작아야 합니다.");edt_SDate_4_1.focus();
					return false;
				}
			}
			
		}else if(ELW_MBR_INFO_TP_CD == 5){
			if (getObjectValue(txb_NotiTitle_5) == "") {
				alert("[제목]을 입력하세요.");txb_NotiTitle_5 .focus();
				return false;
			}
			if (getObjectValue(txa_NotiContn_5) == "") {
				alert("[내용]을 입력하세요.");txa_NotiContn_5 .focus();
				return false;
			}
			
			if (getObjectValue(edt_SDate_5_1) == "") {
				alert("[메시지 표시기간]을 입력하세요.");edt_SDate_5_1.focus();
				return false;
			}
			if (getObjectValue(edt_SDate_5_2) == "") {
				alert("[메시지 표시기간]을 입력하세요.");edt_SDate_5_2.focus();
				return false;
			}
			
			if(getObjectValue(edt_SDate_5_1) > getObjectValue(edt_SDate_5_2)){
				alert("[메시지 표시기간]의 시작일자는 종료일자보다 작아야 합니다.");edt_SDate_5_1.focus();
				return false;
			}
		}
		return true;
	}	
	function fn_trs() {
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if         ( TR_JOB == "I" )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( TR_JOB == "U" )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		else if ( TR_JOB == "D" )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
	
		if(ELW_MBR_INFO_TP_CD == 1){
			dts_Item.NameValue(1, "ISUR_CD") = getObjectValue(txb_ISUR_CD_1);
			dts_Item.NameValue(1, "NOTI_TITLE") = getObjectValue(txb_NotiTitle_1);
			dts_Item.NameValue(1, "NOTI_CONTN") = getObjectValue(txa_NotiContn_1);
			dts_Item.NameValue(1, "STRT_DD") = getObjectValue(edt_SDate_1);
			dts_Item.NameValue(1, "END_DD") = getObjectValue(edt_EDate_1);
			trs_Save.Action="/ElwListedReceive.do?method=saveElwUlyChgInfo&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD;
		}else if(ELW_MBR_INFO_TP_CD == 2){
			dts_Item.NameValue(1, "ISUR_CD") = getObjectValue(txb_ISUR_CD_2);
			dts_Item.NameValue(1, "NOTI_TITLE") = getObjectValue(cmb_NotiTitle_2);
			dts_Item.NameValue(1, "NOTI_CONTN") = getObjectValue(txa_NotiContn_2);
			dts_Item.NameValue(1, "STRT_DD") = getObjectValue(edt_SDate_2);
			trs_Save.Action="/ElwListedReceive.do?method=saveElwUlyChgInfo&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD;
		}else if(ELW_MBR_INFO_TP_CD == 4){
		    dts_Item.NameValue(1, "NOTI_TITLE") = getObjectValue(txb_NotiTitle_4);
			dts_Item.NameValue(1, "NOTI_CONTN") = getObjectValue(txa_NotiContn_4);
			dts_Item.NameValue(1, "STRT_DD") = getObjectValue(edt_SDate_4_1);
			dts_Item.NameValue(1, "END_DD") = getObjectValue(edt_SDate_4_2);
			dts_Item.NameValue(1, "INFO_RND") = getObjectValue(txb_INFO_RND_4);
			dts_Item.NameValue(1, "ELW_MBR_INFO_TP_CD") = "3";
			trs_Save.Action="/ElwListedReceive.do?method=saveElwExchDeclInfo&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD;
		}else if(ELW_MBR_INFO_TP_CD == 5){
		    dts_Item.NameValue(1, "NOTI_TITLE") = getObjectValue(txb_NotiTitle_5);
			dts_Item.NameValue(1, "NOTI_CONTN") = getObjectValue(txa_NotiContn_5);
			dts_Item.NameValue(1, "STRT_DD") = getObjectValue(edt_SDate_5_1);
			dts_Item.NameValue(1, "END_DD") = getObjectValue(edt_SDate_5_2);
			dts_Item.NameValue(1, "INFO_RND") = getObjectValue(txb_INFO_RND_5);
			dts_Item.NameValue(1, "ELW_MBR_INFO_TP_CD") = "4";
			trs_Save.Action="/ElwListedReceive.do?method=saveElwExchDeclInfo&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD;
		}
		trs_Save.KeyName="toinb_dataid4";
		trs_Save.KeyValue="JSP(I:pInput=dts_Item)";
		
		//alert(dts_Item.Text);
		trs_Save.Post();
	}
	function fn_save() {
		if (fn_CheckForm()) {
			if (! fn_isProcess(TR_JOB) )  return ;
			dts_Item.NameValue(1, "TR_JOB") = TR_JOB;
			dts_Item.NameValue(1, "ELW_MBR_INFO_TP_CD") = ELW_MBR_INFO_TP_CD;
			dts_Item.NameValue(1, "EMP_NO") = js_id;
			
			fn_trs();
		}
	}
	function fn_delete() {
		TR_JOB = "D";
		if (fn_CheckForm()) {
			if (! fn_isProcess(TR_JOB) )  return ;
			dts_Item.NameValue(1, "TR_JOB") = TR_JOB;
			dts_Item.NameValue(1, "ELW_MBR_INFO_TP_CD") = ELW_MBR_INFO_TP_CD;
			fn_trs();
		}
	}
]]></script>
<events><event for="gform" eventname="onload"><![CDATA[	
	fn_setYYYYMM();
	
	ELW_MBR_INFO_TP_CD = 1;
	fn_SetTitle();
	PanelToGroupBox(panel_Top_1);
	fn_SetDataHeader();
	showObj(txb_basYm, false);
	showObj(cmb_Bas_YYMM, false);
	
	showObj(label_26, false);
	showObj(rdo_RGHT_TP_CD, false);
	showObj(txb_YYYYMM, false);
	
	fn_Bas_YYMM_sync();
	fn_list_sync();
]]></event>
<event for="MaxTab_01" eventname="OnSelChanged(nIndex)"><![CDATA[
	if(nIndex == 6){			// 	발행가능 KOSPI200 기초자산		
		setObjectValue(txb_basYm, "분기");		
		cmb_Bas_YYMM.Index = 1;
		setObjectValue(cmb_Bas_YYMM, cmb_Bas_YYMM.ValueOfIndex("VALUE",cmb_Bas_YYMM.Index));
		showObj(txb_basYm, true);
		showObj(cmb_Bas_YYMM, true);
		showObj(label_26, false);
		showObj(rdo_RGHT_TP_CD, false);
		showObj(txb_YYYYMM, false);
	}else if(nIndex == 3 ){		//	발행가능 스타지수 기초자산 
		setObjectValue(txb_basYm, "기준년월");
		fn_setYYYYMM();
		showObj(txb_basYm, true);
		showObj(cmb_Bas_YYMM, false);	
		showObj(label_26, false);
		showObj(rdo_RGHT_TP_CD, false);
		showObj(txb_YYYYMM, true);		
	}else if(nIndex == 7 ){			//	발행가능 행사가격
		setObjectValue(txb_basYm, "기준년월");
		fn_setYYYYMM();
		showObj(txb_basYm, true);
		showObj(cmb_Bas_YYMM, false);
		showObj(label_26, true);
		showObj(rdo_RGHT_TP_CD, true);
		showObj(txb_YYYYMM, true);	
	}else {
		showObj(txb_basYm, false);
		showObj(cmb_Bas_YYMM, false);	
		showObj(label_26, false);
		showObj(rdo_RGHT_TP_CD, false);
		showObj(txb_YYYYMM, false);
	}
	ELW_MBR_INFO_TP_CD = nIndex;
	fn_SetTitle();
	fn_SetDataHeader();
	fn_list_sync();
	fn_SetTitle();
]]></event>

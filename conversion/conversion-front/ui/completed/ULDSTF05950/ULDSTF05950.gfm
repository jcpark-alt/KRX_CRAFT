<event for="txb_YYYYMM" eventname="onkeydown"><![CDATA[
	if(!((window.event.keyCode >=48  && window.event.keyCode <=57 ) || window.event.keyCode == 8 ||(window.event.keyCode >=96 && window.event.keyCode <= 105 ) ||
			 window.event.keyCode == 37 ||window.event.keyCode == 39 || window.event.keyCode == 46 || window.event.keyCode == 9||window.event.keyCode == 13)) {
		alert("숫자를 입력하세요.");
		return false;
	}
]]></event></events>

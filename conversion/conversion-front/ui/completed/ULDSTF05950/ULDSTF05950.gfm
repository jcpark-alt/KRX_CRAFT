		</panel>
		<mxtab id="MaxTab_01" class="Tab_01" left="10" top="77" width="920" height="20">
			<property activeindex="1"></property>
			<format>
				<tabpage title="상장제한종목" divid="panel_1"></tabpage>
				<tabpage title="지수구성종목변동" divid="panel_2"></tabpage>
				<tabpage title="발행가능 코스닥150 기초자산" divid="panel_3"></tabpage>
				<tabpage title="심사서류첨부" divid="panel_4"></tabpage>
				<tabpage title="기타안내" divid="panel_5"></tabpage>
				<tabpage title="발행가능  KOSPI 200 기초자산" divid="panel_11"></tabpage>
				<tabpage title="발행가능행사가격" divid="panel_12"></tabpage>
			</format>
		</mxtab>
		<panel id="panel_12" left="10" top="97" width="920" height="630">
			<extproperty visibility="hidden"></extproperty>
			<mxgrid id="grd_List_7" class="Grid_01" left="0" top="0" width="918" height="601">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="28" headborder="4" indwidth="0" sortview="left" titleheight="29" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<column name="구분" align="center" id="GUBUN" width="70"></column>
				<column id="RNK" name="번호" value="{CurRow},{ToString}" align="center" width="40" sort="False" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_CD" name="기초자산;종목코드" width="100" sort="False" align="center" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_KOR_ABBRV" name="기초자산명" width="150" sort="False" align="center" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column name="기준일" sort="False" id="BAS_DD" width="75"></column>
				<column name="기준가격" sort="False" id="BAS_PRC" align="right" width="80"></column>
				<group name="패리티별 행사가격">
					<column name="90%" width="80" id="PRITY_90" align="right"></column>
					<column id="PRITY_92" name="92%" width="80" sort="False" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" align="right"></column>
					<column id="PRITY_94" name="94%" width="80" sort="False" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" align="right"></column>
					<column name="96%" width="80" sort="False" id="PRITY_96" align="right"></column>
					<column name="98%" width="80" sort="False" id="PRITY_98" align="right"></column>
					<column name="100%" width="80" sort="False" id="PRITY_100" align="right"></column>
					<column name="102%" width="80" sort="False" id="PRITY_102" align="right"></column>
					<column name="104%" width="80" sort="False" id="PRITY_104" align="right"></column>
					<column name="106%" width="80" sort="False" id="PRITY_106" align="right"></column>
					<column name="108%" width="80" sort="False" id="PRITY_108" headalign="center" align="right"></column>
					<column id="PRITY_110" width="80" name="110%" align="right" bgcolor="#FFFF99"></column>
				</group>
			</format>
			<ref dataid="dts_List_7"></ref>

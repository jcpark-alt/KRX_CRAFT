			<image id="btn_Excel_1" left="780" top="607" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<panel id="panel_Top_1" class="TopCondition_01" left="10" top="20" width="920" height="50">
			<extproperty background-color="#d9e9fc"></extproperty>
			<mxtextarea id="txa_Title" class="TextArea_01" left="8" top="10" width="677" height="33">
			<property readonly="True"></property>
			<extproperty font-size="12" color="#15549c" background-color="#d9e9fc" border-color="#d9e9fc"></extproperty>
			</mxtextarea>
			<image id="btn_Search" left="865" top="14" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<textbox id="txb_YYYYMM" class="TopCondition_01_write" left="748" top="15" width="50" height="20" maxlength="6">
			<extproperty text-align="left"></extproperty>
			</textbox>
			<textbox id="txb_basYm" class="TopCondition_01_write" left="691" top="18" width="53" height="17" value="기준년월" readonly="readonly" maxlength="15" tabindex="1">
			<extproperty font-weight="normal" color="#000000" background-color="#d9e9fc" border-style="none" border-width="0" border-color="#d9e9fc" text-align="right"></extproperty>
			</textbox>
			<mxradio id="rdo_RGHT_TP_CD" class="TopCondition_Blue" left="607" top="14" width="70" height="20">
			<property automargin="True" codevalue="C" cols="2" format="C^콜,F^풋"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			</mxradio>
			<label id="label_26" class="TopCondition_01" left="555" top="10" width="49" height="30" text="권리형태"></label>
			<mxcombo id="cmb_Bas_YYMM" class="TopCondition_01" left="746" top="14" width="105" height="20">
			<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" index="1" listcount="10" listexprformat="TEXT^0^120" searchcolumn="TEXT"></property>
			<extproperty border-color="#99CCFF"></extproperty>
			<ref combodataid="dts_Bas_YYMM"></ref>
			</mxcombo>
			<image id="image_2" left="857" top="6" width="2" height="35" src="../img/img_line2.gif"></image>
			<label id="label_14" left="713" top="16" width="142" height="17" text="현재 유효한 항목만 보기">
			<extproperty font-weight="normal"></extproperty>
			</label>
			<checkbox id="chk_DelYn" left="694" top="15" width="15" height="15" title="현재 유효한 항목만 보기" checked="checked"></checkbox>
		</panel>
	</components>
<script><![CDATA[
    #include("../js/libRoundPanel.js");
	#include("../js/PopupCalendar.js");
	#include("../js/stf.js");
	#include("../js/session.js");
	#include("../js/list_common.js");
	#include("../js/utils.js");
    #include("../js/common.js");
	
	var vScrenID = "ULDSTF05950.gfm";
	var pMenuID = InfoMenuID();
	var fn_GetPar, fn_SetPar, fr_SecuGrpId;
	var flagVal;
	var TR_JOB;
	var ELW_MBR_INFO_TP_CD ;
		
	function fn_SetTitle(){
		
			
		var strTitle = "";
		txa_Title.ReadOnly = false;
		
		if(ELW_MBR_INFO_TP_CD == 6 ||ELW_MBR_INFO_TP_CD == 7 ){
			showObj(txa_Title,false);
		}else{
			showObj(txa_Title,true);
		}
		
		if(ELW_MBR_INFO_TP_CD == 1 ){
			showObj(chk_DelYn,true);
			showObj(label_14,true);
		}else{
			showObj(chk_DelYn,false);
			showObj(label_14,false);
		}
		
		if(ELW_MBR_INFO_TP_CD == 1 ){
			strTitle = "* 발행사가 코드 발급한 ELW의 기초자산이 제한사유 해당종목이고 만기가 제한사유 발생시점 이후에 도래하는 경우\r\n  상장공시제출시스템의 상장신청 탭을 선택하였을때 안내 메시지를 표시합니다.";			
		}else if(ELW_MBR_INFO_TP_CD == 2 ){
			strTitle = "* 발행사가 조회화면에 저장되어 있는 종목을 코드발급한 경우, 상장공시제출시스템의 상장신청 탭을 선택하였을때 안내 메시지를 표시합니다.";
			
		}else if(ELW_MBR_INFO_TP_CD == 3 ){
			//strTitle = "* 매월 첫 영업일에 전월 말일 기준으로 코스닥150 구성종목중 시가총위 5위 이내의 종목을 자동으로 저장합니다.";
			strTitle = "";
		}else if(ELW_MBR_INFO_TP_CD == 4){
			strTitle = "* 지정한 표시기간 동안 발행사 담당자가 상장공시제출시스템의 공시제출 탭을 선택했을 때 팝업화면으로 내용에 입력한 사항을 표시합니다.";
		}else if(ELW_MBR_INFO_TP_CD == 5 ){
			strTitle = "* 메시지 표시기간은 입력값이 없으면 매월 말일 포함 직전 3영업일입니다.";
		}
		setObjectValue(txa_Title, strTitle);
		txa_Title.ReadOnly = true;
	}
	
	function fn_setYYYYMM(){
		var vCurDate = cGetToday("yyyymmdd");	
		var YYMM = vCurDate.substr(0,6);
		setObjectValue(txb_YYYYMM,YYMM);
	}
	
	function fn_SetDataHeader(){
		if(ELW_MBR_INFO_TP_CD == 1 || ELW_MBR_INFO_TP_CD == 2 ){
			dts_Item.ClearAll();
			dts_Item.SetDataHeader("TR_JOB:STRING(1),ELW_MBR_INFO_TP_CD:STRING(1),ISUR_CD:STRING(5),STRT_DD:STRING(8),END_DD:STRING(8),NOTI_TITLE:STRING(100),NOTI_CONTN:STRING(2000),EMP_NO:STRING(6)"); //껍데기만 만들고 사용자필드를 사용함
			dts_Item.AddRow();
		}else if(ELW_MBR_INFO_TP_CD == 3 ){
			dts_Item.ClearAll();
			dts_Item.SetDataHeader("TR_JOB:STRING(1),ELW_MBR_INFO_TP_CD:STRING(1),BAS_YYMM:STRING(6),ISUR_CD1:STRING(5),ISUR_CD2:STRING(5),ISUR_CD3:STRING(5),ISUR_CD4:STRING(5),ISUR_CD5:STRING(5),EMP_NO:STRING(6)"); //껍데기만 만들고 사용자필드를 사용함
			dts_Item.AddRow();
		}else if(ELW_MBR_INFO_TP_CD == 4 || ELW_MBR_INFO_TP_CD == 5 ){
			dts_Item.ClearAll();
			dts_Item.SetDataHeader("TR_JOB:STRING(1),ELW_MBR_INFO_TP_CD:STRING(1),INFO_RND:STRING(21),NOTI_TITLE:STRING(100),NOTI_CONTN:STRING(2000),STRT_DD:STRING(8), END_DD:STRING(8),EMP_NO:STRING(6)"); //껍데기만 만들고 사용자필드를 사용함
			dts_Item.AddRow();
		}
	}	
		
	function fn_GetParIsur(arrPar) {  // 넘길 인수를 지정하는 펑션
		if(ELW_MBR_INFO_TP_CD == 1){
			arrPar[0] = txb_ISUR_CD_1.value; // 발행기관코드값
			arrPar[1] = txb_COM_NM_1.value; // 발행기관명
		}else if(ELW_MBR_INFO_TP_CD == 2){
			arrPar[0] = txb_ISUR_CD_2.value; // 발행기관코드값
			arrPar[1] = txb_COM_NM_2.value; // 발행기관명
		}
		arrPar[2] = fr_SecuGrpId;  // 명칭값을 포함할 컨트롤
		arrPar[3] = "9";                  // 회사코드팝업 전체데이터
		return arrPar.length;
	} 
	function fn_SetParIsur(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			if(ELW_MBR_INFO_TP_CD == 1){
				txb_ISUR_CD_1.value = arrPar[0].ISUR_CD;
				txb_COM_NM_1.value = arrPar[0].COM_NM;
			}else if(ELW_MBR_INFO_TP_CD == 2){
				txb_ISUR_CD_2.value = arrPar[0].ISUR_CD;
				txb_COM_NM_2.value = arrPar[0].COM_NM;
			}
		}
	}

	function fn_SetValue(row){
		if (row > 0 ) { //그리드에서 선택시
			TR_JOB = "U";
			if(ELW_MBR_INFO_TP_CD == 1){
				img_COM_NM_1.disabled = true;
				btn_SDate_1.disabled = true;
				edt_SDate_1.ReadOnly = true;	
				edt_EDate_1.ReadOnly = false;
				txb_NotiTitle_1.readOnly = false;
				txa_NotiContn_1.ReadOnly = false;			
				edt_SDate_1.style.background = "#b9d4f7";	
				edt_EDate_1.style.background = "#ffffff";
				txb_NotiTitle_1.style.background = "#ffffff";
				txa_NotiContn_1.style.background = "#ffffff";
				
				setObjectValue(txb_ISUR_CD_1, dts_List_1.NameString(eval(row), "ISUR_CD"));
				setObjectValue(txb_COM_NM_1, dts_List_1.NameString(eval(row), "COM_ABBRV"));
				setObjectValue(txb_NotiTitle_1, dts_List_1.NameString(eval(row), "NOTI_TITLE"));
				setObjectValue(txa_NotiContn_1, dts_List_1.NameString(eval(row), "NOTI_CONTN"));
				setObjectValue(edt_SDate_1, dts_List_1.NameString(eval(row), "STRT_DD"));
				setObjectValue(edt_EDate_1, dts_List_1.NameString(eval(row), "END_DD"));			
			}else if(ELW_MBR_INFO_TP_CD == 2){
				img_COM_NM_2.disabled = true;
				btn_SDate_2.disabled = true;
				edt_SDate_2.ReadOnly = true;
				txa_NotiContn_2.ReadOnly = false;
				
				edt_SDate_2.style.background = "#b9d4f7";
				txa_NotiContn_2.style.background = "#ffffff";
				
				setObjectValue(txb_ISUR_CD_2, dts_List_2.NameString(eval(row), "ISUR_CD"));
				setObjectValue(txb_COM_NM_2, dts_List_2.NameString(eval(row), "COM_ABBRV"));
				setObjectValue(cmb_NotiTitle_2,dts_List_2.NameString(eval(row), "NOTI_TITLE"));
				setObjectValue(txa_NotiContn_2, dts_List_2.NameString(eval(row), "NOTI_CONTN"));
				setObjectValue(edt_SDate_2, replaceAll(dts_List_2.NameString(eval(row), "STRT_DD"),"-",""));
			
			}else if(ELW_MBR_INFO_TP_CD == 3){
				 fn_Enable_Item();
				 
			}else if(ELW_MBR_INFO_TP_CD == 4){
				fn_Enable_Item();
				setObjectValue(txb_NotiTitle_4, dts_List_4.NameString(eval(row), "NOTI_TITLE"));
				setObjectValue(txa_NotiContn_4, dts_List_4.NameString(eval(row), "NOTI_CONTN"));
				setObjectValue(edt_SDate_4_1, replaceAll(dts_List_4.NameString(eval(row), "STRT_DD"),"-",""));
				setObjectValue(edt_SDate_4_2, replaceAll(dts_List_4.NameString(eval(row), "END_DD"),"-",""));
				setObjectValue(txb_INFO_RND_4, dts_List_4.NameString(eval(row), "INFO_RND"));
			}else if(ELW_MBR_INFO_TP_CD == 5){
				fn_Enable_Item();
				setObjectValue(txb_NotiTitle_5, dts_List_5.NameString(eval(row), "NOTI_TITLE"));
				setObjectValue(txa_NotiContn_5, dts_List_5.NameString(eval(row), "NOTI_CONTN"));
				setObjectValue(edt_SDate_5_1, replaceAll(dts_List_5.NameString(eval(row), "STRT_DD"),"-",""));
				setObjectValue(edt_SDate_5_2, replaceAll(dts_List_5.NameString(eval(row), "END_DD"),"-",""));
				setObjectValue(txb_INFO_RND_5, dts_List_5.NameString(eval(row), "INFO_RND"));
			}
		}
	}
	
	function fn_Enable_Item() {
		if(ELW_MBR_INFO_TP_CD == 1){
			setObjectValue(txb_ISUR_CD_1, "");
		    setObjectValue(txb_COM_NM_1, "");
		    setObjectValue(txb_NotiTitle_1, "");
		    setObjectValue(txa_NotiContn_1, "");
		    setObjectValue(edt_SDate_1, "");
			setObjectValue(edt_EDate_1, "");

		</panel>
		<panel id="panel_11" left="10" top="97" width="920" height="630">
			<extproperty visibility="hidden"></extproperty>
			<mxgrid id="grd_List_6" class="Grid_01" left="0" top="0" width="918" height="591">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="28" headborder="4" indwidth="0" sortview="left" titleheight="29" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<column id="NO" name="번호" value="{CurRow},{ToString}" align="center" width="50" sort="True" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_CD" name="종목코드" width="130" sort="True" align="center" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_KOR_ABBRV" name="종목명" width="190" sort="True" align="center" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="DYAVG_TRDVAL" name="일평균거래대금" width="150" sort="True" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="MKTCAP" name="시가총액" width="182" sort="True" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column name="상장제한사유(제한기간)" width="200" id="NOTI_TITLE" align="left"></column>
			</format>
			<ref dataid="dts_List_6"></ref>

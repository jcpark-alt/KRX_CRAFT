<event for="btn_Search" eventname="onclick"><![CDATA[
	if(ELW_MBR_INFO_TP_CD== 7) {
		if(getObjectValue(rdo_RGHT_TP_CD) == "") {
			alert("권리형태를 지정해주세요.");
			rdo_RGHT_TP_CD.focus();
			return;
		}
		if(getObjectValue(txb_YYYYMM) == "") {
			alert("기준년월을 지정해주세요.");
			txb_YYYYMM.focus();
			return;
		}else {
			if(getObjectValue(txb_YYYYMM).length<6) {
				alert("올바른 날짜형식이 아닙니다.(YYYYMM)");
				txb_YYYYMM.focus();
				return;				
			} else {
				if(getObjectValue(txb_YYYYMM).substr(0,1)<1) {
					alert("올바른 날짜형식이 아닙니다.");
					txb_YYYYMM.focus();
					return;	
				}
				
				if(getObjectValue(txb_YYYYMM).substr(4,2) > 12 ||getObjectValue(txb_YYYYMM).substr(4,2) < 1 ) {
					alert("올바른 날짜형식이 아닙니다.");
					txb_YYYYMM.focus();
					return;	
				}
			}		
		}	
	}	
	fn_list_sync();
]]></event>

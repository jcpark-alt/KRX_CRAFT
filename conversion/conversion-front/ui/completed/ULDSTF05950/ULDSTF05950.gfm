				</label>
				<label id="label_9" left="70" top="20" width="100" height="20" text="제목">
			<extproperty font-size="12"></extproperty>
				</label>
				<mxtextarea id="txa_NotiContn_5" class="TextArea_01" left="180" top="50" width="608" height="108">
			<extproperty background-color="#b9d4f7"></extproperty>
				</mxtextarea>
				<textbox id="txb_NotiTitle_5" class="panel_text_read_01" left="180" top="20" width="610" height="20" maxlength="1000" type="text">
			<extproperty border-style="solid" border-width="1"></extproperty>
				</textbox>
				<label id="label_21" left="650" top="170" width="60" height="20" text="일련번호">
			<extproperty font-size="12"></extproperty>
				</label>
				<textbox id="txb_INFO_RND_5" class="panel_text_read_01" left="720" top="170" width="70" height="20" maxlength="1000" type="text">
			<extproperty border-style="solid" border-width="1"></extproperty>
				</textbox>
				<label id="label_23" left="70" top="170" width="100" height="20" text="메시지 표시기간">
			<extproperty font-size="12"></extproperty>
				</label>
				<mxmaskedit id="edt_SDate_5_2" class="panel_maskedit_read_01" left="300" top="170" width="67" height="20">
			<property format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
				</mxmaskedit>
				<image id="btn_SDate_5_2" left="371" top="170" width="21" height="20" src="../img/icn_calendar.gif"></image>
				<mxmaskedit id="edt_SDate_5_1" class="panel_maskedit_read_01" left="180" top="170" width="67" height="20">
			<property numeric="False" readonly="True"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
				</mxmaskedit>
				<label id="label_24" left="280" top="170" width="16" height="20" text="~"></label>
				<image id="btn_SDate_5_1" left="251" top="170" width="21" height="20" src="../img/icn_calendar.gif"></image>
			</panel>
			<image id="btn_Close_5" left="859" top="603" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>

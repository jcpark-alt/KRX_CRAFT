		<script type="text/javascript" lazy="false"><![CDATA[scwin.vScrenID = "ULDSTF09302.xml";
scwin.clickBzProcsNo = "";

/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 함수 호출
 * @returns {void}
 */
scwin.onpageload = function () {
    scwin.init();
};

/**
 * @method
 * @name onpageunload
 * @description 화면 종료 시 처리 — 현재 비어있음
 * @returns {void}
 */
scwin.onpageunload = function () {
};

/**
 * @method
 * @name setBzProcsNo
 * @description 그리드 행 선택 시 해당 행의 업무처리번호를 저장
 * @param {number} row - 선택된 그리드 행 인덱스
 * @returns {void}
 */
scwin.setBzProcsNo = function (row) {
    scwin.clickBzProcsNo = dlt_selectListRes.getCellData(row, "bzProcsNo");
};

/**
 * @method
 * @name getBzProcsNo
 * @description 저장된 업무처리번호 반환
 * @returns {string} - 현재 선택된 업무처리번호
 */
scwin.getBzProcsNo = function () {
    return scwin.clickBzProcsNo;
};

/**
 * @method
 * @name list_sync
 * @description 신규상장 목록 조회 — 선택 조건에 따라 데이터를 조회하고 그리드에 표시
 * @returns {Promise<void>}
 */
scwin.list_sync  = async function () {
    const sbmOptions = {
        id: "sbm_selectList",
        action: "/api/listing/lstproc/pf/new-listing/select-list",
        method: "get",
        ref: "dma_selectListReq",
        target: "dlt_selectListRes=body",
        isProcessMsg: false
    };
    await $c.sbm.executeDynamic(sbmOptions);

    scwin.dts_List_OnLoadCompleted(dlt_selectListRes.getRowCount());
};

/**
 * @method
 * @name excelDown
 * @description 그리드 데이터를 엑셀 파일로 다운로드
 * @returns {void}
 */
/**********************************************
 * 함수명   : excelDown()
 * 설명       : 정보를 excel로 다운 받는다.
 ***********************************************/
scwin.excelDown = function () {
    if (dlt_selectListRes.getTotalRow() > 0) {
        //$c.stf.doLogSave(scwin.vScrenID, SCREN_PROCS_TP_CD_07);

        const options = {
            fileName: "리스트",
            //sheetName : "ELW상장수수료계산기",
        };
        $c.data.downloadGridViewExcel(grd_List, options);
    } else {
        $c.win.alert("해당데이터가 없습니다. 조회후 다운받으십시요.");
    }
};

/**
 * @method
 * @name openDetail
 * @description 신규상장 상세 화면 열기 — 선택된 행 또는 신규 등록 모드
 * @param {number} row - 선택된 그리드 행 인덱스 (-999: 신규 등록 모드)
 * @returns {Promise<void>}
 */
scwin.openDetail = async function (row) {
    let secugrpId = "";

    if (row >= 0) {
        //그리드에서 선택시
        scwin.setBzProcsNo(row);
        secugrpId = dlt_selectListRes.getCellData(row, 'secugrpId');
    } else {
        //신규버튼 선택시
        scwin.clickBzProcsNo = ""; //초기화
        secugrpId = cmb_NEW_SECUGRP_ID.getValue();
    }

    const opts = {
        id: "ULDSTF09303",
        popupName: "상장형 수익증권 신규상장관리",
        width: 1320,
        height: 900,
        frameModal: "top",
    };
    await $c.win.openPopup("/ui/lst/pf/ULDSTF09303" + ".xml", opts);
};

/**
 * @method
 * @name btn_Search_onclick
 * @description 조회 버튼 클릭 — 시작일이 종료일 이전인지 확인 후 조회 실행
 * @returns {void}
 */
scwin.btn_Search_onclick = function () {
    if ($c.date.dateCompare(edt_SDate.getValue(), edt_EDate.getValue())) {
        scwin.list_sync ();
    }
};

/**
 * @method
 * @name dts_List_OnLoadError
 * @description 조회 오류 발생 시 오류 메시지 표시
 * @returns {void}
 */
scwin.dts_List_OnLoadError = function () {
    $c.stf.alert_error(dts_List);
};

/**
 * @method
 * @name dts_List_OnLoadCompleted
 * @description 조회 완료 시 그리드 총 건수 업데이트
 * @param {number} rowcount - 조회된 행 수
 * @returns {void}
 */
scwin.dts_List_OnLoadCompleted = function (rowcount) {
    $c.stf.fillGridHeaderTotalCnt(rowcount, panel_page);
};

/**
 * @method
 * @name btn_Excel_onclick
 * @description 엑셀 다운로드 버튼 클릭 — excelDown 함수 호출
 * @returns {void}
 */
scwin.btn_Excel_onclick = function () {
    scwin.excelDown();
};

/**
 * @method
 * @name grd_List_OnDblClick
 * @description 그리드 더블클릭 — 선택된 행의 상세 화면 열기
 * @param {number} row - 클릭된 행 인덱스
 * @param {string} colid - 클릭된 열 ID
 * @returns {void}
 */
scwin.grd_List_OnDblClick = function (row, colid) {
    scwin.openDetail(row);
};

/**
 * @method
 * @name btn_New_onclick
 * @description 신규 등록 버튼 클릭 — 유가증권 선택 확인 후 상세 화면 열기
 * @returns {void}
 */
scwin.btn_New_onclick = function () {
    if (cmb_NEW_SECUGRP_ID.getValue() === "") {
        $c.win.alert("신규등록할 [유가증권]을 선택하세요.");
        cmb_NEW_SECUGRP_ID.focus();
        return;
    } else {
        scwin.openDetail(-999);
    }
};

/**
 * @method
 * @name btn_EDate_onclick
 * @description 종료일 캘린더 버튼 클릭 — 캘린더 팝업 열기
 * @returns {void}
 */
scwin.btn_EDate_onclick = function () {
    popUpCalendar2(edt_EDate);
};

/**
 * @method
 * @name btn_SDate_onclick
 * @description 시작일 캘린더 버튼 클릭 — 캘린더 팝업 열기
 * @returns {void}
 */
scwin.btn_SDate_onclick = function () {
    popUpCalendar2(edt_SDate);
};

/**
 * @method
 * @name img_IsuSearch_onclick
 * @description 종목 검색 버튼 클릭 — 종목 선택 팝업 열기 및 선택된 종목 정보 설정
 * @returns {Promise<void>}
 */
scwin.img_IsuSearch_onclick = async function () {
    const data = {
        "secugrpId": rdo_SECUGRP_ID.getValue(),
        "searchTyp": "SLR",
        "mktTpCd": rdo_SPOT_ISU_TRD_MKT_TP_CD.getValue()
    };

    const opts = {
        id: "ULDSTF05012",
        popupName: "종목 선택",
        width: 600,
        height: 640,
        frameModal: "top",
    };

    const res = await $c.win.openPopup("/ui/lst/common/ULDSTF05012" + ".xml", opts, data);

    if (!$c.util.isEmpty(res)) {
        txb_ISU_CD.setValue(res.isuCd);
        txb_ISU_NM.setValue(res.isuNm);
    }
};

/**
 * @method
 * @name txb_ISU_CD_onblur
 * @description 종목코드 입력 상자 포커스 아웃 — 종목코드가 비어있으면 종목명 초기화
 * @returns {void}
 */
scwin.txb_ISU_CD_onblur = function () {
    if (txb_ISU_CD.getValue() === "") {
        txb_ISU_NM.setValue("");
    }
};

/**
 * @method
 * @name cmb_PeriodTp_OnSelChange
 * @description 기간유형 변경 시 시작일과 종료일 자동 설정
 * @returns {void}
 */
scwin.cmb_PeriodTp_OnSelChange = function () {
    const vTp = $c.cp.valueOfIndex(cmb_PeriodTp, "value", cmb_PeriodTp.getSelectedIndex());
    $c.stf.setFromToDate(vTp, edt_SDate, edt_EDate);
};

/**
 * @method
 * @name init
 * @description 화면 초기화 — 키보드 이벤트 설정, 기간 초기화, 시장구분 설정, 조회 실행
 * @returns {void}
 */
scwin.init = function () {
    $c.win.setEnterKeyEvent(grp_search, scwin.btn_Search_onclick);
    $c.data.comboCbDataSetPeriod(cmb_PeriodTp);

    //목록검색시작일과 종료일자의 초기값 설정
    //let vCurDate = $c.date.getServerDateTime("yyyyMMdd");
    //let vEdate =  $c.date.addDate(vCurDate, 60);
    //edt_EDate.setValue(vEdate);
    $c.date.compareFromToDate(edt_SDate, edt_EDate);
    $c.lc.initSearchDate(edt_SDate, edt_EDate);

    const market = $c.session.getUserInfo("market");

    if (market == "1" || market == "2" || market == "6") {
        $c.cm.setColumnProp(grd_List, "TR_MKT_NM", "Show", false);
        rdo_SPOT_ISU_TRD_MKT_TP_CD.setValue($c.session.getUserInfo("market"));
        panel_mkt_gubun.hide();
    } else {
        panel_mkt_gubun.show("");
    }

    scwin.list_sync();
};
]]></script>

<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="760" height="410" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts_Mst">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_TrdSsp">
			<property activebind="true"></property>
			<bindinfo>
				<column col="DELIST_DD" ctrl="edt_DelistDd" param="text" readonly="False"></column>
				<column col="GRND_REGUL_NM" ctrl="txb_GrndRegulNm" param="value" readonly="False"></column>
				<column col="REMK" ctrl="txa_Remk" param="text" readonly="False"></column>
				<column col="DELIST_RSN_DSC" ctrl="txb_Rsn_Cd" param="value" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_Isu_before">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu_Temp">
			<property usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_DupIsu">
			<property syncload="True"></property>
		</mxdataset>
	</model>
	<components>
		<panel id="panel_3" left="7" top="7" width="743" height="363" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="20" top="10" width="95" height="20" text="1. 상장폐지종목">
				<extproperty font-size="12"></extproperty>
			</label>
			<mxgrid id="MxGrid_2" class="Grid_01" left="120" top="10" width="611" height="153">
				<property borderstyle="0" editable="False" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="ISUR_CD" width="120" show="False" name="BZ_PROCS_NO" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_CD" width="100" name="종목코드" align="center" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column width="89" name="증권구분" id="SECUGRP_ID_NM" align="center"></column>
					<column headbgcolor="#598fd5" headcolor="#FFFFFF" name="상장신청인" width="100" id="ISUR_NM" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" edit="none"></column>
					<column id="ISU_NM" width="149" name="종목명" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="LSTTRD_DD" width="77" name="최종거래일" edit="none" mask="XXXX-XX-XX"></column>
					<column width="102" id="BZ_PROCS_NO" name="업무처리번호"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Isu_Temp"></ref>
			</mxgrid>
			<label id="label_1" class="TopCondition_01" left="20" top="170" width="95" height="20" text="2. 상장폐지일">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_12" class="TopCondition_01" left="10" top="170" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<image id="img_DelistDd" left="195" top="170" width="21" height="20" src="../img/icn_calendar.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_5" class="TopCondition_01" left="10" top="195" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_11" class="TopCondition_01" left="20" top="195" width="95" height="20" text="3. 상장폐지사유">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<mxmaskedit id="edt_DelistDd" class="panel_maskedit_write_01" left="120" top="170" width="70" height="18">
				<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
				<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<textbox id="txb_Rsn_Cd" class="TopCondition_01_write" left="120" top="195" width="613" height="20" readonly="readonly" maxlength="1000">
				<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="120" top="245" width="611" height="108">
				<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<textbox id="txb_GrndRegulNm" class="TopCondition_01_write" left="120" top="220" width="613" height="20" readonly="readonly" maxlength="1000">
				<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<label id="label_3" class="TopCondition_01" left="10" top="220" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_7" class="TopCondition_01" left="20" top="245" width="95" height="20" text="5. 기타">
				<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_6" class="TopCondition_01" left="20" top="220" width="95" height="20" text="4. 근거규정">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
		</panel>
		<image id="btn_Close" left="693" top="378" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="598" top="378" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="488" top="378" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="543" top="378" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Save" left="433" top="378" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common_digital.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF70034_n2.gfm";
	var Isur_cd = "", Isur_nm = "", Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" ,  gubun = "" , select_gubun = "", dscYn = "";
	var trsCnt = 0, trsTotalCnt = 0, trsErrCnt = 0; 
	var selectedGrdNum = 0;
	
	var trsIdx ;  // insert, update 구분
	 	
	var listBzTpCd = "794"; // 디지털증권 상장폐지 
	var fn_GetPar , fn_SetPar ;
	
	function fn_new_onload() {
		/* useupdate를 false로 지정함. */
		var url = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DIGITAL_DELLIST_MST_INOUT";
		url += "&SCREN_ID=" + vScrenID;
		url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
		
		//dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DELLIST_MST_INOUT";
		dts_Mst.DataID = encodeURI(url);
		dts_Mst.reset();
		
		dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DIGITAL_CODE_OUT";
		dts_Isu.reset();
		dts_Isu.AddRow();
		
		dts_Isu_Temp.DataID = "/digital/DigitalListinvstg.do?method=selectDigitalDelist&DIV_IDX="+DIV_IDX_DIGITAL_DELLIST_DTL+ "&TRS_IDX="+TRS_IDX_NEWSEL + "&GUBUN_CD=" + cGetToday("yyyymmdd") ;
		dts_Isu_Temp.reset();
	}

	function fn_CheckForm() {
		if( dts_Isu_Temp.CountRow == 0 ) {
			//alert("[상장폐지종목]을 선택하세요."); return false;
			alert("[상장폐지종목] 만기에 의한 상장폐지 종목이 존재하지 않습니다."); return false;
		}
		
		if( ! checkDdTm ( "DD" , edt_DelistDd   , "상장폐지" , false)  ) return false ; 
		
		if( ! checkEmptyValue( txb_GrndRegulNm , "근거규정" ) ) return false ;
		if( ! checkMaxLength( txb_GrndRegulNm , 200 , "근거규정" ) ) return false ;
		if( ! checkMaxLength( txa_Remk , 2000 , "기타" ) ) return false ;

		return true;
	}
	
	function fn_dupCheck(pUpdate){
		var delistDate = getObjectValue(edt_DelistDd);		
		var isNotDup = true;
		
		for(var i = 1, j = dts_Isu_Temp.CountRow; i <= j; i++){
			var isuCd = dts_Isu_Temp.NameValue(i, "ISU_CD"); 
			var bzProcsNo = dts_Isu_Temp.NameValue(i, "BZ_PROCS_NO"); 
			var url = "/digital/DigitalListinvstg.do?method=searchDigitalDupDelist" + 
			   "&ISU_CD="+isuCd + "&DELIST_DD=" + delistDate;
			if(pUpdate) url += "&BZ_PROCS_NO=" + bzProcsNo;		 
			dts_DupIsu.DataID = encodeURI(url);
			dts_DupIsu.reset();
			var dupIsuCd = dts_DupIsu.NameValue(1, "ISU_CD"); 
			if(dts_DupIsu.CountRow > 0) {
				isNotDup = false;
				alert("동일한 날짜에 상장폐지된 종목["+dupIsuCd+"]이 존재합니다.");
				return false;
			}
		}

		return isNotDup;
	}
	
	function fn_copy_dts(index) {
		//dts_Isu.Reset();
		if(dts_Isu.CountRow == 0) {
			dts_Isu.AddRow();
		}
		dts_Isu.NameValue(1, "BZ_PROCS_NO") = fr_bz_procs_no;
		dts_Isu.NameValue(1, "ISU_CD") = dts_Isu_Temp.NameString(index, "ISU_CD");
		dts_Isu.NameValue(1, "ISU_NM") = dts_Isu_Temp.NameString(index, "ISU_NM");
		dts_Isu.NameValue(1, "ISUR_CD") = dts_Isu_Temp.NameString(index, "ISUR_CD");
		dts_Isu.NameValue(1, "ISUR_NM") = dts_Isu_Temp.NameString(index, "ISUR_NM");
		dts_Isu.NameValue(1, "COM_NM") = dts_Isu_Temp.NameString(index, "COM_NM");
		dts_Isu.NameValue(1, "LSTTRD_DD") = dts_Isu_Temp.NameString(index, "LSTTRD_DD");
		dts_Isu.NameValue(1, "EXP_DD") = dts_Isu_Temp.NameString(index, "EXP_DD");

		Isur_cd = dts_Isu_Temp.NameString(index, "ISUR_CD");
		Isur_nm = dts_Isu_Temp.NameString(index, "COM_NM");
	}
	
	function fn_save_trs() {

		// 종목별 처리를 위해 매번 업무처리 번호를 세팅함
		dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO") = fr_bz_procs_no;
		dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = "99999";
		
		
		// ELW는 항상  종목별기준으로 처리함
		// 1 : 종목별 , 2 : 법인별
		dts_Mst.NameString(dts_Mst.RowPosition, "MKTACT_APPL_OBJ_TP_CD") =  "1" ;
		
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if         ( trsIdx == TRS_IDX_INSERT )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( trsIdx == TRS_IDX_DELETE )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
			
		trs.Action 	     =fn_encodeNSession( "/digital/DigitalListinvstg.do?method=saveDigitalDelist&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD);
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_Isu)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=2" +
								",LIST_BZ_TP_CD=" + listBzTpCd + 
								",DIV_IDX[0]=" + DIV_IDX_DIGITAL_DELLIST_MST+
								",DIV_IDX[1]=" + DIV_IDX_DIGITAL_DELLIST_DTL ;
								
		trs.Post();
	}
	
	function fn_save() {
		
		if (fn_CheckForm() && fn_dupCheck()) {
			if (! fn_isProcess('I') )  return ;
			
			trsTotalCnt = dts_Isu_Temp.CountRow;
			trsCnt = 0;
			trsErrCnt = 0;
		
			for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {
				fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );
				
				fn_copy_dts(i);

				if (fr_bz_procs_no.length != 14) {
					alert(getMessageParam("MSG-0010", ""));
				} else {
					trsIdx = TRS_IDX_INSERT ;

					dts_Isu_Temp.NameString(i, "STATUS") = "N" ;
					trsCnt++;
					
					fn_save_trs();
				}
			}
		}
	}
	
   function fn_update() {
		if (fn_CheckForm() && fn_dupCheck(true)) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			
			trsTotalCnt = dts_Isu_Temp.CountRow;
			trsCnt = 0;
			trsErrCnt = 0;		
			
			for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {
				fr_bz_procs_no = dts_Isu_Temp.NameString(i, "BZ_PROCS_NO");
				//alert('fr_bz_procs_no : ' + fr_bz_procs_no);
				
				fn_copy_dts(i);
				
				dts_Isu_Temp.NameString(i, "STATUS") = "N" ;
				trsCnt++;
				
				fn_save_trs();
			}
		}	
	}

	function fn_delete() {
		// 공시 체크
		if (! fn_check_delete_discls(dts_BzProcsNo, fr_bz_procs_no) )  return;	

		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
			
		trsTotalCnt = dts_Isu_Temp.CountRow;
		trsCnt = 0;
		trsErrCnt = 0;		
		
		for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {			
			fr_bz_procs_no = dts_Isu_Temp.NameString(i, "BZ_PROCS_NO");
			//alert('fr_bz_procs_no : ' + fr_bz_procs_no);
			
			fn_copy_dts(i);
			
			dts_Isu_Temp.NameString(i, "STATUS") = "N" ;
			trsCnt++;
			
			fn_save_trs();
		}
	}
	/********************************************** 
	* 함수명 : fn_checkModifyDts()
	* 설명    : 안내문작성 시, 수정사항 체크
	***********************************************/
	function fn_checkModifyDts() {
		var rtn = false;
		
		if(dts_Mst.IsUpdated == false) {
			rtn = true;
		} else {
			alert("변경된 내용이 있습니다. [수정] 후 진행하세요.");
			rtn = false;
		}
		return rtn;		
	}
	
	function fn_dscl() {
		if(selectedGrdNum == 0) {
			alert('종목을 선택해 주세요! ' );	
			return;
		}
		
		if (fn_checkModifyDts() == false){
			return;
		}
		
		//alert('selectedGrdNum :: '+ selectedGrdNum );	
		fn_copy_dts(selectedGrdNum);
	
		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;

		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2) {
			arr[0] = "69544";			
			arr[1] = fr_bz_procs_no;
			arr[2] = Isur_cd ;
			arr[3] = '1' ;
			//arr[4]; //ctnt
			arr[5] = dts_Isu_Temp.NameValue(selectedGrdNum, "ISU_NM"); 
			//arr[5] = fn_GetAddTitle(dts_Mst.NameValue(dts_Mst.RowPosition, "COM_NM")); //add  title
			
			CopyDataSet( dts_Isu , param_dts_isu) ;
			CopyDataSet( dts_Mst , param_dts_mst) ;
			
			param_dts_mst.NameString(param_dts_mst.RowPosition, "DELIST_RSN_NM") = dts_Mst.NameString(dts_Mst.RowPosition, "DELIST_RSN_DSC")   ;
			param_dts_mst.NameString(param_dts_mst.RowPosition, "ISU_NM") = dts_Isu.NameValue(dts_Isu.RowPosition, "ISU_NM") ;
			
			return arr.length;
		}
		
		fn_SetPar = function(arr) { }
	
		var wth = 730 + 15;
		var hgt = 785 + 40;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}
	function fn_drft() { }
	function fn_makt() { }
	
	function fn_parentRefresh() {
		var fr_fn_list_sync = frame.Provider("../").fn_search2;
		fr_fn_list_sync();
	}

	function fn_SelectGridRow(row) {
		selectedGrdNum = row;
		Isur_cd = dts_Isu_Temp.NameString(row, "ISUR_CD");
		fr_bz_procs_no = dts_Isu_Temp.NameValue(row, "BZ_PROCS_NO"); 
	}
	/********************************************** 
	* 함수명 : dateForm()
	* 설명    : 년월일 포맷 맞춤 (안내문 작성에서 사용)
	***********************************************/
	function dateForm(pStr) {
		var str = "";
		if (pStr == "") {
			str = "★★년" + "★★월" + "★★일";
		} else {
			str = pStr.substring(2,4) + "년 " + pStr.substring(4, 6) + "월 " + pStr.substring(6, 8) +"일";
		}
		return str;
	}
]]></script>
	
		<events><event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
		<event for="img_DelistDd" eventname="onclick"><![CDATA[
	
	edt_DelistDd.focus()
	popUpCalendar2(edt_DelistDd);
]]></event>
		<event for="trs" eventname="OnFail()"><![CDATA[
	dts_Isu_Temp.NameString(trsCnt, "STATUS") = "N" ;
	trsErrCnt++;
	
	if(trsCnt == trsTotalCnt && trsErrCnt > 0){
		fn_alertMsg('F') ; 
		if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
			for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {	
				if(dts_Isu_Temp.NameString(i, "STATUS") == "Y" ){
					dts_Isu_Temp.DeleteRow( i );
				}
			}
		} else{
			
		}
	}
]]></event>
		<event for="trs" eventname="OnSuccess()"><![CDATA[
	dts_Isu_Temp.NameString(trsCnt, "BZ_PROCS_NO") = fr_bz_procs_no;
	dts_Isu_Temp.NameString(trsCnt, "STATUS") = "Y" ;
		
	if(trsCnt == trsTotalCnt){
		fn_alertMsg('S') ;

		fn_parentRefresh(); // 목록 다시 조회

		if(dts_Isu_Temp.CountRow == 1){
			fn_SelectGridRow(1);
		}
		
		if (buttonSet.status == "I") { // 저장처리의 응답인 경우
			buttonSet.setUpdateStatus();
			//fn_SetIsuCdBtnShow(1);
		} else if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
			frame.CloseFrame();
		} else {
			//fn_search();
		}
		selectedGrdNum = 0;
		dts_Isu_Temp.RowPosition = 0;
	}
]]></event>
		<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>
		<event for="dts_Isu_Temp" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu_Temp);
]]></event>
		<event for="dts_Isu" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	dts_Isu.AddRow();
]]></event>
		<event for="dts_Isu_Temp" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if(rowcount > 0) {
	//Isur_cd = dts_Isu.NameString(dts_Isu.RowPosition, "ISUR_CD");
		if (fr_bz_procs_no == "") {
			setObjectValue(edt_DelistDd, cGetPlusDate2(dts_Isu_Temp.NameString(dts_Isu_Temp.RowPosition, "LSTTRD_DD"),1));
			setObjectValue(txa_Remk,"최종거래일 "+dateForm(dts_Isu_Temp.NameString(dts_Isu_Temp.RowPosition, "LSTTRD_DD")));
		
		}
	}
]]></event>
		<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (fr_bz_procs_no == "") {
		dts_Mst.AddRow();
	}
			
	// 신규처리에 의한 조회인지,  수정에 의한 조회인지를 구별
	if (fr_bz_procs_no == "") {
		buttonSet.setInsertStatus();
	} else {
		setButtonSetWithDate( edt_DelistDd , false ) ;
		setButtonSetWithDate2( dscYn ) ;
		
	}

	if (fr_bz_procs_no == "") {
		dts_Mst.NameString(dts_Mst.RowPosition, "DELIST_RSN_CD")  = "730002" ;
		//dts_Mst.NameString(dts_Mst.RowPosition, "DELIST_RSN_DSC") = "상장지수증권 최종거래일 도래";
		dts_Mst.NameString(dts_Mst.RowPosition, "DELIST_RSN_DSC") = "신종증권 최종거래일 도래";		
		dts_Mst.NameString(dts_Mst.RowPosition, "GRND_REGUL_NM") = "신종증권시장운영규정 제00조 제00호";

		
	}
]]></event>
		<event for="edt_DelistDd" eventname="OnKillFocus()"><![CDATA[
	//fn_setRemk();
]]></event>
		<event for="MxGrid_2" eventname="OnClick(row, colid)"><![CDATA[
	fn_SelectGridRow(row);
]]></event>
		<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar; // Provider화면에서 fn_GetPar명칭으로 선언된 함수를 획득
	var arrPar = new Array;
	
	if (fnc != undefined) {
		fnc(arrPar); // Provider화면의 callback함수를 호출하여 필요한 인수를 넘겨받는다.
		Isur_cd 		        = (arrPar.length >= 1 ? arrPar[0] : "");	// 발행기관코드
		Isur_nm 		        = (arrPar.length >= 2 ? arrPar[1] : "");	// 발행기관명
		Secugrp_id 		= (arrPar.length >= 3 ? arrPar[2] : "");	// 증권그룹ID
		Mkt_id	    	    = (arrPar.length >= 4 ? arrPar[3] : "");	// 시장구분코드
		fr_bz_procs_no 	= (arrPar.length >= 5 ? arrPar[4] : "");	// 업무처리번호(수정시만 유효)
		gubun   		        = (arrPar.length >= 6 ? arrPar[5] : "");	// 발행사/기초자산 구분값
		select_gubun		= (arrPar.length >= 7 ? arrPar[6] : "");	//  구분값
		dscYn				= (arrPar.length >= 8 ? arrPar[7] : "");	//  공시여부
	}
		
	//alert( "Isur_cd =  " +Isur_cd + "\n"  + " Isur_nm = " + Isur_nm + "\n" + "  Secugrp_id = " + Secugrp_id + "\n" + 
	//		 "Mkt_id =  " +Mkt_id + "\n" + " fr_bz_procs_no = " + fr_bz_procs_no+ "\n"  ) ;
			
	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성

//	fn_SetIsuCdBtnShow(select_gubun);
	fn_new_onload();    // 신규작성시 호출
	
	PanelToGroupBox(panel_3);
	
]]></event></events>
</gform>

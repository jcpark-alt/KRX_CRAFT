		btn_ReTrSend.src = "../img/btn_ReCls_d.gif";
		btn_ReTrSend.disabled = true;
		showObj(btn_ReTrSend, true);
	}
	else{
		showObj(btn_ReTrSend, false);
	}

	var vCurDate = cGetToday("yyyymmdd");
	//edt_TASK_DD.text = cGetMinusDate2(vCurDate, 1); 	// 일년 날짜
	setObjectValue(edt_TASK_DD, vCurDate);
	
	MaxTab_01.ActiveIndex = 1;
	PanelToGroupBox(panel_Top);

	fn_list_sync();
	fn_btnDisable();
]]></event></events>

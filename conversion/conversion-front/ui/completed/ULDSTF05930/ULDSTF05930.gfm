<event for="MaxTab_01" eventname="OnSelChanged(nIndex)"><![CDATA[
	fn_list_sync();
	
	if (MaxTab_01.ActiveIndex == 1) {
		showObj(txb_NEW_SNDRCV_DATA_CORR_YN, false);
		showObj(txb_ADD_SNDRCV_DATA_CORR_YN, false);
		showObj(txb_APPROV_EMP_NM, false);
		showObj(txb_APPROV_TM, false);
		//팀장확인_20100625
		showObj(txb_TEAMLEADR_EMP_NM, false);
		showObj(txb_TEAMLEADR_TM, false);
		showObj(lb_TEAMLEADR_EMP_NM, false);
		showObj(lb_TEAMLEADR_TM, false);
		
		showObj(lb_NEW_SNDRCV_DATA_CORR_YN, false);
		showObj(lb_ADD_SNDRCV_DATA_CORR_YN, false);
		showObj(lb_APPROV_EMP_NM, false);
		showObj(lb_APPROV_TM, false);
		
	} else if (MaxTab_01.ActiveIndex == 2) {
		showObj(txb_NEW_SNDRCV_DATA_CORR_YN, true);
		showObj(txb_ADD_SNDRCV_DATA_CORR_YN, true);
		showObj(txb_APPROV_EMP_NM, true);
		showObj(txb_APPROV_TM, true);
		//팀장확인_20100625
		showObj(txb_TEAMLEADR_EMP_NM, true);
		showObj(txb_TEAMLEADR_TM, true);
		showObj(lb_TEAMLEADR_EMP_NM, true);
		showObj(lb_TEAMLEADR_TM, true);
		
		showObj(lb_NEW_SNDRCV_DATA_CORR_YN, true);
		showObj(lb_ADD_SNDRCV_DATA_CORR_YN, true);
		showObj(lb_APPROV_EMP_NM, true);
		showObj(lb_APPROV_TM, true);
		
		//팀장승인 disable
		fn_btnDisable();
	}
	
]]></event>

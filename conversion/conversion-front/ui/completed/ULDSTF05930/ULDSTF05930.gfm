<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js"); // showObj(ObjID, flag) SetWindowPos(ObjID, nTop, nLeft, nWidth, nHeight)
	#include("../js/utils.js");
	#include("../js/list_common.js");
	#include("../js/common.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/PopupCalendar.js");
	#include("../js/elw_recv_common.js");

	var vScrenID = "ULDSTF05930.gfm";
	var procJob = "";
	var vViewCorrYnTyp = '3'; //마감송수신 
	var pMngId = js_id;
	var pJobTitl = js_jobtitl;      //권한

	function fn_setButton() {
		if (dts_Item.NameString(1, "BZ_CLS_TM") != "") {
			btn_TrSend.src = "../img/btn_ClsPrc_d.gif";
			btn_TrSend.disabled = true;
			
			showObj(btn_ReTrSend, false);
		} else {
			btn_TrSend.src = "../img/btn_ClsPrc.gif";
			btn_TrSend.disabled = false;
			
			showObj(btn_ReTrSend, false);
		}
		
		//재마감 처리 버튼 - 시스템 관리자 
		if(js_dep_cd == 'ZSYS' ){
			btn_ReTrSend.src = "../img/btn_ReCls.gif";
			btn_ReTrSend.disabled = false;
			showObj(btn_ReTrSend, true);
		}
	}


	function fn_setSndRcvCorrYn(dtsObj) {
		var corrYn = '-';
		if (getObjectValue(txb_RCV_TM) != "") {
			//alert('txb_RCV_TM:'+getObjectValue(txb_RCV_TM));
			//alert('tdtsObj.CountRow:'+dtsObj.CountRow);
			for (var i = 1; i <= dtsObj.CountRow; i++) {
				if (dtsObj.NameString(i, "SNDRCV_DATA_CORR_YN") != "O") {
					corrYn = 'X';
					break;
				}
				corrYn = 'O';
			}
		}
		//alert('corrYn:'+corrYn);
		return  corrYn;
	}

	function fn_list_sync() {
		var urltaskdd = "&TASK_DD=" + getObjectValue(edt_TASK_DD);
		
		var url;
		url = "/ElwListedReceive.do?method=getElwListingListDd&inputMessageId=ELW_LISTING_TR_SEND_LOG_INOUT";
		url += urltaskdd;
		dts_Get_ListDD.DataID = encodeURI(url);
		dts_Get_ListDD.Reset();
		
		url = "/ElwListedReceive.do?method=listElwListingTrSendLog&inputMessageId=ELW_LISTING_TR_SEND_LOG_INOUT";
		url += urltaskdd;
		dts_Item.DataID = encodeURI(url);
		dts_Item.Reset();
		
		fn_setButton();

		var urllistdd = "&LIST_DD=" + getObjectValue(edt_LIST_DD);
		//alert('[urllistdd]'+urllistdd);
		if (MaxTab_01.ActiveIndex == 1) {
			//alert("vListMdCd :"+vListMdCd);
			
			/*
			var url_new;
			url_new = "/ElwListedReceive.do?method=listElwNewListingTrSend&inputMessageId=ELW_NEWLISTING_TR_SEND_INOUT";
			url_new += urllistdd;
			*/

			var url_new = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=ELW_NEWLISTING_TR_SEND_INOUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.lstproc.lstrcv.select.elw.newlisting.trsend.condition.rv"+
			 "&{P}param01=" + getObjectValue(edt_LIST_DD);
			url_new += "&SCREN_ID=" + vScrenID;
			url_new += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
		
			dts_New_Proc.DataID = encodeURI(url_new);
			dts_New_Proc.Reset();
			ShowWin(grd_New_Proc); 


			/*
			var url_add;
			url_add = "/ElwListedReceive.do?method=listElwAddListingTrSend&inputMessageId=ELW_ADDLISTING_TR_SEND_INOUT";
			url_add += urllistdd;
			*/
			
			var url_add = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=ELW_ADDLISTING_TR_SEND_INOUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.lstproc.lstrcv.select.elw.addlisting.trsend.condition.rv"+
			 "&{P}param01=" + getObjectValue(edt_LIST_DD);
			url_add += "&SCREN_ID=" + vScrenID;
			url_add += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_Add_Proc.DataID = encodeURI(url_add);
			dts_Add_Proc.Reset();
			ShowWin(grd_Add_Proc); 

		} else if (MaxTab_01.ActiveIndex == 2) {
			/*
			var url_new;
			url_new = "/ElwListedReceive.do?method=listElwNewListingTrSendSearch&inputMessageId=ELW_NEWLISTING_TR_SEND_INOUT";
			url_new += urllistdd;
			*/
			var url_new = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=ELW_NEWLISTING_TR_SEND_INOUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.lstproc.lstrcv.select.elw.newlisting.trsend.search.condition.rv"+
			 "&{P}param01=" + getObjectValue(edt_LIST_DD);
			url_new += "&SCREN_ID=" + vScrenID;
			url_new += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_New_Search.DataID = encodeURI(url_new);
			dts_New_Search.Reset();
			ShowWin(grd_New_Search); 

			/*
			var url_add;
			url_add = "/ElwListedReceive.do?method=listElwAddListingTrSendSearch&inputMessageId=ELW_ADDLISTING_TR_SEND_INOUT";
			url_add += urllistdd;
			*/
			
			var url_add = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=ELW_ADDLISTING_TR_SEND_INOUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.lstproc.lstrcv.select.elw.addlisting.trsend.search.condition.rv"+
			 "&{P}param01=" + getObjectValue(edt_LIST_DD);
			url_add += "&SCREN_ID=" + vScrenID;
			url_add += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_Add_Search.DataID = encodeURI(url_add);
			dts_Add_Search.Reset();
			ShowWin(grd_Add_Search); 
			
		}
	}

	function fn_sndRcvCorrYn(obj, dtsObj) {
	
		/*
		var url = "/ElwListedReceive.do?method=listElwNewListingTrSndRcvCorrYn&inputMessageId=ELW_NEWLISTING_TR_SEND_INOUT";
		url += "&TASK_DD=" + getObjectValue(edt_TASK_DD);
		url += "&ISU_CD=" + dtsObj.NameString(eval(obj), "ISU_CD");
		*/

		var url = "/listingCommon.do?method=listGeneral" +
		 "&outputMessageId=ELW_NEWLISTING_TR_SEND_INOUT" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.lstproc.lstrcv.select.elw.newlisting.trsend.sndrcvcorryn.condition.rv"+
		 "&{P}param01=" + getObjectValue(edt_TASK_DD) +
		 "&{P}param02=" + dtsObj.NameString(eval(obj), "ISU_CD") +
		 "&{P}param03=" + getObjectValue(edt_TASK_DD) +
		 "&{P}param04=" + dtsObj.NameString(eval(obj), "ISU_CD");

		dts_CorrYn.DataID = encodeURI(url);
		dts_CorrYn.Reset();
		
		//alert('dts_CorrYn'+dts_CorrYn.Text);
		//fn_OpenCorrYn();
		frame.CreateDialogFrame("DLG_ELWCORRYN","/lstproc/ULDSTF05903_RV.gfm", "ELW 일치여부확인", 100, 10, 665, 800, "window");
	}

	
	/**
	* 종목 삭제여부체크
	*/
	function fn_isuDelCheck() {
		var isTrue = false;
		
		/*
		var url;
		url = "/ElwListedReceive.do?method=readElwDeleteCheck&inputMessageId=ELW_LISTING_ISU_DEL_CHK_OUT";
		url += "&LIST_DD=" + getObjectValue(edt_LIST_DD);
		*/

		var url = "/listingCommon.do?method=listGeneral" +
		 "&outputMessageId=ELW_LISTING_ISU_DEL_CHK_OUT" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.lstproc.lstrcv.select.elw.delete.check.condition.rv"+
		 "&{P}param01=" + getObjectValue(edt_LIST_DD)

		
		dts_IsuDelChk.DataID = encodeURI(url);
		dts_IsuDelChk.Reset();

		//alert('dts_IsuDelChk.CountRow'+dts_IsuDelChk.CountRow);
		if (dts_IsuDelChk.CountRow > 0) {
			var msg = " 마감처리종목중 종목코드가 삭제된 종목이 있어 마감처리를 하실 수 없습니다.\n 시스템담당자에게 연락바랍니다." +
							"\n " +
							"\n 코드 삭제종목";
            for (var i = 0, k=1; i < dts_IsuDelChk.CountRow; i++, k++) {
                msg += "\n 종목코드 = [" +dts_IsuDelChk.NameString(k, "ISU_CD")  + "], 종목명 = " + dts_IsuDelChk.NameString(k, "ISU_NM");
            }
			alert(msg);
			isTrue = false;
		} else {
			isTrue = true;
		}
		return isTrue;
	}

	function fn_checkProcDt(str) {
		var vCurDate = cGetToday("yyyymmdd");
		var pCheck = true;
		
		if (getObjectValue(edt_TASK_DD) != vCurDate) {
			alert("[마감일]이 현재일경우만 '"+str+"'를 할수 있습니다.");
			pCheck = false;
		} 
		
		if(pCheck){
			for ( var i=1; i<=dts_New_Proc.CountRow; i++ ) 
			{
				if ( dts_New_Proc.NameValue(i,"ELW_ISU_MKTPARTC_NM") == "" ) 
				{
					alert("발행회사명에 대한 시장참가자번호가 없는 종목이 있습니다. 시스템관리자에게 문의바랍니다.");
					pCheck = false;
					break;
				} 
				
				if ( dts_New_Proc.NameString(i,"ISU_SHRS") <= 0 )
				{
					alert("LP보유량이 '0'인 종목이 있습니다. 확인하여주십시오.");
					pCheck = false;
					break;
				}
			} 
		}
		
		return pCheck;
	}
	
	function fn_UnRcvIsuCheck() {
		var url = "/listingCommon.do?method=listGeneral" +
		 "&outputMessageId=ELW_LISTING_PROC_INOUT" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.lstproc.lstrcv.select.elw.newlisting.trsend.precondition"+
		 "&{P}param01=" + getObjectValue(edt_LIST_DD);

        dts_UnRcvIsuChk.DataID = encodeURI(url);
		dts_UnRcvIsuChk.Reset();

        if (dts_UnRcvIsuChk.CountRow > 0) {
			var msg = "미처리 종목이 있습니다" ;
            for (var i = 0, k=1; i < dts_UnRcvIsuChk.CountRow; i++, k++) {
                msg +=  "\n - 종목명 : " + dts_UnRcvIsuChk.NameString(k, "ISU_KOR_ABBRV");
				msg +=  " [사유] " + dts_UnRcvIsuChk.NameString(k, "LIST_PROCS_STAT_NM");
            }
			msg+= "\n\n 마감처리 하시겠습니까?" ;

			return confirm(msg) ;
		}
	}
	function fn_trsend() {
		procJob = '마감처리';
		
		if (! fn_checkProcDt(procJob))  return;

        if (getObjectValue(edt_LIST_DD) == "") {
			alert("[상장일]이 없습니다.");edt_LIST_DD.focus();return;
		}
		if (! fn_isuDelCheck()) return;
		
		dts_Item.AddRow();
		dts_Item.NameString(1, "LIST_DD") = getObjectValue(edt_LIST_DD);
		dts_Item.NameString(1, "CHRG_EMP_NO") = js_emp_no;
		dts_Item.NameString(1, "CLS_TYPE") = "TR"; //이번트를 발생시키키위해 가비지 데이터를 넣어준다.
		//alert('dts_Item'+dts_Item.text)
		
		var res =  fn_UnRcvIsuCheck();
		
		if(res == null){
			 res = window.confirm(getMessageParam('MSG-A006', procJob));
		}
		if (res) {
				trs_Save.Action=fn_encodeNSession("/ElwListedReceive.do?method=clsElwListingRV&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +SCREN_PROCS_TP_CD_03);
				trs_Save.KeyName="toinb_dataid4";
				trs_Save.KeyValue="JSP(I:pInput=dts_Item)";
				trs_Save.Post();
        	}
	}
	
	function fn_re_trsend() {
		procJob = '재마감처리';
		if (! fn_checkProcDt(procJob))  return;

		dts_Item.NameString(1, "CLS_TYPE") = "RETR"; //이번트를 발생시키키위해 가비지 데이터를 넣어준다.
		//alert('dts_Item'+dts_Item.text)
		

		var msg = " 재마감처리를 선택하셨습니다. \n" +
            " 재마감처리는 이전 마감처리기록을 삭제하므로 \n" +
            " 재마감처리후 다시 마감처리를 하셔아 됩니다. \n" +
            " \n" +
            " 재마감처리 하시겠습니까?";		
			
		var res = window.confirm(msg);
		if (res) {
			trs_Save.Action=fn_encodeNSession("/ElwListedReceive.do?method=reClsElwListing&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +SCREN_PROCS_TP_CD_04);
			trs_Save.KeyName="toinb_dataid4";
			trs_Save.KeyValue="JSP(I:pInput=dts_Item)";
			trs_Save.Post();
		}
	}

	function fn_rcvApprove() {
		procJob = '담당자확인';
		if (! fn_checkProcDt(procJob))  return;
		
		if (getObjectValue(txb_RCV_TM) == "") {
			alert("[파일수신시각] 정보가 없어 처리할수 없습니다.\n(파일수신전 상태임)");return;
		}
		
		if (getObjectValue(txb_APPROV_EMP_NM) != "") {
			alert("이미 [담당자확인] 처리되었습니다.");return;
		}
		dts_Item.NameString(1, "APPROV_EMP_NO") = js_emp_no;
		dts_Item.NameString(1, "APPROV_TYPE") = "1";
		//alert('dts_Item'+dts_Item.text)
		

		var res = window.confirm(getMessageParam('MSG-A006', procJob));
		if (res) {
			trs_Save.Action=fn_encodeNSession("/ElwListedReceive.do?method=rcvApprovElwListing&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +SCREN_PROCS_TP_CD_03);
			trs_Save.KeyName="toinb_dataid4";
			trs_Save.KeyValue="JSP(I:pInput=dts_Item)";
			trs_Save.Post();
		}	
	}
	
	
	//팀장확인_20100625
	function fn_rcvTeamleadr() {
		procJob = '팀장확인';
				
		if (getObjectValue(txb_APPROV_EMP_NM) == "") {
			alert("[담당자]가 확인하지 않았습니다. 담당자 확인 후 [팀장] 확인 해주십시오.");return;
		}
		
		if (getObjectValue(txb_TEAMLEADR_EMP_NM) != "") {
			alert("이미 [팀장확인] 처리되었습니다.");return;
		}
		dts_Item.NameString(1, "APPROV_TEAMLEADR_EMP_NO") = js_emp_no;
		dts_Item.NameString(1, "APPROV_TYPE") = "2";
		//alert('dts_Item'+dts_Item.text)
		

		var res = window.confirm(getMessageParam('MSG-A006', procJob));
		if (res) {
			trs_Save.Action=fn_encodeNSession("/ElwListedReceive.do?method=rcvApprovElwListing&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +SCREN_PROCS_TP_CD_03);
			trs_Save.KeyName="toinb_dataid4";
			trs_Save.KeyValue="JSP(I:pInput=dts_Item)";
			trs_Save.Post();
		}	
	}
	
	
	//팀장확인 2010.0625
	function fn_btnDisable(){
		if(pJobTitl == "03"){ //담당자
			if (getObjectValue(txb_APPROV_EMP_NM) == "") { //담당자확인을 않했을 경우
				btn_rcvApprove.src  = "../img/btn/btn_revw.gif";
				btn_rcvApprove.disabled = false;
			}else{
				btn_rcvApprove.src  = "../img/btn/btn_revw_d.gif";
				btn_rcvApprove.disabled = true;
			}
			btn_rcvTeamleadr.src = "../img/btn_BosApv_d.gif";
			btn_rcvTeamleadr.disabled = true;
		}
		else{ //팀장
			if (getObjectValue(txb_APPROV_EMP_NM) == "") { //담당자확인을 않했을 경우
				btn_rcvApprove.src  = "../img/btn/btn_revw.gif";
				btn_rcvApprove.disabled = false;
				btn_rcvTeamleadr.src = "../img/btn_BosApv_d.gif";
				btn_rcvTeamleadr.disabled = true;
			}else{
				btn_rcvApprove.src  = "../img/btn/btn_revw_d.gif";
				btn_rcvApprove.disabled = true;
				if(getObjectValue(txb_TEAMLEADR_EMP_NM) == "" ) {
					btn_rcvTeamleadr.src = "../img/btn_BosApv.gif";
					btn_rcvTeamleadr.disabled = false;
				}
				else{
					btn_rcvTeamleadr.src = "../img/btn_BosApv_d.gif";
					btn_rcvTeamleadr.disabled = true;
				}
				btn_rcvApprove.src  = "../img/btn/btn_revw_d.gif";
				btn_rcvApprove.disabled = true;			
			}	
		}
	}

	function fn_ExcelDown(){
		if (MaxTab_01.ActiveIndex == 1) {
			grd_New_Proc.GridToExcel("신규상장 마감처리목록", "", "8");
			grd_Add_Proc.GridToExcel("추가상장 송신목록", "", "8");
		} else if (MaxTab_01.ActiveIndex == 2) {
			grd_New_Search.GridToExcel("신규상장 마감처리목록", "", "8");
			grd_Add_Search.GridToExcel("추가상장 송신목록", "", "8");
		}
	}
	
]]></script>


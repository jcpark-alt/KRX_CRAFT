<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="705" height="410" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts_Mst">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="MKTACT_ENFORCE_DD" ctrl="edt_MktactEnforceDd" param="text" readonly="False"></column>
				<column col="GRND_REGUL_NM" ctrl="txb_AdmisuDesignGrndRegulNm" param="value" readonly="False"></column>
				<column col="REMK" ctrl="txa_Remk" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_Status">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_ByCorpDepCd">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_BZ_CHECK">
			<property syncload="True"></property>
		</mxdataset>
	</model>
	<components>
		<panel id="panel_3" left="10" top="10" width="685" height="360" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="20" top="10" width="125" height="20" text="1. 관리종목지정 종목">
				<extproperty font-size="12"></extproperty>
			</label>
			<label id="label_11" class="TopCondition_01" left="10" top="175" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_5" class="TopCondition_01" left="20" top="175" width="125" height="20" text="3. 지정사유">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="150" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="20" top="150" width="125" height="20" text="2. 관리종목지정일">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_6" class="TopCondition_01" left="20" top="265" width="125" height="20" text="4. 근거규정">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_12" class="TopCondition_01" left="10" top="265" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_7" class="TopCondition_01" left="20" top="290" width="125" height="20" text="5. 기타">
				<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<image id="img_MktactEnforceDd" left="225" top="150" width="21" height="20" src="../img/icn_calendar.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="btn_rsn_del" left="600" top="205" width="76" height="22" src="../img/btn_rsn_del.gif">
				<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
			</image>
			<image id="btn_rsn_add" left="600" top="175" width="76" height="22" src="../img/btn_rsn_add.gif">
				<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
			</image>
			<textbox id="txb_AdmisuDesignGrndRegulNm" class="TopCondition_01_write" left="150" top="265" width="445" height="20" maxlength="1000">
				<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<mxgrid id="grid_1" class="Grid_01" left="150" top="10" width="525" height="132">
				<property borderstyle="0" editable="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="120" show="False" name="BZ_PROCS_NO" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_CD" width="100" name="종목코드" align="center" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column headbgcolor="#598fd5" headcolor="#FFFFFF" name="발행회사" width="100" id="ISUR_NM" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_NM" width="240" name="종목명" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column name="상장일" width="80" id="LIST_DD" mask="XXXX-XX-XX"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Isu"></ref>
			</mxgrid>
			<mxgrid id="MxGrid_1" class="Grid_01" left="150" top="175" width="443" height="83">
				<property borderstyle="0" editable="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" rowheight="18" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="97" show="False" name="업무처리번호" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_CD" width="70" name="사유코드" align="center" edit="none" listalign="left" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_NM" width="356" name="사유내용" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" color="#343434"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Rsn"></ref>
			</mxgrid>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="150" top="290" width="443" height="60">
				<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<image id="img_SetIsuCd" left="70" top="35" width="75" height="19" src="../img/btn_isu_select.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_MktactEnforceDd" class="panel_maskedit_write_01" left="150" top="150" width="70" height="18">
				<property alignment="1" border="False" datemodify="True" numeric="False" valign="1"></property>
				<extproperty font-size="12" color="#343434" background-color="#FFFFFF" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
		</panel>
		<image id="btn_release" left="10" top="375" width="50" height="22" src="../img/btn_release.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Close" left="640" top="375" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="545" top="375" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Save" left="380" top="375" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="435" top="375" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="490" top="375" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_rsn_change" left="65" top="375" width="78" height="22" src="../img/btn_40.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common_etn.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF08032.gfm";
	var Isu_cd="", Isur_cd = "", Isur_nm = "", Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" , haltTpCd = "" , gubun = "" , tpCd = "" ;

	var isFirstNew = false ;
	var trsIdx ;  // insert, update 구분
	
	var fn_GetPar , fn_SetPar ;
	 
	function fn_search() {
		if (fr_bz_procs_no != "") {
			var url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnAdministrativeIssue" + 
						"&DIV_IDX="+DIV_ETN_IDX_ADMISU_MST + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			dts_Mst.DataID = encodeURI(url);
			dts_Mst.reset();	
			
			//if (gubun == "1") {
			//	dts_Isu.DataID = "/etn/EtnCodeAct.do?method=searchEtnCode&GUBUN=" + gubun + "&ISUR_CD=" + Isu_cd ;
			//	dts_Isu.reset();
			//} else{
			url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnAdministrativeIssue" + 
				   "&DIV_IDX="+DIV_ETN_IDX_ADMISU_ISU_ITM + "&ISUR_CD=" + Isur_cd + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
					 
				dts_Isu.DataID = encodeURI(url);
				dts_Isu.reset();
			//}

			url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnAdministrativeIssue" + 
			      "&DIV_IDX="+DIV_ETN_IDX_ADMISU_RSN_AF + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			 
			dts_Rsn.DataID = encodeURI(url);
			dts_Rsn.reset();
		}
	}
	
	function fn_new_onload() {

		/* useupdate를 false로 지정함. */
		dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ETN_ADMISU_LIST_MST_INOUT";
		dts_Mst.reset();
		
		/* useupdate를 false로 지정함. */
		dts_Rsn.DataID =  "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ADMISU_RSN_INOUT";
		dts_Rsn.reset();
		
		if (gubun == "1") {
			dts_Isu.DataID = "/etn/EtnCodeAct.do?method=searchEtnCode&GUBUN=" + gubun + "&ISUR_CD=" + Isu_cd ;
			dts_Isu.reset();
		} else{
			/* useupdate를 false로 지정함. */
			dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=CODE_ETN_OUT";
			dts_Isu.reset();
		}

	}

	function fn_GetParRsnCd(arrPar) {  			 // 넘길 인수를 지정하는 펑션
		arrPar[0] =  "1" ;
		arrPar[1] = "07" ;
		arrPar[5] = "N"; //기업인수목적 회사 

		return arrPar.length;
	} 
	
	function fn_SetParRsnCd(arrPar) {
		//선택된 사유코드 중복체크
		if( !fn_isNewValueForDataSet( dts_Rsn ,"ADMISU_DESIGN_RSN_CD" , arrPar[0]) ) return ;
		
		dts_Rsn.AddRow();
		dts_Rsn.NameString( dts_Rsn.RowPosition  , "ADMISU_DESIGN_RSN_CD"  )  =  arrPar[0];
		dts_Rsn.NameString( dts_Rsn.RowPosition  , "ADMISU_DESIGN_RSN_NM"  )  =  arrPar[1];
	}
		
	function fn_GetParIsu(arrPar , param_dts) {
		arrPar[0] = Isur_cd;
		arrPar[1] = gubun ;
		
		CopyDataSet( dts_Isu , param_dts) ;
	}
	
	function fn_SetParIsu(param_dts) {
	//alert(dts_Isu.text);
		CopyDataSet( param_dts , dts_Isu) ;
		if(Isur_cd == ""){
			Isur_cd = dts_Isu.NameString(1, "ISUR_CD");
		}
	//alert(dts_Isu.text);
	}
	

	function fn_CheckForm() {
		if( dts_Isu.CountRow == 0 ) {
			alert("[관리지정종목]을 선택하세요."); img_SetIsuCd.focus(); return false;
		}
		
		if( ! checkDdTm ( "DD" , edt_MktactEnforceDd   , "지정", false )  ) return false ; 
		
		if( dts_Rsn.CountRow == 0 ) {
			alert("[지정사유]를 선택하세요."); btn_rsn_add.focus(); return false;
		}

		if( ! checkEmptyValue( txb_AdmisuDesignGrndRegulNm , "근거규정" ) ) return false ;
		if( ! checkMaxLength( txb_AdmisuDesignGrndRegulNm , 200 , "근거규정" ) ) return false ;

		if( ! checkMaxLength( txa_Remk , 2000 , "기타" ) ) return false ;
		if (! fn_check_bz_doubleinput_etn(	dts_BZ_CHECK, 
											Isu_cd,
											getObjectValue(edt_MktactEnforceDd),
											fr_bz_procs_no,
											LIST_BZ_TP_CD_713)) {
			return false;
		}
		
		return true;
	}
	
	function fn_save_trs() {

		//매매거래정지 사유는 매번 업무처리 번호를 세팅함
		//사유별 추가,삭제가 있을수 있기때문
		for (var i = 1 ; i <= dts_Rsn.CountRow ; i++) { 
			dts_Rsn.NameString(i, "CHG_BFAF_TP_CD") = "2"  ; //변경전후구분코드 1:변경전 , 2:변경후  
			dts_Rsn.NameString(i, "BZ_PROCS_NO")     = fr_bz_procs_no ;
			
			dts_Rsn.NameString(i, "ADMISU_DESNRELS_TP_CD")      = "1" ; // 관리종목지정및해제구분코드 1:관리종목 지정 , 2:관리종목 해제
			dts_Rsn.NameString(i, "ADMISU_ADD_DESIGN_RSN_YN") = "N" ; // 관리종목추가지정사유여부
		};
		
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if ( trsIdx == TRS_IDX_INSERT )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( trsIdx == TRS_IDX_DELETE )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
			
		trs.Action 	     = fn_encodeNSession( "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+vScrenProcsTpCD+"&method=saveEtnAdministrativeIssue" ) ;
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_Rsn)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=2" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_713 + 
								",DIV_IDX[0]=" + DIV_ETN_IDX_ADMISU_MST+
								",DIV_IDX[1]=" + DIV_ETN_IDX_ADMISU_RSN_AF;
								
		trs.Post();
	}
	
	function fn_save() {
		
		if (fn_CheckForm()) {
			if( !fn_getMstStatus_etn(dts_Status , tpCd , edt_MktactEnforceDd, Isu_cd) ) return ;
			if (! fn_isProcess('I') )  return ;
			fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );

			if (fr_bz_procs_no.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {
				trsIdx = TRS_IDX_INSERT ;
				dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO")                    = fr_bz_procs_no;
				dts_Mst.NameString(dts_Mst.RowPosition, "ADMISU_DESIGN_BZ_TP_CD")  = tpCd; //관리종목지정업무구분코드
				dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD")                             = Isur_cd;
				dts_Mst.NameString(dts_Mst.RowPosition, "ISU_CD")                               = Isu_cd;
				dts_Mst.NameString(dts_Mst.RowPosition, "ADMISU_DESIGN_BZ_PROCS_NO") = fr_bz_procs_no;

				fn_save_trs();
			}
		}
	}
	
   function fn_update() {
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			fn_save_trs();
		}	
	}

	function fn_delete() {
		if (! fn_check_delete_discls(dts_BZ_CHECK, fr_bz_procs_no) )  return;
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_save_trs();
	}
	
	function fn_release() {
		fn_GetPar = fn_GetParRelease;
		fn_SetPar = undefined ;
		
		frame.CreateDialogFrame("DLG_TRDSUSP_TRM","../etn/ULDSTF08033.gfm",  fn_getSecuGrpNm(Secugrp_id) +  " 관리종목지정 해제", 10, 10, 720, 600, "window");
		frame.CloseFrame();
	}
	
	function fn_GetParRelease(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = Isur_cd; 		// 발행기관코드값
		arrPar[1] = Isur_nm; 	// 발행기관명
		arrPar[2] = Secugrp_id;	// 증권그룹ID	
		arrPar[3] = Mkt_id;		// 시장구분코드
		arrPar[4] = ""; 			// 업무처리번호(신규작성 시 업무처리번호는 없다.)
		arrPar[5] = "4" ; 			// 지정및해제구분코드 , "4" : 해제
		arrPar[6] = Isu_cd ; 		// 종목코드값
		arrPar[7] = "0" ; 			// 선택 구분(1:종목, 2:발행회사, 3:전체)
		arrPar[8] = fr_bz_procs_no; // 지정업무처리번호
		return arrPar.length;
	} 
	
	function fn_rsnChange() {
		fn_GetPar = fn_GetParRsnChange;
		fn_SetPar = undefined ;
		
		frame.CreateDialogFrame("DLG_TRDSUSP_TRM","../etn/ULDSTF08034.gfm",  fn_getSecuGrpNm(Secugrp_id) +  " 관리종목지정 사유변경", 10, 10, 720, 680, "window");
		frame.CloseFrame();
	}
	
	function fn_GetParRsnChange(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = Isur_cd; 		// 발행기관코드값
		arrPar[1] = Isur_nm; 	// 발행기관명
		arrPar[2] = Secugrp_id;	// 증권그룹ID	
		arrPar[3] = Mkt_id;		// 시장구분코드
		arrPar[4] = ""; 			// 업무처리번호(신규작성 시 업무처리번호는 없다.)
		arrPar[5] = "1" ; 			// 지정및해제구분코드 , "1" : 사유변경
		arrPar[6] = Isu_cd ; 		// 종목코드값
		arrPar[7] = "0" ; 			// 선택 구분(1:종목, 2:발행회사, 3:전체)
		arrPar[8] = fr_bz_procs_no; // 지정업무처리번호
		return arrPar.length;
	} 
	
	function fn_dscl() {
	
		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2) {
			arr[0] = "68344";			
			arr[1] = fr_bz_procs_no;
			arr[2] = Isur_cd ;
			arr[3] = '1' ;
			//arr[4]; //ctnt
			arr[5] = dts_Isu.NameValue(dts_Isu.RowPosition, "ISU_NM"); 
			//arr[5] = fn_GetAddTitle(dts_Mst.NameValue(dts_Mst.RowPosition, "COM_NM")); //add  title

			CopyDataSet( dts_Isu , param_dts_isu) ;
			CopyDataSet( dts_Mst , param_dts_mst) ;
			CopyDataSet( dts_Rsn , param_dts2) ;
			param_dts_mst.NameString(param_dts_mst.RowPosition, "COM_NM") = dts_Isu.NameValue(dts_Isu.RowPosition, "COM_NM"); 

			return arr.length;
		}
		
		fn_SetPar = function(arr) { }
	
		var wth = 730 + 15;
		var hgt = 785 + 40;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}
	function fn_drft() { }
	function fn_makt() { }

	function fn_setRemk(){
		txa_Remk.Text = "상기 상장지수증권은 다음 반기말까지 관리종목 지정사유를 해소하지 못할 경우 상장 폐지됨을 알려드립니다.\r\n";
		//txa_Remk.Text += "폐지됨을 알려드립니다.\r\n";
	}
	
	function fn_parentRefresh() {
		var fr_fn_list_sync = frame.Provider("../").fn_search;
		fr_fn_list_sync();
	}

	function fn_SetIsuCdBtnShow(initTyp) {
		if (initTyp == "1" || fr_bz_procs_no != "") {
			img_SetIsuCd.src = "../img/btn_isu_select_d.gif";
			img_SetIsuCd.disabled = true;
		} else {
			img_SetIsuCd.src = "../img/btn_isu_select.gif";
			img_SetIsuCd.disabled = false;
		}
	}
		
	function fn_SetRelAndChgRsnBtnShow() {
		 
		if ( buttonSet.status == "I" || dts_Mst.NameValue(1, "DSC_YN") == "N") {
			btn_rsn_change.src = "../img/btn_40_d.gif";
			btn_release.src = "../img/btn_release_d.gif";
			btn_rsn_change.disabled = true;
			btn_release.disabled = true;
		} else {
			btn_rsn_change.src = "../img/btn_40.gif";
			btn_release.src = "../img/btn_release.gif";
			btn_rsn_change.disabled = false;
			btn_release.disabled = false;
		}
	}
]]></script>
	
		<events><event for="trs" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
	fn_SetRelAndChgRsnBtnShow();
]]></event>
		<event for="trs" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;

	fn_SetRelAndChgRsnBtnShow();
	fn_parentRefresh(); // 목록 다시 조회

	if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
		frame.CloseFrame();
	} else {
		fn_search();
	}	
]]></event>
		<event for="dts_BZ_CHECK" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_BZ_CHECK);
]]></event>
		<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>
		<event for="dts_Rsn" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Rsn);
]]></event>
		<event for="dts_Mst" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Mst);
]]></event>
		<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	// 신규처리에 의한 조회인지,  수정에 의한 조회인지를 구별
	if (fr_bz_procs_no == "") {
		dts_Mst.AddRow();
		
		dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = Isur_cd;			
		dts_Mst.NameString(dts_Mst.RowPosition, "ADMISUTM_ISU_NM") = Isur_nm;			
		txb_AdmisuDesignGrndRegulNm.value = "유가증권시장상장규정 제149조의6제1항"  ;
		
		fn_setRemk();
		
		buttonSet.setInsertStatus();
	} else {
		setButtonSetWithDate( edt_MktactEnforceDd , false ) ;
		setButtonSetWithDate2( dts_Mst.NameValue(1, "DSC_YN") ) ;
	}
	fn_SetRelAndChgRsnBtnShow();
]]></event>
		<event for="dts_Isu" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (fr_bz_procs_no == "") { // 신규일 경우만 수행한다.
		for (var i = 1; i <= dts_Isu.CountRow ; i++) { /* 모든 종목이 선택되지 않은 상태로 한다. */
			dts_Isu.NameString(i, "SELECTED") = "F" ;
		}
	} 
	Isu_cd = dts_Isu.NameString(dts_Isu.RowPosition, "ISU_CD") ;
]]></event>
		<event for="img_SetIsuCd" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsu;
	fn_SetPar = fn_SetParIsu;
	
	fn_PopFindEtnCode() ; 

]]></event>
		<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
		<event for="img_MktactEnforceDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_MktactEnforceDd); 
]]></event>
		<event for="btn_rsn_add" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParRsnCd;
	fn_SetPar = fn_SetParRsnCd;

	fn_PopFindClssLstRsnCd(RSNCD_ADM_DESIGN);
	//fn_PopFindLstRsnCd(RSNCD_SUSP);
]]></event>
		<event for="btn_rsn_del" eventname="onclick"><![CDATA[
	dts_Rsn.DeleteRow( dts_Rsn.RowPosition );
	//fn_SetHaltGrndRegulNm();
]]></event>
		<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar; // Provider화면에서 fn_GetPar명칭으로 선언된 함수를 획득
	var arrPar = new Array;
	
	if (fnc != undefined) {
		fnc(arrPar); // Provider화면의 callback함수를 호출하여 필요한 인수를 넘겨받는다.
		Isur_cd 		        = (arrPar.length >= 1 ? arrPar[0] : "");	// 발행기관코드
		Isur_nm 		        = (arrPar.length >= 2 ? arrPar[1] : "");	// 발행기관명
		Secugrp_id 		= (arrPar.length >= 3 ? arrPar[2] : "");	// 증권그룹ID
		Mkt_id	    	    = (arrPar.length >= 4 ? arrPar[3] : "");	// 시장구분코드
		fr_bz_procs_no 	= (arrPar.length >= 5 ? arrPar[4] : "");	// 업무처리번호(수정시만 유효)
		tpCd		        	= (arrPar.length >= 6 ? arrPar[5] : "");	// 지정및해제구분코드
		Isu_cd  		        = (arrPar.length >= 7 ? arrPar[6] : "");	// 종목코드값
		gubun		  	    = (arrPar.length >= 8 ? arrPar[7] : "");	//  선택 구분(1:종목, 2:발행회사, 3:전체)
	}
	
	//alert( "Isur_cd =  " +Isur_cd + "\n"  + " Isur_nm = " + Isur_nm + "\n" + "  Secugrp_id = " + Secugrp_id + "\n" + 
	//		 "Mkt_id =  " +Mkt_id + "\n" + " fr_bz_procs_no = " + fr_bz_procs_no+ "\n"  ) ;
			
	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	//buttonSet.setCopyInfo( btn_release, fn_release , btn_Update ); 		// 해제
	//buttonSet.setCopyInfo( btn_rsn_change, fn_rsnChange , btn_Update ); 		// 사유변경

	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); // 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성
	//buttonSet.setRelInfo( btn_release, fn_release );		// 해제

	fn_SetIsuCdBtnShow(gubun);
	fn_SetRelAndChgRsnBtnShow();
	
	if (fr_bz_procs_no != "")  { // Provider화면 에서 넘겨받은 업무처리번호가 ""가 아니라면 신규작성으로 간주한다.
		fn_search(); 
	} else {
		fn_new_onload();    // 신규작성시 호출
		isFirstNew = true ;
	}
	
	PanelToGroupBox(panel_3);
	
	//buttonSet.setButtonDepCd(dts_ByCorpDepCd, Isur_cd, js_dep_cd);
]]></event>
		<event for="btn_release" eventname="onclick"><![CDATA[
	fn_release();
]]></event>
		<event for="btn_rsn_change" eventname="onclick"><![CDATA[
	fn_rsnChange();
]]></event></events>
</gform>

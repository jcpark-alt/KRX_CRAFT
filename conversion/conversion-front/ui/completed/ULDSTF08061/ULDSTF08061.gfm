<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="950" height="810" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts_list_1"></mxdataset>
		<mxdataset id="dts_list_2"></mxdataset>
		<mxdataset id="dts_inst"></mxdataset>
		<mxdataset id="dts_srty"></mxdataset>
		<mxdataset id="dts_lp"></mxdataset>
		<mxdataset id="dts_year1">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_year2">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_year3">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_year4">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_year5">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_year6">
			<property syncload="True"></property>
		</mxdataset>
	</model>
	<components>
		<label id="lbl_1" class="Comment_02" left="5" top="5" width="922" height="20" text="발행인/제3자 LP의 순자본비율">
			<extproperty font-family="굴림" font-weight="bold" font-size="12" color="#000000" text-align="left" border-color="#0000FF"></extproperty>
		</label>
		<panel id="panel_Top_1" class="TopCondition_01" left="5" top="30" width="922" height="65">
			<extproperty background-color="#d9e9fc"></extproperty>
			<mxradio id="rdo_gubun1" class="TopCondition_Blue" left="4" top="7" width="73" height="50">
				<property cols="1" format="1^기준월,2^기간"></property>
				<extproperty font-family="굴림" font-size="12" border-style="none"></extproperty>
			</mxradio>
			<image id="btn_search1" left="860" top="10" width="50" height="22" src="../img/btn_select.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="image_3" left="850" top="8" width="2" height="50" src="../img/img_line2.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<mxcombo id="cmb_instlp_select1" class="TopCondition_01" left="90" top="10" width="80" height="20">
				<property bindcolumn="VALUE" cbdata="''01^발행회사,02^제3자 LP" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_instlp_select2" class="TopCondition_01" left="90" top="35" width="80" height="20">
				<property bindcolumn="VALUE" cbdata="01^발행회사,02^제3자 LP" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_year1" class="TopCondition_01" left="175" top="10" width="70" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_year1"></ref>
			</mxcombo>
			<mxcombo id="cmb_month1" class="TopCondition_01" left="250" top="10" width="50" height="20">
				<property bindcolumn="VALUE" cbdata="''01^01월,02^02월,03^03월,04^04월,05^05월,06^06월,07^07월,08^08월,09^09월,10^10월,11^11월,12^12월" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_inst_lp" class="TopCondition_01" left="175" top="35" width="140" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_year2" class="TopCondition_01" left="330" top="35" width="70" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_year2"></ref>
			</mxcombo>
			<mxcombo id="cmb_month2" class="TopCondition_01" left="405" top="35" width="50" height="20">
				<property bindcolumn="VALUE" cbdata="''01^01월,02^02월,03^03월,04^04월,05^05월,06^06월,07^07월,08^08월,09^09월,10^10월,11^11월,12^12월" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_year3" class="TopCondition_01" left="470" top="35" width="70" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_year3"></ref>
			</mxcombo>
			<mxcombo id="cmb_month3" class="TopCondition_01" left="545" top="35" width="50" height="20">
				<property bindcolumn="VALUE" cbdata="''01^01월,02^02월,03^03월,04^04월,05^05월,06^06월,07^07월,08^08월,09^09월,10^10월,11^11월,12^12월" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
		</panel>
		<mxgrid id="grid_list1" class="Grid_01" left="5" top="120" width="922" height="123">
			<property borderstyle="0" colsizing="True" fillarea="True" fixsizing="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="25" xtitleheight="0"></property>
			<extproperty font-family="굴림" font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
			<format>
				<column id="COM_ABBRV" width="160" name="회사명/연월" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434"></column>
				<column id="FBZ_NETCAP" width="120" name="영업용순자본" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" align="right" dec="0" decao="3" edit="none"></column>
				<column id="TOT_RISK_AMT" width="120" name="총위험액" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" align="right" edit="none" decao="3"></column>
				<column id="REQ_PERSIS_PRINC_CAP_VAL" width="160" name="필요유지 자기자본" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" align="right" edit="none" decao="3"></column>
				<column id="NCR" width="160" name="순자본비율" align="right" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" edit="none" decao="3" dec="2"></column>
				<column id="NCR_PRE1" width="100" name="전월" align="right" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" show="True" edit="none" decao="0" dec="0"></column>
				<column id="NCR_PRE2" width="100" name="전전월" align="right" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" edit="none" decao="0" dec="0"></column>
			</format>
			<selectioncolor>
				<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
				<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
				<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
				<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
				<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
				<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
				<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
				<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
				<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
			</selectioncolor>
			<ref dataid="dts_list_1"></ref>
		</mxgrid>
		<image id="btn_excel1" left="850" top="250" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<label id="lbl_4" class="Comment_02" left="5" top="280" width="922" height="20" text="보증인의 자기자본비율">
			<extproperty font-family="굴림" font-weight="bold" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
		<panel id="panel_Top_2" class="TopCondition_01" left="5" top="304" width="922" height="65">
			<extproperty background-color="#d9e9fc"></extproperty>
			<image id="btn_search2" left="860" top="10" width="50" height="22" src="../img/btn_select.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="image_2" left="850" top="8" width="2" height="50" src="../img/img_line2.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<mxradio id="rdo_gubun2" class="TopCondition_Blue" left="5" top="7" width="73" height="55">
				<property cols="1" format="1^기준월,2^기간"></property>
				<extproperty font-family="굴림" font-size="12"></extproperty>
			</mxradio>
			<mxcombo id="cmb_year4" class="TopCondition_01" left="90" top="10" width="70" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_year4"></ref>
			</mxcombo>
			<mxcombo id="cmb_month4" class="TopCondition_01" left="165" top="10" width="50" height="20">
				<property bindcolumn="VALUE" cbdata="''01^01월,02^02월,03^03월,04^04월,05^05월,06^06월,07^07월,08^08월,09^09월,10^10월,11^11월,12^12월" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_year5" class="TopCondition_01" left="245" top="35" width="70" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_year5"></ref>
			</mxcombo>
			<mxcombo id="cmb_month5" class="TopCondition_01" left="318" top="35" width="50" height="20">
				<property bindcolumn="VALUE" cbdata="''01^01월,02^02월,03^03월,04^04월,05^05월,06^06월,07^07월,08^08월,09^09월,10^10월,11^11월,12^12월" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_year6" class="TopCondition_01" left="384" top="35" width="70" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_year6"></ref>
			</mxcombo>
			<mxcombo id="cmb_month6" class="TopCondition_01" left="458" top="35" width="50" height="20">
				<property bindcolumn="VALUE" cbdata="''01^01월,02^02월,03^03월,04^04월,05^05월,06^06월,07^07월,08^08월,09^09월,10^10월,11^11월,12^12월" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
			</mxcombo>
			<mxcombo id="cmb_srty" class="TopCondition_01" left="90" top="35" width="140" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" enable2="True" index="0" listcount="10" listexprformat="TEXT^0^100" searchcolumn="TEXT"></property>
				<extproperty font-family="굴림" font-size="12" background-color="#FFFFFF" border-color="#b9d4f7"></extproperty>
				<ref combodataid="dts_srty"></ref>
			</mxcombo>
		</panel>
		<image id="btn_excel2" left="850" top="522" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Close" left="878" top="770" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<label id="label_44" class="Comment_02" left="5" top="565" width="922" height="20" text="1. 순자본비율은 자산의 즉시 현금화 가능 여부 등을 기준으로 평가한 금융투자회사의 재무건전성 지표로서 금융투자업규정 제3-6호 제3호에 따라 산출합니다.">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#343434" border-color="#0000FF"></extproperty>
		</label>
		<label id="label_7" class="Comment_02" left="827" top="98" width="100" height="20" text="(단위 : 백만원, %)">
			<extproperty font-family="굴림" font-size="12" color="#343434" background-color="#FFFFFF" border-color="#0000FF"></extproperty>
		</label>
		<mxgrid id="grid_list2" class="Grid_01" left="5" top="393" width="922" height="124">
			<property borderstyle="0" colsizing="True" fillarea="True" fixsizing="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="25" xtitleheight="0"></property>
			<extproperty font-family="굴림" font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
			<format>
				<column id="SRTY_ABBRV" width="160" name="회사명/연월" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434"></column>
				<column id="PRINC_CAP_RTO_KIND_CD" width="120" name="비율종류" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434"></column>
				<column id="BAS_EQTYCAP" width="160" name="(기본)자기자본(A)" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" align="right" edit="any" dec="2" decao="3"></column>
				<column id="RISK_ASST_VAL" width="160" name="위험자산/책임준비(B)" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" align="right" dec="2" decao="3"></column>
				<column id="ETN_SRTY_PRINC_CAP_RTO" width="120" name="비율(A/B)" align="right" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" dec="2" decao="3"></column>
				<column id="CAP_RTO_PRE1" width="100" name="전월" align="right" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" dec="2" decao="3"></column>
				<column id="CAP_RTO_PRE2" width="100" name="전전월" align="right" bgcolor="{decode(COM_ABBRV,'합계(평균)','#FFCC99','default')}" headbgcolor="#598fd5" headcolor="#FFFFFF" color="#343434" sumcolor="#343434" dec="2" decao="3"></column>
			</format>
			<selectioncolor>
				<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
				<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
				<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
				<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
				<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
				<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
				<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
				<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
				<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
			</selectioncolor>
			<ref dataid="dts_list_2"></ref>
		</mxgrid>
		<label id="label_2" class="Comment_02" left="835" top="371" width="93" height="20" text="(단위 : 억원, %)">
			<extproperty font-family="굴림" font-size="12" color="#343434" background-color="#FFFFFF" border-color="#0000FF"></extproperty>
		</label>
		<label id="label_3" class="Comment_02" left="25" top="585" width="902" height="20" text="※ 순자본비율 = 순자본 / 필요유지자기자본 * 100">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
		<label id="label_4" class="Comment_02" left="25" top="605" width="902" height="20" text="    순자본 = 영업용순자본 - 총위험액">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
		<label id="label_5" class="Comment_02" left="5" top="625" width="922" height="20" text="2. 영업용순자본은 금융투자업규정 제3-11조 제1항, 총위험액은 같은 규정 제3-11조 제2항, 필요유지자기자본은 같은 규정 제3-6조 제2호에 따라서 산출된 금액을">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
		<label id="label_6" class="Comment_02" left="19" top="645" width="908" height="20" text="의미합니다.">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
		<label id="label_12" class="Comment_02" left="5" top="665" width="922" height="20" text="3. 발행인은 순자본비율을 100%이상 유지해야 하며 이에 미달시 단계별로 적기시정조치를 발동하게 됩니다. 순자본비율이 상장요건 미만으로 하락할 경우 해당 발행인은">
			<extproperty font-family="굴림" font-size="12" color="#343434" border-color="#0000FF"></extproperty>
		</label>
		<label id="lbl_6" class="Comment_02" left="20" top="685" width="907" height="20" text="상장요건을 회복할 때까지 신규상장 및 추가상장이 제한됩니다. 또한, 순자본비율이 상장폐지요건에 미달할 경우 해당 발행인이 발행한 상장지수증권이 상장폐지될 수 ">
			<extproperty font-family="굴림" font-size="12" color="#343434" border-color="#0000FF"></extproperty>
		</label>
		<label id="lbl_9" class="Comment_02" left="20" top="705" width="907" height="20" text="있으니 투자자들께서는 유의 하시기 바랍니다.">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
		<label id="lbl_8" class="Comment_02" left="5" top="725" width="922" height="20" text="4. 순자본비율은 2016년부터 전면 시행(2015년은 선택 시행)되어, 과거 데이터 조회시 이 점 유의하시기 바랍니다.">
			<extproperty font-family="굴림" font-weight="normal" font-size="12" color="#000000" border-color="#0000FF"></extproperty>
		</label>
	</components>
	<!-- 조회 Error -->
	<!-- 조회 Error -->
	<!-- 조회 Error -->
	<!-- 조회 로드 에러 -->
	<!-- 조회 로드 에러 -->
	<!-- 기준년 로드 에러 -->
	<!-- 기준년 로드 에러 -->
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js");
	#include("../js/utils.js");
	#include("../js/list_common.js");
	#include("../js/common.js");
	#include("../js/session.js");
	
	var vScrenID = "ULDSTF08061.gfm";
	
	//초기화
	function fn_init(){
		var dateTmp = cGetToday("yyyymmdd");

		setObjectValue(cmb_month1, dateTmp.substring(4, 6));
		setObjectValue(cmb_month2, dateTmp.substring(4, 6));
		setObjectValue(cmb_month3, dateTmp.substring(4, 6));
		setObjectValue(cmb_month4, dateTmp.substring(4, 6));
		setObjectValue(cmb_month5, dateTmp.substring(4, 6));
		setObjectValue(cmb_month6, dateTmp.substring(4, 6));
	
		//기준년 (콤보박스)
		var urlYear = "/ElwNcr.do?method=selectElwNcrYear&inputMessageId=ELW_NCR_YEAR_INOUT";
		dts_year1.DataID = encodeURI(urlYear);
		dts_year1.reset();	
		dts_year2.DataID = encodeURI(urlYear);
		dts_year2.reset();	
		dts_year3.DataID = encodeURI(urlYear);
		dts_year3.reset();	
		dts_year4.DataID = encodeURI(urlYear);
		dts_year4.reset();	
		dts_year5.DataID = encodeURI(urlYear);
		dts_year5.reset();	
		dts_year6.DataID = encodeURI(urlYear);
		dts_year6.reset();	
		
		dts_inst.DataID = "/etn/EtnCodeAct.do?method=listIsurCd&For=R";
		dts_inst.Reset();
		
		dts_lp.DataID = "/etn/EtnCodeAct.do?method=listLPCd&For=R";
		dts_lp.Reset();
		
		dts_srty.DataID = "/etn/EtnCodeAct.do?method=listSrtyCd&For=R";
		dts_srty.Reset();
		
		cmb_inst_lp.ComboDataID="dts_inst";
		
		fn_change_gubun1("1");
		fn_change_gubun2("1");
	}
	
	//데이타 가져와서 뿌리기 List
	function fn_list_sync1() {	
		var url = "/etn/EtnStatMgt.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchIsurLpNcrDetailList";
		url += "&inputMessageId=ETN_ISUR_LP_NCR_INOUT&outputMessageId=ETN_ISUR_LP_NCR_INOUT";
		
		if(rdo_gubun1.CodeValue == "1") {

			if(cmb_instlp_select1.BindColVal == "01") url += "&GUBUN=isur";
			else url += "&GUBUN=lp";
			
			url += "&FROM_YYMM=" + cmb_year1.BindColVal + cmb_month1.BindColVal;
			
			grid_list1.ColumnProp('NCR_PRE1','Show')=true;
			grid_list1.ColumnProp('NCR_PRE2','Show')=true;
			
		} else {
			
			if(cmb_instlp_select2.BindColVal == "01") url += "&GUBUN=isur";
			else url += "&GUBUN=lp";
			
			url += "&FROM_YYMM=" + cmb_year2.BindColVal + cmb_month2.BindColVal;
			url += "&TO_YYMM=" + cmb_year3.BindColVal + cmb_month3.BindColVal;
			url += "&ISUR_LP_CD=" + cmb_inst_lp.BindColVal;
			
			grid_list1.ColumnProp('NCR_PRE1','Show')=false;
			grid_list1.ColumnProp('NCR_PRE2','Show')=false;
		}
		
		dts_list_1.DataID = encodeURI(url); 
		dts_list_1.reset();				
		ShowWin(grid_list1);
	}
	
	function fn_list_sync2() {	
		var url = "/etn/EtnStatMgt.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchSrtyCapRatioDetailList";
		url += "&inputMessageId=ETN_SRTY_CAP_RATIO_INOUT&outputMessageId=ETN_SRTY_CAP_RATIO_INOUT";
		
		if(rdo_gubun2.CodeValue == "1") {
			
			url += "&FROM_YYMM=" + cmb_year4.BindColVal + cmb_month4.BindColVal;
			
			grid_list2.ColumnProp('CAP_RTO_PRE1','Show')=true;
			grid_list2.ColumnProp('CAP_RTO_PRE2','Show')=true;
			
		} else {
			
			url += "&FROM_YYMM=" + cmb_year5.BindColVal + cmb_month5.BindColVal;
			url += "&TO_YYMM=" + cmb_year6.BindColVal + cmb_month6.BindColVal;
			url += "&SRTY_CD=" + cmb_srty.BindColVal;
			
			grid_list2.ColumnProp('CAP_RTO_PRE1','Show')=false;
			grid_list2.ColumnProp('CAP_RTO_PRE2','Show')=false;
		}
			
		dts_list_2.DataID = encodeURI(url); 
		dts_list_2.reset();				
		ShowWin(grid_list2);
	}
	
	function fn_change_gubun1(gubun)
	{
		if(gubun == "1") {
			
			cmb_instlp_select1.Enable2="true";
			cmb_year1.Enable2="true"; 
			cmb_month1.Enable2="true";
			
			cmb_instlp_select2.Enable2="false";
			cmb_inst_lp.Enable2="false";
			cmb_year2.Enable2="false"; 
			cmb_month2.Enable2="false";
			
			cmb_year3.Enable2="false"; 
			cmb_month3.Enable2="false";
		
		} else if(gubun == "2") {
			
			cmb_instlp_select1.Enable2="false";
			cmb_year1.Enable2="false"; 
			cmb_month1.Enable2="false";
			
			cmb_instlp_select2.Enable2="true";
			cmb_inst_lp.Enable2="true";
			cmb_year2.Enable2="true"; 
			cmb_month2.Enable2="true";
			
			cmb_year3.Enable2="true"; 
			cmb_month3.Enable2="true";
		}
	}
	
	function fn_change_gubun2(gubun)
	{
		if(gubun == "1") {
			
			//cmb_instlp_select1.Enable2="true";
			cmb_year4.Enable2="true"; 
			cmb_month4.Enable2="true";
			
			cmb_srty.Enable2="false"; 
			//cmb_instlp_select2.Enable2="false";
			//cmb_inst_lp.Enable2="false";
			cmb_year5.Enable2="false"; 
			cmb_month5.Enable2="false";
			
			cmb_year6.Enable2="false"; 
			cmb_month6.Enable2="false";
		} else if(gubun == "2") {
			
			//cmb_instlp_select1.Enable2="false";
			cmb_year4.Enable2="false"; 
			cmb_month4.Enable2="false";
			
			cmb_srty.Enable2="true"; 
			//cmb_instlp_select2.Enable2="true";
			//cmb_inst_lp.Enable2="true";
			cmb_year5.Enable2="true"; 
			cmb_month5.Enable2="true";
			
			cmb_year6.Enable2="true"; 
			cmb_month6.Enable2="true";
		}
	}
	
	//엑셀 다운로드
	function fn_ExcelDown1(){
		grid_list1.GridToExcel("ETN 발행사/LP (영업용)순자본비율", "", "8");
	}
	function fn_ExcelDown2(){
		grid_list2.GridToExcel("ETN 보증인 자기자본비율", "", "8");
	}
]]></script>
	
		<events><event for="rdo_gubun1" eventname="OnSelChange()"><![CDATA[
	fn_change_gubun1(rdo_gubun1.CodeValue);
]]></event>
		<event for="rdo_gubun2" eventname="OnSelChange()"><![CDATA[
	fn_change_gubun2(rdo_gubun2.CodeValue);
]]></event>
		<event for="cmb_instlp_select2" eventname="OnSelChange()"><![CDATA[
	if(cmb_instlp_select2.BindColVal == "01") {
		cmb_inst_lp.ComboDataID="dts_inst";
	}
	else if(cmb_instlp_select2.BindColVal == "02") {
		cmb_inst_lp.ComboDataID="dts_lp";
	}
	else  {
		alert(cmb_instlp_select2.BindColVal);
	}
	cmb_inst_lp.index =0;
]]></event>
		<event for="dts_year1" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Year1);	
]]></event>
		<event for="dts_year2" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Year2);	
]]></event>
		<event for="dts_year3" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Year3);	
]]></event>
		<event for="dts_year4" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Year4);	
]]></event>
		<event for="dts_year5" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Year5);	
]]></event>
		<event for="dts_year6" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Year6);	
]]></event>
		<event for="dts_list_1" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_list_1);	
]]></event>
		<!-- 조회 로딩 끝난 후 멈춤 이벤트 -->
		<event for="dts_list_1" eventname="OnLoadCompleted(rowcount)"><![CDATA[
//	FillGridHeaderTotalCnt(rowcount, panel_page);
	CloseWin(rowcount, grid_list1); 
	//alert("dts_List.CountRow-->"+dts_List.CountRow);
]]></event>
		<event for="dts_list_2" eventname="OnLoadCompleted(rowcount)"><![CDATA[
//	FillGridHeaderTotalCnt(rowcount, panel_page);
	CloseWin(rowcount, grid_list2); 
	//alert("dts_List.CountRow-->"+dts_List.CountRow);
]]></event>
		<!-- 창 닫기 -->
		<event for="btn_Close" eventname="onclick"><![CDATA[
	self.close();
]]></event>
		<!-- 조회 -->
		<event for="btn_search1" eventname="onclick"><![CDATA[
	fn_list_sync1();
]]></event>
		<event for="btn_search2" eventname="onclick"><![CDATA[
	fn_list_sync2();
]]></event>
		<!-- 엑셀다운로드 -->
		<event for="btn_excel1" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	fn_ExcelDown1();
]]></event>
		<event for="btn_excel2" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	fn_ExcelDown2();
]]></event>
		<!--처음 로딩-->
		<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top_1);
	PanelToGroupBox(panel_Top_2);
	rdo_gubun1.CodeValue ="1";
	rdo_gubun2.CodeValue ="1";
	fn_init();
	//fn_list_sync();	
]]></event></events>
</gform>

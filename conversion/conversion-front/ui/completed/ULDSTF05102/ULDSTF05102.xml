/********************************************** 
 * 함수명   : fn_excelDown()
 * 설명       : 정보를 excel로 다운 받는다.
 ***********************************************/
scwin.fn_excelDown = function() {
    if (dlt_selectListRes.getTotalRow() > 0) {
        const today = $c.date.getServerDateTime("yyyyMMddHHmmss");
        const options = {
            fileName : "ULDSTF05102_상장심사_" + today,
            sheetName : "리스트",
        };
        $c.data.downloadGridViewExcel(grd_list, options);
    } else {
        $c.win.alert($c.data.getMessage("com_search_0027"));
    }
};

/* 
 * 상세 조회
 */
scwin.fn_OpenDetail = async function(row) {
    let hight;
    let secugrpId;
    let pageNM;
    let isurCd;
    let comNm;
    let listDd;

    if (row >= 0) {
        //그리드에서 선택시
        scwin.clickBzProcsNo = dlt_selectListRes.getCellData(row, "bzProcsNo");
        secugrpId = dlt_selectListRes.getCellData(row, "secugrpId");
        isurCd = dlt_selectListRes.getCellData(row, "isurCd");
        comNm = dlt_selectListRes.getCellData(row, "comNm");
        listDd = dlt_selectListRes.getCellData(row, "listDd");
    } else {
        //신규버튼 선택시
        scwin.clickBzProcsNo = ""; //초기화
        secugrpId = sbx_newSecugrpId.getValue();
    }

    if (secugrpId == $c.lc.getGlbValue("SECUGRP_ID_ST")) {
        hight = "935";
        pageNM = "ULDSTF05103";
    } else if (secugrpId == $c.lc.getGlbValue("SECUGRP_ID_DR") || secugrpId == $c.lc.getGlbValue("SECUGRP_ID_FS")) {
        hight = "980";
        pageNM = "ULDSTF05104";
    }

    const data = {
        clickBzProcsNo : scwin.clickBzProcsNo,
        rowPos : dlt_selectListRes.getRowJSON(row),
        newSecugrpId : sbx_newSecugrpId.getValue(),
        isurCd : isurCd,
        comNm : comNm,
        listDd : listDd,
    };
    const opts = {
        id: pageNM,
        popupName: $c.lc.getSecuGrpNm(secugrpId) + "종류주식 신규상장관리",
        width: 1280,
        height: hight,
        frameModal: "top",
    };
    await $c.win.openPopup("/ui/lst/kindstk/" + pageNM + ".xml", opts, data);
};

/*
 * 상장심사종목찾기
 */
scwin.fn_PopFindKindStkExamIsu = async function() {
    const data = {
        isurCd: ibx_isurCd.getValue(), // 코드값을 포함할 컨트롤
        comNm: ibx_comNm.getValue(), // 명칭값을 포함할 컨트롤
        secugrpId: rdo_secugrpId.getValue(),
        mktTpCd: rdo_spotIsuTrdMktTpCd.getValue(),
        searchType: $c.lc.getGlbValue("SEARCH_TYP_SLR"),
    };
    const opts = {
        id: "ULDSTF05107",
        popupName: "종류주식 종목 선택",
        width: 1180,
        height: 880,
        frameModal: "top",
    };
    const result = await $c.win.openPopup("/ui/lst/kindstk/ULDSTF05107.xml", opts, data);
    if (result.isCloseButtonClick === false) {
        ibx_isuCd.setValue(result.ISU_CD);
        ibx_isuNm.setValue(result.ISU_NM);
    }
};

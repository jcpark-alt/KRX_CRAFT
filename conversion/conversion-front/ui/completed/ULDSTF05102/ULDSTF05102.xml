///////// 1. 변수 및 선언 영역 /////////

scwin.clickBzProcsNo = "";
scwin.vScrenID = "ULDSTF05102";

///////// 2. 초기화 영역 /////////

scwin.onpageload = function() {
    scwin.init();
};

scwin.onpageunload = function() {
};

/* 
 * 화면 초기화
 */
scwin.init = async function() {
    $c.win.setEnterKeyEvent(grp_search, scwin.btn_search_onclick);
     $c.data.comboCbDataSetPeriod(sbx_periodTp);
    $c.date.compareFromToDate(cal_sDate, cal_eDate);
    $c.lc.initSearchDate(cal_sDate, cal_eDate);

    if ($c.session.getUserInfo("market") === "1" || $c.session.getUserInfo("market") === "2") {
        // $c.cm.setColumnProp(grd_list, "TR_MKT_NM", "Show", false);
        grd_list.setColumnVisible("trMktNm", false);
        rdo_spotIsuTrdMktTpCd.setValue($c.session.getUserInfo("market"));
        panel_mkt_gubun.hide();
    } else {
        panel_mkt_gubun.show();
    }

    await scwin.fn_list_sync();
};

///////// 3. 컴포넌트 이벤트 영역 /////////

/* 
 * 조회 버튼
 */
scwin.btn_search_onclick = function() {
    scwin.fn_list_sync();
};

/* 
 * 엑셀다운로드 버튼
 */
scwin.btn_excel_onclick = function() {
    scwin.fn_excelDown();
};

/* 
 * Grid 더블클릭
 */
scwin.grd_list_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    scwin.fn_OpenDetail(rowIndex);
};

/* 
 * 신규 버튼
 */
scwin.btn_new_onclick = function() {
    if (sbx_newSecugrpId.getValue() == "") {
        $c.win.alert($c.data.getMessage("com_req_select", "신규등록할 유가증권"));
        sbx_newSecugrpId.focus();
        return;
    } else {
        scwin.fn_OpenDetail(-999);
    }
};

/* 
 * 법인코드 조회 버튼
 */
scwin.btn_coSearch_onclick = async function() {
    const res = await $c.lc.popFindExamCorp(rdo_secugrpId.getValue(), "SLR", rdo_spotIsuTrdMktTpCd.getValue());
    ibx_isurCd.setValue(res.isurCd);
    ibx_comNm.setValue(res.comNm);
};

/* 
 * 법인코드 onblur
 */
scwin.ibx_isurCd_onblur = function() {
    if (ibx_isurCd.getValue() == "") {
        ibx_comNm.setValue("");
    }
};

/* 
 * 기간선택 selectBox 일자 세팅
 */
scwin.sbx_periodTp_onviewchange = function (info) {
    var vTp = $c.cp.valueOfIndex(sbx_periodTp, "value", sbx_periodTp.getSelectedIndex());
    $c.stf.setFromToDate(vTp, cal_sDate, cal_eDate);
};

/* 
 * 종목코드 조회 버튼
 */
scwin.btn_isuCdSearch_onclick = function() {
    scwin.fn_PopFindKindStkExamIsu();
};

/* 
 * 종목코드 onblur
 */
scwin.ibx_isuCd_onblur = function (e) {
	    if (ibx_isuCd.getValue() == "") {
        ibx_isuNm.setValue("");
    }
};

///////// 4. 서브미션 콜백 영역 /////////

/* 
 * 목록 조회
 */
scwin.fn_list_sync = async function() {
    const sbmOptions = {
        id: "sbm_selectList",
        action: "/api/listing/lstproc/kind/listing-review/select-list",
        method: "get",
        ref : "dma_selectListReq",
        target: "dlt_selectListRes=body",
        isProcessMsg : false
    };
    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    if (sbmRtn.responseJSON.success) {
        tbx_totCnt.setValue(dlt_selectListRes.getRowCount());
    }
};


<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="715" height="500" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
		@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Mst">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_TrdSsp">
			<property activebind="true"></property>
			<bindinfo>
				<column col="DELIST_DD" ctrl="edt_DelistDd" param="text" readonly="False"></column>
				<column col="GRND_REGUL_NM" ctrl="txb_GrndRegulNm" param="value" readonly="False"></column>
				<column col="REMK" ctrl="txa_Remk" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_Rsn_Uly">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_CheckDate">
			<property syncload="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_1" left="7" top="7" width="695" height="30" class="TopCondition_01">
			<extproperty></extproperty>
			<label id="label_3" class="TopCondition_01" left="10" top="5" width="65" height="20" text="현재일">
			<extproperty font-size="12" text-align="center"></extproperty>
			</label>
			<mxmaskedit id="edt_Dd" class="panel_maskedit_write_01" left="80" top="5" width="70" height="18">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="btn_Dd" left="155" top="5" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="btn_Search" left="185" top="5" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<panel id="panel_3" left="7" top="47" width="695" height="410" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="20" top="10" width="95" height="20" text="1. 상장폐지종목">
			<extproperty font-size="12"></extproperty>
			</label>
			<mxgrid id="grd_isu" class="Grid_01" left="120" top="10" width="565" height="195">
			<property editable="True" gtitleheight="0" titleheight="25" xtitleheight="0"></property>
			<format>
				<column id="BZ_PROCS_NO" width="120" show="False" name="BZ_PROCS_NO"></column>
				<column id="번호" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_CD" width="95" name="종목코드" align="center" edit="none"></column>
				<column id="ISU_NM" width="140" name="종목명" edit="none"></column>
				<column id="ELW_LSTTRD_DD" mask="XXXX-XX-XX" width="70" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="최종거래일" align="center" edit="none" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="EXER_END_DD" mask="XXXX-XX-XX" width="70" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="행사종료일" align="center" edit="none" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ISU_PRC" width="60" name="발행가액" align="right" decao="3" edit="none"></column>
				<column id="ISU_SHRS" width="73" name="발행증권수" align="right" decao="3" edit="none"></column>
			</format>
			<ref dataid="dts_Isu"></ref>
			</mxgrid>
			<label id="label_11" class="TopCondition_01" left="10" top="240" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="215" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_12" class="TopCondition_01" left="10" top="265" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_6" class="TopCondition_01" left="20" top="265" width="95" height="20" text="4. 근거규정">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_GrndRegulNm" class="TopCondition_01_write" left="120" top="265" width="565" height="20" maxlength="1000">
			<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<label id="label_7" class="TopCondition_01" left="20" top="290" width="95" height="20" text="5. 기타">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="120" top="290" width="565" height="108">
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<label id="label_5" class="TopCondition_01" left="20" top="215" width="95" height="20" text="2. 상장폐지사유">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<mxcombo id="cmb_Rsn_Cd" class="TopCondition_01" left="120" top="215" width="565" height="20">
			<property bindcolumn="CODE" cbdatacolumns="CODE,NAME,REGL" index="0" listcount="10" listexprformat="NAME^0^500" searchcolumn="NAME"></property>
			<extproperty font-size="12"></extproperty>
			<ref combodataid="dts_Rsn"></ref>
			</mxcombo>
			<label id="label_1" class="TopCondition_01" left="20" top="240" width="95" height="20" text="3. 상장폐지일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<mxmaskedit id="edt_DelistDd" class="panel_maskedit_write_01" left="120" top="240" width="70" height="18">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_DelistDd" left="195" top="240" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<image id="btn_Close" left="652" top="463" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="557" top="463" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="502" top="463" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="447" top="463" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Save" left="392" top="463" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/common.js");
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF05918.gfm";
	var Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" ,  Dd = "" ;

	var trsIdx ;  // insert, update 구분
	 
	var isFirstLoad = false ;
	
	var fn_GetPar , fn_SetPar ;
	
	// 변수 선언
	var vInitSetting = false;
	var vDELIST_DD = '';
	var vLSTTRD_DD_F = '';
	var vDELIST_DD_F = '';
	var vEXER_END_DD_F = '';
	
	//  기타 안내문 작성 FUNCTION
	function fn_set_etc_info() 
	{
		var etc = '상기 '  
				+ dts_Isu.CountRow + '종목의 주식워런트증권은 최종거래일(' +  dts_CheckDate.NameString(1, "LSTTRD_DD_F") + ')이 도래함에 따라 ' 
				+ dts_CheckDate.NameString(1, "DELIST_DD_F") + '에 \n상장폐지됨을 알려드립니다. (권리행사기간 만료일:' + dts_CheckDate.NameString(1, "EXER_END_DD_F") + ')';
		
		txa_Remk.text = etc;
	}
	
	function fn_getCheckDD() 
	{
		var url = "/listingCommon.do?method=listGeneral&outputMessageId=ULDSTF05918_DELIST_LSTTRD_DD123" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.lstproc.dellist.dtl.new.select.05918_dd123"+ 
		 "&{P}param01=" + edt_Dd.text;
		dts_CheckDate.DataID = encodeURI(url);
		dts_CheckDate.reset();
	}
	
	function fn_get_isu_cd() 
	{
		if (edt_Dd.text.length != 8 ) { alert("[최종거래일]을 정확히 입력하세요.");  return false; }		
	
		/////////////////////////////
		vInitSetting = true;
		//////////////////////////
		
		var url = "/Delisting.do?method=searchDelList" + 
			   "&DIV_IDX="+DIV_IDX_DELLIST_DTL  + "&TRS_IDX="+TRS_IDX_NEWSEL  + "&GUBUN_CD=" + edt_Dd.Text ;
			 
		dts_Isu.DataID = encodeURI(url);
		dts_Isu.reset();
		ShowWin(grd_isu);
		
		///////////////////////////////////
		// jackal_15.06.18
		//fn_getCheckDD();
		//fn_set_etc_info();
		
		//edt_DelistDd.Text = vDELIST_DD;
		////////////////////////////////////
	}

	function fn_search() {
		if (fr_bz_procs_no != "") {
			var url = "/Delisting.do?method=searchDelList" + 
						"&DIV_IDX="+DIV_IDX_DELLIST_MST + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			
			dts_Mst.DataID = encodeURI(url);
			dts_Mst.reset();	
			
			url = "/Delisting.do?method=searchDelList" + 
				   "&DIV_IDX="+DIV_IDX_DELLIST_DTL + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
				 
			dts_Isu.DataID = encodeURI(url);
			dts_Isu.reset();
		}
	}
	
	function fn_new_onload() {
		var url = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DELLIST_MST_INOUT";
		url += "&SCREN_ID=" + vScrenID;
		url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
	
		//dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DELLIST_MST_INOUT";
		dts_Mst.DataID = encodeURI(url);
		dts_Mst.reset();
		
	}
	
	function fn_get_rsn_cd() {
		var url = "/listingCommon.do?method=listCode&inputMessageId=LISTING_CODE_IN&outputMessageId=LISTING_CODE_OUT&MKT=" + 
						Mkt_id + "&RSN=" + "05";
		dts_Rsn.DataID = encodeURI(url); 
		dts_Rsn.reset();
	}
	
	function fn_CheckForm() {
		if( dts_Isu.CountRow == 0 ) {
			alert("[상장폐지종목]을 선택하세요.");  return false;
		}
		
		if( ! checkDdTm ( "DD" , edt_DelistDd   , "상장폐지" , false)  ) return false ; 
		
		if( ! checkEmptyValue( txb_GrndRegulNm , "근거규정" ) ) return false ;
		if( ! checkMaxLength( txb_GrndRegulNm , 200 , "근거규정" ) ) return false ;
		if( ! checkMaxLength( txa_Remk , 2000 , "기타" ) ) return false ;


		return true;
	}
	
	function fn_save_trs() {

		// 매매거래정지종목은 매번 업무처리 번호를 세팅함
		// 종목별 변경이 있을수 있기 때문
		for (var i = 1 ; i <= dts_Isu.CountRow  ; i++) { dts_Isu.NameString(i, "BZ_PROCS_NO") = fr_bz_procs_no ;};
			
		// ELW는 항상  종목별기준으로 처리함
		// 1 : 종목별 , 2 : 법인별
		dts_Mst.NameString(dts_Mst.RowPosition, "MKTACT_APPL_OBJ_TP_CD") =  "1" ;
		dts_Mst.NameString(dts_Mst.RowPosition, "DELIST_RSN_CD") =  dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "CODE")  ;
		
//alert(dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "CODE") + "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "NAME")+ "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "REGL")) ;
		
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if         ( trsIdx == TRS_IDX_INSERT )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( trsIdx == TRS_IDX_DELETE )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
			
		trs.Action 	     = fn_encodeNSession( "/Delisting.do?method=saveDelList&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD);
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_Isu)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=2" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_307 + 
								",DIV_IDX[0]=" + DIV_IDX_DELLIST_MST+
								",DIV_IDX[1]=" + DIV_IDX_DELLIST_DTL ;
								
		trs.Post();
	}
	
	function fn_save() {
		
		if (fn_CheckForm()) {
			if (! fn_isProcess('I') )  return ;
			fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );

			if (fr_bz_procs_no.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {

				trsIdx = TRS_IDX_INSERT ;

				dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO") = fr_bz_procs_no;
				dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = "99999";
				
				fn_save_trs();
			}
		}
	}
	
   function fn_update() {
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			fn_save_trs();
		}	
	}

	function fn_delete() {
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_save_trs();
	}
	
	
	function fn_dscl() {
	
		//수정한 것이 있으면 체크 됨.(종목제외)
		if(  dts_Mst.IsUpdated || dts_Rsn.IsUpdated  ) {
			alert(getMessageParam("MSG-0022", ""));
			return ;
		}
	
		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2,param_dts3) {

			arr[0] = "68955C";
			arr[1] = fr_bz_procs_no;
			arr[2] = "99999" ;
			arr[3] = '1' ; 
			// jackal_150618
			// 공시제목 추가
			arr[4] = '' ; 
			arr[5] = '익일 최종거래일에 의한 상장폐지예고' ; 
			
			CopyDataSet( dts_Isu , param_dts_isu) ;
			CopyDataSet( dts_Mst , param_dts_mst) ;
			
			param_dts_mst.NameString(param_dts_mst.RowPosition, "DELIST_RSN_NM") = cmb_Rsn_Cd.text ;

			return arr.length;
		}
		
		fn_SetPar = function(arr) { }
	
		var wth = 740 + 5;
		var hgt = 790 + 30;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}
	function fn_drft() { }
	function fn_makt() { }
	
]]></script>

<events><event for="trs" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
]]></event>

<event for="trs" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	
	if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
		frame.CloseFrame();
	} else {
		fn_search();
	}	
]]></event>

<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (fr_bz_procs_no == "") {
		dts_Mst.AddRow();
	}
			
	// 신규처리에 의한 조회인지,  수정에 의한 조회인지를 구별
	if (fr_bz_procs_no == "") {
		buttonSet.setInsertStatus();
	} else {
		setButtonSetWithDate( edt_DelistDd , false ) ;
	}

	isFirstLoad = true ;
	
	if (fr_bz_procs_no == "") {
		cmb_Rsn_Cd.BindColVal = "690014" ;
		txb_GrndRegulNm.value = dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "REGL") ;
	}
	else {
		cmb_Rsn_Cd.BindColVal = dts_Mst.NameString(dts_Mst.RowPosition , "DELIST_RSN_CD")  ;
	}
	
	isFirstLoad = false;
	
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
<event for="img_DelistDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_DelistDd); 
]]></event>
<event for="cmb_Rsn_Cd" eventname="OnSelChange2()"><![CDATA[
	if(isFirstLoad ) return ;
	txb_GrndRegulNm.value = dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "REGL") ;
	//alert(dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "CODE") + "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "NAME")+ "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "REGL")) ;
]]></event>
<event for="btn_Dd" eventname="onclick"><![CDATA[
	if(fr_bz_procs_no != "" ) return ;
	popUpCalendar2(edt_Dd); 
]]></event>

<event for="dts_Isu" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	CloseWin(rowcount, grd_isu);	
	if ( vInitSetting )
	{
	fn_getCheckDD();
	vInitSetting = false;
	}
]]></event>

<event for="dts_CheckDate" eventname="OnLoadCompleted(rowcount)"><![CDATA[
		vDELIST_DD = '';
		if ( dts_CheckDate.CountRow == 1) 
		{
		vDELIST_DD = dts_CheckDate.NameString(1, "DELIST_DD");
		vLSTTRD_DD_F = dts_CheckDate.NameString(1, "LSTTRD_DD_F");
		vDELIST_DD_F = dts_CheckDate.NameString(1, "DELIST_DD_F");
		vEXER_END_DD_F = dts_CheckDate.NameString(1, "EXER_END_DD_F");
		}
		fn_set_etc_info();
		
		edt_DelistDd.Text = vDELIST_DD;
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar; // Provider화면에서 fn_GetPar명칭으로 선언된 함수를 획득
	var arrPar = new Array;
	
	if (fnc != undefined) {
		fnc(arrPar); // Provider화면의 callback함수를 호출하여 필요한 인수를 넘겨받는다.
		Secugrp_id 		    = (arrPar.length >= 1 ? arrPar[0] : "");	// 증권그룹ID
		Mkt_id	    	        = (arrPar.length >= 2 ? arrPar[1] : "");	// 시장구분코드
		fr_bz_procs_no 	= (arrPar.length >= 3 ? arrPar[2] : "");	// 업무처리번호(수정시만 유효)
		Dd     		            = (arrPar.length >= 4 ? arrPar[3] : "");	// 최종거래일 또는 당일자
	}
	
	fn_get_rsn_cd() ;
	
	//alert( "Isur_cd =  " +Isur_cd + "\n"  + " Isur_nm = " + Isur_nm + "\n" + "  Secugrp_id = " + Secugrp_id + "\n" + 
	//		 "Mkt_id =  " +Mkt_id + "\n" + " fr_bz_procs_no = " + fr_bz_procs_no+ "\n"  ) ;
			
	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성
	
	buttonSet.setCopyInfo( btn_Search, fn_get_isu_cd , btn_Save ); 		// 조회
	
	edt_Dd.text = Dd ;
	if (fr_bz_procs_no != "")  { // Provider화면 에서 넘겨받은 업무처리번호가 ""가 아니라면 신규작성으로 간주한다.
		edt_Dd.ReadOnly = true ;
		fn_search(); 
	} else {
		edt_Dd.ReadOnly = false ;
		fn_new_onload();    // 신규작성시 호출
	}
	
	PanelToGroupBox(panel_3);
	PanelToGroupBox(panel_1);
	
]]></event></events>
</gform>

		<script type="text/javascript" lazy="false"><![CDATA[scwin.vScrenID = "ULDSTF09330.xml";
scwin.procJob = "";
scwin.pUsrTpCd = $c.session.getUserInfo('usrTpCd'); 

scwin.onpageload = function() {
    scwin.init();
};

scwin.init = function() {
    //담당자 버튼
    btn_TrSend.setDisabled(true);
    
    //마감일
    var vCurDate = $c.date.getServerDateTime();
    $c.stf.setObjectValue(edt_TASK_DD, vCurDate);
    MaxTab_01.setSelectedTabIndex(0);
    if(MaxTab_01.getSelectedTabIndex() == 0){
        edt_TASK_DD.setDisabled(true);
    }
    
    //조회
    scwin.fn_list_sync();
};


scwin.fn_list_sync = async function() {
    //이후 영업 상장일
    await scwin.nextBzSearch();

    //마감정보
    await scwin.closingSttsSearch();


    //마감처리
    if (MaxTab_01.getSelectedTabIndex() == 0) {
        const sbmOptions = {
            id: "sbm_list",
            action: "/api/listing/lstproc/pf/new-listing-closing/select-list",
            method: "get",
            target: "dlt_list=body",
            isProcessMsg: false
        };

        var result = await $c.sbm.executeDynamic(sbmOptions, {'listDd' : edt_LIST_DD.getValue()});
        if(result.responseJSON.success){
            edt_New_Proc_TotalCnt.setValue(dlt_list.getTotalRow());
            scwin.buttonTrSend();
        }


    } else if (MaxTab_01.getSelectedTabIndex() == 1) {
        //마감처리내역
        const sbmOptions = {
            id: "sbm_list",
            action: "/api/listing/lstproc/pf/new-listing-closing/select-list-hist",
            method: "get",
            target: "dlt_list2=body",
            isProcessMsg: false
        };

        var result = await $c.sbm.executeDynamic(sbmOptions, {'taskDd' : edt_TASK_DD.getValue()});
        if(result.responseJSON.success){
            edt_New_Search_TotalCnt.setValue(dlt_list2.getTotalRow());
        }
    }


};

// 마감상태 조회
scwin.closingSttsSearch = async function(){
    dma_item.setEmptyValue();
    const sbmOptions = {
        id: "sbm_closingstatus",
        action: "/api/listing/lstproc/pf/new-listing-closing/closing-status",
        method: "get",
        target: "dma_item=body",
        isProcessMsg: false
    };

    await $c.sbm.executeDynamic(sbmOptions, {'taskDd' : edt_TASK_DD.getValue()});
}


//이후 영업일/상장일 조회
scwin.nextBzSearch = async function(){
    const sbmOptions = {
        id: "sbm_nextbzday",
        action: "/api/listing/lstproc/pf/new-listing-closing/next-bz-day",
        method: "get",
        isProcessMsg: false
    };

    var result = await $c.sbm.executeDynamic(sbmOptions, {'taskDd' : edt_TASK_DD.getValue()});
    if(result.responseJSON.success){
        edt_LIST_DD.setValue(result.responseJSON.body.listDd);
    }
}



//마감처리
scwin.fn_trsend = async function() {
    res = await $c.win.confirm("[마감] 처리 하겠습니까?");
    if (res) {
        var req = {
            "taskDd" : edt_TASK_DD.getValue(),     //마감일
            "listDd" : edt_LIST_DD.getValue(),     //상장일
            "closingTpCd" : 1 //마감,재마감 구분코드
        };

        const sbmOptions = {
            id: "sbm_recvone",
            action: "/api/listing/lstproc/pf/new-listing-closing/closing-procsss",
            method: "post",
            isProcessMsg: false
        };

        var result = await $c.sbm.executeDynamic(sbmOptions, req);
        if(result.responseJSON.success){
            scwin.fn_list_sync();
            $c.win.alert($c.data.getMessage("com_complete_0058"));
        }
    }
};



//재마감
scwin.fn_re_trsend = async function() {
    scwin.procJob = "재마감처리";
    var res = await $c.win.confirm("[재마감] 처리 하겠습니까?");
    if (res) {
       var req = {
            "taskDd" : edt_TASK_DD.getValue(),     //마감일
            "listDd" : edt_LIST_DD.getValue(),     //상장일
            "closingTpCd" : 2 //마감,재마감 구분코드
        };

        const sbmOptions = {
            id: "sbm_recvone",
            action: "/api/listing/lstproc/pf/new-listing-closing/closing-procsss",
            method: "post",
            isProcessMsg: false
        };

        var result = await $c.sbm.executeDynamic(sbmOptions, req);
        if(result.responseJSON.success){
            scwin.fn_list_sync();
            $c.win.alert($c.data.getMessage("com_complete_0058"));
        }
    }
};



// 재/마감버튼 control
scwin.buttonTrSend = function() {
    //마감
    if ($c.stf.getObjectValue(txb_BZ_CLS_TM) == "") {
        btn_TrSend.setDisabled(false);
    } else {
        btn_TrSend.setDisabled(true);
    }

    //재마감 Button 
    if (scwin.pUsrTpCd == "1") {
        //운영자
        btn_ReTrSend.setDisabled(false);
        btn_ReTrSend.show('');
    } else {
        btn_ReTrSend.setDisabled(true);
        btn_ReTrSend.hide();
    }
};

//그리드 엑셀다운로드
scwin.fn_ExcelDown = function() {
    if (MaxTab_01.getSelectedTabIndex() == 0) {
        const today = $c.date.getServerDateTime("yyyyMMddHHmmss");
        const options = {
            fileName : "ULDSTF09330_상장형 수익증권 신규상장 마감처리목록_" + today,
            sheetName : "리스트",
        };

        $c.data.downloadGridViewExcel(grd_New_Proc, options);

    } else if (MaxTab_01.getSelectedTabIndex() == 1) {
        const today = $c.date.getServerDateTime("yyyyMMddHHmmss");
        const options = {
            fileName : "ULDSTF09330_상장형 수익증권 신규상장 송신목록_" + today,
            sheetName : "리스트",
        };

        $c.data.downloadGridViewExcel(grd_New_Search, options);
    }
};


scwin.btn_Search_onclick = function() {
    scwin.fn_list_sync();
};

//마감처리 엑셀다운로드
scwin.btn_ProcExcel_onclick = function() {
    scwin.fn_ExcelDown();
};

//마감처리내역 엑셀다운로드
scwin.btn_SearchExcel_onclick = function() {
    scwin.fn_ExcelDown();
};


//마감처리
scwin.btn_TrSend_onclick = function() {
    scwin.fn_trsend();
};

//재마감처리
scwin.btn_ReTrSend_onclick = function() {
    scwin.fn_re_trsend();
};


//탭클릭
scwin.MaxTab_01_ontabclick = function (tabId, index) {
    if (index == 0) {
        edt_TASK_DD.setDisabled(true);
        edt_TASK_DD.setValue($c.date.getServerDateTime());
    } else if (index == 1) {
        edt_TASK_DD.setDisabled(false);
    }
    
    scwin.fn_list_sync();
};
]]></script>

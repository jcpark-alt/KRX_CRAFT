<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="750" arfsrc="../js/arf.vbs" componentset="unicode">
    <import>
	</import>
	<style>
	@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_List">
			<property useupdate="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_Top" class="TopCondition_01" left="5" top="7" width="1255" height="40">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_6" class="TopCondition_01" left="10" top="10" width="80" height="20" text="회사코드(명)">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_IsurCd" class="TopCondition_01_write" left="95" top="10" width="45" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
			<textbox id="txb_IsurNm" class="TopCondition_01_read" left="145" top="10" width="210" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
			<image id="btn_IsuCdSearch" left="360" top="10" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_Search" left="1200" top="8" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="image_1" left="1185" top="8" width="2" height="22" src="../img/img_line2.gif"></image>
		</panel>
		<mxgrid id="grd_List" class="Grid_01" left="5" top="52" width="1255" height="637">
			<property borderstyle="0" colsizing="True" editable="False" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" titleheight="40" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" usingoneclick="0" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="NO" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<fcolumn id="DSC_YN" width="60" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="공시검토\\여부" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<fcolumn id="MKTACT_ENFORCE_DD" width="80" mask="XXXX-XX-XX" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="시행일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<fcolumn id="ADMISU_DESIGN_BZ_TP_NM" width="180" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="구분" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<fcolumn id="ISU_NM" width="174" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="종목명" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<column id="ADMISU_RSN_NM" width="300" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="지정사유" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="BFCHG_DELIST_BAS_DD_CONTN" width="200" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경전 유의사항" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="AFCHG_DELIST_BAS_DD_CONTN" width="200" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경후 유의사항" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="CHG_RSN_CONTN" width="250" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="변경/해제 사유" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="ADMISU_DESIGN_GRND_REGUL_NM" width="200" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="근거규정" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="REMK" width="150" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="기타" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="LST_EMP_NM" width="80" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="최종처리자" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="BZ_PROCS_NO" width="110" show="True" sort="True" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="업무처리번호" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
			</format>
			<ref dataid="dts_List"></ref>
		</mxgrid>
		<panel id="panel_page" left="5" top="715" width="115" height="20">
			<extproperty></extproperty>
	</panel>
		<image id="img_Excel" left="1180" top="715" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_Close" left="1127" top="715" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_Regist" left="1072" top="715" width="50" height="22" src="../img/btn_new.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<mxcombo id="cmb_RegistTyp" class="TopCondition_01" left="820" top="715" width="247" height="20">
			<property bindcolumn="value" cbdata="(null)^선택해주세요,0^관리종목지정,1^관리종목지정사유변경,2^관리종목지정사유 및 유의사항변경,3^유의사항변경,4^관리종목지정해제,5^상장폐지기준 적용 유예,6^상장폐지기준 적용 유예기간 변경" cbdatacolumns="value,text" enable2="True" index="0" listcount="10" listexprformat="text^0^300"></property>
			<extproperty font-size="12"></extproperty>
		</mxcombo>
		<label id="label_3" class="TopCondition_01" left="742" top="715" width="80" height="20" text="신규등록구분"></label>
		<label id="label_42" class="Red_Bold" left="130" top="700" width="604" height="20" text="※ 동일 결산기 반기 검토의견 미달(부적정, 의견거절)로 관리종목 지정 후 온기 의견미달 감사보고서 제출 시">
			<extproperty font-weight="normal" color="#000000"></extproperty>
		</label>
		<label id="label_1" class="Red_Bold" left="146" top="720" width="589" height="20" text="관리종목 지정사유 변경으로 조치 (반기검토의견 미달 사유 삭제 및 상장폐지 사유의 발생 사유 추가)">
			<extproperty font-weight="normal" color="#000000"></extproperty>
		</label>
	</components>
<script><![CDATA[
	#include("../js/common.js");
	#include("../js/stf.js");				// 호출메뉴ID를 식별하기 위한 함수사용
	#include("../js/list_common.js"); 	// 상장관련공통함수
	#include("../js/libRoundPanel.js");
	#include("../js/session.js");  		// 세션정보를 얻기위한 함수사용

	var pMenuID = InfoMenuID();
	var fr_SecuGrpId = fn_getSecuGrpId(InfoMenuID()); // mid 부모프레임으로 부터 받은 menu id로 증권그룹id를 반환하는 함수 호출, 법인선택팝업에서 fr_SecuGrpId 변수를 참조. 
	var fr_MktId     = fn_getMktId();			 	  // 시장구분코드(유가, 코스닥) 전체), 기준은 로그인 사용자의 부서 소속을 기준으로 한다.
	var fn_GetPar, fn_SetPar;
	var spacYN = "N";  //기업인수목적 회사 구분
	var vScrenID = "ULDSTF05214.gfm";
	var chkRowIndex = 0;
	var hist_bz_procs_no = "";
	
	function fn_search() {
	
		var url = "/administrativeIssue.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchAdministrativeIssue" + 
				      "&DIV_IDX="+DIV_IDX_ADMISU_LIST + "&TRS_IDX="+TRS_IDX_SELECT + "&ISUR_CD=" + txb_IsurCd.value  ;
		dts_List.DataID = encodeURI(url); 
		dts_List.reset();
		ShowWin(grd_List);
	}
	
	// dialog 호출용 함수
	// 예비심사청구제출기관 호출관련
	function fn_GetParIsur(arrPar) {  			 // 넘길 인수를 지정하는 펑션
		arrPar[0] = getObjectValue(txb_IsurCd);   // 코드값을 포함할 컨트롤
		arrPar[1] = getObjectValue(txb_IsurNm);	  // 명칭값을 포함할 컨트롤
		arrPar[2] = fr_SecuGrpId;	  					  // 명칭값을 포함할 컨트롤

		return arrPar.length;
	} 

	function fn_SetParIsur(arrPar) {
		txb_IsurCd.value = arrPar[0].ISUR_CD; 
		txb_IsurNm.value = arrPar[0].COM_NM; 
		fn_search();
	}
	
	function fn_GetParUpdate(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = txb_IsurCd.value;  // 발행기관코드값
		arrPar[1] = txb_IsurNm.value; // 발행기관명
		arrPar[2] = fr_SecuGrpId;	   // 증권그룹구분	
		arrPar[3] = fr_MktId;		       // 시장구분
		arrPar[4] = dts_List.NameString(dts_List.RowPosition, "bz_procs_no");                           // 업무처리번호
		arrPar[5] = dts_List.NameString(dts_List.RowPosition, "ADMISU_DESIGN_BZ_TP_CD")  ; // 관리종목지정업무구분코드
		arrPar[6] = spacYN;			  //기업인수목적회사 구분_2010.05.30
		arrPar[7] = dts_List.NameString(dts_List.RowPosition, "ISU_CD");                                   // 종목코드
		arrPar[8] = dts_List.NameString(dts_List.RowPosition, "ISU_NM")  ;                                // 종목명
		
		return arrPar.length;
	} 
	
	function fn_GetParNew(arrPar) { // 신규생성시 지정하는 평션
		arrPar[0] = txb_IsurCd.value;  // 발행기관코드값
		arrPar[1] = txb_IsurNm.value; // 발행기관명
		arrPar[2] = fr_SecuGrpId;	   // 증권그룹구분	
		arrPar[3] = fr_MktId;		      // 시장구분
		arrPar[4] = "";				          // 신규작성시 업무처리번호는 없다.
		arrPar[5] = cmb_RegistTyp.BindColVal; // 관리종목지정업무구분코드
		arrPar[6] = spacYN;			  //기업인수목적회사 구분_2010.05.30
	}
	
	function  fn_newpre_create_frame(arg  ) {
		/*
		0:관리종목지정
		1:관리종목사유변경
		2:관리종목사유및상장폐지기준일변경
		3:상장폐지기준일변경
		4:관리종목지정해제
		*/
		if(spacYN == "N"){
			switch (arg) {
			case "0":
				frame.CreateDialogFrame("DLG_0","../lstproc/ULDSTF05215.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 관리종목지정", 200, 50, 620 , 450 , "window");
				break;
			case "1":
				frame.CreateDialogFrame("DLG_1","../lstproc/ULDSTF05216.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 관리종목지정 사유변경", 200, 5, 620 , 520 , "window");
				break;                       
			case "2":                        
				frame.CreateDialogFrame("DLG_2","../lstproc/ULDSTF05217.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 관리종목지정 사유 및 유의사항 변경", 200, 50, 620 , 650 , "window");
				break;                       
			case "3":                        
				frame.CreateDialogFrame("DLG_3","../lstproc/ULDSTF05218.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 유의사항 변경", 200, 50, 620 , 520 , "window");
				break;                       
			case "4":                        
				frame.CreateDialogFrame("DLG_4","../lstproc/ULDSTF05219.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 관리종목지정 해제", 200, 50, 615 , 450 , "window");
				break;
			case "5":                        
				frame.CreateDialogFrame("DLG_5","../lstproc/ULDSTF05226.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 상장폐지기준 적용 유예", 200, 50, 620 , 450 , "window");
				break;                       
			case "6":                        
				frame.CreateDialogFrame("DLG_6","../lstproc/ULDSTF05227.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 상장폐지기준 적용 유예기간 변경", 200, 50, 620 , 450 , "window");
				break;	
			}
		}else{
			switch (arg) {
			case "0":
				frame.CreateDialogFrame("DLG_0","../lstproc/ULDSTF05215.gfm",  " 기업인수목적회사 관리종목지정", 200, 50, 615 , 430 , "window");
				break;
			case "1":
				frame.CreateDialogFrame("DLG_1","../lstproc/ULDSTF05216.gfm",   "기업인수목적회사 관리종목지정 사유변경", 200, 5, 620 , 520 , "window");
				break;                       
			case "2":                        
				frame.CreateDialogFrame("DLG_2","../lstproc/ULDSTF05217.gfm",   " 기업인수목적회사 관리종목지정 사유 및 유의사항 변경", 200, 50, 615 , 650 , "window"); 
				break;                       
			case "3":                        
				frame.CreateDialogFrame("DLG_3","../lstproc/ULDSTF05218.gfm",   " 기업인수목적회사 유의사항 변경", 200, 50, 615 , 450 , "window");
				break;                       
			case "4":                        
				frame.CreateDialogFrame("DLG_4","../lstproc/ULDSTF05219.gfm",  " 기업인수목적회사 관리종목지정 해제", 200, 50, 615 , 450 , "window");
				break;
			case "5":                        
				frame.CreateDialogFrame("DLG_5","../lstproc/ULDSTF05226.gfm",  " 기업인수목적회사 상장폐지기준 적용 유예", 200, 50, 615 , 450 , "window");
				break;                       
			case "6":                        
				frame.CreateDialogFrame("DLG_6","../lstproc/ULDSTF05227.gfm",  " 기업인수목적회사 상장폐지기준 적용 유예기간 변경", 200, 50, 615 , 450 , "window");
				break;	
			}
		}
		
		//fn_search() ; // 다이얼로그 창이 닫히면 조회를 보낸다.
		cmb_RegistTyp.index = 0 
	}
]]></script>

<events><event for="img_Excel" eventname="onclick"><![CDATA[
	if (dts_List.CountRow > 0) {
		//엑셀 로그 
		doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
		grd_List.GridToExcel(fn_getSecuGrpNm(fr_SecuGrpId) +  "괸리종목지정내역", "", "8");
	} else {
		alert( NO_EXCEL_DATA );
	}
]]></event>

<event for="img_Search" eventname="onclick"><![CDATA[
	if (txb_IsurCd.value != "") {
		fn_search();
	} else {
		alert(getMessageParam("MSG-0013", ""));
	}
]]></event>

<event for="btn_IsuCdSearch" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsur;
	fn_SetPar = fn_SetParIsur;
	
	//기업인수목적 회사와 주권 목록을 나눔 2010.05.30
	if(pMenuID == "STF05214"){
		fn_PopFindCorpChrgSW(fr_SecuGrpId, "2");
	}
	else if(pMenuID == "STF05263"){ //기업인수목적 회사
		fn_PopFindCorpChrgSW(fr_SecuGrpId, "1");
		spacYN = "Y";					
	}
	else{
		fn_PopFindCorpChrg(fr_SecuGrpId);
	}
	
	//fn_PopFindCorpChrg(fr_SecuGrpId);
]]></event>

<event for="dts_List" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_List);
]]></event>

<event for="dts_List" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	FillGridHeaderTotalCnt(rowcount, panel_page);
	CloseWin(rowcount, grd_List); 
]]></event>

<event for="img_Close" eventname="onclick"><![CDATA[
	window.close();
]]></event>

<event for="img_Regist" eventname="onclick"><![CDATA[
	if (txb_IsurCd.value == "") {
		alert(getMessageParam("MSG-0013", ""));
		txb_IsurCd.focus();
		return true;
	} 
	if ( cmb_RegistTyp.index == 0 ) {
		alert(getMessageParam("MSG-0014", ""));
		cmb_RegistTyp.focus();
		return true;
	}
	
	fn_GetPar = fn_GetParNew;  //신규작성
	fn_SetPar = undefined;
	fn_newpre_create_frame(cmb_RegistTyp.BindColVal );
	
	for (var i = 1; i <= dts_List.CountRow; i++) {
		dts_List.NameString(i, "CHECK") = "F";
	}
]]></event>
<event for="grd_List" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_GetPar = fn_GetParUpdate; // 수정시 인수를 넘기는 function을 fn_GetPar란 변수에 할당, (팝업화면에서 참조하는 변수명이 fn_GetPar임)
	fn_SetPar = undefined;
	
	// 관리종목지정업무구분코드 값 넘겨야함
	fn_newpre_create_frame(dts_List.NameString(dts_List.RowPosition, "ADMISU_DESIGN_BZ_TP_CD") ) ;
]]></event>
<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top);
]]></event></events>
</gform>

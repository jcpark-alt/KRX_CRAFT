<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="610" height="380" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
		@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Mst">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="ISUR_NM" ctrl="txb_IsurNm" param="value" readonly="False"></column>
				<column col="MKTACT_ENFORCE_DD" ctrl="edt_MktactEnforceDd" param="text" readonly="False"></column>
				<column col="CHG_DD" ctrl="edt_ChgDd" param="text" readonly="False"></column>
				<column col="REMK" ctrl="txa_Remk" param="text" readonly="False"></column>
				<column col="ISUR_CD" ctrl="txb_IsurCd" param="value" readonly="False"></column>
				<column col="FISCYY_CHG_RSN_CD" ctrl="cmb_FiscyyChgRsnCd" param="BindColVal" readonly="False"></column>
				<column col="FISCYY_CHG_STRT_DD" ctrl="edt_ChgStatDd" param="text" readonly="False"></column>
				<column col="FISCYY_CHG_END_DD" ctrl="edt_ChgEndDd" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_DtlBf">
			<property syncload="True" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_DtlAf">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxbinder id="bnd_DtlAf">
			<property activebind="true"></property>
			<bindinfo>
				<column col="BAS_MMDD" ctrl="edt_BasMmDdAf" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_DtlAf"></ref>
		</mxbinder>
		<mxbinder id="bnd_DtlBf">
			<property activebind="true"></property>
			<bindinfo>
				<column col="BAS_MMDD" ctrl="edt_BasMmDdBf" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_DtlBf"></ref>
		</mxbinder>
		<mxdataset id="dts_BZ_CHECK">
			<property syncload="True" usechangeinfo="True" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_ByCorpDepCd">
			<property syncload="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_Item" left="5" top="5" width="595" height="335" class="TopCondition_01">
			<extproperty></extproperty>
			<label id="label_5" class="TopCondition_01" left="40" top="85" width="90" height="20" text="나. 변경후(월)">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="left"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="40" top="60" width="90" height="20" text="가. 변경전(월)">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="left"></extproperty>
			</label>
			<label id="label_11" class="TopCondition_01" left="19" top="9" width="111" height="20" text="1. 회사코드(명)">
			<extproperty font-size="12" color="#343434" background-color="#d9e9fc"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="19" top="34" width="111" height="20" text="2. 결산기 변경내역">
			<extproperty font-size="12" color="#343434" background-color="#d9e9fc"></extproperty>
			</label>
			<label id="label_9" class="TopCondition_01" left="10" top="160" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_3" class="TopCondition_01" left="29" top="85" width="10" height="20" text="*">
			<extproperty font-size="12" color="#343434" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_13" class="Comment_02" left="240" top="135" width="170" height="20" text="(시스템 반영일자를 입력)">
			<extproperty font-size="12"></extproperty>
			</label>
			<image id="img_MktactEnforceDd" left="215" top="135" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_MktactEnforceDd" class="panel_maskedit_write_01" left="140" top="135" width="70" height="18" tabindex="5">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="label_6" class="TopCondition_01" left="20" top="135" width="110" height="20" text="4. 시장조치시행일">
			<extproperty font-size="12" background-color="#d9e9fc"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="135" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_4" class="TopCondition_01" left="10" top="110" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_12" class="TopCondition_01" left="20" top="110" width="110" height="20" text="3. 변경일">
			<extproperty font-size="12" background-color="#d9e9fc"></extproperty>
			</label>
			<mxmaskedit id="edt_ChgDd" class="panel_maskedit_write_01" left="140" top="110" width="70" height="18" tabindex="4">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_ChgDd" left="215" top="110" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_15" class="TopCondition_01" left="20" top="160" width="135" height="20" text="5. 변경 후 최초 사업연도">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_14" class="TopCondition_01" left="10" top="236" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_10" class="TopCondition_01" left="20" top="236" width="110" height="20" text="6. 변경사유">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_7" class="TopCondition_01" left="20" top="261" width="110" height="20" text="7. 기타">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<mxcombo id="cmb_FiscyyChgRsnCd" class="TopCondition_01" left="140" top="236" width="440" height="20" tabindex="8">
			<property bindcolumn="code" cbdata="1^임시주주총회에서 결의,2^정기주주총회에서 결의,9^기타" cbdatacolumns="code,value" listcount="10" listexprformat="value^0^410"></property>
			</mxcombo>
			<mxmaskedit id="edt_ChgEndDd" class="panel_maskedit_write_01" left="140" top="211" width="70" height="18" tabindex="7">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_ChgStatDd" left="215" top="185" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_ChgEndDd" left="215" top="211" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_17" class="TopCondition_01" left="64" top="211" width="65" height="20" text="나. 종료일">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="left"></extproperty>
			</label>
			<label id="label_16" class="TopCondition_01" left="64" top="185" width="65" height="20" text="가. 시작일">
			<extproperty font-size="12" background-color="#d9e9fc" text-align="left"></extproperty>
			</label>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="140" top="261" width="438" height="68" tabindex="8">
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<textbox id="txb_IsurCd" class="TopCondition_01_write" left="140" top="9" width="60" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<textbox id="txb_IsurNm" class="TopCondition_01_write" left="205" top="9" width="375" height="20" readonly="readonly" maxlength="1000" tabindex="1">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
			<mxmaskedit id="edt_BasMmDdBf" class="panel_maskedit_read_01" left="140" top="60" width="55" height="18" tabindex="2">
			<property alignment="1" datemodify="True" format="MM월DD일" generaledit="False" inputformat="MMDDYY" iscomma="False" maxlength="4" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_BasMmDdAf" class="panel_maskedit_write_01" left="140" top="86" width="55" height="18" tabindex="3">
			<property alignment="1" datemodify="True" format="MM월DD일" generaledit="False" inputformat="MMDDYY" maxlength="4" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_ChgStatDd" class="panel_maskedit_write_01" left="140" top="185" width="70" height="18" tabindex="6">
			<property alignment="1" datemodify="True" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
		</panel>
		<image id="btn_Save" left="235" top="350" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="290" top="350" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="345" top="350" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Drft" left="401" top="350" width="50" height="22" src="../img/btn_draft.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="455" top="350" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Close" left="550" top="350" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var Isur_cd = "", Isur_nm = "", Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" , haltTpCd = "";

	var trsIdx ;  // insert, update 구분
	var fn_GetPar , fn_SetPar ;
	var TR_JOB;
	var vScrenID = "ULDSTF05203.gfm";

	function fn_read_sync() {
		if (fr_bz_procs_no != "") {
			var url = "/fiscalYearChange.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchFiscalYearChange" + 
						"&DIV_IDX="+DIV_IDX_FSC_MST + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			
			dts_Mst.DataID = encodeURI(url);
			dts_Mst.reset();	

			url = "/fiscalYearChange.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchFiscalYearChange" + 
			      "&DIV_IDX="+DIV_IDX_DTL_FSC_BF + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			 
			dts_DtlBf.DataID = encodeURI(url);
			dts_DtlBf.reset();
			
			url = "/fiscalYearChange.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchFiscalYearChange" + 
			      "&DIV_IDX="+DIV_IDX_DTL_FSC_AF + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			 
			dts_DtlAf.DataID = encodeURI(url);
			dts_DtlAf.reset();
		}
	}
	
	function fn_new_onload() {

		dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=FSCCHG_MST_INOUT";
		dts_Mst.reset();
		
		dts_DtlAf.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=FSCCHG_DTL_INOUT";
		dts_DtlAf.reset();

		/* useupdate를 false로 지정함. */
		var url = "/fiscalYearChange.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchFiscalYearChange" + 
				      "&DIV_IDX="+DIV_IDX_DTL_FSC_BF + "&TRS_IDX="+TRS_IDX_NEWSEL + "&ISUR_CD=" + Isur_cd  ;
				  
		dts_DtlBf.DataID = encodeURI(url); /* 관련종목을 모두 담고 SELECT 컬럼의 플래그로 선택여부를 확인한다. */
		dts_DtlBf.reset();
		
	}

	function fn_CheckForm() {

		if ( edt_BasMmDdAf.text == "" ) {
			alert("[변경후]를  선택해주세요"); 	edt_BasMmDdAf.focus(); return false;
		}
		
		if (edt_ChgDd.text.length != 8 ) { alert("[변경일]을 정확히 입력하세요."); edt_ChgDd.focus(); return false; }		
		if ( ! checkDdTm ( "DD" , edt_MktactEnforceDd   , "시장조치시행"  , false )  ) return false ; 
		
		if ( cmb_FiscyyChgRsnCd.BindColVal == "" ) {
			alert("[변경사유]를  선택해주세요"); 	cmb_FiscyyChgRsnCd.focus(); return false;
		}		

		if ( ! checkMaxLength( txa_Remk , 2000 , "기타" ) ) return false ;

		if (! fn_check_bz_doubleinput(	dts_BZ_CHECK, 
														getObjectValue(txb_IsurCd),
														getObjectValue(edt_ChgDd),
														fr_bz_procs_no,
														LIST_BZ_TP_CD_231)) {
			return false;
		}
		
		return true;
	}
	
	function fn_save_trs() {
			
		//매매거래정지 사유는 매번 업무처리 번호를 세팅함
		//사유별 추가,삭제가 있을수 있기때문
		for (var i = 1 ; i <= dts_DtlBf.CountRow ; i++) { 
			dts_DtlBf.NameString(i, "BZ_PROCS_NO") = fr_bz_procs_no 
			dts_DtlBf.NameString(i, "BYBZPROCS_SEQ") = eval(i + 0 ) ;
			dts_DtlBf.NameString(i, "ISUR_CD") = Isur_cd 
			dts_DtlBf.NameString(i, "CHG_BFAF_TP_CD") = "1" ; // 변경전후구분코드 , 1:변경전 , 2:변경후
		};
		for (var i = 1 ; i <= dts_DtlAf.CountRow ; i++) { 
			dts_DtlAf.NameString(i, "BZ_PROCS_NO") = fr_bz_procs_no 
			dts_DtlAf.NameString(i, "BYBZPROCS_SEQ") = eval( i + 12  );
			dts_DtlAf.NameString(i, "ISUR_CD") = Isur_cd 
			dts_DtlAf.NameString(i, "CHG_BFAF_TP_CD") = "2" ; // 변경전후구분코드 , 1:변경전 , 2:변경후
		};
		
		var vScrenProcTpCd;
		if(TR_JOB == "I"){
			vScrenProcTpCd = SCREN_PROCS_TP_CD_02;
		}
		else if(TR_JOB == "U"){
			vScrenProcTpCd = SCREN_PROCS_TP_CD_03;
		}
		else if(TR_JOB == "D"){
			vScrenProcTpCd = SCREN_PROCS_TP_CD_04;
		}

		trs.Action 	     = fn_encodeNSession( "/fiscalYearChange.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+vScrenProcTpCd+"&method=saveFiscalYearChange" ) ;
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_DtlAf, I:dtsParm3= dts_DtlBf)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=3" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_231 + 
								",DIV_IDX[0]=" + DIV_IDX_FSC_MST+
								",DIV_IDX[1]=" + DIV_IDX_DTL_FSC_AF+
								",DIV_IDX[2]=" + DIV_IDX_DTL_FSC_BF;
								
		trs.Post();
		
	}
	
	function fn_save() {
		TR_JOB = 'I';
		if (fn_CheckForm()) {
			if (! fn_isProcess('I') )  return ;
			if (! fn_mst_check( dts_BZ_CHECK ,"1" ) )  return ;
			fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );
			if (fr_bz_procs_no.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {
				trsIdx = TRS_IDX_INSERT ;
				dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO") = fr_bz_procs_no;
				dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = Isur_cd;
				dts_Mst.NameString(dts_Mst.RowPosition, "FISCYY_DISTR_BASDD_TP_CD") = "1"; // 1:결산기 , 2:분배기준일
				fn_save_trs();
			}
		}
	}
	
   function fn_update() {
		TR_JOB = 'U';
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			fn_save_trs();
		}	
	}

	function fn_delete() {

		TR_JOB = 'D';
		
		if (! fn_check_delete_discls(dts_BZ_CHECK, fr_bz_procs_no) )  return;
	
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_save_trs();
	}
	
	function fn_dscl() {
	
		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2,param_dts3) {
			arr[0] = "68212A";
			arr[1] = fr_bz_procs_no;
			arr[2] = Isur_cd ;
			
			//CopyDataSet( dts_Isu , param_dts_isu) ;
			CopyDataSet( dts_Mst , param_dts_mst) ;
			CopyDataSet( dts_DtlBf , param_dts2) ;
			CopyDataSet( dts_DtlAf , param_dts3) ;
			
			return arr.length;
		}
		fn_SetPar = function(arr) { }
	
		var wth = 730 + 5;
		var hgt = 785 + 30;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}

	function fn_drft() {
		var OldGet = fn_GetPar;
		
		fn_GetPar = function(arr) {
			arr[0] = fr_bz_procs_no ;
			return arr.length;
		}
		
		fn_PopFindDraft();
		fn_GetPar = OldGet;
	}
	
	function fn_makt() { }
]]></script>

<events><event for="trs" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
]]></event>

<event for="trs" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	
	if (buttonSet.status == "D") { // 삭제처리의 응답인 경우
		frame.CloseFrame();
	} else {
		fn_read_sync();
	}	
]]></event>

<event for="dts_BZ_CHECK" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_BZ_CHECK);
]]></event>

<event for="dts_Mst" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Mst);
]]></event>

<event for="dts_DtlBf" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_DtlBf);
]]></event>


<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[

	if (fr_bz_procs_no == "") {	dts_Mst.AddRow(); 	}
			
	// 신규처리에 의한 조회인지,  수정에 의한 조회인지를 구별
	if (fr_bz_procs_no == "") {
		buttonSet.setInsertStatus();
	} else {
		setButtonSetWithDate( edt_MktactEnforceDd , false ) ;
		//alert('[DISCLS_YN]'+dts_Mst.NameValue(1, "DISCLS_YN"));
		setButtonSetWithDate2( dts_Mst.NameValue(1, "DISCLS_YN") ) ;
	}
	
	//alert(" dts_TrdSsp OnLoadCompleted \n" + dts_TrdSsp.Text  + "\n\n" + fn_logDSet(dts_TrdSsp) ); 
]]></event>

<event for="dts_DtlBf" eventname="OnLoadCompleted(rowcount)"><![CDATA[
//	if (fr_bz_procs_no == "") {	dts_DtlBf.AddRow(); 	}
//	alert(dts_DtlBf.Text);
]]></event>

<event for="dts_DtlAf" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (fr_bz_procs_no == "") {	dts_DtlAf.AddRow(); 	}
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="img_ChgDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ChgDd);
]]></event>

<event for="img_MktactEnforceDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_MktactEnforceDd);
]]></event>

<event for="img_ChgStatDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ChgStatDd);
]]></event>

<event for="img_ChgEndDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ChgEndDd);
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar; // Provider화면에서 fn_GetPar명칭으로 선언된 함수를 획득
	var arrPar = new Array;
	
	if (fnc != undefined) {
		fnc(arrPar); // Provider화면의 callback함수를 호출하여 필요한 인수를 넘겨받는다.
		Isur_cd 		        = (arrPar.length >= 1 ? arrPar[0] : "");	// 발행기관코드
		Isur_nm 		        = (arrPar.length >= 2 ? arrPar[1] : "");	// 발행기관명
		Secugrp_id 		    = (arrPar.length >= 3 ? arrPar[2] : "");	// 증권그룹ID
		Mkt_id	    	        = (arrPar.length >= 4 ? arrPar[3] : "");	// 시장구분코드
		fr_bz_procs_no 	= (arrPar.length >= 5 ? arrPar[4] : "");	// 업무처리번호(수정시만 유효)
		haltTpCd		        = (arrPar.length >= 6 ? arrPar[5] : "");	 // 결산기분배기준일구분코드 1 : 결산기, 2 : 분배기준일
	}
	
	//alert( "Isur_cd =  " +Isur_cd + "\n"  + " Isur_nm = " + Isur_nm + "\n" + "  Secugrp_id = " + Secugrp_id + "\n" + 
	//		 "Mkt_id =  " +Mkt_id + "\n" + " fr_bz_procs_no = " + fr_bz_procs_no+ "\n"  ) ;
			
	/* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 		// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 	// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );			// 안내문작성
	buttonSet.setDrftInfo( btn_Drft, fn_drft );			// 기안

	if (fr_bz_procs_no != "")  { // Provider화면 에서 넘겨받은 업무처리번호가 ""가 아니라면 신규작성으로 간주한다.
		fn_read_sync(); 
	} else {
		fn_new_onload();    // 신규작성시 호출
	}
	
	dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") = Isur_cd;			
	dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_NM") = Isur_nm;			
	
	PanelToGroupBox(panel_Item);

	buttonSet.setButtonDepCd(dts_ByCorpDepCd, Isur_cd, js_dep_cd);

]]></event></events>
</gform>

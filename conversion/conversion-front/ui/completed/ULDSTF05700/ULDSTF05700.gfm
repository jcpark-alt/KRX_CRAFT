<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="750" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
	@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Recv">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_List">
			<property syncload="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_Top" class="TopCondition_01" left="5" top="5" width="1255" height="40">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_26" class="TopCondition_01" left="9" top="11" width="80" height="20" text="회사코드(명)">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ISUR_CD" class="TopCondition_01_write" left="93" top="11" width="55" height="20" readonly="readonly" maxlength="5">
			<extproperty background-color="#b9d4f7" border-style="solid" border-width="1" border-color="#92b1f1" text-align="center"></extproperty>
		</textbox>
			<image id="img_COM_NM" left="384" top="12" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<textbox id="txb_COM_NM" class="TopCondition_01_write" left="154" top="11" width="224" height="20" readonly="readonly" maxlength="1000" tabindex="1">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
			<image id="img_tmp_11" left="1190" top="5" width="2" height="30" src="../img/img_line2.gif"></image>
			<image id="btn_Search" left="1198" top="9" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<label id="label_1" class="TopCondition_01" left="5" top="48" width="100" height="20" text="발행예정종목">
			<extproperty font-weight="bold" font-size="12" color="#333399" border-style="solid" border-width="0" border-color="#000000"></extproperty>
		</label>
		<textbox id="edt_TotalCnt_1" class="panel_text_write_01" left="1160" top="50" width="100" height="20" readonly="readonly" maxlength="1000">
			<extproperty text-align="right"></extproperty>
		</textbox>
		<mxgrid id="grd_List" class="Grid_01" left="5" top="250" width="1253" height="465">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" titleheight="37" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="NO" width="40" name="번호" align="center" color="#343434" value="{CurRow},{ToString}"></fcolumn>
				<column id="DISCLS_YN" width="60" name="공시검토;여부" align="center"></column>
				<column id="ISU_KOR_NM" width="210" show="True" sort="True" name="종목명" align="left"></column>
				<column id="ISU_KOR_ABBRV" width="190" show="False" sort="True" name="종목약명" align="left"></column>
				<column id="ISU_ENG_NM" width="190" show="False" sort="True" name="종목영문명" align="left"></column>
				<column id="ISU_ENG_ABBRV" width="190" show="False" sort="True" name="종목영문약명" align="left"></column>
				<column id="LIST_DD" width="80" name="상장일" align="center" color="#343434" mask="XXXX-XX-XX"></column>
				<column id="ISU_DD" width="80" name="발행일" align="center" color="#343434" mask="XXXX-XX-XX"></column>
				<column id="ISU_RND" width="81" show="False" name="발행회차" align="center"></column>
				<column id="LIST_METHD_TP_NM" width="60" name="상장방식" align="center"></column>
				<column id="ISU_RSN_CONTN" width="160" name="발행사유"></column>
				<column id="TARSTK_ISU_NM" width="130" name="목적주권명"></column>
				<column id="LIST_SHRS" width="110" name="상장증권수량" align="right"></column>
				<column id="ISU_SHRS" width="110" name="발행주식수(주)" align="right"></column>
				<column id="TOT_ISU_PRC" width="110" name="발행가액총액(원)" align="right" decao="3"></column>
				<column id="NPARVALSTK_YN" width="80" name="무액면주식;여부" align="center"></column>
				<column id="EXER_PRC" width="110" name="행사가격(원)" align="right" decao="8"></column>
				<column id="EXER_STRT_DD" width="100" name="행사시작일" align="center" color="#343434" mask="XXXX-XX-XX"></column>
				<column id="EXER_END_DD" width="100" name="행사종료일" align="center" color="#343434" mask="XXXX-XX-XX"></column>
				<column id="SUBSRGHT_CONTN" width="150" name="신주인수권의내용"></column>
				<column id="SUBSRGHT_EXERTM_PAYMETHD_CONTN" width="150" name="납입방법"></column>
				<column id="REMK" width="150" name="비고"></column>
				<column id="FNL_EMP_NM" width="100" name="최종처리자" align="center"></column>
				<column id="ISU_CD" width="100" name="종목코드" align="center"></column>
				<column id="DISCLS_ACPT_TP_NM" width="80" show="True" sort="True" name="제출유형" align="center"></column>
				<column id="ACPT_NO" width="110" name="접수번호" align="center"></column>
				<column id="BZ_PROCS_NO" width="110" show="True" sort="True" name="업무처리번호" align="center"></column>
			</format>
			<ref dataid="dts_List"></ref>
		</mxgrid>
		<mxgrid id="grd_Recv" class="Grid_01" left="5" top="69" width="1255" height="149">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" titleheight="31" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="NO" width="40" name="번호" align="center" color="#343434" value="{CurRow},{ToString}"></fcolumn>
				<fcolumn id="DISCLS_ACPT_TP_NM" width="80" show="True" sort="True" name="제출유형" align="center"></fcolumn>
				<column id="ISU_KOR_NM" width="140" name="종목명" align="left"></column>
				<column id="LIST_SHRS" width="120" name="신주인수권증서수" align="right"></column>
				<column id="RGHT_RTO" width="100" name="신주인수비율" align="right" decao="6"></column>
				<column id="EXER_STRT_DD" width="90" name="행사시작일" align="center" mask="XXXX-XX-XX"></column>
				<column id="EXER_END_DD" width="90" name="행사종료일" align="center" mask="XXXX-XX-XX"></column>
				<column id="ISU_DD" width="90" name="발행일" align="center" color="#343434" mask="XXXX-XX-XX"></column>
				<column id="LIST_DD" width="90" name="상장예정일" align="center" color="#343434" mask="XXXX-XX-XX"></column>
				<column id="STKCERT_KIND_NM" width="80" name="주식의종류"></column>
				<column id="NPARVALSTK_YN" width="90" name="무액면주식;여부" align="center"></column>
				<column id="ISU_SHRS" width="90" name="발행주식수" align="right"></column>
				<column id="PARVAL" width="90" name="액면가" align="right" decao="3"></column>
				<column id="EXER_PRC" width="90" name="발행가" align="right" decao="8"></column>
				<column id="TOT_PAR" width="90" name="액면총액" align="right" decao="3"></column>
				<column id="TOT_ISU_PRC" width="90" name="발행총액" align="right" decao="3"></column>
				<column id="SKTAMT_SB_PAY_CONTN" width="200" name="주금대용납입의제사항"></column>
				<column id="NEWSTK_PROFT_DIV_CONTN" width="200" name="신주의이익배당사항"></column>
				<column id="REMK" width="200" name="비고"></column>
				<column id="ACPT_NO" width="110" name="접수번호" align="center"></column>
				<column id="BZ_PROCS_NO" width="110" name="업무처리번호" align="center"></column>
			</format>
			<ref dataid="dts_Recv"></ref>
		</mxgrid>
		<label id="label_11" class="TopCondition_01" left="5" top="230" width="100" height="20" text="증권발행내역">
			<extproperty font-weight="bold" font-size="12" color="#333399" border-style="solid" border-width="0" border-color="#000000"></extproperty>
		</label>
		<textbox id="edt_TotalCnt_2" class="panel_text_write_01" left="1160" top="226" width="100" height="20" readonly="readonly" maxlength="1000">
			<extproperty text-align="right"></extproperty>
		</textbox>
		<image id="btn_Excel" left="1185" top="721" width="73" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Close" left="1132" top="721" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_New" left="1079" top="721" width="50" height="22" src="../img/btn_new.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js");
	#include("../js/utils.js");
	#include("../js/list_common.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	
	var vScrenID = "ULDSTF05700.gfm";
	var fn_GetPar, fn_SetPar;
	var clickBzProcsNo = "";
	var vAcptNo="";
	
	var fr_SecuGrpId = SECUGRP_ID_SW;
	var vOpenTyp = ""; // R=접수, H = 이력, N : 신규
	var pSecuGrpId = SECUGRP_ID_SW;
	
	var gIsurCd;
	var gComAbbrv;
	var gSecugrpId;
	var gMktTpCd;
	var vSPOT_ISU_TRD_MKT_TP_CD = "";

	function fn_GetParIsur(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = txb_ISUR_CD.value; // 발행기관코드값
		arrPar[1] = txb_COM_NM.value; // 발행기관명
		return arrPar.length;
	} 

	function fn_SetParIsur(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			txb_ISUR_CD.value = arrPar[0].ISUR_CD;
			txb_COM_NM.value = arrPar[0].COM_NM;
			vSPOT_ISU_TRD_MKT_TP_CD = arrPar[0].SPOT_ISU_TRD_MKT_TP_CD;
			fn_all_list_sync();
		}
	}

	function fn_getBzProcsNo() {
		return clickBzProcsNo;
	}

	function fn_all_list_sync() {
		fn_recv_list_sync();
		fn_list_sync();
	}
	
	function fn_recv_list_sync() {
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") { // 유가경우
			grd_Recv.ColumnProp("LIST_DD", "Show") = false;
			var url = "/Listing.do";
			url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
			url += "&method=searchIsuIssChgList&DIV_IDX="+DIV_IDX_NEW_ISS_SW_RECV_S + "&ISUR_CD=" + getObjectValue(txb_ISUR_CD) ;
			dts_Recv.DataID = encodeURI(url);
			dts_Recv.reset();
		} else if (vSPOT_ISU_TRD_MKT_TP_CD == "2") { // 코스닥인경우
		    grd_Recv.ColumnProp("LIST_DD", "Show") = true;
			var url = "/Listing.do";
			url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
			url += "&method=searchIsuIssChgList&DIV_IDX="+DIV_IDX_NEW_ISS_SW_RECV_K + "&ISUR_CD=" + getObjectValue(txb_ISUR_CD) ;
			dts_Recv.DataID = encodeURI(url);
			dts_Recv.reset();
		}
	}
	
	function fn_list_sync() {
		var url = "/Listing.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchIsuIssChgList&DIV_IDX="+DIV_IDX_NEW_ISS_SWR_HIST + "&ISUR_CD=" + getObjectValue(txb_ISUR_CD) + "&SECUGRP_ID=" + pSecuGrpId;
		dts_List.DataID = encodeURI(url);
		dts_List.Reset();
	}

	function fn_setBzProcsNo(dsjObj, row) {
		clickBzProcsNo = dsjObj.NameString(eval(row), "BZ_PROCS_NO");
		//alert("fn_setBzProcsNo():"+clickBzProcsNo);
	}
	
	function fn_OpenDetailRecv(row) {
		vOpenTyp = "R";
		fn_setBzProcsNo(dts_Recv, row);
		vAcptNo = dts_Recv.NameString(row, "ACPT_NO");
		if (vAcptNo != "") {
			fn_OpenPopup();
		}
	}

	function fn_OpenDetailMng(row) {
		vAcptNo = ""; //초기화
		if (row > 0 ) { //그리드에서 선택시
			vOpenTyp = "H";
			fn_setBzProcsNo(dts_List, row);
		} else { //신규버튼 선택시
			vOpenTyp = "N";
			clickBzProcsNo = ""; //초기화
		}

		fn_OpenPopup();
	}
	
	function fn_OpenPopup() {
		frame.CreateDialogFrame("ULDSTF05711.gfm", "/lstproc/ULDSTF05710.gfm", "신주인수권증권 신주상장 관리", 200, 200, 860, 490, "window");
	}


]]></script>


<events><event for="btn_Search" eventname="onclick"><![CDATA[
	if (getObjectValue(txb_ISUR_CD) == "") {
		alert("[회사]를 선택하세요.");txb_ISUR_CD.focus();return;
	} else {
		fn_all_list_sync();
	}
]]></event>

<event for="btn_Excel" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	grd_List.GridToExcel("신주인수권증권 발행내역", "", "8");
]]></event>

<event for="img_COM_NM" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsur;
	fn_SetPar = fn_SetParIsur;

	//"1" :신주상장, "2" :변경상장
	fn_PopFindCorpChrgSW(fr_SecuGrpId, "1");
	
	
]]></event>

<event for="btn_New" eventname="onclick"><![CDATA[
	if (getObjectValue(txb_ISUR_CD) == "") {
		alert("[회사]를 선택하세요.");txb_ISUR_CD.focus();return;
	}
	fn_OpenDetailMng(-1);
]]></event>

<event for="grd_Recv" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_OpenDetailRecv(row);
]]></event>

<event for="grd_List" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_OpenDetailMng(row);
]]></event>

<event for="dts_Recv" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Recv);
]]></event>

<event for="dts_List" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_List);
]]></event>


<event for="dts_Recv" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	setObjectValue(edt_TotalCnt_1, "총 " + dts_Recv.CountRow + " 건");
]]></event>

<event for="dts_List" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	setObjectValue(edt_TotalCnt_2, "총 " + dts_List.CountRow + " 건");
	dts_List.RowPosition = dts_List.countrow;
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top);

	var parentWin = fn_GetRecvDocProvider();
	//var parentWin = frame.Provider("../");
	//alert('[parentWin]'+parentWin);
	if (gIsurCd != "" && gIsurCd != undefined) {
		txb_ISUR_CD.value = gIsurCd;
		txb_COM_NM.value = gComAbbrv;
		fr_SecuGrpId =  gSecugrpId; 
		vSPOT_ISU_TRD_MKT_TP_CD = gMktTpCd;
		
		btn_Search.onclick();
	}
]]></event></events>
</gform>

<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="690" height="470" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts_Mst">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Invstwarn">
			<property activebind="true"></property>
			<bindinfo>
				<column col="DESIGN_DD" ctrl="edt_DesignDd" param="text" readonly="False"></column>
			    <column col="DESIGN_RSN" ctrl="txa_Rsn" param="text" readonly="False"></column>
				<column col="ETP_INVSTWARN_CONTN" ctrl="txa_InvstwarnContn" param="text" readonly="False"></column>
			    <column col="MISC" ctrl="txa_Remk" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_Isu_Temp">
			<property usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_DUP_CHK">
			<property syncload="True"></property>
	</mxdataset>
		<mxdataset id="dts_Cand">
			<property syncload="True"></property>
	</mxdataset>
		<mxdataset id="dts_Instwarn">
			<property syncload="True"></property>
	</mxdataset>
	</model>
	<components>
		<panel id="panel_3" left="10" top="10" width="660" height="400" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="10" top="10" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_isu" class="TopCondition_01" left="20" top="10" width="90" height="20" text="1. 지정해제종목">
			<extproperty font-size="12"></extproperty>
			</label>
			<label id="label_rsn" class="TopCondition_01" left="20" top="170" width="90" height="20" text="3. 지정해제사유">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_designdd" class="TopCondition_01" left="20" top="140" width="90" height="20" text="2. 지정해제일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_4" class="TopCondition_01" left="20" top="220" width="90" height="20" text="4. 투자유의사항">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_5" class="TopCondition_01" left="20" top="270" width="90" height="20" text="5. 기타">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<image id="img_DesignDd" left="195" top="140" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxgrid id="grid_1" class="Grid_01" left="120" top="10" width="525" height="120">
			<property borderstyle="0" editable="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="18" xtitleheight="0"></property>
			<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
			<format>
				<column id="BZ_PROCS_NO" width="120" show="False" name="BZ_PROCS_NO" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
				<column id="ISU_CD" width="180" name="종목코드" align="center" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
				<column name="발행회사" id="ISUR_CD" width="120" show="False"></column>
				<column id="ISU_NM" width="200" name="종목명" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
				<column id="BZ_PROCS_NO" width="110" name="업무처리번호" edit="none"></column>
			</format>
			<selectioncolor>
				<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
				<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
				<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
				<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
				<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
				<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
				<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
				<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
				<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
			</selectioncolor>
			<ref dataid="dts_Isu_Temp"></ref>
			</mxgrid>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="120" top="270" width="525" height="120">
			<property wantreturn="True"></property>
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<image id="img_SetIsuCd" left="40" top="35" width="75" height="19" src="../img/btn_isu_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_DesignDd" class="panel_maskedit_write_01" left="120" top="140" width="70" height="20">
			<property alignment="1" border="False" datemodify="True" numeric="False" valign="1"></property>
			<extproperty font-size="12" color="#343434" background-color="#FFFFFF" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<mxtextarea id="txa_InvstwarnContn" class="TextArea_01" left="120" top="220" width="525" height="40">
			<property syncload="False" wantreturn="True"></property>
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<label id="lbl_1" class="TopCondition_01" left="10" top="140" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<mxtextarea id="txa_Rsn" class="TextArea_01" left="120" top="170" width="525" height="40">
			<property wantreturn="True"></property>
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
		</panel>
		<image id="btn_Close" left="620" top="420" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="525" top="420" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Save" left="360" top="420" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="415" top="420" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="470" top="420" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common_etn.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF05345.gfm";
	var Isur_cd = "", Isur_nm = "", Isu_cd = "", Isu_nm = "", Secugrp_id = "", fr_bz_procs_no = "", design_dd = "", Inq_dd= "", today_dd = "", fst_dtect_dd = "", selectedGrdNum = 0;
	
	var trsCnt = 0, trsTotalCnt = 0, trsErrCnt = 0; 	
	var trsIdx ;	
	var fn_GetPar , fn_SetPar ;
//
	var etp_Invstwarn_design_cd = "05"; //지정해제
    var list_bz_tp_cd = "" ;
	var discls_form_cd  = "" ;

	function fn_onload() {
		if( fr_bz_procs_no != "") {
			var url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnInvstwarn" + 
				      "&DIV_IDX="+DIV_IDX_ETN_INVSTWARN_MST + "&TRS_IDX="+TRS_IDX_SELECT + 
                      "&SECUGRP_ID=" + Secugrp_id + "&GUBUN_CD=" + etp_Invstwarn_design_cd +  "&BZ_PROCS_NO=" + fr_bz_procs_no ;

			dts_Mst.DataID = encodeURI(url); 
			dts_Mst.reset();		
		} else {
			var url = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ETN_INVSTWARNISU_MST_INOUT";
			url += "&SCREN_ID=" + vScrenID;
			url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;

			dts_Mst.DataID = encodeURI(url);
			dts_Mst.reset();			
			
			/* useupdate를 false로 지정함. */
			dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ETN_INVSTWARNISU_MST_INOUT";
			dts_Isu.reset();
			dts_Isu.AddRow();
			
			dts_Isu_Temp.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ETN_INVSTWARNISU_MST_INOUT";
			dts_Isu_Temp.reset();
		}
	}

	function fn_todayDate(){
	 	var url = "/listingCommon.do?method=listGeneral&outputMessageId=ETN_INVSTWARN_DATE_OUT" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.etn.lstproc.invstwarn_today_dd.select";

		dts_Cand.DataID = encodeURI(url);
		dts_Cand.reset();

		today_dd = dts_Cand.NameString(1, "TODAY_DD");
	}

	function fn_CheckForm() {

		if( dts_Isu_Temp.CountRow == 0 ) {	
			alert("[종목]을 선택하세요."); 
            img_SetIsuCd.focus(); 
            return false;	
        }
		if( getObjectValue(edt_DesignDd) == "" ) {	
			alert("[지정해제일]을 입력하세요."); 
            edt_DesignDd.focus(); 
            return false;	
        }
		return true;
	}
	
	function fn_copy_dts(index) {

		if(dts_Isu.CountRow == 0) {
			dts_Isu.AddRow();
		}
		dts_Isu.NameValue(1, "BZ_PROCS_NO") = fr_bz_procs_no;
		dts_Isu.NameValue(1, "ISU_CD") = dts_Isu_Temp.NameString(index, "ISU_CD");	
		dts_Isu.NameValue(1, "ISU_NM") = dts_Isu_Temp.NameString(index, "ISU_NM");
		dts_Isu.NameValue(1, "ISUR_CD") = dts_Isu_Temp.NameString(index, "ISUR_CD");
	   dts_Isu.NameValue(1, "ADD_YN") = dts_Isu_Temp.NameString(index, "ADD_YN");

		Isur_cd = dts_Isu_Temp.NameString(index, "ISUR_CD");
		Isur_nm = dts_Isu_Temp.NameString(index, "COM_NM");
	}
	
	function fn_save_trs() {	

		dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO") = fr_bz_procs_no;
		dts_Mst.NameString(dts_Mst.RowPosition, "ETP_INVSTWARN_DESIGN_CD") = etp_Invstwarn_design_cd;
		dts_Mst.NameString(dts_Mst.RowPosition, "ISU_CD") =  dts_Isu.NameValue(1, "ISU_CD"); 
		dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD") =  dts_Isu.NameValue(1, "ISUR_CD"); 

		if( dts_Isu.NameValue(1, "ADD_YN") == "Y")
			fn_Instwarn_fstdd();
		else 
			dts_Mst.NameString(dts_Mst.RowPosition, "FST_DESIGN_DD") =  fst_dtect_dd;

		dts_Mst.NameString(dts_Mst.RowPosition, "ADD_YN") =  dts_Isu.NameValue(1, "ADD_YN") ;
		dts_Mst.NameString(dts_Mst.RowPosition, "BAS_DD") =  Inq_dd ;
								
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if         ( trsIdx == TRS_IDX_INSERT )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( trsIdx == TRS_IDX_DELETE )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
		
		if(Secugrp_id == SECUGRP_ID_EN ) {
			list_bz_tp_cd  =  LIST_BZ_TP_CD_716 ;
		}
		else if(Secugrp_id == SECUGRP_ID_EF ) {
			list_bz_tp_cd  =  LIST_BZ_TP_CD_750 ;
		}

		trs.Action 	     =fn_encodeNSession( "/etn/EtnMktAct.do?method=saveEtnInvstwarn&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD=" +vScrenProcsTpCD);
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=1" +
								",LIST_BZ_TP_CD=" + list_bz_tp_cd + 
								",DIV_IDX[0]=" + DIV_IDX_ETN_INVSTWARN_MST;								
		trs.Post();
	}
	
	function fn_save() {		

		if (fn_CheckForm()) {

			if ( fn_duplicate_check() == "Y" ) {
				return;
			}
			if (! fn_isProcess('I') )  return ;			

			trsTotalCnt = dts_Isu_Temp.CountRow;
			trsCnt = 0;
			trsErrCnt = 0;
		
			for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {				
				fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );
				
				fn_copy_dts(i);

				if (fr_bz_procs_no.length != 14) {
					alert(getMessageParam("MSG-0010", ""));
				} else {
					trsIdx = TRS_IDX_INSERT ;
					dts_Isu_Temp.NameString(i, "STATUS") = "N" ;
					trsCnt++;	
				
					fn_save_trs();
				}
			}
		}
	}
	
	function fn_update() {
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			
			trsTotalCnt = dts_Isu_Temp.CountRow;
			trsCnt = 0;
			trsErrCnt = 0;		
			
			for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {
				fr_bz_procs_no = dts_Isu_Temp.NameString(i, "BZ_PROCS_NO");
			
				fn_copy_dts(i);
				
				dts_Isu_Temp.NameString(i, "STATUS") = "N" ;
				trsCnt++;
				
				fn_save_trs();
			}
		}	
	}

	function fn_delete() {
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus();

		trsIdx = TRS_IDX_DELETE ;
			
		trsTotalCnt = dts_Isu_Temp.CountRow;
		trsCnt = 0;
		trsErrCnt = 0;		
		
		for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {			
			fr_bz_procs_no = dts_Isu_Temp.NameString(i, "BZ_PROCS_NO");
		
			fn_copy_dts(i);
			
			dts_Isu_Temp.NameString(i, "STATUS") = "N" ;
			trsCnt++;
			
			fn_save_trs();
		}
	}	
	
	function fn_dscl() {
		
	     if(dts_Isu_Temp.CountRow > 1 && selectedGrdNum == 0 ) {
			alert('종목을 선택해 주세요.' );	
			return;
		} else if(dts_Isu_Temp.CountRow == 1) {
			selectedGrdNum = 1;
		}
		fn_copy_dts(selectedGrdNum);

		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst) {

			if(Secugrp_id == SECUGRP_ID_EN ) {
				discls_form_cd  = "68392" ;// 상장지수증권 투자유의종목 지정해제 안내공시
			}
			else if(Secugrp_id == SECUGRP_ID_EF ) {
				discls_form_cd  = "99358" ;// ETF 투자유의종목 지정해제
			}

			arr[0] = discls_form_cd;	
			arr[1] = fr_bz_procs_no;
			arr[2] = Isur_cd ;
			arr[3] = '1' ;
			if(Secugrp_id == SECUGRP_ID_EN ) {
				arr[5] = dts_Isu.NameValue(selectedGrdNum, "ISU_NM");
			}
			else if(Secugrp_id == SECUGRP_ID_EF ) {
				arr[5] = "";
			}

			CopyDataSet( dts_Isu , param_dts_isu) ;
			CopyDataSet( dts_Mst , param_dts_mst) ;
			
			param_dts_mst.NameString(param_dts_mst.RowPosition, "COM_NM") = dts_Isu_Temp.NameValue(selectedGrdNum, "COM_NM"); 
			return arr.length;
		}		
		fn_SetPar = function(arr) { }
	
		var wth = 730 + 15;
		var hgt = 785 + 40;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}

    function fn_duplicate_check() {
		
		var url ="";
		for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {

			var url =  "/etn/EtnMktAct.do?method=checkDuplicate&inputMessageId=ETN_INVSTWARNISU_DUK_INOUT";
				 url += "&ETP_INVSTWARN_DESIGN_CD=" + etp_Invstwarn_design_cd ;
				 url += "&ISU_CD=" +  dts_Isu_Temp.NameString(i, "ISU_CD");
				 url += "&BAS_DD=" + Inq_dd;
        
				dts_DUP_CHK.DataID = encodeURI(url); 
				dts_DUP_CHK.reset();
				
				if(dts_DUP_CHK.NameValue(1, "DUP_CHK") == "Y") {
					alert("중복된 종목이 저장되어 있습니다.");
					return "Y";
				}
		}
		return "N";
	}

	function fn_parentRefresh() {
		var fr_fn_list_sync = frame.Provider("../").fn_search;
		fr_fn_list_sync();
	}

	function fn_SetIsuCdBtnShow() {
		if (fr_bz_procs_no != "" || Isu_cd != "" ) {
			img_SetIsuCd.src = "../img/btn_isu_select_d.gif";
			img_SetIsuCd.disabled = true;
		} else {
			img_SetIsuCd.src = "../img/btn_isu_select.gif";
			img_SetIsuCd.disabled = false;
		}
	}
	
	function fn_SelectGridRow(row) {
		selectedGrdNum = row;
		Isur_cd = dts_Isu_Temp.NameString(row, "ISUR_CD");
		fr_bz_procs_no = dts_Isu_Temp.NameValue(row, "BZ_PROCS_NO"); 
	}

//종목추가 
	function fn_GetParIsu(arrPar , param_dts) {
		arrPar[0] = "";
		arrPar[1] = "3" ; //상장전체
		
		CopyDataSet( dts_Isu_Temp , param_dts) ;
	}
	
	function fn_SetParIsu(param_dts) {

		CopyDataSet( param_dts , dts_Isu_Temp) ;
		for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) { 
			dts_Isu_Temp.NameString(i, "ADD_YN") = "Y" ;
        }
	}

	function fn_Instwarn_fstdd() {

		var url = "/listingCommon.do?method=listGeneral&outputMessageId=ETN_INVSTWARNISU_MST_INOUT" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.lstproc.invstwarnisu.isu_fst_design_dd.select" +
		 "&{P}param01=" + dts_Isu.NameValue(1, "ISU_CD");

		dts_Instwarn.DataID = encodeURI(url);
		dts_Instwarn.reset();

		fst_design_dd = dts_Instwarn.NameString(1, "FST_DESIGN_DD");
		if(fst_design_dd != "") {
			dts_Mst.NameString(dts_Mst.RowPosition, "FST_DESIGN_DD") = fst_design_dd;
		} else {
			dts_Mst.NameString(dts_Mst.RowPosition, "FST_DESIGN_DD") = getObjectValue(edt_DesignDd);
		}
	}
]]></script>

<events><event for="trs" eventname="OnSuccess()"><![CDATA[

	dts_Isu_Temp.NameString(trsCnt, "BZ_PROCS_NO") = fr_bz_procs_no;
	dts_Isu_Temp.NameString(trsCnt, "STATUS") = "Y" ;
	
	if(trsCnt == trsTotalCnt){
		fn_alertMsg('S') ;

		fn_parentRefresh();

		if(dts_Isu_Temp.CountRow == 1){
			fn_SelectGridRow(1);
		}
		if (buttonSet.status == "I") {
			buttonSet.setUpdateStatus();
			fn_SetIsuCdBtnShow();
		} else if (buttonSet.status == "D") {
			frame.CloseFrame();
		} else {
		}			
	}
]]></event>
	
<event for="trs" eventname="OnFail()"><![CDATA[
	alert_error(trs);
	dts_Isu_Temp.NameString(trsCnt, "STATUS") = "N" ;
	trsErrCnt++;
	
	if(trsCnt == trsTotalCnt && trsErrCnt > 0){
		fn_alertMsg('F') ; 
		if (buttonSet.status == "D") {
			for (var i = 1 ; i <= dts_Isu_Temp.CountRow  ; i++) {	
				if(dts_Isu_Temp.NameString(i, "STATUS") == "Y" ){
					dts_Isu_Temp.DeleteRow( i );
				}
			}
		} else{			
		}
	}
]]></event>

<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[
		if (fr_bz_procs_no == "") {
			buttonSet.setInsertStatus();
			dts_Mst.AddRow();

			dts_Mst.NameString(dts_Mst.RowPosition, "DESIGN_DD") = design_dd;

			txa_Rsn.Text = "투자유의종목 지정단위기간(3매매거래일) 종료";
			txa_InvstwarnContn.Text = "지정해제일부터 투자유의종목 지정을 해제하며, 접속매매의 매매거래방식이 적용됩니다."  ;
			txa_Remk.Text = "-";
		} else {
			CopyDataSet( dts_Mst, dts_Isu_Temp) ;
			CopyDataSet( dts_Mst, dts_Isu) ;
         
			Isur_cd = dts_Isu_Temp.NameString(1, "ISUR_CD");
			fr_bz_procs_no = dts_Isu_Temp.NameValue(1, "BZ_PROCS_NO"); 
			
			fn_SetIsuCdBtnShow();

			if (Inq_dd	< today_dd) {
				buttonSet.setDisableStatus();
			} else {
				buttonSet.setUpdateStatus();
			}
		}
]]></event>

<event for="dts_Mst" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Mst);
]]></event>

<event for="dts_Isu" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	dts_Isu.AddRow();
]]></event>

<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>

<event for="dts_Isu_Temp" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (fr_bz_procs_no == "" &&  Isu_cd != "") {
		dts_Isu_Temp.AddRow();
		dts_Isu_Temp.NameString(dts_Isu_Temp.RowPosition, "ISU_CD") = Isu_cd;
		dts_Isu_Temp.NameString(dts_Isu_Temp.RowPosition, "ISU_NM") = Isu_nm;
		dts_Isu_Temp.NameString(dts_Isu_Temp.RowPosition, "ISUR_CD") = Isur_cd;
	}
]]></event>

<event for="dts_Isu_Temp" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu_Temp);
]]></event>

<event for="img_SetIsuCd" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsu;
	fn_SetPar = fn_SetParIsu;
	
	if(Secugrp_id == SECUGRP_ID_EN ) {
		fn_PopFindEtnCode() ; 	
	} 
	else if(Secugrp_id == SECUGRP_ID_EF) {
		fn_PopFindEtfCode(Secugrp_id);
	}
]]></event>

<event for="btn_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>

<event for="img_DesignDd" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_DesignDd); 
]]></event>

<event for="grid_1" eventname="OnClick(row, colid)"><![CDATA[
	fn_SelectGridRow(row);
]]></event>


<event for="gform" eventname="onload"><![CDATA[
	var fnc = frame.Provider("../").fn_GetPar;
	var arrPar = new Array;
	
	fnc(arrPar);
	Isu_cd 		       = (arrPar.length >= 1 ? arrPar[0] : "");
	Isu_nm 		       = (arrPar.length >= 2 ? arrPar[1] : "");
	Secugrp_id 	   = (arrPar.length >= 3 ? arrPar[2] : "");
	Mkt_id	    	   = (arrPar.length >= 4 ? arrPar[3] : "");
	fr_bz_procs_no = (arrPar.length >= 5 ? arrPar[4] : "");
	design_dd		   = (arrPar.length >= 6 ? arrPar[5] : ""); 
    Inq_dd   		   = (arrPar.length >= 7 ? arrPar[6] : "");
	fst_dtect_dd	   = (arrPar.length >= 8 ? arrPar[7] : "");
	Isur_cd	           = (arrPar.length >= 9 ? arrPar[8] : ""); 

	buttonSet.setSaveInfo( btn_Save, fn_save );
	buttonSet.setUpdateInfo( btn_Update, fn_update );
	buttonSet.setDeleteInfo( btn_Delete, fn_delete );
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );

	fn_SetIsuCdBtnShow();
	fn_todayDate();
	fn_onload();  
	
	PanelToGroupBox(panel_3);
]]></event>
<event for="dts_Cand" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Cand);
]]></event>
<event for="dts_Instwarn" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Instwarn);
]]></event></events>
</gform>

<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="750" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
    		@import url('../css/global.gss');
    </style>
    <model>
		<mxdataset id="dts_DsclList">
			<property syncload="False"></property>
		</mxdataset>
		<mxdataset id="dts_TrstComList"></mxdataset>
		<mxdataset id="MxDataSet_jong_mok"></mxdataset>
	</model>
    <components>
		<panel id="panel_page" left="5" top="722" width="305" height="20">
			<extproperty></extproperty>
	</panel>
		<image id="btn_Excel" left="1180" top="721" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<panel id="panel_1" class="TopCondition_01" left="5" top="5" width="1255" height="84">
			<extproperty></extproperty>
			<label id="lbl_tmp_5" class="TopCondition_01" left="684" top="7" width="68" height="20" text="자산운용사"></label>
			<label id="label_1" class="TopCondition_01" left="11" top="5" width="75" height="20" text="종목코드(명)">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<mxcombo id="cmb_PeriodTp" left="328" top="30" width="108" height="20">
			<property bindcolumn="disp" cbdata="1주일^1,1개월^2,3개월^3,6개월^4,1년^5,2년^6" cbdatacolumns="disp,value" defaultstring="기간선택" inheritcolor="False" listcount="10" listexprformat="disp^0^70" maxlength="20" xpstyle="True"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			</mxcombo>
			<image id="img_ToCal" left="294" top="30" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_ToDate" class="panel_maskedit_write_01" left="217" top="30" width="72" height="18">
			<property maxlength="8" numeric="False"></property>
			<extproperty font-family="돋움" font-size="12" color="#343434" background-color="#ffffff" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<label id="label_2" class="TopCondition_01" left="195" top="30" width="14" height="20" text="~"></label>
			<image id="img_FromCal" left="163" top="30" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_FromDate" class="panel_maskedit_write_01" left="87" top="30" width="72" height="18">
			<property maxlength="8" numeric="False"></property>
			<extproperty font-family="돋움" font-size="12" color="#343434" background-color="#ffffff" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<textbox id="txb_IsuNm" class="TopCondition_01_read" left="180" top="5" width="235" height="20" readonly="readonly" maxlength="1000">
			<extproperty font-family="돋움" font-size="12" color="#343434 " background-color="#b9d4f7&quot;" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</textbox>
			<image id="btn_Search" left="1141" top="7" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxcombo id="cmb_TrstCom" left="760" top="7" width="185" height="20">
			<property cbdatacolumns="value,text" inheritcolor="True" listcount="15" listexprformat="text^0^200" searchcolumn="text" xpstyle="True"></property>
			<extproperty font-family="돋움" font-size="13" background-color="#ffffff"></extproperty>
			<ref combodataid="dts_TrstComList"></ref>
			</mxcombo>
			<image id="image_11" left="1121" top="7" width="2" height="70" src="../img/img_line2.gif"></image>
			<label id="label_7" class="TopCondition_01" left="11" top="55" width="75" height="20" text="공시제목"></label>
			<label id="lbl_tmp_1" class="TopCondition_01" left="11" top="31" width="75" height="20" text="공시기간"></label>
			<textbox id="txb_FormNm" left="88" top="55" width="325" height="20" maxlength="1000">
			<extproperty font-family="돋움" font-size="12" color="#343434 " border-style="solid" border-width="1" border-color="#92b1f1 "></extproperty>
			</textbox>
			<textbox id="txb_IsuCd" left="88" top="5" width="89" height="20" maxlength="20">
			<extproperty font-family="돋움" font-size="12" color="#343434 " border-style="solid" border-width="1" border-color="#92b1f1" text-align="center"></extproperty>
			</textbox>
			<image id="img_FindForm" left="418" top="56" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_Isu_Srh" left="418" top="6" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<panel id="panel_2" left="435" top="49" width="210" height="30">
			<extproperty></extproperty>
				<label id="label_3" class="TopCondition_01" left="10" top="6" width="75" height="20" text="서식코드"></label>
				<textbox id="txb_FormCd" left="86" top="6" width="75" height="20" maxlength="5">
			<extproperty font-family="돋움" font-size="12" color="#343434 " border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
				</textbox>
			</panel>
		</panel>
		<mxgrid id="grd_Grid" class="Grid_01" left="5" top="95" width="1253" height="613">
			<property colsizing="True" editable="False" fillarea="True" fixlinemode="1" fixsizing="True" gtitleheight="0" headborder="4" indwidth="0" sortview="left" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" xtitleheight="0"></property>
			<extproperty font-family="돋움" font-size="13"></extproperty>
			<format>
				<fcolumn id="NO" width="40" name="번호" value="{CurRow},{ToString}" align="center"></fcolumn>
				<fcolumn id="ISU_CD" width="100" name="종목코드" sort="True" align="center"></fcolumn>
				<fcolumn width="75" name="상장여부" value="{Decode(LIST_STAT_CD,'Y','상장','D','상장폐지','기타')}" color="{Decode(LIST_STAT_CD,'Y','#000000','D','#FF0033','#009933')}" align="center"></fcolumn>
				<fcolumn id="ISU_KOR_ABBRV" width="170" name="종목명" color="{Decode(LIST_STAT_CD,'Y','#000000','D','#FF0033','N','#009933')}" sort="True" cursor="hand" bgcolor="#ffff99"></fcolumn>
				<column id="DOC_TITLE" width="250" name="공시제목" sort="True" cursor="hand" bgcolor="#ffff99"></column>
				<column id="ACPT_DDTM" width="120" sort="True" name="접수시각" mask="XXXX-XX-XX XX:XX" align="center" cursor="hand" bgcolor="#ffff99"></column>
				<column id="DISCLS_PROCS_DDTM" width="120" sort="True" name="처리시각" mask="XXXX-XX-XX XX:XX" align="center"></column>
				<column id="DISCLS_PUBL_DDTM" width="120" sort="True" name="배포시각" mask="XXXX-XX-XX XX:XX" align="center"></column>
				<column id="TRST_COM_ISUR_NM" width="130" sort="True" name="자산운용사"></column>
				<column id="DEP_NM" width="70" name="처리팀" sort="True" align="center"></column>
				<column id="EMP_NM" width="70" name="담당자" sort="True" align="center"></column>
			</format>
			<ref dataid="dts_DsclList"></ref>
		</mxgrid>
		<mxgrid id="Grd_jong_mok" class="Grid_01" left="1020" top="130" width="338" height="101">
			<property gtitleheight="0" sortview="left" usingoneclick="1" viewheader="False" xtitleheight="0"></property>
			<extproperty font-size="13"></extproperty>
			<format>
				<column id="ISU_KOR_ABBRV" width="186" sort="True" name="회사명" align="left" color="{Decode(LIST_STAT_CD,'Y','#000000','D','#FF0033','N','#009933')}"></column>
				<column id="ISU_CD" width="108" sort="True" headalign="center" name="회사코드" align="center"></column>
				<column id="LIST_STAT_CD" show="false"></column>
			</format>
			<ref dataid="MxDataSet_jong_mok"></ref>
		</mxgrid>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js");
	#include("../js/utils.js");
	#include("../js/session.js");
	#include("../js/PopupCalendar.js");
	#include("../js/common.js");
	#include("../js/stockSearch.js");	
	#include("../js/list_common.js");
	#include("../js/controlResize.js"); // 화면 리사이징
	
	var gDepCd;
	var gEmpNo;
	var gLdMktTp;
	
	var gAcptNo;
	var gMainFormCd;
	var gFormVer;
	var gIsurCd;   
	
	//PF공시검색(상장형수익증권)
	var vScrenID = 'ULDSTF15900.gfm';
	
	function fn_SetCode() {

		//  기간 from~ to  셋팅	
		vCurDate = cGetToday("yyyymmdd");
		edt_FromDate.text = cGetMinusMonth(vCurDate.substring(0,4), vCurDate.substring(4,6), vCurDate.substring(6,8), 1); 	// 한달전 날짜
		edt_ToDate.text = cGetToday("yyyymmdd");		// 현재날짜

		// 자산운용사(위탁운영업체)
		dts_TrstComList.DataID = "/CodeAction.do?method=listTrstComPF"+
						"&inputMessageId=CODEVALUE_INOUT&outputMessageId=CODE_OUT"+
						"&For=R" ;
		dts_TrstComList.Reset();		
		
	}
	
	function fn_CheckCond() {
		
		// 일자 체크
		if( getObjectValue(edt_FromDate).length < 8) {
			alert("일자 올바르게 입력하십시오." );
			edt_FromDate.focus();
			return;		
		}		

		// 일자 체크
		if( getObjectValue(edt_ToDate).length < 8) {
			alert("일자 올바르게 입력하십시오." );
			edt_ToDate.focus();
			return;		
		}
		
		if (compareFromToDate2(edt_FromDate, edt_ToDate) == false) {
			return;	
		}			

		fn_Search();
	}	
	
	function fn_Search() {
		var url = "/DsclSearchPF.do?method=listPFDsclSrch"				
				+ "&inputMessageId=PFDSCLLIST_INOUT"				
				+ "&outputMessageId=PFDSCLLIST_INOUT" 
				+ "&ISU_CD=" +  getObjectValue(txb_IsuCd)
				+ "&FROM_DATE=" +  getObjectValue(edt_FromDate)
				+ "&TO_DATE=" +  getObjectValue(edt_ToDate)
				+ "&FORM_CD="+ getObjectValue(txb_FormCd)
				+ "&FORM_NM=" +  getObjectValue(txb_FormNm)
				+ "&TRST_COM_ISUR_CD=" +  getObjectValue(cmb_TrstCom)
				+ "&SCREN_ID=" +vScrenID
				+ "&SCREN_PROCES_TP_CD=" +SCREN_PROCS_TP_CD_01;

		ShowWin(grd_Grid);
		
		dts_DsclList.DataID = encodeURI(url);
		dts_DsclList.reset();			
	}
	
	// 그리드에서 클릭 row의 변수셋팅
	function fn_setContnId(obj) {
		gAcptNo = dts_DsclList.NameString(eval(obj),"ACPT_NO");
		gMainFormCd = dts_DsclList.NameString(eval(obj),"FORM_CD");
		gFormVer = dts_DsclList.NameString(eval(obj),"FORM_VER");
		gIsurCd = dts_DsclList.NameString(eval(obj),"ISUR_CD");
		//alert("부모창:"+gAcptNo+","+gMainFormCd+","+ gFormVer+","+ gIsurCd);
	}	

]]></script>

<events><event for="btn_Search" eventname="onclick"><![CDATA[
	fn_CheckCond();
]]></event>

<event for="btn_Excel" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	grd_Grid.GridToExcel("PF공시 목록", "", "8");
]]></event>

<event for="dts_DsclList" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_DsclList);	
	CloseWin('', grd_Grid); 
]]></event>

<event for="dts_DsclList" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (dts_DsclList.errorMsg) {
		alert("OnLoadCompleted => "+dts_DsclList.errorMsg);
	} else {
		CloseWin(rowcount, grd_Grid);	//조회완료시 LOADING 이미지 종료
		FillGridHeaderTotalCnt(rowcount, panel_page);	//총 건수
	}
]]></event>

<event for="grd_Grid" eventname="OnDblClick(row, colid)"><![CDATA[
	// 클릭된 값 변수에 셋팅
	fn_setContnId(row);

	if (colid == "DOC_TITLE") { 		
		//2017-11-28 KBoY 비공개 첨부서류 볼 수 없음.
		fn_OpenDisclViewer(gAcptNo, "R",vScrenID);
	}  else if (colid == "ACPT_DDTM") {		
		fn_OpenDisclAllList();		
	}  else if (colid == "ISU_KOR_ABBRV") {
		fn_PopupCorpInfo();
	} 
]]></event>

<event for="img_Isu_Srh" eventname="onclick"><![CDATA[
	JongmokSearch(txb_IsuCd, txb_IsuNm, SECUGRP_ID_PF, js_market, "A");
]]></event>

<event for="img_FromCal" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_FromDate);
]]></event>

<event for="img_ToCal" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ToDate);
]]></event>

<event for="img_FindForm" eventname="onclick"><![CDATA[
	// *** 셋팅할 필드명 정의를 아래처럼 해야함.
	// => 보고서명: txb_FormNm, 보고서코드 : txb_FormCd
	var url = "/common/ULDSTF91003.gfm";
	var winTitle ="공시제목선택 ";
	frame.CreateDialogFrame("FORMLIST", url , winTitle ,100, 10, 690, 570, "window" );	
]]></event>

<event for="txb_FormCd" eventname="onblur"><![CDATA[
	if (txb_FormCd.value == "") {txb_FormNm.value = ""; }
]]></event>

<event for="cmb_PeriodTp" eventname="OnSelChange()"><![CDATA[
	var vTp = cmb_PeriodTp.ValueOfIndex("VALUE", cmb_PeriodTp.Index);
	fn_setFromToDate(vTp, edt_FromDate, edt_ToDate);	
]]></event>

<event for="Grd_jong_mok" eventname="OnKeyPress(kcode)"><![CDATA[
	if(kcode =='13'){
		fn_jongMok_set();
	}
]]></event>
<event for="Grd_jong_mok" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_jongMok_set();
]]></event>
<event for="Grd_jong_mok" eventname="OnClick(row, colid)"><![CDATA[
	Grd_jong_mok.style.display ="";
]]></event>
<event for="Grd_jong_mok" eventname="OnSetFocus()"><![CDATA[
	stFocusGrid = true;
]]></event>
<event for="Grd_jong_mok" eventname="OnKillFocus()"><![CDATA[
	stFocusGrid = false;
	Grd_jong_mok.style.display ="none";
]]></event>

<event for="txb_IsuCd" eventname="onblur"><![CDATA[
	if (stFocusGrid == false) {
		Grd_jong_mok.style.display ="none";
	}
	if (txb_IsuCd.value == "") {txb_IsuNm.value = ""; }
]]></event>

<event for="txb_IsuCd" eventname="onfocus"><![CDATA[
	Grd_jong_mok.style.display ="none";
]]></event>

<event for="txb_IsuCd" eventname="onkeyup"><![CDATA[
	if(txb_IsuCd.value==""){
		Grd_jong_mok.style.display ="none";
	}else{
		if (window.event.keyCode == 40) { //아래화살표눌렀을때 그리드로 포커스
			Grd_jong_mok.Focus();
		}else{
			fn_jongMok_nm(window.event.keyCode);
			//txtTest.value = window.event.keyCode;
		}
	}
]]></event>
<event for="MxDataSet_jong_mok" eventname="OnFilter(row)"><![CDATA[
	if (skw !="") {
		f1 = MxDataSet_jong_mok.NameString(row,"ISU_KOR_ABBRV");
		f2 = MxDataSet_jong_mok.NameString(row,"ISU_CD");
		if (f1.indexOf(skw) !=-1 ||f2.indexOf(skw) != -1) 
			return true;
		else 
			return false;  
	}else {
		return true; 
	}	
]]></event>
<event for="gform" eventname="onload"><![CDATA[
	showObj(panel_2, false);
	
	// 패널라운드 처리
	PanelToGroupBox(panel_1);
	
	fn_SetCode();
	Combo_CBDataSetPeriod(cmb_PeriodTp);

	fn_CheckCond();

	fn_jongMok(txb_IsuCd, txb_IsuNm, SECUGRP_ID_PF, "0", "A");

]]></event></events>
</gform>

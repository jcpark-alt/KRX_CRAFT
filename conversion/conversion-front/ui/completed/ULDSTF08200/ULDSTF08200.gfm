<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="750" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
	@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_New_Proc">
			<property syncload="False"></property>
		</mxdataset>
		<mxdataset id="dts_Add_Proc">
			<property syncload="False"></property>
		</mxdataset>
		<mxdataset id="dts_New_Search">
			<property syncload="False"></property>
		</mxdataset>
		<mxdataset id="dts_Add_Search">
			<property syncload="False"></property>
		</mxdataset>
		<mxlogicaltr id="trs_Save"></mxlogicaltr>
		<mxdataset id="dts_Item">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Get_ListDD">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Item">
			<property activebind="True"></property>
			<bindinfo>
				<column col="LIST_TRNSM_END_TM" ctrl="txb_LIST_TRNSM_END_TM" param="value" readonly="False"></column>
				<column col="REDMPT_TRNSM_END_TM" ctrl="txb_REDMPT_TRNSM_END_TM" param="value" readonly="False"></column>
				<column col="APPROV_EMP_NM" ctrl="txb_APPROV_EMP_NM" param="value" readonly="False"></column>
				<column col="APPROV_TM" ctrl="txb_APPROV_TM" param="value" readonly="False"></column>
				<column col="APPROV_TEAMLEADR_EMP_NM" ctrl="txb_TEAMLEADR_EMP_NM" param="value" readonly="False"></column>
				<column col="BZ_CLS_TM" ctrl="txb_BZ_CLS_TM" param="value" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Item"></ref>
		</mxbinder>
		<mxbinder id="bnd_LIST_DD">
			<property activebind="True"></property>
			<bindinfo>
				<column col="LIST_DD" ctrl="edt_LIST_DD" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Get_ListDD"></ref>
		</mxbinder>
		<mxdataset id="dts_IsuDelChk">
			<property syncload="False"></property>
		</mxdataset>
		<mxdataset id="dts_CorrYn"></mxdataset>
		<mxdataset id="dts_UnRcvIsuChk">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Cls">
			<property syncload="True"></property>
	</mxdataset>
		<mxlogicaltr id="trs_revw"></mxlogicaltr>
		<mxlogicaltr id="trs_Cls"></mxlogicaltr>
	</model>
    <components>
		<panel id="panel_Top" left="5" top="5" width="1255" height="55" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_2" class="TopCondition_01" left="5" top="5" width="45" height="20" text="마감일">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="5" top="30" width="45" height="20" text="상장일">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<image id="img_TASK_DD" left="125" top="5" width="21" height="20" src="../img/icn_calendar.gif">

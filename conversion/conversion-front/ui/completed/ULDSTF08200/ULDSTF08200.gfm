				<column id="EARY_REDMPT_BAS2_IDX" width="130" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="조기상환기준2지수" align="right" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>

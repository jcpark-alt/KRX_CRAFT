		<panel id="panel_1" left="5" top="85" width="1255" height="655">
			<extproperty border-style="solid" border-width="1" border-color="#99CCFF"></extproperty>
			<mxgrid id="grd_Add_Proc" class="Grid_01" left="2" top="444" width="1250" height="143">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" sortview="left" titleheight="25" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="NO" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>

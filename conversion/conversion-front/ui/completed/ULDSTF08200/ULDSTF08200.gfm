				<column id="ISU_NM" width="120" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="종목명" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
				<column id="ISU_ABBRV" width="120" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="종목약명" color="#343434" decao="3" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>

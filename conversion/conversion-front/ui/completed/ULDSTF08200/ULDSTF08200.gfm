				<column id="ISU_ENG_ABBRV" width="120" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="종목영문약명" color="#343434" decao="3" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>

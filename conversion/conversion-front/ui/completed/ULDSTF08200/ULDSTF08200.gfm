				<column id="VALU_PRC_CALC_INST_NM2" width="110" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="평가가격;산출기관코드2" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>

			</textbox>
			<textbox id="edt_New_Proc_TotalCnt" class="panel_text_write_01" left="1152" top="4" width="100" height="20" readonly="readonly" maxlength="1000">
			<extproperty text-align="right"></extproperty>
			</textbox>
			<mxgrid id="grd_New_Proc" class="Grid_01" left="2" top="28" width="1250" height="384">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" sortview="left" titleheight="31" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" tooltipmarkshow="False" xtitleheight="0"></property>

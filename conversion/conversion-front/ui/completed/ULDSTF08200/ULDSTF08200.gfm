				<column id="DISTR_TP_NM" width="80" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="분배금;형태코드" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
				<column id="MKTPARTC_NO1" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="시장참가자;번호1" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>
				<column id="ETN_EARNG_STRUCT_ID" width="99" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="수익구조ID" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" sort="True"></column>

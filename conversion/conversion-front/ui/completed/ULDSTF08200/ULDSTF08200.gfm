		<mxtab id="MaxTab_01" class="Tab_01" left="5" top="65" width="1255" height="20">
			<property activeindex="1"></property>
			<format>
				<tabpage divid="panel_1" title="ETN마감처리"></tabpage>
				<tabpage divid="panel_2" title="ETN마감처리내역"></tabpage>
			</format>
		</mxtab>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/stf.js"); // showObj(ObjID, flag) SetWindowPos(ObjID, nTop, nLeft, nWidth, nHeight)
	#include("../js/utils.js");
	#include("../js/list_common.js");
	#include("../js/common.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/PopupCalendar.js");
	#include("../js/elw_recv_common.js");

	var vScrenID = "ULDSTF08200.gfm";
	var procJob = "";
	var vViewCorrYnTyp = '3'; //마감송수신 
	var pMngId = js_id;
	var pJobTitl = js_jobtitl;      //권한
	var vBzProcsNo;
	var vIsuCd;
	
	function fn_list_sync() {
		var urltaskdd = "&TASK_DD=" + getObjectValue(edt_TASK_DD);
		
		var url;
		
		//상장일자 가져오기 (TBLD_BZ_CALND 테이블사용)
		url = "/ElwListedReceive.do?method=getElwListingListDd&inputMessageId=ELW_LISTING_TR_SEND_LOG_INOUT";
		url += urltaskdd;
		dts_Get_ListDD.DataID = encodeURI(url);
		dts_Get_ListDD.Reset();
		
		//마감이력가져오기 - etn으로 수정해야함
		url = "/etn/EtnNewList.do?method=searchLosslmtFinalLog&inputMessageId=LOSSLMT_ETN_FINAL_LOG";
		url += urltaskdd;
		dts_Item.DataID = encodeURI(url);
		dts_Item.Reset();
		
		if (MaxTab_01.ActiveIndex == 1) {

			//손실제한ETN 신규상장 내역
			var url_new = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=LOSSLMT_ETN_NEWLISTING_SEARCH_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.etn.lstproc.losslmtetn.newlst.select.list.condition"+
			 "&{P}param01=" + getObjectValue(edt_LIST_DD);
			url_new += "&SCREN_ID=" + vScrenID;
			url_new += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
		
			dts_New_Proc.DataID = encodeURI(url_new);
			dts_New_Proc.Reset();
			ShowWin(grd_New_Proc); 

			//상환주기 내역
			var url_add = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=LOSSLMT_ETN_NEWLISTING_REDMPT_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.etn.lstproc.losslmtetn.newlst.select.redmpt.condition"+
			 "&{P}param01=" + vBzProcsNo;
			url_add += "&SCREN_ID=" + vScrenID;
			url_add += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_Add_Proc.DataID = encodeURI(url_add);
			dts_Add_Proc.Reset();
			ShowWin(grd_Add_Proc);

		} else if (MaxTab_01.ActiveIndex == 2) {

			//손실제한ETN 신규상장 마감처리내역
			var url_new = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=LOSSLMT_ETN_NEWLISTING_SEARCH_RV_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.etn.lstproc.losslmtetn.newlst.select.list.rv"+
			 "&{P}param01=" + getObjectValue(edt_TASK_DD);
			url_new += "&SCREN_ID=" + vScrenID;
			url_new += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_New_Search.DataID = encodeURI(url_new);
			dts_New_Search.Reset();
			ShowWin(grd_New_Search); 

			//상환주기 마감처리내역
			var url_add = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=LOSSLMT_ETN_NEWLISTING_REDMPT_RV_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.etn.lstproc.losslmtetn.newlst.select.redmpt.rv.all" +
			 "&{P}param01=" + getObjectValue(edt_TASK_DD);
			url_add += "&SCREN_ID=" + vScrenID;
			url_add += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_Add_Search.DataID = encodeURI(url_add);
			dts_Add_Search.Reset();
			ShowWin(grd_Add_Search); 
			
		}
	}

	//신규상장 그리드 클릭시 상환주기 가져오기
	function fn_SearchRedmpt() {
			var url_add = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=LOSSLMT_ETN_NEWLISTING_REDMPT_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.etn.lstproc.losslmtetn.newlst.select.redmpt.condition"+
			 "&{P}param01=" + vBzProcsNo;
			url_add += "&SCREN_ID=" + vScrenID;
			url_add += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_Add_Proc.DataID = encodeURI(url_add);
			dts_Add_Proc.Reset();
			ShowWin(grd_Add_Proc);
	}		

	//마감처리내역 신규상장 그리드 클릭시 상환주기(전송내역) 가져오기
	function fn_SearchRedmptRv() {
			var url_add = "/listingCommon.do?method=listGeneral" +
			 "&outputMessageId=LOSSLMT_ETN_NEWLISTING_REDMPT_RV_OUT" +
			 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
			 "&queryId=lds.stf.etn.lstproc.losslmtetn.newlst.select.redmpt.rv.sel"+
			 "&{P}param01=" + getObjectValue(edt_TASK_DD) +
			 "&{P}param02=" + vIsuCd;
			url_add += "&SCREN_ID=" + vScrenID;
			url_add += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01 ;
			 
			dts_Add_Search.DataID = encodeURI(url_add);
			dts_Add_Search.Reset();
			ShowWin(grd_Add_Search); 
	}		

	//재마감 버튼 클릭시 (현업관리자만 버튼보임)
	function fn_recls() {
		procJob = "재마감처리";
		if (! fn_checkProcDt(procJob))  return;
		
		var res = window.confirm("재마감처리를 선택 하셨습니다.\n재마감처리는 이전마감처리기록을 삭제하므로\n재마감처리후 다시 마감처리를 하셔야 됩니다.\n\n재마감처리를 하시겠습니까?");
		if (res) {
			fn_trSetHeader();
			
			trs_Cls.Action="/etn/EtnNewList.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_04+"&method=losslmtReClsProcsSave";
			trs_Cls.KeyName="toinb_dataid4";
			trs_Cls.KeyValue="JSP(I:pInput=dts_Cls)";
			trs_Cls.Post();
		}
	}

	function fn_trSetHeader() {
		dts_Cls.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=LOSSLMT_ETN_FINAL_LOG_EMP";
		dts_Cls.reset();
		dts_Cls.AddRow();
	}

	//담당자 확인 버튼 클릭시
	function fn_revw(){
		procJob = "담당자 확인";
		if (! fn_checkProcDt(procJob))  return;
		
		res = window.confirm("담당자 확인 하시겠습니까?");
		if (res) {
			fn_trs_revw();
		}
	}

	//담당자 확인
	function fn_trs_revw() {
		fn_trSetHeader();
		dts_Cls.NameValue(1, "CHRG_EMP_NO") =  js_emp_no;
		
		trs_revw.Action="/etn/EtnNewList.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_02+"&method=losslmtRevwProcsSave";
		trs_revw.KeyName="toinb_dataid4";
		trs_revw.KeyValue="JSP(I:pInput=dts_Cls)";
		trs_revw.Post();
	}	

	//팀장승인 버튼 클릭시
	function fn_cls() {
		if ( getObjectValue(txb_APPROV_TM) == "") {
			alert("담당자가 확인하지 않았습니다. 담당자 확인 후 마감처리를 해주십시오.");
			return true;
		} 
		procJob = "마감처리";
		//if (! fn_checkProcDt(procJob))  return;
        if (getObjectValue(edt_LIST_DD) == "") {
			alert("[상장일]이 없습니다.");edt_LIST_DD.focus();return;
		}
		
		var commit = window.confirm("마감처리 하시겠습니까?");
		if (commit) {
			fn_trs();
		}
	}

	//팀장승인 
	function fn_trs() {
		fn_trSetHeader();
		dts_Cls.NameValue(1, "LIST_DD") = getObjectValue(edt_LIST_DD);
		dts_Cls.NameValue(1, "CHRG_EMP_NO") =  js_emp_no;
		
		trs_Cls.Action="/etn/EtnNewList.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_02+"&method=losslmtClsProcsSave";
		trs_Cls.KeyName="toinb_dataid4";
		trs_Cls.KeyValue="JSP(I:pInput=dts_Cls)";
		trs_Cls.Post();
	}	

	// 담당자 승인, 팀장승인, 재마감처리 
	function buttonSetDis() {
	
		//담당자일때
		if(pJobTitl == "03"){
			if (getObjectValue(txb_BZ_CLS_TM) != "" ){
				btn_Revw.src = "../img/btn/btn_revw_d.gif";
				btn_Revw.disabled = true;
				btn_Cls.src = "../img/btn_BosApv_d.gif";
				btn_Cls.disabled = true;
			} else {
				if (getObjectValue(txb_APPROV_EMP_NM) == "") { //담당자확인을 않했을 경우
					btn_Revw.src = "../img/btn/btn_revw.gif";
					btn_Revw.disabled = false;
				}else{
					btn_Revw.src = "../img/btn/btn_revw_d.gif";
					btn_Revw.disabled = true;
				}
				btn_Cls.src = "../img/btn_BosApv_d.gif";
				btn_Cls.disabled = true;
			}
		//	showObj(btn_Recls, false);
		}
		//팀장일때 - 마감처리
		else{
			if (getObjectValue(txb_BZ_CLS_TM) != ""  ){
				btn_Revw.src = "../img/btn/btn_revw_d.gif";
				btn_Revw.disabled = true;
				btn_Cls.src = "../img/btn_BosApv_d.gif";
				btn_Cls.disabled = true;
			} else {	
				if (getObjectValue(txb_APPROV_EMP_NM) == "") { //담당자확인을 않했을 경우		
					btn_Revw.src = "../img/btn/btn_revw.gif";
					btn_Revw.disabled = false;
					btn_Cls.src = "../img/btn_BosApv_d.gif";
					btn_Cls.disabled = true;
				}else{		
					btn_Revw.src = "../img/btn/btn_revw_d.gif";
					btn_Revw.disabled = true;
					btn_Cls.src = "../img/btn_BosApv.gif";
					btn_Cls.disabled = false;
				}		
			}
		//	showObj(btn_Recls, false);
		}
			
		//재마감 처리 버튼 - 시스템 관리자 
		if( js_dep_cd == 'ZSYS' ){
			btn_Recls.src = "../img/btn_ReCls.gif";
			btn_Recls.disabled = false;
			showObj(btn_Recls, true);
		} else {
			showObj(btn_Recls, false);
	    }
	}

	function fn_checkProcDt(str) {
		var vCurDate = cGetToday("yyyymmdd");
		var pCheck = true;
		
		if (getObjectValue(edt_TASK_DD) != vCurDate) {
			alert("[마감일]이 현재일경우만 '"+str+"'를 할수 있습니다.");
			pCheck = false;
		} 
		
		if(pCheck){
			for ( var i=1; i<=dts_New_Proc.CountRow; i++ ) 
			{
				if ( dts_New_Proc.NameValue(i,"ISU_MKTPARTC_NO") == "" ) 
				{
					alert("발행회사명에 대한 시장참가자번호가 없는 종목이 있습니다. 시스템관리자에게 문의바랍니다.");
					pCheck = false;
					break;
				} 
				
				//if ( dts_New_Proc.NameString(i,"ISU_SHRS") <= 0 )
				//{
				//	alert("LP보유량이 '0'인 종목이 있습니다. 확인하여주십시오.");
				//	pCheck = false;
				//	break;
				//}
			}
		}
		
		return pCheck;
	}

	function fn_ExcelDown(){
		if (MaxTab_01.ActiveIndex == 1) {
			grd_New_Proc.GridToExcel("손실제한ETN 신규상장 마감처리목록", "", "8");
			grd_Add_Proc.GridToExcel("손실제한ETN 상환주기 마감처리목록", "", "8");
		} else if (MaxTab_01.ActiveIndex == 2) {
			grd_New_Search.GridToExcel("손실제한ETN 신규상장 송신목록", "", "8");
			grd_Add_Search.GridToExcel("손실제한ETN 추가상장 송신목록", "", "8");
		}
	}
	
]]></script>


<events><event for="MaxTab_01" eventname="OnSelChanged(nIndex)"><![CDATA[
	if (nIndex == "1") {
		edt_TASK_DD.ReadOnly = true;
		img_TASK_DD.disabled = true;
		edt_TASK_DD.ReadOnlyBackColor = "#b9d4f7";
		edt_TASK_DD.Text = cGetToday("yyyymmdd");
	} else if (nIndex == "2") {
		edt_TASK_DD.ReadOnly = false;
		img_TASK_DD.disabled = false;
	}
	fn_list_sync();
	
]]></event>

				<fcolumn id="NO" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>

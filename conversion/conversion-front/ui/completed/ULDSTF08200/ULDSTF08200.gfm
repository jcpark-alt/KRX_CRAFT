			</image>
			<mxmaskedit id="edt_TASK_DD" class="panel_maskedit_write_01" left="55" top="5" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>

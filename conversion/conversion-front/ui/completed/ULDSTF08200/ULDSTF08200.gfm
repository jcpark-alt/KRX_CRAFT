				<fcolumn id="TASK_DD" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="작업일자" align="center" color="#343434" mask="XXXX-XX-XX" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>

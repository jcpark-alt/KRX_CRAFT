			<mxgrid id="grd_New_Search" class="Grid_01" left="2" top="28" width="1250" height="384">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" sortview="left" titleheight="35" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" tooltipmarkshow="False" xtitleheight="0"></property>

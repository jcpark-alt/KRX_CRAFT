		<script type="text/javascript" lazy="false"><![CDATA[scwin.vScrenID = "ULDSTF09304.xml";
scwin.clickBzProcsNo = "";
scwin.vAcptNo = "";
scwin.vIsurCd = "";
scwin.vOpenTyp = ""; // R=접수, H = 이력, N : 신규
scwin.fr_MktId = $c.session.getUserInfo("market"); // 시장구분코드(유가, 코스닥) 전체), 기준은 로그인 사용자의 부서 소속을 기준으로 한다.
scwin.fr_SecuGrpId = "PF";
scwin.clickDisclsMainDocFormCd = "";
scwin.clickBzProcsNoRecent = "";

scwin.onpageload = function() {
    scwin.init();
};

scwin.init = function() {
    scwin.fn_recv_list_sync();
};

scwin.fn_all_list_sync = function() {
    scwin.fn_recv_list_sync();
    scwin.fn_list_sync();
};

//그리드 상단 조회
scwin.fn_recv_list_sync = async function() {
    //초기화
    dlt_recv.removeAll();

    const sbmOptions = {
        id: "sbm_listrecv",
        action: "/api/listing/lstproc/pf/chglisting/select-list-recv",
        method: "get",
        target: "dlt_recv=body",
        isProcessMsg: false
    };

    var result = await $c.sbm.executeDynamic(sbmOptions);
    if(result.responseJSON.success){
        panel_page.setValue(dlt_list.getTotalRow());
    }
};

//그리드 하단 조회
scwin.fn_list_sync = async function() {
    //초기화
    dlt_list.removeAll();

    const sbmOptions = {
        id: "sbm_listhist",
        action: "/api/listing/lstproc/pf/chglisting/select-list-hist",
        method: "get",
        target: "dlt_list=body",
        isProcessMsg: false
    };

    var result = await $c.sbm.executeDynamic(sbmOptions, {isuCd: txb_ISU_CD.getValue()});
    if(result.responseJSON.success){
        panel_page.setValue(dlt_list.getTotalRow());
    }
};


//상단 그리드  dbCLick
scwin.fn_OpenDetailRecv = function(row) {
    scwin.vOpenTyp = "R";
    scwin.vAcptNo = dlt_recv.getCellData(row, "acptNo");
    scwin.vIsurCd = dlt_recv.getCellData(row, "isurCd");

    if (scwin.clickDisclsMainDocFormCd == "69780") {
        // 변경상장 취소 서식이면
        //TOBE에서 사용X
        //scwin.fn_OpenPopupCancel();
    } else {
        scwin.fn_OpenPopup();
    }
};

//상세 팝업 호출(그리드 더블클릭)
scwin.fn_OpenDetailMng = function(row) {
    scwin.vAcptNo = ""; //초기화
    scwin.vOpenTyp = "H";
    scwin.fn_setBzProcsNo(row);

    scwin.fn_OpenPopup();
};

scwin.fn_setBzProcsNo = function(obj) {
    scwin.clickBzProcsNo = dlt_list.getCellData(obj, "bzProcsNo");
    scwin.vIsurCd = dlt_list.getCellData(obj, "isurCd");
};


scwin.fn_OpenPopupCancel = async function() {
    //TODO 확인 필요 
    // await $c.win.openPopup 함수로 전환 필요 : await $c.frame.CreateDialogFrame("ULDSTF09321.gfm", "/pf/ULDSTF09321.gfm", "상장형 수익증권 변경상장 취소", 200, 200, 705 + 35, 270 + 40, "window");
};


scwin.fn_OpenPopup = async function() {
    let url = "/ui/lst/pf/ULDSTF09306.xml";
    let popTitle = "상장형수익증권변경상장관리";

    const opts = {
        id: "ULDSTF41621",
        popupName: popTitle,
        width: 1400,
        height: 430,
        frameModal: "top"
    };

    let popupData = {
        "clickBzProcsNo" : scwin.clickBzProcsNo, 
        "vAcptNo" : scwin.vAcptNo,
        "vIsurCd" : scwin.vIsurCd,
        "vOpenTyp" : scwin.vOpenTyp,
        "isuCd" : txb_ISU_CD.getValue(),
        "isuNm" : txb_ISU_NM.getValue()
    };

    const res = await $c.win.openPopup(url, opts, {"pData" : popupData});
    if(res){
        //재조회
        scwin.fn_list_sync();
    }

};

scwin.fn_getBzProcsNo = function() {
    return scwin.clickBzProcsNo;
};

scwin.fn_List_Benf_Estb_DD_check = function(row) {
    if (scwin.clickDisclsMainDocFormCd != "69780"){
        // 변경상장 취소이 아니면{
        var beDD = dlt_recv.getCellData(row, "benfcertEstbrepurDd");
        var liDD = dlt_recv.getCellData(row, "listDd");
        
        if (liDD <= beDD) $c.win.alert('변경상장 예정일 및 설정 또는 환매일을 확인해 주시기 바랍니다.');
    }
};


//종목코드 검색
scwin.img_ISU_CD_onclick = async function() {
    const opts = {
        id: "ULDSTF92017",
        popupName: "종목 선택",
        width: 1180,
        height: 880,
        frameModal: "top",
    };
    
    var result = await $c.win.openPopup("/ui/lst/common/ULDSTF92017.xml", opts, {"secugrpId" : scwin.fr_SecuGrpId});

    if(!$c.util.isEmpty(result)){
        txb_ISU_CD.setValue(result.isuCd);//종목코드
        txb_ISU_NM.setValue(result.isuKorNm);//종목명 
        scwin.vIsurCd = result.isurCd;//발행기관코드 설정 

        //하단 그리드만 재조회가 맞는지 확인필요핟스 
        scwin.fn_list_sync();
    }
};

//조회
scwin.btn_Search_onclick = function() {
    if("" != txb_ISU_CD.getValue()){
        scwin.fn_all_list_sync();
    }
};

/* 
 * 신규 버튼
 */
scwin.btn_New_onclick = async function() {
    if ($c.stf.getObjectValue(txb_ISU_CD) == "") {
        await $c.win.alert("[종목]을 선택하세요.");
        txb_ISU_CD.focus();
        return;
    }
    scwin.vAcptNo = ""
    //신규버튼 선택시
    if (dlt_recv.getRowCount() === 0 && dlt_list.getRowCount() === 0) {
        scwin.vOpenTyp = "X"; //최초 신규시
    }
    scwin.vOpenTyp = "N";
    scwin.clickBzProcsNo = ""; //초기화
    
    scwin.fn_OpenPopup();
};


//엑셀다운로드
scwin.btn_Excel_onclick = function() {
    if (dlt_list.getRowCount() > 0) {
        const today = $c.date.getServerDateTime("yyyyMMddHHmmss");
        const options = {
            fileName : "ULDSTF09304_PF변경상장내역_" + today,
            sheetName : "리스트",
        };
        $c.data.downloadGridViewExcel(grd_List, options);
    } else {
        $c.win.alert($c.data.getMessage("com_search_0027"));
    }
};

scwin.btn_Close_onclick = async function() {
    await $c.win.closePopup();
};


//상단 그리드 onclick
scwin.grd_Recv_oncellclick = function (rowIndex, columnIndex, columnId) {
    scwin.clickDisclsMainDocFormCd = dlt_recv.getCellData(rowIndex, "disclsMaindocFormCd");
    scwin.clickBzProcsNoRecent = dlt_recv.getCellData(rowIndex, "bzProcsNoRecent");
    $c.stf.setObjectValue(txb_ISU_CD, dlt_recv.getCellData(rowIndex, "isuCd"));
    $c.stf.setObjectValue(txb_ISU_NM, dlt_recv.getCellData(rowIndex, "isuKorNm"));
    
    scwin.fn_list_sync();
    scwin.fn_List_Benf_Estb_DD_check(rowIndex);
};

//상단 그리드 dbclick
scwin.grd_Recv_oncelldblclick = function (rowIndex, columnIndex, columnId) {
	scwin.clickBzProcsNoRecent = dlt_recv.getCellData(rowIndex, "bzProcsNoRecent");
    scwin.fn_OpenDetailRecv(rowIndex);
};

//하단 그리드 dbClick
scwin.grd_List_oncelldblclick = function (rowIndex, columnIndex, columnId) {
    scwin.fn_OpenDetailMng(rowIndex);
};
]]></script>

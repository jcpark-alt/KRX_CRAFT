<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="460" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
			@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_List">
			<property syncload="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs_Save"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="PARVAL" ctrl="edt_PARVAL" param="text" readonly="False"></column>
				<column col="LIST_SHRS" ctrl="edt_LIST_SHRS" param="text" readonly="False"></column>
				<column col="DELIST_DD" ctrl="edt_DELIST_DD" param="text" readonly="False"></column>
				<column col="DELIST_RSN_DSC" ctrl="txb_DELIST_RSN_DSC" param="text" readonly="False"></column>
				<column col="ARRANTRD_MKTACT_ENFORCE_DD" ctrl="edt_ARRANTRD_MKTACT_ENFORCE_DD" param="text" readonly="False"></column>
				<column col="ARRANTRD_END_DD" ctrl="edt_ARRANTRD_END_DD" param="text" readonly="False"></column>
				<column col="DELIST_ADVNOTI_STRT_DD" ctrl="edt_DELIST_ADVNOTI_STRT_DD" param="text" readonly="False"></column>
				<column col="DELIST_ADVNOTI_END_DD" ctrl="edt_DELIST_ADVNOTI_END_DD" param="text" readonly="False"></column>
				<column col="GRND_REGUL_NM" ctrl="txb_GRND_REGUL_NM" param="value" readonly="False"></column>
				<column col="REMK" ctrl="txb_REMK" param="text" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
		<mxdataset id="dts_Mst">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Mst_Eng">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_BZ_CHECK">
			<property syncload="True"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="panel_Top" class="TopCondition_01" left="5" top="5" width="1253" height="40">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_2_top" class="TopCondition_01" left="20" top="10" width="80" height="20" text="종목코드(명)">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_ISU_CD" class="TopCondition_01_write" left="104" top="10" width="90" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7" text-align="center"></extproperty>
			</textbox>
			<textbox id="txb_ISU_NM" class="TopCondition_01_write" left="198" top="10" width="272" height="20" readonly="readonly" maxlength="1000">
			<extproperty background-color="#b9d4f7"></extproperty>
			</textbox>
			<image id="btn_Search" left="1195" top="7" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_tmp_11" left="1187" top="4" width="2" height="30" src="../img/img_line2.gif"></image>
			<image id="img_ISU_NM" left="475" top="10" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<image id="btn_Save" left="890" top="423" width="50" height="22" src="../img/btn_save.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="944" top="423" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="998" top="423" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_Drft" left="1052" top="423" width="50" height="22" src="../img/btn_draft.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="1106" top="423" width="92" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_close" left="1201" top="423" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<panel id="panel_page" left="5" top="424" width="335" height="20">
			<extproperty></extproperty>
	</panel>
		<mxgrid id="grd_List" class="Grid_01" left="4" top="270" width="1253" height="141">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indwidth="0" titleheight="40" tooltip="use=true;alt=true;createtime=300;color=#FFFFFF;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="NO" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434"></fcolumn>
				<column id="DISCLS_YN" width="60" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="공시검토\\여부" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="LIST_SHRS" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="상장증권수" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="DELIST_DD" width="90" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="상장폐지일" align="center" color="#343434" mask="XXXX-XX-XX" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="DELIST_RSN_DSC" width="300" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="상장폐지사유" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="GRND_REGUL_NM" width="230" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="근거" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="REMK" width="200" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="기타" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="FNL_EMP_NM" width="101" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="최종처리자" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434"></column>
				<column id="BZ_PROCS_NO" width="110" name="업무처리번호"></column>
			</format>
			<ref dataid="dts_List"></ref>
		</mxgrid>
		<panel id="panel_Item" left="5" top="50" width="1253" height="202" class="TopCondition_01">
			<extproperty border-style="none" border-width="4" background-color="#d9e9fc"></extproperty>
			<mxmaskedit id="edt_DELIST_ADVNOTI_STRT_DD" class="panel_maskedit_write_01" left="133" top="31" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_DELIST_ADVNOTI_END_DD" class="panel_maskedit_write_01" left="244" top="31" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_DELIST_ADVNOTI_END_DD" left="314" top="31" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_ARRANTRD_END_DD" left="314" top="56" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_ARRANTRD_END_DD" class="panel_maskedit_write_01" left="244" top="56" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<label id="lbl_Tilde" class="TopCondition_01" left="229" top="56" width="10" height="20" text="~">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<mxmaskedit id="edt_ARRANTRD_MKTACT_ENFORCE_DD" class="panel_maskedit_write_01" left="133" top="56" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<textbox id="lb_LIST_SHRS" class="TopCondition_01_write" left="275" top="7" width="80" height="20" value="상장증권수" readonly="readonly" maxlength="1000">
			<extproperty color="#000000" background-color="#d9e9fc" border-style="none" border-width="0"></extproperty>
			</textbox>
			<mxmaskedit id="edt_LIST_SHRS" class="panel_maskedit_write_02" left="357" top="6" width="120" height="20">
			<property alignment="2" datemodify="True" generaledit="False" numeric="True" readonly="True" readonlybackcolor="#b9d4f7" showliteral="false" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<mxmaskedit id="edt_DELIST_DD" class="panel_maskedit_write_01" left="132" top="7" width="65" height="20">
			<property alignment="1" format="YYYY-MM-DD" generaledit="False" numeric="False" readonly="True" valign="1"></property>
			<extproperty border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="img_DELIST_DD" left="201" top="7" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_ARRANTRD_MKTACT_ENFORCE_DD" left="202" top="56" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_DELIST_ADVNOTI_STRT_DD" left="202" top="31" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxtextarea id="txb_DELIST_RSN_DSC" class="TextArea_01" left="133" top="81" width="447" height="40"></mxtextarea>
			<image id="img_DELIST_RSN_DSC" left="584" top="81" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<textbox id="txb_GRND_REGUL_NM" class="TopCondition_01_write" left="133" top="124" width="449" height="20" maxlength="1000">
			<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<mxtextarea id="txb_REMK" class="TextArea_01" left="133" top="146" width="446" height="51"></mxtextarea>
			<label id="label_7" class="TopCondition_01" left="20" top="146" width="80" height="20" text="기타">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_5" class="TopCondition_01" left="20" top="124" width="80" height="20" text="근거규정">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_6" class="TopCondition_01" left="10" top="81" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_4" class="TopCondition_01" left="20" top="81" width="80" height="20" text="상장폐지사유">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="20" top="7" width="80" height="20" text="상장폐지일">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="10" top="7" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="10" top="124" width="10" height="20" text="*">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="lbl_ArrantrdPermiPd" class="TopCondition_01" left="20" top="56" width="112" height="20" text="정리매매 허용기간">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_3" class="TopCondition_01" left="20" top="32" width="112" height="20" text="상장폐지 예고기간">
			<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_9" class="TopCondition_01" left="229" top="32" width="10" height="20" text="~">
			<extproperty font-size="12" color="#000000" background-color="#d9e9fc" text-align="center" border-color="black"></extproperty>
			</label>
		</panel>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/PopupCalendar.js");
	#include("../js/stf.js");
	#include("../js/utils.js");
	#include("../js/list_common.js");
	#include("../js/buttonSet.js");
	#include("../js/session.js");  			// 세션정보를 얻기위한 함수사용
	
	var vScrenID = "ULDSTF05806.gfm";
    var vScrenTpCD = "";
	var vBzProcsNo = "";
	var vIsurCd = "";
	var trsIdx ;  // insert, update 구분
	var rowPos;
	var vISU_ENG_NM = "";

	var fr_SecuGrpId = fn_getSecuGrpId(InfoMenuID());
	var vSPOT_ISU_TRD_MKT_TP_CD;
	
	function fn_GetParIsuCd(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = ""; 	// 코드값을 포함할 컨트롤
		//arrPar[1] = getObjectValue(txb_SearchNm);	// 명칭값을 포함할 컨트롤
		arrPar[1] = "";	// 명칭값을 포함할 컨트롤
		arrPar[2] = fr_SecuGrpId;
		return arrPar, length;
	} 

	function fn_SetParIsuCd(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			txb_ISU_CD.value = arrPar[0].ISU_CD;
			txb_ISU_NM.value = arrPar[0].ISU_KOR_NM;

			vSPOT_ISU_TRD_MKT_TP_CD = arrPar[0].SPOT_ISU_TRD_MKT_TP_CD;
			vIsurCd = arrPar[0].ISUR_CD;

			fn_initMktPerComponent(vSPOT_ISU_TRD_MKT_TP_CD);
			
			fn_initItem() ;
			fn_isubook_read_sync();
			fn_list_sync();
		}	
	}
	
	function fn_GetParRsn(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = "1";
		arrPar[1] = "05";
		return arrPar,length;
	} 
	
	function fn_SetParRsn(arrPar) {
		dts_Mst.NameString(1, "DELIST_RSN_CD") = (arrPar.length >= 1 ? arrPar[0] : "");
		txb_DELIST_RSN_DSC.Text = (arrPar.length >= 2 ? arrPar[1] : "");
		txb_GRND_REGUL_NM.value = (arrPar.length >= 3 ? arrPar[2] : "");
	}	

	/**
	* 시장을 구분해서 콤포넌트 보여주기
	*/
	function fn_initMktPerComponent(pMkt) {
		if ( pMkt == '1' ) {
			img_DELIST_RSN_DSC.src = "../img/btn_search.gif";
			img_DELIST_RSN_DSC.disabled = false;

			txb_DELIST_RSN_DSC.readOnly = true;
			txb_DELIST_RSN_DSC.style.backgroundColor='#b9d4f7';
			
			label_2.style.top    = 7;
			label_1.style.top    = 7;
			edt_DELIST_DD.style.top    = 7;
			img_DELIST_DD.style.top    = 7;
			lb_LIST_SHRS.style.top    = 7;
			edt_LIST_SHRS.style.top    = 7;
			
			showObj(label_3, true);
			showObj(edt_DELIST_ADVNOTI_STRT_DD, true);
			showObj(img_DELIST_ADVNOTI_STRT_DD, true);
			showObj(label_9, true);
			showObj(edt_DELIST_ADVNOTI_END_DD, true);
			showObj(img_DELIST_ADVNOTI_END_DD, true);
			
			showObj(lbl_ArrantrdPermiPd, true);
			showObj(edt_ARRANTRD_MKTACT_ENFORCE_DD, true);
			showObj(img_ARRANTRD_MKTACT_ENFORCE_DD, true);
			showObj(lbl_Tilde, true);
			showObj(edt_ARRANTRD_END_DD, true);
			showObj(img_ARRANTRD_END_DD, true);
			
		} else if ( pMkt == '2' ) {
			img_DELIST_RSN_DSC.src = "../img/btn_search_d.gif";
			img_DELIST_RSN_DSC.disabled = true;
			
			txb_DELIST_RSN_DSC.readOnly = false;
			txb_DELIST_RSN_DSC.style.backgroundColor='#ffffff';
			
			showObj(label_3, false);
			showObj(edt_DELIST_ADVNOTI_STRT_DD, false);
			showObj(img_DELIST_ADVNOTI_STRT_DD, false);
			showObj(label_9, false);
			showObj(edt_DELIST_ADVNOTI_END_DD, false);
			showObj(img_DELIST_ADVNOTI_END_DD, false);
			
			showObj(lbl_ArrantrdPermiPd, false);
			showObj(edt_ARRANTRD_MKTACT_ENFORCE_DD, false);
			showObj(img_ARRANTRD_MKTACT_ENFORCE_DD, false);
			showObj(lbl_Tilde, false);
			showObj(edt_ARRANTRD_END_DD, false);
			showObj(img_ARRANTRD_END_DD, false);
			
			label_2.style.top    = 56;
			label_1.style.top    = 56;
			edt_DELIST_DD.style.top    = 56;
			img_DELIST_DD.style.top    = 56;
			lb_LIST_SHRS.style.top    = 56;
			edt_LIST_SHRS.style.top    = 56;
			
		}
	}


	function fn_initItem() {
		buttonSet.setInsertStatus();
		dts_Isu.ClearData();
		dts_Isu.AddRow();
		
		dts_Mst.ClearData();
		dts_Mst.AddRow();
		vBzProcsNo = ""; //초기화 
	}
	
	//신주인수권증권/증서수 조회
	function fn_isubook_read_sync() {
		var url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchTotstkcnt&inputMessageId=DELISTING_INOUT"
		+"&ISU_CD=" + getObjectValue(txb_ISU_CD); 
		dts_Mst.DataID =encodeURI(url);
		dts_Mst.reset();
	}
	
	 //품목코드선택시 리스트 조회
	function fn_list_sync() {
	
		if ( fr_SecuGrpId == SECUGRP_ID_SW ) {
			setObjectValue(lb_LIST_SHRS, '상장증권수');
			grd_List.ColumnProp("LIST_SHRS", "Name") = '상장증권수';
		} else if ( fr_SecuGrpId == SECUGRP_ID_SR ) {
			setObjectValue(lb_LIST_SHRS, '상장증서수');
			grd_List.ColumnProp("LIST_SHRS", "Name") = '상장증서수';
		}
	
		var url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchlist&inputMessageId=DELISTING_INOUT"
		+"&ISU_CD=" + getObjectValue(txb_ISU_CD); 
		dts_List.DataID =encodeURI(url);
		dts_List.reset();	
	}

	//그리드  더블 클릭시 조회
	function fn_read_sync(row) {
		vBzProcsNo = dts_List.NameString(row, "BZ_PROCS_NO");
		var url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=searchlistDbDetail&inputMessageId=DELISTING_INOUT"
		+"&BZ_PROCS_NO=" + vBzProcsNo; 
		dts_Mst.DataID =encodeURI(url);
		dts_Mst.reset();	
	}
	
	function fn_getListBzTpCd() {
		var VListBzTpCd =""; 

		if	(fr_SecuGrpId == SECUGRP_ID_SW) {
			VListBzTpCd = LIST_BZ_TP_CD_203;
		} else if (fr_SecuGrpId == SECUGRP_ID_SR) {
			VListBzTpCd = LIST_BZ_TP_CD_204;
		}	
		return VListBzTpCd;
	}

	function fn_CheckForm() {
		var vCurDate = cGetToday("yyyymmdd");
		
		if (getObjectValue(txb_ISU_CD) == "") {
			alert("[종목코드]를 선택하세요.");txb_ISU_CD.focus();return false;
		}
	    if (getObjectValue(edt_DELIST_DD) == "") {
			alert("[상장폐지일]을 입력하세요.");edt_DELIST_DD.focus();return false;
		}
		if (cGetToday("yyyymmdd") >= getObjectValue(edt_DELIST_DD)) {
			alert("[상장폐지일]을 현재일이후로 입력하세요.");edt_DELIST_DD.focus();return false;
		}
		
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") {
			if (dts_Mst.NameString(1, "DELIST_RSN_CD") == "") {
				alert("[상장폐지사유]를 선택하세요.");txb_DELIST_RSN_DSC.focus();return false;
			};
		} else if (vSPOT_ISU_TRD_MKT_TP_CD == "2") {
            if (txb_DELIST_RSN_DSC.Text == "") {
				alert("[상장폐지사유]를 입력하세요.");txb_DELIST_RSN_DSC.focus();return false;
			};
			if ( !checkMaxLength( txb_DELIST_RSN_DSC , 2000 , "상장폐지사유" ) ) return false ;
		}
		
				if (getObjectValue(txb_GRND_REGUL_NM) == "") {
			alert("[근거규정]을 입력하세요.");txb_GRND_REGUL_NM.focus();return false;
		} 

		if ( !checkMaxLength( txb_GRND_REGUL_NM , 200 , "근거규정" ) ) return false ;

		if (! fn_check_bz_doubleinput(	dts_BZ_CHECK, 
														getObjectValue(txb_ISU_CD),
														getObjectValue(edt_DELIST_DD),
														dts_Mst.NameString(1, "BZ_PROCS_NO"),
														fn_getListBzTpCd() 
														)) {
			return false;
		}
		
		return true;
	}

    function fn_save() {
		trsIdx = TRS_IDX_INSERT ;
		
		if (! fn_CheckForm()) return;
		if (! fn_isProcess('I') )  return ;
		
		vBzProcsNo = fn_getNewBzProcNo( dts_BzProcsNo );

		if (vBzProcsNo.length != 14) {
			alert(getMessageParam("MSG-0010", ""));
		} else {

			dts_Mst.NameString(1, "BZ_PROCS_NO") = vBzProcsNo;
			//alert('[dts_Mst]'+dts_Mst.text);
			fn_trs();
		}
	}

	function fn_update() {
		trsIdx = TRS_IDX_UPDATE ;
		if (! fn_CheckForm() ) return;
		if (! fn_isProcess('U') )  return ;
		fn_trs();
	}	
	
	function fn_delete() {
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_trs();
	}

	function fn_trs() {
		if(trsIdx=='1'){
			vScrenTpCD = SCREN_PROCS_TP_CD_02;
		}else if(trsIdx=='2'){
			vScrenTpCD = SCREN_PROCS_TP_CD_03;
		}else if(trsIdx=='3'){
			vScrenTpCD = SCREN_PROCS_TP_CD_04;
		}

		for (var i = 1 ; i <= dts_Isu.CountRow  ; i++) {
			dts_Isu.NameString(i, "BZ_PROCS_NO") = vBzProcsNo ;
			dts_Isu.NameString(i, "ISU_CD") = getObjectValue(txb_ISU_CD) ;
		};
		// 종목별기준으로 처리함
		// 1 : 종목별 , 2 : 법인별
		dts_Mst.NameString(dts_Mst.RowPosition, "MKTACT_APPL_OBJ_TP_CD") =  "1" ;
		dts_Mst.NameString(1, "ISUR_CD") = vIsurCd;

		//alert(dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "CODE") + "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "NAME")+ "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "REGL")) ;
		
		trs_Save.Action 	      = fn_encodeNSession( "/Delisting.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+vScrenTpCD+"&method=saveDelList" ) ;
		trs_Save.KeyName     = "toinb_dataid4";
		trs_Save.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_Isu)";
		trs_Save.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ vBzProcsNo +
								",COUNT=2" +
								",LIST_BZ_TP_CD=" + fn_getListBzTpCd() + 
								",DIV_IDX[0]=" + DIV_IDX_DELLIST_MST+
								",DIV_IDX[1]=" + DIV_IDX_DELLIST_DTL ;
								
		trs_Save.Post();
	}
	
	function fn_dscl() {
	
		if (  dts_Mst.IsUpdated  ) {
			alert(getMessageParam("MSG-0022", ""));
			return ;
		}

		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") { // 유가경우
			fn_GetPar = function(arr, param_dts_isu, param_dts_mst, param_dts2, param_dts3) {

				if( fr_SecuGrpId == SECUGRP_ID_SW ) {
					arr[0] = "68913";
				} else if( fr_SecuGrpId == SECUGRP_ID_SR ) {
					arr[0] = "68917";
				}
				arr[1] = vBzProcsNo ;
				arr[2] = vIsurCd ;
				arr[3] = vSPOT_ISU_TRD_MKT_TP_CD;
				arr[4] = "";
				arr[5] = '';
				
				//CopyDataSet( dts_Isu , param_dts_isu) ;
				CopyDataSet( dts_Mst , param_dts_mst) ;
				
				return arr.length;
			}
		} else if (vSPOT_ISU_TRD_MKT_TP_CD == "2") { // 코스닥인경우
			fn_GetPar = function(arr, param_dts_isu, param_dts_mst, param_dts2, param_dts3, param_dts4, param_dts_isu_eng, param_dts_mst_eng, param_dts_dtl_eng, param_dts_rel_eng, param_dts_dtl_all_eng) {
				if ( fr_SecuGrpId == SECUGRP_ID_SW ) {
					arr[0] = "70925";
				} else if ( fr_SecuGrpId == SECUGRP_ID_SR ) {
					arr[0] = "70930";
				}
				arr[1] = vBzProcsNo ;
				arr[2] =vIsurCd;
				arr[3] = vSPOT_ISU_TRD_MKT_TP_CD;
				
				CopyDataSet( dts_Mst , param_dts_mst ) ;
				CopyDataSet( dts_Mst_Eng , param_dts_mst_eng ) ;
	
				return arr.length;
			}		
		}


		fn_SetPar = function(arr) { }
	
		var wth = 730 + 5;
		var hgt = 785 + 30;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}

	function fn_drft() {
		var OldGet = fn_GetPar;
		
		fn_GetPar = function(arr) {
			arr[0] = dts_List.NameValue(1, "BZ_PROCS_NO");
			return arr.length;
		}
		
		fn_PopFindDraft();
		fn_GetPar = OldGet;
	}
	
//function fn_makt() { }


]]></script>

<events><event for="btn_Search" eventname="onclick"><![CDATA[
	if (getObjectValue(txb_ISU_CD) == "") {
		alert("[종목]을 선택하세요.");txb_ISU_CD.focus();return;
	} else {
		fn_initItem();
		fn_isubook_read_sync();
		fn_list_sync();
	}
]]></event>

<event for="img_ISU_NM" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsuCd;
	fn_SetPar = fn_SetParIsuCd;
	fn_PopFindIsu(fr_SecuGrpId);
]]></event>

<event for="img_DELIST_RSN_DSC" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParRsn;
	fn_SetPar = fn_SetParRsn;
	fn_PopFindClssLstRsnCd(RSNCD_DELIST);
]]></event>

<event for="img_DELIST_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_DELIST_DD);
]]></event>

<event for="grd_List" eventname="OnClick(row, colid)"><![CDATA[
	fn_read_sync(row);
]]></event>

<event for="dts_BZ_CHECK" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_BZ_CHECK);
]]></event>
<event for="dts_Mst" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Mst);
]]></event>
<event for="dts_Isu" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_Isu);
]]></event>
<event for="dts_List" eventname="OnLoadError()"><![CDATA[
	alert_error(dts_List);
]]></event>

<event for="dts_Mst" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	if (vBzProcsNo == "") {
		buttonSet.setInsertStatus();
	} else {
		if (cGetToday("yyyymmdd") <= getObjectValue(edt_DELIST_DD)) {
			buttonSet.setUpdateStatus();
		} else {
			buttonSet.setErrorStatus();
		}
	}
	
	//영문공시용 
	CopyDataSet( dts_Mst , dts_Mst_Eng) ;
	
]]></event>

<event for="dts_List" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	FillGridHeaderTotalCnt(rowcount, panel_page);
	if (vBzProcsNo == "") {
		buttonSet.setInsertStatus();
	}
]]></event>

<event for="trs_Save" eventname="OnSuccess()"><![CDATA[
	fn_alertMsg('S') ;
	fn_initItem() ;
	fn_list_sync();
	
	if (buttonSet.status != "D") { // 삭제처리의 응답인 경우
		fn_read_sync(dts_List.CountRow);
	}
]]></event>

<event for="trs_Save" eventname="OnFail()"><![CDATA[
	fn_alertMsg('F') ;
	alert_error(trs_Save);	
]]></event>


<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top);
	PanelToGroupBox(panel_Item);
	
   /* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 			// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 		// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );				// 안내문작성
	buttonSet.setDrftInfo( btn_Drft, fn_drft );				   		// 기안

	buttonSet.setInsertStatus();
	
	dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DELISTING_ISU_INOUT";
	dts_Isu.reset();	
	
	fn_initMktPerComponent(js_market);

]]></event>
<event for="btn_close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
<event for="img_DELIST_ADVNOTI_STRT_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_DELIST_ADVNOTI_STRT_DD);
]]></event>
<event for="img_DELIST_ADVNOTI_END_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_DELIST_ADVNOTI_END_DD);
]]></event>
<event for="img_ARRANTRD_END_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ARRANTRD_END_DD);
]]></event>
<event for="img_ARRANTRD_MKTACT_ENFORCE_DD" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_ARRANTRD_MKTACT_ENFORCE_DD);
]]></event></events>
</gform>

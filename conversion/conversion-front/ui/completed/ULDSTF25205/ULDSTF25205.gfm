	popUpCalendar2(edt_EDATE);
]]></event>

<event for="btn_SDATE" eventname="onclick"><![CDATA[
	popUpCalendar2(edt_SDATE);
]]></event>

<event for="btn_Search" eventname="onclick"><![CDATA[
	fn_Search();
]]></event>

<event for="dts_Grid" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	CloseWin(rowcount, grd_Grid);
	FillGridHeaderTotalCnt(rowcount, panel_page);	
]]></event>

<event for="dts_Grid" eventname="OnLoadError()"><![CDATA[

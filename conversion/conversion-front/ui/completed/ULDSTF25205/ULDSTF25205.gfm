]]></event>

<event for="btn_Excel" eventname="onclick"><![CDATA[
	doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
	grd_Grid.GridToExcel("감사보고서 제출", "", "8");
]]></event>

<event for="txb_ISUR_CD" eventname="onkeyup"><![CDATA[
	if (window.event.keyCode == 40) {
		//아래화살표눌렀을때 그리드로 포커스
		Grd_com_isur.Focus();
	}else{
		if(window.event.keyCode ==13){
			fn_com_Confirm_set();
		}else{
			fn_com_isur_nm(window.event.keyCode);
		}
	}
]]></event>

<event for="txb_ISUR_CD" eventname="onfocus"><![CDATA[
	Grd_com_isur.style.display = "";
]]></event>
<event for="txb_ISUR_CD" eventname="onblur"><![CDATA[
	if (stFocusGrid == false) {
		Grd_com_isur.style.display ="none";
	}
	if (txb_ISUR_CD.value == "") {txb_COM_NM.value = ""; }
]]></event>
<event for="btn_ISUR_CD" eventname="onclick"><![CDATA[
	IsurcdSearch(txb_ISUR_CD, txb_COM_NM);
]]></event>
<event for="Grd_com_isur" eventname="OnKeyPress(kcode)"><![CDATA[
	if(kcode =='13'){
		fn_com_Confirm_set();
	}
]]></event>
<event for="Grd_com_isur" eventname="OnDblClick(row, colid)"><![CDATA[
	fn_com_Confirm_set();
]]></event>
<event for="Grd_com_isur" eventname="OnClick(row, colid)"><![CDATA[
	Grd_com_isur.style.display ="";
]]></event>
<event for="Grd_com_isur" eventname="OnSetFocus()"><![CDATA[
	stFocusGrid = true;
]]></event>
<event for="Grd_com_isur" eventname="OnKillFocus()"><![CDATA[
	stFocusGrid = false;
	Grd_com_isur.style.display ="none";
]]></event>
<event for="txb_ISUR_CD" eventname="onfocus"><![CDATA[
    Grd_com_isur.style.display ="none";
]]></event>

<event for="MxDataSet_com_isur" eventname="OnFilter(row)"><![CDATA[
	if (skw !="" && foColum == "1") {
		f1 = MxDataSet_com_isur.NameString(row,"COM_ABBRV");
		f2 = MxDataSet_com_isur.NameString(row,"OLD_COM_ABBRV");
		if (f1.indexOf(skw) !=-1 ||f2.indexOf(skw) != -1) return true;
		else return false;  
	}else return true; 
]]></event>

<event for="txb_ISUR_CD" eventname="onkeyup"><![CDATA[
	if(txb_ISUR_CD.value==""){
		Grd_com_isur.style.display ="none";
	}else{
		if (window.event.keyCode == 40) { //아래화살표눌렀을때 그리드로 포커스
			Grd_com_isur.Focus();
		}else{
			fn_com_isur_nm(window.event.keyCode);
		}
	}
]]></event>

<event for="gform" eventname="onload"><![CDATA[
	fn_HideDebugCtrls();

	fn_com_isur(txb_ISUR_CD, txb_COM_NM);
	Grd_com_isur.style.zIndex = 30;

	PanelToGroupBox(panel_1);

	fn_SetCode();
	fn_Init();
]]></event></events>
</gform>

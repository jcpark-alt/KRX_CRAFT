<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1270" height="750" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_STD_INDTP1">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_STD_INDTP2"></mxdataset>
		<mxdataset id="dts_STD_INDTP3"></mxdataset>
		<mxdataset id="dts_Grid"></mxdataset>
		<mxdataset id="MxDataSet_com_isur"></mxdataset>
	</model>
    <components>
		<panel id="panel_1" class="TopCondition_01" left="5" top="5" width="1255" height="90">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_29" class="TopCondition_01" left="10" top="10" width="75" height="20" text="시장구분">
			<extproperty background-color="#d9e9fc"></extproperty>
		</label>
			<label id="label_1" class="TopCondition_01" left="10" top="60" width="75" height="20" text="표준산업업종"></label>
			<mxcombo id="cmb_STD_INDTP1" left="90" top="60" width="214" height="20" tabindex="6">
			<property bindcolumn="VALUE" cbdatacolumns="value,text" index="0" inheritcolor="False" listcount="10" listexprformat="value^1^79,text^0^263" searchcolumn="TEXT" xpstyle="True"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			<ref combodataid="dts_STD_INDTP1"></ref>
			</mxcombo>
			<mxcombo id="cmb_STD_INDTP2" left="310" top="60" width="214" height="20" tabindex="7">
			<property bindcolumn="VALUE" cbdatacolumns="value,text" enable2="True" index="0" inheritcolor="False" listcount="10" listexprformat="value^1^79,text^0^263" searchcolumn="TEXT" xpstyle="True"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			<ref combodataid="dts_STD_INDTP2"></ref>
			</mxcombo>
			<mxcombo id="cmb_STD_INDTP3" left="530" top="60" width="214" height="20" tabindex="8">
			<property bindcolumn="VALUE" cbdatacolumns="value,text" enable2="True" index="0" inheritcolor="False" listcount="10" listexprformat="value^1^79,text^0^263" searchcolumn="TEXT" xpstyle="True"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			<ref combodataid="dts_STD_INDTP3"></ref>
			</mxcombo>
			<image id="btn_Search" left="1190" top="10" width="50" height="22" src="../img/btn_select.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_2" class="TopCondition_01" left="765" top="60" width="40" height="20" text="결산월">
			<extproperty vertical-align="middle"></extproperty>
			</label>
			<mxcombo id="cmb_f_mm_1" left="810" top="60" width="115" height="20">
			<property bindcolumn="value" cbdata="%^전체,12^12월,11^11월,10^10월,09^09월,08^08월,07^07월,06^06월,05^05월,04^04월,03^03월,02^02월,01^01월" cbdatacolumns="value,text" haslistgridhorizline="False" haslistgridvertline="False" index="0" inheritcolor="False" listcount="10" listexprformat="text^0^100" xpstyle="True"></property>
			<extproperty font-size="12"></extproperty>
			</mxcombo>
			<image id="image_11" left="1180" top="6" width="2" height="80" src="../img/img_line2.gif"></image>
			<mxradio id="rdo_MKT_ID" class="TopCondition_Blue" left="90" top="10" width="165" height="18">
			<property automargin="True" cols="3" enable="False" format="9^전체,1^유가,2^코스닥"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			</mxradio>
			<mxmaskedit id="edt_EDATE" class="panel_maskedit_write_01" left="650" top="35" width="68" height="20" tabindex="4">
			<property border="False" format="YYYY-MM-DD" numeric="False" valign="1"></property>
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="btn_EDATE" left="720" top="35" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxcombo id="cmb_PeriodTp" left="750" top="35" width="108" height="20" tabindex="5">
			<property bindcolumn="disp" cbdata="1주일^1,1개월^2,3개월^3,6개월^4,1년^5,2년^6" cbdatacolumns="disp,value" defaultstring="기간선택" inheritcolor="False" listcount="10" listexprformat="disp^0^70" maxlength="20" xpstyle="True"></property>
			<extproperty font-family="돋움" font-size="12"></extproperty>
			</mxcombo>
			<label id="label_5" class="TopCondition_01" left="625" top="35" width="20" height="20" text="~">
			<extproperty text-align="center"></extproperty>
			</label>
			<mxmaskedit id="edt_SDATE" class="panel_maskedit_write_01" left="530" top="35" width="68" height="20" tabindex="3">
			<property border="False" format="YYYY-MM-DD" numeric="False" valign="1"></property>
			<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxmaskedit>
			<image id="btn_SDATE" left="600" top="35" width="21" height="20" src="../img/icn_calendar.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_7" class="TopCondition_01" left="470" top="35" width="55" height="20" text="검색일자"></label>
		</panel>
		<mxgrid id="grd_Grid" class="Grid_01" left="5" top="100" width="1253" height="604">
			<property autoresizing="True" autoresizingallcol="True" autoresizingwithheader="True" colsizing="True" fillarea="True" fixsizing="True" gtitleheight="0" rowheight="20" sortview="left" titleheight="25" xtitleheight="0" tooltip="use=true;alt=true;createtime=300;destroytime=10000;width=400;color=#ffffff;backcolor=#808080;edgecolor=#333333;leftmargin=10;rightmargin=10;topmargin=10;bottommargin=10;"></property>
			<format>
				<fcolumn id="NO" width="50" name="번호" align="center" value="{CurRow},{ToString}"></fcolumn>
				<fcolumn id="MKT_NM" width="75" name="시장구분" align="center" sort="True"></fcolumn>
				<fcolumn id="LIST_STAT_NM" width="75" name="상장여부" color="{Decode(LIST_STAT_CD,'Y','#000000','D','#FF0033','N','#009933')}" align="center" sort="True"></fcolumn>
				<fcolumn id="COM_ABBRV" width="120" name="회사명" color="{Decode(LIST_STAT_CD,'Y','#000000','D','#FF0033','N','#009933')}" sort="True"></fcolumn>
				<fcolumn id="ISU_SRT_CD" name="종목코드" width="80" align="center" sort="True"></fcolumn>
				<fcolumn id="STD_IND_NM" name="표준산업업종" width="110" sort="True"></fcolumn>
				<fcolumn width="80" name="원공시일" mask="XXXX-XX-XX" id="ORGN_DISCLS_DDTM" align="center" sort="True"></fcolumn>
				<fcolumn width="100" name="(정정)공시일" mask="XXXX-XX-XX" id="DISCLS_DDTM" align="center" bgcolor="#ffff99" cursor="hand" sort="True"></fcolumn>
				<column width="95" name="외부감사인" id="EXT_AUDTR_NM" sort="True"></column>
				<column width="100" name="연결재무제표;제출대상" id="CONSFS_SUBMIT_OBJ_YN" sort="True" align="center"></column>
				<column width="90" name="감사보고서;수령일" id="AUDT_WRTRPT_ACPT_DD" sort="True" mask="XXXX-XX-XX" align="center" color="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
				<column width="80" name="당해년도;감사의견;(개별)" id="THSBZYY_AUDT_OPIN_TP_NM" align="center" sort="True"></column>
				<column width="80" name="직전년도;감사의견;(개별)" id="LSTBZYY_AUDT_OPIN_TP_NM" align="center" sort="True"></column>
				<column width="80" name="당해년도;감사의견;(연결)" id="L_THSBZYY_AUDT_OPIN_TP_NM" align="center" sort="True"></column>
				<column width="80" name="직전년도;감사의견;(연결)" id="L_LSTBZYY_AUDT_OPIN_TP_NM" align="center" sort="True"></column>
				<column width="100" name="당해년도;자본잠식여부" id="THSBZYY_IMPCAP_TP_NM" align="center" sort="True"></column>
				<column width="100" name="직전년도;자본잠식여부" id="LSTBZYY_IMPCAP_TP_NM" align="center" sort="True"></column>
				<group name="당해년도;(개별)">
					<column width="119" name="자산총계" id="CURTRM_TOT_ASST_AMT" sort="True"></column>
					<column width="120" name="부채총계" id="CURTRM_TOT_DEBT_AMT" sort="True"></column>
					<column width="110" name="자본금" id="CURTRM_CAP" sort="True"></column>
					<column width="118" name="자본총계" id="CURTRM_TOT_CAP" sort="True"></column>
					<column width="105" name="매출액" id="CURTRM_SALES" sort="True"></column>
					<column width="116" name="영업이익" id="CURTRM_OPERPROFT_AMT" sort="True"></column>
					<column width="110" name="경상이익" id="CURTRM_ORDNINCM_AMT" sort="True"></column>
					<column width="127" name="당기순이익" id="CURTRM_NETINCM_AMT" sort="True"></column>
					<column width="184" name="법인세비용차감전;순손익및계속사업손익금액" id="CURTRM_BFTAX_NETPL_AMT" sort="True"></column>
					<column width="176" name="자본총계/자본금(%)" id="CURTRM_CMPCAP_TOT_CAP_RTO" sort="True"></column>
					<column width="129" name="자본잠식율" id="CURTRM_IMPCAP_RTO" sort="True"></column>
				</group>
				<group name="직전년도;(개별)">
					<column width="117" name="자산총계" id="FSTTRM_TOT_ASST_AMT" sort="True"></column>
					<column width="115" name="부채총계" id="FSTTRM_TOT_DEBT_AMT" sort="True"></column>
					<column width="105" name="자본금" id="FSTTRM_CAP" sort="True"></column>
					<column width="113" name="자본총계" id="FSTTRM_TOT_CAP" sort="True"></column>
					<column width="106" name="매출액" id="FSTTRM_SALES" sort="True"></column>
					<column width="113" name="영업이익" id="FSTTRM_OPERPROFT_AMT" sort="True"></column>
					<column width="119" name="경상이익" id="FSTTRM_ORDNINCM_AMT" sort="True"></column>
					<column width="121" name="당기순이익" id="FSTTRM_NETINCM_AMT" sort="True"></column>
					<column width="174" name="법인세비용차감전;순손익및계속사업손익금액" id="BFFSTTRMTAX_NETPL_AMT" sort="True"></column>
					<column width="179" name="자본총계/자본금(%)" id="CMPEQTY_TOT_CAP_RTO" sort="True"></column>
					<column width="125" name="자본잠식율" id="FSTTRM_IMPCAP_RTO" sort="True"></column>
				</group>
				<group name="당해년도;(연결)">
					<column width="119" name="자산총계" id="L_CURTRM_TOT_ASST_AMT" sort="True"></column>
					<column width="120" name="부채총계" id="L_CURTRM_TOT_DEBT_AMT" sort="True"></column>
					<column width="110" name="자본금" id="L_CURTRM_CAP" sort="True"></column>
					<column width="118" name="자본총계" id="L_CURTRM_TOT_CAP" sort="True"></column>
					<column width="105" name="매출액" id="L_CURTRM_SALES" sort="True"></column>
					<column width="116" name="영업이익" id="L_CURTRM_OPERPROFT_AMT" sort="True"></column>
					<column width="110" name="경상이익" id="L_CURTRM_ORDNINCM_AMT" sort="True"></column>
					<column width="127" name="당기순이익" id="L_CURTRM_NETINCM_AMT" sort="True"></column>
					<column width="184" name="법인세비용차감전;순손익및계속사업손익금액" id="L_CURTRM_BFTAX_NETPL_AMT" sort="True"></column>
					<column width="176" name="자본총계/자본금(%)" id="L_CURTRM_CMPCAP_TOT_CAP_RTO" sort="True"></column>
					<column width="129" name="자본잠식율" id="L_CURTRM_IMPCAP_RTO" sort="True"></column>
				</group>
				<group name="직전년도;(연결)">
					<column width="117" name="자산총계" id="L_FSTTRM_TOT_ASST_AMT" sort="True"></column>
					<column width="115" name="부채총계" id="L_FSTTRM_TOT_DEBT_AMT" sort="True"></column>
					<column width="105" name="자본금" id="L_FSTTRM_CAP" sort="True"></column>
					<column width="113" name="자본총계" id="L_FSTTRM_TOT_CAP" sort="True"></column>
					<column width="106" name="매출액" id="L_FSTTRM_SALES" sort="True"></column>
					<column width="113" name="영업이익" id="L_FSTTRM_OPERPROFT_AMT" sort="True"></column>
					<column width="119" name="경상이익" id="L_FSTTRM_ORDNINCM_AMT" sort="True"></column>
					<column width="121" name="당기순이익" id="L_FSTTRM_NETINCM_AMT" sort="True"></column>
					<column width="174" name="법인세비용차감전;순손익및계속사업손익금액" id="L_BFFSTTRMTAX_NETPL_AMT" sort="True"></column>
					<column width="179" name="자본총계/자본금(%)" id="L_CMPEQTY_TOT_CAP_RTO" sort="True"></column>
					<column width="125" name="자본잠식율" id="L_FSTTRM_IMPCAP_RTO" sort="True"></column>
				</group>
				<column width="136" name="기타" id="MISC_CONTN"></column>
			</format>
			<ref dataid="dts_Grid"></ref>
		</mxgrid>
		<label id="label_4" class="TopCondition_01" left="15" top="40" width="75" height="20" text="법인코드(명)">
			<extproperty background-color="#d9e9fc"></extproperty>
		</label>
		<mxgrid id="Grd_com_isur" class="Grid_01" left="995" top="190" width="274" height="99">
			<property gtitleheight="0" sortview="left" usingoneclick="1" viewheader="False" xtitleheight="0"></property>
			<format>
				<column id="SPOT_ISU_TRD_MKT_TP_CD" width="20" name="시장구분" align="center" data="1:유,2:코" edit="none" editstyle="combo"></column>
				<column id="COM_ABBRV" width="186" sort="True" name="회사명" align="left" color="{Decode(LIST_STAT_CD,'Y','#000000','D','#FF0033','N','#009933')}"></column>
				<column id="ISUR_CD" width="50" sort="True" headalign="center" name="회사코드" align="center"></column>
				<column id="LIST_STAT_CD" show="false"></column>
			</format>
			<ref dataid="MxDataSet_com_isur"></ref>
		</mxgrid>
		<textbox id="txb_ISUR_CD" left="95" top="40" width="90" height="20" maxlength="20">
			<extproperty font-family="돋움" font-size="12" color="#343434 " border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
		</textbox>
		<textbox id="txb_COM_NM" class="panel_text_read_01" left="189" top="40" width="235" height="20" readonly="readonly" maxlength="1000">
			<extproperty font-family="돋움" font-size="12" color="#343434 " border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
		</textbox>
		<image id="btn_ISUR_CD" left="429" top="41" width="20" height="19" src="../img/btn_search.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<panel id="panel_page" left="5" top="710" width="1170" height="20">
			<extproperty></extproperty>
		</panel>
		<image id="btn_Excel" left="1180" top="710" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/common.js");
	#include("../js/utils.js");
	#include("../js/stf.js");
	#include("../js/session.js");
	#include("../js/PopupCalendar.js");
	#include("../js/libRoundPanel.js");
	#include("../js/controlResize.js"); // 화면 리사이징

	var gDepCd = js_dep_cd;
	var gEmpNo = js_emp_no;
	var gLdMktTp = js_market;
	var gAcptNo;
	var vScrenID = 'ULDSTF25205.gfm';

	function fn_HideDebugCtrls()
	{
	}

	function fn_SetCode()
	{
		dts_STD_INDTP1.DataID = "/CodeAction.do?method=listStdIndtp&For=R&Flag=1";
		dts_STD_INDTP1.Reset();
		
		dts_STD_INDTP2.DataID = "/CodeAction.do?method=listStdIndtp&For=R&Flag=2";
		dts_STD_INDTP2.Reset();
		
		/*
		// 시장에 따라 코드를 다르게 가져온다. (YSH, 2008/09/25)
		if("1" == gLdMktTp){
			dts_STD_INDTP3.DataID = "/CodeAction.do?method=listStdIndtp&For=R&Flag=3";
		}else{	//코스닥용 업종코드
			dts_STD_INDTP3.DataID = "/CodeAction.do?method=listStdIndtp&For=R&Flag=6";
		}
		*/
		
		// 시장시스템 오픈에 따른 수정 : 2009.03.20 happyhan
		dts_STD_INDTP3.DataID = "/CodeAction.do?method=listStdIndtp&For=R&Flag=3";
		dts_STD_INDTP3.Reset();	
		//alert(dts_GRADE.ExportData(1, dts_GRADE.CountRow, true));
		
		//  기간 from~ to  셋팅	
		vCurDate = cGetToday("yyyymmdd");	
		edt_SDATE.text = cGetMinusYear(vCurDate,1) ; 	// 1년전 날짜
		edt_EDATE.text =vCurDate;	// 현재날짜	
	}
	
	function fn_Search()
	{
		ShowWin(grd_Grid);
		var url = "/DisclosureStatistics.do?method=listAuditReport";
			url += "&MKT_ID=" + getObjectValue(rdo_MKT_ID);
			url += "&ISUR_CD=" + getObjectValue(txb_ISUR_CD);
			url += "&SDATE=" + getObjectValue(edt_SDATE);
			url += "&EDATE=" + getObjectValue(edt_EDATE);
			url += "&STD_INDTP1=" + getObjectValue(cmb_STD_INDTP1);
			url += "&STD_INDTP2=" + getObjectValue(cmb_STD_INDTP2);
			url += "&STD_INDTP3=" + getObjectValue(cmb_STD_INDTP3);	
			url += "&ACNTCLS_MMDD1=" + getObjectValue(cmb_f_mm_1);	
			url += "&SCREN_ID=" +vScrenID;
			url += "&SCREN_PROCES_TP_CD=" +SCREN_PROCS_TP_CD_01;
			
		dts_Grid.DataID = encodeURI(url);
		dts_Grid.Reset();	
	}
	
	function fn_Init()
	{
		setObjectValue(rdo_MKT_ID, js_market);
		if (js_market == "9")
		{
			rdo_MKT_ID.Enable = true;
			rdo_MKT_ID.ClassName = "TopCondition_Blue";
		}
		else
		{// 콘트롤 잠그기.
			grd_Grid.ColumnProp("MKT_NM", "Show") = false;
			rdo_MKT_ID.Enable = false;
		}
	}

	// 그리드에서 클릭 row의 변수셋팅
	function fn_setContnId(obj) {		
		gAcptNo = dts_Grid.NameString(eval(obj),"ACPT_NO");
	}
]]></script>

<events><event for="grd_Grid" eventname="OnDblClick(row, colid)"><![CDATA[
	// 클릭된 값 변수에 셋팅
	fn_setContnId(row);
	
	if (colid == "DISCLS_DDTM") { 		
		fn_OpenDisclViewer(gAcptNo, "R");
	}  
]]></event>

<event for="cmb_STD_INDTP1" eventname="OnSelChange()"><![CDATA[
	dts_STD_INDTP2.UseFilter = true;
	dts_STD_INDTP2.Filter();
]]></event>

<event for="cmb_STD_INDTP2" eventname="OnSelChange()"><![CDATA[
	dts_STD_INDTP3.UseFilter = true;
	dts_STD_INDTP3.Filter();
]]></event>

<event for="dts_STD_INDTP2" eventname="OnFilter(row)"><![CDATA[
	var vVal = getObjectValue(cmb_STD_INDTP1);
	if (vVal == "")
	{// 대분류가 전체일 경우
		return true;
	}
	else
	{
		var vVal2 = dts_STD_INDTP2.NameString(row, "value");
		if (vVal2 == "") return true;
		if (vVal.substring(0, 2) == vVal2.substring(0, 2))
		{
			return true;
		}
		else
		{
			return false;
		}
	}
]]></event>

<event for="dts_STD_INDTP3" eventname="OnFilter(row)"><![CDATA[
	var vVal = getObjectValue(cmb_STD_INDTP2);
	if (vVal == "")
	{// 대분류가 전체일 경우
		return true;
	}
	else
	{
		var vVal2 = dts_STD_INDTP3.NameString(row, "value");
		if (vVal2 == "") return true;
		if (vVal.substring(0, 4) == vVal2.substring(0, 4))
		{
			return true;
		}
		else
		{
			return false;
		}
	}
]]></event>

<event for="cmb_PeriodTp" eventname="OnSelChange()"><![CDATA[
	var vTp = getObjectValue(cmb_PeriodTp);
	fn_setFromToDate(vTp, edt_SDATE, edt_EDATE);	
]]></event>


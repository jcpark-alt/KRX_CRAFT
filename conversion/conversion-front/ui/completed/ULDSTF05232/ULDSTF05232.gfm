<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(panel_Top);
	
   /* buttonSet의 초기화를 수행한다.  각 용도에 맞게 이미지ID와 onclick event시 수행할 function을 지정한다. */
	buttonSet.setSaveInfo( btn_Save, fn_save ); 			// 저장
	buttonSet.setUpdateInfo( btn_Update, fn_update ); 	// 수정
	buttonSet.setDeleteInfo( btn_Delete, fn_delete ); 		// 삭제
	buttonSet.setDsclInfo( btn_Dscl, fn_dscl );				// 안내문작성
	buttonSet.setDrftInfo( btn_Drft, fn_drft );				   		// 기안

	buttonSet.setInsertStatus();

	dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=DELISTING_INOUT";
	dts_Mst.reset();
	dts_Mst.AddRow();
	
	var strCodeCnt = "";
	
	if(js_market == "6"){
		showObj(cmb_SPECL_LIST_TP_CD, true);
		showObj(cmb_PRE_LIST_TP_CD, true);
		showObj(txa_DSC, true);
		showObj(label_25, true);
		showObj(label_26, true);
		strCodeCnt = "코넥스시장상장규정 제28조 및 제33조^코넥스시장상장규정 제28조 및 제33조,직접 입력하세요^수기 입력";
		fn_searchCode() ;
	}else{
		showObj(cmb_SPECL_LIST_TP_CD, false);
		showObj(cmb_PRE_LIST_TP_CD, false);
		showObj(txa_DSC, false);
		showObj(label_25, false);
		showObj(label_26, false);
		strCodeCnt = "유가증권시장상장규정 제48조^유가증권시장상장규정 제48조,코스닥시장상장규정 제23조 및 제54조^코스닥시장상장규정 제23조 및 제54조,코스닥시장상장규정 제23조 및 제82조^코스닥시장상장규정 제23조 및 제82조"
								+ ",코스닥시장상장규정 제54조 및 제73조^코스닥시장상장규정 제54조 및 제73조,직접 입력하세요^수기 입력";
	}
	cmb_GRND_REGUL_NM.CBData = strCodeCnt;
	
	showObj(label_24, false);
	showObj(label_18, true);
]]></event>


	var pMenuID = InfoMenuID();
	var fn_GetPar, fn_SetPar ;
    var fr_SecuGrpId = fn_getSecuGrpId(InfoMenuID()); // mid 부모프레임으로 부터 받은 menu id로 증권그룹id를 반환하는 함수 호출, 법인선택팝업에서 fr_SecuGrpId 변수를 참조. 
	var vBzProcsNo = "";
	var vSPOT_ISU_TRD_MKT_TP_CD;
	var trsIdx ;  // insert, update 구분
	var spacYN = "N";  //기업인수목적 회사 구분
	
	function fn_searchCode() {
		/*
		004048 -  특례상장구분코드
		04108 - 이전상장구분코드
		*/
		var arrCid = [
					  {cid: "SPECL_LIST_TP_CD"	, cnm: "cmb_SPECL_LIST_TP_CD"}
					 ,{cid: "PRE_LIST_TP_CD"		, cnm: "cmb_PRE_LIST_TP_CD"}
					 ];

		var objCod;
		var url = '';
		
		url = "/CodeAction.do?method=listCodeValueNameM&inputMessageId=CODE_M_IN&outputMessageId=CODE_M_OUT" + 
				  "&CD_ID_M='SPECL_LIST_TP_CD','PRE_LIST_TP_CD'";
				  
		dts_Cod.DataID = encodeURI(url);
		dts_Cod.reset();

		var strCbd = "", i, j;

		for (i = 0; i < arrCid.length; i++)  {
			objCod = document.getElementById(arrCid[i].cnm);
			//alert('[objCod]'+objCod);
			if (objCod == null) { alert(arrCid[i].cnm) };

			strCbd = "^선택,";
			for (j = 1; j <= dts_Cod.CountRow; j++) {
				if (dts_Cod.NameValue(j, "CD_ENG_NM") == arrCid[i].cid) {
					strCbd = strCbd + (strCbd == "" ? "" : ",") + dts_Cod.NameValue(j, "VALUE") + "^" + dts_Cod.NameValue(j, "TEXT");
				}
			}
			objCod.CBData = strCbd;
		}
	}
	
	function fn_GetParIsur(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = txb_ISUR_CD.value; // 발행기관코드값
		arrPar[1] = txb_COM_NM.value; // 발행기관명
		return arrPar.length;
	} 
	
	function fn_SetParIsur(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			txb_ISUR_CD.value = arrPar[0].ISUR_CD;
			txb_COM_NM.value = arrPar[0].COM_NM;
			fr_SecuGrpId = arrPar[0].SECUGRP_ID; 
			vSPOT_ISU_TRD_MKT_TP_CD = arrPar[0].SPOT_ISU_TRD_MKT_TP_CD;
			
			if(vSPOT_ISU_TRD_MKT_TP_CD == "6"){
				showObj(label_24, true);
				showObj(label_18, false);
				showObj(label_23, false);
			}else{
				showObj(label_24, false);
				showObj(label_18, true);
				showObj(label_23, true);
			}
			fn_setComponent();
			fn_initItem();
			fn_list_sync();

			buttonSet.setButtonDepCd(dts_ByCorpDepCd, txb_ISUR_CD.value, js_dep_cd);
			
			buttonSet.setInsertStatus();
		}
	}
	
	function fn_setComponent() {
		if ( vSPOT_ISU_TRD_MKT_TP_CD == '1' ) {
			img_DELIST_RSN_DSC.src = "../img/btn_search.gif";
			img_DELIST_RSN_DSC.disabled = false;
			
			txb_DELIST_RSN_DSC.readOnly = true;
			txb_DELIST_RSN_DSC.style.backgroundColor='#b9d4f7';
			
			img_MKTPARTC_KOR_NM.src = "../img/btn_search_d.gif";
			img_MKTPARTC_KOR_NM.disabled = true;
			
		} else if ( vSPOT_ISU_TRD_MKT_TP_CD == '2' ||vSPOT_ISU_TRD_MKT_TP_CD=='6') {
			img_DELIST_RSN_DSC.src = "../img/btn_search_d.gif";
			img_DELIST_RSN_DSC.disabled = true;
			
			txb_DELIST_RSN_DSC.readOnly = false;
			txb_DELIST_RSN_DSC.style.backgroundColor='#ffffff';
			
			img_MKTPARTC_KOR_NM.src = "../img/btn_search.gif";
			img_MKTPARTC_KOR_NM.disabled = false;

			setObjectValue(edt_DELIST_ADVNOTI_STRT_DD, '');
			edt_DELIST_ADVNOTI_STRT_DD.readOnly = true;
			edt_DELIST_ADVNOTI_STRT_DD.ReadOnlyBackColor='#b9d4f7';
			img_DELIST_ADVNOTI_STRT_DD.src = "../img/icn_calendar_d.gif";
			
			setObjectValue(edt_DELIST_ADVNOTI_END_DD, '');
			edt_DELIST_ADVNOTI_END_DD.readOnly = true;
			edt_DELIST_ADVNOTI_END_DD.ReadOnlyBackColor='#b9d4f7';
			img_DELIST_ADVNOTI_END_DD.src = "../img/icn_calendar_d.gif";
			
			setObjectValue(txb_DELIST_ADVNOTI_PD_DSC, '');
			txb_DELIST_ADVNOTI_PD_DSC.readOnly = true;
			txb_DELIST_ADVNOTI_PD_DSC.style.backgroundColor='#b9d4f7';			
			
			setObjectValue(cmb_PRE_LIST_TP_CD, '');
			setObjectValue(txa_DSC, '');
			if(vSPOT_ISU_TRD_MKT_TP_CD=='6') {
				cmb_PRE_LIST_TP_CD.Enable2 = true;
				txa_DSC.Enable2 = true;
			} else {
				cmb_PRE_LIST_TP_CD.Enable2 = false;
				txa_DSC.Enable2 = false;
			}
		}
	}
	
	
	function fn_GetParRsn(arrPar) {  // 넘길 인수를 지정하는 펑션
		arrPar[0] = "K";
		arrPar[1] = "05";
		arrPar[5] = spacYN; //기업인수목적 회사 
		return arrPar,length;
	} 
	
	function fn_SetParRsn(arrPar) {
		dts_Mst.NameString(1, "DELIST_RSN_CD") = (arrPar.length >= 1 ? arrPar[0] : "");
		txb_DELIST_RSN_DSC.value = (arrPar.length >= 2 ? arrPar[1] : "");
		txb_GRND_REGUL_NM.value = (arrPar.length >= 3 ? arrPar[2] : "");
	}
	

	function fn_SetParMbrNo(arrPar) {
		//txb_list_agnccom_mbr_cd.value = (arrPar.length >= 1 ? arrPar[0] : "");
		dts_Mst.NameString(1, "LIST_AGNCCOM_MBR_NO") = (arrPar.length >= 1 ? arrPar[0] : "");
		txb_MKTPARTC_KOR_NM.value = (arrPar.length >= 2 ? arrPar[1] : "");
	}
	
	function fn_new_read_sync() {
		var url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=listMarketNew&inputMessageId=DELISTING_ISU_INOUT&ISUR_CD="+getObjectValue(txb_ISUR_CD)
		dts_Isu.DataID =encodeURI(url);
		dts_Isu.reset();	
		CopyDataSet(dts_Isu, dts_Secu);
	}

	function fn_list_sync() {
		var url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=listMarketDetail&inputMessageId=DELISTING_INOUT&ISUR_CD="+getObjectValue(txb_ISUR_CD)+"&MKTACT_APPL_OBJ_TP_CD=2" ; 
		
		dts_List.DataID = encodeURI(url);
		dts_List.Reset();
	}	

	function fn_OpenDetail(row) {
		vBzProcsNo = dts_List.NameString(dts_List.RowPosition, "BZ_PROCS_NO");
		
		var url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=masterDetail&inputMessageId=DELISTING_INOUT&BZ_PROCS_NO=" + vBzProcsNo; 
		dts_Mst.DataID =encodeURI(url);
		dts_Mst.reset();	
		
		url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=listMarket&inputMessageId=DELISTING_ISU_INOUT&BZ_PROCS_NO=" + vBzProcsNo ; 
		dts_Isu.DataID =encodeURI(url);
		dts_Isu.reset();	
		
		
		/* 2009.06.08 영문공시관련 추가 */
		url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=masterDetailEng&inputMessageId=DELISTING_INOUT&BZ_PROCS_NO=" + vBzProcsNo; 
		dts_Mst_Eng.DataID =encodeURI(url);
		dts_Mst_Eng.reset();	
		
		url =  "/Delisting.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=listMarketEng&inputMessageId=DELISTING_ISU_INOUT&BZ_PROCS_NO=" + vBzProcsNo ; 
		dts_Isu_Eng.DataID =encodeURI(url);
		dts_Isu_Eng.reset();	
		/* 2009.06.08 영문공시관련 추가 End */
		
	}

	function fn_initItem() {
		buttonSet.setInsertStatus();
		dts_Isu.ClearData();
		dts_Mst.ClearData();
		dts_Mst.AddRow();
		vBzProcsNo = ""; //초기화 
		setObjectValue(cmb_GRND_REGUL_NM, "");
	}


	function fn_CheckForm() {
		var vCurDate = cGetToday("yyyymmdd");
		if (getObjectValue(txb_ISUR_CD) == "") {
			alert("[회사]를 선택하세요.");return false;
		}
		if (dts_Isu.CountRow == 0) {
			alert("[상장폐지 종목]을선택하세요");return false;
		}
		
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") {	
			if (dts_Mst.NameString(1, "DELIST_RSN_CD") == "") {
				alert("[상장폐지사유]를 선택하세요.");txb_DELIST_RSN_DSC.focus();return false;
			};
		} else if (vSPOT_ISU_TRD_MKT_TP_CD == "2" || vSPOT_ISU_TRD_MKT_TP_CD == "6") {
            if (getObjectValue(txb_DELIST_RSN_DSC) == "") {
				alert("[상장폐지사유]를 입력하세요.");txb_DELIST_RSN_DSC.focus();return false;
			};
			if ( !checkMaxLength( txb_DELIST_RSN_DSC , 2000 , "상장폐지사유" ) ) return false ;
		}

	    if (getObjectValue(edt_DELIST_ADVNOTI_STRT_DD) != "" || getObjectValue(edt_DELIST_ADVNOTI_END_DD) != "") {
			if (getObjectValue(edt_DELIST_ADVNOTI_STRT_DD) == "") {
				alert("[상장폐지예고 시작일]을 입력하세요.");edt_DELIST_ADVNOTI_STRT_DD.focus();return false;
			}
			
			if (getObjectValue(edt_DELIST_ADVNOTI_END_DD) == "") {
				alert("[상장폐지예고 종료일]을 입력하세요.");edt_DELIST_ADVNOTI_END_DD.focus();return false;
			}
			
			if (!compareFromToDate(edt_DELIST_ADVNOTI_STRT_DD, edt_DELIST_ADVNOTI_END_DD,  "상장폐지예고 시작일",  "상장폐지예고 종료일"))  return false;
		}

	    if (getObjectValue(edt_ARRANTRD_MKTACT_ENFORCE_DD) != "" || getObjectValue(edt_ARRANTRD_END_DD) != "") {
			if (getObjectValue(edt_ARRANTRD_MKTACT_ENFORCE_DD) == "") {
				alert("[정리매매허용 시작일]을 입력하세요.");edt_ARRANTRD_MKTACT_ENFORCE_DD.focus();return false;
			}
			
			if (getObjectValue(edt_ARRANTRD_END_DD) == "") {
				alert("[정리매매허용 종료일]을 입력하세요.");edt_ARRANTRD_END_DD.focus();return false;
			}			

			if (!compareFromToDate(edt_ARRANTRD_MKTACT_ENFORCE_DD, edt_ARRANTRD_END_DD,  "정리매매허용 시작일",  "정리매매허용 종료일"))  return false;
		}

	    if (getObjectValue(edt_DELIST_DD) == "") {
			alert("[상장폐지일]을 입력하세요.");edt_DELIST_DD.focus();return false;
		}
		if (vCurDate >= getObjectValue(edt_DELIST_DD)) {
			alert("[상장폐지일]을 현재일이후로 입력하세요.");edt_DELIST_DD.focus();return false;
		}

		if (getObjectValue(txb_GRND_REGUL_NM) == "") {
			alert("[근거규정]을 입력하세요.");txb_GRND_REGUL_NM.focus();return false;
		} 

		if ( !checkMaxLength( txb_GRND_REGUL_NM , 200 , "근거규정" ) ) return false ;
		
		if (vSPOT_ISU_TRD_MKT_TP_CD == "2" ) {
            if (dts_Mst.NameString(1, "LIST_AGNCCOM_MBR_NO") == "") {
				alert("[상장주선인]를 선택하세요.");txb_MKTPARTC_KOR_NM.focus();return false;
			}
		}

		if (! fn_check_bz_doubleinput(	dts_BZ_CHECK, 
														getObjectValue(txb_ISUR_CD),
														getObjectValue(edt_DELIST_DD),
														vBzProcsNo,
														LIST_BZ_TP_CD_200)) {
			return false;
		}

		// 코넥스 이전상장구분 필수값 체크추가 jackal_22.06.24
		if (vSPOT_ISU_TRD_MKT_TP_CD == '6') {
			if(getObjectValue(cmb_PRE_LIST_TP_CD) == "" ) {
				alert("[이전상장구분(코넥스)]를 선택하세요.");cmb_PRE_LIST_TP_CD.focus();return false;
			}
		}
		
		return true;
	}
	
    function fn_save() {
		trsIdx = TRS_IDX_INSERT ;
		
		if (! fn_CheckForm()) return;
		if (! fn_isProcess('I') )  return ;
		
		vBzProcsNo = fn_getNewBzProcNo( dts_BzProcsNo );

		if (vBzProcsNo.length != 14) {
			alert(getMessageParam("MSG-0010", ""));
		} else {

			dts_Mst.NameString(1, "BZ_PROCS_NO") = vBzProcsNo;
			dts_Mst.NameString(1, "ISUR_CD") = getObjectValue(txb_ISUR_CD);
			//alert('[dts_Mst]'+dts_Mst.text);
			fn_trs();
		}
	}
	
	function fn_update() {
		trsIdx = TRS_IDX_UPDATE ;
		if (! fn_CheckForm() ) return;
		if (! fn_isProcess('U') )  return ;
		fn_trs();
	}	

	function fn_update2() {
		trsIdx = TRS_IDX_UPDATE ;
		if (! fn_CheckForm() ) return;
		//if (! fn_isProcess('U') )  return ;
		fn_trs();
	}	

	function fn_delete() {
	
		if (! fn_check_delete_discls(dts_BZ_CHECK, vBzProcsNo) )  return;

		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_trs();
	}
	

	function fn_trs() {
		
		if(trsIdx=='1'){
			vScrenTpCD = SCREN_PROCS_TP_CD_02;
		}else if(trsIdx=='2'){
			vScrenTpCD = SCREN_PROCS_TP_CD_03;
		}else if(trsIdx=='3'){
			vScrenTpCD = SCREN_PROCS_TP_CD_04;
		}

		// 매매거래정지종목은 매번 업무처리 번호를 세팅함
		// 종목별 변경이 있을수 있기 때문
		for (var i = 1 ; i <= dts_Isu.CountRow  ; i++) { dts_Isu.NameString(i, "BZ_PROCS_NO") = vBzProcsNo ;};
			
		// 법인별기준으로 처리함
		// 1 : 종목별 , 2 : 법인별
		dts_Mst.NameString(dts_Mst.RowPosition, "MKTACT_APPL_OBJ_TP_CD") =  "2" ;
		
//alert(dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "CODE") + "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "NAME")+ "\n" + dts_Rsn.NameString(cmb_Rsn_Cd.index + 1, "REGL")) ;
		
		trs_Save.Action 	     =fn_encodeNSession( "/Delisting.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+vScrenTpCD+"&method=saveDelList" ) ;
		trs_Save.KeyName     = "toinb_dataid4";
		trs_Save.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_Isu)";
		trs_Save.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ vBzProcsNo +
								",COUNT=2" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_200 + 
								",DIV_IDX[0]=" + DIV_IDX_DELLIST_MST+
								",DIV_IDX[1]=" + DIV_IDX_DELLIST_DTL ;
								
		trs_Save.Post();
	}
	
	function fn_CheckBiz() {
		if (getObjectValue(txb_ISUR_CD) == "") {
			alert("[회사]를 선택하세요.");return;
		}
		if (vBzProcsNo == "") {
			alert("[대상]를 선택하세요.");return;
		}
		return true;
	}


	function fn_dscl() {
		if ( ! fn_CheckBiz() ) {
			return;
		}

		if ( dts_Mst.IsUpdated || dts_Isu.IsUpdated ) {
			alert(getMessageParam("MSG-0022", ""));
			return ;
		}

		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		/*
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2,param_dts3) {
			if (vSPOT_ISU_TRD_MKT_TP_CD == "1") { 
				arr[0] = "68051A";
			} else if (vSPOT_ISU_TRD_MKT_TP_CD == "2") {
				if ( fr_SecuGrpId == SECUGRP_ID_MF ) {
					arr[0] = "70794";
				} else {
					arr[0] = "70769";
				}
			}
		*/
		
		/* 2009.06.08 영문공시관련 추가 */
		if (vSPOT_ISU_TRD_MKT_TP_CD == "1") {	//유가
			fn_GetPar = function(arr, param_dts_isu, param_dts_mst, param_dts2, param_dts3, param_dts4, param_dts_isu_eng, param_dts_mst_eng, param_dts_dtl_eng, param_dts_rel_eng, param_dts_dtl_all_eng) {			
				arr[0] = "68051A";
				arr[1] = vBzProcsNo ;
				arr[2] = getObjectValue(txb_ISUR_CD) ;
				arr[3] = vSPOT_ISU_TRD_MKT_TP_CD ;
			
				CopyDataSet( dts_Isu , param_dts_isu) ;
				CopyDataSet( dts_Mst , param_dts_mst) ;
				CopyDataSet( dts_Isu_Eng, param_dts_isu_eng);
				CopyDataSet( dts_Mst_Eng, param_dts_mst_eng);	
				return arr.length;
			}
		}else if (vSPOT_ISU_TRD_MKT_TP_CD == "2" || vSPOT_ISU_TRD_MKT_TP_CD == "6") {	//코스닥,코넥스
			fn_GetPar = function(arr, param_dts_isu, param_dts_mst, param_dts2, param_dts3, param_dts4, param_dts_isu_eng, param_dts_mst_eng, param_dts_dtl_eng, param_dts_rel_eng, param_dts_dtl_all_eng) {			
				if ( fr_SecuGrpId == SECUGRP_ID_MF ) {
					 // 액면가가 무액면인지, '0'인지를 발행기관 테이블에서 판단 
					 //fn_getParval();
					 if(dts_Isu.NameString(1,"PARVAL") !=  0 ){
						arr[0] = "70794";
					}
					else{ //무액면
						arr[0] = "70794_P";
					}
					//alert("서식코드-->70794");
				} else {
					if(vSPOT_ISU_TRD_MKT_TP_CD == "2"){
						arr[0] = "70769";
					}else{
						arr[0] = "32007";
					}
					//alert("서식코드-->70769");
				}					
				arr[1] = vBzProcsNo ;
				arr[2] = getObjectValue(txb_ISUR_CD) ;
				arr[3] = vSPOT_ISU_TRD_MKT_TP_CD ;				
				CopyDataSet( dts_Isu , param_dts_isu) ;
				
				if(vSPOT_ISU_TRD_MKT_TP_CD == "6") {
					if(getObjectValue(cmb_SPECL_LIST_TP_CD) !="") {
						setObjectValue(txb_MKTPARTC_KOR_NM,getObjectText(cmb_SPECL_LIST_TP_CD));
					}
				}
				
				CopyDataSet( dts_Mst , param_dts_mst) ;
				CopyDataSet( dts_Isu_Eng, param_dts_isu_eng);
				CopyDataSet( dts_Mst_Eng, param_dts_mst_eng);				
				return arr.length;
			}
		}
		/* 2009.06.08 영문공시관련 추가 */
		
		fn_SetPar = function(arr) { }
	
		var wth = 750 + 5;
		var hgt = 785 + 30;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;

		fn_list_sync();
	}
	
	function fn_getParval(){
		var url = "/listingCommon.do";
		url += "?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		url += "&method=listGeneral" +
		 "&outputMessageId=DELISTING_ISU_INOUT" +
		 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
		 "&queryId=lds.stf.lstproc.delist.parval.isuinst.select"+
		 "&{P}param01=" + getObjectValue(txb_ISUR_CD) +
		 "&{P}param02=" + vSPOT_ISU_TRD_MKT_TP_CD ;

		dts_getParval.DataID = encodeURI(url);
		dts_getParval.reset();
	}

	function fn_drft() {
		if ( ! fn_CheckBiz() ) {
			return;
		}
		
		var OldGet = fn_GetPar;
		
		fn_GetPar = function(arr) {
			arr[0] = vBzProcsNo ;
			return arr.length;
		}
		
		fn_PopFindDraft();
		fn_GetPar = OldGet;
	}

	//function fn_makt() { }

	function fn_chkIsu(row) {
		
		var chkIsu = false;

		if ( dts_List.NameValue(row, "DISCLS_YN") == 'Y' )  {

			for (var i = 1 ; i <= dts_Isu.CountRow  ; i++) { 
				if( dts_Isu.NameValue(i, "LIST_SHRS" ) != dts_Secu.NameValue(i, "LIST_SHRS") ) {
					chkIsu = true;
				}
			}
		}

		if( chkIsu ) {
			var res = window.confirm("상장주식수가 변경되었습니다. \n[수정] 처리를 하시겠습니까?");
			if (res) {
				LastJob = '수정' ;
				fn_new_read_sync();
				fn_update2();
			}	
		}		
	}

]]></script>


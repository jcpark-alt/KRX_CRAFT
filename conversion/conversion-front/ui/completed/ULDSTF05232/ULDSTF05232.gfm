			buttonSet.setUpdateStatus();
		} else {
			//alert('[DISCLS_YN]'+dts_Mst.NameValue(1, "DISCLS_YN"));
			setButtonSetWithDate2(dts_Mst.NameValue(1, "DISCLS_YN"));
		}
	}
]]></event>


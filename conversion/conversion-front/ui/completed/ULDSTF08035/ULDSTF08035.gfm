<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="1200" height="750" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts">
			<property useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_EtnInst">
			<property syncload="True"></property>
		</mxdataset>
	</model>
	<components>
		<panel id="pan_Cnd" class="TopCondition_01" left="5" top="5" width="1175" height="40">
			<extproperty background-color="#d9e9fc"></extproperty>
			<mxradio id="rdo_ISUR_CD_1" class="TopCondition_Blue" left="5" top="10" width="60" height="20">
				<property automargin="False" codevalue="2" cols="1" format="1^종목,2^"></property>
				<extproperty font-family="돋움" font-size="12" border-style="solid" border-width="0" border-color="#1c5280"></extproperty>
			</mxradio>
			<mxradio id="rdo_ISUR_CD_2" class="TopCondition_Blue" left="335" top="10" width="80" height="20">
				<property automargin="False" cols="1" format="1^발행회사,2^"></property>
				<extproperty font-family="돋움" font-size="12" border-style="solid" border-width="0" border-color="#1c5280"></extproperty>
			</mxradio>
			<mxcombo id="cmb_ISUR_CD" class="TopCondition_01" left="430" top="10" width="180" height="20">
				<property bindcolumn="VALUE" cbdatacolumns="VALUE,TEXT" index="0" listcount="10" listexprformat="TEXT^0^140" searchcolumn="TEXT"></property>
				<extproperty font-size="12" background-color="#FFFFFF"></extproperty>
				<ref combodataid="dts_EtnInst"></ref>
			</mxcombo>
			<textbox id="txb_ISU_CD" class="TopCondition_01" left="70" top="10" width="77" height="20" readonly="readonly" maxlength="1000">
				<extproperty font-size="12" color="#15549c" background-color="#b9d4f7" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</textbox>
			<textbox id="txb_ISU_NM" class="TopCondition_01" left="150" top="10" width="135" height="20" readonly="readonly" maxlength="1000">
				<extproperty font-size="12" color="#15549c" background-color="#b9d4f7" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</textbox>
			<image id="btn_iSU_CD" left="290" top="10" width="20" height="19" src="../img/btn_search.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="img_Search" left="1120" top="10" width="50" height="22" src="../img/btn_select.gif"></image>
			<image id="image_1" left="1110" top="10" width="2" height="22" src="../img/img_line2.gif"></image>
		</panel>
		<mxgrid id="grd_List" class="Grid_01" left="5" top="50" width="1173" height="656">
			<property borderstyle="0" colsizing="True" fillarea="True" gtitleheight="0" headborder="4" indicatorbkcolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="40" xtitleheight="0"></property>
			<extproperty font-family="돋움체" font-weight="normal" font-size="12" border-style="solid" border-width="1" border-color="#c0c0c0"></extproperty>
			<format>
				<fcolumn id="NO" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="번호" align="center" color="#343434" value="{CurRow},{ToString}" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></fcolumn>
				<fcolumn id="DSC_YN" width="40" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="공시;여부" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></fcolumn>
				<column name="종목명" width="280" id="ISU_NM" align="left"></column>
				<column name="발행회사" width="120" id="COM_NM"></column>
				<column id="ADMISUNOTI_DD" mask="XXXX-XX-XX" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="관리종목;지정예고일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
				<column id="ADMISU_DESIGN_SCHDL_DD" width="100" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="관리종목지정;예정일" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" mask="XXXX-XX-XX"></column>
				<column id="ADMISU_RSN_NM" width="400" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="지정예고 사유" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
				<column id="ADMISU_DESIGN_GRND_REGUL_NM" width="250" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="근거" align="left" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" show="False"></column>
				<column id="LST_EMP_NM" width="80" headalign="center" headbgcolor="#598fd5" headcolor="#ffffff" name="최종처리자" align="center" color="#343434" sumbgcolor="#fefaef" sumcolor="#343434" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
			</format>
			<ref dataid="dts"></ref>
		</mxgrid>
		<textbox id="txb_TotCnt" left="10" top="715" width="100" height="20" maxlength="1000">
			<extproperty font-size="12" color="#343434" border-style="none" border-width="0"></extproperty>
		</textbox>
		<image id="img_Close" left="1045" top="715" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_Excel" left="1100" top="715" width="78" height="22" src="../img/btn_excelsave.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="img_Regist" left="990" top="715" width="50" height="22" src="../img/btn_new.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/common.js");
	#include("../js/stf.js");				// 호출메뉴ID를 식별하기 위한 함수사용
	#include("../js/session.js");  		// 세션정보를 얻기위한 함수사용
	#include("../js/list_common_etn.js"); 	// 상장관련공통함수
	#include("../js/libRoundPanel.js");
	#include("../js/buttonSet.js");		// jackal_11.05.12

	var vScrenID = "ULDSTF08035.gfm";
	var fr_SecuGrpId = SECUGRP_ID_EN; // mid 부모프레임으로 부터 받은 menu id로 증권그룹id를 반환하는 함수 호출, 법인선택팝업에서 fr_SecuGrpId 변수를 참조. 
	var fr_MktId     = fn_getMktId();			 	  // 시장구분코드(유가, 코스닥) 전체), 기준은 로그인 사용자의 부서 소속을 기준으로 한다.
	var fn_GetPar, fn_SetPar;
	var vIsurCd = "";
	var vLIST_STAT_CD = "Y";		// jackal_11.05.12 상장종목 여부 체크 추가

	function fn_search() {
		var url = "/etn/EtnMktAct.do?method=searchEtnAdministrativeIssueNoti"
		url += "&SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01;
		
		if(rdo_ISUR_CD_1.CodeValue == "1") {
			url += "&DIV_IDX="+DIV_ETN_IDX_ADMISUNOTI_LIST_ISU + "&TRS_IDX="+TRS_IDX_SELECT + "&ISU_CD=" + txb_ISU_CD.value ;
		} else if(rdo_ISUR_CD_2.CodeValue == "1") {
			if( cmb_ISUR_CD.index == 0 ) {
				url += "&DIV_IDX="+DIV_ETN_IDX_ADMISUNOTI_LIST_ALL + "&TRS_IDX="+TRS_IDX_SELECT + "&GUBUN_CD=ETN" ;
			} else{
				url += "&DIV_IDX="+DIV_ETN_IDX_ADMISUNOTI_LIST_CORP + "&TRS_IDX="+TRS_IDX_SELECT + "&ISUR_CD=" + cmb_ISUR_CD.BindColVal + "&GUBUN_CD=ETN" ;
			}
		}
		//alert(url);
		dts.DataID = encodeURI(url); 
		dts.reset();
		ShowWin(grd_List);
	}
	
	// dialog 호출용 함수
	// 예비심사청구제출기관 호출관련
	function fn_GetParIsur(arrPar) {  			 // 넘길 인수를 지정하는 펑션
		arrPar[0] = "";   // 코드값을 포함할 컨트롤
		arrPar[1] = getObjectValue(txb_ISU_NM);	  // 명칭값을 포함할 컨트롤
		arrPar[2] = fr_SecuGrpId;	  					  // 명칭값을 포함할 컨트롤

		return arrPar.length;
	} 

	function fn_SetParIsur(arrPar) {
		var dbClickYn =  arrPar[0].DBCLICKYN;
		if (dbClickYn == "Y" ) {
			fn_changeRadioBtn(1);
			
			txb_ISU_CD.value = arrPar[0].ISU_CD;
			//txb_ISU_NM.value = arrPar[0].ISU_KOR_NM;
			txb_ISU_NM.value = arrPar[0].ISU_KOR_ABBRV;
			vIsurCd = arrPar[0].ISUR_CD;
		}	
		fn_search();
		//jackal_11.05.12
		// 삭제 종목인 경우 모든 버튼 discable
		vLIST_STAT_CD = arrPar[0].LIST_STAT_CD;
		if ( vLIST_STAT_CD == "D" )
		{
			img_Regist.disabled = true;
			img_Regist.src = "../img/btn_new_d.gif";
		}
		else
		{
			img_Regist.disabled = false;
			img_Regist.src = "../img/btn_new.gif";
		}
	}
	
	function fn_GetParUpdate(arrPar) {  // 넘길 인수를 지정하는 펑션
		if(rdo_ISUR_CD_1.CodeValue == "1") {
			arrPar[0] = vIsurCd; // 발행기관코드값
			arrPar[1] = txb_ISU_NM.value; // 종목코드명
			arrPar[6] = txb_ISU_CD.value; // 종목코드값
			arrPar[7] = "1"; 		// 선택 구분(1:종목, 2:발행회사, 3:전체)
		} else if(rdo_ISUR_CD_2.CodeValue == "1") {
			if( cmb_ISUR_CD.index == 0 ) {
				arrPar[0] = vIsurCd; // 발행기관코드값
				arrPar[1] = dts.NameString(dts.RowPosition, "COM_NM"); // 발행기관명
				arrPar[6] = ""; // 종목코드값
				arrPar[7] = "3"; 		// 선택 구분(1:종목, 2:발행회사, 3:전체)
			} else{
				arrPar[0] = vIsurCd; // 발행기관코드값
				arrPar[1] = dts.NameString(dts.RowPosition, "COM_NM"); // 발행기관명
				//arrPar[1] = cmb_ISUR_CD.Text; // 발행기관명
				arrPar[6] = "" ; // 종목코드값
				arrPar[7] = "2"; 		// 선택 구분(1:종목, 2:발행회사, 3:전체)
			}
		}
		arrPar[2] = fr_SecuGrpId;	  // 증권그룹구분	
		arrPar[3] = fr_MktId;		  // 시장구분
		arrPar[4] = dts.NameString(dts.RowPosition, "bz_procs_no"); // 업무처리번호
		arrPar[5] = dts.NameString(dts.RowPosition, "ADMISU_DESIGN_BZ_TP_CD")  ; // 거래정지지정및해제구분코드
		
		return arrPar.length;
	} 
	
	function fn_GetParNew(arrPar) { // 신규생성시 지정하는 평션
		if(rdo_ISUR_CD_1.CodeValue == "1") {
			arrPar[0] = vIsurCd; // 발행기관코드값
			arrPar[1] = txb_ISU_NM.value; // 발행기관명
			arrPar[6] = txb_ISU_CD.value; // 종목코드값
			arrPar[7] = "1"; 		// 선택 구분(1:종목, 2:발행회사, 3:전체)
		} else if(rdo_ISUR_CD_2.CodeValue == "1") {
			if( cmb_ISUR_CD.index == 0 ) {
				arrPar[0] = ""; // 발행기관코드값
				arrPar[1] = ""; // 발행기관명
				arrPar[6] = ""; // 종목코드값
				arrPar[7] = "3"; 		// 선택 구분(1:종목, 2:발행회사, 3:전체)
			} else{
				arrPar[0] = cmb_ISUR_CD.BindColVal; // 발행기관코드값
				arrPar[1] = cmb_ISUR_CD.Text; // 발행기관명
				arrPar[6] = ""; // 종목코드값
				arrPar[7] = "2"; 		// 선택 구분(1:종목, 2:발행회사, 3:전체)
			}
		}		
		arrPar[2] = fr_SecuGrpId;	  // 증권그룹구분	
		arrPar[3] = fr_MktId;		  // 시장구분
		arrPar[4] = "";				  // 신규작성시 업무처리번호는 없다.
		arrPar[5] = ""; // 지정및해제구분코드
	}
	
	function  fn_new_create_frame() {		
		frame.CreateDialogFrame("DLG_0","../etn/ULDSTF08036_new.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 관리종목지정 우려 예고", 200, 50, 750 , 450 , "window");
	}

	function  fn_newpre_create_frame() {
		frame.CreateDialogFrame("DLG_0","../etn/ULDSTF08036.gfm",  fn_getSecuGrpNm(fr_SecuGrpId) +  " 관리종목지정 우려 예고", 200, 50, 720 , 450 , "window");
	}
	
	function fn_get_isurcode() {
 	//etn발행사
		dts_EtnInst.DataID = "/etn/EtnCodeAct.do?method=listIsurCd&For=R";
		dts_EtnInst.Reset();
	}
	
	function fn_changeRadioBtn(idx) {
		if(idx == "1"){
			cmb_ISUR_CD.index =0;
			
			rdo_ISUR_CD_1.CodeValue ="1";
			rdo_ISUR_CD_2.CodeValue ="2";
		} else if(idx == "2"){
			txb_ISU_CD.value = "";
			txb_ISU_NM.value = "";
			
			rdo_ISUR_CD_1.CodeValue ="2";
			rdo_ISUR_CD_2.CodeValue ="1";
		}
	}
]]></script>
	
		<events><event for="img_Search" eventname="onclick"><![CDATA[
		if(rdo_ISUR_CD_1.CodeValue == "1"){
			if (txb_ISU_CD.value == "") {
				alert(getMessageParam("MSG-0015", ""));
				return true;
			} 
		}
		
		fn_search();
]]></event>
		<event for="dts" eventname="OnLoadError()"><![CDATA[
	alert_error(dts);
]]></event>
		<event for="dts" eventname="OnLoadCompleted(rowcount)"><![CDATA[
	//FillGridHeaderTotalCnt(rowcount, panel_page);
	txb_TotCnt.value = "총건수 : " + rowcount ;
	dts.RowPosition = rowcount;
	CloseWin(rowcount, grd_List); 
]]></event>
		<event for="img_Excel" eventname="onclick"><![CDATA[
	if (dts.CountRow > 0) {
		doLogSave(vScrenID, SCREN_PROCS_TP_CD_07);
		grd_List.GridToExcel(fn_getSecuGrpNm(fr_SecuGrpId) +  "괸리종목지정 우려 예고 내역", "", "8");
	} else {
		alert( NO_EXCEL_DATA );
	}
]]></event>
		<event for="img_Close" eventname="onclick"><![CDATA[
	frame.CloseFrame();
]]></event>
		<event for="btn_iSU_CD" eventname="onclick"><![CDATA[
	fn_GetPar = fn_GetParIsur;
	fn_SetPar = fn_SetParIsur;
	//fn_PopFindIsu(fr_SecuGrpId);
	//fn_PopFindIsuAll(fr_SecuGrpId);		// jackal_11.05.12
	fn_PopFindEtnIsuAll(fr_SecuGrpId);
]]></event>
		<event for="img_Regist" eventname="onclick"><![CDATA[
	if(rdo_ISUR_CD_1.CodeValue == "1"){
		if (txb_ISU_CD.value == "") {
			alert(getMessageParam("MSG-0015", ""));
			return true;
		}
	} 
	
	fn_GetPar = fn_GetParNew;
	fn_SetPar = undefined;
	
	if(rdo_ISUR_CD_2.CodeValue == "1") {
		fn_new_create_frame();
	} else {
		fn_newpre_create_frame();
	}
]]></event>
		<event for="grd_List" eventname="OnDblClick(row, colid)"><![CDATA[
	// jackal_11.05.12 삭제종목인 경우 팝업 금지
	if(rdo_ISUR_CD_1.CodeValue == "1"){
		if ( vLIST_STAT_CD == "D" )
		{
			return true;		
		}
	}
	vIsurCd = dts.NameString(dts.RowPosition, "ISUR_CD");
	fn_GetPar = fn_GetParUpdate; // 수정시 인수를 넘기는 function을 fn_GetPar란 변수에 할당, (팝업화면에서 참조하는 변수명이 fn_GetPar임)
	fn_SetPar = undefined;

	// 거래정지지정및해제구분코드 값 넘겨야함
	fn_newpre_create_frame() ;
]]></event>
		<event for="gform" eventname="onload"><![CDATA[
	PanelToGroupBox(pan_Cnd);
	
	rdo_ISUR_CD_1.CodeValue ="1";
	fn_get_isurcode() ;
]]></event>
		<event for="rdo_ISUR_CD_1" eventname="OnClick()"><![CDATA[
	//rdo_ISUR_CD_2.CodeValue ="2";
	fn_changeRadioBtn(1);
]]></event>
		<event for="rdo_ISUR_CD_2" eventname="OnClick()"><![CDATA[
	//rdo_ISUR_CD_1.CodeValue ="2";
	fn_changeRadioBtn(2);
	fn_search();
]]></event>
		<event for="cmb_ISUR_CD" eventname="OnSelChange()"><![CDATA[
	fn_changeRadioBtn(2);
	//if( rdo_ISUR_CD_2.CodeValue == "1" && cmb_ISUR_CD.index != 0 ) {
		fn_search();
	//}
]]></event></events>
</gform>

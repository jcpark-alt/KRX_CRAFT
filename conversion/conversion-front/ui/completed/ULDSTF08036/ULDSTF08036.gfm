<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="710" height="410" arfsrc="../js/arf.vbs" componentset="unicode">
	<style>
		@import url('../css/global.gss');
	</style>
	<model>
		<mxdataset id="dts_Mst">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property syncload="False" usechangeinfo="False" useupdate="True"></property>
		</mxdataset>
		<mxlogicaltr id="trs"></mxlogicaltr>
		<mxdataset id="dts_BzProcsNo">
			<property syncload="True"></property>
		</mxdataset>
		<mxbinder id="bnd_Mst">
			<property activebind="true"></property>
			<bindinfo>
				<column col="ADMISUNOTI_DD" ctrl="edt_AdmIsuNotiDd" param="text" readonly="False"></column>
				<column col="ADMISU_DESIGN_SCHDL_DD" ctrl="edt_AdmIsuNotiEndDd" param="text" readonly="False"></column>
				<column col="REMK" ctrl="txa_Remk" param="text" readonly="False"></column>
				<column col="ADMISU_DESIGN_SCHDL_CONTN" ctrl="txb_AdmIsuNotiEndContn" param="value" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Mst"></ref>
		</mxbinder>
	</model>
	<components>
		<panel id="panel_3" left="10" top="10" width="690" height="360" class="TopCondition_01">
			<extproperty background-color="#d9e9fc"></extproperty>
			<label id="label_10" class="TopCondition_01" left="5" top="10" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_2" class="TopCondition_01" left="15" top="10" width="135" height="20" text="1.관리종목지정예고 종목">
				<extproperty font-size="11"></extproperty>
			</label>
			<label id="label_8" class="TopCondition_01" left="5" top="150" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_1" class="TopCondition_01" left="15" top="150" width="125" height="20" text="2. 관리종목지정예고일">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_9" class="TopCondition_01" left="5" top="175" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_14" class="TopCondition_01" left="15" top="175" width="125" height="20" text="3. 관리종목지정예정일">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<label id="label_5" class="TopCondition_01" left="5" top="200" width="10" height="20" text="*">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="black"></extproperty>
			</label>
			<label id="label_11" class="TopCondition_01" left="15" top="200" width="125" height="20" text="4. 예고사유">
				<extproperty font-size="12" color="#000000" border-color="#0000FF"></extproperty>
			</label>
			<image id="img_SetIsuCd" left="70" top="35" width="75" height="19" src="../img/btn_isu_select.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_AdmIsuNotiDd" class="panel_maskedit_write_01" left="150" top="150" width="70" height="18">
				<property alignment="1" border="False" datemodify="True" numeric="False" valign="1"></property>
				<extproperty font-size="12" color="#343434" background-color="#FFFFFF" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<image id="img_SetAdmIsuNotiDd" left="225" top="150" width="21" height="20" src="../img/icn_calendar.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<mxmaskedit id="edt_AdmIsuNotiEndDd" class="panel_maskedit_write_01" left="150" top="175" width="70" height="18">
				<property alignment="1" border="False" datemodify="True" numeric="False" valign="1"></property>
				<extproperty font-size="12" color="#343434" background-color="#FFFFFF" border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
			</mxmaskedit>
			<image id="image_1" left="225" top="175" width="21" height="20" src="../img/icn_calendar.gif">
				<extproperty cursor="pointer"></extproperty>
			</image>
			<label id="label_16" class="TopCondition_01" left="250" top="175" width="30" height="20" text="주석">
				<extproperty font-size="12" color="#000000" text-align="center" border-color="#0000FF"></extproperty>
			</label>
			<mxgrid id="MxGrid_2" class="Grid_01" left="150" top="10" width="530" height="132">
				<property borderstyle="0" editable="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="120" show="False" name="BZ_PROCS_NO" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_CD" width="100" name="종목코드" align="center" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column headbgcolor="#598fd5" headcolor="#FFFFFF" name="발행회사" width="100" id="ISUR_NM" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="ISU_NM" width="240" name="종목명" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}"></column>
					<column id="LIST_DD" width="80" name="상장일"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Isu"></ref>
			</mxgrid>
			<mxgrid id="MxGrid_1" class="Grid_01" left="150" top="200" width="443" height="83">
				<property borderstyle="0" editable="True" focusrect="False" gtitleheight="0" headborder="4" headlinecolor="#C0C0C0" indwidth="0" linecolor="#C0C0C0" rowheight="18" titleheight="18" xtitleheight="0"></property>
				<extproperty font-size="12" border-style="solid" border-width="1" border-color="#C0C0C0"></extproperty>
				<format>
					<column id="BZ_PROCS_NO" width="97" show="False" name="업무처리번호" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_CD" width="70" name="사유코드" align="center" edit="none" listalign="left" headbgcolor="#598fd5" headcolor="#FFFFFF"></column>
					<column id="ADMISU_DESIGN_RSN_NM" width="356" name="사유내용" edit="none" headbgcolor="#598fd5" headcolor="#FFFFFF" bgcolor="{decode(currow-tointeger(currow/2)*2,0,\'#f2f5f9\',1,\'#ffffff\')}" color="#343434"></column>
				</format>
				<selectioncolor>
					<focuseditcol textcolor="#c05001" bgcolor="#f9ede5"></focuseditcol>
					<focuseditrow textcolor="#c05001" bgcolor="#f9ede5"></focuseditrow>
					<focuscurcol textcolor="#c05001" bgcolor="#f9ede5"></focuscurcol>
					<focuscurrow textcolor="#c05001" bgcolor="#f9ede5"></focuscurrow>
					<focusselrow textcolor="#c05001" bgcolor="#f9ede5"></focusselrow>
					<editcol textcolor="#c05001" bgcolor="#f9ede5"></editcol>
					<curcol textcolor="#c05001" bgcolor="#f9ede5"></curcol>
					<currow textcolor="#c05001" bgcolor="#f9ede5"></currow>
					<selrow textcolor="#c05001" bgcolor="#f9ede5"></selrow>
				</selectioncolor>
				<ref dataid="dts_Rsn"></ref>
			</mxgrid>
			<mxtextarea id="txa_Remk" class="TextArea_01" left="150" top="290" width="443" height="60">
				<extproperty font-size="12" background-color="#FFFFFF" border-style="solid" border-width="1"></extproperty>
			</mxtextarea>
			<textbox id="txb_AdmIsuNotiEndContn" class="TopCondition_01_write" left="290" top="175" width="310" height="20" maxlength="2000">
				<extproperty background-color="#FFFFFF"></extproperty>
			</textbox>
			<label id="label_7" class="TopCondition_01" left="15" top="290" width="125" height="20" text="5. 기타">
				<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<image id="btn_rsn_del" left="605" top="230" width="76" height="22" src="../img/btn_rsn_del.gif">
				<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
			</image>
			<image id="btn_rsn_add" left="605" top="200" width="76" height="22" src="../img/btn_rsn_add.gif">
				<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
			</image>
		</panel>
		<image id="btn_Save" left="390" top="380" width="50" height="22" src="../img/btn_save.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Update" left="445" top="380" width="50" height="22" src="../img/btn_modify.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Delete" left="500" top="380" width="50" height="22" src="../img/btn_delete.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Dscl" left="555" top="380" width="89" height="22" src="../img/btn_make_info.gif">
			<extproperty border-style="none" border-width="1" border-color="#C0C0C0" cursor="pointer"></extproperty>
		</image>
		<image id="btn_Close" left="650" top="380" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
	</components>
<script><![CDATA[
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");  	// 세션정보를 얻기위한 함수사용
	#include("../js/list_common_etn.js");
	#include("../js/buttonSet.js");
	#include("../js/utils.js");
	#include("../js/libRoundPanel.js");

	var vScrenID = "ULDSTF08036.gfm";
	var Isu_cd="", Isur_cd = "", Isur_nm = "", Secugrp_id = "", Mkt_id = "", fr_bz_procs_no = "" , haltTpCd = "" , gubun = "" , select_gubun = "" , tpCd = "" ;

	var trsIdx ;  // insert, update 구분
	
	var fn_GetPar , fn_SetPar ;
	 
	function fn_search() {
		if (fr_bz_procs_no != "") {
			var url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnAdministrativeIssueNoti" + 
						"&DIV_IDX="+DIV_ETN_IDX_ADMISUNOTI_MST + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			dts_Mst.DataID = encodeURI(url);
			dts_Mst.reset();	
			
			url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnAdministrativeIssueNoti" + 
				   "&DIV_IDX="+DIV_ETN_IDX_ADMISUNOTI_ISU_ITM + "&ISUR_CD=" + Isur_cd + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
					 
				dts_Isu.DataID = encodeURI(url);
				dts_Isu.reset();

			url = "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=searchEtnAdministrativeIssueNoti" + 
			      "&DIV_IDX="+DIV_ETN_IDX_ADMISUNOTI_RSN + "&BZ_PROCS_NO=" + fr_bz_procs_no ;
			 
			dts_Rsn.DataID = encodeURI(url);
			dts_Rsn.reset();
		}
	}
	
	function fn_new_onload() {
		/* useupdate를 false로 지정함. */
		dts_Mst.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ETN_ADMISUNOTI_LIST_MST_INOUT";
		dts_Mst.reset();
		
		/* useupdate를 false로 지정함. */
		dts_Rsn.DataID =  "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=ADMISU_RSN_INOUT";
		dts_Rsn.reset();
		
		if (select_gubun == "1") {
			dts_Isu.DataID = "/etn/EtnCodeAct.do?method=searchEtnCode&GUBUN=" + select_gubun + "&ISUR_CD=" + gubun ;
			dts_Isu.reset();
		} else{
			/* useupdate를 false로 지정함. */
			dts_Isu.DataID = "/gauceSystemierAdaptor.do?method=getGauceDataHeader&messageId=CODE_ETN_OUT";
			dts_Isu.reset();
		}
	}

	function fn_GetParRsnCd(arrPar) {  			 // 넘길 인수를 지정하는 펑션
		arrPar[0] =  "1" ;
		arrPar[1] = "07" ;
		arrPar[5] = "N"; //기업인수목적 회사 

		return arrPar.length;
	} 
	
	function fn_SetParRsnCd(arrPar) {
		//선택된 사유코드 중복체크
		if( !fn_isNewValueForDataSet( dts_Rsn ,"ADMISU_DESIGN_RSN_CD" , arrPar[0]) ) return ;
		
		dts_Rsn.AddRow();
		dts_Rsn.NameString( dts_Rsn.RowPosition  , "ADMISU_DESIGN_RSN_CD"  )  =  arrPar[0];
		dts_Rsn.NameString( dts_Rsn.RowPosition  , "ADMISU_DESIGN_RSN_NM"  )  =  arrPar[1];
		
		//fn_setRemk();
	}
	
	function fn_GetParIsu(arrPar , param_dts) {
		arrPar[0] = Isur_cd;
		arrPar[1] = select_gubun ;
		
		CopyDataSet( dts_Isu , param_dts) ;
	}
	
	function fn_SetParIsu(param_dts) {
	//alert(dts_Isu.text);
		CopyDataSet( param_dts , dts_Isu) ;
		if(Isur_cd == ""){
			Isur_cd = dts_Isu.NameString(1, "ISUR_CD");
		}
	//alert(dts_Isu.text);
	}
	

	function fn_CheckForm() {
		if( dts_Isu.CountRow == 0 ) {
			alert("[관리종목지정예고 종목]을 선택하세요."); img_SetIsuCd.focus(); return false;
		}
		
		if( ! checkDdTm ( "DD" , edt_AdmIsuNotiDd   , "관리종목지정예고" , true)  ) return false ; 
		if( ! checkDdTm ( "DD" , edt_AdmIsuNotiEndDd   , "관리종목지정예정" , false)  ) return false ; 
		
		if (edt_AdmIsuNotiEndDd.text == "" && txb_AdmIsuNotiEndContn.value == "" ) {
			alert("[관리종목지정예정] 또는 [주석]을 입력하세요."); txb_AdmIsuNotiEndContn.focus(); return false;
		}
		if( ! checkMaxLength( txb_AdmIsuNotiEndContn , 400 , "주석" ) ) return false ;

		if (edt_AdmIsuNotiEndDd.text != ""  && ( edt_AdmIsuNotiDd.Text >= edt_AdmIsuNotiEndDd.Text ) ) {
			alert("[관리종목지정예정일]은  [관리종목지정예고일]이후로 입력하세요."); edt_AdmIsuNotiEndDd.focus(); return false;
		}
		
		if( dts_Rsn.CountRow == 0 ) {
			alert("[지정사유]를 선택하세요."); btn_rsn_add.focus(); return false;
		}

		if( ! checkMaxLength( txa_Remk , 4000 , "기타" ) ) return false ;

		return true;
	}
	
	function fn_save_trs() {

		//매매거래정지 사유는 매번 업무처리 번호를 세팅함
		//사유별 추가,삭제가 있을수 있기때문
		for (var i = 1 ; i <= dts_Rsn.CountRow ; i++) { 
			dts_Rsn.NameString(i, "CHG_BFAF_TP_CD") = "2"  ; //변경전후구분코드 1:변경전 , 2:변경후  
			dts_Rsn.NameString(i, "BZ_PROCS_NO")     = fr_bz_procs_no ;
			
			dts_Rsn.NameString(i, "ADMISU_DESNRELS_TP_CD")      = "3" ; // 관리종목지정및해제구분코드 1:관리종목 지정 , 2:관리종목 해제 ,3:관리종목우려예고
			dts_Rsn.NameString(i, "ADMISU_ADD_DESIGN_RSN_YN") = "N" ; // 관리종목추가지정사유여부
		};

		dts_Mst.NameString(dts_Mst.RowPosition, "BZ_PROCS_NO")  = fr_bz_procs_no;
		dts_Mst.NameString(dts_Mst.RowPosition, "ISUR_CD")           = Isur_cd;
		dts_Mst.NameString(dts_Mst.RowPosition, "ISU_CD")             = Isu_cd;
		
		var vScrenProcsTpCD = SCREN_PROCS_TP_CD_03;
		if ( trsIdx == TRS_IDX_INSERT )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_02;
		else if ( trsIdx == TRS_IDX_DELETE )
			vScrenProcsTpCD = SCREN_PROCS_TP_CD_04;
			
		trs.Action 	     = fn_encodeNSession( "/etn/EtnMktAct.do?SCREN_ID="+vScrenID+"&SCREN_PROCES_TP_CD="+vScrenProcsTpCD+"&method=saveEtnAdministrativeIssueNoti" ) ;
		trs.KeyName     = "toinb_dataid4";
		trs.KeyValue     = "JSP(I: dtsParm1= dts_Mst , I:dtsParm2= dts_Rsn)";
		trs.Parameters  = "TRS_IDX=" + trsIdx + 
								",BZ_PROCS_NO="+ fr_bz_procs_no +
								",COUNT=2" +
								",LIST_BZ_TP_CD=" + LIST_BZ_TP_CD_714 + 
								",DIV_IDX[0]=" + DIV_ETN_IDX_ADMISUNOTI_MST+
								",DIV_IDX[1]=" + DIV_ETN_IDX_ADMISUNOTI_RSN;
								
		trs.Post();
	}
	
	function fn_save() {
		
		if (fn_CheckForm()) {
			if (! fn_isProcess('I') )  return ;
			fr_bz_procs_no = fn_getNewBzProcNo( dts_BzProcsNo );

			if (fr_bz_procs_no.length != 14) {
				alert(getMessageParam("MSG-0010", ""));
			} else {
				trsIdx = TRS_IDX_INSERT ;

				fn_save_trs();
			}
		}
	}
	
   function fn_update() {
		if (fn_CheckForm()) {
			trsIdx = TRS_IDX_UPDATE ;
			
			if (! fn_isProcess('U') )  return ;
			fn_save_trs();
		}	
	}

	function fn_delete() {
		if (! fn_isProcess('D') )  return ;
		buttonSet.setDeleteStatus(); // buttonSet에 CRUD상태를 저장하여 이용하는 사례, TR의 응답event에서 사용.

		trsIdx = TRS_IDX_DELETE ;
		fn_save_trs();
	}
	
	function fn_dscl() {
		
		var OldGet = fn_GetPar;
		var OldSet = fn_SetPar;
		
		fn_GetPar = function(arr, param_dts_isu, param_dts_mst,param_dts2) {
			arr[0] = "68347";			
			arr[1] = fr_bz_procs_no;
			arr[2] = Isur_cd ;
			arr[3] = '1' ;
			//arr[4]; //ctnt
			arr[5] = dts_Isu.NameValue(dts_Isu.RowPosition, "ISU_NM"); 
			//arr[5] = fn_GetAddTitle(dts_Mst.NameValue(dts_Mst.RowPosition, "COM_NM")); //add  title
			
			CopyDataSet( dts_Isu , param_dts_isu) ;
			CopyDataSet( dts_Mst , param_dts_mst) ;
			CopyDataSet( dts_Rsn , param_dts2) ;
			
			param_dts_mst.NameString(param_dts_mst.RowPosition, "ADMISU_RSN_NM") = fn_getRsnNm();
			param_dts_mst.NameString(param_dts_mst.RowPosition, "COM_NM") = dts_Isu.NameValue(dts_Isu.RowPosition, "COM_NM"); 
			

			return arr.length;
		}
		
		fn_SetPar = function(arr) { }
	
		var wth = 730 + 15;
		var hgt = 785 + 40;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
	
		frame.CreateDialogFrame("ULDSTF92024", "/listingcommon/ULDSTF92024.gfm", "공시안내문작성", pt.x, pt.y, wth, hgt, "window");
		
		fn_GetPar = OldGet;
		fn_SetPar = OldSet;
	}
	function fn_drft() { }
	function fn_makt() { }

	function fn_parentRefresh() {
		var fr_fn_list_sync = frame.Provider("../").fn_search;
		fr_fn_list_sync();
	}

	function fn_SetIsuCdBtnShow(initTyp) {
		if (initTyp == "1" || fr_bz_procs_no != "") {
			img_SetIsuCd.src = "../img/btn_isu_select_d.gif";
			img_SetIsuCd.disabled = true;
		} else {
			img_SetIsuCd.src = "../img/btn_isu_select.gif";
			img_SetIsuCd.disabled = false;
		}
	}
	
	function fn_getRsnNm(){
		var strDate = "O월 O일";
		var strRsnNm = "";
		var strHalfYear = "6월말";
		
		if( edt_AdmIsuNotiDd.text.length == 8  ){
			strDate = getObjectValue(edt_AdmIsuNotiDd).substring(4,6) + "월 " + getObjectValue(edt_AdmIsuNotiDd).substring(6,8) + "일"
		}

		if( getObjectValue(edt_AdmIsuNotiDd).substring(4,6) > "06" ){
			strHalfYear = "12월말";
		}
		
		if(dts_Rsn.CountRow < 1) {
			strRsnNm =  "";
		}
		else{
			for (var i = 1 ; i <= dts_Rsn.CountRow ; i++) {
				var RsnNm = dts_Rsn.NameString( i, "ADMISU_DESIGN_RSN_NM"  ) ;
				
				if(strRsnNm.indexOf(RsnNm) <0 ){
					if(strRsnNm != ""){
						strRsnNm = strRsnNm + " 및 " + RsnNm;
					}
					else{
						strRsnNm =  RsnNm;
					}
				}
			}
		}
		return  strDate + " 현재 " + strRsnNm + " 사유로 인하여, " + strHalfYear;
	}
	
	function fn_setRemk(){
	/*/// 
		var strDate = "O월 O일";
		var strRsnNm = fn_getRsnNm();
		var strHalfYear = "6월말";
		
		if( edt_AdmIsuNotiDd.text.length == 8  ){
			strDate = getObjectValue(edt_AdmIsuNotiDd).substring(4,6) + "월 " + getObjectValue(edt_AdmIsuNotiDd).substring(6,8) + "일"
		}

		if( getObjectValue(edt_AdmIsuNotiDd).substring(4,6) > "06" ){
			strHalfYear = "12월말";
		}
	///*///
		//안내문의 기타 텍스트 부분
		//txa_Remk.Text = "상기 종목은 " + strDate + " 현재 " + strRsnNm + " 사유로 인하여, " + strHalfYear;
		//txa_Remk.Text += " 관리종목으로 지정될 우려가 있으니 투자에 유의하시기 바랍니다. 관리종목으로 지정된 경우에도 ETN 매매는 정상적으로 가능합니다.\r\n";
		// 2014.12.26 변경
		txa_Remk.Text = "관리종목으로 지정된 경우에도 ETN 매매는 정상적으로 가능합니다.\r\n";		
	}
	
]]></script>
	
		<events><event for="edt_AdmIsuNotiDd" eventname="OnKillFocus()"><![CDATA[

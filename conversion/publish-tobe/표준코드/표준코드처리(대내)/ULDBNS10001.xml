// 세션정보를 얻기위한 함수사용
scwin.fn_GetPar, scwin.fn_SetPar;
scwin.vBndApplId, scwin.vBndListProcsTpCd;

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {void}
 * @hidden N
 */
scwin.onpageload = function() {
    try {
        // 패널라운드처리
        $c.bns.BnsPanelToGroupBox(pnl_Top);
        // 호출파라미터설정
        scwin.setParam();
        // 목록조회
        scwin.search();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDBNS10001.onpageload" });
    }
};

/**
 * @method
 * @name onpageunload
 * @description 화면 언로드 시 정리 처리
 * @returns {void}
 * @hidden N
 */
scwin.onpageunload = function() {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name btn_Close_onclick
 * @description 「닫기」 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_Close_onclick = async function() {
    try {
        await $c.win.closePopup();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDBNS10001.btn_Close_onclick" });
    }
};

/**
 * @method
 * @name dts_List_OnLoadCompleted
 * @description dts_List 로드 완료 후처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @param {Number} rowcount 조회 건수
 * @returns {void}
 * @hidden N
 */
scwin.dts_List_OnLoadCompleted = function(rowcount) {
    try {
        txb_TotalCnt.setValue("총 " + rowcount + "건");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDBNS10001.dts_List_OnLoadCompleted" });
    }
};

/**
 * @method
 * @name btn_Excel_onclick
 * @description 「엑셀다운로드」 클릭 이벤트
 * @returns {void}
 * @hidden N
 */
scwin.btn_Excel_onclick = function() {
    try {
        $c.stf.doLogSave("ULDBNS90005.xml", SCREN_PROCS_TP_CD_07, '');
        const fileNm = $c.session.getExcelDownPath() + $c.ut.cGetToday("yyyymmddhhmmss") + "_스트립종목상세(신규).xls";
        $c.data.downloadGridViewExcel(grd_List, {fileName: "스트립종목상세(신규)", type: 8});
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDBNS10001.btn_Excel_onclick" });
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name search
 * @description 스트립종목정보를 조회한다.
 * @returns {void}
 * @hidden N
 */
scwin.search = function() {
    let param = '';
    param += "&{P}V_BND_APPL_ID=" + scwin.vBndApplId;
    param += "&{P}V_BND_LIST_PROCS_TP_CD=" + scwin.vBndListProcsTpCd;
    const dsNm = 'BNS_STRIP_INFO';
    const qryId = 'lds.stf.bnschg.select.listStripIsuInfo';
    $c.bns.fn_SearchBns("ULDBNS90005.xml", dts_List, dsNm, qryId, param);
};

/**
 * @method
 * @name setParam
 * @description 부모창에서 받은 데이터를 설정한다.
 * @returns {void}
 * @hidden N
 */
scwin.setParam = function() {
    const prt = $c.frame.path("../");
    if (prt !== undefined) {
        scwin.fn_GetPar = prt.scwin.fn_GetPar;
    }
    if (scwin.fn_GetPar !== undefined) {
        const arrPar = new Array();
        scwin.fn_GetPar(arrPar);
        scwin.vBndApplId = arrPar[0].BND_APPL_ID;
        scwin.vBndListProcsTpCd = arrPar[0].BND_LIST_PROCS_TP_CD;
    }
};
]]></script>

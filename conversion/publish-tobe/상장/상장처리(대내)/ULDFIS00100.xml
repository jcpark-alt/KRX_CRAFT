 */
scwin.popupCallback = function (arg) {
    // TO-DO : arg 값 확인 후 업무 로직 추가
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name initDs
 * @description 데이터셋 초기화.
 * @param {*} pWorkFg pWorkFg
 * @returns {void}
 * @hidden N
 */
scwin.initDs = function(pWorkFg) {
    if (pWorkFg === "1") {
        dts_ComOutLook.removeAll();
        dts_FncInfo.removeAll();
    } else if (pWorkFg === "2") {
        dts_ComInfo.removeAll();
    }
};

/**
 * @method
 * @name setDefaultVal
 * @description 기본값 세팅
 * @returns {void}
 * @hidden N
 */
scwin.setDefaultVal = function() {

};

/**
 * @method
 * @name getParKisCd
 * @description 팝업으로 값을 넘김.
 * @returns {void}
 * @hidden N
 */
scwin.getParKisCd = function() {
    const arrPar = new Array();
    arrPar[0] = txb_CoSnm.getValue(); // 기업명
    return arrPar;
};

/**
 * @method
 * @name setParKisCd
 * @description 팝업에서 넘어온 값 세팅.
 * @param {Array} arrPar 팝업 파라미터 배열(참조 채움)
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.setParKisCd = async function(arrPar) {
    txb_CoSnm.setValue(arrPar[0].CO_SNM); // 기업명
    txb_KisCd.setValue(arrPar[0].KIS_CD); // 기업코드
    txb_IndPttn.setValue(arrPar[0].IND_PTTN); // 업종유형

    if (txb_KisCd.getValue() !== "") {
        await scwin.search();
    }
};

/**
 * @method
 * @name comSrchOpen
 * @description 기업검색 팝업
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.comSrchOpen = async function() {
    const options = {
        id: "ULDFIS00100_P1",
        title: "기업 검색",
        type: "browserPopup",
        width: 640 + 20,
        height: 445 + 45,
        callbackFn: "scwin.popupCallback"
    };

    $c.win.openPopup("./ULDFIS00100_P1.gfm", options);
};

/**
 * @method
 * @name chkValid
 * @description 조회조건 유효성 체크
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.chkValid = async function() {
    // 필수항목 체크.
    if (txb_CoSnm.getValue() === "") {
        await $c.win.alert("기업명을 입력하세요.");
        txb_CoSnm.focus();
        return false;
    }

    // 기업명은 있는데 기업코드가 없는 경우
    if (txb_CoSnm.getValue() !== "" && txb_KisCd.getValue() === "") {
        await scwin.comInfoSrch();
        return false;
    }
    return true;
};

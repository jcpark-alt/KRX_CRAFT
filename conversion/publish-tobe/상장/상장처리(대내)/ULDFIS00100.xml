/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {void}
 * @hidden N
 */
scwin.onpageload = function() {
    try {
        // 화면 초기화.
        scwin.init();

        // 기본값 세팅
        scwin.setDefaultVal();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDFIS00100.onpageload" });
    }
};

/**
 * @method
 * @name onpageunload
 * @description 화면 언로드 시 정리 처리
 * @returns {void}
 * @hidden N
 */
scwin.onpageunload = function() {
};

// var vCurDate = cGetToday("yyyymmdd");
// var pMenuID = InfoMenuID();

/**
 * @method
 * @name init
 * @description 화면 초기화 — 파라미터 수신·기본값·컴포넌트 초기 설정(onpageload 에서 순차 호출)
 * @returns {void}
 * @hidden N
 */
scwin.init = function() {
    // 패널 라운드 처리
    $c.cm.PanelToGroupBox(panel_Top);
    $c.libRoundPanel.PanelToGroupBox(panel_Mid);
    $c.cm.PanelToGroupBox(panel_Bot);
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name btn_Search_onclick
 * @description 「조회」 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_Search_onclick = async function() {
    try {
        // 조회버튼 클릭
        await scwin.search();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIS00100.btn_Search_onclick" });
    }
};

/**
 * @method
 * @name img_CoSearch_onclick
 * @description img_CoSearch 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.img_CoSearch_onclick = async function() {
    try {
        // 기업검색팝업 오픈
        await scwin.comSrchOpen();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIS00100.img_CoSearch_onclick" });
    }
};

/**
 * @method
 * @name txb_CoSnm_onkeydown
 * @description txb_CoSnm 키 입력 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.txb_CoSnm_onkeydown = async function() {
    try {
        // 기업명 키다운.
        if (event.keyCode === 13) {
            if (txb_CoSnm.getValue() === "") {
                // 기업검색팝업 오픈
                await scwin.comSrchOpen();
            } else {
                // 기업정보 조회
                await scwin.comInfoSrch();
            }
        }
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIS00100.txb_CoSnm_onkeydown" });
    }
};

/**
 * @method
 * @name txb_CoSnm_onchange
 * @description txb_CoSnm 변경 이벤트
 * @returns {void}
 * @hidden N
 */
scwin.txb_CoSnm_onchange = function() {
    try {
        // 조회조건이 변경된 경우 초기화.
        txb_KisCd.setValue("");
        txb_IndPttn.setValue("");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDFIS00100.txb_CoSnm_onchange" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name comInfoSrch
 * @description com Info Srch 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.comInfoSrch = async function() {
    // 데이터셋 초기화
    scwin.initDs("2");
    const sbmOptions = {
        id : "sbm_dts_ComInfo",
        action : "/listingCommon.do",
        ref : "",
        target : "dts_ComInfo=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    // 조회결과가 1개이면 기업개황 조회 아니면 기업팝업 오픈.
    if (dts_ComInfo.getRowCount() === 1) {
        // 조회조건에 값을 세팅하고..
        txb_KisCd.setValue(dts_ComInfo.getCellData(0, "KIS_CD"));
        txb_IndPttn.setValue(dts_ComInfo.getCellData(0, "IND_PTTN"));
        await scwin.search(); // 기업개황 조회

    } else {
        await scwin.comSrchOpen(); // 기업검색 팝업 오픈

    }
};

/**
 * @method
 * @name search
 * @description 기업개황 조회
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.search = async function() {
    // 데이터셋 초기화
    scwin.initDs("1");

    // 조회조건 필수 체크.
    if (!await scwin.chkValid()) {
        return;
    }
    const sbmOptions = {
        id : "sbm_dts_ComOutLook",
        action : "/listingCommon.do",
        ref : "",
        target : "dts_ComOutLook=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    // 재무정보 조회
    if (dts_ComOutLook.getRowCount() > 0) {
        await scwin.searchFncInfo();
    }
};

/**
 * @method
 * @name searchFncInfo
 * @description 기업개황_재무정보 조회
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.searchFncInfo = async function() {
    const sbmOptions = {
        id : "sbm_dts_FncInfo",
        action : "/listingCommon.do",
        ref : "",
        target : "dts_FncInfo=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};


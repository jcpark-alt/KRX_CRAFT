};

/**
 * @method
 * @name init
 * @description 화면 초기화 — 파라미터 수신·기본값·컴포넌트 초기 설정(onpageload 에서 순차 호출)
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.init = async function() {
    const strBzProcsNo = $c.stf.getQuery(frame.srcUrl, "BZ_PROCS_NO");
    if (strBzProcsNo === "") {
        btn_Save.hide();
        await $c.win.alert("실질심사  내용을 저장 한 후에 상장적격성 실질심사 절차를 등록하여 주십시오.");
    }
    txb_BZ_PROCS_NO.setValue(strBzProcsNo);
    url += "&BZ_PROCS_NO=" + strBzProcsNo;
    const sbmOptions = {
        id : "sbm_dts_Grid",
        action : "/RealInvstg.do",
        ref : "",
        target : "dts_Grid=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

    const sSEQ = txb_BYBZPROCS_SEQ.getValue();
    // alert(dts_Grid.Text);

    if (sSEQ === "") {
        // 추가모드.
        dts_Grid.insertRow(); // syncload = true;
        dts_Grid.setCellData(1, "BZ_PROCS_NO", strBzProcsNo);
        dts_Grid.setCellData(1, "STEP01", "0");
        dts_Grid.setCellData(1, "STEP02", "0");
        dts_Grid.setCellData(1, "STEP03", "0");
        dts_Grid.setCellData(1, "STEP04", "0");
        dts_Grid.setCellData(1, "STEP05", "0");
        dts_Grid.setCellData(1, "STEP06", "0");
        dts_Grid.setCellData(1, "STEP07", "0");
        dts_Grid.setCellData(1, "STEP08", "0");
        dts_Grid.setCellData(1, "STEP09", "0");
        dts_Grid.setCellData(1, "STEP10", "0");
        dts_Grid.setCellData(1, "STEP11", "0");
        dts_Grid.setCellData(1, "STEP12", "0");
    }
    const sbmOptions2 = {
        id : "sbm_dts_detail",
        action : "/listingCommon.do",
        ref : "",
        target : "dts_detail=body.content",
        isProcessMsg : false
    };

    const sbmRtn2 = await $c.sbm.executeDynamic(sbmOptions2);
    // TODO Stage2: sbmRtn2 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};


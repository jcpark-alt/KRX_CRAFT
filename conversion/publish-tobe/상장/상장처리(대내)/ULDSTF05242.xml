/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.onpageload = async function() {
    try {
        scwin.hideDebugCtrls();
        $c.cm.PanelToGroupBox(panel_1);
        await scwin.init();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF05242.onpageload" });
    }
};

/**
 * @method
 * @name onpageunload
 * @description 화면 언로드 시 정리 처리
 * @returns {void}
 * @hidden N
 */

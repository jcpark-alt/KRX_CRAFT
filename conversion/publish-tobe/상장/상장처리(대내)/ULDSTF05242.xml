/**
 * @method
 * @name save
 * @description save 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.save = async function() {
    const sSTEP01 = dts_Grid.getCellData(1, "STEP01");
    const sSTEP02 = dts_Grid.getCellData(1, "STEP02");
    const sSTEP03 = dts_Grid.getCellData(1, "STEP03");
    const sSTEP04 = dts_Grid.getCellData(1, "STEP04");
    const sSTEP05 = dts_Grid.getCellData(1, "STEP05");
    const sSTEP06 = dts_Grid.getCellData(1, "STEP06");
    const sSTEP07 = dts_Grid.getCellData(1, "STEP07");
    const sSTEP08 = dts_Grid.getCellData(1, "STEP08");
    const sSTEP09 = dts_Grid.getCellData(1, "STEP09");
    const sSTEP10 = dts_Grid.getCellData(1, "STEP10");
    const sSTEP11 = dts_Grid.getCellData(1, "STEP11");
    const sSTEP12 = dts_Grid.getCellData(1, "STEP12");
    if (sSTEP01 === "0" && sSTEP02 === "0" &&
        sSTEP03 === "0" && sSTEP04 === "0" &&
        sSTEP05 === "0" && sSTEP06 === "0" &&
        sSTEP07 === "0" && sSTEP08 === "0" &&
        sSTEP09 === "0" && sSTEP10 === "0" &&
        sSTEP11 === "0" && sSTEP12 === "0") {
        await $c.win.alert("저장할 상태가 없습니다.");
        return;
    }
    const res = window.confirm("상장적격성 실질심사 절차를 저장합니다.\n\n계속하시겠습니까?");
    if (res) {
        trs_Save.KeyName = "toinb_dataid4";
        // [전환검토] trs_Save.Parameters → 동적 파라미터(필요 시 sbmOptions 에 반영)
        // const sbmParams = {
        //     USER_ID : js_id
        // };
        const sbmOptions = {
            id : "sbm_trs_Save",
            action : "/RealInvstg.do",
            ref : "dts_Grid",
            target : "trs_Save=body.content",
            isProcessMsg : false
        };

        const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
        // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)
    }
};


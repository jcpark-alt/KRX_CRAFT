/**
 * @method
 * @name confirm
 * @description confirm 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.confirm = async function() {
    dts_isudtl.removeAll();
    for (let i = 11; i <= 60; i++) {
        scwin.setIsuDtl(i);
        scwin.generatekeyWord(document.getElementById("chk_" + i), "tbx_ISSUE_" + i);
    }
    frame.opener.tbox_may_keywrd.setValue(scwin.vkeyWord.substr(0, scwin.vkeyWord.length - 2));
    const parentWin = $c.frame.path("../");
    parentWin.fn_SetPar(dts_issueyn, dts_isudtl);
    await $c.win.closePopup();
};

/**
 * @method
 * @name setIsuDtl
 * @description set Isu Dtl 처리
 * @param {*} codeIdx codeIdx
 * @returns {void}
 * @hidden N
 */
scwin.setIsuDtl = function(codeIdx) {
    dts_isudtl.insertRow();
    const seq = "" + dts_isudtl.getRowCount();
    dts_isudtl.setCellData(seq, "LIST_INVSTG_ISUE_KEYWRD_TP_CD", codeIdx);
    dts_isudtl.setCellData(seq, "LIST_INVSTG_ISUE_KEYWRD_YN", dts_issueyn.getCellData(1, "LIST_INVSTG_ISUE_KEYWRD_" + codeIdx + "_YN"));
    dts_isudtl.setCellData(seq, "LIST_INVSTG_ISUE_KEYWRD", dts_issueyn.getCellData(1, "LIST_INVSTG_ISUE_KEYWRD_" + codeIdx));
};

/**
 * @method
 * @name generatekeyWord
 * @description generatekey Word 처리
 * @param {Object} obj 컴포넌트
 * @param {*} obj_id obj_id
 * @returns {void}
 * @hidden N
 */
scwin.generatekeyWord = function(obj, obj_id) {
    if (obj.checked !== true) return;
    const cnm = obj.name;
    if ((obj.id === 'chk_20' || obj.id === 'chk_28' || obj.id === 'chk_39' || obj.id === 'chk_43' || obj.id === 'chk_48' || obj.id === 'chk_52' || obj.id === 'chk_60')) {
        obj = document.getElementById(obj_id);
        if (obj.getValue() !== "") {
            scwin.vkeyWord += obj.getValue() + ", ";
        } else scwin.vkeyWord += cnm + ", ";
    } else scwin.vkeyWord += cnm + ", ";
};

		<script type="text/javascript" lazy="false"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.g_ACPT_NO = '';

///////// 2. 초기화 영역 /////////
/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.onpageload = async function() {
    try {
        const sbmOptions = {
            id : "sbm_MxDataSet",
            action : "/gauceSystemierAdaptor.do",
            ref : "",
            target : "MxDataSet=body.content",
            isProcessMsg : false
        };

        const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
        // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

        $c.cm.PanelToGroupBox_01(panel_1);
        // PanelToGroupBox_02(panel_2);
        toDaySet(txb_date);
        await scwin.listSync();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDMGT10106.onpageload" });
    }
};

/**
 * @method
 * @name onpageunload
 * @description 화면 언로드 시 정리 처리
 * @returns {void}
 * @hidden N
 */
scwin.onpageunload = function() {
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name MxDataSet_OnLoadCompleted
 * @description MxDataSet 로드 완료 후처리(레거시 Gauce 이벤트명 — 화면 내부 호출용)
 * @param {Number} rowcount 조회 건수
 * @returns {void}
 * @hidden N
 */
scwin.MxDataSet_OnLoadCompleted = function(rowcount) {
    try {
        textbox_1.setValue("총 " + rowcount + "건");
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10106.MxDataSet_OnLoadCompleted" });
    }
};

/**
 * @method
 * @name btn_cal_onclick
 * @description btn_cal 클릭 이벤트
 * @returns {void}
 * @hidden N
 */
scwin.btn_cal_onclick = function() {
    try {
        popUpCalendar(txb_date_bg, 'txb_date', 'yyyymmdd'); // alert('image_2.onclick');
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10106.btn_cal_onclick" });
    }
};

/**
 * @method
 * @name btn_sys_search_onclick
 * @description 「조회」 클릭 이벤트
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.btn_sys_search_onclick = async function() {
    try {
        if (txb_date.getValue() !== "") {
            await scwin.listSync(); // alert();

        } else {
            await $c.win.alert("접수일을 지정하십시요");
        }
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDMGT10106.btn_sys_search_onclick" });
    }
};

/**
 * @method
 * @name btn_toExcel_onclick
 * @description 「엑셀다운로드」 클릭 이벤트
 * @returns {void}
 * @hidden N
 */
scwin.btn_toExcel_onclick = function() {
    try {
        $c.data.downloadGridViewExcel(MxGrid_1, {fileName: "우편함공시처리현황", type: "8"});
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDMGT10106.btn_toExcel_onclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name listSync
 * @description list Sync 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.listSync = async function() {
    const sbmOptions = {
        id : "sbm_MxDataSet",
        action : "/disclspost.do",
        ref : "",
        target : "MxDataSet=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name setContnId
 * @description set Contn Id 처리
 * @param {Object} obj 컴포넌트
 * @returns {void}
 * @hidden N
 */
scwin.setContnId = function(obj) {
    scwin.g_ACPT_NO = MxDataSet.getCellData(Number(obj), "ACPT_NO");
};
]]></script>

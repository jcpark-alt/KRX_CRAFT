 * @name trs_Save_OnFail
 * @description Save On Fail 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.trs_Save_OnFail = async function() {
    try {
        let msg = $c.stf.getMessageParam("MSG-A002", scwin.gLastJob);
        await $c.win.alert(msg);
        await $c.win.alert(trs_Save);
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF30701.trs_Save_OnFail" });
    }
};

/**

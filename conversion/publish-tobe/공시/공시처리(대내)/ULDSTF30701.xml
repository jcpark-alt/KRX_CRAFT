///////// 4. 서브미션 콜백 영역 /////////
/**
 * @method
 * @name readNewPassword
 * @description NEWPASS_READ|INTEG_USR_ID=" + vINTEG_USR_ID
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.readNewPassword = async function() {
    // NEWPASS_READ|INTEG_USR_ID=" + vINTEG_USR_ID
    const vTemp = frame.FrameID;
    const Temp2 = vTemp.split("|")[1];
    const vCORP_USR_REG_APPL_SEQ = Temp2.split("=")[1]; // CORP_USR_REG_APPL_SEQ
    // alert(vCORP_USR_REG_APPL_SEQ);
    // alert(vCONTN_ID);
    url += "&CORP_USR_REG_APPL_SEQ=" + vCORP_USR_REG_APPL_SEQ;
    url += "&SCREN_ID=" + "ULDSTF30701.xml";
    url += "&SCREN_PROCES_TP_CD=" + SCREN_PROCS_TP_CD_01;
    const sbmOptions = {
        id : "sbm_dts_MASTER",
        action : "/ListedCompanyPassword.do",
        ref : "",
        target : "dts_MASTER=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)

};

/**
 * @method
 * @name executeNewPasswordApproval
 * @description execute New Password Approval 처리
 * @param {*} APPL_FLAG APPL_FLAG
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.executeNewPasswordApproval = async function(APPL_FLAG) {
    let canGoNext = true;
    let usrTpCd = dts_MASTER.getCellData(1, "CORP_USR_TP_CD");
    if (APPL_FLAG === "Y") {
        scwin.gLastJob = "승인";
        if (usrTpCd === '32') {
            if (!await scwin.check4MM()) {
                canGoNext = false;
            }
        }
    } else if (APPL_FLAG === "N") {
        scwin.gLastJob = "거부";
    }
    if (canGoNext) {
        txb_APPL_RSLT_CD.setValue(APPL_FLAG);
        //    return;
        let msg = $c.stf.getMessageParam("MSG-A006", scwin.gLastJob);
        let res = window.confirm(msg);
        if (res) {
            trs_Save.KeyName = "toinb_dataid4";
            const sbmOptions = {
                id : "sbm_trs_Save",
                action : "/ListedCompanyPassword.do",
                ref : "dts_MASTER",
                target : "trs_Save=body.content",
                isProcessMsg : false
            };

            const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
            // TODO Stage2: sbmRtn 응답 처리 로직 작성 (구 submitDoneHandler 자리)
        }
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name initPage
 * @description init Page 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.initPage = async function() {
    await scwin.readNewPassword();
    const vAPPL_RSLT_CD = txb_APPL_RSLT_CD.getValue();
    if (vAPPL_RSLT_CD !== "R") {
        btn_Approv.hide(); // 승인버튼 숨기기.
        btn_REJECT.hide();
    }
    txb_EMP_NO.setValue(js_emp_no); // 세션정보 넘기기. 이런 ㅈㄹ같은.;;

};

/**
 * @method
 * @name hideDebugCtrls
 * @description hide Debug Ctrls 처리
 * @returns {void}
 * @hidden N
 */
scwin.hideDebugCtrls = function() {
    panel_debug.hide();
};

/**
 * @method
 * @name check4MM
 * @description check4 MM 처리
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.check4MM = async function() {
    const mm_a = txt_MM_A.getValue();
    const mm_b = txt_MM_B.getValue();
    // 시장조성자 번호는 필수임.
    if (mm_a === '') {
        await $c.win.alert('시장조성자 번호가 없습니다. 시스템담당자에게 문의 하십시오.');
        return false;
    } else {
        // 발행기관에 시장조성자 번호가 있는경우,  승인시 신청한 시장조성자 번호로 업데이트 하지 않음.(시장조성자 번호가 발행기관에 없는 경우에만 처기하기 위하여)
        if (mm_b !== '') {
            let res = window.confirm('발행기관 테이블에 시장조성자 번호가 있는경우,\r\n시장조성자 번호는 업데이트 하지 않습니다.\r\n계속 진행하시겠습니까?');
            if (res) {
                return true;
            } else return false;
        } else return true;
    }
};

/**
 * @method
 * @name checkIsMM
 * @description check Is MM 처리
 * @returns {void}
 * @hidden N
 */
scwin.checkIsMM = function() {
    let usrTpCd = dts_MASTER.getCellData(1, "CORP_USR_TP_CD");
    if (usrTpCd === '32') {
        pnl_MM.show("");
    } else {
        pnl_MM.hide();
    }
};
]]></script>

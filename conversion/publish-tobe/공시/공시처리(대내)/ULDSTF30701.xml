    try {
        let msg = $c.stf.getMessageParam("MSG-A001", scwin.gLastJob);
        await $c.win.alert(msg);
        const fr_fn_Search = $c.frame.path("../").fn_listNewPassword;
        fr_fn_Search();
        await $c.win.closePopup();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF30701.trs_Save_OnSuccess" });
    }
};


scwin.dts_List_OnLoadCompleted = async function(rowcount) {
    try {
        if (dts_List.errorMsg) {
            await $c.win.alert(dts_List.errorMsg);
        } else {
            $c.stf.fillGridHeaderTotalCnt(rowcount, panel_page);

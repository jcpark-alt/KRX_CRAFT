scwin.dts_AcptProcs_OnLoadCompleted = function(rowcount) {
    // *** 처리일시 타이틀 셋팅
    txb_ProcsStatDdtm_Title.setValue(txb_ProcsStatNm.getValue() + " 처리일시");

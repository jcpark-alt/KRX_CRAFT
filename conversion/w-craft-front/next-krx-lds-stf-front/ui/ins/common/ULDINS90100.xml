		<script type="text/javascript" lazy="false"><![CDATA[scwin.vScrenID = "ULDINS90100";
scwin.param1 = "";
scwin.param2 = "";
scwin.flag = "0";

scwin.onpageload = function() {
    scwin.flag = "0";
    ibx_instNm.focus();

    var param = $c.data.getParameter();

    scwin.param1 = $p.parent().scwin.param1;
    scwin.param2 = $p.parent().scwin.param2;

    console.log("scwin.param1 : "+ scwin.param1);

    dlt_list.setCellData(0, "bndInstCd", "00123");
    dlt_list.setCellData(0, "instNm", "테스트");

    if(scwin.param1 != "") { // undefined 확인필요
        scwin.ins_search("", scwin.param1);
    }


};


scwin.btn_search_onclick = function (e) {
    
    scwin.flag = "1";
    scwin.ins_search(ibx_instNm.getValue());
};

scwin.ins_search = function (instNm,mktID) {
    dma_search.set("instNm", instNm);
    dma_search.set("flag", scwin.flag);
    dma_search.set("param1", mktID);
/*
    dlt_list.insertRow(0);
    dlt_list.setCellData(0, "bndInstCd", "00123");
    dlt_list.setCellData(0, "instNm", "테스트");
    //dlt_list.setCellData(0, "stdCdInstStatCd", "1");
    //grd_main.refreshRow(0);
*/

    $c.sbm.execute(sbm_search);
}

scwin.grd_main_oncelldblclick = function (rowIndex, columnIndex, columnId) {
	if(dlt_list.getCellData(rowIndex, "stdCdInstStatCd") != "1") {
        $c.win.alert("기관상태가 정상인 기관만 선택 가능 합니다.\n선택을 원할 경우 기관관리화면에서 상태를 변경 후 선택이 가능합니다.");
        return;
    }

    var bndInstcd = dlt_list.getCellData(rowIndex, "bndInstCd");
    var instNm = dlt_list.getCellData(rowIndex, "instNm");

    $c.cm.ins_popupRtn_cdnm(bndInstcd, instNm);
    $c.win.closePopup();
};

scwin.btn_close_onclick = function (e) {
    $c.win.closePopup();
};

scwin.sbm_search_submitdone = function (e) {
    spa_totCnt.setValue(dlt_list.getRowCount());
};

scwin.ibx_instNm_onkeyup = function (e) {
    scwin.flag = "1";
    $c.cm.fn_DelChar(ibx_instNm);
};

scwin.ibx_instNm_oneditenter = function (e) {
    scwin.flag = "1";
    if(ibx_instNm.getValue() != "") {
        scwin.ins_search(ibx_instNm.getValue());
    }
};
]]></script>

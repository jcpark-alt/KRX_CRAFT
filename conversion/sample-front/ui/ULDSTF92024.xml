<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenId="ULDSTF92024" meta_screenName="공시안내문작성" meta_desc="공시안내문작성 팝업 퍼블리싱 (원본 /listingcommon/ULDSTF92024.gfm, 캡처 2026-10-20 기준 마크업)"
		meta_author="Inswave" meta_date="2026-10-20">
		<title>공시안내문작성</title>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<!-- 공시 기본정보 (원본 dts_Inf 중 화면에 보이는 항목) -->
				<w2:dataMap baseNode="map" id="dma_disclsInf">
					<w2:keyInfo>
						<w2:key id="DISCLS_NM" name="공시명" dataType="text"></w2:key>
						<w2:key id="DISCLS_TITLE" name="공시제목" dataType="text"></w2:key>
						<w2:key id="CORRCT_YN" name="정정구분" dataType="text"></w2:key>
						<w2:key id="HTML_CONTN" name="공시내용" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<!-- 첨부파일 목록 (원본 dts_Fil) -->
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_Fil">
					<w2:columnInfo>
						<w2:column id="fileInfo" name="화일명" dataType="text"></w2:column>
						<w2:column id="fileUrl" name="화일경로" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="scwin.onpageload" />
		<script lazy="false" type="text/javascript"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.screenId = "ULDSTF92024";

///////// 2. 초기화 영역 /////////

/**
 * @method
 * @name scwin.onpageload
 * @author Inswave
 * @date 2026. 10. 20
 * @description 페이지로드
 * @param
 * @returns
 * @hidden N
 */
scwin.onpageload = async function () {
    try {

    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDSTF92024.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////

///////// 4. 서브미션 콜백 영역 /////////

///////// 5. 일반/업무 함수 영역 /////////
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="pop_contents" id="" meta_componentContainer="true" style="">
			<!-- 상단 버튼 : 인쇄(좌) / 정정공시·정정공시 정보입력·공시검토전송·닫기(우) -->
			<xf:group class="titbox mt0" id="" style="">
				<xf:group class="lt" id="" style="">
					<!-- 원본 panel_PRINT : 유가(시장구분 1)일 때만 노출 -->
					<xf:trigger class="btn_cm" id="btn_Print" style="" type="button">
						<xf:label><![CDATA[인쇄]]></xf:label>
					</xf:trigger>
				</xf:group>
				<xf:group class="rt" id="" style="">
					<xf:select appearance="full" cols="1" id="chk_CorrctYn" ref="data:dma_disclsInf.CORRCT_YN" renderType="checkboxgroup"
						selectedindex="-1" style="">
						<xf:choices>
							<xf:item>
								<xf:label><![CDATA[정정공시]]></xf:label>
								<xf:value><![CDATA[Y]]></xf:value>
							</xf:item>
						</xf:choices>
					</xf:select>
					<!-- 원본 pan_btn : 정정공시일 때만 노출 (캡처 1 노출 / 캡처 2 숨김) -->
					<xf:trigger class="btn_cm" id="btn_crt" style="display:none;" type="button">
						<xf:label><![CDATA[정정공시 정보입력]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_cm pt" id="btn_send" style="" type="button">
						<xf:label><![CDATA[공시검토전송]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_cm" id="btn_close" style="" type="button">
						<xf:label><![CDATA[닫기]]></xf:label>
					</xf:trigger>
				</xf:group>
			</xf:group>

			<!-- 제목 : 공시명(읽기전용) ( 공시제목 ) -->
			<xf:group class="tblbox" id="" style="">
				<xf:group adaptive="layout" adaptiveThreshold="768" class="w2tb tbl" id="" style="" tagname="table">
					<w2:attributes>
						<w2:summary>공시안내문 제목</w2:summary>
					</w2:attributes>
					<xf:group tagname="colgroup">
						<xf:group style="width:100px;" tagname="col"></xf:group>
						<xf:group style="" tagname="col"></xf:group>
					</xf:group>
					<xf:group style="" tagname="tr">
						<xf:group class="w2tb_th" style="" tagname="th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
							<w2:textbox id="" label="제목" style=""></w2:textbox>
						</xf:group>
						<xf:group class="w2tb_td" style="" tagname="td">
							<xf:group class="flex flex_no" id="" style="">
								<xf:input id="txb_frmNam" readOnly="true" ref="data:dma_disclsInf.DISCLS_NM" style="width:200px;"
									title="공시명">
								</xf:input>
								<w2:textbox id="" label="(" style=""></w2:textbox>
								<xf:input id="txb_frmTit" maxByteLength="1000" ref="data:dma_disclsInf.DISCLS_TITLE" style="width:100%;"
									title="공시제목">
								</xf:input>
								<w2:textbox id="" label=")" style=""></w2:textbox>
							</xf:group>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>

			<!-- 공시 내용 : 원본 tar(텍스트)·pan(HTML) 두 영역을 editor 하나로 통합. TODO: edt_contn ↔ dma_disclsInf.HTML_CONTN 은 스크립트(setHTML/getHTML)로 연동 -->
			<xf:group class="mt10" id="" style="">
				<w2:editor id="edt_contn" style="width:100%;height:540px;"></w2:editor>
			</xf:group>

			<!-- 첨부파일 : 화일명 목록 + 파일추가(폴더)·삭제 -->
			<xf:group class="titbox" id="" style="">
				<xf:group class="rt" id="" style="">
					<xf:trigger class="btn_cm" id="btn_ins" style="" type="button">
						<xf:label><![CDATA[파일추가]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_cm" id="btn_del" style="" type="button">
						<xf:label><![CDATA[삭제]]></xf:label>
					</xf:trigger>
				</xf:group>
			</xf:group>
			<xf:group class="gvwbox" id="" style="">
				<w2:gridView autoFit="allColumn" class="gvw row3" dataList="data:dlt_Fil" focusMode="row" id="grd_Fil"
					keepDefaultColumnWidth="false" style="" visibleRowNum="3">
					<w2:header id="header1" style="">
						<w2:row id="row1" style="">
							<w2:column displayMode="label" id="hSeq" inputType="text" value="순번" width="60"></w2:column>
							<w2:column displayMode="label" id="hFileInfo" inputType="text" value="화일명" width="570"></w2:column>
						</w2:row>
					</w2:header>
					<w2:gBody id="gBody1" style="">
						<w2:row id="row2" style="">
							<w2:column displayMode="label" expression="rowIndex()+1" id="seq" inputType="expression" textAlign="center"
								width="60">
							</w2:column>
							<w2:column displayMode="label" id="fileInfo" inputType="text" readOnly="true" textAlign="left" width="570">
							</w2:column>
						</w2:row>
					</w2:gBody>
				</w2:gridView>
			</xf:group>
		</xf:group>
	</body>
</html>

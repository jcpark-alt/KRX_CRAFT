        <script lazy="false" type="text/javascript"><![CDATA[/************************************************************************************
 * ID           :	JLDFIL00018
 * File         :	JLDFIL00018.xml
 * Name         :	상장자회사 조회 (법인명 찾기)
 * Author       :	최서희
 * Description  :	상장자회사 조회 (법인명 찾기) 팝업
 * Create Date  :	2026-08-10
************************************************************************************/
scwin.onpageload = function() {
	scwin.param = $c.data.getParameter();

    //시장구분(유가:stockMkt, 코스닥:kosdaqMkt, 코넥스:konexMkt, 연계공시:forLink)
    dma_SearchReq.set("marketType", scwin.param.marketType);

    scwin.searchSubcomList(true);

    //엔터키 조회 세팅
    $c.win.setEnterKeyEvent(grp_search, scwin.btn_search_onclick);
};

/**
 * 조회 버튼 클릭
 */
scwin.btn_search_onclick = function (e) {
    dma_SearchReq.set("beginIndex", "");
    scwin.searchSubcomList(true);
};

/**
 * ㄱ~ㅎ, A~z, 기타 클릭
 */
scwin.btn_quickSearch_onclick = function (e) {
    const val = this.getUserData("userData1");
    dma_SearchReq.set("beginIndex", val);
    scwin.searchSubcomList(true);
};

/**
 * 닫기 버튼 클릭
 */
/*
scwin.btn_cancel_onclick = function () {
    $c.win.closePopup();
};
*/

/**
 * row 선택
 */
scwin.grd_Gird_oncellclick = function (rowIndex, columnIndex, columnId) {
    const rowData = dlt_SubcomList.getRowJSON(rowIndex);
    if(rowData && rowData.isurCd) {
        const isurCd = rowData.isurCd;
        const kisComCd = rowData.kisComCd;
        const repIsuSrtCd = rowData.repIsuSrtCd;
        const comNm = rowData.comNm;
        const comAbbrv = rowData.comAbbrv;
        const isurSymbl = rowData.isurSymbl;
        const fssUnqNo = rowData.fssUnqNo;
        const comEngAbbrv = rowData.comEngAbbrv;
        const eqtyoptIsuObjYn = rowData.eqtyoptIsuObjYn;

	    scwin.setCorpInfo(isurCd, kisComCd, repIsuSrtCd, comNm, comAbbrv, isurSymbl, fssUnqNo, comEngAbbrv, eqtyoptIsuObjYn);
    }
};


/**
 * 페이지네이션 현재 페이지 변경
 */
scwin.pageList1_onviewchange = function (info) {
	const currentPage = info.newSelectedIndex;
    dma_SearchReq.set("page", currentPage);
	scwin.searchSubcomList(false);
};


/// FUNCTION ///

scwin.searchSubcomList = async function (isFirst) {
    if(isFirst) {
        dma_SearchReq.set("page", 1);//현재페이지 초기화
    }

    const id = "sbm_SelectSubcom";
	const sbmOptions = {
        id : id,
        method: "get",
        action : "/api/discls/common/popup/corp/select-list",
        ref : "dma_SearchReq",
        target : "dma_SearchRes=body,dlt_SubcomList=body.content",
        gridview : "grd_Grid",
        isProcessMsg : false 
    };
	let res = await $c.sbm.executeDynamic(sbmOptions);

    if (res.responseJSON.success == true) {
        const resBody = res.responseJSON.body;
        txt_totalCount.setValue(resBody.totalCount);
        txt_page.setValue(resBody.page);
        txt_totalPages.setValue(resBody.totalPages);
        
        for (let idx = 0; idx < resBody.content.length; idx++) {
            const row = dlt_SubcomList.getRowJSON(idx);
            
            //TODO : 회사명 앞에 아이콘 이미지 표시
            //if(marketType.equals("1")) marketTypeImageName = "ic_yu";
            //else if(marketType.equals("2")) marketTypeImageName = "ic_ko";
            //else if(marketType.equals("6")) marketTypeImageName = "ic_konex";   

            const comNm = row.comNm;
            const listStatCd = row.listStatCd;
            const marketType = row.spotIsuTrdMktTpCd;
            let marketTypeImageName = "";

            //TODO : 아이콘 이미지 표시
            if(listStatCd == "Y") {
                if(marketType == "1") {
                    marketTypeImageName = "유";
                } else if(marketType == "2") {
                    marketTypeImageName = "코";
                } else if(marketType == "6") {
                    marketTypeImageName = "넥";                              
                }
            } else if(listStatCd == "N") {
                    marketTypeImageName = "기";                              
            } else if(listStatCd == "D") {
                    marketTypeImageName = "폐";                              
            }
            if(marketTypeImageName) {
                dlt_SubcomList.setCellData(idx, "comNm", marketTypeImageName + " " + comNm);
            }
        }

        if (isFirst) {
            //페이지네이션 생성
            pageList1.setCount(resBody.totalPages);
        } else {
            //페이지네이션 선택
            pageList1.setSelectedIndex(resBody.page);
        }
    }
};

/**
 * 데이터 콜백(팝업 닫고 파라미터 전달)
 */
scwin.setCorpInfo = function (isurCd, kisComCd, repIsuSrtCd, comNm, comAbbrv, isurSymbl, fssUnqNo, comEngAbbrv, eqtyoptIsuObjYn) {
    const data = {
        "isurCd": isurCd,
        "kisComCd": kisComCd,
        "repIsuSrtCd": repIsuSrtCd,
        "repIsuSrtCd": repIsuSrtCd,
        "comNm": comNm,
        "comAbbrv": comAbbrv,
        "isurSymbl": isurSymbl,
        "fssUnqNo": fssUnqNo,
        "comEngAbbrv": comEngAbbrv,
        "eqtyoptIsuObjYn": eqtyoptIsuObjYn,
    }
    $c.win.closePopup(data, scwin.param.callbackFn);
};


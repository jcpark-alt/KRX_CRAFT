/**
 * @method
 * @name btn_excel_onclick
 * @description 「엑셀다운로드」 버튼 클릭 — 두 그리드를 멀티 시트 엑셀로 내려받는다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 */
scwin.btn_excel_onclick = function (e) {
    try {
        const options = {
            common:{
            fileName:"ELW발행가능기초자산.xlsx"
            },
            excelInfo:[
                {
                    gridId: "grd_list1"
                }
                ,
                {
                    gridId: "grd_list2"
                }
            ]
        };

        $c.data.downloadMultipleGridView(options);
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDFIL05039.btn_excel_onclick" });
    }
};

/**
 * @method
 * @name btn_search_onclick
 * @description 「조회」 버튼 클릭 — ELW 발행가능 기초자산 목록을 조회한다.
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 */

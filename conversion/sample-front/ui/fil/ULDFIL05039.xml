/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — search 호출
 * @returns {void}
 * @hidden N
 */
scwin.onpageload = function() {
    try {

        // 초기화함수

        scwin.init();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDFIL05039.onpageload" });
    }
};

/**
 * @method
 * @name init
 * @description 화면 초기화 — 파라미터 수신·기본값·컴포넌트 초기 설정(onpageload 에서 순차 호출).
 * @returns {void}
 * @hidden N
 */
scwin.init = function () {

    const vCurDate = $c.date.getServerDateTime("yyyymmdd");
    ica_searchDd.setValue(vCurDate);

    dma_searchReq.set("forExcel", "N");
    scwin.search();

    // 컴포넌트 객체 전달
    $c.date.checkCalendarFormat("ica_searchDd", "yyyyMMdd");

    // 해당 그룹 안의 컴포넌트에서 엔터키가 발생하면 해당 컴포넌트의 값을 DataCollection에 저장하고 objFunc 함수를 실행한다.

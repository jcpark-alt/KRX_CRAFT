/**
 * @method
 * @name search
 * @description 목록 조회
 * @returns {Promise<void>}
 * @hidden N
 */
scwin.search = async function() {
    const sbmOptions = {
        id : "sbm_isuPosbleExerPrcInfo",
        method: "get",
        action : "/api/listing/list/elw/apply/isu-posble-exer-prc-info/select-list",
        ref : "dma_searchReq",
        target : "dlt_resultKospiRes=body.resultKospi, dlt_resultStarRes=body.resultStar, dma_searchInfoRes=body.searchInfo",
        //  gridview : "grd_list",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    await scwin.sbm_isuPosbleExerPrcInfo_submitdone(sbmRtn);
}


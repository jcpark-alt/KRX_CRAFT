        <script lazy="false" type="text/javascript"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.pageIndex = 1;
scwin.pageItemCnt = 10;
window.disPage = window.disPage || {};
window.disPage

// 첨부파일 다운로드(전역으로 선언)
 
window.disPage.fn_downloadAttach = function (contnId, contnAttachSeq) {
    scwin.downloadAttach(contnId, contnAttachSeq);
};

///////// 2. 초기화 영역 /////////
scwin.onpageload = async function() {
    try {
       // 초기화함수
       await scwin.init();

       	// 목록 조회
       await scwin.search();
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIL58000.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////
// 조회 버튼 클릭
scwin.btn_search_onclick = async function (e) {
    try {
        await scwin.search(true);
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIL58000.btn_search_onclick" });
    }
};

// 페이지 사이즈 변경
scwin.sel_size_onviewchange = function (info) {
	try {
		scwin.search(true);
	} catch (ex) {
		$c.exception.handleError(ex, { context : "ULDFIL58000.sel_size_onviewchange" });
	}
};

// 페이지네이션 현재 페이지 변경
scwin.pageList1_onviewchange = async function (info) {
    try {
        const currentPage = info.newSelectedIndex;
        dma_SearchReq.set("page", currentPage);
    	scwin.search(false);
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIL58000.pageList1_onviewchange" });
    }
};

// 선택(상세보기, 첨부파일 다운로드)
scwin.grd_List_oncellclick = async function (rowIndex, columnIndex, columnId) {
    try {
        const contnId = dlt_BbsList.getCellData(rowIndex, "contnId");

        if(columnId === "dispalyName") {
            return;
        } else {
            await scwin.searchDetailView(contnId);
        }
    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDFIL58000.grd_List_oncellclick" });
    }
};

///////// 4. 서브미션 콜백 영역 /////////
// 리스트 조회
scwin.search = async function (isFirst) {

    const dateChk = await $c.date.diffDate(ibx_startDate.getValue(), ibx_endDate.getValue());

    if(dateChk < 0) {
        $c.win.alert("시작일이 종료일이 보다 클 수 없습니다.")
        return;
    }

    if(isFirst) {
        dma_SearchReq.set("page", 1);// 현재페이지 초기화
        dma_SearchReq.set("size", 10);// 페이지당 데이터 개수
    }

    const sbmOptions = {
        id : "sbm_SelectBbsList",
        method: "get",
        action : "/api/listing/listinvstg/common-board/select-list-paging",
        ref : "dma_SearchReq",
        target : "dma_SearchRes=body,dlt_BbsList=body.content",
        gridview : "grd_List",
        isProcessMsg : true 
    };

	const res = await $c.sbm.executeDynamic(sbmOptions);

    if (res.responseJSON.success === true) {
        const bbsList = dlt_BbsList.getAllJSON();
        
        if(!bbsList || bbsList.length === 0) {
            dma_SearchRes.set("page", 0);

        } else {
            dlt_BbsList.setBroadcast(false);
            for (let idx = 0; idx < bbsList.length; idx++) {
                        
                // 첨부파일
                const row = dlt_BbsList.getRowJSON(idx);
                const attachFileNm = row.attachFileNm;
                const attachIcon = row.attachIcon;
                const contnId = row.contnId;
                const contnAttachSeq = row.contnAttachSeq;

                let dispalyName = "";  
                if(attachFileNm && attachFileNm.length !== "") {
                 
                    let fileNm = "";
                    
                        fileNm += "<a href='javascript:void(0)' style='margin:1.5px 1.5px;' title='"+attachFileNm+"' onclick=\"window.disPage.fn_downloadAttach(";
                        fileNm += "'"+ contnId + "',";
                        fileNm += "'"+ contnAttachSeq + "'";
                        fileNm += ")\" >";
                    if(attachIcon=== "1") {
                        fileNm += "<img src='/cm/images/dis/attach_1.gif' border='0' alt='"+attachFileNm+"' />"; 
                    } else if(attachIcon === "2") {
                        fileNm += "<img src='/cm/images/dis/attach_2.gif' border='0' alt='"+attachFileNm+"' />"; 
                    } else if(attachIcon === "3") {
                        fileNm += "<img src='/cm/images/dis/attach_3.gif' border='0' alt='"+attachFileNm+"' />"; 
                    } else if(attachIcon === "4") {
                        fileNm += "<img src='/cm/images/dis/attach_4.gif' border='0' alt='"+attachFileNm+"' />"; 
                    } else if(attachIcon === "6") {
                        fileNm += "<img src='/cm/images/dis/attach_6.gif' border='0' alt='"+attachFileNm+"' />"; 
                    } else {
                        fileNm += "<img src='/cm/images/dis/attach_5.gif' border='0' alt='"+attachFileNm+"' />"; 
                    }
                    
                    fileNm += "</a>";
                    dispalyName += fileNm;
                
                }
                dlt_BbsList.setCellData(idx, "dispalyName", dispalyName);

            }
            dlt_BbsList.setBroadcast(true, true);
        }
        if (isFirst) {
            // 페이지네이션 생성
            pageList1.setCount(dma_SearchRes.get("totalPages"));
        } else {
            // 페이지네이션 선택
            pageList1.setSelectedIndex(dma_SearchRes.get("page"));
        }
    }
};

///////// 5. 일반/업무 함수 영역 /////////
scwin.init = async function() {
    // 조회조건의 기간 체크
    $c.date.compareFromToDate(ibx_startDate, ibx_endDate);

	// 조회조건 영역 엔터키 치면 자동 조회되도록 SET
	$c.win.setEnterKeyEvent(grp_search, scwin.btn_search_onclick);
}

// 상세보기
scwin.searchDetailView = async function (contnId) {
    let param = {};
    param.contnId = contnId;
    await $c.win.moveUrl("/ui/lst/lstinvstg/ULDFIL58001.xml", param);
};

// 첨부파일 다운로드(지역으로 선언)
scwin.downloadAttach = function (contnId, contnAttachSeq) {
    const url = "/api/listing/listinvstg/common-board/file-download";
    const param = {
        contnId : contnId,
        contnAttachSeq : contnAttachSeq
    }; 
    $c.data.downFile(url, "", param);
};
]]></script>

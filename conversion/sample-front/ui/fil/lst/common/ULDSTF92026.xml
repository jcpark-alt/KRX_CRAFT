/**
 * @method
 * @name onpageload
 * @description 화면 로딩 시 초기 처리 — init 순차 호출
 * @returns {void}
 * @hidden N
 */
scwin.onpageload = function() {
    try {
        scwin.init();
    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF92026.onpageload" });
    }
};

/**
 * @method
 * @name init
 * @description 초기값 셋팅
 * @returns {void}
 * @hidden N
 */
scwin.init = function(){
    // 초기값 셋팅
    scwin.setData($c.data.getParameter('reqJson'));
};

///////// 3. 컴포넌트 이벤트 영역 /////////
/**
 * @method
 * @name btn_Save_onclick
 * @description 저장
 * @param {Object} e 이벤트 객체
 * @returns {void}
 * @hidden N
 */
scwin.btn_Save_onclick = function (e) {
    try {
        if(scwin.newYn === "Y"){
            $c.win.closePopup({
                'isuRnd': txb_nm.getValue(), // 주식발행회차
                'isuDd' : med_PrtdepoStrtDd2.getValue(), // 주식발행일
                'isuShrs' : input3.getValue(), // 발행주식수
                'isuPrc' : input1.getValue(), // 1주 발행가
                'ksdMatchYn' : sbx_ksdStockIssuYn.getValue()
            });
        }else{
            $c.win.closePopup(sbx_ksdStockIssuYn.getValue());
        }

    } catch (ex) {
        $c.exception.handleError(ex, { context : "ULDSTF92026.btn_Save_onclick" });
    }
};

///////// 5. 일반/업무 함수 영역 /////////
/**
 * @method
 * @name setData
 * @description 오프너가 넘긴 행 데이터로 입력 폼 구성(없으면 신규 입력 모드)
 * @param {Object} param param
 * @returns {void}
 * @hidden N
 */
scwin.setData = function(param){
    if($c.util.isEmpty(param)){
        scwin.newYn = "Y";
        // 행추가로 진입시
        txb_nm.setDisabled(false);
        med_PrtdepoStrtDd2.setDisabled(false);
        input3.setDisabled(false);
        input1.setDisabled(false);
    }else{
        txb_nm.setValue(param.isuRnd);// 주식발행회사
        med_PrtdepoStrtDd2.setValue(param.isuDd);// 주식발행일
        input3.setValue(param.isuShrs);// 발행주식수
        input1.setValue(param.isuPrc);// 1주 발행가
        input4.setValue(param.per1stkCap);// 주급 납입
        selectbox1.setValue(param.corpbndIsuRnd);// 소송제기여부
        med_PrtdepoStrtDd.setValue(param.filelawstDd);// 소송제기일
        sbx_ksdStockIssuYn.setValue(param.krxKsdMatchYn);;// 예탁원주식발행여부
    }
};
]]></script>

<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:ev="http://www.w3.org/2001/xml-events" xmlns:w2="http://www.inswave.com/websquare"
	xmlns:xf="http://www.w3.org/2002/xforms">
	<head meta_screenId="ULDINS94400" meta_screenName="비밀번호수정" meta_desc="등록된 이메일 주소로 비밀번호를 전송할 수 없는 사용자의 비밀번호를 수동으로 수정하고, 필요하면 안내문자를 발송하는 팝업 퍼블리싱 (캡처 ULDINS94400.png 2026-10-23 기준 마크업)"
		meta_author="Inswave" meta_date="2026-10-23">
		<title>비밀번호수정</title>
		<w2:type>COMPONENT</w2:type>
		<w2:buildDate />
		<xf:model>
			<w2:dataCollection baseNode="map">
				<!-- 사용자 정보 + 변경 비밀번호. TODO: 키 이름은 서버 전문 확정 후 맞춘다(캡처 기준 가칭). -->
				<w2:dataMap baseNode="map" id="dma_usrInf">
					<w2:keyInfo>
						<w2:key id="usrId" name="아이디" dataType="text"></w2:key>
						<w2:key id="usrNm" name="신청인" dataType="text"></w2:key>
						<w2:key id="email" name="이메일" dataType="text"></w2:key>
						<w2:key id="mphonNo" name="휴대전화번호" dataType="text"></w2:key>
						<!-- TODO: 단일 체크박스는 체크 시 "Y", 해제 시 "" 를 쓴다. 서버가 "N" 을 요구하면 저장 전에 보정한다. -->
						<w2:key id="smsSendYn" name="안내문자발송여부" dataType="text"></w2:key>
						<w2:key id="chgPwd" name="변경 패스워드" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
			<w2:workflowCollection />
		</xf:model>
		<w2:layoutInfo />
		<w2:publicInfo method="scwin.onpageload" />
		<script lazy="false" type="text/javascript"><![CDATA[
///////// 1. 변수 및 선언 영역 /////////
scwin.screenId = "ULDINS94400";

///////// 2. 초기화 영역 /////////

/**
 * @method
 * @name scwin.onpageload
 * @author Inswave
 * @date 2026. 10. 23
 * @description 페이지로드
 * @param
 * @returns
 * @hidden N
 */
scwin.onpageload = async function () {
    try {

    } catch (ex) {
        await $c.exception.handleError(ex, { context : "ULDINS94400.onpageload" });
    }
};

///////// 3. 컴포넌트 이벤트 영역 /////////

///////// 4. 서브미션 콜백 영역 /////////

///////// 5. 일반/업무 함수 영역 /////////
]]></script>
	</head>
	<body ev:onpageload="scwin.onpageload">
		<xf:group class="pop_contents" id="" meta_componentContainer="true" style="">
			<!-- 사용자 정보 : 아이디·신청인·이메일·휴대전화번호는 출력, 변경 패스워드만 입력 -->
			<xf:group class="tblbox" id="" style="">
				<xf:group adaptive="layout" adaptiveThreshold="768" class="w2tb tbl" id="grp_usrInf" style="" tagname="table">
					<w2:attributes>
						<w2:summary>비밀번호수정 사용자 정보</w2:summary>
					</w2:attributes>
					<xf:group tagname="colgroup">
						<xf:group style="width:150px;" tagname="col"></xf:group>
						<xf:group style="" tagname="col"></xf:group>
					</xf:group>
					<xf:group style="" tagname="tr">
						<xf:group class="w2tb_th" style="" tagname="th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
							<w2:textbox id="" label="아이디" style=""></w2:textbox>
						</xf:group>
						<xf:group class="w2tb_td" style="" tagname="td">
							<w2:textbox class="bold" id="tbx_usrId" label="" ref="data:dma_usrInf.usrId" style=""></w2:textbox>
						</xf:group>
					</xf:group>
					<xf:group style="" tagname="tr">
						<xf:group class="w2tb_th" style="" tagname="th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
							<w2:textbox id="" label="신청인" style=""></w2:textbox>
						</xf:group>
						<xf:group class="w2tb_td" style="" tagname="td">
							<w2:textbox class="bold" id="tbx_usrNm" label="" ref="data:dma_usrInf.usrNm" style=""></w2:textbox>
						</xf:group>
					</xf:group>
					<xf:group style="" tagname="tr">
						<xf:group class="w2tb_th" style="" tagname="th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
							<w2:textbox id="" label="이메일" style=""></w2:textbox>
						</xf:group>
						<xf:group class="w2tb_td" style="" tagname="td">
							<w2:textbox class="bold" id="tbx_email" label="" ref="data:dma_usrInf.email" style=""></w2:textbox>
						</xf:group>
					</xf:group>
					<!-- 휴대전화번호 + 안내문자발송 체크 (캡처에서 같은 줄 오른쪽) -->
					<xf:group style="" tagname="tr">
						<xf:group class="w2tb_th" style="" tagname="th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
							<w2:textbox id="" label="휴대전화번호" style=""></w2:textbox>
						</xf:group>
						<xf:group class="w2tb_td" style="" tagname="td">
							<xf:group class="flex flex_no" id="" style="">
								<w2:textbox class="bold" id="tbx_mphonNo" label="" ref="data:dma_usrInf.mphonNo" style="width:160px;"></w2:textbox>
								<xf:select appearance="full" id="chk_smsSendYn" ref="data:dma_usrInf.smsSendYn" renderType="checkbox" style="" title="안내문자발송">
									<xf:choices>
										<xf:item>
											<xf:label><![CDATA[안내문자발송]]></xf:label>
											<xf:value><![CDATA[Y]]></xf:value>
										</xf:item>
									</xf:choices>
								</xf:select>
							</xf:group>
						</xf:group>
					</xf:group>
					<xf:group style="" tagname="tr">
						<xf:group class="w2tb_th" style="" tagname="th">
							<w2:attributes>
								<w2:scope>row</w2:scope>
							</w2:attributes>
							<w2:textbox id="" label="변경 패스워드" style=""></w2:textbox>
						</xf:group>
						<xf:group class="w2tb_td" style="" tagname="td">
							<xf:secret id="sct_chgPwd" placeholder="변경하고자 하는 비밀번호를 입력바랍니다." ref="data:dma_usrInf.chgPwd" style="width:300px;"
								title="변경 패스워드">
							</xf:secret>
						</xf:group>
					</xf:group>
				</xf:group>
			</xf:group>

			<w2:textbox class="txt_info" id="" label="해당 화면은 등록된 이메일 주소로 비밀번호 전송이 불가한 경우 수동으로 비밀번호를 수정하는 기능입니다." style=""></w2:textbox>

			<!-- 하단 버튼 : 주요 동작(저장, pt)을 맨 오른쪽에 둔다 -->
			<xf:group class="btnbox" id="" style="">
				<xf:group class="rt" id="" style="">
					<xf:trigger class="btn_cm" id="btn_close" type="button">
						<xf:label><![CDATA[닫기]]></xf:label>
					</xf:trigger>
					<xf:trigger class="btn_cm pt" id="btn_save" type="button">
						<xf:label><![CDATA[저장]]></xf:label>
					</xf:trigger>
				</xf:group>
			</xf:group>
		</xf:group>
	</body>
</html>

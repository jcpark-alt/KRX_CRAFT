<?xml version="1.0" encoding="utf-8"?>
<gform version="1.5" width="730" height="785" arfsrc="../js/arf.vbs" componentset="unicode">
    <style>
	@import url('../css/global.gss');
	</style>
    <model>
		<mxdataset id="dts_Rst">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Inf">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Fil">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxlogicaltr id="trs">
			<property keyname="toinb_dataid4"></property>
		</mxlogicaltr>
		<mxdataset id="dts_3">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Mst">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_2">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Tit">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Ori">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Isu">
			<property usechangeinfo="False"></property>
		</mxdataset>
		<mxbinder id="bnd_fileList">
			<property activebind="true"></property>
			<bindinfo>
				<column col="fileInfo" ctrl="fil" param="Value" readonly="False"></column>
				<column col="fileUrl" ctrl="fil" param="Value" readonly="False"></column>
			</bindinfo>
			<ref dataid="dts_Fil"></ref>
		</mxbinder>
		<mxdataset id="dts_4">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Print">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Print_BODY">
			<property syncload="True"></property>
		</mxdataset>
		<mxdataset id="dts_Inf_Eng">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Rst_Eng">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Mst_Eng">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Dtl_Eng">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Isu_Eng">
			<property usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn_All_Eng">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_Rsn_Rel_Eng">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_5">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_6">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_7">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_8">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
		<mxdataset id="dts_9">
			<property syncload="True" usechangeinfo="False"></property>
		</mxdataset>
	</model>
    <components>
		<panel id="pan_1" left="5" top="5" width="720" height="40" class="TopCondition_01">
			<extproperty></extproperty>
			<image id="btn_close" left="665" top="10" width="50" height="22" src="../img/btn_close.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<image id="btn_send" left="560" top="10" width="102" height="22" src="../img/btn_send_dscl.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			<mxtextarea id="log" class="TextArea_01" left="10" top="10" width="0" height="18">
			<extproperty border-style="none"></extproperty>
			</mxtextarea>
			<panel id="pan_btn" left="416" top="5" width="142" height="30">
			<extproperty></extproperty>
				<image id="btn_crt" left="5" top="5" width="133" height="22" src="../img/btn_crtdiscls_info.gif">
			<extproperty cursor="pointer"></extproperty>
				</image>
			</panel>
			<checkbox id="chk_CorrctYn" left="335" top="13" width="16" height="16"></checkbox>
			<label id="label_8" class="TopCondition_01" left="355" top="11" width="55" height="20" text="정정공시">
			<extproperty font-size="12" color="#343434" text-align="left" border-color="#0000FF"></extproperty>
			</label>
			<panel id="panel_PRINT" left="5" top="5" width="65" height="30">
			<extproperty></extproperty>
				<image id="btn_Print" left="5" top="5" width="50" height="22" src="../img/btn_print.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
			</panel>
			<label id="lbl_engdiscls_view" left="219" top="10" width="40" height="21"></label>
			<image id="btn_engdiscls_view" left="70" top="10" width="133" height="22" src="../img/btn_engdiscls_view.gif">
			<extproperty cursor="pointer"></extproperty>
			</image>
		</panel>
		<panel id="pan_2" class="TopCondition_01" left="5" top="50" width="720" height="40">
			<extproperty></extproperty>
			<label id="label_9" class="TopCondition_01" left="10" top="10" width="45" height="20" text="제목">
			<extproperty font-size="12" color="#343434" border-color="#0000FF"></extproperty>
			</label>
			<textbox id="txb_frmNam" class="TopCondition_01_read" left="59" top="10" width="201" height="20" readonly="readonly" maxlength="1000"></textbox>
			<label id="label_6" class="TopCondition_01" left="263" top="10" width="8" height="20" text="(">
			<extproperty font-weight="bold" text-align="center" border-style="solid" border-width="0"></extproperty>
			</label>
			<textbox id="txb_frmTit" class="TopCondition_01_write" left="274" top="10" width="434" height="20" maxlength="1000"></textbox>
			<label id="label_1" class="TopCondition_01" left="708" top="10" width="8" height="20" text=")">
			<extproperty font-weight="bold" text-align="center" border-style="solid" border-width="0"></extproperty>
			</label>
		</panel>
		<mxgrid id="grd_Fil" class="Grid_01" left="5" top="675" width="648" height="98">
			<format>
				<column name="순번" value="{CurRow}" align="center"></column>
				<column name="화일명" width="570" align="left" id="fileInfo"></column>
			</format>
			<ref dataid="dts_Fil"></ref>
		</mxgrid>
		<panel id="pan" left="40" top="130" width="650" height="505">
			<extproperty border-color="#92b1f1" border-style="none" border-width="1"></extproperty>
		</panel>
		<image id="btn_ins" left="660" top="675" width="23" height="22" src="../img/btn_openfolder.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<image id="btn_del" left="660" top="700" width="32" height="22" src="../img/btn_deletes.gif">
			<extproperty cursor="pointer"></extproperty>
		</image>
		<mxfilecontrol id="fil" left="660" top="730" width="0" height="22">
			<extproperty font-family="돋움" font-size="12"></extproperty>
		</mxfilecontrol>
		<panel id="panel_1" left="5" top="95" width="720" height="575">
			<extproperty border-style="solid" border-width="1" border-color="#92b1f1"></extproperty>
	</panel>
		<mxtextarea id="tar" class="TextArea_01" left="40" top="130" width="648" height="503">
			<property applyrtf="False"></property>
			<extproperty font-size="12" border-style="none"></extproperty>
			</mxtextarea>
	</components>
<script><![CDATA[
	#include("../js/libRoundPanel.js");
	#include("../js/list_common.js");
	#include("../js/stf.js");
	#include("../js/PopupCalendar.js");
	#include("../js/session.js");
	#include("../js/utils.js");
	#include("../js/json2.js");
	#include("../js/report.js");

	var vScrenID = "ULDSTF92024.gfm";
	var vScrenTpCD = "";
	var NO_SRC_DSET = "원본 DATASET이 존재하지 않아 공시문서를 생성할 수 없습니다.";

	var fn_getPar = undefined, fn_setPar = undefined, OnSuccessAfter;
	var getPar = undefined, setPar = undefined, isNoGen = false;
	var stKeyFrm = "", stKeyBiz = "", stKeyIsurCd = "" , stKeyMktId = "", stKeyMsg = "", sKeyTit = "";
	var formTrnsCodeYN = "N";
	
	function fn_getParCrt(arr) { 
		arr[0] = dts_Inf, 
		arr[1] = dts_Inf_Eng; 
	}
	
	function fn_setParCrt(arr) { }
	
	function fn_getCrtInfo() {

		fn_getPar = fn_getParCrt;
		fn_setPar = fn_setParCrt;
		
		var wth = 735 + 5;
		var hgt = 270 + 30;
		var pt = fn_getModalCenterPos(frame, wth, hgt)
		
		frame.CreateDialogFrame("DLG_CRTINF","../listingcommon/ULDSTF92019.gfm", "정정공시정보입력", pt.x, pt.y, wth, hgt, "window");
	}
	
	function OnSuccessAfterSearch() {
		var s = "";
		for (var i = 1; i <= dts_Rst.CountRow; i++) {
			s = s + (s == "" ? "" : "\n") + dts_Rst.NameString(i, "HTML_CONTN");
		}

		var stLstMktId = "";
		if ((stKeyMktId == "1") || (stKeyMktId == "2") || (stKeyMktId == "6") ) { // 호출한 화면에서 넘겨받은 시장구분자를 우선반영하며, 그 이후에 밣행기관에서 조회한 자료를 적용한다.
			stLstMktId = stKeyMktId;
		} else {
			stLstMktId = dts_Ori.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD");
		}
		
		if ((stLstMktId == "1") || ( ((stLstMktId == "2") || (stLstMktId == "6") ) && (stKeyFrm.substr(0, 5) == "70837"))) {
			if(formTrnsCodeYN == "Y"){
				pan.innerHTML = s;
			}else{
				tar.text = s;
			}
		} else if (stLstMktId == "2" || stLstMktId == "6" ) {
			pan.innerHTML = s;
		}
		txb_frmNam.value = dts_Tit.NameString(1, "DISCLS_TITLE");
		log.Text = dts_Rst.Text;
	}
	
	function OnSuccessAfterSave() {
		alert(getMessageParam("MSG-0001", ""));
		//btn_send.src = "../img/btn_send_dscl_d.gif";
		frame.CloseFrame();
	}
		
	
	/* 2009.05.18 영문공시내용까지 DataSet에 보관
	공시원문조회부분
	*/
	function fn_genDisclsTotal() {
	
		OnSuccessAfter = OnSuccessAfterSearch;
		if ((stKeyFrm != "") && (stKeyIsurCd != "") && (stKeyBiz != "")) { // 서식코드,  발행기관코드, 업무처리번호 확인
			if ((dts_Mst.CountRow > 0) || (dts_2.CountRow > 0) || (dts_3.CountRow > 0)) {
				if (dts_Inf.CountRow == 0) { 
					dts_Inf.AddRow(); 
				}
				dts_Inf.NameString(1, "ISUR_CD") 				= stKeyIsurCd; 							        // 발행기관코드
				dts_Inf.NameString(1, "BZ_PROCS_NO")		= stKeyBiz; 							                // 업무처리번호
				dts_Inf.NameString(1, "ACPT_NO")				= dts_Ori.NameString(1, "ACPT_NO"); 	// 원공시번호
				if ( (stKeyMktId == "1") || (stKeyMktId == "2") || (stKeyMktId == "6") ) { // 화면에서 지정한 시장구분자우선처리
					dts_Inf.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= stKeyMktId;
				} else {
					dts_Inf.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= dts_Ori.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD"); // 현물종목거래시장구분코드
				}
				dts_Inf.NameString(1, "DISCLS_TITLE")			= txb_frmTit.value;						        // 공시제목
				dts_Inf.NameString(1, "FORM_CD") 				= stKeyFrm; 							                // 서식코드				
				dts_Inf.NameString(1, "CORRCT_YN") 			= (chk_CorrctYn.checked ? "Y" : "N"); 	// 정정구분
				

				/* 2009.05.18 영문공시 */
				if (dts_Inf_Eng.CountRow == 0) { 
					dts_Inf_Eng.AddRow(); 
				}
				
				dts_Inf_Eng.NameString(1, "ISUR_CD") 				= stKeyIsurCd; 							        // 발행기관코드
				dts_Inf_Eng.NameString(1, "BZ_PROCS_NO")		= stKeyBiz; 							                // 업무처리번호
				dts_Inf_Eng.NameString(1, "ACPT_NO")				= dts_Ori.NameString(1, "ACPT_NO"); 	// 원공시번호
				
				if ( (stKeyMktId == "1") || (stKeyMktId == "2")  || (stKeyMktId == "6") ) { // 화면에서 지정한 시장구분자우선처리
					dts_Inf_Eng.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= stKeyMktId;
				} else {
					dts_Inf_Eng.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= dts_Ori.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD"); // 현물종목거래시장구분코드
				}
				
				dts_Inf_Eng.NameString(1, "DISCLS_TITLE")			= txb_frmTit.value;						// 공시제목
				dts_Inf_Eng.NameString(1, "FORM_CD") 				= stKeyFrm+"_EN"; 							// 서식코드				
				dts_Inf_Eng.NameString(1, "CORRCT_YN") 			= (chk_CorrctYn.checked ? "Y" : "N"); 	// 정정구분
				/* 2009.05.18 영문공시 End */
			

				
				/* 2009.05.18 영문공시 */
				trs.Action 	 = fn_encodeNSession("/listingCommon.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_01+"&method=generateDisclosureTotal");
				trs.KeyName  = "toinb_dataid4";
				trs.KeyValue = "JSP(O:pRstEng=dts_Rst_Eng, O:pOut=dts_Rst, O:pTit=dts_Tit, I:pInf=dts_Inf,I:pIn0=dts_Mst, I:pIn1=dts_Isu, I:pIn2=dts_2, I:pIn3=dts_3, I:pIn4=dts_4, I:pIn5=dts_Isu_Eng, I:pIn6=dts_Mst_Eng, I:pIn7=dts_Dtl_Eng, I:pIn8=dts_Rsn_All_Eng, I:pIn9=dts_Rsn_Rel_Eng,I:pInfEng=dts_Inf_Eng, I:pIn10=dts_5, I:pIn11=dts_6, I:pIn12=dts_7, I:pIn13=dts_8, I:pIn14=dts_9)";
				/* 2009.05.18 영문공시 End */
				trs.Post();
				
			} else if (isNoGen) {
					dts_Tit.DataID = "/listingCommon.do?method=listGeneral" +
									 "&outputMessageId=RESULT_TITLE_INOUT" +
									 "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" + 
									 "&queryId=lds.stf.lstproc.marketaction.dsclname.select" + 
									 "&{P}1=" + cGetToday2() +
									 "&{P}2=" + stKeyFrm;
									 
					dts_Tit.reset();
					txb_frmNam.value = dts_Tit.NameString(1, "DISCLS_TITLE");
					tar.text = stKeyMsg;
			} else {
				alert(getMessageParam("MSG-0908"));
			}
			if (stKeyTit != "") { txb_frmTit.value = stKeyTit; };
		} else {
			alert(getMessageParam("MSG-0908"));
		}
	}
	
	function txt2dts(d, t) {
		d.ClearData();

		var arrStr = t.split("\n");
		for (var i = 0; i < arrStr.length; i++) {
			d.AddRow();
			if (arrStr[i].charCodeAt(arrStr[i].length - 1) == 13) {
				d.NameString(dts_Rst.CountRow, "HTML_CONTN") = arrStr[i].substring(0, arrStr[i].length - 1);
			} else	{
				d.NameString(dts_Rst.CountRow, "HTML_CONTN") = arrStr[i];
			}
		}
	}
	

	/*
	2009.05.18 영문공시원문도 저장을 해야 하기 때문에 DataSet을 두개 만들어서 처리해야 할 듯.
	공시검토전송부분..
	*/
	function fn_sendDisclsTotal() {
		OnSuccessAfter = OnSuccessAfterSave;
		dts_Rst.NameString(1, "HTML_CONTN") = "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">";
		dts_Rst_Eng.NameString(1, "HTML_CONTN") = "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">";
		
		if ((stKeyFrm != "") && (stKeyIsurCd != "") && (stKeyBiz != "")) { // 서식코드,  발행기관코드, 업무처리번호 확인
			if ( (isNoGen) || (dts_Inf.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD") == "1") ) {
				//alert("유가");
				if(formTrnsCodeYN != "Y"){
					txt2dts(dts_Rst, tar.text);
				}
			}
			
			if (dts_Rst.CountRow > 0) { // 공시원문이 있어야 함.
				if (dts_Inf.CountRow == 0) { 
					dts_Inf.AddRow(); 
				}
				dts_Inf.NameString(1, "ISUR_CD") 				= stKeyIsurCd; 							        // 발행기관코드
				dts_Inf.NameString(1, "BZ_PROCS_NO")		= stKeyBiz; 							                // 업무처리번호
				dts_Inf.NameString(1, "ACPT_NO")				= dts_Ori.NameString(1, "ACPT_NO"); 	// 원공시번호
				if ( (stKeyMktId == "1") || (stKeyMktId == "2")  || ( stKeyMktId == "6")) {
					dts_Inf.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= stKeyMktId;
				} else {
					dts_Inf.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= dts_Ori.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD"); // 현물종목거래시장구분코드
				}
				dts_Inf.NameString(1, "DISCLS_TITLE")			= txb_frmTit.value;						        // 공시제목
				dts_Inf.NameString(1, "FORM_CD") 				= stKeyFrm; 							                // 서식코드
				dts_Inf.NameString(1, "CORRCT_YN") 			= (chk_CorrctYn.checked ? "Y" : "N"); 	// 정정구분
				
				/* 2009.05.18 영문공시 */
				if (dts_Inf_Eng.CountRow == 0) { 
					dts_Inf_Eng.AddRow(); 
				}
				dts_Inf_Eng.NameString(1, "ISUR_CD") 				= stKeyIsurCd; 							// 발행기관코드
				dts_Inf_Eng.NameString(1, "BZ_PROCS_NO")		= stKeyBiz; 	    						    // 업무처리번호
				dts_Inf_Eng.NameString(1, "ACPT_NO")				= dts_Ori.NameString(1, "ACPT_NO"); 	// 원공시번호
				if ( (stKeyMktId == "1") || (stKeyMktId == "2") || (stKeyMktId == "6") ) {
					dts_Inf_Eng.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= stKeyMktId;
				} else {
					dts_Inf_Eng.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD")	= dts_Ori.NameString(1, "SPOT_ISU_TRD_MKT_TP_CD"); // 현물종목거래시장구분코드
				}
				dts_Inf_Eng.NameString(1, "DISCLS_TITLE")			= txb_frmTit.value;						        // 공시제목
				dts_Inf_Eng.NameString(1, "FORM_CD") 				= stKeyFrm+"_EN"; 							    // 서식코드
				dts_Inf_Eng.NameString(1, "CORRCT_YN") 			= (chk_CorrctYn.checked ? "Y" : "N"); 	// 정정구분
				/* 2009.05.18 영문공시 End*/

				/* 2009.05.18 영문공시 */
				trs.Action = fn_encodeNSession("/listingCommon.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_02+"&method=sendDisclosureTotal");
				trs.KeyName  = "toinb_dataid4";
				trs.KeyValue = "JSP(I:pInf=dts_Inf, I:pRst=dts_Rst, I:pFil=dts_Fil, I:pIsu=dts_Isu, I:pInfEng=dts_Inf_Eng, I:pRstEng=dts_Rst_Eng)";
				trs.Post();
				
			} else {
				alert(NO_SRC_DSET);
			}
		} else {
			alert(NO_SRC_DSET);
		}
	}


	/********************************************** 
	* 함수명   : Print()
	* 설명       : 화면을 인쇄한다. 
	***********************************************/
	function fn_print(){
		var pdf_rptname = "RLDSTF00004";
		var subTitle = "";
		var sDepNm_1 = "";
		var sDepNm_2 = "";
		var gDepCd = js_dep_cd.substring(0, 2);
		
		
		if(stKeyFrm=="68956C" || stKeyFrm=="68955C"  ){	// ELW 상장폐지예고 or ELW 상장폐지(최종거래일에 의한 상장폐지) 
			pdf_rptname = "RLDSTF00004_1";
		} else {
			pdf_rptname = "RLDSTF00004";
		
			if (gDepCd == '2B') { //유가증권 상품상장팀				
				sDepNm_1 = '확인';
				sDepNm_2 = '팀장';
			} else if (gDepCd == '26') {
				sDepNm_1 = '팀장';
				sDepNm_2 = '공시총괄팀';
				
				if(js_dep_cd == '2615') { //  기업심사팀(2615) by nhkw 
					sDepNm_1 = '팀장';
					sDepNm_2 = '상장부장';
			    }
			} else if (gDepCd == '25') {
				sDepNm_1 = '팀장';
				sDepNm_2 = '상장부장';
			} else {
				sDepNm_1 = '팀장';
				sDepNm_2 = '공시총괄팀';
			}
		}
		
		var url = "/listingCommon.do?SCREN_ID=" +vScrenID+"&SCREN_PROCES_TP_CD="+SCREN_PROCS_TP_CD_05;
		url += "&method=listGeneral&outputMessageId=INSIDE_DRAFT_PRINT_OUT";
		url += "&service=krx.lds.stf.listingcommon.services.ListingCommonApp" ;
		url += "&queryId=lds.stf.lstproc.lstlst.select.inner.draft.print.condition";
		url += "&{P}param01=" + stKeyIsurCd;

		dts_Print.DataID = encodeURI(url);
		dts_Print.reset();
		
		if (getObjectValue(txb_frmTit) == "") {
			subTitle = getObjectValue(txb_frmNam);
		} else {
			subTitle = getObjectValue(txb_frmNam) +" ("+ getObjectValue(txb_frmTit) +")";
		}
		
		var tInfoContn = tar.text;
		
		if(tInfoContn != ''){
			tInfoContn = replaceAll(tInfoContn, '\n', '<br>');
			tInfoContn = replaceAll(tInfoContn, ' ', '&nbsp;');
		} else {
			tInfoContn = defaultStrHtmlSpace(tInfoContn);
		}
		
		var userParam = [
					  {uid: "DEP_NM_1",		unm: defaultStrHtmlSpace(sDepNm_1) }
					 ,{uid: "DEP_NM_2",		unm: defaultStrHtmlSpace(sDepNm_2) }
					 ,{uid: "ISUR_CD",		unm: defaultStrHtmlSpace(stKeyIsurCd) }
					 ,{uid: "COM_NM",	unm: defaultStrHtmlSpace(dts_Print.NameString(1, "COM_NM"))}
					 ,{uid: "TITLE",			unm: defaultStrHtmlSpace(subTitle)}
					 ,{uid: "BODY",			unm: tInfoContn}
					 //,{uid: "BODY",			unm: tar.text}
		];
		
		//PDF Convert
		fn_open_report_pdf(pdf_rptname, userParam);
	}

	// ********************************************************************
	//
	// 문자열(sInData)를 \n 구분으로 자른 다음,  특정 길이(iSize)로 다시 자르는 함수
	//
	// ********************************************************************
	function fnSplitString(sInData, iSize) {
		var sFldSep = "|*|";
		
		var aOutData = new Array();
		var sOutData = "";
		var aData = sInData.split("\n");
		var cnt = 0;

		for ( var k = 0; k < aData.length; k++) {
			aData[k] = aData[k].replace('\r', '');
			var rtnLen = aData[k].length;
			var rtnValMod;
			var mod = 0;
			var j = 0;
			
			if (iSize == 0) {
				mod = 0;
				iSize = rtnLen;
			} else {
				mod = rtnLen / iSize;
			}

			for (var i = 1; i < mod+1; i++) {
				cnt++;
				rtnValMod = aData[k].substr(j, iSize);
				aOutData.push(rtnValMod.replace('\r', ''));
				j = j + parseInt(iSize);
			} // end if

			if (mod+1 <= 1) {
				cnt++;
				aOutData.push("");
			} // end if
		} // end for

		for ( var i = 0, k = 1; i < aOutData.length; i++, k++) {
			if (i > 0) sOutData += sFldSep;
			sOutData += aOutData[i];
			
			//dts_Print_BODY.AddRow();
			//dts_Print_BODY.NameValue(k, "BODY") = aOutData[i];
		}
		
		return sOutData;
		
	} // end function
	


	
	//2009.05.11 영문공시 추가
	function fn_engDisclsView(){
		frame.CreateDialogFrame('ULDSTF92024_EN.gfm', '/listingcommon/ULDSTF92024_EN.gfm', '영문공시안내문 미리보기' ,30, 30, 735, 815, 'window' );
	}
	
	
	



]]></script>

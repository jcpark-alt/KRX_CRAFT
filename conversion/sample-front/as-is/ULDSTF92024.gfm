			}
			
			if(stKeyFrm=="68053" || stKeyFrm == "68053A"  || stKeyFrm == "68053B"  || stKeyFrm == "68053C"  || stKeyFrm == "68053D"  ||stKeyFrm == "68053E" || stKeyFrm == "68053F"  ) { // 유가 관리종목지정해제시 안내
				var sMsg = "관리종목 지정해제된 법인은 해제된 날로부터 3년이 경과하면 공시내용 확인절차 대상법인에서 지정해제 됩니다.\n" +
								   "동사의 확인절차 대상법인 지정해제예정일을 반드시 확인하시기 바랍니다.\n" +
								   "*[공시관리] > [공시내용 확인절차 대상] > [확인절차 대상법인] > [대상법인 현황]";
				alert(sMsg);
		}
		
		if (confirm(getMessageParam("MSG-0024", ""))) {

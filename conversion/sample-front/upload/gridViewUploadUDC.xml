	//mpd_multiFileUpload.getFileInfos() == selectFileList
	scwin.selectCallback(selectFileList);
};

//파일업로드시 파일정보 dataList에 세팅
scwin.selectCallback = function (selectFileList) {

};


scwin.btn_Save_onclick = function (e) {
	scwin.fn_Save();
};


scwin.upd_multiUpload_onFileRemoveDone = function (udcObj, removeRowTarget, dataListTarget, allIdx) {
	console.log(removeRowTarget)
	console.log(dataListTarget)	

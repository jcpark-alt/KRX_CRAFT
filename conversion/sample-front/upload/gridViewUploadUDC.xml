};


scwin.upd_multiUpload_onFileUploadDone = function (udcObj, fileList , resJSON) {
	scwin.fn_saveResult(resJSON ?? {});
};

scwin.upd_multiUpload_onGrdcellclick = function (rowIndex, columnIndex, columnId) {
	let fileData = dlt_FILE_LIST.getRowJSON(rowIndex);

    if (columnId === "attachFileNm" && dlt_FILE_LIST.getRowStatus(0) != "C") {
        let url = "/api/discls/common/file/download";
        const param = { gubun: "2", ...fileData };
		alert("다운로드 로직수행");
        $c.data.downFile(url, fileData[columnId], param); 
    }
};

//파일선택시 호출되는 이벤트 
scwin.upd_multiUpload_onFileSelectDone = function (udcObj, selectFileList) {
	//udcObj :  udc 컴포넌트

<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:w2="http://www.inswave.com/websquare" xmlns:xf="http://www.w3.org/2002/xforms">
    <head meta_screenName="(팝업)공지사항">
        <w2:type>COMPONENT</w2:type>
        <w2:buildDate/>
        <w2:MSA/>
        <xf:model>
			<w2:workflowCollection />
			<w2:dataCollection baseNode="map">
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_noticeList" saveRemovedData="true">
					<w2:columnInfo>
						<w2:column id="contnId" name="게시물ID" dataType="text"></w2:column>
						<w2:column id="bbsTpNm" name="공지구분" dataType="text"></w2:column>
						<w2:column id="title" name="제목" dataType="text"></w2:column>
						<w2:column id="wrtrEmpNm" name="등록자" dataType="text"></w2:column>
						<w2:column id="notiObjSysTpCd" name="공지대상시스템코드" dataType="text"></w2:column>
						<w2:column id="notiObjSysTpNm" name="공지대상시스템명" dataType="text"></w2:column>
						<w2:column id="wrtDd" name="등록일" dataType="text"></w2:column>
						<w2:column id="inqCnt" name="조회수" dataType="text"></w2:column>
					</w2:columnInfo>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dma_search">
					<w2:keyInfo>
						<w2:key id="condition1" name="키워드콤보박스" dataType="text"></w2:key>
						<w2:key id="keyword" name="키워드" dataType="text"></w2:key>
						<w2:key id="dateS" name="시작일" dataType="text"></w2:key>
						<w2:key id="dateE" name="종료일자" dataType="text"></w2:key>
						<w2:key id="wrtrEmpNm" name="등록자" dataType="text"></w2:key>
						<w2:key id="notiObjSysTpCd" name="공지대상시스템구분코드" dataType="text"></w2:key>
						<w2:key id="mktTpCd" name="시장구분코드" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_notiObjSysCd">
					<w2:columnInfo>
						<w2:column id="code" name="name1" dataType="text"></w2:column>
						<w2:column id="codeNm" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[1]]></code>
							<codeNm><![CDATA[제출(국문) 시스템]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[2]]></code>
							<codeNm><![CDATA[조회(국문)]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[D]]></code>
							<codeNm><![CDATA[조회(영문)]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[3]]></code>
							<codeNm><![CDATA[처리시스템]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[B]]></code>
							<codeNm><![CDATA[K-CLIC]]></codeNm>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataList baseNode="list" repeatNode="map" id="dlt_mktGubun">
					<w2:columnInfo>
						<w2:column id="code" name="name1" dataType="text"></w2:column>
						<w2:column id="codeNm" name="name2" dataType="text"></w2:column>
					</w2:columnInfo>
					<w2:data use="true">
						<w2:row>
							<code><![CDATA[9]]></code>
							<codeNm><![CDATA[전체]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[1]]></code>
							<codeNm><![CDATA[유가]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[2]]></code>
							<codeNm><![CDATA[코스닥]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[4]]></code>
							<codeNm><![CDATA[채권]]></codeNm>
						</w2:row>
						<w2:row>
							<code><![CDATA[6]]></code>
							<codeNm><![CDATA[코넥스]]></codeNm>
						</w2:row>
					</w2:data>
				</w2:dataList>
				<w2:dataMap baseNode="map" id="dma_dataMap1">
					<w2:keyInfo>
						<w2:key id="condition1" name="name1" dataType="text"></w2:key>
						<w2:key id="condition2" name="name2" dataType="text"></w2:key>
					</w2:keyInfo>
				</w2:dataMap>
			</w2:dataCollection>
			<xf:submission id="sbm_getNoticeList" action="/api/discls/dsclinfo/select-list-notice-content" method="get" mediatype="application/json" ref="data:json,dma_search"
				target='data:json,{"id":"dlt_noticeList","key":"body"}' encoding="UTF-8" instance="" replace="" errorHandler="" customHandler="" mode="asynchronous"
				processMsg="" ev:submit="" ev:submitdone="scwin.sbm_getNoticeList_submitdone" ev:submiterror="" abortTrigger="">
			</xf:submission>
        </xf:model>
        <w2:layoutInfo/>
        <w2:publicInfo method=""/>
        <script lazy="false" type="text/javascript"><![CDATA[
scwin.tDay = $c.date.getServerDateTime();  // 오늘일자 yyyyMMdd
scwin.jsBondYn = $c.stf.getUserInfo("bondYn");  // 채권공시여부
scwin.market = $c.stf.getUserInfo("market");    // 시장구분
scwin.vScrenID = "ULDSTF91220.xml";
scwin.procsTpCd = "01"; // SCREN_PROCS_TP_CD_01

scwin.onpageload = function (e) {
	
    scwin.fn_search();
};

scwin.fn_search = function() { // fn_list_sync

    // 로그인 한 사용자가 채권상장팀이면 시장구분값 4, 아니면 라디오버튼 선택값으로 세팅
    let selMtkId = (scwin.bondYn === "Y")? "4" : dma_search.get("mktTpCd");
    dma_search.set("mktTpCd", selMtkId);

    // 목록 조회
    $c.sbm.execute(sbm_getNoticeList);

}

scwin.btn_list_onclick = function (e) {
	$c.win.openMenu("공지사항 입력", "/ui/dsclinfo/ULDSTF30400.xml", "100112");
};

// 그리드 cell click 이벤트
scwin.grd_list_oncellclick = function (rowIndex, columnIndex, columnId) {
    
    let pData = dlt_noticeList.getRowJSON(rowIndex) // 그리드 행 선택 data
    
    const opts = {
        id: "ULDSTF91230"  // (팝업) 공지사항 상세
        , popupName: "공지사항 보기"
        , width: 1080
        , height: 679
        , frameModal: "top"
    };

    $c.win.openPopup("/ui/common/ULDSTF91230.xml", opts, pData);
	
};]]></script>
    </head>
    <body ev:onpageload="scwin.onpageload">
    	<xf:group class="pop_contents" id="" meta_componentContainer="true" style="">
    		<xf:group class="titbox" id="" style="">
    			<xf:group class="rt" id="" style="">
    				<xf:trigger class="btn_cm" id="btn_list" style="" type="button" ev:onclick="scwin.btn_list_onclick">
    					<xf:label><![CDATA[더 많은 목록보기]]></xf:label>
    				</xf:trigger>
    			</xf:group>
    		</xf:group>
    		<xf:group adaptiveThreshold="" class="gvwbox" id="" style="">
    			<w2:gridView autoFit="allColumn" checkReadOnlyOnPasteEnable="" class="gvw" dataList="data:dlt_noticeList" focusMode="row" id="grd_list"
    				keepDefaultColumnWidth="true" rowNumHeaderValue="No" rowNumVisible="true" rowNumWidth="50" rowStatusHeaderValue="상태"
    				rowStatusWidth="50" scrollByColumn="false" scrollByColumnAdaptive="false" style="height: 153px;" readOnly="true" ev:oncellclick="scwin.grd_list_oncellclick">
    				<w2:caption id="caption2" style="" value="this is a grid caption."></w2:caption>
    				<w2:header id="header2" style="">
    					<w2:row id="row3" style="">
    						<w2:column blockSelect="false" displayMode="label" id="column11" inputType="text" removeBorderStyle="false"
    							value="구분" width="90">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column10" inputType="text" removeBorderStyle="false"
    							value="제목" width="300">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="column9" inputType="text" removeBorderStyle="false"
    							value="게시일자" width="90">
    						</w2:column>
    					</w2:row>
    				</w2:header>
    				<w2:gBody id="gBody2" style="">
    					<w2:row id="row4" style="">
    						<w2:column blockSelect="false" displayMode="label" id="bbsTpNm" inputType="text" removeBorderStyle="false"
    							width="90">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="title" inputType="text" removeBorderStyle="false"
    							width="300">
    						</w2:column>
    						<w2:column blockSelect="false" displayMode="label" id="wrtDd" inputType="text" removeBorderStyle="false"
    							width="90">
    						</w2:column>
    					</w2:row>
    				</w2:gBody>
    			</w2:gridView>
    		</xf:group>
    	</xf:group>
    </body>
</html>

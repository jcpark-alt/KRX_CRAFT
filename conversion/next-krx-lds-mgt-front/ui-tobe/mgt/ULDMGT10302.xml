/**
 * @method
 * @name listSync
 * @description 금감원공시처리현황 목록(MxDataSet)을 조회(/dartextract.do)하고 완료 후 구 콜백(MxDataSet_OnLoadCompleted)으로 총건수를 갱신한다.
 * @returns {void}
 * @hidden N
 * @example scwin.listSync();
 */
scwin.listSync = async function() {
    const sbmOptions = {
        id : "sbm_MxDataSet",
        action : "/dartextract.do",
        ref : "",
        target : "MxDataSet=body.content",
        isProcessMsg : false
    };

    const sbmRtn = await $c.sbm.executeDynamic(sbmOptions);
    scwin.MxDataSet_OnLoadCompleted(MxDataSet.getRowCount()); // 구 콜백 연결

};


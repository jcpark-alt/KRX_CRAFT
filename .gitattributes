# Normalize all text files to LF in the repository (and on checkout), so line
# endings stay consistent across machines and Git stops warning about CRLF.
* text=auto eol=lf

# Explicit text types used in this project
*.xml   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
*.cfg   text eol=lf
*.toml  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Binary assets (never touch line endings)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
